[{"id":1790779673000,"createdDate":"2026-09-30 14:47","name":"法国国际广播电台","title":"视频 : 特朗普称人工智能行业可以自我监管","content":"美国总统特朗普9月29日在白宫与近20位美国高科技界企业领袖会面后指出该行业的自我监管非常重要，并表示正式将“人工智能”更名为“超级智能”，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260930-%E8%A7%86%E9%A2%91-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E8%A1%8C%E4%B8%9A%E5%8F%AF%E4%BB%A5%E8%87%AA%E6%88%91%E7%9B%91%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790779673000.webp","sourceId":"rfi"},{"id":1790778681000,"createdDate":"2026-09-30 14:31","name":"法国国际广播电台","title":"G20贸易部长会议  聚焦过剩产能和消除强迫劳动等议题","content":"作为轮值主办国，华盛顿今年将举办一系列G20峰会，专门讨论贸易问题的贸易部长会议于周三（9月30号）开始在威斯康星州密尔沃基举行，为期两天。由美国贸易代表贾米森·格里尔主持。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260930-g20%E8%B4%B8%E6%98%93%E9%83%A8%E9%95%BF%E4%BC%9A%E8%AE%AE-%E8%81%9A%E7%84%A6%E8%BF%87%E5%89%A9%E4%BA%A7%E8%83%BD%E5%92%8C%E6%B6%88%E9%99%A4%E5%BC%BA%E8%BF%AB%E5%8A%B3%E5%8A%A8%E7%AD%89%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790778681000.webp","sourceId":"rfi"},{"id":1790777614000,"createdDate":"2026-09-30 14:13","name":"法国国际广播电台","title":"马克龙：中国正攻击我们的本土市场，其巨额补贴是不可接受的","content":"在对西班牙进行国事访问期间，法国总统马克龙周三呼吁欧盟更好地保护其市场并增强战略自主权——特别是在面对来自中国的竞争。他警告称必须警惕欧洲大陆持续的去工业化趋势​​。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260930-%E9%A9%AC%E5%85%8B%E9%BE%99-%E4%B8%AD%E5%9B%BD%E6%AD%A3%E6%94%BB%E5%87%BB%E6%88%91%E4%BB%AC%E7%9A%84%E6%9C%AC%E5%9C%9F%E5%B8%82%E5%9C%BA%EF%BC%8C%E5%85%B6%E5%B7%A8%E9%A2%9D%E8%A1%A5%E8%B4%B4%E6%98%AF%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97%E7%9A%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790777614000.webp","sourceId":"rfi"},{"id":1790772876000,"createdDate":"2026-09-30 12:54","name":"法国国际广播电台","title":"日本教授称获取解放军机密文件 指广州军区高层曾提准备介入“雨伞运动”","content":"据共同社周三（30日）披露的一份军方内部机密文件显示，2014年11月，中国军方一名高层曾提及应为军事介入香港当时发生的大规模民主化示威活动——“雨伞运动”——做好准备。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260930-%E6%97%A5%E6%9C%AC%E6%95%99%E6%8E%88%E7%A7%B0%E8%8E%B7%E5%8F%96%E8%A7%A3%E6%94%BE%E5%86%9B%E6%9C%BA%E5%AF%86%E6%96%87%E4%BB%B6-%E6%8C%87%E5%B9%BF%E5%B7%9E%E5%86%9B%E5%8C%BA%E9%AB%98%E5%B1%82%E6%9B%BE%E4%BF%83%E5%87%86%E5%A4%87%E4%BB%8B%E5%85%A5-%E9%9B%A8%E4%BC%9E%E8%BF%90%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790772876000.webp","sourceId":"rfi"},{"id":1790772685000,"createdDate":"2026-09-30 12:51","name":"法国国际广播电台","title":"法国扇贝出口中国：是机遇还是豪赌？","content":"中日关系陷入低谷为法国的海鲜出口带来了新的机遇。据法国媒体介绍，由于从日本进口扇贝市场的关闭使大约20家中国加工厂失去了货源，从而产生了迫切的替代需求。为了维持这些设施的运转，中国迅速对法国的扇贝表现出浓厚的兴趣。法国的扇贝（CoquilleSaint-Jacques），也就是圣雅克扇贝被誉为是法式海鲜中的极品，主要产自诺曼底和布列塔尼等冷水海域。从去年开始，一个全新的中国市场为法国的扇贝捕捞行业敞开了大门，去年法国扇贝的总出口量为4000吨，而其中近10%出口到了中国，而两年前，这个数字几乎为零。而且买家的热情日益高涨。即将于下个月开始的捕捞季的前景十分乐观，出口量因此有望大量翻倍，不过，法国的扇贝捕捞业内人士不仅担心增加捕捞会对该行业的持久性构成威胁，而且也对中日关系一旦改善中方市场或将消失存有疑虑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20260930-%E6%B3%95%E5%9B%BD%E6%89%87%E8%B4%9D%E5%87%BA%E5%8F%A3%E4%B8%AD%E5%9B%BD-%E6%98%AF%E6%9C%BA%E9%81%87%E8%BF%98%E6%98%AF%E8%B5%8C%E5%8D%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790772685000.webp","sourceId":"rfi"},{"id":1790769831000,"createdDate":"2026-09-30 12:03","name":"法国国际广播电台","title":"英超史上最大丑闻：曼城被指控超10亿美元财务造假，115项指控大部分成立","content":"一个独立调查委员会周二（9月29日）公布的重磅裁决认定，英超豪门曼城（ManchesterCity）在近十年间人为夸大俱乐部收入超过10亿美元，从而规避旨在限制俱乐部过度支出的财政公平规则。调查认为，曼城能够得以打造由世界足坛顶级球星组成的豪华阵容和这有直接的关系。独立委员会认定，这支由阿联酋资本支持的俱乐部在被指控的115项以上违规行为中，几乎全部成立。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E4%BD%93%E8%82%B2/20260930-%E8%8B%B1%E8%B6%85%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E4%B8%91%E9%97%BB-%E6%9B%BC%E5%9F%8E%E8%A2%AB%E6%8C%87%E6%8E%A7%E8%B6%8510%E4%BA%BF%E7%BE%8E%E5%85%83%E8%B4%A2%E5%8A%A1%E9%80%A0%E5%81%87%EF%BC%8C115%E9%A1%B9%E6%8C%87%E6%8E%A7%E5%A4%A7%E9%83%A8%E5%88%86%E6%88%90%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790769831000.webp","sourceId":"rfi"},{"id":1790769399000,"createdDate":"2026-09-30 11:56","name":"法国国际广播电台","title":"高雄儿少嘉年华｜法国馆特展《Badass 女英雄群像》 是时候把法国儿少漫画舞台让给女英雄了","content":"2026台湾国际儿少嘉年华在高雄登场，今年主题国为法国，在庆祝经典文学《小王子》80周年外，法国在台协会将里昂漫画节（LyonBD）策展的《Badass女英雄群像》搬来台湾，由总监艾蜜奈（HerminéeNurpetlian）亲自导览，特展展出10位女性儿少漫画角色，其中包含受邀创作者艾蜜莉（AmélieFléchais）和乔纳森（JonathanGarnier）的作品《牧羊女战士》（BergèresGuerrières）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260930-%E9%AB%98%E9%9B%84%E5%84%BF%E5%B0%91%E5%98%89%E5%B9%B4%E5%8D%8E%EF%BD%9C%E6%B3%95%E5%9B%BD%E9%A6%86%E7%89%B9%E5%B1%95-badass-%E5%A5%B3%E8%8B%B1%E9%9B%84%E7%BE%A4%E5%83%8F-%E6%98%AF%E6%97%B6%E5%80%99%E6%8A%8A%E6%B3%95%E5%9B%BD%E5%84%BF%E5%B0%91%E6%BC%AB%E7%94%BB%E8%88%9E%E5%8F%B0%E8%AE%A9%E7%BB%99%E5%A5%B3%E8%8B%B1%E9%9B%84%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790769399000.webp","sourceId":"rfi"},{"id":1790768788000,"createdDate":"2026-09-30 11:46","name":"法国国际广播电台","title":"电子垃圾回收商文件造假 印度税务部门指海尔印度等3家电公司存在失察","content":"一份政府公告显示，印度税务部门指责中国家电生产企业海尔的印度子公司、印度工程与制造企Godrej&Boyce（G&B）和家用电器公司蓝星（BlueStar）等家电制造商存在失察，未能识别出一家回收商伪造的文件；这些制造商本应依靠该回收商来实现环保目标，但后者实际上并未从事电子废弃物回收业务。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260930-%E7%94%B5%E5%AD%90%E5%9E%83%E5%9C%BE%E5%9B%9E%E6%94%B6%E5%95%86%E6%96%87%E4%BB%B6%E9%80%A0%E5%81%87-%E5%8D%B0%E5%BA%A6%E7%A8%8E%E5%8A%A1%E9%83%A8%E9%97%A8%E6%8C%87%E6%B5%B7%E5%B0%94%E5%8D%B0%E5%BA%A6%E7%AD%893%E5%AE%B6%E7%94%B5%E5%85%AC%E5%8F%B8%E5%AD%98%E5%9C%A8%E5%A4%B1%E5%AF%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790768788000.webp","sourceId":"rfi"},{"id":1790766666000,"createdDate":"2026-09-30 11:11","name":"法国国际广播电台","title":"十一国庆前夕，中国进一步强化动员法为哪桩？","content":"大家好，欢迎收听法国报纸摘要。法国国家统计局周二29日发布报告说，截至今年第二季度末，法国公共债务达到国内生产总值119%，创下战后新高，周三9月30日出刊的法国各大日报头版无不围绕此一主题开展。《费加罗报》指出，在布鲁塞尔和其他欧洲国家的首都，人们正密切关注法国的利率曲线和总统选举的民调结果。政治不稳定加剧了市场的紧张情绪，对系统性危机的担忧正在蔓延。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260930-%E5%8D%81%E4%B8%80%E5%9B%BD%E5%BA%86%E5%89%8D%E5%A4%95%EF%BC%8C%E4%B8%AD%E5%9B%BD%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%BC%BA%E5%8C%96%E5%8A%A8%E5%91%98%E6%B3%95%E4%B8%BA%E5%93%AA%E6%A1%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790766666000.webp","sourceId":"rfi"},{"id":1790763799000,"createdDate":"2026-09-30 10:23","name":"法国国际广播电台","title":"美国制裁13个与伊朗武器采购有关的实体和个人 含伊朗军方后勤部驻京代表","content":"美国特朗普政府周二宣布对13个个人和实体实施新一轮制裁，其中包括位于俄罗斯、中国大陆、香港和巴基斯坦的机构或个人；美方指控这些对象协助伊朗采购武器及相关零部件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260930-%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%8113%E4%B8%AA%E4%B8%8E%E4%BC%8A%E6%9C%97%E6%AD%A6%E5%99%A8%E9%87%87%E8%B4%AD%E6%9C%89%E5%85%B3%E7%9A%84%E5%AE%9E%E4%BD%93%E5%92%8C%E4%B8%AA%E4%BA%BA-%E5%90%AB%E4%BC%8A%E6%9C%97%E5%86%9B%E6%96%B9%E5%90%8E%E5%8B%A4%E9%83%A8%E9%A9%BB%E4%BA%AC%E4%BB%A3%E8%A1%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790763799000.webp","sourceId":"rfi"},{"id":1790761294000,"createdDate":"2026-09-30 09:41","name":"法国国际广播电台","title":"一架从阿联酋飞往特拉维夫的航班迫降沙特 以官员：迹象指副驾驶曾试图坠毁飞机","content":"一名以色列官员周三表示，一架从阿联酋飞往以色列的航班在飞行途中，因飞行员之间发生打斗而发出紧急信号，随后改道飞往沙特阿拉伯。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260930-%E4%B8%80%E6%9E%B6%E4%BB%8E%E9%98%BF%E8%81%94%E9%85%8B%E9%A3%9E%E5%BE%80%E7%89%B9%E6%8B%89%E7%BB%B4%E5%A4%AB%E7%9A%84%E8%88%AA%E7%8F%AD%E8%BF%AB%E9%99%8D%E6%B2%99%E7%89%B9-%E4%BB%A5%E5%AE%98%E5%91%98-%E8%BF%B9%E8%B1%A1%E6%8C%87%E9%A3%9E%E8%A1%8C%E5%91%98%E6%9B%BE%E8%AF%95%E5%9B%BE%E5%9D%A0%E6%AF%81%E9%A3%9E%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790761294000.webp","sourceId":"rfi"},{"id":1790760693000,"createdDate":"2026-09-30 09:31","name":"法国国际广播电台","title":"中国证监会前主席易会满涉贪腐 移交法院受审","content":"法新社引述中国官媒新华社周三（9月30号）报道，中国当局已下令将前证券监督管理委员会主席易会满逮捕移送法院，就其涉嫌腐败指控案进行审判。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260930-%E4%B8%AD%E5%9B%BD%E8%AF%81%E7%9B%91%E4%BC%9A%E5%89%8D%E4%B8%BB%E5%B8%AD%E6%98%93%E4%BC%9A%E6%BB%A1%E6%B6%89%E8%B4%AA%E8%85%90-%E7%A7%BB%E4%BA%A4%E6%B3%95%E9%99%A2%E5%8F%97%E5%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790760693000.webp","sourceId":"rfi"},{"id":1790759481000,"createdDate":"2026-09-30 09:11","name":"法国国际广播电台","title":"特朗普政府已遣返2.5万人  最高法院再开绿灯：暂准第三国遣返继续进行","content":"在保守派占据多数的背景下，美国最高法院周二（9月29日）裁定，在法官审议相关政策是否合法期间，特朗普政府目前可以继续迅速将移民遣送至其原籍国以外的第三国。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260930-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%B7%B2%E9%81%A3%E8%BF%942-5%E4%B8%87%E4%BA%BA-%E6%9C%80%E9%AB%98%E6%B3%95%E9%99%A2%E5%86%8D%E5%BC%80%E7%BB%BF%E7%81%AF-%E6%9A%82%E5%87%86%E7%AC%AC%E4%B8%89%E5%9B%BD%E9%81%A3%E8%BF%94%E7%BB%A7%E7%BB%AD%E8%BF%9B%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790759481000.webp","sourceId":"rfi"},{"id":1790759345000,"createdDate":"2026-09-30 09:09","name":"法国国际广播电台","title":"美国国家档案馆原准备展出《旧金山和约》中方表不悦后撤下","content":"据美国全国公共广播电台（NPR）报导，上周五，美国国家档案馆为迎接特朗普总统和中国国家主席习近平做好了准备。当天上午，该博物馆主大厅中央摆放了一张长桌，黑色桌布上设有一个临时展台，展示着一块来自中国长城的砖石，以及一件由清朝皇帝赠予的精美19世纪卷轴。然而，据一位因未获授权公开发言而要求匿名的中国外交官透露，由于活动安排发生“最后一刻”变动，整个陈列被撤下了。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260930-%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%AE%B6%E6%A1%A3%E6%A1%88%E9%A6%86%E5%8E%9F%E5%87%86%E5%A4%87%E5%B1%95%E5%87%BA-%E6%97%A7%E9%87%91%E5%B1%B1%E5%92%8C%E7%BA%A6-%E4%B8%AD%E6%96%B9%E8%A1%A8%E4%B8%8D%E6%82%A6%E5%90%8E%E6%92%A4%E4%B8%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790759345000.webp","sourceId":"rfi"},{"id":1790755249000,"createdDate":"2026-09-30 08:00","name":"法国国际广播电台","title":"九合一选举台北市选战激烈 最新民调显示民进党在台北市好感度破50%","content":"台湾九合一选举剩下不到两个月，民调专家戴立安29日公布最新《2026年9月台湾民心调查》显示，台北市长选战以40.6%的关注度超越其他县市。民进党的好感度不仅在全国达47.4%，台北市民对民进党好感度更罕见地远高于南部。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260930-%E4%B9%9D%E5%90%88%E4%B8%80%E9%80%89%E4%B8%BE%E5%8F%B0%E5%8C%97%E5%B8%82%E9%80%89%E6%88%98%E6%BF%80%E7%83%88-%E6%9C%80%E6%96%B0%E6%B0%91%E8%B0%83%E6%98%BE%E7%A4%BA%E6%B0%91%E8%BF%9B%E5%85%9A%E5%9C%A8%E5%8F%B0%E5%8C%97%E5%B8%82%E5%A5%BD%E6%84%9F%E5%BA%A6%E7%A0%B450","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790755249000.webp","sourceId":"rfi"},{"id":1790754153000,"createdDate":"2026-09-30 07:42","name":"法国国际广播电台","title":"日本外相反驳中朝反对联合国削除“敌国条款”","content":"在9月22日的联合国大会演讲中，日本首相高市早苗要求删除《联合国宪章》中的“敌国条款”，对此，中国和朝鲜于28日表示反对。日本外相茂木敏充在29日的记者会上，就中朝反对日本要求删除《联合国宪章》“敌国条款”一事表示：“任何国家都没有援引该条款的余地。”以此对中朝进行牵制。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260930-%E6%97%A5%E6%9C%AC%E5%A4%96%E7%9B%B8%E5%8F%8D%E9%A9%B3%E4%B8%AD%E6%9C%9D%E5%8F%8D%E5%AF%B9%E8%81%94%E5%90%88%E5%9B%BD%E5%89%8A%E9%99%A4-%E6%95%8C%E5%9B%BD%E6%9D%A1%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790754153000.webp","sourceId":"rfi"},{"id":1790752584000,"createdDate":"2026-09-30 07:16","name":"法国国际广播电台","title":"网媒记者以发布假消息煽动被捕 港国安例下首人","content":"香港警方国安处今早拘捕两人，指他们发布假消息煽动，其中一人是一人网媒「BoomNews-爆炸头」的创办人兼记者邓浩荣，是公开资料中，首名被当局以国安条例中的新煽动罪拘捕的记者。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260930-%E7%BD%91%E5%AA%92%E8%AE%B0%E8%80%85%E4%BB%A5%E5%8F%91%E5%B8%83%E5%81%87%E6%B6%88%E6%81%AF%E7%85%BD%E5%8A%A8%E8%A2%AB%E6%8D%95-%E6%B8%AF%E5%9B%BD%E5%AE%89%E4%BE%8B%E4%B8%8B%E9%A6%96%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790752584000.webp","sourceId":"rfi"},{"id":1790752335000,"createdDate":"2026-09-30 07:12","name":"法国国际广播电台","title":"泰晤士世界大学排名：香港五大跻身50强 惟「产业」力降 多元化须加强","content":"根据最新的泰晤士高等教育世界大学排名(简称THE)，中国的清华大学上升一级排名全球第11位，创历史佳绩，亦是连续九年排名亚洲首位；香港五间大学继续跻身百强，进入五十强的分别是香港大学和中文大学，成绩与去年相若。不过，THE指出，香港国际生和合作多来自中国内地，若要维持佳绩，须在人才及跨境合作上更加多元化。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260930-%E6%B3%B0%E6%99%A4%E5%A3%AB%E4%B8%96%E7%95%8C%E5%A4%A7%E5%AD%A6%E6%8E%92%E5%90%8D-%E9%A6%99%E6%B8%AF%E4%BA%94%E5%A4%A7%E8%B7%BB%E8%BA%AB50%E5%BC%BA-%E6%83%9F-%E4%BA%A7%E4%B8%9A-%E5%8A%9B%E9%99%8D-%E5%A4%9A%E5%85%83%E5%8C%96%E9%A1%BB%E5%8A%A0%E5%BC%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790752335000.webp","sourceId":"rfi"},{"id":1790801770000,"createdDate":"2026-09-30 20:56","name":"法国国际广播电台","title":"默茨希望“进一步改善”对乌克兰的援助","content":"据德国《商报》报道，德国总理默茨希望进一步加强对乌克兰的支持，并就此与合作伙伴展开磋商。重点包括财政援助以及为乌克兰防空系统提供补给。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260930-%E9%BB%98%E8%8C%A8%E5%B8%8C%E6%9C%9B-%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%94%B9%E5%96%84-%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0%E7%9A%84%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790801770000.webp","sourceId":"rfi"},{"id":1790801139000,"createdDate":"2026-09-30 20:45","name":"法国国际广播电台","title":"特朗普称从伊拉克撤军是美国的“胜利”","content":"9月30日，特朗普称美国领导的打击“伊斯兰国”联盟最后一批部队撤出伊拉克是一场“胜利”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260930-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%BB%8E%E4%BC%8A%E6%8B%89%E5%85%8B%E6%92%A4%E5%86%9B%E6%98%AF%E7%BE%8E%E5%9B%BD%E7%9A%84-%E8%83%9C%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790801139000.webp","sourceId":"rfi"},{"id":1790801026000,"createdDate":"2026-09-30 20:43","name":"法国国际广播电台","title":"美贸易代表推G20联手应对中国钢铁过剩","content":"美国贸易代表格里尔（JamiesonGreer）30日表示，美国将在本周二十国集团（G20）贸易部长会议，推动一项新的钢铁产能过剩协调框架。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260930-%E7%BE%8E%E8%B4%B8%E6%98%93%E4%BB%A3%E8%A1%A8%E6%8E%A8g20%E8%81%94%E6%89%8B%E5%BA%94%E5%AF%B9%E4%B8%AD%E5%9B%BD%E9%92%A2%E9%93%81%E8%BF%87%E5%89%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790801026000.webp","sourceId":"rfi"},{"id":1790800611000,"createdDate":"2026-09-30 20:36","name":"法国国际广播电台","title":"美说唱歌手演唱会被俄方取消","content":"美国说唱歌手坎耶·维斯特（KanyeWest）原定于10月在俄罗斯举行的演唱会已被取消。主办方周三宣布了这一消息。此前数周，围绕此次演唱会的种种不确定性一直悬而未决，而演唱会的消息也曾在饱受战火蹂躏的俄罗斯引发轩然大波。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260930-%E7%BE%8E%E8%AF%B4%E5%94%B1%E6%AD%8C%E6%89%8B%E6%BC%94%E5%94%B1%E4%BC%9A%E8%A2%AB%E4%BF%84%E6%96%B9%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790800611000.webp","sourceId":"rfi"},{"id":1790800532000,"createdDate":"2026-09-30 20:35","name":"法国国际广播电台","title":"英国“西藏观察”报告：无人机如何成为《高原上的眼睛》","content":"英国人权组织“西藏观察”(TibetWatch)星期三(9月30日)发布调查报告称，中国当局正在西藏建立从警用无人机、自动机巢到反无人机设备的空中管控体系。报告也呼吁英国政府，重新审查对中国无人机的相关采购。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260930-%E8%8B%B1%E5%9B%BD-%E8%A5%BF%E8%97%8F%E8%A7%82%E5%AF%9F-%E6%8A%A5%E5%91%8A-%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%A6%82%E4%BD%95%E6%88%90%E4%B8%BA-%E9%AB%98%E5%8E%9F%E4%B8%8A%E7%9A%84%E7%9C%BC%E7%9D%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790800532000.webp","sourceId":"rfi"},{"id":1790800100000,"createdDate":"2026-09-30 20:28","name":"法国国际广播电台","title":"俄召见丹麦大使   抗议“不专业且具挑衅性的行为”","content":"俄罗斯周三召见丹麦驻莫斯科大使，就9月中旬发生在波罗的海的一起涉及俄罗斯军舰和丹麦军用直升机的事件提出抗议。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260930-%E4%BF%84%E5%8F%AC%E8%A7%81%E4%B8%B9%E9%BA%A6%E5%A4%A7%E4%BD%BF-%E6%8A%97%E8%AE%AE-%E4%B8%8D%E4%B8%93%E4%B8%9A%E4%B8%94%E5%85%B7%E6%8C%91%E8%A1%85%E6%80%A7%E7%9A%84%E8%A1%8C%E4%B8%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790800100000.webp","sourceId":"rfi"},{"id":1790799921000,"createdDate":"2026-09-30 20:25","name":"法国国际广播电台","title":"巴西与美国就贸易问题举行会晤","content":"巴西外交部长毛罗·维埃拉（MauroVieira）和贸易部长马尔西奥·埃利亚斯·罗萨（MarcioEliasRosa）在美国密尔沃基（Milwaukee）举行的二十国集团（G20）贸易部长会议期间会见了美国贸易代表杰米森·格里尔。巴西外交部称此次会晤“富有建设性”，并在新闻稿中表示，双方讨论了“双边贸易议程的主要议题”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260930-%E5%B7%B4%E8%A5%BF%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%B0%B1%E8%B4%B8%E6%98%93%E9%97%AE%E9%A2%98%E4%B8%BE%E8%A1%8C%E4%BC%9A%E6%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790799921000.webp","sourceId":"rfi"},{"id":1790799806000,"createdDate":"2026-09-30 20:23","name":"法国国际广播电台","title":"法达飞海运公司被迫削减船队规模","content":"法国航运公司达飞海运集团（CMACGM）将缩减其原计划在法注册的船队规模，以应对法国政府即将于2027年开征的企业巨额利益特例税（Surtaxeexceptionnelle）。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260930-%E6%B3%95%E8%BE%BE%E9%A3%9E%E6%B5%B7%E8%BF%90%E5%85%AC%E5%8F%B8%E8%A2%AB%E8%BF%AB%E5%89%8A%E5%87%8F%E8%88%B9%E9%98%9F%E8%A7%84%E6%A8%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790799806000.webp","sourceId":"rfi"},{"id":1790799303000,"createdDate":"2026-09-30 20:15","name":"法国国际广播电台","title":"卡塔尔UCC Oil and Gas Holding：“委内瑞拉是值得投资的地方”","content":"一场在加拉加斯举行的“委内瑞拉国际石油和天然气峰会”9月30日将闭幕，它吸引了约650名高级别代表与会，聚焦委内瑞拉重返全球能源体系及油气产业的复苏。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260930-%E5%8D%A1%E5%A1%94%E5%B0%94ucc-oil-and-gas-holding-%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%98%AF%E5%80%BC%E5%BE%97%E6%8A%95%E8%B5%84%E7%9A%84%E5%9C%B0%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790799303000.webp","sourceId":"rfi"},{"id":1790796996000,"createdDate":"2026-09-30 19:36","name":"法国国际广播电台","title":"一架从迪拜飞往以色列航班流血惊魂一幕 多亏乘客机智英勇","content":"一架从迪拜飞往以色列的客机周三（9月30日）发生极其严重的安全事件。事件发生后，以色列总理内塔尼亚胡率先发布视频讲述事件情况，以色列国防部长伊斯雷尔‧卡茨（IsraelKatz）将这起事件称为一起未遂的“恐怖主义袭击”，并表示，正是多名以色列乘客的英勇行为，才使这一恐袭得以挫败。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260930-%E4%B8%80%E6%9E%B6%E4%BB%8E%E8%BF%AA%E6%8B%9C%E9%A3%9E%E5%BE%80%E4%BB%A5%E8%89%B2%E5%88%97%E8%88%AA%E7%8F%AD%E6%B5%81%E8%A1%80%E6%83%8A%E9%AD%82%E4%B8%80%E5%B9%95-%E5%A4%9A%E4%BA%8F%E4%B9%98%E5%AE%A2%E6%9C%BA%E6%99%BA%E8%8B%B1%E5%8B%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790796996000.webp","sourceId":"rfi"},{"id":1790790309000,"createdDate":"2026-09-30 17:45","name":"法国国际广播电台","title":"视频 面对美国关税措施 加拿大商家面临更多挑战","content":"随着美国对加拿大包括酒类进口的禁令于周二（9月29日）生效，加拿大各省推出国内消费行动，不过也有挑战，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260930-%E8%A7%86%E9%A2%91-%E9%9D%A2%E5%AF%B9%E7%BE%8E%E5%9B%BD%E5%85%B3%E7%A8%8E%E6%8E%AA%E6%96%BD-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%95%86%E5%AE%B6%E9%9D%A2%E4%B8%B4%E6%9B%B4%E5%A4%9A%E6%8C%91%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790790309000.webp","sourceId":"rfi"},{"id":1790788466000,"createdDate":"2026-09-30 17:14","name":"法国国际广播电台","title":"特朗普会见习近平期间的几大“外交失误”","content":"10月1日出刊的法国世界报与亚洲地区相关的报道有两则。首先一起来看世界报聚焦的中美元首最新会谈，和期间的外交细节。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260930-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BC%9A%E8%A7%81%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%9C%9F%E9%97%B4%E7%9A%84%E5%87%A0%E5%A4%A7-%E5%A4%96%E4%BA%A4%E5%A4%B1%E8%AF%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790788466000.webp","sourceId":"rfi"},{"id":1790788166000,"createdDate":"2026-09-30 17:09","name":"法国国际广播电台","title":"韩国要求朝鲜立即停止边界加固工事 就地雷爆炸事件道歉","content":"韩国联合参谋本部周三（9月30日）表示，朝鲜应立即停止边境加固工事，并就非军事区（DMZ）发生的地雷爆炸事件道歉。朝鲜前日否认首尔指控，反呛韩方借爆炸事件捏造“物证”挑衅朝鲜，其做法“非常荒谬”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260930-%E9%9F%A9%E5%9B%BD%E8%A6%81%E6%B1%82%E6%9C%9D%E9%B2%9C%E7%AB%8B%E5%8D%B3%E5%81%9C%E6%AD%A2%E8%BE%B9%E7%95%8C%E5%8A%A0%E5%9B%BA%E5%B7%A5%E4%BA%8B-%E5%B0%B1%E5%9C%B0%E9%9B%B7%E7%88%86%E7%82%B8%E4%BA%8B%E4%BB%B6%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790788166000.webp","sourceId":"rfi"},{"id":1790786883000,"createdDate":"2026-09-30 16:48","name":"法国国际广播电台","title":"实施一年后效果不尽人意，英法讨论终止“以一换一”移民协议","content":"路透社9月30日消息，法国政府当天透露，法国正在和英国讨论终止一项协议。根据该协议，乘坐小型船只抵达英国领土的移民，将被送返至法国领土。该协议即将到期，法国政府将不再寻求延续这一协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260930-%E5%AE%9E%E6%96%BD%E4%B8%80%E5%B9%B4%E5%90%8E%E6%95%88%E6%9E%9C%E4%B8%8D%E5%B0%BD%E4%BA%BA%E6%84%8F%EF%BC%8C%E8%8B%B1%E6%B3%95%E8%AE%A8%E8%AE%BA%E7%BB%88%E6%AD%A2-%E4%BB%A5%E4%B8%80%E6%8D%A2%E4%B8%80-%E7%A7%BB%E6%B0%91%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790786883000.webp","sourceId":"rfi"},{"id":1790785804000,"createdDate":"2026-09-30 16:30","name":"法国国际广播电台","title":"美众议员要求鲁比奥警惕韩中关系回暖 共和党高层首对F-35零部件事件表关切","content":"美国众议院美国与中共战略竞争特设委员会主席、共和党籍联邦众议员穆勒纳尔（JohnMoolenaar）呼吁特朗普政府审视盟国——韩国与中国日益升温的关系，称这种关系对美国构成“重大风险”。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260930-%E7%BE%8E%E4%BC%97%E8%AE%AE%E5%91%98%E8%A6%81%E6%B1%82%E9%B2%81%E6%AF%94%E5%A5%A5%E8%AD%A6%E6%83%95%E9%9F%A9%E4%B8%AD%E5%85%B3%E7%B3%BB%E5%9B%9E%E6%9A%96-%E5%85%B1%E5%92%8C%E5%85%9A%E9%AB%98%E5%B1%82%E9%A6%96%E5%AF%B9f-35%E9%9B%B6%E9%83%A8%E4%BB%B6%E4%BA%8B%E4%BB%B6%E8%A1%A8%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790785804000.webp","sourceId":"rfi"},{"id":1790781837000,"createdDate":"2026-09-30 15:23","name":"法国国际广播电台","title":"英安全事务国务大臣致信所有高校 促与军情五处所指中国机构终止关系","content":"据路透社报导，英国军情五处（MI5）周三发布了一份前所未有的警报，警告称一家中国机构代表中方国家安全部门，为人工智能（AI）等领域的学术研究提供资金。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260930-%E8%8B%B1%E5%AE%89%E5%85%A8%E4%BA%8B%E5%8A%A1%E5%9B%BD%E5%8A%A1%E5%A4%A7%E8%87%A3%E8%87%B4%E4%BF%A1%E6%89%80%E6%9C%89%E9%AB%98%E6%A0%A1-%E4%BF%83%E4%B8%8E%E5%86%9B%E6%83%85%E4%BA%94%E5%A4%84%E6%89%80%E6%8C%87%E4%B8%AD%E5%9B%BD%E6%9C%BA%E6%9E%84%E7%BB%88%E6%AD%A2%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/30/1790781837000.webp","sourceId":"rfi"}]