[{"id":1789819381000,"createdDate":"2026-09-19 12:03","name":"法国国际广播电台","title":"贝森特、格里尔周日在纽约会见何立峰 将讨论AI、贸易、稀土等经贸议题","content":"据一位知情人士透露，美国财政部长贝森特（ScottBessent）计划于本周末在纽约与中国国务院副总理何立峰举行会晤，讨论人工智能、贸易、稀土等经贸议题。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260919-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E6%A0%BC%E9%87%8C%E5%B0%94%E5%91%A8%E6%97%A5%E5%9C%A8%E7%BA%BD%E7%BA%A6%E4%BC%9A%E8%A7%81%E4%BD%95%E7%AB%8B%E5%B3%B0-%E5%B0%86%E8%AE%A8%E8%AE%BAai-%E8%B4%B8%E6%98%93-%E7%A8%80%E5%9C%9F%E7%AD%89%E7%BB%8F%E8%B4%B8%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789819381000.webp","sourceId":"rfi"},{"id":1789816649000,"createdDate":"2026-09-19 11:17","name":"法国国际广播电台","title":"中国年轻世代性欲消失了？ 消费低迷导致「性萧条」连亲密关系成本都负担不起","content":"2024年的「中国人私生活质量调查」中显示出年轻一代的性活跃度在下降，相当大比例的中国年轻人处于无性婚姻或关系中。在微博、小红书等社媒上一搜也能看到「连亲密关系成本都负担不起」、「避孕套销售缩水」等热门关键字。难道中国Z世代被社会负担压垮到正处于「低欲望社会」？看看中国网友们怎么说。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260919-%E4%B8%AD%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%B8%96%E4%BB%A3%E6%80%A7%E6%AC%B2%E6%B6%88%E5%A4%B1%E4%BA%86-%E6%B6%88%E8%B4%B9%E4%BD%8E%E8%BF%B7%E5%AF%BC%E8%87%B4-%E6%80%A7%E8%90%A7%E6%9D%A1-%E8%BF%9E%E4%BA%B2%E5%AF%86%E5%85%B3%E7%B3%BB%E6%88%90%E6%9C%AC%E9%83%BD%E8%B4%9F%E6%8B%85%E4%B8%8D%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789816649000.webp","sourceId":"rfi"},{"id":1789816415000,"createdDate":"2026-09-19 11:13","name":"法国国际广播电台","title":"中国：西方的失败？","content":"各位好，本周末线上出刊的法国主流媒体对中国的报道数量多、角度丰富。首先一起来看巴黎人报报道的，尽管担心中国会研究其技术，美国政府依旧批准向沙特出售48架F35战机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260919-%E4%B8%AD%E5%9B%BD-%E8%A5%BF%E6%96%B9%E7%9A%84%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789816415000.webp","sourceId":"rfi"},{"id":1789813361000,"createdDate":"2026-09-19 10:22","name":"法国国际广播电台","title":"美据报正考虑推迟对台重大军售 直至11月深圳APEC峰会之后","content":"据《南华早报》援引多位消息人士报导称，美国正考虑推迟宣布对台重大军售，直至11月在深圳举行的亚太经合组织（APEC）峰会之后。此次可能出现的推迟正值中国国家主席习近平准备于下周前往华盛顿进行国事访问之际。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%BE%8E%E6%8D%AE%E6%8A%A5%E6%AD%A3%E8%80%83%E8%99%91%E6%8E%A8%E8%BF%9F%E5%AF%B9%E5%8F%B0%E9%87%8D%E5%A4%A7%E5%86%9B%E5%94%AE-%E7%9B%B4%E8%87%B311%E6%9C%88%E6%B7%B1%E5%9C%B3apec%E5%B3%B0%E4%BC%9A%E4%B9%8B%E5%90%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789813361000.webp","sourceId":"rfi"},{"id":1789811145000,"createdDate":"2026-09-19 09:45","name":"法国国际广播电台","title":"白宫公布习近平下周访美行程 特朗普：成千上万的人都想参加这场国宴","content":"白宫公布了美国总统特朗普（DonaldTrump）与中国国家主席习近平计划会晤的行程安排。习近平上次对美国进行国事访问是在2015年9月，当时正值民主党人奥巴马执政期间。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%99%BD%E5%AE%AB%E5%85%AC%E5%B8%83%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%8B%E5%91%A8%E8%AE%BF%E7%BE%8E%E8%A1%8C%E7%A8%8B-%E7%89%B9%E6%9C%97%E6%99%AE-%E6%88%90%E5%8D%83%E4%B8%8A%E4%B8%87%E7%9A%84%E4%BA%BA%E9%83%BD%E6%83%B3%E5%8F%82%E5%8A%A0%E8%BF%99%E5%9C%BA%E5%9B%BD%E5%AE%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789811145000.webp","sourceId":"rfi"},{"id":1789808505000,"createdDate":"2026-09-19 09:01","name":"法国国际广播电台","title":"分析师用AI协助生产情报险促美军对载有“核武器项目部件”的中国船只武装登船","content":"据美国有线电视新闻网（CNN）报导，今年春季，正值伊朗战争之际，一份在美国军方内部流传的情报报告立即引发了警报：一艘位于中东地区的中国船只正在运输核武器项目的相关部件。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260919-%E5%88%86%E6%9E%90%E5%B8%88%E7%94%A8ai%E5%8D%8F%E5%8A%A9%E7%94%9F%E4%BA%A7%E6%83%85%E6%8A%A5%E9%99%A9%E4%BF%83%E4%BD%BF%E7%BE%8E%E5%86%9B%E5%AF%B9%E8%BD%BD%E6%9C%89-%E6%A0%B8%E6%AD%A6%E5%99%A8%E9%A1%B9%E7%9B%AE%E9%83%A8%E4%BB%B6-%E7%9A%84%E4%B8%AD%E5%9B%BD%E8%88%B9%E5%8F%AA%E6%AD%A6%E8%A3%85%E7%99%BB%E8%88%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789808505000.webp","sourceId":"rfi"},{"id":1789807194000,"createdDate":"2026-09-19 08:39","name":"法国国际广播电台","title":"美国升级对俄制裁：可对中印等俄能源进口国征收最高100%关税","content":"周五（9月18日），美国总统特朗普签署了一项法案，旨在对俄罗斯实施新的制裁措施，重点针对俄罗斯能源领域。这项法案是特朗普重返白宫以来，美国国会针对俄罗斯采取的首个重大行动。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%BE%8E%E5%9B%BD%E5%8D%87%E7%BA%A7%E5%AF%B9%E4%BF%84%E5%88%B6%E8%A3%81-%E5%8F%AF%E5%AF%B9%E4%B8%AD%E5%8D%B0%E7%AD%89%E4%BF%84%E8%83%BD%E6%BA%90%E8%BF%9B%E5%8F%A3%E5%9B%BD%E5%BE%81%E6%94%B6%E6%9C%80%E9%AB%98100-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789807194000.webp","sourceId":"rfi"},{"id":1789806315000,"createdDate":"2026-09-19 08:25","name":"法国国际广播电台","title":"日美防长举行电话会谈  一致表示将强化日美同盟的威慑力","content":"日本时间9月18日晚上，日本防卫大臣小泉进次郎与美国国防部长赫格塞思举行了约10分钟的电话会谈。在会谈中，两防长一致表示将强化日美同盟的威慑力。日本防卫省19日公布了这一消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260919-%E6%97%A5%E7%BE%8E%E9%98%B2%E9%95%BF%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88-%E4%B8%80%E8%87%B4%E8%A1%A8%E7%A4%BA%E5%B0%86%E5%BC%BA%E5%8C%96%E6%97%A5%E7%BE%8E%E5%90%8C%E7%9B%9F%E7%9A%84%E5%A8%81%E6%85%91%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789806315000.webp","sourceId":"rfi"},{"id":1789802984000,"createdDate":"2026-09-19 07:29","name":"法国国际广播电台","title":"俄版微信快速普及，监控能力引担忧","content":"综合费加罗报、回声报、卫报等消息，随着俄罗斯议会选举的启动，一款应用程序Max再次受到关注。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260919-%E4%BF%84%E7%89%88%E5%BE%AE%E4%BF%A1%E5%BF%AB%E9%80%9F%E6%99%AE%E5%8F%8A%EF%BC%8C%E7%9B%91%E6%8E%A7%E8%83%BD%E5%8A%9B%E5%BC%95%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789802984000.webp","sourceId":"rfi"}]