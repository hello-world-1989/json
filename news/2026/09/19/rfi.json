[{"id":1789819381000,"createdDate":"2026-09-19 12:03","name":"法国国际广播电台","title":"贝森特、格里尔周日在纽约会见何立峰 将讨论AI、贸易、稀土等经贸议题","content":"据一位知情人士透露，美国财政部长贝森特（ScottBessent）计划于本周末在纽约与中国国务院副总理何立峰举行会晤，讨论人工智能、贸易、稀土等经贸议题。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260919-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E6%A0%BC%E9%87%8C%E5%B0%94%E5%91%A8%E6%97%A5%E5%9C%A8%E7%BA%BD%E7%BA%A6%E4%BC%9A%E8%A7%81%E4%BD%95%E7%AB%8B%E5%B3%B0-%E5%B0%86%E8%AE%A8%E8%AE%BAai-%E8%B4%B8%E6%98%93-%E7%A8%80%E5%9C%9F%E7%AD%89%E7%BB%8F%E8%B4%B8%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789819381000.webp","sourceId":"rfi"},{"id":1789816649000,"createdDate":"2026-09-19 11:17","name":"法国国际广播电台","title":"中国年轻世代性欲消失了？ 消费低迷导致「性萧条」连亲密关系成本都负担不起","content":"2024年的「中国人私生活质量调查」中显示出年轻一代的性活跃度在下降，相当大比例的中国年轻人处于无性婚姻或关系中。在微博、小红书等社媒上一搜也能看到「连亲密关系成本都负担不起」、「避孕套销售缩水」等热门关键字。难道中国Z世代被社会负担压垮到正处于「低欲望社会」？看看中国网友们怎么说。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260919-%E4%B8%AD%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%B8%96%E4%BB%A3%E6%80%A7%E6%AC%B2%E6%B6%88%E5%A4%B1%E4%BA%86-%E6%B6%88%E8%B4%B9%E4%BD%8E%E8%BF%B7%E5%AF%BC%E8%87%B4-%E6%80%A7%E8%90%A7%E6%9D%A1-%E8%BF%9E%E4%BA%B2%E5%AF%86%E5%85%B3%E7%B3%BB%E6%88%90%E6%9C%AC%E9%83%BD%E8%B4%9F%E6%8B%85%E4%B8%8D%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789816649000.webp","sourceId":"rfi"},{"id":1789816415000,"createdDate":"2026-09-19 11:13","name":"法国国际广播电台","title":"中国：西方的失败？","content":"各位好，本周末线上出刊的法国主流媒体对中国的报道数量多、角度丰富。首先一起来看巴黎人报报道的，尽管担心中国会研究其技术，美国政府依旧批准向沙特出售48架F35战机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260919-%E4%B8%AD%E5%9B%BD-%E8%A5%BF%E6%96%B9%E7%9A%84%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789816415000.webp","sourceId":"rfi"},{"id":1789813361000,"createdDate":"2026-09-19 10:22","name":"法国国际广播电台","title":"美据报正考虑推迟对台重大军售 直至11月深圳APEC峰会之后","content":"据《南华早报》援引多位消息人士报导称，美国正考虑推迟宣布对台重大军售，直至11月在深圳举行的亚太经合组织（APEC）峰会之后。此次可能出现的推迟正值中国国家主席习近平准备于下周前往华盛顿进行国事访问之际。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%BE%8E%E6%8D%AE%E6%8A%A5%E6%AD%A3%E8%80%83%E8%99%91%E6%8E%A8%E8%BF%9F%E5%AF%B9%E5%8F%B0%E9%87%8D%E5%A4%A7%E5%86%9B%E5%94%AE-%E7%9B%B4%E8%87%B311%E6%9C%88%E6%B7%B1%E5%9C%B3apec%E5%B3%B0%E4%BC%9A%E4%B9%8B%E5%90%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789813361000.webp","sourceId":"rfi"},{"id":1789811145000,"createdDate":"2026-09-19 09:45","name":"法国国际广播电台","title":"白宫公布习近平下周访美行程 特朗普：成千上万的人都想参加这场国宴","content":"白宫公布了美国总统特朗普（DonaldTrump）与中国国家主席习近平计划会晤的行程安排。习近平上次对美国进行国事访问是在2015年9月，当时正值民主党人奥巴马执政期间。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%99%BD%E5%AE%AB%E5%85%AC%E5%B8%83%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%8B%E5%91%A8%E8%AE%BF%E7%BE%8E%E8%A1%8C%E7%A8%8B-%E7%89%B9%E6%9C%97%E6%99%AE-%E6%88%90%E5%8D%83%E4%B8%8A%E4%B8%87%E7%9A%84%E4%BA%BA%E9%83%BD%E6%83%B3%E5%8F%82%E5%8A%A0%E8%BF%99%E5%9C%BA%E5%9B%BD%E5%AE%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789811145000.webp","sourceId":"rfi"},{"id":1789808505000,"createdDate":"2026-09-19 09:01","name":"法国国际广播电台","title":"分析师用AI协助生产情报险促美军对载有“核武器项目部件”的中国船只武装登船","content":"据美国有线电视新闻网（CNN）报导，今年春季，正值伊朗战争之际，一份在美国军方内部流传的情报报告立即引发了警报：一艘位于中东地区的中国船只正在运输核武器项目的相关部件。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260919-%E5%88%86%E6%9E%90%E5%B8%88%E7%94%A8ai%E5%8D%8F%E5%8A%A9%E7%94%9F%E4%BA%A7%E6%83%85%E6%8A%A5%E9%99%A9%E4%BF%83%E4%BD%BF%E7%BE%8E%E5%86%9B%E5%AF%B9%E8%BD%BD%E6%9C%89-%E6%A0%B8%E6%AD%A6%E5%99%A8%E9%A1%B9%E7%9B%AE%E9%83%A8%E4%BB%B6-%E7%9A%84%E4%B8%AD%E5%9B%BD%E8%88%B9%E5%8F%AA%E6%AD%A6%E8%A3%85%E7%99%BB%E8%88%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789808505000.webp","sourceId":"rfi"},{"id":1789807194000,"createdDate":"2026-09-19 08:39","name":"法国国际广播电台","title":"美国升级对俄制裁：可对中印等俄能源进口国征收最高100%关税","content":"周五（9月18日），美国总统特朗普签署了一项法案，旨在对俄罗斯实施新的制裁措施，重点针对俄罗斯能源领域。这项法案是特朗普重返白宫以来，美国国会针对俄罗斯采取的首个重大行动。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%BE%8E%E5%9B%BD%E5%8D%87%E7%BA%A7%E5%AF%B9%E4%BF%84%E5%88%B6%E8%A3%81-%E5%8F%AF%E5%AF%B9%E4%B8%AD%E5%8D%B0%E7%AD%89%E4%BF%84%E8%83%BD%E6%BA%90%E8%BF%9B%E5%8F%A3%E5%9B%BD%E5%BE%81%E6%94%B6%E6%9C%80%E9%AB%98100-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789807194000.webp","sourceId":"rfi"},{"id":1789806315000,"createdDate":"2026-09-19 08:25","name":"法国国际广播电台","title":"日美防长举行电话会谈  一致表示将强化日美同盟的威慑力","content":"日本时间9月18日晚上，日本防卫大臣小泉进次郎与美国国防部长赫格塞思举行了约10分钟的电话会谈。在会谈中，两防长一致表示将强化日美同盟的威慑力。日本防卫省19日公布了这一消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260919-%E6%97%A5%E7%BE%8E%E9%98%B2%E9%95%BF%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88-%E4%B8%80%E8%87%B4%E8%A1%A8%E7%A4%BA%E5%B0%86%E5%BC%BA%E5%8C%96%E6%97%A5%E7%BE%8E%E5%90%8C%E7%9B%9F%E7%9A%84%E5%A8%81%E6%85%91%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789806315000.webp","sourceId":"rfi"},{"id":1789802984000,"createdDate":"2026-09-19 07:29","name":"法国国际广播电台","title":"俄版微信快速普及，监控能力引担忧","content":"综合费加罗报、回声报、卫报等消息，随着俄罗斯议会选举的启动，一款应用程序Max再次受到关注。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260919-%E4%BF%84%E7%89%88%E5%BE%AE%E4%BF%A1%E5%BF%AB%E9%80%9F%E6%99%AE%E5%8F%8A%EF%BC%8C%E7%9B%91%E6%8E%A7%E8%83%BD%E5%8A%9B%E5%BC%95%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789802984000.webp","sourceId":"rfi"},{"id":1789834238000,"createdDate":"2026-09-19 16:10","name":"法国国际广播电台","title":"美国牵头目标月底就应对钢铁产能过剩问题与诸多盟友达成共识","content":"尽管特朗普政府正与加拿大进行贸易战，且与欧盟的贸易紧张关系依然存在，但华盛顿仍在悄然推动建立一个主要由西方盟友组成的联盟，以应对中国庞大的钢铁产能过剩问题。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260919-%E7%BE%8E%E5%9B%BD%E7%89%B5%E5%A4%B4%E7%9B%AE%E6%A0%87%E6%9C%88%E5%BA%95%E5%B0%B1%E5%BA%94%E5%AF%B9%E9%92%A2%E9%93%81%E4%BA%A7%E8%83%BD%E8%BF%87%E5%89%A9%E9%97%AE%E9%A2%98%E4%B8%8E%E8%AF%B8%E5%A4%9A%E7%9B%9F%E5%8F%8B%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789834238000.webp","sourceId":"rfi"},{"id":1789830082000,"createdDate":"2026-09-19 15:01","name":"法国国际广播电台","title":"美中峰会前 20多名民主党议员促美高官与中方就AI风险启动持续、实质对话","content":"二十多位美国众议院民主党议员呼吁特朗普政府高层官员，就人工智能带来的安全风险与中方官员启动“持续对话”。在周五发出的一封联名信中，这些议员敦促美国国务卿鲁比奥（MarcoRubio）和财政部长贝森特（ScottBessent）推动美中之间就人工智能安全问题进行“持续且持久的外交”会谈；民主党人主张，此类讨论的持续时间应远超中国国家主席习近平下周对华盛顿访问的这一机遇。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%BE%8E%E4%B8%AD%E5%B3%B0%E4%BC%9A%E5%89%8D-20%E5%A4%9A%E5%90%8D%E6%B0%91%E4%B8%BB%E5%85%9A%E8%AE%AE%E5%91%98%E4%BF%83%E7%BE%8E%E9%AB%98%E5%AE%98%E4%B8%8E%E4%B8%AD%E6%96%B9%E5%B0%B1ai%E9%A3%8E%E9%99%A9%E5%90%AF%E5%8A%A8%E6%8C%81%E7%BB%AD-%E5%AE%9E%E8%B4%A8%E5%AF%B9%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789830082000.webp","sourceId":"rfi"},{"id":1789826169000,"createdDate":"2026-09-19 13:56","name":"法国国际广播电台","title":"中国持有美国国债降至2008年以来最低水平 真实规模难确切掌握","content":"美国财政部的最新数据显示，中国持有的美国国债规模在7月份降至18年来的最低水平。不仅是中国，多国政府都在减少购买美国国债，而对冲基金及其他私人投资者则填补了这一空缺。这给美国以低成本举债的能力带来了一定风险，因为分析人士指出，这可能会推高借贷成本。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260919-%E4%B8%AD%E5%9B%BD%E6%8C%81%E6%9C%89%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%80%BA%E9%99%8D%E8%87%B32008%E5%B9%B4%E4%BB%A5%E6%9D%A5%E6%9C%80%E4%BD%8E%E6%B0%B4%E5%B9%B3-%E7%9C%9F%E5%AE%9E%E8%A7%84%E6%A8%A1%E9%9A%BE%E7%A1%AE%E5%88%87%E6%8E%8C%E6%8F%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789826169000.webp","sourceId":"rfi"},{"id":1789823999000,"createdDate":"2026-09-19 13:19","name":"法国国际广播电台","title":"俄大使：赴华俄游客数量显著增长，上半年有160万俄罗斯游客访华","content":"自实行免签政策以来，赴华俄罗斯游客数量显著增长。俄罗斯驻华大使莫尔古洛夫周六表示，2026年上半年，共有160万俄罗斯游客到访中国。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260919-%E4%BF%84%E5%A4%A7%E4%BD%BF-%E8%B5%B4%E5%8D%8E%E4%BF%84%E6%B8%B8%E5%AE%A2%E6%95%B0%E9%87%8F%E6%98%BE%E8%91%97%E5%A2%9E%E9%95%BF%EF%BC%8C%E4%B8%8A%E5%8D%8A%E5%B9%B4%E6%9C%89160%E4%B8%87%E4%BF%84%E7%BD%97%E6%96%AF%E6%B8%B8%E5%AE%A2%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789823999000.webp","sourceId":"rfi"},{"id":1789821751000,"createdDate":"2026-09-19 12:42","name":"法国国际广播电台","title":"格陵兰争端得到妥善解决？特朗普宣布对该岛安全事务获“永久控制权”","content":"美国总统特朗普周五（9月18日）宣布，他已从丹麦和格陵兰方面获得对格陵兰安全事务的“永久控制权”。几个月前，特朗普曾信誓旦旦地说要将格陵兰直接并入美国，甚至不排除动用武力，因此引发了与欧洲盟友之间的重大外交危机。在美国中期选举前，渴望获得一些“外交成果”的特朗普又把注意力转向了格陵兰，促使这件事在本周五迎来了一个看似“圆满”的结局。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260919-%E6%A0%BC%E9%99%B5%E5%85%B0%E4%BA%89%E7%AB%AF%E5%BE%97%E5%88%B0%E5%A6%A5%E5%96%84%E8%A7%A3%E5%86%B3-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%AF%B9%E8%AF%A5%E5%B2%9B%E5%AE%89%E5%85%A8%E4%BA%8B%E5%8A%A1%E8%8E%B7-%E6%B0%B8%E4%B9%85%E6%8E%A7%E5%88%B6%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789821751000.webp","sourceId":"rfi"},{"id":1789856388000,"createdDate":"2026-09-19 22:19","name":"法国国际广播电台","title":"火车地缘政治与投资非洲筑铁路","content":"非洲的未来在于铁路。法国铁路专家克洛德·勒布朗（ClaudeLeblanc）在本台法国国际广播电台（RFI）作客接受法语《交通》专栏（Chroniquetransports）采访时表示，继中国之后，印度、土耳其等国家也纷纷投资非洲铁路建设。人们当前正处于铁路发展的第二个黄金时代（âged’or），而非洲国家正积极推动铁路的未来发展。铁路有助一个国家的团结。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260919-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E7%81%AB%E8%BD%A6%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E4%B8%8E%E6%8A%95%E8%B5%84%E9%9D%9E%E6%B4%B2%E7%AD%91%E9%93%81%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789856388000.webp","sourceId":"rfi"},{"id":1789854358000,"createdDate":"2026-09-19 21:45","name":"法国国际广播电台","title":"非洲:刚果(金)重判前司法部长","content":"非洲国家刚果民主共和国（RDCongo）终审法院（laCourdecassation）于2026年09月18日星期五判处该国前司法部长康斯坦·穆坦巴（ConstantMutamba）十年强迫劳动（travauxforcés），中文也有译作劳改。他被控挪用超过2000万美元，其中包括有争议的公共合同和有争议的受害者赔偿。这些钱款由一个特别基金(Frivao)管理用于赔偿和补偿2000年代刚果（金）东北部乌干达不法活动的受害者。辩方否认指控，谴责“政治司法阴谋”。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260919-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E9%87%91-%E9%87%8D%E5%88%A4%E5%89%8D%E5%8F%B8%E6%B3%95%E9%83%A8%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789854358000.webp","sourceId":"rfi"},{"id":1789850393000,"createdDate":"2026-09-19 20:39","name":"法国国际广播电台","title":"巴黎FC周六在足球法甲联赛中以2-1击败了斯特拉斯堡队","content":"巴黎FC（ParisFC）在足球法甲联赛中延续了开局不败的势头，周六以2-1击败了斯特拉斯堡队，这是主教练利亚姆·罗塞尼奥尔（LiamRosenior）的前东家；不过，这场比赛因客队球迷针对罗塞尼奥尔这位英国教练的辱骂性口号而蒙上了阴影。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260919-%E5%B7%B4%E9%BB%8Efc%E5%91%A8%E5%85%AD%E5%9C%A8%E8%B6%B3%E7%90%83%E6%B3%95%E7%94%B2%E8%81%94%E8%B5%9B%E4%B8%AD%E4%BB%A52-1%E5%87%BB%E8%B4%A5%E4%BA%86%E6%96%AF%E7%89%B9%E6%8B%89%E6%96%AF%E5%A0%A1%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789850393000.webp","sourceId":"rfi"},{"id":1789847795000,"createdDate":"2026-09-19 19:56","name":"法国国际广播电台","title":"美签署对俄制裁法案   中国商务部回应","content":"美国一项针对俄罗斯的制裁法令，或对中国等购买俄罗斯原油和天然气的主要买家征收高额关税。中国商务部回应称，反对以涉及第三方为由，对他国采取“次级制裁措施”，将继续密切关注美国后续举措。《世界报》表示，北京谴责美方未经联合国授权且“没有”国际法依据的“单边”措施。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260919-%E7%BE%8E%E7%AD%BE%E7%BD%B2%E5%AF%B9%E4%BF%84%E5%88%B6%E8%A3%81%E6%B3%95%E6%A1%88-%E4%B8%AD%E5%9B%BD%E5%95%86%E5%8A%A1%E9%83%A8%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789847795000.webp","sourceId":"rfi"},{"id":1789847276000,"createdDate":"2026-09-19 19:47","name":"法国国际广播电台","title":"马克龙到访北大西洋的法属群岛    卡尼将与之会合","content":"法国总统马克龙在前往纽约之前，19-20日首次到访北大西洋法属群岛圣皮埃尔-密克隆（Saint-Pierre-et-Miquelon）；加拿大总理卡尼将于9月20日与马克龙在此会合。爱丽舍宫强调，对法国而言，此次访问也是为了重申其“在通往美国和北极的门户”的“战略存在”，而俄罗斯和中国也对北极地区的新航道垂涎已久。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260919-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%B0%86%E5%88%B0%E8%AE%BF%E5%8C%97%E5%A4%A7%E8%A5%BF%E6%B4%8B%E7%9A%84%E6%B3%95%E5%B1%9E%E7%BE%A4%E5%B2%9B-%E5%8D%A1%E5%B0%BC%E5%B0%86%E4%B8%8E%E4%B9%8B%E4%BC%9A%E5%90%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789847276000.webp","sourceId":"rfi"},{"id":1789847042000,"createdDate":"2026-09-19 19:44","name":"法国国际广播电台","title":"“特朗普达成军事协议    但放弃吞并格陵兰的梦想”","content":"丹麦周六对美国总统特朗普宣布的一项“具有约束力”的协议表示欢迎。该协议赋予华盛顿对格陵兰岛安全的“永久控制权”，并禁止俄罗斯和中国在该北极地区设立军事基地。法新社表示：在格陵兰上，特朗普达成了一项军事协议，但放弃了此前吞并它的梦想。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260919-%E7%89%B9%E6%9C%97%E6%99%AE%E8%BE%BE%E6%88%90%E5%86%9B%E4%BA%8B%E5%8D%8F%E8%AE%AE-%E4%BD%86%E6%94%BE%E5%BC%83%E5%90%9E%E5%B9%B6%E6%A0%BC%E9%99%B5%E5%85%B0%E7%9A%84%E6%A2%A6%E6%83%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789847042000.webp","sourceId":"rfi"},{"id":1789846677000,"createdDate":"2026-09-19 19:37","name":"法国国际广播电台","title":"巴黎迎来盛大场面的Techno Parade","content":"时隔两年，巴黎19日迎来盛大的TechnoParade。电子音乐游行组织方Technopol的主席TommyVaudecrane表示：我们要把成千上万的人聚集在一起，回归喜悦、欢快。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260919-%E5%B7%B4%E9%BB%8E%E8%BF%8E%E6%9D%A5%E7%9B%9B%E5%A4%A7%E5%9C%BA%E9%9D%A2%E7%9A%84techno-parade","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789846677000.webp","sourceId":"rfi"},{"id":1789846451000,"createdDate":"2026-09-19 19:34","name":"法国国际广播电台","title":"橄榄球赛：日本夺太平洋国家杯冠军","content":"太平洋国家杯橄榄球决赛于周六在东京登场，地主日本队以20比15力克强敌斐济队，成功报了过去两届决赛落败的一箭之仇，夺下自2019年以来的首座赛事冠军。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260919-%E6%A9%84%E6%A6%84%E7%90%83%E8%B5%9B-%E6%97%A5%E6%9C%AC%E5%A4%BA%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%9B%BD%E5%AE%B6%E6%9D%AF%E5%86%A0%E5%86%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789846451000.webp","sourceId":"rfi"},{"id":1789845811000,"createdDate":"2026-09-19 19:23","name":"法国国际广播电台","title":"特朗普称将组建AI部队","content":"周六，特朗普对人工智能的批评者发起猛烈抨击，声称他绝不容忍任何阻碍该行业发展的行为，并宣布即将组建一支“人工智能部队”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260919-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%B0%86%E7%BB%84%E5%BB%BAai%E9%83%A8%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789845811000.webp","sourceId":"rfi"},{"id":1789845073000,"createdDate":"2026-09-19 19:11","name":"法国国际广播电台","title":"白宫记者协会促特朗普“立即”恢复记者的采访权","content":"代表报道美国总统新闻的记者协会周六呼吁特朗普撤销对CNN和其他媒体记者进入白宫的禁令，称其违宪。19日上午，三个媒体的记者抵达白宫，证件失效，称被要求交出证件。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260919-%E7%99%BD%E5%AE%AB%E8%AE%B0%E8%80%85%E5%8D%8F%E4%BC%9A%E4%BF%83%E7%89%B9%E6%9C%97%E6%99%AE-%E7%AB%8B%E5%8D%B3-%E6%81%A2%E5%A4%8D%E8%AE%B0%E8%80%85%E7%9A%84%E9%87%87%E8%AE%BF%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789845073000.webp","sourceId":"rfi"},{"id":1789844824000,"createdDate":"2026-09-19 19:07","name":"法国国际广播电台","title":"白宫落实封杀令 CNN、MS NOW与Politico记者遭拒绝入场并被没收证件","content":"美国总统特朗普（DonaldTrump）宣布禁止三家主流媒体进入白宫采访的决定，在周六（19日）迅速付诸实施。美国媒体CNN、MSNOW以及《政治》（Politico）的记者于周六早晨抵达白宫时，遭到特勤局拦阻，其白宫记者证亦遭到没收或失效处理。多家受影响的新闻机构随即发表强硬声明，直指此举违反美国宪法第一修正案，并表明将采取法律行动捍卫新闻自由。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E7%99%BD%E5%AE%AB%E8%90%BD%E5%AE%9E%E5%B0%81%E6%9D%80%E4%BB%A4-cnn-ms-now%E4%B8%8Epolitico%E8%AE%B0%E8%80%85%E9%81%AD%E6%8B%92%E7%BB%9D%E5%85%A5%E5%9C%BA%E5%B9%B6%E8%A2%AB%E6%B2%A1%E6%94%B6%E8%AF%81%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789844824000.webp","sourceId":"rfi"},{"id":1789844699000,"createdDate":"2026-09-19 19:04","name":"法国国际广播电台","title":"柏林和梅前州选举在即 谁将成功 谁将失败？","content":"德国柏林和梅前州周日将举行州议会选举。根据最新民调，社民党最后冲刺忽然超越选择党，有望在梅前州成为最大党。基民盟则可能跌落5%的门槛。在柏林，左翼党有望成为最大党，但只是微弱领先基民盟。选择党位居两党之后，但得分比上届明显增加。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260919-%E6%9F%8F%E6%9E%97%E5%92%8C%E6%A2%85%E5%89%8D%E5%B7%9E%E9%80%89%E4%B8%BE%E5%9C%A8%E5%8D%B3-%E8%B0%81%E5%B0%86%E6%88%90%E5%8A%9F-%E8%B0%81%E5%B0%86%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789844699000.webp","sourceId":"rfi"},{"id":1789844488000,"createdDate":"2026-09-19 19:01","name":"法国国际广播电台","title":"民进党创党40周年音乐会 总统赖清德登台回顾民进党与台湾民主道路","content":"民进党创党40周年纪念音乐会「传承40，民主共鸣」在19日傍晚于民进党总部前登场。民进党声明表示，晚会的民主金曲唱出了属于台湾的自由之声，也唱出40年来，为民主奋斗、一路前行的故事。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260919-%E6%B0%91%E8%BF%9B%E5%85%9A%E5%88%9B%E5%85%9A40%E5%91%A8%E5%B9%B4%E9%9F%B3%E4%B9%90%E4%BC%9A-%E6%80%BB%E7%BB%9F%E8%B5%96%E6%B8%85%E5%BE%B7%E7%99%BB%E5%8F%B0%E5%9B%9E%E9%A1%BE%E6%B0%91%E8%BF%9B%E5%85%9A%E4%B8%8E%E5%8F%B0%E6%B9%BE%E6%B0%91%E4%B8%BB%E9%81%93%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/19/1789844488000.webp","sourceId":"rfi"}]