[{"id":1790613098000,"createdDate":"2026-09-28 16:31","name":"美国之音","title":"俄罗斯袭击乌克兰，至少造成七人死亡，50多人受伤，目标包括加油站和数据中心","content":"乌克兰官员星期一(9月28日)说，俄罗斯无人机袭击乌克兰各地，造成至少七人死亡，50多人受伤，袭击目标包括公寓楼、办公室、数据中心以及基辅市中心的国家科学院一栋大楼。","newsLink":"https://www.voachinese.com/a/russian-strikes-kill-at-least-7-wound-more-than-50-across-ukraine-hitting-gas-stations-and-data-centers-20260928/8205331.html","thumbnail":"","detailImage":"news/detail/voa/2026/09/28/1790613098000.webp","sourceId":"voa"},{"id":1790610272000,"createdDate":"2026-09-28 15:44","name":"美国之音","title":"特朗普总统：美伊预计本周举行更多会谈，美国中央司令部反驳德黑兰对海峡的宣称","content":"美国总统唐纳德·特朗普(DonaldTrump)说，他预计美伊谈判代表这个星期将举行更多会谈。此前，伊朗在上星期提议重新开放霍尔木兹海峡，并恢复核谈判。","newsLink":"https://www.voachinese.com/a/president-trump-says-more-us-iran-talks-expected-this-week-as-centcom-rejects-tehran-strait-claim-20260928/8205322.html","thumbnail":"","detailImage":"news/detail/voa/2026/09/28/1790610272000.webp","sourceId":"voa"},{"id":1790609428000,"createdDate":"2026-09-28 15:30","name":"美国之音","title":"两党参议员推出法案，拟禁止国家安全系统使用中国制造的光收发器","content":"四名来自共和与民主两党的美国参议员推出一项法案，旨在阻止联邦政府最敏感的国家安全系统使用中国制造的光收发器。两家主要中国制造商被该法案点名。","newsLink":"https://www.voachinese.com/a/senators-introduce-bipartisan-bill-to-ban-use-of-chinese-made-optical-transceivers-in-national-security-systems-20260928/8205326.html","thumbnail":"","detailImage":"news/detail/voa/2026/09/28/1790609428000.webp","sourceId":"voa"},{"id":1790609179000,"createdDate":"2026-09-28 15:26","name":"美国之音","title":"调查人员就针对美军使用的英国空军基地的可能袭击展开调查","content":"英国反恐警察星期一(9月28日)表示，调查人员正在努力查明一起可能被挫败的，针对美国部队使用的一处英格兰西部空军基地的袭击。","newsLink":"https://www.voachinese.com/a/investigators-probe-potential-thwarted-attack-at-british-base-used-by-us-forces-20260928/8205318.html","thumbnail":"","detailImage":"news/detail/voa/2026/09/28/1790609179000.webp","sourceId":"voa"}]