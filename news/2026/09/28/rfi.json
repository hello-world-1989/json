[{"id":1790612496000,"createdDate":"2026-09-28 16:21","name":"法国国际广播电台","title":"中国军力的蜕变：从台海到非洲，走向何方？","content":"从1996年台海危机，再到2001年南海中美撞机事件和两千年初开始的索马里护航，以及俄乌战争中对无人机的使用，中国军队在几次关键事件的震撼下，历经半个世纪，在数量、规模、观念、战略等领域进行了重大调整。中国当今军力，不仅要看规模，更要看其向何处延伸、发展何种战争能力。本期“中华人民共和国建国77周年”特辑，从军事角度关注中国的蜕变。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260928-%E4%B8%AD%E5%9B%BD%E5%86%9B%E5%8A%9B%E7%9A%84%E8%9C%95%E5%8F%98-%E4%BB%8E%E5%8F%B0%E6%B5%B7%E5%88%B0%E9%9D%9E%E6%B4%B2%EF%BC%8C%E8%B5%B0%E5%90%91%E4%BD%95%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790612496000.webp","sourceId":"rfi"},{"id":1790608808000,"createdDate":"2026-09-28 15:20","name":"法国国际广播电台","title":"谈拥有核武器和核潜艇辩论 日防相：应不设禁忌、不预设结论地进行讨论","content":"日本防卫大臣小泉进次郎在周一的BS富士电视台节目中，就有关拥有核武器及核动力潜艇的话题发言时说道：“应当不设禁忌、不预设结论地进行讨论；若连讨论都不被允许，那便与我的危机感有些脱节”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260928-%E8%B0%88%E6%8B%A5%E6%9C%89%E6%A0%B8%E6%AD%A6%E5%99%A8%E5%92%8C%E6%A0%B8%E6%BD%9C%E8%89%87%E8%BE%A9%E8%AE%BA-%E6%97%A5%E9%98%B2%E7%9B%B8-%E5%BA%94%E4%B8%8D%E8%AE%BE%E7%A6%81%E5%BF%8C-%E4%B8%8D%E9%A2%84%E8%AE%BE%E7%BB%93%E8%AE%BA%E5%9C%B0%E8%BF%9B%E8%A1%8C%E8%AE%A8%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790608808000.webp","sourceId":"rfi"},{"id":1790607617000,"createdDate":"2026-09-28 15:00","name":"法国国际广播电台","title":"台湾学者马准威（Adam MA）评特习会：美国停止对台军售这个选项，目前应该并不存在","content":"本周，世界的焦点都集中在中国领导人习近平访美一事上。周四(9月24日)，美国总统特朗普亲自接机，对来访的中国国家主席习近平给予了极高礼遇。有媒体称，这是中美力量的逆转，中国并没有按照美国设想的方式退让。更有媒体发问，为什么特朗普对习近平这么好？而关于中美元首峰会，外界则评价此次“习特会”排场大、效果小，重大问题难有突破。该如何理解这次“习特会”，以及双方在诸如对台军售等核心议题上的谈判进展呢？今天的节目，我们特别邀请到淡江大学国际事务与战略研究所学者马准威（AdamMA）先生，为我们详细解读。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20260928-%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85%E9%A9%AC%E5%87%86%E5%A8%81-adam-ma-%E8%AF%84%E7%89%B9%E4%B9%A0%E4%BC%9A-%E7%BE%8E%E5%9B%BD%E5%81%9C%E6%AD%A2%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%E8%BF%99%E4%B8%AA%E9%80%89%E9%A1%B9%EF%BC%8C%E7%9B%AE%E5%89%8D%E5%BA%94%E8%AF%A5%E5%B9%B6%E4%B8%8D%E5%AD%98%E5%9C%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790607617000.webp","sourceId":"rfi"},{"id":1790607484000,"createdDate":"2026-09-28 14:58","name":"法国国际广播电台","title":"王毅在京会见日本前外相岩屋毅 分析指向高市政府施压","content":"据凤凰卫视报道称，率日本国际贸易促进协会（国贸促）代表团访华的该民间团队会长、日本前外务大臣岩屋毅，周一在北京与中国外交部长王毅举行了会谈。国贸促是日本对华贸易与经济交流的窗口。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260928-%E7%8E%8B%E6%AF%85%E5%9C%A8%E4%BA%AC%E4%BC%9A%E8%A7%81%E6%97%A5%E6%9C%AC%E5%89%8D%E5%A4%96%E7%9B%B8%E5%B2%A9%E5%B1%8B%E6%AF%85-%E5%88%86%E6%9E%90%E6%8C%87%E5%90%91%E9%AB%98%E5%B8%82%E6%94%BF%E5%BA%9C%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790607484000.webp","sourceId":"rfi"},{"id":1790605703000,"createdDate":"2026-09-28 14:28","name":"法国国际广播电台","title":"高市出席强化情报功能专家会议首会：有必要制定和公布《国家情报战略》","content":"日本首相高市早苗周一在首相官邸召开了旨在强化政府情报功能的专家会议的首次会议。高市在会上指出，“鉴于当前的国际局势等情况，强化情报职能是一项‌紧迫的课题”。她表示将致力于加强防范外国不当干涉，如间谍等活动的措施，并充实负责海外情报搜集的对外情报职能。她还称，计划制定并公布首个日本《国家情报战略》，作为情报活动的首要指导方针。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260928-%E9%AB%98%E5%B8%82%E5%87%BA%E5%B8%AD%E5%BC%BA%E5%8C%96%E6%83%85%E6%8A%A5%E5%8A%9F%E8%83%BD%E4%B8%93%E5%AE%B6%E4%BC%9A%E8%AE%AE%E9%A6%96%E4%BC%9A-%E6%9C%89%E5%BF%85%E8%A6%81%E5%88%B6%E5%AE%9A%E5%92%8C%E5%85%AC%E5%B8%83-%E5%9B%BD%E5%AE%B6%E6%83%85%E6%8A%A5%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790605703000.webp","sourceId":"rfi"},{"id":1790604210000,"createdDate":"2026-09-28 14:03","name":"法国国际广播电台","title":"特习会后 中美宣布就600亿美元商品低关税达成一致","content":"继上周中国国家主席习近平和美国总统特朗普总统在华盛顿举行峰会后，市场一直在等待有关削减关税的消息。访问结束两天后，两国周一宣布同意建立这项涵盖价值600亿美元的低关税非敏感商品贸易，目的是为两国关系注入一定的稳定性。美国贸易代表办公室与中国商务部都表示，这是在一项贸易委员会提出的所谓“30对30”框架下做出的安排。涉及到的商品种类繁多，从美国玉米到化妆品，从中国家用电器到玩具。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260928-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%90%8E-%E4%B8%AD%E7%BE%8E%E5%B0%B1600%E4%BA%BF%E7%BE%8E%E5%85%83%E5%95%86%E5%93%81%E4%BD%8E%E5%85%B3%E7%A8%8E%E8%BE%BE%E6%88%90%E4%B8%80%E8%87%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790604210000.webp","sourceId":"rfi"},{"id":1790603285000,"createdDate":"2026-09-28 13:48","name":"法国国际广播电台","title":"韩国“习近平”中餐厅遭闯入破坏 警方拟申请逮捕令追逃回国的中国4嫌","content":"据韩联社报导，韩国京畿道城南市的一家以中国领导人习近平的名字为名的中餐厅日前遭人闯入喷漆破坏，警方发现4名嫌疑人均为中国籍人员，他们现已潜逃回国。韩国警方已启动国际司法合作。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260928-%E9%9F%A9%E5%9B%BD-%E4%B9%A0%E8%BF%91%E5%B9%B3-%E4%B8%AD%E9%A4%90%E9%A6%86%E9%81%AD%E9%97%AF%E5%85%A5%E7%A0%B4%E5%9D%8F-%E8%AD%A6%E6%96%B9%E6%8B%9F%E7%94%B3%E8%AF%B7%E9%80%AE%E6%8D%95%E4%BB%A4%E8%BF%BD%E9%80%83%E5%9B%9E%E5%9B%BD%E7%9A%84%E4%B8%AD%E5%9B%BD4%E5%AB%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790603285000.webp","sourceId":"rfi"},{"id":1790603112000,"createdDate":"2026-09-28 13:45","name":"法国国际广播电台","title":"俄罗斯 : 俄美军控谈判本早应恢复","content":"克里姆林宫周一表示，俄美军控谈判早已迫在眉睫，特别是要重启相关谈判，将需要进行漫长而审慎的磋商。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260928-%E4%BF%84%E7%BD%97%E6%96%AF-%E4%BF%84%E7%BE%8E%E5%86%9B%E6%8E%A7%E8%B0%88%E5%88%A4%E6%9C%AC%E6%97%A9%E5%BA%94%E6%81%A2%E5%A4%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790603112000.webp","sourceId":"rfi"},{"id":1790600474000,"createdDate":"2026-09-28 13:01","name":"法国国际广播电台","title":"高市首相访美：日美的分歧与疏离越来越明显","content":"日本首相高市早苗于9月21日至24日访问美国纽约，出席第81届联合国大会，并发表一般性辩论演说，22日与美国总统特朗普举行会谈。她希望在美中元首会谈举行之前，就涉及中国的问题与美国方面进行沟通和协调。但是这次高市首相访美，正值特朗普紧锣密鼓，以最高的规格，热烈欢迎中国国家主席习近平访美的阶段，而高市的访美与美国接待习近平访美相比，显得备受零落，日美之间的分歧与疏离也日渐明显。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260928-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E8%AE%BF%E7%BE%8E-%E6%97%A5%E7%BE%8E%E7%9A%84%E5%88%86%E6%AD%A7%E4%B8%8E%E7%96%8F%E7%A6%BB%E8%B6%8A%E6%9D%A5%E8%B6%8A%E6%98%8E%E6%98%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790600474000.webp","sourceId":"rfi"},{"id":1790596413000,"createdDate":"2026-09-28 11:53","name":"法国国际广播电台","title":"中国据报扩大出境限制范围 涵盖部分AI及芯片行业高管直系亲属","content":"据彭博社报导称，中国已扩大针对私营企业顶尖人工智能（AI）专业人士的出境限制，将适用范围延伸至关键人员的家属；此举旨在进一步收紧管控，防止关键技术诀窍和信息流向美国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260928-%E4%B8%AD%E5%9B%BD%E6%8D%AE%E6%8A%A5%E6%89%A9%E5%A4%A7%E5%87%BA%E5%A2%83%E9%99%90%E5%88%B6%E8%8C%83%E5%9B%B4-%E6%B6%B5%E7%9B%96%E9%83%A8%E5%88%86ai%E5%8F%8A%E8%8A%AF%E7%89%87%E8%A1%8C%E4%B8%9A%E9%AB%98%E7%AE%A1%E7%9B%B4%E7%B3%BB%E4%BA%B2%E5%B1%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790596413000.webp","sourceId":"rfi"},{"id":1790594680000,"createdDate":"2026-09-28 11:24","name":"法国国际广播电台","title":"吓阻中国侵台　美太平洋司令称“不战而屈人之兵”才是最高境界","content":"在接受时代周刊专访时，美国太平洋司令部司令帕帕罗表示，在台海问题上，美国的目标并不是通过战争击败中国，而是建立足够强大的威慑能力，让战争根本不会发生。他还引用中国古代军事书籍《孙子兵法谋战》中的“不战而屈人之兵，善之善者也”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260928-%E5%90%93%E9%98%BB%E4%B8%AD%E5%9B%BD%E4%BE%B5%E5%8F%B0-%E7%BE%8E%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%8F%B8%E4%BB%A4%E7%A7%B0-%E4%B8%8D%E6%88%98%E8%80%8C%E5%B1%88%E4%BA%BA%E4%B9%8B%E5%85%B5-%E6%89%8D%E6%98%AF%E6%9C%80%E9%AB%98%E5%A2%83%E7%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790594680000.webp","sourceId":"rfi"},{"id":1790592205000,"createdDate":"2026-09-28 10:43","name":"法国国际广播电台","title":"赖清德:台湾要深化与民主伙伴在无人机领域的合作","content":"台湾总统赖清德9月28日表示，台湾必须深化与民主伙伴在无人机领域的合作，共同打造更加安全、更具韧性的无人机供应链。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260928-%E8%B5%96%E6%B8%85%E5%BE%B7-%E5%8F%B0%E6%B9%BE%E8%A6%81%E6%B7%B1%E5%8C%96%E4%B8%8E%E6%B0%91%E4%B8%BB%E4%BC%99%E4%BC%B4%E5%9C%A8%E6%97%A0%E4%BA%BA%E6%9C%BA%E9%A2%86%E5%9F%9F%E7%9A%84%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790592205000.webp","sourceId":"rfi"},{"id":1790591842000,"createdDate":"2026-09-28 10:37","name":"法国国际广播电台","title":"贝森特：未来两周内，伊朗或将向中国交付最后一批石油","content":"美国财政部长贝森特（ScottBessent）周日在受访时预测称，随着特朗普政府加大对伊朗政权的经济施压，伊朗将在两周内完成向中国交付剩余石油，届时德黑兰方面将“无物可用于交易”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260928-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E6%9C%AA%E6%9D%A5%E4%B8%A4%E5%91%A8%E5%86%85%EF%BC%8C%E4%BC%8A%E6%9C%97%E5%B0%86%E5%90%91%E4%B8%AD%E5%9B%BD%E4%BA%A4%E4%BB%98%E6%9C%80%E5%90%8E%E4%B8%80%E6%89%B9%E7%9F%B3%E6%B2%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790591842000.webp","sourceId":"rfi"},{"id":1790590059000,"createdDate":"2026-09-28 10:07","name":"法国国际广播电台","title":"习特会强调中美二战联盟关系 台湾予以反驳","content":"上周，中国国家主席习近平和美国总统唐纳德·特朗普在峰会上强调了两国在二战期间的联盟关系，台湾对此表示反击，认为这是北京试图改写二战历史的举动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260928-%E4%B9%A0%E7%89%B9%E4%BC%9A%E5%BC%BA%E8%B0%83%E4%B8%AD%E7%BE%8E%E4%BA%8C%E6%88%98%E8%81%94%E7%9B%9F%E5%85%B3%E7%B3%BB-%E5%8F%B0%E6%B9%BE%E4%BA%88%E4%BB%A5%E5%8F%8D%E9%A9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790590059000.webp","sourceId":"rfi"},{"id":1790589758000,"createdDate":"2026-09-28 10:02","name":"法国国际广播电台","title":"中国驻菲使馆批“极端反华、企图捞取政治资本” 菲军方：坚定支持防长","content":"菲律宾武装部队周一强烈驳斥了中国驻菲大使馆的说法，该说法指责菲律宾国防部长特奥多罗（GilbertoTeodoro）企图利用中菲南海争议来积累政治资本。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260928-%E4%B8%AD%E5%9B%BD%E9%A9%BB%E8%8F%B2%E4%BD%BF%E9%A6%86%E6%89%B9-%E6%9E%81%E7%AB%AF%E5%8F%8D%E5%8D%8E-%E4%BC%81%E5%9B%BE%E6%8D%9E%E5%8F%96%E6%94%BF%E6%B2%BB%E8%B5%84%E6%9C%AC-%E8%8F%B2%E5%86%9B%E6%96%B9-%E5%9D%9A%E5%AE%9A%E6%94%AF%E6%8C%81%E9%98%B2%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790589758000.webp","sourceId":"rfi"},{"id":1790585233000,"createdDate":"2026-09-28 08:47","name":"法国国际广播电台","title":"美驻华大使称特朗普曾问习近平是否有意购买美国武器 美国务院：法律禁止","content":"美国驻华大使庞德伟（DavidPerdue）在周日接受电视采访时提到，美国总统特朗普（DonaldTrump）曾询问中国国家主席习近平是否有意购买美国武器。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260928-%E7%BE%8E%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF%E7%A7%B0%E7%89%B9%E6%9C%97%E6%99%AE%E6%9B%BE%E9%97%AE%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%98%AF%E5%90%A6%E6%9C%89%E6%84%8F%E8%B4%AD%E4%B9%B0%E7%BE%8E%E5%9B%BD%E6%AD%A6%E5%99%A8-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2-%E6%B3%95%E5%BE%8B%E7%A6%81%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790585233000.webp","sourceId":"rfi"},{"id":1790583097000,"createdDate":"2026-09-28 08:11","name":"法国国际广播电台","title":"日本官房长官反驳俄罗斯称日本“正在走军国主义道路”","content":"日本内阁官房长官木原稔28日上午在记者会上表示，针对俄罗斯外长拉夫罗夫在联合国大会演讲中声称日本正在走军国主义道路，并表示反对日本成为联合国安理会常任理事国一事指出，日本认为这一说法与事实不符，因此行使答辩权，阐明了日本的立场。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260928-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E5%8F%8D%E9%A9%B3%E4%BF%84%E7%BD%97%E6%96%AF%E7%A7%B0%E6%97%A5%E6%9C%AC-%E6%AD%A3%E5%9C%A8%E8%B5%B0%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E9%81%93%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790583097000.webp","sourceId":"rfi"},{"id":1790582752000,"createdDate":"2026-09-28 08:05","name":"法国国际广播电台","title":"香港首办国际足协东盟杯 有团体指「香港魂」等半数打气物品被禁惹争议","content":"香港首次主办国际足协正式赛事，但却因有球迷团体指半数应援旗帜不获批准带入场而蒙上阴影。被指禁带入场的旗帜包括印有「香港魂」和「打不死」等字眼，亦有些过往曾获准带入场的旗帜今次被禁足。团体质疑有关方面标准不一，评论员亦指是管理文化不成熟，难以配合香港发展盛事之都的需要。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260928-%E9%A6%99%E6%B8%AF%E9%A6%96%E5%8A%9E%E5%9B%BD%E9%99%85%E8%B6%B3%E5%8D%8F%E4%B8%9C%E7%9B%9F%E6%9D%AF-%E6%9C%89%E5%9B%A2%E4%BD%93%E6%8C%87-%E9%A6%99%E6%B8%AF%E9%AD%82-%E7%AD%89%E5%8D%8A%E6%95%B0%E6%89%93%E6%B0%94%E7%89%A9%E5%93%81%E8%A2%AB%E7%A6%81%E6%83%B9%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790582752000.webp","sourceId":"rfi"},{"id":1790634696000,"createdDate":"2026-09-28 22:31","name":"法国国际广播电台","title":"在习近平访问华盛顿期间，特朗普政府接连出现外交失误","content":"法国世界报周一刊出的一篇文章指出，在习近平访问华盛顿期间，美国政府接连出现一些外交上的失误。这些失误，有的涉及对华政策，有的出现在国宴和礼宾安排上，反映出特朗普政府在处理复杂外交问题时，准备和协调似乎并不充分。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260928-%E5%9C%A8%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E9%97%AE%E5%8D%8E%E7%9B%9B%E9%A1%BF%E6%9C%9F%E9%97%B4%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E6%8E%A5%E8%BF%9E%E5%87%BA%E7%8E%B0%E5%A4%96%E4%BA%A4%E5%A4%B1%E8%AF%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790634696000.webp","sourceId":"rfi"},{"id":1790632645000,"createdDate":"2026-09-28 21:57","name":"法国国际广播电台","title":"在欧盟之父的家乡，教宗向欧洲及青年发出和平与团结的呼吁","content":"9月28日，教宗选择在欧盟之父罗贝尔·舒曼（RobertSchuman）的家乡梅斯作为此次访法的最后一站，向欧洲及青年发出和平与团结的呼吁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260928-%E5%9C%A8%E6%AC%A7%E7%9B%9F%E4%B9%8B%E7%88%B6%E7%9A%84%E5%AE%B6%E4%B9%A1%EF%BC%8C%E6%95%99%E5%AE%97%E5%90%91%E6%AC%A7%E6%B4%B2%E5%8F%8A%E9%9D%92%E5%B9%B4%E5%8F%91%E5%87%BA%E5%92%8C%E5%B9%B3%E4%B8%8E%E5%9B%A2%E7%BB%93%E7%9A%84%E5%91%BC%E5%90%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790632645000.webp","sourceId":"rfi"},{"id":1790630388000,"createdDate":"2026-09-28 21:19","name":"法国国际广播电台","title":"美国联邦众议院议长约翰逊预期美国将持续支持台湾","content":"美国联邦众议院议长约翰逊周一接受美媒访问表示，美国需要台湾保持稳定与独立，这对国安、经济至关重要；他也认为，美国总统特朗普的两个任期间，美方将会完成400亿美元的对台军售。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260928-%E7%BE%8E%E5%9B%BD%E8%81%94%E9%82%A6%E4%BC%97%E8%AE%AE%E9%99%A2%E8%AE%AE%E9%95%BF%E7%BA%A6%E7%BF%B0%E9%80%8A%E9%A2%84%E6%9C%9F%E7%BE%8E%E5%9B%BD%E5%B0%86%E6%8C%81%E7%BB%AD%E6%94%AF%E6%8C%81%E5%8F%B0%E6%B9%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790630388000.webp","sourceId":"rfi"},{"id":1790628901000,"createdDate":"2026-09-28 20:55","name":"法国国际广播电台","title":"美向第三国遣返移民：专家谴责“一系列侵犯人权行为”","content":"联合国专家周一警告称，美国的遣返计划使被遣返者面临“更高的侵犯人权风险”，包括酷刑和迫害。约20名联合国专家在一份声明中表示，该计划引发了“一系列人权侵犯，增加了酷刑、虐待以及强迫失踪的风险”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260928-%E7%BE%8E%E5%90%91%E7%AC%AC%E4%B8%89%E5%9B%BD%E9%81%A3%E8%BF%94%E7%A7%BB%E6%B0%91-%E4%B8%93%E5%AE%B6%E8%B0%B4%E8%B4%A3-%E4%B8%80%E7%B3%BB%E5%88%97%E4%BE%B5%E7%8A%AF%E4%BA%BA%E6%9D%83%E8%A1%8C%E4%B8%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790628901000.webp","sourceId":"rfi"},{"id":1790628288000,"createdDate":"2026-09-28 20:44","name":"法国国际广播电台","title":"挺特朗普短片     反对派批用纳税人的钱资助政治广告","content":"周一反对派指责特朗普从事非法“宣传”，此前，一则由政府资助、美化他的电视广告于周日播出，距离关键的中期选举仅剩几周时间。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260928-%E6%8C%BA%E7%89%B9%E6%9C%97%E6%99%AE%E7%9F%AD%E7%89%87-%E5%8F%8D%E5%AF%B9%E6%B4%BE%E6%89%B9%E7%94%A8%E7%BA%B3%E7%A8%8E%E4%BA%BA%E7%9A%84%E9%92%B1%E8%B5%84%E5%8A%A9%E6%94%BF%E6%B2%BB%E5%B9%BF%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790628288000.webp","sourceId":"rfi"},{"id":1790628149000,"createdDate":"2026-09-28 20:42","name":"法国国际广播电台","title":"法前文化部长达蒂被求刑2年   剥夺公职权利5年","content":"法国检方9月28日针对涉嫌收受雷诺日产联盟顾问费的贪腐案件进行审理，对法国前文化部长拉茜达·达蒂（RachidaDati）求处配戴电子脚镣服刑2年，并剥夺公职权利5年，最终判决预计数月后出炉。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260928-%E6%B3%95%E5%89%8D%E6%96%87%E5%8C%96%E9%83%A8%E9%95%BF%E8%BE%BE%E8%92%82%E8%A2%AB%E6%B1%82%E5%88%912%E5%B9%B4-%E5%89%A5%E5%A4%BA%E5%85%AC%E8%81%8C%E6%9D%83%E5%88%A95%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790628149000.webp","sourceId":"rfi"},{"id":1790627756000,"createdDate":"2026-09-28 20:35","name":"法国国际广播电台","title":"Mediapart 翻出旧账：乔丹·巴德拉被控曾发表过反犹言论","content":"法国调查媒体Mediapart周一公布了据称出自乔丹·巴尔德拉（JordanBardella）之笔的反犹信息，这些信息发布于2013年，当时他是国民阵线的一名年轻活动家。巴尔德拉宣布他的律师“已提起诽谤诉讼”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260928-mediapart-%E7%BF%BB%E5%87%BA%E6%97%A7%E8%B4%A6-%E4%B9%94%E4%B8%B9%C2%B7%E5%B7%B4%E5%BE%B7%E6%8B%89%E8%A2%AB%E6%8E%A7%E6%9B%BE%E5%8F%91%E8%A1%A8%E8%BF%87%E5%8F%8D%E7%8A%B9%E8%A8%80%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790627756000.webp","sourceId":"rfi"},{"id":1790627486000,"createdDate":"2026-09-28 20:31","name":"法国国际广播电台","title":"感人的瞬间：教宗祝福多重残疾女孩玛丽-加朗斯（Marie-Garance）","content":"教宗良十四世（LéonXIV）于2026年9月26日星期六在法国巴黎香榭丽舍大道上，破例停下专车，亲自拥抱并祝福了10岁的多重残疾女孩玛丽-加朗斯（Marie-Garance）。这一温情瞬间被法新社（AFP）摄影师路易斯·马林（LudovicMarin）用镜头记录下来，并在全球范围内引发了巨大的轰动与情感共鸣。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260928-%E6%84%9F%E4%BA%BA%E7%9A%84%E7%9E%AC%E9%97%B4-%E6%95%99%E5%AE%97%E7%A5%9D%E7%A6%8F%E5%A4%9A%E9%87%8D%E6%AE%8B%E7%96%BE%E5%A5%B3%E5%AD%A9%E7%8E%9B%E4%B8%BD-%E5%8A%A0%E6%9C%97%E6%96%AF-marie-garance","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790627486000.webp","sourceId":"rfi"},{"id":1790627294000,"createdDate":"2026-09-28 20:28","name":"法国国际广播电台","title":"中美峰会成果寥寥 台湾等敏感议题成未亮的牌？","content":"习近平访美结束，从表面上看，此次峰会成果寥寥，但更多会谈细节正在慢慢流出并得到进一步分析。自去年10月以来，习近平与特朗普已经会面三次，年底前可能还会再见两次。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260928-%E4%B8%AD%E7%BE%8E%E5%B3%B0%E4%BC%9A%E6%88%90%E6%9E%9C%E5%AF%A5%E5%AF%A5-%E5%8F%B0%E6%B9%BE%E7%AD%89%E6%95%8F%E6%84%9F%E8%AE%AE%E9%A2%98%E6%98%AF%E8%B0%81%E7%9A%84%E7%89%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790627294000.webp","sourceId":"rfi"},{"id":1790627195000,"createdDate":"2026-09-28 20:26","name":"法国国际广播电台","title":"乌方：俄无人机袭击波兰附近边境检查站","content":"乌克兰一名地方官员表示，周一早些时候，一架俄罗斯喷气式无人机击中了波兰边境附近的一个乌克兰村庄，导致一处边境检查站受损。该官员未透露有关检查站性质或爆炸造成损坏程度的细节。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260928-%E4%B9%8C%E6%96%B9-%E4%BF%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E6%B3%A2%E5%85%B0%E9%99%84%E8%BF%91%E8%BE%B9%E5%A2%83%E6%A3%80%E6%9F%A5%E7%AB%99","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790627195000.webp","sourceId":"rfi"},{"id":1790626713000,"createdDate":"2026-09-28 20:18","name":"法国国际广播电台","title":"普京签署法令   部队再次扩编","content":"俄罗斯总统普京周一签署法令，将武装部队的核定编制人数增加15500人，这是他今年第四次做出此类决定。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260928-%E6%99%AE%E4%BA%AC%E7%AD%BE%E7%BD%B2%E6%B3%95%E4%BB%A4-%E9%83%A8%E9%98%9F%E5%86%8D%E6%AC%A1%E6%89%A9%E7%BC%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790626713000.webp","sourceId":"rfi"},{"id":1790626436000,"createdDate":"2026-09-28 20:13","name":"法国国际广播电台","title":"希音（SHEIN）上半年同比大幅下滑 50.4%","content":"快时尚平台Shein周一宣布，今年上半年其营业利润（或称调整后息税前利润）较上年同期下降了50.4%。快时尚巨头Shein周一报告称，在全球监管不利的情况下，今年上半年净收入同比增长1%，达到201亿美元。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260928-%E5%B8%8C%E9%9F%B3-shein-%E4%B8%8A%E5%8D%8A%E5%B9%B4%E5%90%8C%E6%AF%94%E5%A4%A7%E5%B9%85%E4%B8%8B%E6%BB%91-50-4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790626436000.webp","sourceId":"rfi"},{"id":1790620639000,"createdDate":"2026-09-28 18:37","name":"法国国际广播电台","title":"万斯：企业裁员后不应再用H-1B签证引进低薪外籍劳工","content":"美国副总统万斯（JDVance）表示，特朗普政府正研究进一步限制企业使用H-1B工作签证，在裁减美国员工后再招聘外籍劳工，并考虑把企业近期及计划中的裁员纪录纳入签证审查。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260928-%E4%B8%87%E6%96%AF-%E4%BC%81%E4%B8%9A%E8%A3%81%E5%91%98%E5%90%8E%E4%B8%8D%E5%BA%94%E5%86%8D%E7%94%A8h-1b%E7%AD%BE%E8%AF%81%E5%BC%95%E8%BF%9B%E4%BD%8E%E8%96%AA%E5%A4%96%E7%B1%8D%E5%8A%B3%E5%B7%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/28/1790620639000.webp","sourceId":"rfi"}]