[{"id":1789044351000,"createdDate":"2026-09-10 12:45","name":"法国国际广播电台","title":"法意等成员国拟促欧盟采取广泛进口配额 主要针对化工和塑料行业","content":"据路透社援引知情人士报导称，多个欧洲国家政府计划敦促欧盟启用一项鲜少使用的贸易防御工具，以保护欧盟化工和塑料行业免受进口激增——主要来自中国——的冲击。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260910-%E6%B3%95%E6%84%8F%E7%AD%89%E6%88%90%E5%91%98%E5%9B%BD%E6%8B%9F%E4%BF%83%E6%AC%A7%E7%9B%9F%E9%87%87%E5%8F%96%E5%B9%BF%E6%B3%9B%E8%BF%9B%E5%8F%A3%E9%85%8D%E9%A2%9D-%E4%B8%BB%E8%A6%81%E9%92%88%E5%AF%B9%E5%8C%96%E5%B7%A5%E5%92%8C%E5%A1%91%E6%96%99%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789044351000.webp","sourceId":"rfi"},{"id":1789044119000,"createdDate":"2026-09-10 12:41","name":"法国国际广播电台","title":"非洲在巴黎国际太空峰会展雄心","content":"在法国首都，多个非洲国家在历时两天的第一届巴黎国际太空峰会（Lepremiersommetinternationalsurl’espace）期间，展现了它们的航天雄心。就此，塞内加尔（leSénégal）和卢旺达(leRwanda)的主要官员分别接受了本台法广非洲组（RFIAfrique）法语记者的采访。非洲内陆国卢旺达的中文国名也有译作盧安達共和国(leRwanda)。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260910-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E5%9C%A8%E5%B7%B4%E9%BB%8E%E5%9B%BD%E9%99%85%E5%A4%AA%E7%A9%BA%E5%B3%B0%E4%BC%9A%E5%B1%95%E9%9B%84%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789044119000.webp","sourceId":"rfi"},{"id":1789039867000,"createdDate":"2026-09-10 11:31","name":"法国国际广播电台","title":"中东战争升级 能源危机来势汹汹","content":"近期美国和伊朗再次爆发激烈冲突，中东紧张局势威胁全球能源运输线，进一步冲击能源供应链和消费价格。东南亚国家菲律宾再度因南海争议跟北京互呛，背后的中美地缘政治角逐和军事安全危机值得密切关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260910-%E4%B8%AD%E4%B8%9C%E6%88%98%E4%BA%89%E5%8D%87%E7%BA%A7-%E8%83%BD%E6%BA%90%E5%8D%B1%E6%9C%BA%E6%9D%A5%E5%8A%BF%E6%B1%B9%E6%B1%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789039867000.webp","sourceId":"rfi"},{"id":1789039823000,"createdDate":"2026-09-10 11:30","name":"法国国际广播电台","title":"习近平12日赴印度出席金砖国家峰会 时隔7年再访印","content":"据官媒新华社报导，中国外交部发言人周四宣布：应印度共和国总理莫迪邀请，国家主席习近平将于9月12日至13日赴印度新德里出席金砖国家领导人第十八次会晤。习近平本周访问印度，将是他七年来首次访印。此次访问有望进一步推动中印外交关系回暖，但目前鲜有迹象显示，两国经贸关系将随之改善。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E4%B9%A0%E8%BF%91%E5%B9%B312%E6%97%A5%E8%B5%B4%E5%8D%B0%E5%BA%A6%E5%87%BA%E5%B8%AD%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A-%E6%97%B6%E9%9A%947%E5%B9%B4%E5%86%8D%E8%AE%BF%E5%8D%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789039823000.webp","sourceId":"rfi"},{"id":1789038445000,"createdDate":"2026-09-10 11:07","name":"法国国际广播电台","title":"防堵中国“欧洲行动太慢了”中小企业群起炮轰：布鲁塞尔宣告将终结“最低价中标”的时代！","content":"大家好，欢迎收听法国报纸摘要。周四9月10日本台订阅的法国日报头版的焦点均不相同。中国方面的报道见于《回声报》经济版，该报指出，欧洲中型企业正在向布鲁塞尔施压，认为与美国和中国相比，欧洲的行动速度太慢了！据悉，欧盟委员会现已提出了一项公共采购改革方案，旨在应对中国倾销行为，以及在不符合互惠原则的情况下，布鲁塞尔有权排除外国运营商参与采购。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260910-%E9%98%B2%E5%A0%B5%E4%B8%AD%E5%9B%BD-%E6%AC%A7%E6%B4%B2%E8%A1%8C%E5%8A%A8%E5%A4%AA%E6%85%A2%E4%BA%86-%E4%B8%AD%E5%B0%8F%E4%BC%81%E4%B8%9A%E7%BE%A4%E8%B5%B7%E7%82%AE%E8%BD%B0-%E5%B8%83%E9%B2%81%E5%A1%9E%E5%B0%94%E5%AE%A3%E5%91%8A%E7%BB%88%E7%BB%93-%E6%9C%80%E4%BD%8E%E4%BB%B7%E4%B8%AD%E6%A0%87-%E7%9A%84%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789038445000.webp","sourceId":"rfi"},{"id":1789036269000,"createdDate":"2026-09-10 10:31","name":"法国国际广播电台","title":"被北京指“哗众取宠” 菲防长：我不是演员，不懂表演 菲海警称中方向其飞机发射照明弹","content":"菲律宾国防部长特奥多罗（GilbertoTeodoro）周四作出回应，此前中国外交部发言人将他在“首尔防务对话”期间的言论未点名地形容为“哗众取宠、挑事生非”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E8%A2%AB%E5%8C%97%E4%BA%AC%E6%8C%87-%E5%93%97%E4%BC%97%E5%8F%96%E5%AE%A0-%E8%8F%B2%E9%98%B2%E9%95%BF-%E6%88%91%E4%B8%8D%E6%98%AF%E6%BC%94%E5%91%98%EF%BC%8C%E4%B8%8D%E6%87%82%E8%A1%A8%E6%BC%94-%E8%8F%B2%E6%B5%B7%E8%AD%A6%E7%A7%B0%E4%B8%AD%E6%96%B9%E5%90%91%E5%85%B6%E9%A3%9E%E6%9C%BA%E5%8F%91%E5%B0%84%E7%85%A7%E6%98%8E%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789036269000.webp","sourceId":"rfi"},{"id":1789032378000,"createdDate":"2026-09-10 09:26","name":"法国国际广播电台","title":"华为案在纽约开审 美检方陈列本案涉及的12项指控：“犯罪是其重要的商业策略”","content":"当地时间周三，针对中国科技巨头华为的审判在布鲁克林联邦法院开庭，一名美国检察官将华为描述为一个通过窃取美国公司技术来建立其电信帝国的犯罪企业。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E5%8D%8E%E4%B8%BA%E6%A1%88%E5%9C%A8%E7%BA%BD%E7%BA%A6%E5%BC%80%E5%AE%A1-%E7%BE%8E%E6%A3%80%E6%96%B9%E9%99%88%E5%88%97%E6%9C%AC%E6%A1%88%E6%B6%89%E5%8F%8A%E7%9A%8412%E9%A1%B9%E6%8C%87%E6%8E%A7-%E5%85%B6%E5%B0%86%E7%8A%AF%E7%BD%AA%E8%A7%86%E4%B8%BA%E9%87%8D%E8%A6%81%E7%9A%84%E5%95%86%E4%B8%9A%E7%AD%96%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789032378000.webp","sourceId":"rfi"},{"id":1789030605000,"createdDate":"2026-09-10 08:56","name":"法国国际广播电台","title":"乌克兰总统出访加拿大，谋求深化两国在国防等领域的合作","content":"法新社引述加拿大媒体报道，乌克兰总统泽连斯基已于昨夜今晨抵达加拿大，将与加拿大总理马克-卡尼会谈。核心话题是如何更好地支持乌克兰抗击俄罗斯入侵的战争。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%80%BB%E7%BB%9F%E5%87%BA%E8%AE%BF%E5%8A%A0%E6%8B%BF%E5%A4%A7%EF%BC%8C%E8%B0%8B%E6%B1%82%E6%B7%B1%E5%8C%96%E4%B8%A4%E5%9B%BD%E5%9C%A8%E5%9B%BD%E9%98%B2%E7%AD%89%E9%A2%86%E5%9F%9F%E7%9A%84%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789030605000.webp","sourceId":"rfi"},{"id":1789026951000,"createdDate":"2026-09-10 07:55","name":"法国国际广播电台","title":"一名澳大利亚人因向中国提供情报被判三年半监禁","content":"一名澳大利亚人因鲁莽向中国情报机构提供信息，周四（9月10日）被悉尼一家法院判处三年半监禁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E4%B8%80%E5%90%8D%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E4%BA%BA%E5%9B%A0%E5%90%91%E4%B8%AD%E5%9B%BD%E6%8F%90%E4%BE%9B%E6%83%85%E6%8A%A5%E8%A2%AB%E5%88%A4%E5%9B%9A%E4%B8%89%E5%B9%B4%E5%8D%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789026951000.webp","sourceId":"rfi"},{"id":1789026560000,"createdDate":"2026-09-10 07:49","name":"法国国际广播电台","title":"刘翔选择买断并捐出工资补助：今后与体育局再无关联 上海市体育局：充分尊重","content":"针对此前引发广泛关注的退役安置“买断”问题，2004年雅典奥运会男子110米栏冠军刘翔周四在个人微博上发文称，自己已于9月1日“买断”，获得49.4万元“买断费”，“今后与体育局再无关联”。上海市体育局官方微信当天发布了对于刘翔退役安置的相关回应，并称“我们会继续关心好包括刘翔在内的所有退役运动员，也祝愿他们在人生新赛道上续写精彩！”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260910-%E5%88%98%E7%BF%94%E9%80%89%E6%8B%A9-%E4%B9%B0%E6%96%AD-%E5%B9%B6%E6%8D%90%E5%87%BA%E5%B7%A5%E8%B5%84%E8%A1%A5%E5%8A%A9-%E4%BB%8A%E5%90%8E%E4%B8%8E%E4%BD%93%E8%82%B2%E5%B1%80%E5%86%8D%E6%97%A0%E5%85%B3%E8%81%94-%E4%B8%8A%E6%B5%B7%E5%B8%82%E4%BD%93%E8%82%B2%E5%B1%80-%E5%85%85%E5%88%86%E5%B0%8A%E9%87%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789026560000.webp","sourceId":"rfi"},{"id":1789024640000,"createdDate":"2026-09-10 07:17","name":"法国国际广播电台","title":"俄罗斯称日本菊花纹章是“军国主义象征” 中国支持俄罗斯","content":"俄罗斯外交部新闻出版司司长，该部门的官方发言人扎哈罗娃在10月9日记者会上，就日本政府要求撤除建立在俄罗斯远东哈巴罗夫斯克，表现苏联士兵捣毁日本菊花纹章“对日战争胜利纪念碑”一事作出回应，她反驳称日方“没有理由对此指手画脚”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A7%B0%E6%97%A5%E6%9C%AC%E8%8F%8A%E8%8A%B1%E7%BA%B9%E7%AB%A0%E6%98%AF-%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E8%B1%A1%E5%BE%81-%E4%B8%AD%E5%9B%BD%E6%94%AF%E6%8C%81%E4%BF%84%E7%BD%97%E6%96%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789024640000.webp","sourceId":"rfi"},{"id":1789024385000,"createdDate":"2026-09-10 07:13","name":"法国国际广播电台","title":"支联会案判刑前夕 邹幸彤批港府要求充公与罪成理据无关的所有证物 属清洗六四","content":"被裁定煽动颠覆国家政权罪成的支联会及其前正丶副主席李卓人丶何俊仁和邹幸彤，法庭将于明（11日）早判刑，而邹幸彤则在判刑前夕于社交平台发文，透露控方已申请充公与罪成理据无关丶甚至完全没有呈堂的所谓「证物」，包括逾千本与六四事件相关或无关的书籍及物品，但由於支联会已经解散，她及其他人在法律上不能代表该会提出反对，将可让当局达到藉支联会案来清洗「六四」记忆的目的。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260910-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E5%88%A4%E5%88%91%E5%89%8D%E5%A4%95-%E9%82%B9%E5%B9%B8%E5%BD%A4%E6%89%B9%E6%B8%AF%E5%BA%9C%E8%A6%81%E6%B1%82%E5%85%85%E5%85%AC%E4%B8%8E%E7%BD%AA%E6%88%90%E7%90%86%E6%8D%AE%E6%97%A0%E5%85%B3%E7%9A%84%E6%89%80%E6%9C%89%E8%AF%81%E7%89%A9-%E5%B1%9E%E6%B8%85%E6%B4%97%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789024385000.webp","sourceId":"rfi"}]