[{"id":1789044351000,"createdDate":"2026-09-10 12:45","name":"法国国际广播电台","title":"法意等成员国拟促欧盟采取广泛进口配额 主要针对化工和塑料行业","content":"据路透社援引知情人士报导称，多个欧洲国家政府计划敦促欧盟启用一项鲜少使用的贸易防御工具，以保护欧盟化工和塑料行业免受进口激增——主要来自中国——的冲击。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260910-%E6%B3%95%E6%84%8F%E7%AD%89%E6%88%90%E5%91%98%E5%9B%BD%E6%8B%9F%E4%BF%83%E6%AC%A7%E7%9B%9F%E9%87%87%E5%8F%96%E5%B9%BF%E6%B3%9B%E8%BF%9B%E5%8F%A3%E9%85%8D%E9%A2%9D-%E4%B8%BB%E8%A6%81%E9%92%88%E5%AF%B9%E5%8C%96%E5%B7%A5%E5%92%8C%E5%A1%91%E6%96%99%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789044351000.webp","sourceId":"rfi"},{"id":1789044119000,"createdDate":"2026-09-10 12:41","name":"法国国际广播电台","title":"非洲在巴黎国际太空峰会展雄心","content":"在法国首都，多个非洲国家在历时两天的第一届巴黎国际太空峰会（Lepremiersommetinternationalsurl’espace）期间，展现了它们的航天雄心。就此，塞内加尔（leSénégal）和卢旺达(leRwanda)的主要官员分别接受了本台法广非洲组（RFIAfrique）法语记者的采访。非洲内陆国卢旺达的中文国名也有译作盧安達共和国(leRwanda)。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260910-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E5%9C%A8%E5%B7%B4%E9%BB%8E%E5%9B%BD%E9%99%85%E5%A4%AA%E7%A9%BA%E5%B3%B0%E4%BC%9A%E5%B1%95%E9%9B%84%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789044119000.webp","sourceId":"rfi"},{"id":1789039867000,"createdDate":"2026-09-10 11:31","name":"法国国际广播电台","title":"中东战争升级 能源危机来势汹汹","content":"近期美国和伊朗再次爆发激烈冲突，中东紧张局势威胁全球能源运输线，进一步冲击能源供应链和消费价格。东南亚国家菲律宾再度因南海争议跟北京互呛，背后的中美地缘政治角逐和军事安全危机值得密切关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260910-%E4%B8%AD%E4%B8%9C%E6%88%98%E4%BA%89%E5%8D%87%E7%BA%A7-%E8%83%BD%E6%BA%90%E5%8D%B1%E6%9C%BA%E6%9D%A5%E5%8A%BF%E6%B1%B9%E6%B1%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789039867000.webp","sourceId":"rfi"},{"id":1789039823000,"createdDate":"2026-09-10 11:30","name":"法国国际广播电台","title":"习近平12日赴印度出席金砖国家峰会 时隔7年再访印","content":"据官媒新华社报导，中国外交部发言人周四宣布：应印度共和国总理莫迪邀请，国家主席习近平将于9月12日至13日赴印度新德里出席金砖国家领导人第十八次会晤。习近平本周访问印度，将是他七年来首次访印。此次访问有望进一步推动中印外交关系回暖，但目前鲜有迹象显示，两国经贸关系将随之改善。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E4%B9%A0%E8%BF%91%E5%B9%B312%E6%97%A5%E8%B5%B4%E5%8D%B0%E5%BA%A6%E5%87%BA%E5%B8%AD%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A-%E6%97%B6%E9%9A%947%E5%B9%B4%E5%86%8D%E8%AE%BF%E5%8D%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789039823000.webp","sourceId":"rfi"},{"id":1789038445000,"createdDate":"2026-09-10 11:07","name":"法国国际广播电台","title":"防堵中国“欧洲行动太慢了”中小企业群起炮轰：布鲁塞尔宣告将终结“最低价中标”的时代！","content":"大家好，欢迎收听法国报纸摘要。周四9月10日本台订阅的法国日报头版的焦点均不相同。中国方面的报道见于《回声报》经济版，该报指出，欧洲中型企业正在向布鲁塞尔施压，认为与美国和中国相比，欧洲的行动速度太慢了！据悉，欧盟委员会现已提出了一项公共采购改革方案，旨在应对中国倾销行为，以及在不符合互惠原则的情况下，布鲁塞尔有权排除外国运营商参与采购。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260910-%E9%98%B2%E5%A0%B5%E4%B8%AD%E5%9B%BD-%E6%AC%A7%E6%B4%B2%E8%A1%8C%E5%8A%A8%E5%A4%AA%E6%85%A2%E4%BA%86-%E4%B8%AD%E5%B0%8F%E4%BC%81%E4%B8%9A%E7%BE%A4%E8%B5%B7%E7%82%AE%E8%BD%B0-%E5%B8%83%E9%B2%81%E5%A1%9E%E5%B0%94%E5%AE%A3%E5%91%8A%E7%BB%88%E7%BB%93-%E6%9C%80%E4%BD%8E%E4%BB%B7%E4%B8%AD%E6%A0%87-%E7%9A%84%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789038445000.webp","sourceId":"rfi"},{"id":1789036269000,"createdDate":"2026-09-10 10:31","name":"法国国际广播电台","title":"被北京指“哗众取宠” 菲防长：我不是演员，不懂表演 菲海警称中方向其飞机发射照明弹","content":"菲律宾国防部长特奥多罗（GilbertoTeodoro）周四作出回应，此前中国外交部发言人将他在“首尔防务对话”期间的言论未点名地形容为“哗众取宠、挑事生非”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E8%A2%AB%E5%8C%97%E4%BA%AC%E6%8C%87-%E5%93%97%E4%BC%97%E5%8F%96%E5%AE%A0-%E8%8F%B2%E9%98%B2%E9%95%BF-%E6%88%91%E4%B8%8D%E6%98%AF%E6%BC%94%E5%91%98%EF%BC%8C%E4%B8%8D%E6%87%82%E8%A1%A8%E6%BC%94-%E8%8F%B2%E6%B5%B7%E8%AD%A6%E7%A7%B0%E4%B8%AD%E6%96%B9%E5%90%91%E5%85%B6%E9%A3%9E%E6%9C%BA%E5%8F%91%E5%B0%84%E7%85%A7%E6%98%8E%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789036269000.webp","sourceId":"rfi"},{"id":1789032378000,"createdDate":"2026-09-10 09:26","name":"法国国际广播电台","title":"华为案在纽约开审 美检方陈列本案涉及的12项指控：“犯罪是其重要的商业策略”","content":"当地时间周三，针对中国科技巨头华为的审判在布鲁克林联邦法院开庭，一名美国检察官将华为描述为一个通过窃取美国公司技术来建立其电信帝国的犯罪企业。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E5%8D%8E%E4%B8%BA%E6%A1%88%E5%9C%A8%E7%BA%BD%E7%BA%A6%E5%BC%80%E5%AE%A1-%E7%BE%8E%E6%A3%80%E6%96%B9%E9%99%88%E5%88%97%E6%9C%AC%E6%A1%88%E6%B6%89%E5%8F%8A%E7%9A%8412%E9%A1%B9%E6%8C%87%E6%8E%A7-%E5%85%B6%E5%B0%86%E7%8A%AF%E7%BD%AA%E8%A7%86%E4%B8%BA%E9%87%8D%E8%A6%81%E7%9A%84%E5%95%86%E4%B8%9A%E7%AD%96%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789032378000.webp","sourceId":"rfi"},{"id":1789030605000,"createdDate":"2026-09-10 08:56","name":"法国国际广播电台","title":"乌克兰总统出访加拿大，谋求深化两国在国防等领域的合作","content":"法新社引述加拿大媒体报道，乌克兰总统泽连斯基已于昨夜今晨抵达加拿大，将与加拿大总理马克-卡尼会谈。核心话题是如何更好地支持乌克兰抗击俄罗斯入侵的战争。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%80%BB%E7%BB%9F%E5%87%BA%E8%AE%BF%E5%8A%A0%E6%8B%BF%E5%A4%A7%EF%BC%8C%E8%B0%8B%E6%B1%82%E6%B7%B1%E5%8C%96%E4%B8%A4%E5%9B%BD%E5%9C%A8%E5%9B%BD%E9%98%B2%E7%AD%89%E9%A2%86%E5%9F%9F%E7%9A%84%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789030605000.webp","sourceId":"rfi"},{"id":1789026951000,"createdDate":"2026-09-10 07:55","name":"法国国际广播电台","title":"一名澳大利亚人因向中国提供情报被判三年半监禁","content":"一名澳大利亚人因鲁莽向中国情报机构提供信息，周四（9月10日）被悉尼一家法院判处三年半监禁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E4%B8%80%E5%90%8D%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E4%BA%BA%E5%9B%A0%E5%90%91%E4%B8%AD%E5%9B%BD%E6%8F%90%E4%BE%9B%E6%83%85%E6%8A%A5%E8%A2%AB%E5%88%A4%E5%9B%9A%E4%B8%89%E5%B9%B4%E5%8D%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789026951000.webp","sourceId":"rfi"},{"id":1789026560000,"createdDate":"2026-09-10 07:49","name":"法国国际广播电台","title":"刘翔选择买断并捐出工资补助：今后与体育局再无关联 上海市体育局：充分尊重","content":"针对此前引发广泛关注的退役安置“买断”问题，2004年雅典奥运会男子110米栏冠军刘翔周四在个人微博上发文称，自己已于9月1日“买断”，获得49.4万元“买断费”，“今后与体育局再无关联”。上海市体育局官方微信当天发布了对于刘翔退役安置的相关回应，并称“我们会继续关心好包括刘翔在内的所有退役运动员，也祝愿他们在人生新赛道上续写精彩！”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260910-%E5%88%98%E7%BF%94%E9%80%89%E6%8B%A9-%E4%B9%B0%E6%96%AD-%E5%B9%B6%E6%8D%90%E5%87%BA%E5%B7%A5%E8%B5%84%E8%A1%A5%E5%8A%A9-%E4%BB%8A%E5%90%8E%E4%B8%8E%E4%BD%93%E8%82%B2%E5%B1%80%E5%86%8D%E6%97%A0%E5%85%B3%E8%81%94-%E4%B8%8A%E6%B5%B7%E5%B8%82%E4%BD%93%E8%82%B2%E5%B1%80-%E5%85%85%E5%88%86%E5%B0%8A%E9%87%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789026560000.webp","sourceId":"rfi"},{"id":1789024640000,"createdDate":"2026-09-10 07:17","name":"法国国际广播电台","title":"俄罗斯称日本菊花纹章是“军国主义象征” 中国支持俄罗斯","content":"俄罗斯外交部新闻出版司司长，该部门的官方发言人扎哈罗娃在10月9日记者会上，就日本政府要求撤除建立在俄罗斯远东哈巴罗夫斯克，表现苏联士兵捣毁日本菊花纹章“对日战争胜利纪念碑”一事作出回应，她反驳称日方“没有理由对此指手画脚”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A7%B0%E6%97%A5%E6%9C%AC%E8%8F%8A%E8%8A%B1%E7%BA%B9%E7%AB%A0%E6%98%AF-%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E8%B1%A1%E5%BE%81-%E4%B8%AD%E5%9B%BD%E6%94%AF%E6%8C%81%E4%BF%84%E7%BD%97%E6%96%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789024640000.webp","sourceId":"rfi"},{"id":1789024385000,"createdDate":"2026-09-10 07:13","name":"法国国际广播电台","title":"支联会案判刑前夕 邹幸彤批港府要求充公与罪成理据无关的所有证物 属清洗六四","content":"被裁定煽动颠覆国家政权罪成的支联会及其前正丶副主席李卓人丶何俊仁和邹幸彤，法庭将于明（11日）早判刑，而邹幸彤则在判刑前夕于社交平台发文，透露控方已申请充公与罪成理据无关丶甚至完全没有呈堂的所谓「证物」，包括逾千本与六四事件相关或无关的书籍及物品，但由於支联会已经解散，她及其他人在法律上不能代表该会提出反对，将可让当局达到藉支联会案来清洗「六四」记忆的目的。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260910-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E5%88%A4%E5%88%91%E5%89%8D%E5%A4%95-%E9%82%B9%E5%B9%B8%E5%BD%A4%E6%89%B9%E6%B8%AF%E5%BA%9C%E8%A6%81%E6%B1%82%E5%85%85%E5%85%AC%E4%B8%8E%E7%BD%AA%E6%88%90%E7%90%86%E6%8D%AE%E6%97%A0%E5%85%B3%E7%9A%84%E6%89%80%E6%9C%89%E8%AF%81%E7%89%A9-%E5%B1%9E%E6%B8%85%E6%B4%97%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789024385000.webp","sourceId":"rfi"},{"id":1789079328000,"createdDate":"2026-09-10 22:28","name":"法国国际广播电台","title":"最新PISA测评：中国的成绩“看起来很成功”","content":"经合组织9月8日星期二公布了测评全球15岁学生学习能力的PISA测试结果。众多欧洲国家尤其是法国，排名直往下掉。可中国的表现非常突出，中国学生在科学和数学两项测试中排名全球第一。不过，中国并没有大肆庆祝。为什么呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260910-%E6%9C%80%E6%96%B0pisa%E6%B5%8B%E8%AF%84-%E4%B8%AD%E5%9B%BD%E7%9A%84%E6%88%90%E7%BB%A9-%E7%9C%8B%E8%B5%B7%E6%9D%A5%E5%BE%88%E6%88%90%E5%8A%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789079328000.webp","sourceId":"rfi"},{"id":1789076031000,"createdDate":"2026-09-10 21:33","name":"法国国际广播电台","title":"加拿大宣布向乌克兰提供超过2亿欧元的防空援助","content":"乌克兰总统泽连斯基周四访问加拿大，与加拿大总理卡尼举行了会谈。当天，加拿大宣布向乌克兰提供超过2亿欧元的防空援助。双方还签署了一项“长期伙伴关系”协议，将合作生产无人机以及反无人机系统。最后，两国领导人还签署了一份声明。根据声明，加拿大和乌克兰将建立一个为期100年的安全与经济伙伴关系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AE%A3%E5%B8%83%E5%90%91%E4%B9%8C%E5%85%8B%E5%85%B0%E6%8F%90%E4%BE%9B%E8%B6%85%E8%BF%872%E4%BA%BF%E6%AC%A7%E5%85%83%E7%9A%84%E9%98%B2%E7%A9%BA%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789076031000.webp","sourceId":"rfi"},{"id":1789073334000,"createdDate":"2026-09-10 20:48","name":"法国国际广播电台","title":"乌克兰购物中心遭俄罗斯袭击，致5死67伤","content":"乌克兰当局表示，周四（9月10日），俄罗斯对乌克兰中东部城市帕夫洛格勒（Pavlograd）一座购物中心发动袭击，造成至少5人死亡、67人受伤，其中包括8名儿童。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260910-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%B4%AD%E7%89%A9%E4%B8%AD%E5%BF%83%E9%81%AD%E8%A2%AD%E8%87%B45%E6%AD%BB67%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789073334000.webp","sourceId":"rfi"},{"id":1789071596000,"createdDate":"2026-09-10 20:19","name":"法国国际广播电台","title":"美国打击之后，霍尔木兹海峡附近海域疑似出现了浮油带","content":"美国对涉嫌与伊朗革命卫队有关联的油轮实施了打击之后，霍尔木兹海峡附近海域疑似出现了浮油带；这是周四分析的最新卫星图像显示的。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E7%BE%8E%E5%9B%BD%E6%89%93%E5%87%BB%E4%B9%8B%E5%90%8E%EF%BC%8C%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E9%99%84%E8%BF%91%E6%B5%B7%E5%9F%9F%E7%96%91%E4%BC%BC%E5%87%BA%E7%8E%B0%E4%BA%86%E6%B5%AE%E6%B2%B9%E5%B8%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789071596000.webp","sourceId":"rfi"},{"id":1789071232000,"createdDate":"2026-09-10 20:13","name":"法国国际广播电台","title":"周四油价暴涨超6%，创近两月来最大单日涨幅，分析称油价上涨能否持续或取决于中国","content":"路透社消息称，周四（9月10日），油价大幅上涨超过6%。布伦特原油和美国原油两大基准价格均突破每桶100美元。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260910-%E5%91%A8%E5%9B%9B%E6%B2%B9%E4%BB%B7%E6%9A%B4%E6%B6%A8%E8%B6%856-%EF%BC%8C%E5%88%9B%E8%BF%91%E4%B8%A4%E6%9C%88%E6%9D%A5%E6%9C%80%E5%A4%A7%E5%8D%95%E6%97%A5%E6%B6%A8%E5%B9%85%EF%BC%8C%E5%88%86%E6%9E%90%E7%A7%B0%E6%B2%B9%E4%BB%B7%E4%B8%8A%E6%B6%A8%E8%83%BD%E5%90%A6%E6%8C%81%E7%BB%AD%E6%88%96%E5%8F%96%E5%86%B3%E4%BA%8E%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789071232000.webp","sourceId":"rfi"},{"id":1789069376000,"createdDate":"2026-09-10 19:42","name":"法国国际广播电台","title":"京东收购德国电子零售巨头遇阻，遭欧盟审查与竞争对手双重施压","content":"路透社周四（9月10日）报导称，知情人士向路透社透露，京东为缓解欧盟对其以25亿美元收购德国电子产品零售商Ceconomy所涉及的外国补贴问题而提出的让步方案，已经引发竞争对手的批评。知情人士表示，作为欧盟竞争监管机构的欧盟委员会本周早些时候已将竞争对手针对京东上月提出的让步方案所提交的反馈意见告知京东。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260910-%E4%BA%AC%E4%B8%9C%E6%94%B6%E8%B4%AD%E5%BE%B7%E5%9B%BD%E7%94%B5%E5%AD%90%E9%9B%B6%E5%94%AE%E5%B7%A8%E5%A4%B4%E9%81%87%E9%98%BB%EF%BC%8C%E9%81%AD%E6%AC%A7%E7%9B%9F%E5%AE%A1%E6%9F%A5%E4%B8%8E%E7%AB%9E%E4%BA%89%E5%AF%B9%E6%89%8B%E5%8F%8C%E9%87%8D%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789069376000.webp","sourceId":"rfi"},{"id":1789067473000,"createdDate":"2026-09-10 19:11","name":"法国国际广播电台","title":"法国北部敦刻尔克港查获近4吨可卡因，价值约2.25亿欧元","content":"法新社消息称，法国北部敦刻尔克港本周查获约3.9吨可卡因，估值接近2.25亿欧元。这批毒品于周一被发现，但直到周四（9月10日）才由法国国家有组织犯罪检察机关（Pnaco）对外公布。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260910-%E6%B3%95%E5%9B%BD%E5%8C%97%E9%83%A8%E6%95%A6%E5%88%BB%E5%B0%94%E5%85%8B%E6%B8%AF%E6%9F%A5%E8%8E%B7%E8%BF%914%E5%90%A8%E5%8F%AF%E5%8D%A1%E5%9B%A0%EF%BC%8C%E4%BB%B7%E5%80%BC%E7%BA%A62-25%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789067473000.webp","sourceId":"rfi"},{"id":1789066939000,"createdDate":"2026-09-10 19:02","name":"法国国际广播电台","title":"特朗普承诺若中期选举获胜每人发5000美元，总计超1.3万亿美元，钱从哪儿来？","content":"美国总统特朗普周三（9月9日）承诺，如果共和党赢得11月举行的国会选举，他将向每一名美国成年人发放5000美元的“特朗普红利”。除了提到将使用关税收入之外，特朗普并未说明这项承诺将通过何种方式筹集资金。这一方案能否实施以及是否合法，目前都引发了诸多疑问。法新社对此作出了详细的解读。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260910-%E7%89%B9%E6%9C%97%E6%99%AE%E6%89%BF%E8%AF%BA%E8%8B%A5%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E8%8E%B7%E8%83%9C%E6%AF%8F%E4%BA%BA%E5%8F%915000%E7%BE%8E%E5%85%83%EF%BC%8C%E6%80%BB%E8%AE%A1%E8%B6%851-3%E4%B8%87%E4%BA%BF%E7%BE%8E%E5%85%83%EF%BC%8C%E9%92%B1%E4%BB%8E%E5%93%AA%E5%84%BF%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789066939000.webp","sourceId":"rfi"},{"id":1789064398000,"createdDate":"2026-09-10 18:19","name":"法国国际广播电台","title":"韩国与非洲2026经合部长级会议","content":"韩国（2026年）与非洲大陆第八届经合部长会议（KOAFEC）预计将于2026年09月11日周五落幕。非洲大陆所有54个国家都派出了代表团前往首尔。韩国女总理韩圣淑（MmeHanSeongsook）承诺，作为全球高科技的冠军之一，韩国愿把其在此领域的技能给予非洲大陆。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9F%A9%E5%9B%BD%E4%B8%8E%E9%9D%9E%E6%B4%B22026%E7%BB%8F%E5%90%88%E9%83%A8%E9%95%BF%E7%BA%A7%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789064398000.webp","sourceId":"rfi"},{"id":1789064241000,"createdDate":"2026-09-10 18:17","name":"法国国际广播电台","title":"报告：美国企业对中国市场信心回升","content":"美国企业对中国市场的信心在去年跌至历史低点后明显回升。上海美国商会10日公布年度《中国商业报告》显示，58%受访美国企业对未来5年在中国的业务前景，持乐观或略为乐观态度，较前一年增加17个百分点；与此同时，中国国内竞争首次自2022年以来，超越美中紧张关系，成为受访企业最主要的业务挑战。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260910-%E6%8A%A5%E5%91%8A-%E7%BE%8E%E5%9B%BD%E4%BC%81%E4%B8%9A%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%B8%82%E5%9C%BA%E4%BF%A1%E5%BF%83%E5%9B%9E%E5%8D%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789064241000.webp","sourceId":"rfi"},{"id":1789063295000,"createdDate":"2026-09-10 18:01","name":"法国国际广播电台","title":"阿联酋将向德国投资400亿欧元，重点用于建设尖端数据中心","content":"周四（9月10日），阿联酋总统对德国进行访问期间，两国宣布，阿联酋将向德国一系列项目总计投资400亿欧元，其中包括用于建设和发展新数据中心的项目。据悉，这是阿联酋国家元首首次访问德国。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260910-%E9%98%BF%E8%81%94%E9%85%8B%E5%B0%86%E5%90%91%E5%BE%B7%E5%9B%BD%E6%8A%95%E8%B5%84400%E4%BA%BF%E6%AC%A7%E5%85%83%EF%BC%8C%E9%87%8D%E7%82%B9%E7%94%A8%E4%BA%8E%E5%BB%BA%E8%AE%BE%E5%B0%96%E7%AB%AF%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789063295000.webp","sourceId":"rfi"},{"id":1789062371000,"createdDate":"2026-09-10 17:46","name":"法国国际广播电台","title":"韩国情报部门：金正恩的女儿金主爱可能还有一个弟弟或妹妹","content":"据法新社消息，韩国情报部门周四（9月10日）表示，朝鲜最高领导人金正恩的女儿金主爱（KimJuAe）被认为可能是潜在的接班人，而她似乎还有一名年龄更小的弟弟或妹妹。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260910-%E9%9F%A9%E5%9B%BD%E6%83%85%E6%8A%A5%E9%83%A8%E9%97%A8-%E9%87%91%E6%AD%A3%E6%81%A9%E7%9A%84%E5%A5%B3%E5%84%BF%E9%87%91%E4%B8%BB%E7%88%B1%E5%8F%AF%E8%83%BD%E8%BF%98%E6%9C%89%E4%B8%80%E4%B8%AA%E5%BC%9F%E5%BC%9F%E6%88%96%E5%A6%B9%E5%A6%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789062371000.webp","sourceId":"rfi"},{"id":1789055820000,"createdDate":"2026-09-10 15:57","name":"法国国际广播电台","title":"特朗普政府提案取消H-1B签证持有者失业后的60天宽限期","content":"根据周四在线发布的一份政府公告，特朗普政府提议取消一项为期60天的宽限期；该宽限期允许包括持有H-1B签证的熟练工人在内的特定移民在失业后继续留美并寻找新的担保雇主。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260910-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E6%8F%90%E8%AE%AE%E5%8F%96%E6%B6%88h-1b%E6%8C%81%E6%9C%89%E8%80%85%E5%A4%B1%E4%B8%9A%E5%90%8E%E7%9A%8460%E5%A4%A9%E5%AE%BD%E9%99%90%E6%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789055820000.webp","sourceId":"rfi"},{"id":1789054731000,"createdDate":"2026-09-10 15:38","name":"法国国际广播电台","title":"中方据报愿协助促成特金再会 北京正着手发挥“积极、建设性”作用","content":"据《南华早报》援引消息人士报导称，中国愿意协助促成美国总统特朗普与朝鲜最高领导人金正恩之间可能举行的会晤；而就在几周后，中国国家主席习近平预计将前往华盛顿参加美中峰会。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E4%B8%AD%E6%96%B9%E6%8D%AE%E6%8A%A5%E6%84%BF%E5%8D%8F%E5%8A%A9%E4%BF%83%E6%88%90%E7%89%B9%E9%87%91%E5%86%8D%E4%BC%9A-%E5%8C%97%E4%BA%AC%E6%AD%A3%E7%9D%80%E6%89%8B%E5%8F%91%E6%8C%A5-%E7%A7%AF%E6%9E%81-%E5%BB%BA%E8%AE%BE%E6%80%A7-%E4%BD%9C%E7%94%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789054731000.webp","sourceId":"rfi"},{"id":1789053040000,"createdDate":"2026-09-10 15:10","name":"法国国际广播电台","title":"何为生态焦虑？为何引发公共卫生部门关注？","content":"酷暑高温天气对健康的影响已是毋庸置疑。2026年夏一波又一波的热浪直接或间接导致死亡率上升就是最好的证明。但气候变化加速、极端天气频发对人类精神健康的影响才刚刚引起公共卫生部门的关注。近年来一个新名词逐渐进入公众视野：éco-anxiété。我们暂且把它译作生态焦虑。法国政府为此在今年7月底启动宣传活动：如何应对生态焦虑。何为“生态焦虑”？法国政府何以为此启动全国范围的宣传活动？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%81%A5%E5%BA%B7%E6%97%B6%E9%97%B4/20260910-%E4%BD%95%E4%B8%BA%E7%94%9F%E6%80%81%E7%84%A6%E8%99%91-%E4%B8%BA%E4%BD%95%E5%BC%95%E5%8F%91%E5%85%AC%E5%85%B1%E5%8D%AB%E7%94%9F%E9%83%A8%E9%97%A8%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789053040000.webp","sourceId":"rfi"},{"id":1789052504000,"createdDate":"2026-09-10 15:01","name":"法国国际广播电台","title":"国际原子能机构总干事：伊朗镐山存在施工活动 特朗普：我们注意到那边有动静","content":"国际原子能机构向彭博社表示，该机构监测到伊朗镐山（PickaxeMountain）存在施工活动。这处被称为镐山的设施位于德黑兰以南约225公里处的纳坦兹核设施附近，长期以来一直是情报机构关注的焦点；这些机构认为，该地点很可能是伊朗政权为保护其未来核计划相关活动而选定的场所。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260910-%E5%9B%BD%E9%99%85%E5%8E%9F%E5%AD%90%E8%83%BD%E6%9C%BA%E6%9E%84%E6%80%BB%E5%B9%B2%E4%BA%8B-%E4%BC%8A%E6%9C%97%E9%95%90%E5%B1%B1%E5%AD%98%E5%9C%A8%E6%96%BD%E5%B7%A5%E6%B4%BB%E5%8A%A8-%E7%89%B9%E6%9C%97%E6%99%AE-%E6%88%91%E4%BB%AC%E6%B3%A8%E6%84%8F%E5%88%B0%E9%82%A3%E8%BE%B9%E6%9C%89%E5%8A%A8%E9%9D%99","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789052504000.webp","sourceId":"rfi"},{"id":1789050089000,"createdDate":"2026-09-10 14:21","name":"法国国际广播电台","title":"中伊据报通过“以油易物”机制规避制裁 涉及基础设施项目、药品和防空装备等","content":"据路透社援引两名伊朗高层消息人士及另外三名知情人士报导称，伊朗利用一种类似以货换货贸易的安排，绕过了针对其石油销售的制裁，并从中国购入了价值数十亿美元的商品，其中包括军事装备。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260910-%E4%B8%AD%E4%BC%8A%E6%8D%AE%E6%8A%A5%E9%80%9A%E8%BF%87-%E4%BB%A5%E6%B2%B9%E6%98%93%E7%89%A9-%E6%9C%BA%E5%88%B6%E8%A7%84%E9%81%BF%E5%88%B6%E8%A3%81-%E6%B6%89%E5%8F%8A%E5%9F%BA%E7%A1%80%E8%AE%BE%E6%96%BD%E9%A1%B9%E7%9B%AE-%E8%8D%AF%E5%93%81%E5%92%8C%E9%98%B2%E7%A9%BA%E8%A3%85%E5%A4%87%E7%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789050089000.webp","sourceId":"rfi"},{"id":1789049659000,"createdDate":"2026-09-10 14:14","name":"法国国际广播电台","title":"毛泽东逝世50周年：法国纪录片“末代皇帝毛泽东”巴黎线下首映","content":"恰逢中国领导人毛泽东逝世50周年，中国纪录片电影节EcransdeChine9月10日在巴黎六区放映法国记者SergedeSampigny制作的纪录片Maoledernierempereur。并在放映活动后，邀请法国著名汉学家玛丽-侯芷明、专注研究中国地缘政治的研究员瓦莱里-尼凯以及电影节主办人MichelNoll,与现场观众互动、讨论。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260910-%E6%AF%9B%E6%B3%BD%E4%B8%9C%E9%80%9D%E4%B8%9650%E5%91%A8%E5%B9%B4-%E6%B3%95%E5%9B%BD%E7%BA%AA%E5%BD%95%E7%89%87-%E6%9C%AB%E4%BB%A3%E7%9A%87%E5%B8%9D%E6%AF%9B%E6%B3%BD%E4%B8%9C-%E5%B7%B4%E9%BB%8E%E7%BA%BF%E4%B8%8B%E9%A6%96%E6%98%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789049659000.webp","sourceId":"rfi"},{"id":1789047192000,"createdDate":"2026-09-10 13:33","name":"法国国际广播电台","title":"回声报：香港，今成俄罗斯通往中国的“黄金”桥梁","content":"据《回声报》金融版周四（9月10日）报道，黄金正成为莫斯科和北京关系中的关键杠杆。不受制裁的香港吸引了大量俄罗斯金条流入。中国希望在全球黄金市场确立其核心地位。这种贵金属正日益成为中俄外交关系中的关键要素，其重要性堪比能源流动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260910-%E5%9B%9E%E5%A3%B0%E6%8A%A5-%E9%A6%99%E6%B8%AF%EF%BC%8C%E4%BB%8A%E6%88%90%E4%BF%84%E7%BD%97%E6%96%AF%E9%80%9A%E5%BE%80%E4%B8%AD%E5%9B%BD%E7%9A%84-%E9%BB%84%E9%87%91-%E6%A1%A5%E6%A2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789047192000.webp","sourceId":"rfi"},{"id":1789046594000,"createdDate":"2026-09-10 13:23","name":"法国国际广播电台","title":"美海军一官员肯定日本探讨拥有核动力潜艇：核电站与核潜艇所利用的都是核能","content":"美国海军一名官员周三（9日）就日本国内出现的探讨拥有核潜艇动向一事，表达了肯定看法，指出日本已拥有核电站，具备作为基础的发电技术。当被问及日本是否应考虑引进核潜艇时，该官员回答称：“我认为应该”。该官员是在夏威夷的美军设施内接受共同社等媒体采访时作出上述发言的。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260910-%E7%BE%8E%E6%B5%B7%E5%86%9B%E4%B8%80%E5%AE%98%E5%91%98%E8%82%AF%E5%AE%9A%E6%97%A5%E6%9C%AC%E6%8E%A2%E8%AE%A8%E6%8B%A5%E6%9C%89%E6%A0%B8%E5%8A%A8%E5%8A%9B%E6%BD%9C%E8%89%87-%E6%A0%B8%E7%94%B5%E7%AB%99%E4%B8%8E%E6%A0%B8%E6%BD%9C%E8%89%87%E6%89%80%E5%88%A9%E7%94%A8%E7%9A%84%E9%83%BD%E6%98%AF%E6%A0%B8%E8%83%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/10/1789046594000.webp","sourceId":"rfi"}]