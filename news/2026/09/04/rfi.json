[{"id":1788523893000,"createdDate":"2026-09-04 12:11","name":"法国国际广播电台","title":"万斯称与伊朗的冲突不算“战争”：中期选举前，特朗普政府如何重塑伊朗战争叙事？","content":"周四（9月3日），美国副总统JD·万斯拒绝使用“战争”一词来描述美国与伊朗之间的战事。在白宫举行的新闻发布会上，当被问及战事能否在选民于11月3日举行的国会选举投票之前结束时，万斯说：“我不会把它称为战争。现在已经没有正在进行的交火。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260904-%E4%B8%87%E6%96%AF%E7%A7%B0%E4%B8%8E%E4%BC%8A%E6%9C%97%E7%9A%84%E5%86%B2%E7%AA%81%E4%B8%8D%E7%AE%97-%E6%88%98%E4%BA%89-%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%89%8D%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%A6%82%E4%BD%95%E9%87%8D%E5%A1%91%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E5%8F%99%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788523893000.webp","sourceId":"rfi"},{"id":1788523786000,"createdDate":"2026-09-04 12:09","name":"法国国际广播电台","title":"视频 林佳龙批中国战狼外交","content":"台湾外交部长林佳龙率团出访太平洋友邦帕劳，并受邀参加第55届太平洋岛国论坛峰会等相关活动 ，随后林佳龙4日回台湾后出席活动接受媒体联访时透露，此次太平洋岛国论坛峰会期间几乎每场活动会场，都可见中共派出“便衣”紧随，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E8%A7%86%E9%A2%91-%E6%9E%97%E4%BD%B3%E9%BE%99%E6%89%B9%E4%B8%AD%E5%9B%BD%E6%88%98%E7%8B%BC%E5%A4%96%E4%BA%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788523786000.webp","sourceId":"rfi"},{"id":1788522492000,"createdDate":"2026-09-04 11:48","name":"法国国际广播电台","title":"韩国考虑派兵协助维护霍尔木兹海峡安全","content":"韩国总统府周五表示，正考虑为保障霍尔木兹海峡航行安全作出“贡献”。韩国总统府一名发言人对媒体表示：可在不影响半岛防卫态势的前提下考虑向霍尔木兹派兵，并称派兵并不等于一定参战。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E9%9F%A9%E5%9B%BD%E8%80%83%E8%99%91%E6%B4%BE%E5%85%B5%E5%8D%8F%E5%8A%A9%E7%BB%B4%E6%8A%A4%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788522492000.webp","sourceId":"rfi"},{"id":1788517734000,"createdDate":"2026-09-04 10:28","name":"法国国际广播电台","title":"欧洲卡车市场将面临中国攻势，法国雷诺要如何捍卫疆土？","content":"面对来自中国的潜在竞争，雷诺卡车等欧洲重型货车制造商正专注于创新和售后服务质量，以保住市场份额。与此同时，据德国工商会（DIHK）的最新调查，即便可能产生负面影响，55%的德国企业支持更严格的贸易措施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20260904-%E6%AC%A7%E6%B4%B2%E5%8D%A1%E8%BD%A6%E5%B8%82%E5%9C%BA%E5%B0%86%E9%9D%A2%E4%B8%B4%E4%B8%AD%E5%9B%BD%E6%94%BB%E5%8A%BF%EF%BC%8C%E6%B3%95%E5%9B%BD%E9%9B%B7%E8%AF%BA%E8%A6%81%E5%A6%82%E4%BD%95%E6%8D%8D%E5%8D%AB%E7%96%86%E5%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788517734000.webp","sourceId":"rfi"},{"id":1788516442000,"createdDate":"2026-09-04 10:07","name":"法国国际广播电台","title":"抗战胜利81周年  中国表示坚决遏制日本“新型军国主义”","content":"2026年9月3日，纪念中国人民抗日战争暨世界反法西斯战争胜利81周年座谈会在北京举行。在9月3日中国外交部的记者会上，发言人郭嘉昆指出：坚决遏止日本“新型军国主义”披着“国家正常化”外衣滋长成势、祸乱地区、为害世界。9月2中国人民解放军英文版官方X账号（@ChinaMilBugle）发布的短篇动画《和平的面具》，内容旨在批评日本强化防卫力量。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260904-%E6%8A%97%E6%88%98%E8%83%9C%E5%88%A981%E5%91%A8%E5%B9%B4-%E4%B8%AD%E5%9B%BD%E8%A1%A8%E7%A4%BA%E5%9D%9A%E5%86%B3%E9%81%8F%E5%88%B6%E6%97%A5%E6%9C%AC-%E6%96%B0%E5%9E%8B%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788516442000.webp","sourceId":"rfi"},{"id":1788514043000,"createdDate":"2026-09-04 09:27","name":"法国国际广播电台","title":"瑙鲁反对 太平洋岛国论坛峰会未对中国导弹试验达成一致谴责","content":"太平洋岛国领导人在峰会上一致同意对中国向其水域发射弹道导弹表示集体“关切”，但他们周四表示，该声明获得并非一致通过，且未对北京的行为做出更为严厉的谴责。今年的峰会在帕劳举行。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E7%91%99%E9%B2%81%E5%8F%8D%E5%AF%B9-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B3%B0%E4%BC%9A%E6%9C%AA%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%AF%BC%E5%BC%B9%E8%AF%95%E9%AA%8C%E8%BE%BE%E6%88%90%E4%B8%80%E8%87%B4%E8%B0%B4%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788514043000.webp","sourceId":"rfi"},{"id":1788511375000,"createdDate":"2026-09-04 08:42","name":"法国国际广播电台","title":"敏昂莱访问越南，寻求进一步摆脱“外交孤立”","content":"综合美联社和法新社的消息，缅甸军方支持的政府领导人敏昂莱周五（9月4日）抵达越南，与越南领导人举行会谈。预计在为期三天的访问期间，敏昂莱将与越南国家主席苏林举行会晤，并参加经济论坛，同时访问数字科技和电子企业。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260904-%E6%95%8F%E6%98%82%E8%8E%B1%E8%AE%BF%E9%97%AE%E8%B6%8A%E5%8D%97%EF%BC%8C%E5%AF%BB%E6%B1%82%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%91%86%E8%84%B1-%E5%A4%96%E4%BA%A4%E5%AD%A4%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788511375000.webp","sourceId":"rfi"},{"id":1788510474000,"createdDate":"2026-09-04 08:27","name":"法国国际广播电台","title":"国民党主席郑丽文造势险遭呼巴掌 更被批选举战略错误若蓝白合破局将成祸首","content":"国民党主席郑丽文陪同新竹县长参选人徐欣莹与竹北市长参选人吴旭智在3日一同登记参选，却遭新竹前县长范振宗批评，蓝白合破局罪魁祸首，更作势要打郑丽文巴掌。此举引出选举蓝白合的争议。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E5%9B%BD%E6%B0%91%E5%85%9A%E4%B8%BB%E5%B8%AD%E9%83%91%E4%B8%BD%E6%96%87%E9%80%A0%E5%8A%BF%E9%99%A9%E9%81%AD%E5%91%BC%E5%B7%B4%E6%8E%8C-%E6%9B%B4%E8%A2%AB%E6%89%B9%E9%80%89%E4%B8%BE%E6%88%98%E7%95%A5%E9%94%99%E8%AF%AF%E8%8B%A5%E8%93%9D%E7%99%BD%E5%90%88%E7%A0%B4%E5%B1%80%E5%B0%86%E6%88%90%E7%A5%B8%E9%A6%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788510474000.webp","sourceId":"rfi"},{"id":1788504270000,"createdDate":"2026-09-04 06:44","name":"法国国际广播电台","title":"西九突取消有社运背景音乐人黄衍仁演出 拒谈原因","content":"有「社运歌手」之称的独立音乐人黄衍仁和低音大提琴手冯晟睎原订今(4日)晚在西九文化区M+博物馆的「M+夜不同」系列中演出，但突然在演出前夕被取消，馆方和演出者均没有解释改动原因，但曾经获得最佳原创电影音乐奖的黄衍仁指出，西九对其演出「一直由头support(支持)到尾」，意味取消与外力有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E8%A5%BF%E4%B9%9D%E7%AA%81%E5%8F%96%E6%B6%88%E6%9C%89%E7%A4%BE%E8%BF%90%E8%83%8C%E6%99%AF%E9%9F%B3%E4%B9%90%E4%BA%BA%E9%BB%84%E8%A1%8D%E4%BB%81%E6%BC%94%E5%87%BA-%E6%8B%92%E8%B0%88%E5%8E%9F%E5%9B%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788504270000.webp","sourceId":"rfi"},{"id":1788503803000,"createdDate":"2026-09-04 06:36","name":"法国国际广播电台","title":"香港马会两度受挫 从化赛马突无限期延期 料与非法赌博难阻中国资金外流有关","content":"继投资10亿港元(下同，折算约1.1亿欧元)的篮球博彩合法化於4月突被叫停後，香港赛马会投资百亿元的广州从化马场，原订10月底在该处举行的首场国际赛马赛事，亦因接获中国内地有关部门「最新风险评估」而突告延期，且未有新的开赛日期。事件惹来热议，原因亦众说纷纭，有评论认为，事件应与中国近来收紧银根丶防止资金外流有关，因为从化马场虽不设投注，但资金可循境外非法投注流走。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E9%A6%99%E6%B8%AF%E9%A9%AC%E4%BC%9A%E4%B8%A4%E5%BA%A6%E5%8F%97%E6%8C%AB-%E4%BB%8E%E5%8C%96%E8%B5%9B%E9%A9%AC%E7%AA%81%E6%97%A0%E9%99%90%E6%9C%9F%E5%BB%B6%E6%9C%9F-%E6%96%99%E4%B8%8E%E9%9D%9E%E6%B3%95%E8%B5%8C%E5%8D%9A%E9%9A%BE%E9%98%BB%E4%B8%AD%E5%9B%BD%E8%B5%84%E9%87%91%E5%A4%96%E6%B5%81%E6%9C%89%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788503803000.webp","sourceId":"rfi"}]