[{"id":1788523893000,"createdDate":"2026-09-04 12:11","name":"法国国际广播电台","title":"万斯称与伊朗的冲突不算“战争”：中期选举前，特朗普政府如何重塑伊朗战争叙事？","content":"周四（9月3日），美国副总统JD·万斯拒绝使用“战争”一词来描述美国与伊朗之间的战事。在白宫举行的新闻发布会上，当被问及战事能否在选民于11月3日举行的国会选举投票之前结束时，万斯说：“我不会把它称为战争。现在已经没有正在进行的交火。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260904-%E4%B8%87%E6%96%AF%E7%A7%B0%E4%B8%8E%E4%BC%8A%E6%9C%97%E7%9A%84%E5%86%B2%E7%AA%81%E4%B8%8D%E7%AE%97-%E6%88%98%E4%BA%89-%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%89%8D%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%A6%82%E4%BD%95%E9%87%8D%E5%A1%91%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E5%8F%99%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788523893000.webp","sourceId":"rfi"},{"id":1788523786000,"createdDate":"2026-09-04 12:09","name":"法国国际广播电台","title":"视频 林佳龙批中国战狼外交","content":"台湾外交部长林佳龙率团出访太平洋友邦帕劳，并受邀参加第55届太平洋岛国论坛峰会等相关活动 ，随后林佳龙4日回台湾后出席活动接受媒体联访时透露，此次太平洋岛国论坛峰会期间几乎每场活动会场，都可见中共派出“便衣”紧随，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E8%A7%86%E9%A2%91-%E6%9E%97%E4%BD%B3%E9%BE%99%E6%89%B9%E4%B8%AD%E5%9B%BD%E6%88%98%E7%8B%BC%E5%A4%96%E4%BA%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788523786000.webp","sourceId":"rfi"},{"id":1788522492000,"createdDate":"2026-09-04 11:48","name":"法国国际广播电台","title":"韩国考虑派兵协助维护霍尔木兹海峡安全","content":"韩国总统府周五表示，正考虑为保障霍尔木兹海峡航行安全作出“贡献”。韩国总统府一名发言人对媒体表示：可在不影响半岛防卫态势的前提下考虑向霍尔木兹派兵，并称派兵并不等于一定参战。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E9%9F%A9%E5%9B%BD%E8%80%83%E8%99%91%E6%B4%BE%E5%85%B5%E5%8D%8F%E5%8A%A9%E7%BB%B4%E6%8A%A4%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788522492000.webp","sourceId":"rfi"},{"id":1788517734000,"createdDate":"2026-09-04 10:28","name":"法国国际广播电台","title":"欧洲卡车市场将面临中国攻势，法国雷诺要如何捍卫疆土？","content":"面对来自中国的潜在竞争，雷诺卡车等欧洲重型货车制造商正专注于创新和售后服务质量，以保住市场份额。与此同时，据德国工商会（DIHK）的最新调查，即便可能产生负面影响，55%的德国企业支持更严格的贸易措施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20260904-%E6%AC%A7%E6%B4%B2%E5%8D%A1%E8%BD%A6%E5%B8%82%E5%9C%BA%E5%B0%86%E9%9D%A2%E4%B8%B4%E4%B8%AD%E5%9B%BD%E6%94%BB%E5%8A%BF%EF%BC%8C%E6%B3%95%E5%9B%BD%E9%9B%B7%E8%AF%BA%E8%A6%81%E5%A6%82%E4%BD%95%E6%8D%8D%E5%8D%AB%E7%96%86%E5%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788517734000.webp","sourceId":"rfi"},{"id":1788516442000,"createdDate":"2026-09-04 10:07","name":"法国国际广播电台","title":"抗战胜利81周年  中国表示坚决遏制日本“新型军国主义”","content":"2026年9月3日，纪念中国人民抗日战争暨世界反法西斯战争胜利81周年座谈会在北京举行。在9月3日中国外交部的记者会上，发言人郭嘉昆指出：坚决遏止日本“新型军国主义”披着“国家正常化”外衣滋长成势、祸乱地区、为害世界。9月2中国人民解放军英文版官方X账号（@ChinaMilBugle）发布的短篇动画《和平的面具》，内容旨在批评日本强化防卫力量。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260904-%E6%8A%97%E6%88%98%E8%83%9C%E5%88%A981%E5%91%A8%E5%B9%B4-%E4%B8%AD%E5%9B%BD%E8%A1%A8%E7%A4%BA%E5%9D%9A%E5%86%B3%E9%81%8F%E5%88%B6%E6%97%A5%E6%9C%AC-%E6%96%B0%E5%9E%8B%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788516442000.webp","sourceId":"rfi"},{"id":1788514043000,"createdDate":"2026-09-04 09:27","name":"法国国际广播电台","title":"瑙鲁反对 太平洋岛国论坛峰会未对中国导弹试验达成一致谴责","content":"太平洋岛国领导人在峰会上一致同意对中国向其水域发射弹道导弹表示集体“关切”，但他们周四表示，该声明获得并非一致通过，且未对北京的行为做出更为严厉的谴责。今年的峰会在帕劳举行。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E7%91%99%E9%B2%81%E5%8F%8D%E5%AF%B9-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B3%B0%E4%BC%9A%E6%9C%AA%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%AF%BC%E5%BC%B9%E8%AF%95%E9%AA%8C%E8%BE%BE%E6%88%90%E4%B8%80%E8%87%B4%E8%B0%B4%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788514043000.webp","sourceId":"rfi"},{"id":1788511375000,"createdDate":"2026-09-04 08:42","name":"法国国际广播电台","title":"敏昂莱访问越南，寻求进一步摆脱“外交孤立”","content":"综合美联社和法新社的消息，缅甸军方支持的政府领导人敏昂莱周五（9月4日）抵达越南，与越南领导人举行会谈。预计在为期三天的访问期间，敏昂莱将与越南国家主席苏林举行会晤，并参加经济论坛，同时访问数字科技和电子企业。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260904-%E6%95%8F%E6%98%82%E8%8E%B1%E8%AE%BF%E9%97%AE%E8%B6%8A%E5%8D%97%EF%BC%8C%E5%AF%BB%E6%B1%82%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%91%86%E8%84%B1-%E5%A4%96%E4%BA%A4%E5%AD%A4%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788511375000.webp","sourceId":"rfi"},{"id":1788510474000,"createdDate":"2026-09-04 08:27","name":"法国国际广播电台","title":"国民党主席郑丽文造势险遭呼巴掌 更被批选举战略错误若蓝白合破局将成祸首","content":"国民党主席郑丽文陪同新竹县长参选人徐欣莹与竹北市长参选人吴旭智在3日一同登记参选，却遭新竹前县长范振宗批评，蓝白合破局罪魁祸首，更作势要打郑丽文巴掌。此举引出选举蓝白合的争议。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E5%9B%BD%E6%B0%91%E5%85%9A%E4%B8%BB%E5%B8%AD%E9%83%91%E4%B8%BD%E6%96%87%E9%80%A0%E5%8A%BF%E9%99%A9%E9%81%AD%E5%91%BC%E5%B7%B4%E6%8E%8C-%E6%9B%B4%E8%A2%AB%E6%89%B9%E9%80%89%E4%B8%BE%E6%88%98%E7%95%A5%E9%94%99%E8%AF%AF%E8%8B%A5%E8%93%9D%E7%99%BD%E5%90%88%E7%A0%B4%E5%B1%80%E5%B0%86%E6%88%90%E7%A5%B8%E9%A6%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788510474000.webp","sourceId":"rfi"},{"id":1788504270000,"createdDate":"2026-09-04 06:44","name":"法国国际广播电台","title":"西九突取消有社运背景音乐人黄衍仁演出 拒谈原因","content":"有「社运歌手」之称的独立音乐人黄衍仁和低音大提琴手冯晟睎原订今(4日)晚在西九文化区M+博物馆的「M+夜不同」系列中演出，但突然在演出前夕被取消，馆方和演出者均没有解释改动原因，但曾经获得最佳原创电影音乐奖的黄衍仁指出，西九对其演出「一直由头support(支持)到尾」，意味取消与外力有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E8%A5%BF%E4%B9%9D%E7%AA%81%E5%8F%96%E6%B6%88%E6%9C%89%E7%A4%BE%E8%BF%90%E8%83%8C%E6%99%AF%E9%9F%B3%E4%B9%90%E4%BA%BA%E9%BB%84%E8%A1%8D%E4%BB%81%E6%BC%94%E5%87%BA-%E6%8B%92%E8%B0%88%E5%8E%9F%E5%9B%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788504270000.webp","sourceId":"rfi"},{"id":1788503803000,"createdDate":"2026-09-04 06:36","name":"法国国际广播电台","title":"香港马会两度受挫 从化赛马突无限期延期 料与非法赌博难阻中国资金外流有关","content":"继投资10亿港元(下同，折算约1.1亿欧元)的篮球博彩合法化於4月突被叫停後，香港赛马会投资百亿元的广州从化马场，原订10月底在该处举行的首场国际赛马赛事，亦因接获中国内地有关部门「最新风险评估」而突告延期，且未有新的开赛日期。事件惹来热议，原因亦众说纷纭，有评论认为，事件应与中国近来收紧银根丶防止资金外流有关，因为从化马场虽不设投注，但资金可循境外非法投注流走。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260904-%E9%A6%99%E6%B8%AF%E9%A9%AC%E4%BC%9A%E4%B8%A4%E5%BA%A6%E5%8F%97%E6%8C%AB-%E4%BB%8E%E5%8C%96%E8%B5%9B%E9%A9%AC%E7%AA%81%E6%97%A0%E9%99%90%E6%9C%9F%E5%BB%B6%E6%9C%9F-%E6%96%99%E4%B8%8E%E9%9D%9E%E6%B3%95%E8%B5%8C%E5%8D%9A%E9%9A%BE%E9%98%BB%E4%B8%AD%E5%9B%BD%E8%B5%84%E9%87%91%E5%A4%96%E6%B5%81%E6%9C%89%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788503803000.webp","sourceId":"rfi"},{"id":1788565112000,"createdDate":"2026-09-04 23:38","name":"法国国际广播电台","title":"习近平访问埃及，尝试挑战美国在中东的核心地位","content":"在访问埃及期间，习近平表示，中东人民应该自己处理自己的事务。外部势力的干涉应该被拒绝。他还呼吁地区国家探索建立新的安全架构。这实际上是在挑战美国长期主导的中东安全体系。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260904-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E9%97%AE%E5%9F%83%E5%8F%8A%EF%BC%8C%E5%B0%9D%E8%AF%95%E6%8C%91%E6%88%98%E7%BE%8E%E5%9B%BD%E5%9C%A8%E4%B8%AD%E4%B8%9C%E7%9A%84%E6%A0%B8%E5%BF%83%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788565112000.webp","sourceId":"rfi"},{"id":1788558672000,"createdDate":"2026-09-04 21:51","name":"法国国际广播电台","title":"欧盟希望禁止向经合组织以外的国家出口铝废料","content":"欧盟工业事务专员塞茹尔内的团队周五表示，塞茹尔内将在今年年底之前提出相关措施，限制将铝废料出口到欧洲以外的国家。铝废料是欧洲工业非常重要的资源之一。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260904-%E6%AC%A7%E7%9B%9F%E5%B8%8C%E6%9C%9B%E7%A6%81%E6%AD%A2%E5%90%91%E7%BB%8F%E5%90%88%E7%BB%84%E7%BB%87%E4%BB%A5%E5%A4%96%E7%9A%84%E5%9B%BD%E5%AE%B6%E5%87%BA%E5%8F%A3%E9%93%9D%E5%BA%9F%E6%96%99","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788558672000.webp","sourceId":"rfi"},{"id":1788558486000,"createdDate":"2026-09-04 21:48","name":"法国国际广播电台","title":"联合国粮农组织：干旱与战争推升8月食品价格","content":"联合国粮食及农业组织周五（9月4日）公布的数据显示，干旱、高温和武装冲突冲击全球大宗商品市场，推动2026年8月食品价格进一步上涨，其中食糖价格升至一年多来的最高水平。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E8%81%94%E5%90%88%E5%9B%BD%E7%B2%AE%E5%86%9C%E7%BB%84%E7%BB%87-%E5%B9%B2%E6%97%B1%E4%B8%8E%E6%88%98%E4%BA%89%E6%8E%A8%E5%8D%878%E6%9C%88%E9%A3%9F%E5%93%81%E4%BB%B7%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788558486000.webp","sourceId":"rfi"},{"id":1788558305000,"createdDate":"2026-09-04 21:45","name":"法国国际广播电台","title":"俄无人机袭击乌克兰安全局总部 基辅称局长办公室成为目标","content":"乌克兰安全局总部周五（9月4日）遭俄罗斯无人机袭击。这起发生在基辅市中心的引人注目的袭击，据乌克兰总统泽连斯基称，目标是这个重要安全机构负责人波克拉德的办公室。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E4%BF%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E4%B9%8C%E5%85%8B%E5%85%B0%E5%AE%89%E5%85%A8%E5%B1%80%E6%80%BB%E9%83%A8-%E5%9F%BA%E8%BE%85%E7%A7%B0%E5%B1%80%E9%95%BF%E5%8A%9E%E5%85%AC%E5%AE%A4%E6%88%90%E4%B8%BA%E7%9B%AE%E6%A0%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788558305000.webp","sourceId":"rfi"},{"id":1788558134000,"createdDate":"2026-09-04 21:42","name":"法国国际广播电台","title":"特朗普派特使赴莫斯科和基辅 推动结束俄乌战争方案","content":"美国总统特朗普周五（9月4日）表示，他已派遣特使库什纳和威特科夫前往莫斯科和基辅，就一项旨在结束乌克兰战争的方案展开磋商。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E7%89%B9%E6%9C%97%E6%99%AE%E6%B4%BE%E7%89%B9%E4%BD%BF%E8%B5%B4%E8%8E%AB%E6%96%AF%E7%A7%91%E5%92%8C%E5%9F%BA%E8%BE%85-%E6%8E%A8%E5%8A%A8%E7%BB%93%E6%9D%9F%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%89%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788558134000.webp","sourceId":"rfi"},{"id":1788557540000,"createdDate":"2026-09-04 21:32","name":"法国国际广播电台","title":"特朗普宣布将设国宴款待习近平 中方拟组织大型企业家代表团随访","content":"美国总统特朗普周五（9月4日）宣布，中国国家主席习近平9月24日访问白宫期间，美方将为其举行国宴。与此同时，据路透社援引消息人士报道，习近平正准备率领一个规模庞大的中国企业家代表团访问华盛顿，以推动中美投资与经贸关系。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%B0%86%E8%AE%BE%E5%9B%BD%E5%AE%B4%E6%AC%BE%E5%BE%85%E4%B9%A0%E8%BF%91%E5%B9%B3-%E4%B8%AD%E6%96%B9%E6%8B%9F%E7%BB%84%E7%BB%87%E5%A4%A7%E5%9E%8B%E4%BC%81%E4%B8%9A%E5%AE%B6%E4%BB%A3%E8%A1%A8%E5%9B%A2%E9%9A%8F%E8%AE%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788557540000.webp","sourceId":"rfi"},{"id":1788553251000,"createdDate":"2026-09-04 20:20","name":"法国国际广播电台","title":"美中拟9月中旬首次举行AI安全对话","content":"美国与中国正筹备9月中旬举行AI安全对话，知情人士告诉路透社，双方可能讨论如何监测人工智能引发的网路攻击，以及建立机制防止先进AI系统遭到滥用。这将是美国总统特朗普（DonaldTrump）第二任期以来，美中首次专门聚焦AI的正式双边对话。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E7%BE%8E%E4%B8%AD%E6%8B%9F9%E6%9C%88%E4%B8%AD%E6%97%AC%E9%A6%96%E6%AC%A1%E4%B8%BE%E8%A1%8Cai%E5%AE%89%E5%85%A8%E5%AF%B9%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788553251000.webp","sourceId":"rfi"},{"id":1788544562000,"createdDate":"2026-09-04 17:56","name":"法国国际广播电台","title":"意大利总理梅洛尼打破任期最长纪录 正式启动2027竞选活动","content":"意大利首位女总理乔尔吉娅·梅洛尼在本周五（9月4日）打破二战以来该国总理执政期最长纪录，这进一步巩固了她在2027年议会选举中启动竞选活动的“公信力”。她表示，我们没有辜负选民的信任，还有很多工作亟待完成。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E6%84%8F%E5%A4%A7%E5%88%A9%E6%80%BB%E7%90%86%E6%A2%85%E6%B4%9B%E5%B0%BC%E6%89%93%E7%A0%B4%E4%BB%BB%E6%9C%9F%E6%9C%80%E9%95%BF%E7%BA%AA%E5%BD%95-%E6%AD%A3%E5%BC%8F%E5%90%AF%E5%8A%A82027%E7%AB%9E%E9%80%89%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788544562000.webp","sourceId":"rfi"},{"id":1788542123000,"createdDate":"2026-09-04 17:15","name":"法国国际广播电台","title":"汽车制造商敦促美国国会永久禁止中国网联汽车进入美国","content":"在美运营的主要汽车制造商正在加大对国会施压，要求永久禁止在美国国内销售、进口和生产中国网联汽车及其软硬件。汽车创新联盟（AllianceforAutomotiveInnovation）敦促国会在1月3日会期结束前通过这项禁令。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E6%B1%BD%E8%BD%A6%E5%88%B6%E9%80%A0%E5%95%86%E6%95%A6%E4%BF%83%E7%BE%8E%E5%9B%BD%E5%9B%BD%E4%BC%9A%E6%B0%B8%E4%B9%85%E7%A6%81%E6%AD%A2%E4%B8%AD%E5%9B%BD%E7%BD%91%E8%81%94%E6%B1%BD%E8%BD%A6%E8%BF%9B%E5%85%A5%E7%BE%8E%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788542123000.webp","sourceId":"rfi"},{"id":1788539833000,"createdDate":"2026-09-04 16:37","name":"法国国际广播电台","title":"中国航运巨头中远集团否认为北京搜集情报的指控","content":"路透社北京消息，中国国有航运巨头中远集团周五（9月4日）否认了有关其在船上使用隐蔽设备为北京政府搜集情报的指控，称这些说法“完全没有根据”且是虚假的。然而，据悉中国法律要求中国企业为政府情报工作提供支持。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E4%B8%AD%E5%9B%BD%E8%88%AA%E8%BF%90%E5%B7%A8%E5%A4%B4%E4%B8%AD%E8%BF%9C%E9%9B%86%E5%9B%A2%E5%90%A6%E8%AE%A4%E4%B8%BA%E5%8C%97%E4%BA%AC%E6%90%9C%E9%9B%86%E6%83%85%E6%8A%A5%E7%9A%84%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788539833000.webp","sourceId":"rfi"},{"id":1788536297000,"createdDate":"2026-09-04 15:38","name":"法国国际广播电台","title":"李在明9月6日开始访法国与马克龙共同担任“卢米埃尔峰会”主席","content":"据韩联社报道，韩国总统李在明将于9月6日开始对法国进行国是访问。法国总统马克龙在4月访韩期间邀请李在明访问法国。李在明将在法国与马克龙总统共同担任“卢米埃尔峰会”主席。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E6%9D%8E%E5%9C%A8%E6%98%8E9%E6%9C%886%E6%97%A5%E5%BC%80%E5%A7%8B%E8%AE%BF%E6%B3%95%E5%9B%BD%E4%B8%8E%E9%A9%AC%E5%85%8B%E9%BE%99%E5%85%B1%E5%90%8C%E6%8B%85%E4%BB%BB-%E5%8D%A2%E7%B1%B3%E5%9F%83%E5%B0%94%E5%B3%B0%E4%BC%9A-%E4%B8%BB%E5%B8%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788536297000.webp","sourceId":"rfi"},{"id":1788534179000,"createdDate":"2026-09-04 15:02","name":"法国国际广播电台","title":"中国将尼泊尔边境樟木口岸过境点迁址","content":"西藏聂拉木政府一份通告显示，中国将于周六上午起，迁移连接西藏与尼泊尔的樟木海关及出入境边防检查作业场地，并对通往新场所的道路实施闭环管制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260904-%E4%B8%AD%E5%9B%BD%E5%B0%86%E5%B0%BC%E6%B3%8A%E5%B0%94%E8%BE%B9%E5%A2%83%E6%A8%9F%E6%9C%A8%E5%8F%A3%E5%B2%B8%E8%BF%87%E5%A2%83%E7%82%B9%E8%BF%81%E5%9D%80","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788534179000.webp","sourceId":"rfi"},{"id":1788532201000,"createdDate":"2026-09-04 14:30","name":"法国国际广播电台","title":"王维洛：几千年的历史就是人与水之间的博弈","content":"8月26日尼泊尔北部热索瓦地区发生的大规模泥石流灾害已经造成近1300人死亡，近5000人失踪，有关此次灾难发生的原因也逐渐明朗，无论是山崩还是冰崩，岩基的松动以及冰川的倒塌都与气候变化以及喜马拉雅地震多发地带的大背景有关。不过网络有舆论怀疑中国与尼泊尔在当地的水电施工或许增加了暂难的强度？此外，中尼泥石流灾难再度引发外界对中国去年夏天刚刚启动的雅鲁藏布江下游巨大水利工程的担忧，尽管中国国内的地质专家都强调当地已经进入多地震阶段，然后，中国当局修建发电功能是三峡水电站三倍的雅江下游水电站的决心似乎难以动摇，北京方面究竟是出于何种考量？法广为此先后采访了旅居德国的水电专家王维洛先生以及法国的水文学家EmmaHaziza女士。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20260904-%E7%8E%8B%E7%BB%B4%E6%B4%9B-%E5%87%A0%E5%8D%83%E5%B9%B4%E7%9A%84%E5%8E%86%E5%8F%B2%E5%B0%B1%E6%98%AF%E4%BA%BA%E4%B8%8E%E6%B0%B4%E4%B9%8B%E9%97%B4%E7%9A%84%E5%8D%9A%E5%BC%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788532201000.webp","sourceId":"rfi"},{"id":1788529893000,"createdDate":"2026-09-04 13:51","name":"法国国际广播电台","title":"尼泊尔洪灾：两名工人“奇迹般”从隧道中获救，已知1318人遇难","content":"喜马拉雅山脉发生灾难性洪水泥石流九天后，“奇迹”降临了：两名尼泊尔工人从尼泊尔北部一处隧道中获救，而当地幸存者对救援物资的需求正变得十分紧迫。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260904-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE-%E4%B8%A4%E5%90%8D%E5%B7%A5%E4%BA%BA-%E5%A5%87%E8%BF%B9%E8%88%AC-%E4%BB%8E%E9%9A%A7%E9%81%93%E4%B8%AD%E8%8E%B7%E6%95%91%EF%BC%8C%E5%B7%B2%E7%9F%A51318%E4%BA%BA%E9%81%87%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788529893000.webp","sourceId":"rfi"},{"id":1788528350000,"createdDate":"2026-09-04 13:25","name":"法国国际广播电台","title":"《费加罗报》：习近平出访埃及彰显中国是制衡美国的力量","content":"法国各路政治力量备战2027大选背景下，围绕政府预算案博弈是4日上市的《费加罗报》和《回声报》从不同角度重点关注的国内话题。天主教报刊《十字架报》则以大版篇幅报道法国为迎接罗马教皇良十四不久后来访的各种安全部署。德国萨克森-安哈尔特州（Sachsen-Anhalt）6日举行地方选举，民调显示极右翼政党选项党（也有人称选择党）可能取得前所未有的胜利，这是4日上市的法国全国性大报在国际版特别关注的话题。《费加罗报》和《回声报》也都刊登文章，梳理意大利极右翼倾向的领导人梅罗妮何以打破意大利政府总理任期最长记录的原因。关于中国，《费加罗报》刊登文章，介绍中国国家主席习近平出访埃及背后的战略考量。周四出刊的最新一期《快报》周刊刊登文章，解析为什么特朗普政府难以让中国在伊朗战争问题上让步。该周刊的另一篇文章则着重分析为何人们对中国的好感度正在提升，而对美国的好感在下降。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260904-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%87%BA%E8%AE%BF%E5%9F%83%E5%8F%8A%E5%BD%B0%E6%98%BE%E4%B8%AD%E5%9B%BD%E6%98%AF%E5%88%B6%E8%A1%A1%E7%BE%8E%E5%9B%BD%E7%9A%84%E5%8A%9B%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788528350000.webp","sourceId":"rfi"},{"id":1788523959000,"createdDate":"2026-09-04 12:12","name":"法国国际广播电台","title":"美财长促G20检视对中贸易条件　19国挺处理“廉价出口”中国成唯一异议者","content":"美国财政部长贝森特（ScottBessent）本周表示，美国将要求20国集团（G20）成员重新检视与中国的贸易条件，并敦促各国采取措施，因应中国庞大贸易顺差及大量低价出口。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260904-%E7%BE%8E%E8%B4%A2%E9%95%BF%E4%BF%83g20%E6%A3%80%E8%A7%86%E5%AF%B9%E4%B8%AD%E8%B4%B8%E6%98%93%E6%9D%A1%E4%BB%B6-19%E5%9B%BD%E6%8C%BA%E5%A4%84%E7%90%86-%E5%BB%89%E4%BB%B7%E5%87%BA%E5%8F%A3-%E4%B8%AD%E5%9B%BD%E6%88%90%E5%94%AF%E4%B8%80%E5%BC%82%E8%AE%AE%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/04/1788523959000.webp","sourceId":"rfi"}]