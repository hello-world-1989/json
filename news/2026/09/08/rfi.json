[{"id":1788869540000,"createdDate":"2026-09-08 12:12","name":"法国国际广播电台","title":"【视频】洪灾过后北京控制信息：西藏灾区处于监控下的搜救工作","content":"8月26日在尼泊尔和西藏发生灾难性的洪灾后，搜救工作仍在继续，但在边境的中国一侧，北京已经封锁了当地的通讯，不过当局允许外国媒体进入，来核实灾情范围。和法广同属法国世界媒体集团的法国电视24台的新闻节目对此进行了报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260908-%E8%A7%86%E9%A2%91-%E6%B4%AA%E7%81%BE%E8%BF%87%E5%90%8E%E5%8C%97%E4%BA%AC%E6%8E%A7%E5%88%B6%E4%BF%A1%E6%81%AF-%E8%A5%BF%E8%97%8F%E7%81%BE%E5%8C%BA%E5%A4%84%E4%BA%8E%E7%9B%91%E6%8E%A7%E4%B8%8B%E7%9A%84%E6%90%9C%E6%95%91%E5%B7%A5%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788869540000.webp","sourceId":"rfi"},{"id":1788866259000,"createdDate":"2026-09-08 11:17","name":"法国国际广播电台","title":"回声报：EDF意外推动比亚迪等中国车企的发展，小米将挑战宝马、奔驰和奥迪的欧洲霸主地位","content":"据《回声报》企业版周一7日晚报道，自诩为法国工业捍卫者的法国电力公司（EDF）正在为购买中国比亚迪汽车的消费者提供补贴，而比亚迪正是法国汽车制造商的主要竞争对手。与此同时，该报另一篇报道称，中国汽车行业的崛起势头正持续蔓延至欧洲，在柏林举行的IFA国际消费电子展上，小米正式宣布将于2027年进军欧洲。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260908-%E5%9B%9E%E5%A3%B0%E6%8A%A5-edf%E6%84%8F%E5%A4%96%E6%8E%A8%E5%8A%A8%E6%AF%94%E4%BA%9A%E8%BF%AA%E7%AD%89%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E7%9A%84%E5%8F%91%E5%B1%95%EF%BC%8C%E5%B0%8F%E7%B1%B3%E5%B0%86%E6%8C%91%E6%88%98%E5%AE%9D%E9%A9%AC-%E5%A5%94%E9%A9%B0%E5%92%8C%E5%A5%A5%E8%BF%AA%E7%9A%84%E6%AC%A7%E6%B4%B2%E9%9C%B8%E4%B8%BB%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788866259000.webp","sourceId":"rfi"},{"id":1788861394000,"createdDate":"2026-09-08 09:56","name":"法国国际广播电台","title":"“特朗普和普京正在开香槟庆祝”：德国选择党的胜利影响欧洲的未来，乌克兰一把利剑悬头！","content":"新纳粹极右势力在前东德的萨安州取得空前的胜利，从而削弱了默茨总理的影响力，这不仅仅是一次简单的地区性冲击，继续成为周二9月8日法国各大日报头版的重中之重。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260908-%E7%89%B9%E6%9C%97%E6%99%AE%E5%92%8C%E6%99%AE%E4%BA%AC%E6%AD%A3%E5%9C%A8%E5%BC%80%E9%A6%99%E6%A7%9F%E5%BA%86%E7%A5%9D-%E5%BE%B7%E5%9B%BD%E9%80%89%E6%8B%A9%E5%85%9A%E7%9A%84%E8%83%9C%E5%88%A9%E5%BD%B1%E5%93%8D%E6%AC%A7%E6%B4%B2%E7%9A%84%E6%9C%AA%E6%9D%A5%EF%BC%8C%E4%B9%8C%E5%85%8B%E5%85%B0%E4%B8%80%E6%8A%8A%E5%88%A9%E5%89%91%E6%82%AC%E5%A4%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788861394000.webp","sourceId":"rfi"},{"id":1788858703000,"createdDate":"2026-09-08 09:11","name":"法国国际广播电台","title":"感到被美国人“背叛”的加拿大 如何无奈地“向东看”","content":"2001年9月11日早晨，北美领空全面紧急关闭，加拿大交通部随即启动著名的“黄丝带行动”（OperationYellowRibbon）。纽芬兰岛Newfoundland上一个常住人口仅约1万人的边陲小镇甘德（Gander），迎来了38架被迫改道、载有约6,500名各国乘客的客机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8C%97%E7%BE%8E%E6%9D%A5%E9%B8%BF/20260908-%E6%84%9F%E5%88%B0%E8%A2%AB%E7%BE%8E%E5%9B%BD%E4%BA%BA-%E8%83%8C%E5%8F%9B-%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E5%A6%82%E4%BD%95%E6%97%A0%E5%A5%88%E5%9C%B0-%E5%90%91%E4%B8%9C%E7%9C%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788858703000.webp","sourceId":"rfi"},{"id":1788858374000,"createdDate":"2026-09-08 09:06","name":"法国国际广播电台","title":"日本强烈抗议中国针对日本半导体材料进行反倾销调查","content":"日本内阁官房长官木原稔8日在记者会上，就中国宣布对日本产半导体材料采取反倾销（不当低价销售）调查一事表示：“我们对此表示强烈抗议，并已要求中方撤回相关措施。”在调查期间，相关日本商家需缴纳高额保证金。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260908-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE%E4%B8%AD%E5%9B%BD%E9%92%88%E5%AF%B9%E6%97%A5%E6%9C%AC%E5%8D%8A%E5%AF%BC%E4%BD%93%E6%9D%90%E6%96%99%E8%BF%9B%E8%A1%8C%E5%8F%8D%E5%80%BE%E9%94%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788858374000.webp","sourceId":"rfi"},{"id":1788856742000,"createdDate":"2026-09-08 08:39","name":"法国国际广播电台","title":"贸易战升级 加拿大对美报复性关税生效","content":"加拿大政府星期二正式对总值276亿加元、约200亿美元的美国进口商品实施报复性关税，税率介于15%到50%，涵盖钢铁、铝材以及奶酪等乳制品。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260908-%E8%B4%B8%E6%98%93%E6%88%98%E5%8D%87%E7%BA%A7-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AF%B9%E7%BE%8E%E6%8A%A5%E5%A4%8D%E6%80%A7%E5%85%B3%E7%A8%8E%E7%94%9F%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788856742000.webp","sourceId":"rfi"},{"id":1788851599000,"createdDate":"2026-09-08 07:13","name":"法国国际广播电台","title":"港府财赤削福利 立法会议员却有望加薪至逾11万 评论指势惹市民不满","content":"香港特首李家超将于下周三公布「双报告」(港府年度《施政报告》和香港首份五年规划报告)，亲港府媒体引述消息称，89位在「爱国者治港」制度下产生的立法会议员，有望于新立法会会期加薪，料月薪将突破11万港元（折算约1.21万欧元）。消息一出，即引发非议，评论指，新制下的议员未能发挥代议士功能，表现和公众辨识度过低，加上港府身陷财赤，若议员此时齐获加薪，势必引发公众不满。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260908-%E6%B8%AF%E5%BA%9C%E8%B4%A2%E8%B5%A4%E5%89%8A%E7%A6%8F%E5%88%A9-%E7%AB%8B%E6%B3%95%E4%BC%9A%E8%AE%AE%E5%91%98%E5%8D%B4%E6%9C%89%E6%9C%9B%E5%8A%A0%E8%96%AA%E8%87%B3%E9%80%BE11%E4%B8%87-shehui%E8%AF%84%E8%AE%BA-%E5%8A%BF%E6%83%B9%E5%B8%82%E6%B0%91%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788851599000.webp","sourceId":"rfi"},{"id":1788851293000,"createdDate":"2026-09-08 07:08","name":"法国国际广播电台","title":"退休妇住所贴旗帜遭控展示煽动刊物 庭上称「我无犯罪」遭还柙候精神评估","content":"一名退休妇人被指在住所内外张贴及展示具煽动意图的旗帜及物品，事隔近两年後疑被追究，被控以违反新煽动罪。她在庭上多次强调自己没有犯罪，但负责审理案件的国安法指定法官苏惠德认为，无法肯定被告是否适合答辩，下令索取两份精神科报告，被告期间须还押小榄精神病治疗中心。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260908-%E9%80%80%E4%BC%91%E5%A6%87%E4%BD%8F%E6%89%80%E8%B4%B4%E6%97%97%E5%B8%9C%E9%81%AD%E6%8E%A7%E5%B1%95%E7%A4%BA%E7%85%BD%E5%8A%A8%E5%88%8A%E7%89%A9-%E5%BA%AD%E4%B8%8A%E7%A7%B0-%E6%88%91%E6%97%A0%E7%8A%AF%E7%BD%AA-%E9%81%AD%E8%BF%98%E6%9F%99%E5%80%99%E7%B2%BE%E7%A5%9E%E8%AF%84%E4%BC%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788851293000.webp","sourceId":"rfi"}]