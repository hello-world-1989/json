[{"id":1788869540000,"createdDate":"2026-09-08 12:12","name":"法国国际广播电台","title":"【视频】洪灾过后北京控制信息：西藏灾区处于监控下的搜救工作","content":"8月26日在尼泊尔和西藏发生灾难性的洪灾后，搜救工作仍在继续，但在边境的中国一侧，北京已经封锁了当地的通讯，不过当局允许外国媒体进入，来核实灾情范围。和法广同属法国世界媒体集团的法国电视24台的新闻节目对此进行了报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260908-%E8%A7%86%E9%A2%91-%E6%B4%AA%E7%81%BE%E8%BF%87%E5%90%8E%E5%8C%97%E4%BA%AC%E6%8E%A7%E5%88%B6%E4%BF%A1%E6%81%AF-%E8%A5%BF%E8%97%8F%E7%81%BE%E5%8C%BA%E5%A4%84%E4%BA%8E%E7%9B%91%E6%8E%A7%E4%B8%8B%E7%9A%84%E6%90%9C%E6%95%91%E5%B7%A5%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788869540000.webp","sourceId":"rfi"},{"id":1788866259000,"createdDate":"2026-09-08 11:17","name":"法国国际广播电台","title":"回声报：EDF意外推动比亚迪等中国车企的发展，小米将挑战宝马、奔驰和奥迪的欧洲霸主地位","content":"据《回声报》企业版周一7日晚报道，自诩为法国工业捍卫者的法国电力公司（EDF）正在为购买中国比亚迪汽车的消费者提供补贴，而比亚迪正是法国汽车制造商的主要竞争对手。与此同时，该报另一篇报道称，中国汽车行业的崛起势头正持续蔓延至欧洲，在柏林举行的IFA国际消费电子展上，小米正式宣布将于2027年进军欧洲。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260908-%E5%9B%9E%E5%A3%B0%E6%8A%A5-edf%E6%84%8F%E5%A4%96%E6%8E%A8%E5%8A%A8%E6%AF%94%E4%BA%9A%E8%BF%AA%E7%AD%89%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E7%9A%84%E5%8F%91%E5%B1%95%EF%BC%8C%E5%B0%8F%E7%B1%B3%E5%B0%86%E6%8C%91%E6%88%98%E5%AE%9D%E9%A9%AC-%E5%A5%94%E9%A9%B0%E5%92%8C%E5%A5%A5%E8%BF%AA%E7%9A%84%E6%AC%A7%E6%B4%B2%E9%9C%B8%E4%B8%BB%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788866259000.webp","sourceId":"rfi"},{"id":1788861394000,"createdDate":"2026-09-08 09:56","name":"法国国际广播电台","title":"“特朗普和普京正在开香槟庆祝”：德国选择党的胜利影响欧洲的未来，乌克兰一把利剑悬头！","content":"新纳粹极右势力在前东德的萨安州取得空前的胜利，从而削弱了默茨总理的影响力，这不仅仅是一次简单的地区性冲击，继续成为周二9月8日法国各大日报头版的重中之重。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260908-%E7%89%B9%E6%9C%97%E6%99%AE%E5%92%8C%E6%99%AE%E4%BA%AC%E6%AD%A3%E5%9C%A8%E5%BC%80%E9%A6%99%E6%A7%9F%E5%BA%86%E7%A5%9D-%E5%BE%B7%E5%9B%BD%E9%80%89%E6%8B%A9%E5%85%9A%E7%9A%84%E8%83%9C%E5%88%A9%E5%BD%B1%E5%93%8D%E6%AC%A7%E6%B4%B2%E7%9A%84%E6%9C%AA%E6%9D%A5%EF%BC%8C%E4%B9%8C%E5%85%8B%E5%85%B0%E4%B8%80%E6%8A%8A%E5%88%A9%E5%89%91%E6%82%AC%E5%A4%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788861394000.webp","sourceId":"rfi"},{"id":1788858703000,"createdDate":"2026-09-08 09:11","name":"法国国际广播电台","title":"感到被美国人“背叛”的加拿大 如何无奈地“向东看”","content":"2001年9月11日早晨，北美领空全面紧急关闭，加拿大交通部随即启动著名的“黄丝带行动”（OperationYellowRibbon）。纽芬兰岛Newfoundland上一个常住人口仅约1万人的边陲小镇甘德（Gander），迎来了38架被迫改道、载有约6,500名各国乘客的客机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8C%97%E7%BE%8E%E6%9D%A5%E9%B8%BF/20260908-%E6%84%9F%E5%88%B0%E8%A2%AB%E7%BE%8E%E5%9B%BD%E4%BA%BA-%E8%83%8C%E5%8F%9B-%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E5%A6%82%E4%BD%95%E6%97%A0%E5%A5%88%E5%9C%B0-%E5%90%91%E4%B8%9C%E7%9C%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788858703000.webp","sourceId":"rfi"},{"id":1788858374000,"createdDate":"2026-09-08 09:06","name":"法国国际广播电台","title":"日本强烈抗议中国针对日本半导体材料进行反倾销调查","content":"日本内阁官房长官木原稔8日在记者会上，就中国宣布对日本产半导体材料采取反倾销（不当低价销售）调查一事表示：“我们对此表示强烈抗议，并已要求中方撤回相关措施。”在调查期间，相关日本商家需缴纳高额保证金。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260908-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE%E4%B8%AD%E5%9B%BD%E9%92%88%E5%AF%B9%E6%97%A5%E6%9C%AC%E5%8D%8A%E5%AF%BC%E4%BD%93%E6%9D%90%E6%96%99%E8%BF%9B%E8%A1%8C%E5%8F%8D%E5%80%BE%E9%94%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788858374000.webp","sourceId":"rfi"},{"id":1788856742000,"createdDate":"2026-09-08 08:39","name":"法国国际广播电台","title":"贸易战升级 加拿大对美报复性关税生效","content":"加拿大政府星期二正式对总值276亿加元、约200亿美元的美国进口商品实施报复性关税，税率介于15%到50%，涵盖钢铁、铝材以及奶酪等乳制品。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260908-%E8%B4%B8%E6%98%93%E6%88%98%E5%8D%87%E7%BA%A7-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AF%B9%E7%BE%8E%E6%8A%A5%E5%A4%8D%E6%80%A7%E5%85%B3%E7%A8%8E%E7%94%9F%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788856742000.webp","sourceId":"rfi"},{"id":1788851599000,"createdDate":"2026-09-08 07:13","name":"法国国际广播电台","title":"港府财赤削福利 立法会议员却有望加薪至逾11万 评论指势惹市民不满","content":"香港特首李家超将于下周三公布「双报告」(港府年度《施政报告》和香港首份五年规划报告)，亲港府媒体引述消息称，89位在「爱国者治港」制度下产生的立法会议员，有望于新立法会会期加薪，料月薪将突破11万港元（折算约1.21万欧元）。消息一出，即引发非议，评论指，新制下的议员未能发挥代议士功能，表现和公众辨识度过低，加上港府身陷财赤，若议员此时齐获加薪，势必引发公众不满。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260908-%E6%B8%AF%E5%BA%9C%E8%B4%A2%E8%B5%A4%E5%89%8A%E7%A6%8F%E5%88%A9-%E7%AB%8B%E6%B3%95%E4%BC%9A%E8%AE%AE%E5%91%98%E5%8D%B4%E6%9C%89%E6%9C%9B%E5%8A%A0%E8%96%AA%E8%87%B3%E9%80%BE11%E4%B8%87-shehui%E8%AF%84%E8%AE%BA-%E5%8A%BF%E6%83%B9%E5%B8%82%E6%B0%91%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788851599000.webp","sourceId":"rfi"},{"id":1788851293000,"createdDate":"2026-09-08 07:08","name":"法国国际广播电台","title":"退休妇住所贴旗帜遭控展示煽动刊物 庭上称「我无犯罪」遭还柙候精神评估","content":"一名退休妇人被指在住所内外张贴及展示具煽动意图的旗帜及物品，事隔近两年後疑被追究，被控以违反新煽动罪。她在庭上多次强调自己没有犯罪，但负责审理案件的国安法指定法官苏惠德认为，无法肯定被告是否适合答辩，下令索取两份精神科报告，被告期间须还押小榄精神病治疗中心。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260908-%E9%80%80%E4%BC%91%E5%A6%87%E4%BD%8F%E6%89%80%E8%B4%B4%E6%97%97%E5%B8%9C%E9%81%AD%E6%8E%A7%E5%B1%95%E7%A4%BA%E7%85%BD%E5%8A%A8%E5%88%8A%E7%89%A9-%E5%BA%AD%E4%B8%8A%E7%A7%B0-%E6%88%91%E6%97%A0%E7%8A%AF%E7%BD%AA-%E9%81%AD%E8%BF%98%E6%9F%99%E5%80%99%E7%B2%BE%E7%A5%9E%E8%AF%84%E4%BC%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788851293000.webp","sourceId":"rfi"},{"id":1788894599000,"createdDate":"2026-09-08 19:09","name":"法国国际广播电台","title":"特习会可能影响美国大豆销售和中国无人机关税","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平预计于9月24日在美国举行会晤，美中农业贸易将面临新一轮检验。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%8F%AF%E8%83%BD%E5%BD%B1%E5%93%8D%E7%BE%8E%E5%9B%BD%E5%A4%A7%E8%B1%86%E9%94%80%E5%94%AE%E5%92%8C%E4%B8%AD%E5%9B%BD%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788894599000.webp","sourceId":"rfi"},{"id":1788891559000,"createdDate":"2026-09-08 18:19","name":"法国国际广播电台","title":"81届联大开幕 呼吁绕过俄罗斯否决权迫使其停止对乌侵略的声音再起","content":"第81届联合国大会9月8日至22日举行，法国世界报说，国际社会必须停止将安理会的瘫痪视为不可避免的命运。目前仍存在能够将声明转化为行动的手段。国际民间社会必须参与这一转型进程。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-81%E5%B1%8A%E8%81%94%E5%A4%A7%E5%BC%80%E5%B9%95-%E5%91%BC%E5%90%81%E7%BB%95%E8%BF%87%E4%BF%84%E7%BD%97%E6%96%AF%E5%90%A6%E5%86%B3%E6%9D%83%E8%BF%AB%E4%BD%BF%E5%85%B6%E5%81%9C%E6%AD%A2%E5%AF%B9%E4%B9%8C%E4%BE%B5%E7%95%A5%E7%9A%84%E5%A3%B0%E9%9F%B3%E5%86%8D%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788891559000.webp","sourceId":"rfi"},{"id":1788890142000,"createdDate":"2026-09-08 17:55","name":"法国国际广播电台","title":"菲律宾防长在首尔当众回应中方送给他的便条：请知道一点廉耻！这是“胁迫、欺凌和侵犯”","content":"菲律宾国防部长吉尔伯托·C·特奥多罗二世（GilbertoC.TeodoroJr.）在韩国首尔举行的2026年首尔防务对话（SDD）期间，对中方送给他的一份便条当众作出了回应。谴责此举是“胁迫、欺凌和侵犯”。他用菲律宾语说，“MAHIYANAMANKAYO”（请知道一点廉耻）","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E9%98%B2%E9%95%BF%E5%9C%A8%E9%A6%96%E5%B0%94%E5%BD%93%E4%BC%97%E5%9B%9E%E5%BA%94%E4%B8%AD%E6%96%B9%E9%80%81%E7%BB%99%E4%BB%96%E7%9A%84%E4%BE%BF%E6%9D%A1-%E8%AF%B7%E7%9F%A5%E9%81%93%E4%B8%80%E7%82%B9%E5%BB%89%E8%80%BB-%E8%BF%99%E6%98%AF-%E8%83%81%E8%BF%AB-%E6%AC%BA%E5%87%8C%E5%92%8C%E4%BE%B5%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788890142000.webp","sourceId":"rfi"},{"id":1788889359000,"createdDate":"2026-09-08 17:42","name":"法国国际广播电台","title":"【视频】哥伦比亚：地震一个月后 仍有家庭无家可归","content":"哥伦比亚地震发生一个月后，房屋依然倒塌，瓦砾尚未清理，众多家庭仍流离失所。本台记者MaríaGladysZapata对此进行了报道。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260908-%E8%A7%86%E9%A2%91-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A-%E5%9C%B0%E9%9C%87%E4%B8%80%E4%B8%AA%E6%9C%88%E5%90%8E-%E4%BB%8D%E6%9C%89%E5%AE%B6%E5%BA%AD%E6%97%A0%E5%AE%B6%E5%8F%AF%E5%BD%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788889359000.webp","sourceId":"rfi"},{"id":1788887498000,"createdDate":"2026-09-08 17:11","name":"法国国际广播电台","title":"埃菲尔铁塔周二重开 印度教团歧视女员工引爆法国舆论 巴黎市启动调查","content":"巴黎埃菲尔铁塔周二早晨重新开放，此前一天，员工们举行抗议活动，他们对一名女性工作人员在为一个印度教团体提供导览时，被赶下塔一事感到愤慨罢工一天；该印度教团体虽已致歉，但仍对事件的严重性轻描淡写。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E5%9F%83%E8%8F%B2%E5%B0%94%E9%93%81%E5%A1%94%E5%91%A8%E4%BA%8C%E9%87%8D%E5%BC%80-%E5%8D%B0%E5%BA%A6%E6%95%99%E5%9B%A2%E6%AD%A7%E8%A7%86%E5%A5%B3%E5%91%98%E5%B7%A5%E5%BC%95%E7%88%86%E6%B3%95%E5%9B%BD%E8%88%86%E8%AE%BA-%E5%B7%B4%E9%BB%8E%E5%B8%82%E5%90%AF%E5%8A%A8%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788887498000.webp","sourceId":"rfi"},{"id":1788883524000,"createdDate":"2026-09-08 16:05","name":"法国国际广播电台","title":"尼泊尔重点营救三条隧道中的工人 那里曾有食堂宿舍食品","content":"尼泊尔正在集中精力搜救三个水电项目隧道，认为可能有数十名工人被困在那里。据尼泊尔军方救援人员称，900名失踪的工人中约有121人可能被困在水电站隧道内。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E5%B0%BC%E6%B3%8A%E5%B0%94%E9%87%8D%E7%82%B9%E8%90%A5%E6%95%91%E4%B8%89%E6%9D%A1%E9%9A%A7%E9%81%93%E4%B8%AD%E7%9A%84%E5%B7%A5%E4%BA%BA-%E9%82%A3%E9%87%8C%E6%9B%BE%E6%9C%89%E9%A3%9F%E5%A0%82%E5%AE%BF%E8%88%8D%E9%A3%9F%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788883524000.webp","sourceId":"rfi"},{"id":1788882788000,"createdDate":"2026-09-08 15:53","name":"法国国际广播电台","title":"柯文哲京华城案二审开庭 检辩大阵势攻防 要求法庭直播诉诸全民","content":"民众党前主席柯文哲涉及京华城、政治献金等弊案，在3月时一审遭重判17年并褫夺公权6年。台湾高等法院8日二审开庭，柯文哲仍否认犯罪，并指司法系统对他追杀不停。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260908-%E6%9F%AF%E6%96%87%E5%93%B2%E4%BA%AC%E5%8D%8E%E5%9F%8E%E6%A1%88%E4%BA%8C%E5%AE%A1%E5%BC%80%E5%BA%AD-%E6%A3%80%E8%BE%A9%E5%A4%A7%E9%98%B5%E5%8A%BF%E6%94%BB%E9%98%B2-%E8%A6%81%E6%B1%82%E6%B3%95%E5%BA%AD%E7%9B%B4%E6%92%AD%E8%AF%89%E8%AF%B8%E5%85%A8%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788882788000.webp","sourceId":"rfi"},{"id":1788882602000,"createdDate":"2026-09-08 15:50","name":"法国国际广播电台","title":"德国消费者对中国汽车的兴趣日益增长——大众汽车将面临什么？","content":"中国汽车制造商的竞争力在德国究竟有多大？对德国大众来说，他们有多weix4？北德广播电台派记者到德国下萨克森州宁堡县的利贝瑙（Liebenau）一家汽车经销商处进行探访，发现一名客户对中国车很满意。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E5%BE%B7%E5%9B%BD%E6%B6%88%E8%B4%B9%E8%80%85%E5%AF%B9%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E7%9A%84%E5%85%B4%E8%B6%A3%E6%97%A5%E7%9B%8A%E5%A2%9E%E9%95%BF-%E5%A4%A7%E4%BC%97%E6%B1%BD%E8%BD%A6%E5%B0%86%E9%9D%A2%E4%B8%B4%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788882602000.webp","sourceId":"rfi"},{"id":1788881362000,"createdDate":"2026-09-08 15:29","name":"法国国际广播电台","title":"朝鲜与俄罗斯首条公路跨境链接桥梁正式开通","content":"朝鲜和俄罗斯周二对两国首条公路连接线开通表示欢迎。这座新桥彰显了两国关系日益密切，并可能让平壤从其与莫斯科的关系中获益。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E6%9C%9D%E9%B2%9C%E4%B8%8E%E4%BF%84%E7%BD%97%E6%96%AF%E9%A6%96%E6%9D%A1%E5%85%AC%E8%B7%AF%E8%B7%A8%E5%A2%83%E9%93%BE%E6%8E%A5%E6%A1%A5%E6%A2%81%E6%AD%A3%E5%BC%8F%E5%BC%80%E9%80%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788881362000.webp","sourceId":"rfi"},{"id":1788879577000,"createdDate":"2026-09-08 14:59","name":"法国国际广播电台","title":"匈牙利驱逐俄罗斯外交使团10名成员 莫斯科威胁严厉报复","content":"匈牙利新一届亲欧政府周二宣布驱逐10名俄罗斯外交使团成员，理由是他们从事了“不可接受的活动”。对于这个此前在民族主义者欧尔班（ViktorOrbán）领导下一直奉行亲俄立场的国家而言，这是自2018年以来的首次此类行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E5%8C%88%E7%89%99%E5%88%A9%E9%A9%B1%E9%80%90%E4%BF%84%E7%BD%97%E6%96%AF%E5%A4%96%E4%BA%A4%E4%BD%BF%E5%9B%A210%E5%90%8D%E6%88%90%E5%91%98-%E8%8E%AB%E6%96%AF%E7%A7%91%E5%A8%81%E8%83%81%E4%B8%A5%E5%8E%89%E6%8A%A5%E5%A4%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788879577000.webp","sourceId":"rfi"},{"id":1788877898000,"createdDate":"2026-09-08 14:31","name":"法国国际广播电台","title":"美特使离开后 俄罗斯恢复空袭基辅 乌克兰急需拦截系统 英国出手德国跟随","content":"俄罗斯在美国特使离开当晚对基辅发动了新一轮空袭，造成至少两人死亡、八人受伤。乌克兰总统再呼吁盟友提供更多的拦截导弹。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260908-%E7%BE%8E%E7%89%B9%E4%BD%BF%E7%A6%BB%E5%BC%80%E5%90%8E-%E4%BF%84%E7%BD%97%E6%96%AF%E6%81%A2%E5%A4%8D%E7%A9%BA%E8%A2%AD%E5%9F%BA%E8%BE%85-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%80%A5%E9%9C%80%E6%8B%A6%E6%88%AA%E7%B3%BB%E7%BB%9F-%E8%8B%B1%E5%9B%BD%E5%87%BA%E6%89%8B%E5%BE%B7%E5%9B%BD%E8%B7%9F%E9%9A%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788877898000.webp","sourceId":"rfi"},{"id":1788876850000,"createdDate":"2026-09-08 14:14","name":"法国国际广播电台","title":"冰岛召见了美国大使 此前特朗普发帖将冰岛等多国划入美国版图","content":"在美国总统特朗普发帖将冰岛等多国划入美国版图后，冰岛外交部长索尔格杜尔·贡纳尔斯多蒂尔已经在周一召见了美国驻冰岛大使比利·朗，明确表示“这篇帖文完全不合适”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260908-%E5%86%B0%E5%B2%9B%E5%8F%AC%E8%A7%81%E4%BA%86%E7%BE%8E%E5%9B%BD%E5%A4%A7%E4%BD%BF-%E6%AD%A4%E5%89%8D%E7%89%B9%E6%9C%97%E6%99%AE%E5%8F%91%E5%B8%96%E5%B0%86%E5%86%B0%E5%B2%9B%E7%AD%89%E5%A4%9A%E5%9B%BD%E5%88%92%E5%85%A5%E7%BE%8E%E5%9B%BD%E7%89%88%E5%9B%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788876850000.webp","sourceId":"rfi"},{"id":1788873593000,"createdDate":"2026-09-08 13:19","name":"法国国际广播电台","title":"武汉市文旅局发布对郭德纲改红歌处罚通报 一个开不起玩笑的时代？","content":"武汉市文旅局周二发布对著名相声演员郭德纲的处理通报，指控他在武汉举办的《济公活佛》商演中拿红歌开玩笑，篡改了《弹起我心爱的土琵琶》当中的歌词。一般认为那句“紫禁城中静悄悄”是惹祸的根苗：似乎标志着一个开不起玩笑的时代要来了。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260908-%E6%AD%A6%E6%B1%89%E5%B8%82%E6%96%87%E6%97%85%E5%B1%80%E5%8F%91%E5%B8%83%E5%AF%B9%E9%83%AD%E5%BE%B7%E7%BA%B2%E6%94%B9%E7%BA%A2%E6%AD%8C%E5%A4%84%E7%BD%9A%E9%80%9A%E6%8A%A5-%E4%B8%80%E4%B8%AA%E5%BC%80%E4%B8%8D%E8%B5%B7%E7%8E%A9%E7%AC%91%E7%9A%84%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788873593000.webp","sourceId":"rfi"},{"id":1788869147000,"createdDate":"2026-09-08 12:05","name":"法国国际广播电台","title":"俄军恢复空袭基辅　和平谈判前景再添变数","content":"就在美国总统特朗普派遣的特使结束访问后，俄罗斯星期二凌晨恢复对乌克兰首都基辅发动大规模空袭，造成至少两人死亡、八人受伤，也让刚出现转机迹象的和平谈判再度蒙上阴影。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260908-%E4%BF%84%E5%86%9B%E6%81%A2%E5%A4%8D%E7%A9%BA%E8%A2%AD%E5%9F%BA%E8%BE%85-%E5%92%8C%E5%B9%B3%E8%B0%88%E5%88%A4%E5%89%8D%E6%99%AF%E5%86%8D%E6%B7%BB%E5%8F%98%E6%95%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/08/1788869147000.webp","sourceId":"rfi"}]