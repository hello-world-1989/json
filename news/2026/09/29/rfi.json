[{"id":1790691116000,"createdDate":"2026-09-29 14:11","name":"法国国际广播电台","title":"俄军扩编、朝鲜或向俄增兵，韩乌因朝鲜战俘起争端","content":"9月28日，俄罗斯总统普京签署政令，确定俄罗斯武装力量编制人数为244万1630人，其中155万500人为军人。总统令当天生效。俄罗斯武装力量编制人数的调整是在今年7月底。对照两次数据，本次调整意味着俄罗斯武装力量总编制增加人数1万5千5百人，全部体现在军人编制的增加上。同时，朝鲜似也再向俄罗斯派出更多军人。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260929-%E4%BF%84%E5%86%9B%E6%89%A9%E7%BC%96-%E6%9C%9D%E9%B2%9C%E6%88%96%E5%90%91%E4%BF%84%E5%A2%9E%E5%85%B5%EF%BC%8C%E9%9F%A9%E4%B9%8C%E5%9B%A0%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BF%98%E8%B5%B7%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790691116000.webp","sourceId":"rfi"},{"id":1790690921000,"createdDate":"2026-09-29 14:08","name":"法国国际广播电台","title":"扩大军事足迹 中老两军班根机场联合保障和训练中心挂牌运行","content":"据中国国防部网站消息，9月29日，中老两军班根机场联合保障和训练中心、中老友谊航空学院正式挂牌运行。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260929-%E6%89%A9%E5%A4%A7%E5%86%9B%E4%BA%8B%E8%B6%B3%E8%BF%B9-%E4%B8%AD%E8%80%81%E4%B8%A4%E5%86%9B%E7%8F%AD%E6%A0%B9%E6%9C%BA%E5%9C%BA%E8%81%94%E5%90%88%E4%BF%9D%E9%9A%9C%E5%92%8C%E8%AE%AD%E7%BB%83%E4%B8%AD%E5%BF%83%E6%8C%82%E7%89%8C%E8%BF%90%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790690921000.webp","sourceId":"rfi"},{"id":1790690736000,"createdDate":"2026-09-29 14:05","name":"法国国际广播电台","title":"视频 : 特朗普称美伊通过调解人交换了信息","content":"据美国哥伦比亚广播公司（CBS）报道，美国总统特朗普周一表示，美国和伊朗通过调解人交换了信息 ,与此同时伊朗代表团正准备结束其纽约之行 ，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260929-%E8%A7%86%E9%A2%91-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E7%BE%8E%E4%BC%8A%E9%80%9A%E8%BF%87%E8%B0%83%E8%A7%A3%E4%BA%BA%E4%BA%A4%E6%8D%A2%E4%BA%86%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790690736000.webp","sourceId":"rfi"},{"id":1790688314000,"createdDate":"2026-09-29 13:25","name":"法国国际广播电台","title":"两名在韩国涉嫌利敌罪的中国前军人被逮捕起诉","content":"据韩联社报导，两名解放军前成员因从事“利敌”活动被起诉，这些活动包括在韩国和驻韩美军军事基地附近活动期间窃听无线电通讯，以及窃取有关韩美联合军事演习的机密信息。据韩国法律界周二消息，涉嫌窃听韩军和驻韩美军通信内容并泄露韩美联合演习相关机密的两名中国人日前被逮捕起诉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260929-%E4%B8%A4%E5%90%8D%E5%9C%A8%E9%9F%A9%E5%9B%BD%E6%B6%89%E5%AB%8C%E5%88%A9%E6%95%8C%E7%BD%AA%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%89%8D%E5%86%9B%E4%BA%BA%E8%A2%AB%E9%80%AE%E6%8D%95%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790688314000.webp","sourceId":"rfi"},{"id":1790687913000,"createdDate":"2026-09-29 13:18","name":"法国国际广播电台","title":"造成印尼火灾的两大因素","content":"印尼加里曼丹岛（印尼语：Kalimantan）9月29日开始降雨，对当地延续了数个月的森林火灾带来了缓解，  几个月来,印尼当局难以应对发生在婆罗洲、苏门答腊和巴布亚的森林和泥炭地火灾。法新社引述印尼官方提供的数据指出，截至8月底,已有近90万 公顷土地被烧毁。当局表示,自上个月以来,学校不得不关闭,并记录了数千例呼吸道疾病病例。火灾所导致的有毒烟雾已经蔓延至印尼的邻国马来西亚、新加坡、菲律宾甚至越南，马来西亚以及日本等国纷纷派出飞机以及救灾人员前往印尼援助。那么，造成此一特大火灾的原因是什么？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20260929-%E9%80%A0%E6%88%90%E5%8D%B0%E5%B0%BC%E7%81%AB%E7%81%BE%E7%9A%84%E4%B8%A4%E5%A4%A7%E5%9B%A0%E7%B4%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790687913000.webp","sourceId":"rfi"},{"id":1790683923000,"createdDate":"2026-09-29 12:12","name":"法国国际广播电台","title":"解放报：解码中国半个世纪的“熊猫外交”传奇","content":"大家好，欢迎收听法国报纸摘要。如何看待受到法国人热烈欢迎的教宗良十四世的政治艺术成为周二9月29日法国《费加罗报》与《十字架报》头版的主要话题，与此同时，法国公务员大罢工也是各大报关注焦点，预计全国将有超过170场示威活动。据《费加罗报》指出：“ 在2027年预算案公布前夕，公务员们确实在要求改善薪酬条件，并拒绝政府设想的预算削减方案，尤其是冻结工资指数。学校、交通、医院……在许多行业，愤怒的情绪正在酝酿 。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260929-%E8%A7%A3%E6%94%BE%E6%8A%A5-%E8%A7%A3%E7%A0%81%E4%B8%AD%E5%9B%BD%E5%8D%8A%E4%B8%AA%E4%B8%96%E7%BA%AA%E7%9A%84-%E7%86%8A%E7%8C%AB%E5%A4%96%E4%BA%A4-%E4%BC%A0%E5%A5%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790683923000.webp","sourceId":"rfi"},{"id":1790683735000,"createdDate":"2026-09-29 12:08","name":"法国国际广播电台","title":"因过于容易偏离指令，OpenAI放弃推出最新模型GPT-6.1 Astra","content":"失控、烧钱、降价：AI产业的问题可能才初露端倪。周二（9月29日），法新社消息称，OpenAI决定取消新一代人工智能模型的发布计划，原因是该模型过于容易偏离指令。这一决定再次反映出，随着人工智能能力不断增强，对先进AI系统的控制正变得越来越困难。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%A7%91%E6%8A%80%E6%97%B6%E7%A9%BA/20260929-%E5%9B%A0%E8%BF%87%E4%BA%8E%E5%AE%B9%E6%98%93%E5%81%8F%E7%A6%BB%E6%8C%87%E4%BB%A4%EF%BC%8Copenai%E6%94%BE%E5%BC%83%E6%8E%A8%E5%87%BA%E6%9C%80%E6%96%B0%E6%A8%A1%E5%9E%8Bgpt-6-1-astra","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790683735000.webp","sourceId":"rfi"},{"id":1790683320000,"createdDate":"2026-09-29 12:02","name":"法国国际广播电台","title":"欧委会促中方接受特定产品进口配额以期贸易再平衡 德法据报有大动作","content":"随着谈判进入冲刺阶段，布鲁塞尔方面正敦促北京接受针对中国出口产品的配额限制，并威胁称若下个月前未能取得实质性进展，将采取贸易措施。据欧洲新闻台获悉，布鲁塞尔与北京正围绕旨在限制中国产品进入欧盟市场的配额问题展开纷争，欧方正寻求重新平衡其与中国的贸易关系。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260929-%E6%AC%A7%E5%A7%94%E4%BC%9A%E4%BF%83%E4%B8%AD%E6%96%B9%E6%8E%A5%E5%8F%97%E7%89%B9%E5%AE%9A%E4%BA%A7%E5%93%81%E8%BF%9B%E5%8F%A3%E9%85%8D%E9%A2%9D%E4%BB%A5%E6%9C%9F%E8%B4%B8%E6%98%93%E5%86%8D%E5%B9%B3%E8%A1%A1-%E5%BE%B7%E6%B3%95%E6%8D%AE%E6%8A%A5%E6%9C%89%E5%A4%A7%E5%8A%A8%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790683320000.webp","sourceId":"rfi"},{"id":1790678742000,"createdDate":"2026-09-29 10:45","name":"法国国际广播电台","title":"默茨跌入深渊","content":"德国9月三州州议会选举（9月6日萨安州，9月20日梅前州和柏林）后，被视为极端右翼的选择党在萨安州和梅前州成为最大党，在首都柏林，得分也大大增加，由第五位跃升到第三位。联邦执政大党基民盟在三州均大大受挫，在梅前州得分甚至破历史纪录地跌破5%的门槛，失去了进入州议会的资格。基民盟党主席和总理默茨虽然承认对选举失利负有责任，但如何负担责任，如何让基民盟获得更多的民众支持，他并没有说明。他表示将坚持其改革路线，但他的改革方案已受到争议。选择党地位上升，多份媒体认为这是选民要求改变政治路线的信号。但默茨到现在并没有显示改变政策的迹象，而是在走老路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20260929-%E9%BB%98%E8%8C%A8%E8%B7%8C%E5%85%A5%E6%B7%B1%E6%B8%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790678742000.webp","sourceId":"rfi"},{"id":1790676205000,"createdDate":"2026-09-29 10:03","name":"法国国际广播电台","title":"荷兰凯谛思将剥离其建筑及在华业务 拟裁约1000个全职岗位","content":"荷兰工程与咨询公司凯谛思（Arcadis）周二表示，作为其2027-2029年战略规划的一部分，公司计划剥离大部分建筑业务及在华业务。该战略旨在加速增长、提升盈利能力并优化业务组合；此前，凯谛思曾于9月初拒绝了加拿大竞争对手科进集团（WSPGlobal）的收购提议，如今正致力于彰显其作为独立企业的价值。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260929-%E8%8D%B7%E5%85%B0%E5%87%AF%E8%B0%9B%E6%80%9D%E5%B0%86%E5%89%A5%E7%A6%BB%E5%85%B6%E5%BB%BA%E7%AD%91%E5%8F%8A%E5%9C%A8%E5%8D%8E%E4%B8%9A%E5%8A%A1-%E6%8B%9F%E8%A3%81%E7%BA%A61000%E4%B8%AA%E5%85%A8%E8%81%8C%E5%B2%97%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790676205000.webp","sourceId":"rfi"},{"id":1790675780000,"createdDate":"2026-09-29 09:56","name":"法国国际广播电台","title":"视频 : 教宗良十四世反驳特朗普 人工智能安全隐患并非“假新闻”","content":"教宗良十四世在返回梵蒂冈飞机上反驳特朗普，教宗认为关于人工智能可能失控的担忧并非“假新闻”，他强调人工智能专家提出的安全问题必须得到重视并采取相应行动，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260929-%E8%A7%86%E9%A2%91-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%8F%8D%E9%A9%B3%E7%89%B9%E6%9C%97%E6%99%AE-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%AE%89%E5%85%A8%E9%9A%90%E6%82%A3%E5%B9%B6%E9%9D%9E-%E5%81%87%E6%96%B0%E9%97%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790675780000.webp","sourceId":"rfi"},{"id":1790674623000,"createdDate":"2026-09-29 09:37","name":"法国国际广播电台","title":"5部委表态 德国政府拟阻止将物流公司Zippel出售给中远海运","content":"据德国《商报》周二报导，德国政府打算以存在安全风险为由，阻止该国物流企业Zippel出售给中国国企业中国远洋海运集团（Cosco、以下简称中远海运）。该报援引了一份其获取的政府内部机密备忘录。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260929-5%E9%83%A8%E5%A7%94%E8%A1%A8%E6%80%81-%E5%BE%B7%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%8B%9F%E9%98%BB%E6%AD%A2%E5%B0%86%E7%89%A9%E6%B5%81%E5%85%AC%E5%8F%B8zippel%E5%87%BA%E5%94%AE%E7%BB%99%E4%B8%AD%E8%BF%9C%E6%B5%B7%E8%BF%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790674623000.webp","sourceId":"rfi"},{"id":1790672730000,"createdDate":"2026-09-29 09:05","name":"法国国际广播电台","title":"日本官房长官回应王毅会见日本前外相 提出日中“再次实现正常化”条件","content":"针对中国外长王毅与日本前外相、日本国际贸易促进协会会长岩屋毅举行会谈一事，日本内阁官房长官木原稔29日表示：“正因为双方存在意见分歧，才更需要在广泛领域开展沟通。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260929-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E5%9B%9E%E5%BA%94%E7%8E%8B%E6%AF%85%E4%BC%9A%E8%A7%81%E6%97%A5%E6%9C%AC%E5%89%8D%E5%A4%96%E7%9B%B8-%E6%8F%90%E5%87%BA%E6%97%A5%E4%B8%AD-%E5%86%8D%E6%AC%A1%E5%AE%9E%E7%8E%B0%E6%AD%A3%E5%B8%B8%E5%8C%96-%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790672730000.webp","sourceId":"rfi"},{"id":1790672478000,"createdDate":"2026-09-29 09:01","name":"法国国际广播电台","title":"法国公共债务率达119%，创战后新高，融资成本涨幅仅次于土耳其和俄罗斯，市场担心暴雷","content":"9月29日，法国国家统计局发布报告，截至2026年第二季度末，法国公共债务达到3.5955万亿欧元，占国内生产总值119%，创下1946年二战遗留经济创伤以来新高点。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260929-%E6%B3%95%E5%9B%BD%E5%85%AC%E5%85%B1%E5%80%BA%E5%8A%A1%E7%8E%87%E8%BE%BE119-%EF%BC%8C%E5%88%9B%E6%88%98%E5%90%8E%E6%96%B0%E9%AB%98%EF%BC%8C%E8%9E%8D%E8%B5%84%E6%88%90%E6%9C%AC%E6%B6%A8%E5%B9%85%E4%BB%85%E6%AC%A1%E4%BA%8E%E5%9C%9F%E8%80%B3%E5%85%B6%E5%92%8C%E4%BF%84%E7%BD%97%E6%96%AF%EF%BC%8C%E5%B8%82%E5%9C%BA%E6%8B%85%E5%BF%83%E6%9A%B4%E9%9B%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790672478000.webp","sourceId":"rfi"},{"id":1790671813000,"createdDate":"2026-09-29 08:50","name":"法国国际广播电台","title":"代省长转正 孔绍逊任甘肃省长","content":"据官媒新华社消息，甘肃省第十四届人民代表大会第五次会议9月29日选举吴晓军为甘肃省人大常委会主任，选举孔绍逊为甘肃省人民政府省长。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260929-%E4%BB%A3%E7%9C%81%E9%95%BF%E8%BD%AC%E6%AD%A3-%E5%AD%94%E7%BB%8D%E9%80%8A%E4%BB%BB%E7%94%98%E8%82%83%E7%9C%81%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790671813000.webp","sourceId":"rfi"},{"id":1790671061000,"createdDate":"2026-09-29 08:37","name":"法国国际广播电台","title":"霍尔木兹海峡或将重开？伊朗称静候美方周二回应，特朗普否认对伊让步","content":"伊朗外交部长阿巴斯·阿拉格齐表示，伊朗预计将在周二（9月29日）收到美国对于德黑兰提出的重开霍尔木兹海峡条件的正式回应。过去一周，在纽约联合国大会期间，在卡塔尔的斡旋下，围绕中东战争问题的间接谈判持续进行。一方是美国特使，另一方则是伊朗外交代表。阿拉格齐上周五在联合国期间向记者表示，目前讨论中的方案一旦达成，将启动为期七天的倒计时机制，其间霍尔木兹海峡将逐步恢复通航，同时地区冲突也将暂停。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260929-%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%88%96%E5%B0%86%E9%87%8D%E5%BC%80-%E4%BC%8A%E6%9C%97%E7%A7%B0%E9%9D%99%E5%80%99%E7%BE%8E%E6%96%B9%E5%91%A8%E4%BA%8C%E5%9B%9E%E5%BA%94%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E5%90%A6%E8%AE%A4%E5%AF%B9%E4%BC%8A%E8%AE%A9%E6%AD%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790671061000.webp","sourceId":"rfi"},{"id":1790667774000,"createdDate":"2026-09-29 07:42","name":"法国国际广播电台","title":"特习会后美国向台湾国防部保证台美关系不变 大豆与波音无法取代台湾地位","content":"随着特习会落幕，是否影响美国对台军售，备受关注。台湾国防部长顾立雄表示，会后接获美方一再说明，美国对台的政策并没有任何改变。且对美军购的F-16V战机，现在产制进度确实已达到可以交机的状态。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260929-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%90%8E%E7%BE%8E%E5%9B%BD%E5%90%91%E5%8F%B0%E6%B9%BE%E5%9B%BD%E9%98%B2%E9%83%A8%E4%BF%9D%E8%AF%81%E5%8F%B0%E7%BE%8E%E5%85%B3%E7%B3%BB%E4%B8%8D%E5%8F%98-%E5%A4%A7%E8%B1%86%E4%B8%8E%E6%B3%A2%E9%9F%B3%E6%97%A0%E6%B3%95%E5%8F%96%E4%BB%A3%E5%8F%B0%E6%B9%BE%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790667774000.webp","sourceId":"rfi"},{"id":1790666159000,"createdDate":"2026-09-29 07:15","name":"法国国际广播电台","title":"谈判筹码？特朗普否认向习近平提议卖美国军火 但又称向华售武是好主意","content":"美国总统特朗普(DonaldTrump，台湾译作川普)被指曾向中国国家主席习近平提问要不要购买美国军备一事引发争议後翌日，特朗普亲口否认，质疑是透露事件的驻华大使庞德伟(DavidPerdue)误提台湾作中国。但特朗普又表示，向中国售武可能是好主意。综合而言，不同评论认为，特朗普可能是进行谈判操作或以军售作为对华外交筹码，但结果都会惹亚洲盟友不安。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260929-%E8%B0%88%E5%88%A4%E7%AD%B9%E7%A0%81-%E7%89%B9%E6%9C%97%E6%99%AE%E5%90%A6%E8%AE%A4%E5%90%91%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8F%90%E8%AE%AE%E5%8D%96%E7%BE%8E%E5%9B%BD%E5%86%9B%E7%81%AB-%E4%BD%86%E5%8F%88%E7%A7%B0%E5%90%91%E5%8D%8E%E5%94%AE%E6%AD%A6%E6%98%AF%E5%A5%BD%E4%B8%BB%E6%84%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790666159000.webp","sourceId":"rfi"},{"id":1790715257000,"createdDate":"2026-09-29 20:54","name":"法国国际广播电台","title":"美伊战争重塑海湾地缘政治并危及石油美元体系","content":"美伊战争延续至今超过半年，战火同时冲击伊朗和海湾多国，未来局势恐重塑海湾地缘政治并危及石油美元体系。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260929-%E7%BE%8E%E4%BC%8A%E6%88%98%E4%BA%89%E9%87%8D%E5%A1%91%E6%B5%B7%E6%B9%BE%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E5%B9%B6%E5%8D%B1%E5%8F%8A%E7%9F%B3%E6%B2%B9%E7%BE%8E%E5%85%83%E4%BD%93%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790715257000.webp","sourceId":"rfi"},{"id":1790711315000,"createdDate":"2026-09-29 19:48","name":"法国国际广播电台","title":"俄袭击乌国科学院和基辅等地  并持续对北约盟国展开敌对行动","content":"俄乌战争迈入第5年，由于俄罗斯以无人机与飞弹攻击基辅的情况日益频繁，这场战争已成二战以来欧洲死伤最惨重的冲突。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260929-%E4%BF%84%E8%A2%AD%E5%87%BB%E4%B9%8C%E5%9B%BD%E7%A7%91%E5%AD%A6%E9%99%A2%E5%92%8C%E5%9F%BA%E8%BE%85%E7%AD%89%E5%9C%B0-%E5%B9%B6%E6%8C%81%E7%BB%AD%E5%AF%B9%E5%8C%97%E7%BA%A6%E7%9B%9F%E5%9B%BD%E5%B1%95%E5%BC%80%E6%95%8C%E5%AF%B9%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790711315000.webp","sourceId":"rfi"},{"id":1790706294000,"createdDate":"2026-09-29 18:24","name":"法国国际广播电台","title":"特朗普推出AI政府服务网站 称美国领先中国 不愿共同发展AI技术","content":"美国总统特朗普（DonaldTrump）29日在华盛顿宣布，由AI驱动的政府服务网站America.gov正式上线，宣称这项新工具将成为美国民众接触联邦政府的“单一入口”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260929-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8E%A8%E5%87%BAai%E6%94%BF%E5%BA%9C%E6%9C%8D%E5%8A%A1%E7%BD%91%E7%AB%99-%E7%A7%B0%E7%BE%8E%E5%9B%BD%E9%A2%86%E5%85%88%E4%B8%AD%E5%9B%BD-%E4%B8%8D%E6%84%BF%E5%85%B1%E5%90%8C%E5%8F%91%E5%B1%95ai%E6%8A%80%E6%9C%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790706294000.webp","sourceId":"rfi"},{"id":1790700302000,"createdDate":"2026-09-29 16:45","name":"法国国际广播电台","title":"继王毅后 日本前外相岩屋毅会见何立峰称提稀土出口许可证问题","content":"日本国际贸易促进协会（国贸促）新任会长、前外相岩屋毅继周一在北京会见了中国外交部长王毅，周二会见了中国国务院副总理何立峰。共同社报导指，自日本首相高市早苗去年11月的涉台国会答辩引发中日关系恶化以来，这是中方高层首次与日本国会议员会面。而接连两天安排会见实属罕见。王毅和何立峰均强调了日中关系的重要性，同时也就台湾问题向日方发出警告。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260929-%E7%BB%A7%E7%8E%8B%E6%AF%85%E5%90%8E-%E6%97%A5%E6%9C%AC%E5%89%8D%E5%A4%96%E7%9B%B8%E5%B2%A9%E5%B1%8B%E6%AF%85%E4%BC%9A%E8%A7%81%E4%BD%95%E7%AB%8B%E5%B3%B0%E7%A7%B0%E6%8F%90%E7%A8%80%E5%9C%9F%E5%87%BA%E5%8F%A3%E8%AE%B8%E5%8F%AF%E8%AF%81%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790700302000.webp","sourceId":"rfi"},{"id":1790697142000,"createdDate":"2026-09-29 15:52","name":"法国国际广播电台","title":"研究和专家指与美国对手相似 中国的AI智能体也欺骗、规避限制及掩盖失败","content":"据路透社报导，研究文件和专家指出，由中国技术驱动的人工智能（AI）智能体已学会欺骗、规避限制及掩盖失败；这些自主人工智能所表现出的特性，正是此前引发全球对美国人工智能模型担忧的同类问题。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260929-%E7%A0%94%E7%A9%B6%E5%92%8C%E4%B8%93%E5%AE%B6%E6%8C%87%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%AF%B9%E6%89%8B%E7%9B%B8%E4%BC%BC-%E4%B8%AD%E5%9B%BD%E7%9A%84ai%E6%99%BA%E8%83%BD%E4%BD%93%E4%B9%9F%E6%AC%BA%E9%AA%97-%E8%A7%84%E9%81%BF%E9%99%90%E5%88%B6%E5%8F%8A%E6%8E%A9%E7%9B%96%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/29/1790697142000.webp","sourceId":"rfi"}]