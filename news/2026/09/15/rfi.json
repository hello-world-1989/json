[{"id":1789432144000,"createdDate":"2026-09-15 00:29","name":"法国国际广播电台","title":"金砖国家峰会见证了中印关系在谨慎地回暖","content":"法国世界报指出，上周末在新德里举行的金砖国家峰会见证了中印关系进一步谨慎地回暖，但是，两国关系中的深层矛盾仍然存在。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260915-%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A%E8%A7%81%E8%AF%81%E4%BA%86%E4%B8%AD%E5%8D%B0%E5%85%B3%E7%B3%BB%E5%9C%A8%E8%B0%A8%E6%85%8E%E5%9C%B0%E5%9B%9E%E6%9A%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789432144000.webp","sourceId":"rfi"},{"id":1789497578000,"createdDate":"2026-09-15 18:39","name":"法国国际广播电台","title":"中国收紧公民出境规定 今天生效","content":"从今天9月15日起中国公民如果出境必须说明其理由，甚至可能在离境前需要接受面谈。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E4%B8%AD%E5%9B%BD%E6%94%B6%E7%B4%A7%E5%85%AC%E6%B0%91%E5%87%BA%E5%A2%83%E8%A7%84%E5%AE%9A-%E4%BB%8A%E5%A4%A9%E7%94%9F%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789497578000.webp","sourceId":"rfi"},{"id":1789497207000,"createdDate":"2026-09-15 18:33","name":"法国国际广播电台","title":"艾美奖颁奖《寡妇湾》斩获14项大奖，医疗剧《匹兹堡》表现抢眼","content":"恐怖喜剧《寡妇湾》周一在艾美奖颁奖典礼上大放异彩，在这项被誉为美国电视界“奥斯卡”的盛典上斩获14座奖杯；当晚，医疗剧《匹兹堡》也表现抢眼。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E8%89%BE%E7%BE%8E%E5%A5%96%E9%A2%81%E5%A5%96-%E5%AF%A1%E5%A6%87%E6%B9%BE-%E6%96%A9%E8%8E%B714%E9%A1%B9%E5%A4%A7%E5%A5%96%EF%BC%8C%E5%8C%BB%E7%96%97%E5%89%A7-%E5%8C%B9%E5%85%B9%E5%A0%A1-%E8%A1%A8%E7%8E%B0%E6%8A%A2%E7%9C%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789497207000.webp","sourceId":"rfi"},{"id":1789495665000,"createdDate":"2026-09-15 18:07","name":"法国国际广播电台","title":"胡塞狂炸沙特空军基地 加强控制曼德海峡 沙特王储抵埃及","content":"沙特阿拉伯周二承诺，在亲伊朗的也门胡塞武装再袭其领土后，采取“坚定”的反击措施。与此同时，伊朗否认参与这场冲突。这场冲突已成为中东战争中的又一条新战线。沙特王储周二到访开罗与埃及总统塞西会谈。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E8%83%A1%E5%A1%9E%E7%8B%82%E7%82%B8%E6%B2%99%E7%89%B9%E7%A9%BA%E5%86%9B%E5%9F%BA%E5%9C%B0-%E5%8A%A0%E5%BC%BA%E6%8E%A7%E5%88%B6%E6%9B%BC%E5%BE%B7%E6%B5%B7%E5%B3%A1-%E6%B2%99%E7%89%B9%E7%8E%8B%E5%82%A8%E6%8A%B5%E5%9F%83%E5%8F%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789495665000.webp","sourceId":"rfi"},{"id":1789494716000,"createdDate":"2026-09-15 17:51","name":"法国国际广播电台","title":"德黑兰拒绝特朗普对话建议：只要伊朗条件未满足不会有任何对话。句号！","content":"美国总统特朗普表示对与伊朗对话“持开放态度”后，伊朗最高安全机构负责人周二高调拒绝了在当前情况下与美国进行任何旨在结束战争的对话。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E5%BE%B7%E9%BB%91%E5%85%B0%E6%8B%92%E7%BB%9D%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E8%AF%9D%E5%BB%BA%E8%AE%AE-%E5%8F%AA%E8%A6%81%E4%BC%8A%E6%9C%97%E6%9D%A1%E4%BB%B6%E6%9C%AA%E6%BB%A1%E8%B6%B3%E4%B8%8D%E4%BC%9A%E6%9C%89%E4%BB%BB%E4%BD%95%E5%AF%B9%E8%AF%9D-%E5%8F%A5%E5%8F%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789494716000.webp","sourceId":"rfi"},{"id":1789493118000,"createdDate":"2026-09-15 17:25","name":"法国国际广播电台","title":"伊朗外长阿拉格齐将访中国 再与王毅会晤","content":"据中国外交部周二表示，伊朗外交部长阿巴斯·阿拉格齐将访问北京，并于周三与中国外交部长王毅举行会谈。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E9%98%BF%E6%8B%89%E6%A0%BC%E9%BD%90%E5%B0%86%E8%AE%BF%E4%B8%AD%E5%9B%BD-%E5%86%8D%E4%B8%8E%E7%8E%8B%E6%AF%85%E4%BC%9A%E6%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789493118000.webp","sourceId":"rfi"},{"id":1789489997000,"createdDate":"2026-09-15 16:33","name":"法国国际广播电台","title":"共同社独家：倘若华盛顿新批对台军售，北京称习近平将暂不访美","content":"共同社周一晚发自华盛顿的独家消息称，围绕计划本月下旬在美国举行的美中首脑会谈，多名美中关系消息人士日前透露，中方已要求美方不要在会谈前新批准对台湾的武器出售。据称，中方表示如果美方批准新的对台军售，中国国家主席习近平则暂不访美。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E5%85%B1%E5%90%8C%E7%A4%BE%E7%8B%AC%E5%AE%B6-%E5%80%98%E8%8B%A5%E5%8D%8E%E7%9B%9B%E9%A1%BF%E6%96%B0%E6%89%B9%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%EF%BC%8C%E5%8C%97%E4%BA%AC%E7%A7%B0%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%B0%86%E6%9A%82%E4%B8%8D%E8%AE%BF%E7%BE%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789489997000.webp","sourceId":"rfi"},{"id":1789489917000,"createdDate":"2026-09-15 16:31","name":"法国国际广播电台","title":"中国广州持刀袭击事件后一名男子被捕","content":"法新社9月15日电，中国警方表示，已逮捕一名男子，该男子于周一在广东一家购物中心持刀行凶，造成多人受伤。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E4%B8%AD%E5%9B%BD%E5%B9%BF%E5%B7%9E%E6%8C%81%E5%88%80%E8%A2%AD%E5%87%BB%E4%BA%8B%E4%BB%B6%E5%90%8E%E4%B8%80%E5%90%8D%E7%94%B7%E5%AD%90%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789489917000.webp","sourceId":"rfi"},{"id":1789488932000,"createdDate":"2026-09-15 16:15","name":"法国国际广播电台","title":"尼泊尔泥石流： 灾害到底发生在什么时间？谁上传了吉隆口岸的视频？","content":"这是两个看上去根本不值得讨论的问题，但确实又是十分重要的问题。","newsLink":"http://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260915-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B3%A5%E7%9F%B3%E6%B5%81-%E7%81%BE%E5%AE%B3%E5%88%B0%E5%BA%95%E5%8F%91%E7%94%9F%E5%9C%A8%E4%BB%80%E4%B9%88%E6%97%B6%E9%97%B4-%E8%B0%81%E4%B8%8A%E4%BC%A0%E4%BA%86%E5%90%89%E9%9A%86%E5%8F%A3%E5%B2%B8%E7%9A%84%E8%A7%86%E9%A2%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789488932000.webp","sourceId":"rfi"},{"id":1789488755000,"createdDate":"2026-09-15 16:12","name":"法国国际广播电台","title":"日中关系紧张未缓 东京国际电影节「中国电影周」停办","content":"据日本共同社周二（9月15日）报道，主办方NPO法人“日中电影节实行委员会”（东京方）宣布，原定每年10月配合东京国际电影节举办的年度「东京·中国电影周」今年取消举办。东京国际电影节将于10月26日至11月4日登场。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E6%97%A5%E4%B8%AD%E5%85%B3%E7%B3%BB%E7%B4%A7%E5%BC%A0%E6%9C%AA%E7%BC%93-%E4%B8%9C%E4%BA%AC%E5%9B%BD%E9%99%85%E7%94%B5%E5%BD%B1%E8%8A%82-%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%BD%B1%E5%91%A8-%E5%81%9C%E5%8A%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789488755000.webp","sourceId":"rfi"},{"id":1789488331000,"createdDate":"2026-09-15 16:05","name":"法国国际广播电台","title":"《费加罗报》：推动人民币国际化雄心与资本管控政策相互矛盾","content":"法国朝野围绕政府新预算案的博弈以及自美国开始的围绕人工智能开发的讨论是15日上市的法国全国性大报两大凸出主题。各报在国际版也都特别关注在乌克兰以及在海湾地区的两场战争。《费加罗报》和《解放报》聚焦俄罗斯打击乌克兰的行动距离欧洲越来越近的趋势，《解放报》和《回声报》也都关注胡塞武装控制曼德海峡对海上运输构成的威胁以及对能源市场的影响。《费加罗报》刊登文章，分析朝鲜金正恩政权为何对特朗普想与他再次会晤的提议并不积极。天主教报刊《十字架报》则以大版篇幅介绍围绕罗马教皇良十四来法国访问的种种准备工作。关于中国，我们借本次节目时间，介绍《费加罗报》网站一篇关于人民币如何在全球布局，挑战美元的文章。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260915-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E6%8E%A8%E5%8A%A8%E4%BA%BA%E6%B0%91%E5%B8%81%E5%9B%BD%E9%99%85%E5%8C%96%E9%9B%84%E5%BF%83%E4%B8%8E%E8%B5%84%E6%9C%AC%E7%AE%A1%E6%8E%A7%E6%94%BF%E7%AD%96%E7%9B%B8%E4%BA%92%E7%9F%9B%E7%9B%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789488331000.webp","sourceId":"rfi"},{"id":1789487822000,"createdDate":"2026-09-15 15:57","name":"法国国际广播电台","title":"美军首认在太空部署了武器 中俄迅即反应：法新社解析“太空军事化”的利益攸关者、武器、法律框架是什么？","content":"在美军昨天周一首次证实美国已在轨道上部署武器后，中国今天周二敦促美国“停止为太空战争做准备”；並警告称，应防止“外层空间军事化及其向战场的转化”。针对这场竞争，法新社稍晚引述常驻香港的独立军事评论员宋忠平认为：“中国不会坐视不管，因为美国的太空战略必将危及我们的国家安全。”","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260915-%E7%BE%8E%E5%86%9B%E9%A6%96%E8%AE%A4%E5%9C%A8%E5%A4%AA%E7%A9%BA%E9%83%A8%E7%BD%B2%E4%BA%86%E6%AD%A6%E5%99%A8-%E4%B8%AD%E4%BF%84%E8%BF%85%E5%8D%B3%E5%8F%8D%E5%BA%94-%E6%B3%95%E6%96%B0%E7%A4%BE%E8%A7%A3%E6%9E%90-%E5%A4%AA%E7%A9%BA%E5%86%9B%E4%BA%8B%E5%8C%96-%E7%9A%84%E5%88%A9%E7%9B%8A%E6%94%B8%E5%85%B3%E8%80%85-%E6%AD%A6%E5%99%A8-%E6%B3%95%E5%BE%8B%E6%A1%86%E6%9E%B6%E6%98%AF%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789487822000.webp","sourceId":"rfi"},{"id":1789487722000,"createdDate":"2026-09-15 15:55","name":"法国国际广播电台","title":"默茨陷入严重危机","content":"9月6日德国萨安州选举，被视为右翼民粹的选择党(AfD)获得巨大胜利，给德国民主党派尤其是执政党基民盟（CDU）带来巨大难题。基民盟籍总理默茨的领导能力受到越来越多的怀疑。默茨陷入严重危机。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20260915-%E9%BB%98%E8%8C%A8%E9%99%B7%E5%85%A5%E4%B8%A5%E9%87%8D%E5%8D%B1%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789487722000.webp","sourceId":"rfi"},{"id":1789487647000,"createdDate":"2026-09-15 15:54","name":"法国国际广播电台","title":"北约在立陶宛击落一架无人机 俄舰向丹麦军机发射两颗照明弹","content":"俄罗斯对乌克兰的攻击已向西部外溢到北约成员国立陶宛和更西边的丹麦，令地缘政治局势日趋紧张。","newsLink":"http://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260915-%E5%8C%97%E7%BA%A6%E5%9C%A8%E7%AB%8B%E9%99%B6%E5%AE%9B%E5%87%BB%E8%90%BD%E4%B8%80%E6%9E%B6%E6%97%A0%E4%BA%BA%E6%9C%BA-%E4%BF%84%E8%88%B0%E5%90%91%E4%B8%B9%E9%BA%A6%E5%86%9B%E6%9C%BA%E5%8F%91%E5%B0%84%E4%B8%A4%E9%A2%97%E7%85%A7%E6%98%8E%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789487647000.webp","sourceId":"rfi"},{"id":1789487209000,"createdDate":"2026-09-15 15:46","name":"法国国际广播电台","title":"美日政府对冲绳县知事选举结果感到欣慰","content":"在日本冲绳县知事选举中，容忍冲绳县宜野湾市美军普天间机场迁至名护市边野古的古谢玄太以14万以上的得票差距战胜反对美军机场在县内迁移的现任知事玉城丹尼，容忍派时隔12年战胜反对派，为此美国政府和日本政府都感到欣慰。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260915-%E7%BE%8E%E6%97%A5%E6%94%BF%E5%BA%9C%E5%AF%B9%E5%86%B2%E7%BB%B3%E5%8E%BF%E7%9F%A5%E4%BA%8B%E9%80%89%E4%B8%BE%E7%BB%93%E6%9E%9C%E6%84%9F%E5%88%B0%E6%AC%A3%E6%85%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789487209000.webp","sourceId":"rfi"},{"id":1789486417000,"createdDate":"2026-09-15 15:33","name":"法国国际广播电台","title":"金正恩再重申支持俄罗斯对乌克兰“圣战”","content":"朝鲜领导人金正恩在致俄罗斯总统普京的一封信中继续承诺将向俄罗斯对乌克兰发动的“圣战”中提供“坚定不移的支持”。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E9%87%91%E6%AD%A3%E6%81%A9%E5%86%8D%E9%87%8D%E7%94%B3%E6%94%AF%E6%8C%81%E4%BF%84%E7%BD%97%E6%96%AF%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0-%E5%9C%A3%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789486417000.webp","sourceId":"rfi"},{"id":1789485968000,"createdDate":"2026-09-15 15:26","name":"法国国际广播电台","title":"法国2027年总统大选：候选人纷纷登场 极右翼勒庞占据领先","content":"暑期结束，距离法国2027年总统大选首轮投票不足八个月，法国政坛已提前进入了选举周期。随着越来越多政治人物宣布参选或释放参选意愿，爱丽舍宫争夺之战的基本轮廓正在初显。本次欧洲专题，我们就一起来了解此次大选的概况，以及截止到目前各党派候选人参选的情况。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E6%AC%A7%E6%B4%B2/20260915-%E6%B3%95%E5%9B%BD2027%E5%B9%B4%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89-%E5%80%99%E9%80%89%E4%BA%BA%E7%BA%B7%E7%BA%B7%E7%99%BB%E5%9C%BA-%E6%9E%81%E5%8F%B3%E7%BF%BC%E5%8B%92%E5%BA%9E%E5%8D%A0%E6%8D%AE%E9%A2%86%E5%85%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789485968000.webp","sourceId":"rfi"},{"id":1789485770000,"createdDate":"2026-09-15 15:22","name":"法国国际广播电台","title":"华盛顿称在太空部署了武器  中国敦促美国“停止太空备战”","content":"法新社报道，美国太空军首次承认在太空部署了武器，但未透露具体细节。美国太空军一名发言人在一份声明中表示：“美国在轨道上部署了武装太空监控系统，能够保护联合部队免受对手敌对行动的威胁”。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E7%A7%B0%E5%9C%A8%E5%A4%AA%E7%A9%BA%E9%83%A8%E7%BD%B2%E4%BA%86%E6%AD%A6%E5%99%A8-%E4%B8%AD%E5%9B%BD%E6%95%A6%E4%BF%83%E7%BE%8E%E5%9B%BD-%E5%81%9C%E6%AD%A2%E5%A4%AA%E7%A9%BA%E5%A4%87%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789485770000.webp","sourceId":"rfi"},{"id":1789484509000,"createdDate":"2026-09-15 15:01","name":"法国国际广播电台","title":"美国施压：日本拟将国防开支提高至GDP3.5%","content":"彭博社消息，在美国施压下，日本正考虑将中期国防开支目标设定为GDP的3.5%，与北约和其他美国盟国保持一致，此举可能会引发争议。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260915-%E7%BE%8E%E5%9B%BD%E6%96%BD%E5%8E%8B-%E6%97%A5%E6%9C%AC%E6%8B%9F%E5%B0%86%E5%9B%BD%E9%98%B2%E5%BC%80%E6%94%AF%E6%8F%90%E9%AB%98%E8%87%B3gdp3-5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789484509000.webp","sourceId":"rfi"},{"id":1789484053000,"createdDate":"2026-09-15 14:54","name":"法国国际广播电台","title":"英跨党派促首相助黄之锋获释 港府拟跟进Netflix免费发放黄之锋纪录片预告","content":"在囚的学民思潮创办人黄之锋被控勾结外国势力，现正认罪候判，最高可判终身监禁，前景惹人关注，英国政界为此联署促请首相贝安德（AndyBurnham）就黄之锋案件向中方提出交涉。另一边厢，港府应亲北京媒体和人士要求，跟进美国串流网络电视平台Netflix容许香港用户无须付费订阅，即可观看黄之锋纪录片预告一事，是否涉及违法。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260915-%E8%8B%B1%E8%B7%A8%E5%85%9A%E6%B4%BE%E4%BF%83%E9%A6%96%E7%9B%B8%E5%8A%A9%E9%BB%84%E4%B9%8B%E9%94%8B%E8%8E%B7%E9%87%8A-%E6%B8%AF%E5%BA%9C%E6%8B%9F%E8%B7%9F%E8%BF%9Bnetflix%E5%85%8D%E8%B4%B9%E5%8F%91%E6%94%BE%E9%BB%84%E4%B9%8B%E9%94%8B%E7%BA%AA%E5%BD%95%E7%89%87%E9%A2%84%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789484053000.webp","sourceId":"rfi"},{"id":1789483014000,"createdDate":"2026-09-15 14:36","name":"法国国际广播电台","title":"香山论坛开幕　香港记协和RSF关注采访会议後失联三年的《南早》记者陈敏莉","content":"第13届北京香山论坛周二（15日）在北京开幕，在外界关注中美军方接触情况的同时，「无国界记者」发文，关注于2023年到北京采访香山论坛后失联的香港英文《南华早报》记者陈敏莉至今仍下落不明，促请中国公开她的下落；而香港记者协会采访陈的友人则促请《南早》更积极营救陈敏莉。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260915-%E9%A6%99%E5%B1%B1%E8%AE%BA%E5%9D%9B%E5%BC%80%E5%B9%95-%E9%A6%99%E6%B8%AF%E8%AE%B0%E5%8D%8F%E5%92%8Crsf%E5%85%B3%E6%B3%A8%E9%87%87%E8%AE%BF%E4%BC%9A%E8%AE%AE%E5%BE%8C%E5%A4%B1%E8%81%94%E4%B8%89%E5%B9%B4%E7%9A%84-%E5%8D%97%E6%97%A9-%E8%AE%B0%E8%80%85%E9%99%88%E6%95%8F%E8%8E%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789483014000.webp","sourceId":"rfi"},{"id":1789511769000,"createdDate":"2026-09-15 22:36","name":"法国国际广播电台","title":"中国实施出入境新规后会发生什么？","content":"中国国务院关于出境入境管理的新规定9月15日起正式实施。有不少人预感“未来出境将全面收紧，普通人出境变难”，更有人直指“国门正慢慢关上”，怀疑声浪之大，以至于中国国务院三部门负责人以答记者问形式出面释疑，称前述说法系“误读新规”。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E4%B8%AD%E5%9B%BD%E5%AE%9E%E6%96%BD%E5%87%BA%E5%85%A5%E5%A2%83%E6%96%B0%E8%A7%84%E5%90%8E%E4%BC%9A%E5%8F%91%E7%94%9F%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789511769000.webp","sourceId":"rfi"},{"id":1789510758000,"createdDate":"2026-09-15 22:19","name":"法国国际广播电台","title":"中国：年轻大学毕业生勇于抗争，最终让汽车业巨头低下了头","content":"法国世界报周二关注中国的一起社会抗争事件。这一事件涉及107名入职不久的中国年轻大学毕业生以及中国汽车零部件巨头星宇。星宇试图解雇107名刚入职的年轻大学毕业生，可这些年轻的大学毕业生勇于抗争，最终让星宇低了头。星宇因此陷入一系列麻烦，原本在香港上市的计划也受到威胁。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260915-%E4%B8%AD%E5%9B%BD-%E5%B9%B4%E8%BD%BB%E5%A4%A7%E5%AD%A6%E6%AF%95%E4%B8%9A%E7%94%9F%E5%8B%87%E4%BA%8E%E6%8A%97%E4%BA%89%EF%BC%8C%E6%9C%80%E7%BB%88%E8%AE%A9%E6%B1%BD%E8%BD%A6%E4%B8%9A%E5%B7%A8%E5%A4%B4%E4%BD%8E%E4%B8%8B%E4%BA%86%E5%A4%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789510758000.webp","sourceId":"rfi"},{"id":1789510615000,"createdDate":"2026-09-15 22:16","name":"法国国际广播电台","title":"法国央行：法国经济增长2026年会放缓，但不会“掉链子”","content":"法国央行周二将2026年法国经济增长预期下调了0.1个百分点，目前的预计是增长0.4%。上星期四，法国国家统计与经济研究所（Insee）预计的2026年法国经济增长率也是0.4%。不过，虽然数字相同，但解读却不同。","newsLink":"http://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260915-%E6%B3%95%E5%9B%BD%E5%A4%AE%E8%A1%8C-%E6%B3%95%E5%9B%BD%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF2026%E5%B9%B4%E4%BC%9A%E6%94%BE%E7%BC%93%EF%BC%8C%E4%BD%86%E4%B8%8D%E4%BC%9A-%E6%8E%89%E9%93%BE%E5%AD%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789510615000.webp","sourceId":"rfi"},{"id":1789508754000,"createdDate":"2026-09-15 21:45","name":"法国国际广播电台","title":"卡尼力邀全球资本投资加拿大 称仍可能与美国达成协议","content":"加拿大总理卡尼周二（9月15日）在投资峰会上称加拿大“为全球资本的理想投资目的地”，他同时试图消除国际银行和投资基金对美加关系前景的担忧。卡尼并重申，加拿大与美国达成协议仍然“有可能”。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E5%8D%A1%E5%B0%BC%E5%8A%9B%E9%82%80%E5%85%A8%E7%90%83%E8%B5%84%E6%9C%AC%E6%8A%95%E8%B5%84%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E7%A7%B0%E4%BB%8D%E5%8F%AF%E8%83%BD%E4%B8%8E%E7%BE%8E%E5%9B%BD%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789508754000.webp","sourceId":"rfi"},{"id":1789508594000,"createdDate":"2026-09-15 21:43","name":"法国国际广播电台","title":"中国多所大学财政压力下要过“紧日子” 教师降薪受瞩","content":"中国多所大学近期要求“厉行节约、过紧日子”。由于大学预算逐年被删减，财政压力增加，社交媒体上出现许多大学教师遭到降薪的消息，引发关注与热议。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E4%B8%AD%E5%9B%BD%E5%A4%9A%E6%89%80%E5%A4%A7%E5%AD%A6%E8%B4%A2%E6%94%BF%E5%8E%8B%E5%8A%9B%E4%B8%8B%E8%A6%81%E8%BF%87-%E7%B4%A7%E6%97%A5%E5%AD%90-%E6%95%99%E5%B8%88%E9%99%8D%E8%96%AA%E5%8F%97%E7%9E%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789508594000.webp","sourceId":"rfi"},{"id":1789508268000,"createdDate":"2026-09-15 21:37","name":"法国国际广播电台","title":"泽连斯基拟在纽约会晤马克龙 乌克兰面临230亿欧元军费缺口","content":"乌克兰总统泽连斯基周二（9月15日）表示，他将在纽约联合国大会期间与法国总统马克龙会晤，讨论结束乌克兰战争的外交进程。与此同时，为填补高达230亿欧元的军费缺口，乌克兰政府准备采取一系列措施，这些措施可能引发民众不满。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8B%9F%E5%9C%A8%E7%BA%BD%E7%BA%A6%E4%BC%9A%E6%99%A4%E9%A9%AC%E5%85%8B%E9%BE%99-%E4%B9%8C%E5%85%8B%E5%85%B0%E9%9D%A2%E4%B8%B4230%E4%BA%BF%E6%AC%A7%E5%85%83%E5%86%9B%E8%B4%B9%E7%BC%BA%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789508268000.webp","sourceId":"rfi"},{"id":1789508059000,"createdDate":"2026-09-15 21:34","name":"法国国际广播电台","title":"美国三大人工智能企业拟组建风险监督机构","content":"美国人工智能企业OpenAI、Anthropic和谷歌旗下DeepMind公司正在筹建一个人工智能风险监督机构。在各界日益呼吁加强监管、防范人工智能失控风险之际，OpenAI周二（9月15日）向法新社证实了这一消息。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E7%BE%8E%E5%9B%BD%E4%B8%89%E5%A4%A7%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%BC%81%E4%B8%9A%E6%8B%9F%E7%BB%84%E5%BB%BA%E9%A3%8E%E9%99%A9%E7%9B%91%E7%9D%A3%E6%9C%BA%E6%9E%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789508059000.webp","sourceId":"rfi"},{"id":1789507733000,"createdDate":"2026-09-15 21:28","name":"法国国际广播电台","title":"美国财长周末会晤何立峰 为中美元首会晤作准备","content":"美国财政部长贝森特周二（9月15日）宣布，他将于本周末与中国副总理何立峰举行会晤，为预计本月下旬举行的中美元首会晤作准备。目前，中方尚未公布此次会晤的相关消息。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-%E7%BE%8E%E5%9B%BD%E8%B4%A2%E9%95%BF%E5%91%A8%E6%9C%AB%E4%BC%9A%E6%99%A4%E4%BD%95%E7%AB%8B%E5%B3%B0-%E4%B8%BA%E4%B8%AD%E7%BE%8E%E5%85%83%E9%A6%96%E4%BC%9A%E6%99%A4%E4%BD%9C%E5%87%86%E5%A4%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789507733000.webp","sourceId":"rfi"},{"id":1789507003000,"createdDate":"2026-09-15 21:16","name":"法国国际广播电台","title":"AI大家谈： “我们为自己创造了一个魔鬼”？","content":"人工智能飞速发展会给人类前途带来什么样的后果？美国AI领域的某些精英预言，人工智能再这样发展下去，会把人类毁灭，美国AI领军企业的老板们倡议放缓开发？法新社为此采访了多个国家的普通人，请他们谈谈看法和感受。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260915-ai%E5%A4%A7%E5%AE%B6%E8%B0%88-%E6%88%91%E4%BB%AC%E4%B8%BA%E8%87%AA%E5%B7%B1%E5%88%9B%E9%80%A0%E4%BA%86%E4%B8%80%E4%B8%AA%E9%AD%94%E9%AC%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/15/1789507003000.webp","sourceId":"rfi"}]