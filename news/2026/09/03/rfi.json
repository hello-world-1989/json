[{"id":1788439038000,"createdDate":"2026-09-03 12:37","name":"法国国际广播电台","title":"新西兰外长：中台议题紧张气氛在太平洋岛国论坛会场外显而易见 门外游说不妥","content":"新西兰外交部长彼得斯（WinstonPeters）表示，根据长期以来的既有规程，台湾在太平洋岛国论坛中享有观察员地位；明年由新西兰主办该论坛时，这一安排也不会改变。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260903-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%A4%96%E9%95%BF-%E4%B8%AD%E5%8F%B0%E8%AE%AE%E9%A2%98%E7%B4%A7%E5%BC%A0%E6%B0%94%E6%B0%9B%E5%9C%A8%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E4%BC%9A%E5%9C%BA%E5%A4%96%E6%98%BE%E8%80%8C%E6%98%93%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788439038000.webp","sourceId":"rfi"},{"id":1788435573000,"createdDate":"2026-09-03 11:39","name":"法国国际广播电台","title":"中使馆提醒赴俄留学若接到征兵类电话等及时与校方、使领馆联系","content":"中国驻俄罗斯大使馆周二发布有关“2026年中国公民赴（返）俄罗斯留学的相关提醒”的重要通知。其内容包括“外国公民在俄办理教育临时居留许可与兵役及服役领域的法律规定无关联。如接到‘征兵’类电话、短信、邮件等，请及时与校方、驻俄使（领）馆联系”的提醒。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260903-%E4%B8%AD%E4%BD%BF%E9%A6%86%E6%8F%90%E9%86%92%E8%B5%B4%E4%BF%84%E7%95%99%E5%AD%A6%E8%8B%A5%E6%8E%A5%E5%88%B0%E5%BE%81%E5%85%B5%E7%B1%BB%E7%94%B5%E8%AF%9D%E7%AD%89%E5%8F%8A%E6%97%B6%E4%B8%8E%E6%A0%A1%E6%96%B9-%E4%BD%BF%E9%A2%86%E9%A6%86%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788435573000.webp","sourceId":"rfi"},{"id":1788434298000,"createdDate":"2026-09-03 11:18","name":"法国国际广播电台","title":"香港高院驳回“612基金”五名信托人定罪上诉　信托人称将上诉终审法院","content":"香港已停运的“612人道支援基金”涉嫌违反《社团条例》一案最新进展。香港高等法院上诉庭今天（9月3日），驳回基金五名信托人的定罪上诉，维持原审裁决。五人表示，将一同向香港终审法院申请终极上诉。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260903-%E9%A6%99%E6%B8%AF%E9%AB%98%E9%99%A2%E9%A9%B3%E5%9B%9E-612%E5%9F%BA%E9%87%91-%E4%BA%94%E5%90%8D%E4%BF%A1%E6%89%98%E4%BA%BA%E5%AE%9A%E7%BD%AA%E4%B8%8A%E8%AF%89-%E4%BF%A1%E6%89%98%E4%BA%BA%E7%A7%B0%E5%B0%86%E4%B8%8A%E8%AF%89%E7%BB%88%E5%AE%A1%E6%B3%95%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788434298000.webp","sourceId":"rfi"},{"id":1788432970000,"createdDate":"2026-09-03 10:56","name":"法国国际广播电台","title":"地缘争端白热化 经济利益最大化","content":"9月初刚刚结束的G20财长会和上合组织峰会，向世界揭开了大国元首穿梭外交背后的政治与经济博弈序幕。东南亚观察意见认为，一个以“多极化”和“阵营对垒”为核心特征的新全球秩序正在加速确立，并以阵营化、碎片化的发展趋势取代先前由美国主导的单极全球秩序。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260903-%E5%9C%B0%E7%BC%98%E4%BA%89%E7%AB%AF%E7%99%BD%E7%83%AD%E5%8C%96-%E7%BB%8F%E6%B5%8E%E5%88%A9%E7%9B%8A%E6%9C%80%E5%A4%A7%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432970000.webp","sourceId":"rfi"},{"id":1788432510000,"createdDate":"2026-09-03 10:48","name":"法国国际广播电台","title":"欧洲如何才能“拍死”俄罗斯“这只咬人苍蝇”？传统亲美的东南亚正投向中国怀抱","content":"大家好，欢迎收听法国报纸摘要。作为基辅军事后勤枢纽的德国莱比锡机场8月初发生了针对货机的未遂袭击，令欧洲人陷入两难境地：一方面，俄罗斯否认参与其中；另一方面，俄罗斯却不断加大对乌克兰境内平民目标的打击力度。欧盟外交与安全政策高级代表卡拉斯周三直言，面对这个棘手的问题是“该怎么办？” 成为周四9月3日出刊的《解放报》与《费加罗报》头版共同关注的焦点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260903-%E6%AC%A7%E6%B4%B2%E5%A6%82%E4%BD%95%E6%89%8D%E8%83%BD-%E6%8B%8D%E6%AD%BB-%E4%BF%84%E7%BD%97%E6%96%AF-%E8%BF%99%E5%8F%AA%E5%92%AC%E4%BA%BA%E8%8B%8D%E8%9D%87-%E4%BC%A0%E7%BB%9F%E4%BA%B2%E7%BE%8E%E7%9A%84%E4%B8%9C%E5%8D%97%E4%BA%9A%E6%AD%A3%E6%8A%95%E5%90%91%E4%B8%AD%E5%9B%BD%E6%80%80%E6%8A%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432510000.webp","sourceId":"rfi"},{"id":1788432157000,"createdDate":"2026-09-03 10:42","name":"法国国际广播电台","title":"特朗普以打击生育旅游为名限制出生公民权政令遭法官叫停","content":"美国总统特朗普8月6日才推出的一项限制出生公民权的新政令，9月2日被马里兰州一名联邦法官叫停。特朗普这项政令原本意在打击外国人以旅游名义赴美生产，新生儿因此获得美国公民权的现象。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BB%A5%E6%89%93%E5%87%BB%E7%94%9F%E8%82%B2%E6%97%85%E6%B8%B8%E4%B8%BA%E5%90%8D%E9%99%90%E5%88%B6%E5%87%BA%E7%94%9F%E5%85%AC%E6%B0%91%E6%9D%83%E6%94%BF%E4%BB%A4%E9%81%AD%E6%B3%95%E5%AE%98%E5%8F%AB%E5%81%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432157000.webp","sourceId":"rfi"},{"id":1788432129000,"createdDate":"2026-09-03 10:42","name":"法国国际广播电台","title":"针对Shein等“超快时尚”产品经济处罚在法生效 北京：由此产生一切后果由法方承担","content":"针对Shein、Temu和AliExpress等中国大型电商平台销售的“超快时尚”产品，一项经济惩罚措施于周二（1日）在法国生效。这项措施规定，到2030年，每件商品最高将被处以19.50欧元的罚款，罚款上限为税前价格的50%。该措施是法国议会于6月下旬通过的一项旨在打击“快时尚”的法律的一部分；该法律还包含其他定于日后生效的措施。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260903-%E9%92%88%E5%AF%B9shein%E7%AD%89-%E8%B6%85%E5%BF%AB%E6%97%B6%E5%B0%9A-%E4%BA%A7%E5%93%81%E7%BB%8F%E6%B5%8E%E5%A4%84%E7%BD%9A%E5%9C%A8%E6%B3%95%E7%94%9F%E6%95%88-%E5%8C%97%E4%BA%AC-%E7%94%B1%E6%AD%A4%E4%BA%A7%E7%94%9F%E4%B8%80%E5%88%87%E5%90%8E%E6%9E%9C%E7%94%B1%E6%B3%95%E6%96%B9%E6%89%BF%E6%8B%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432129000.webp","sourceId":"rfi"},{"id":1788429378000,"createdDate":"2026-09-03 09:56","name":"法国国际广播电台","title":"美驻华大使：美国呼吁立即释放艺术家高兟 他和家人已受尽苦难","content":"美国驻华大使庞德伟（DavidPerdue）周四通过社媒平台X表示，“艺术家高兟在遭到不公正的判刑之前已经在拘留所被关了两年。他和他的家人已经受尽了苦难。美国呼吁立即释放他”。庞德伟并转发了美国国务院负责民主、人权和劳工事务的助理国务卿巴恩斯（Riley M. Barnes）周三发表的呼吁立即释放高兟，并要求有关当局允许他的家人离开中国的贴文。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260903-%E7%BE%8E%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF-%E7%BE%8E%E5%9B%BD%E5%91%BC%E5%90%81%E7%AB%8B%E5%8D%B3%E9%87%8A%E6%94%BE%E8%89%BA%E6%9C%AF%E5%AE%B6%E9%AB%98%E5%85%9F-%E4%BB%96%E5%92%8C%E5%85%B6%E5%AE%B6%E4%BA%BA%E5%B7%B2%E5%8F%97%E5%B0%BD%E8%8B%A6%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788429378000.webp","sourceId":"rfi"},{"id":1788428290000,"createdDate":"2026-09-03 09:38","name":"法国国际广播电台","title":"美国对进口无人机及无人机零部件加征关税措施今起生效","content":"美国针对多种类型无人机及无人机零部件进口加征百分之百关税的措施2026年9月3日零时起，开始生效执行。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E8%BF%9B%E5%8F%A3%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%8F%8A%E6%97%A0%E4%BA%BA%E6%9C%BA%E9%9B%B6%E9%83%A8%E4%BB%B6%E5%8A%A0%E5%BE%81%E5%85%B3%E7%A8%8E%E6%8E%AA%E6%96%BD%E4%BB%8A%E8%B5%B7%E7%94%9F%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788428290000.webp","sourceId":"rfi"},{"id":1788427728000,"createdDate":"2026-09-03 09:28","name":"法国国际广播电台","title":"乌克兰警告国际民用航空组织使用俄罗斯领空存在的风险","content":"乌克兰已正式联系国际民用航空组织（ICAO），警告其使用俄罗斯领空存在的风险。基辅甚至要求该国际组织成员国禁止民用航班飞越俄罗斯领空。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260903-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%AD%A6%E5%91%8A%E5%9B%BD%E9%99%85%E6%B0%91%E7%94%A8%E8%88%AA%E7%A9%BA%E7%BB%84%E7%BB%87%E4%BD%BF%E7%94%A8%E4%BF%84%E7%BD%97%E6%96%AF%E9%A2%86%E7%A9%BA%E5%AD%98%E5%9C%A8%E7%9A%84%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788427728000.webp","sourceId":"rfi"},{"id":1788426915000,"createdDate":"2026-09-03 09:15","name":"法国国际广播电台","title":"光州双年展恢复台湾馆名称 中方策展团队撤展 韩国外交部：此事与政府对台立场无关","content":"中方策展团队决定撤回其在第十六届光州双年展上的展馆，以抗议“台湾馆”相关问题。周四，中方策展团队在光州河正雄美术馆举行新闻发布会，宣布：“我们一致决定撤展，以表达我们的强烈抗议”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260903-%E5%85%89%E5%B7%9E%E5%8F%8C%E5%B9%B4%E5%B1%95%E6%81%A2%E5%A4%8D%E5%8F%B0%E6%B9%BE%E9%A6%86%E5%90%8D%E7%A7%B0-%E4%B8%AD%E6%96%B9%E7%AD%96%E5%B1%95%E5%9B%A2%E9%98%9F%E6%92%A4%E5%B1%95-%E9%9F%A9%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8-%E6%AD%A4%E4%BA%8B%E4%B8%8E%E6%94%BF%E5%BA%9C%E5%AF%B9%E5%8F%B0%E7%AB%8B%E5%9C%BA%E6%97%A0%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788426915000.webp","sourceId":"rfi"},{"id":1788426304000,"createdDate":"2026-09-03 09:05","name":"法国国际广播电台","title":"港府成功收购九成九宏福苑火灾业权 有居民称被迫无奈 有卖楼者称续追责","content":"导致168人死亡的大埔宏福苑大火，不少居民要求原址重建，但随着香港政府拒绝公开根楼宇勘察报告丶扬言不排除立法强制收回业权等情况下，当局终於在限期前收到99.1%的业主签署「接受收购建议信件」，成为宏福苑最大业主，亦令一众原业主能否继续追责成为疑问。但不少出席极有可能是最後一次业主大会的居民均表示，出售业权是被迫和无奈，当中，在火灾中失去妻子的叶家驹表明，不会放弃追责，要讨回公道。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260903-%E6%B8%AF%E5%BA%9C%E6%88%90%E5%8A%9F%E6%94%B6%E8%B4%AD%E4%B9%9D%E6%88%90%E4%B9%9D%E5%AE%8F%E7%A6%8F%E8%8B%91%E7%81%AB%E7%81%BE%E4%B8%9A%E6%9D%83-%E6%9C%89%E5%B1%85%E6%B0%91%E7%A7%B0%E8%A2%AB%E8%BF%AB%E6%97%A0%E5%A5%88-%E6%9C%89%E5%8D%96%E6%A5%BC%E8%80%85%E7%A7%B0%E7%BB%AD%E8%BF%BD%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788426304000.webp","sourceId":"rfi"},{"id":1788420585000,"createdDate":"2026-09-03 07:29","name":"法国国际广播电台","title":"中友好议员联盟拟组织跨党派年轻议员访华","content":"据悉，由日本朝野各党议员组成的日中友好议员联盟，正在协调组织年轻议员代表团访华，目标是在9月内实现访问。日中友好议员联盟会长、自民党前干事长森山裕9月3日向记者透露了这一消息，目前议联正在与中国方面积极联系，以最后敲定行程与其他细节。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260903-%E4%B8%AD%E5%8F%8B%E5%A5%BD%E8%AE%AE%E5%91%98%E8%81%94%E7%9B%9F%E6%8B%9F%E7%BB%84%E7%BB%87%E8%B7%A8%E5%85%9A%E6%B4%BE%E5%B9%B4%E8%BD%BB%E8%AE%AE%E5%91%98%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788420585000.webp","sourceId":"rfi"},{"id":1788449849000,"createdDate":"2026-09-03 15:37","name":"法国国际广播电台","title":"参与为锡安教会案辩护 律师王夏红落地台湾寻求协助再安置","content":"一名曾在北京为著名的锡安教会辩护的中国律师，在面临中国当局对其律师事务所和同事日益增长的压力后，已逃至台湾寻求重新安置的协助。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260903-%E5%8F%82%E4%B8%8E%E4%B8%BA%E9%94%A1%E5%AE%89%E6%95%99%E4%BC%9A%E6%A1%88%E8%BE%A9%E6%8A%A4-%E5%BE%8B%E5%B8%88%E7%8E%8B%E5%A4%8F%E7%BA%A2%E8%90%BD%E5%9C%B0%E5%8F%B0%E6%B9%BE%E5%AF%BB%E6%B1%82%E5%8D%8F%E5%8A%A9%E5%86%8D%E5%AE%89%E7%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788449849000.webp","sourceId":"rfi"},{"id":1788447749000,"createdDate":"2026-09-03 15:02","name":"法国国际广播电台","title":"Alipay+与印度支付系统对接计划搁浅 印政府存在国家安全和数据顾虑","content":"据路透社援引三位知情人士报导称，蚂蚁国际旗下的Alipay+提出的与印度即时支付系统对接以开展跨境交易的方案，因新德里方面的国家安全顾虑以及对客户数据存储与使用的质疑而陷入停滞。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260903-alipay-%E4%B8%8E%E5%8D%B0%E5%BA%A6%E6%94%AF%E4%BB%98%E7%B3%BB%E7%BB%9F%E5%AF%B9%E6%8E%A5%E8%AE%A1%E5%88%92%E6%90%81%E6%B5%85-%E5%8D%B0%E6%94%BF%E5%BA%9C%E5%AD%98%E5%9C%A8%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8%E5%92%8C%E6%95%B0%E6%8D%AE%E9%A1%BE%E8%99%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788447749000.webp","sourceId":"rfi"},{"id":1788447156000,"createdDate":"2026-09-03 14:52","name":"法国国际广播电台","title":"《快报》：曾称黄之锋为香港未来的卢比奥对黄之锋命运保持沉默","content":"香港前泛民主运动团体“学民思潮”创办人黄之锋在临近重获自由时，又被港府追加“勾结外国势力”罪名。黄之锋9月2日在高等法院出庭时选择认罪。刑罚判决尚未宣布，但预计自2000年11月就已经入狱的黄之锋还将在狱中度过很多时日。法国《快报》周刊当日发表文章，认为美国政府对香港民主运动的代表性人物的命运视而不见。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260903-%E5%BF%AB%E6%8A%A5-%E6%9B%BE%E7%A7%B0%E9%BB%84%E4%B9%8B%E9%94%8B%E4%B8%BA%E9%A6%99%E6%B8%AF%E6%9C%AA%E6%9D%A5%E7%9A%84%E5%8D%A2%E6%AF%94%E5%A5%A5%E5%AF%B9%E9%BB%84%E4%B9%8B%E9%94%8B%E5%91%BD%E8%BF%90%E4%BF%9D%E6%8C%81%E6%B2%89%E9%BB%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788447156000.webp","sourceId":"rfi"},{"id":1788446004000,"createdDate":"2026-09-03 14:33","name":"法国国际广播电台","title":"中方新闻稿指王毅称“韩朝两国” 韩国家安保室长魏圣洛：他没有这样说","content":"自首尔方面消息，针对中国外交部的一份新闻稿指，中共中央外办主任、外交部长王毅上月在与韩方官员会面时称“韩朝两国”一事，韩国政府已向中方提出交涉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260903-%E4%B8%AD%E6%96%B9%E6%96%B0%E9%97%BB%E7%A8%BF%E6%8C%87%E7%8E%8B%E6%AF%85%E7%A7%B0-%E9%9F%A9%E6%9C%9D%E4%B8%A4%E5%9B%BD-%E9%9F%A9%E5%9B%BD%E5%AE%B6%E5%AE%89%E4%BF%9D%E5%AE%A4%E9%95%BF%E9%AD%8F%E5%9C%A3%E6%B4%9B-%E4%BB%96%E6%B2%A1%E6%9C%89%E8%BF%99%E6%A0%B7%E8%AF%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788446004000.webp","sourceId":"rfi"},{"id":1788444055000,"createdDate":"2026-09-03 14:00","name":"法国国际广播电台","title":"法学者：欧洲认为军事优势在于武器的精密性，中国则认为军事优势在于武器的数量！","content":"当中国正通过大规模生产和简单但有效的技术重新定义现代战争之际，而欧洲却仍然依附于精密性。“欧洲必须重新思考其优先事项才能保持竞争力”，欧洲地缘政治研究所所长塞巴斯蒂安·布索瓦斯周三（9月2日）投书《回声报》论坛如是警告。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260903-%E6%B3%95%E5%AD%A6%E8%80%85-%E6%AC%A7%E6%B4%B2%E8%AE%A4%E4%B8%BA%E5%86%9B%E4%BA%8B%E4%BC%98%E5%8A%BF%E5%9C%A8%E4%BA%8E%E6%AD%A6%E5%99%A8%E7%9A%84%E7%B2%BE%E5%AF%86%E6%80%A7%EF%BC%8C%E4%B8%AD%E5%9B%BD%E5%88%99%E8%AE%A4%E4%B8%BA%E5%86%9B%E4%BA%8B%E4%BC%98%E5%8A%BF%E5%9C%A8%E4%BA%8E%E6%AD%A6%E5%99%A8%E7%9A%84%E6%95%B0%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788444055000.webp","sourceId":"rfi"},{"id":1788442277000,"createdDate":"2026-09-03 13:31","name":"法国国际广播电台","title":"加拿大中国留学生称收取联系人酬劳在机场拍照 在美被捕、被指作虚假陈述","content":"一名在加拿大安大略省一所大学留学的中国留学生因涉嫌应某人——其以为是中国政府官员——的要求在两座机场拍照而在美国被捕。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E4%B8%AD%E5%9B%BD%E7%95%99%E5%AD%A6%E7%94%9F%E7%A7%B0%E6%94%B6%E5%8F%96%E8%81%94%E7%B3%BB%E4%BA%BA%E9%85%AC%E5%8A%B3%E5%9C%A8%E6%9C%BA%E5%9C%BA%E6%8B%8D%E7%85%A7-%E5%9C%A8%E7%BE%8E%E8%A2%AB%E6%8D%95%E8%A2%AB%E8%A2%AB%E6%8C%87%E4%BD%9C%E8%99%9A%E5%81%87%E9%99%88%E8%BF%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788442277000.webp","sourceId":"rfi"},{"id":1788440402000,"createdDate":"2026-09-03 13:00","name":"法国国际广播电台","title":"太平洋岛国论坛峰会凸显大国区域竞争","content":"第55届太平洋岛国论坛的18个成员国和地区于本周一开始在帕劳召开的年度峰会，周四进入尾声，今年的峰会因几位领导人的缺席以及中国对台湾外交部长出席的抗议而蒙上阴影。与此同时，通过该峰会浮现出来的大国区域竞争日趋明显。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260903-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B3%B0%E4%BC%9A%E5%87%B8%E6%98%BE%E5%A4%A7%E5%9B%BD%E5%8C%BA%E5%9F%9F%E7%AB%9E%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788440402000.webp","sourceId":"rfi"},{"id":1788479186000,"createdDate":"2026-09-03 23:46","name":"法国国际广播电台","title":"不管官方统计怎么说，中国的就业问题是实实在在的","content":"中国的失业问题是法国世界报一篇文章的主题。该报指出，中国当局使用了多种方法来掩盖真实的失业率，尤其是年轻人的失业率。这样做是为了避免引发社会不满。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260903-%E4%B8%8D%E7%AE%A1%E5%AE%98%E6%96%B9%E7%BB%9F%E8%AE%A1%E6%80%8E%E4%B9%88%E8%AF%B4%EF%BC%8C%E4%B8%AD%E5%9B%BD%E7%9A%84%E5%B0%B1%E4%B8%9A%E9%97%AE%E9%A2%98%E6%98%AF%E5%AE%9E%E5%AE%9E%E5%9C%A8%E5%9C%A8%E7%9A%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788479186000.webp","sourceId":"rfi"},{"id":1788472456000,"createdDate":"2026-09-03 21:54","name":"法国国际广播电台","title":"俄罗斯：一名人道工作者因批评俄军被起诉","content":"在俄罗斯的一名人道工作者因批评军队被起诉，周四她被俄罗斯一家法院置于司法监管之下。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260903-%E4%BF%84%E7%BD%97%E6%96%AF-%E4%B8%80%E5%90%8D%E4%BA%BA%E9%81%93%E5%B7%A5%E4%BD%9C%E8%80%85%E5%9B%A0%E6%89%B9%E8%AF%84%E4%BF%84%E5%86%9B%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788472456000.webp","sourceId":"rfi"},{"id":1788469418000,"createdDate":"2026-09-03 21:03","name":"法国国际广播电台","title":"路透社：尼泊尔水电工人讲述从隧道逃生的噩梦","content":"中尼边境上周爆发洪灾与泥石流，导致尼泊尔近千名水电项目工人被困隧道，上千人死亡。路透社采访到一个水电工人讲他从被困隧道逃生的经过。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260903-%E8%B7%AF%E9%80%8F%E7%A4%BE-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B0%B4%E7%94%B5%E5%B7%A5%E4%BA%BA%E4%BB%8E%E9%9A%A7%E9%81%93%E9%80%83%E7%94%9F%E7%9A%84%E5%99%A9%E6%A2%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788469418000.webp","sourceId":"rfi"},{"id":1788468607000,"createdDate":"2026-09-03 20:50","name":"法国国际广播电台","title":"美把劳尔·卡斯特罗的孙子列入经济制裁名单","content":"美国政府周四宣布，将古巴前领导人劳尔·卡斯特罗的孙子菲德尔·埃内斯托（FidelErnesto）列入经济制裁名单，这是其向这个共产主义岛国施压行动的一部分。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%BE%8E%E6%8A%8A%E5%8A%B3%E5%B0%94%C2%B7%E5%8D%A1%E6%96%AF%E7%89%B9%E7%BD%97%E7%9A%84%E5%AD%99%E5%AD%90%E5%88%97%E5%85%A5%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%E5%90%8D%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788468607000.webp","sourceId":"rfi"},{"id":1788468204000,"createdDate":"2026-09-03 20:43","name":"法国国际广播电台","title":"“反超快时尚法”：法方否认对中国存有任何歧视","content":"中国敦促法国当局停止实施“反超快时尚法”和征收额外附加费，并批评有关措施带有歧视性。法国当局从9月1日起，对快时尚商品征收额外附加费，以遏制希音和Temu在内的中国电商平台。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260903-%E5%8F%8D%E8%B6%85%E5%BF%AB%E6%97%B6%E5%B0%9A%E6%B3%95-%E6%B3%95%E6%96%B9%E5%90%A6%E8%AE%A4%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%AD%98%E6%9C%89%E4%BB%BB%E4%BD%95%E6%AD%A7%E8%A7%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788468204000.webp","sourceId":"rfi"},{"id":1788467971000,"createdDate":"2026-09-03 20:39","name":"法国国际广播电台","title":"教宗访法    将部署 15,000 名安保力量","content":"法国政府已宣布将部署高达15,000名的创纪录安保力量，以确保教宗良十四世（PopeLeoXIV）于2026年9月25日至28日访问法国期间的安全。安保人员包括警察、宪兵、移动部队以及执行法国本土反恐巡逻的“哨兵行动”（Sentinelle）军人。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E6%95%99%E5%AE%97%E8%AE%BF%E6%B3%95-%E5%B0%86%E9%83%A8%E7%BD%B2-15-000-%E5%90%8D%E5%AE%89%E4%BF%9D%E5%8A%9B%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467971000.webp","sourceId":"rfi"},{"id":1788467809000,"createdDate":"2026-09-03 20:36","name":"法国国际广播电台","title":"挪威：俄要求“立即释放”在北极扣押的船只","content":"俄罗斯周四要求“立即释放”前一天在北极被挪威法院下令扣押的俄罗斯船只。该船只的扣押是应乌克兰国有能源公司Naftogaz的要求进行的。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E6%8C%AA%E5%A8%81-%E4%BF%84%E8%A6%81%E6%B1%82-%E7%AB%8B%E5%8D%B3%E9%87%8A%E6%94%BE-%E5%9C%A8%E5%8C%97%E6%9E%81%E6%89%A3%E6%8A%BC%E7%9A%84%E8%88%B9%E5%8F%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467809000.webp","sourceId":"rfi"},{"id":1788467612000,"createdDate":"2026-09-03 20:33","name":"法国国际广播电台","title":"联合国呼吁伊朗撤回 \"反外国影响\"法案","content":"联合国授权调查伊朗人权状况的独立实况调查团周四谴责了一项法律草案，称该草案可能导致与外国实体联系的个人被监禁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260903-%E8%81%94%E5%90%88%E5%9B%BD%E5%91%BC%E5%90%81%E4%BC%8A%E6%9C%97%E6%92%A4%E5%9B%9E-%E5%8F%8D%E5%A4%96%E5%9B%BD%E5%BD%B1%E5%93%8D-%E6%B3%95%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467612000.webp","sourceId":"rfi"},{"id":1788467290000,"createdDate":"2026-09-03 20:28","name":"法国国际广播电台","title":"特朗普要对偏袒某些“种族”的私立学校征税","content":"美国政府周四宣布，计划对那些以促进多元化为名，采用偏袒特定种族的招生标准的私立学校和大学征税。特朗普公开威胁要取消哈佛大学等藤校的免税资格，将其视作“政治实体”进行征税，并冻结了部分联邦补助。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E5%AF%B9%E5%81%8F%E8%A2%92%E6%9F%90%E4%BA%9B-%E7%A7%8D%E6%97%8F-%E7%9A%84%E7%A7%81%E7%AB%8B%E5%AD%A6%E6%A0%A1%E5%BE%81%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467290000.webp","sourceId":"rfi"},{"id":1788467150000,"createdDate":"2026-09-03 20:25","name":"法国国际广播电台","title":"列支敦士登议会批准堕胎合法化     王储拥有否决权","content":"列支敦士登议会周三在瓦杜兹以可能的最微弱多数通过了一项公民倡议，拟将怀孕头三个月内的堕胎合法化。该措施在25票中以13票通过，此前议会进行了长时间辩论。不过，这项措施能否生效仍不确定，因为该国摄政王、王储阿洛伊斯拥有否决权，并已公开表示反对。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E5%88%97%E6%94%AF%E6%95%A6%E5%A3%AB%E7%99%BB%E8%AE%AE%E4%BC%9A%E6%89%B9%E5%87%86%E5%A0%95%E8%83%8E%E5%90%88%E6%B3%95%E5%8C%96-%E7%8E%8B%E5%82%A8%E6%8B%A5%E6%9C%89%E5%90%A6%E5%86%B3%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467150000.webp","sourceId":"rfi"},{"id":1788467136000,"createdDate":"2026-09-03 20:25","name":"法国国际广播电台","title":"杜斌和黄之锋的国度：异见者亲情的分量","content":"中国大陆人权摄影记者与自由作家杜斌今年8月28日被判刑前，请求回家见病危母亲最后一面却遭拒，其母随后病逝。而本周三，香港知名民主派活动人士黄之锋就涉及游说西方议员的勾结外国势力案表示“认罪”，也有出于照顾年迈双亲的考量。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260903-%E6%9D%9C%E6%96%8C%E5%92%8C%E9%BB%84%E4%B9%8B%E9%94%8B%E7%9A%84%E5%9B%BD%E5%BA%A6-%E5%BC%82%E8%A7%81%E8%80%85%E4%BA%B2%E6%83%85%E7%9A%84%E5%88%86%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788467136000.webp","sourceId":"rfi"},{"id":1788466803000,"createdDate":"2026-09-03 20:20","name":"法国国际广播电台","title":"尼日利亚非法盗油   毒气体泄漏至少37人遇难","content":"周四，在非洲最大的石油生产国尼日利亚南部，至少37人因吸入有毒石油烟雾而死亡。这些烟雾是在一次试图盗窃输油管道的事件中产生的。管道破坏和石油盗窃在尼日尔三角洲地区十分猖獗，造成了严重的环境污染。该地区事故频发，走私者刺破输油管道，窃取原油，并秘密提炼成燃料出售。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260903-%E5%B0%BC%E6%97%A5%E5%88%A9%E4%BA%9A%E9%9D%9E%E6%B3%95%E7%9B%97%E6%B2%B9-%E6%AF%92%E6%B0%94%E4%BD%93%E6%B3%84%E6%BC%8F%E8%87%B3%E5%B0%9137%E4%BA%BA%E9%81%87%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788466803000.webp","sourceId":"rfi"},{"id":1788466583000,"createdDate":"2026-09-03 20:16","name":"法国国际广播电台","title":"叙开始销毁阿萨德时代的化学武器","content":"叙利亚常驻联合国代表周四向安理会宣布，叙利亚已开始销毁与其前化学武器计划相关的材料。这一具有高度象征意义的举措，距离巴沙尔·阿萨德政权倒台已近两年。叙利亚常驻联合国代表易卜拉欣·奥拉比评论道：“这是我们摆脱旧政权以来首次开展销毁行动。”他称此举为“历史性时刻”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260903-%E5%8F%99%E5%BC%80%E5%A7%8B%E9%94%80%E6%AF%81%E9%98%BF%E8%90%A8%E5%BE%B7%E6%97%B6%E4%BB%A3%E7%9A%84%E5%8C%96%E5%AD%A6%E6%AD%A6%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788466583000.webp","sourceId":"rfi"},{"id":1788466239000,"createdDate":"2026-09-03 20:10","name":"法国国际广播电台","title":"《大声说出来》获文学奖","content":"《世界报》文学奖（PrixlittéraireduMonde）是秋季首批文学奖项之一，于周四颁给了法俄混血小说家波利娜·帕纳森科（PolinaPanassenko），获奖作品是《大声说出来》（Avoixhaute）。这部小说以斯大林统治下的秘密苏联为背景，讲述了一个家族的探寻故事。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E5%A4%A7%E5%A3%B0%E8%AF%B4%E5%87%BA%E6%9D%A5-%E8%8E%B7%E6%96%87%E5%AD%A6%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788466239000.webp","sourceId":"rfi"},{"id":1788465918000,"createdDate":"2026-09-03 20:05","name":"法国国际广播电台","title":"法首次展出1827年拍摄出现存的最早照片","content":"法国文化部周四宣布，为纪念摄影技术诞生两百周年，法国发明家约瑟夫·尼塞福尔·涅普斯（NicéphoreNiépce）拍摄的现存史上第一张照片将在法国首次展出。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E6%B3%95%E9%A6%96%E6%AC%A1%E5%B1%95%E5%87%BA1827%E5%B9%B4%E6%8B%8D%E6%91%84%E5%87%BA%E7%8E%B0%E5%AD%98%E7%9A%84%E6%9C%80%E6%97%A9%E7%85%A7%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788465918000.webp","sourceId":"rfi"},{"id":1788465650000,"createdDate":"2026-09-03 20:00","name":"法国国际广播电台","title":"大众监事会批准重组计划     额外裁员5万人","content":"大众汽车监事会9月3日“一致”批准了一项重组计划，规定五年内在全球范围内裁减约50,000个职位，这一数字是之前从2024年开始实施的计划的两倍，此后情况更加恶化。这一决定是在董事会主席委员会会议后宣布的，随后沃尔夫斯堡集团监督机构定于周五召开全体会议。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260903-%E5%A4%A7%E4%BC%97%E7%9B%91%E4%BA%8B%E4%BC%9A%E6%89%B9%E5%87%86%E9%87%8D%E7%BB%84%E8%AE%A1%E5%88%92-%E9%A2%9D%E5%A4%96%E8%A3%81%E5%91%985%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788465650000.webp","sourceId":"rfi"},{"id":1788461317000,"createdDate":"2026-09-03 18:48","name":"法国国际广播电台","title":"回应德国关闭俄罗斯之家 俄罗斯关闭歌德学院","content":"据德国广播电台报道：在莱比锡/哈雷机场发生无人机事件后，德国联邦政府于周二正式指控俄罗斯应对此事负责，并宣布关闭位于柏林和波恩的俄罗斯机构。对此，莫斯科作出回应，宣布关闭俄罗斯境内的歌德学院。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260903-%E5%9B%9E%E5%BA%94%E5%BE%B7%E5%9B%BD%E5%85%B3%E9%97%AD%E4%BF%84%E7%BD%97%E6%96%AF%E4%B9%8B%E5%AE%B6-%E4%BF%84%E7%BD%97%E6%96%AF%E5%85%B3%E9%97%AD%E6%AD%8C%E5%BE%B7%E5%AD%A6%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788461317000.webp","sourceId":"rfi"}]