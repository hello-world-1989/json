[{"id":1788439038000,"createdDate":"2026-09-03 12:37","name":"法国国际广播电台","title":"新西兰外长：中台议题紧张气氛在太平洋岛国论坛会场外显而易见 门外游说不妥","content":"新西兰外交部长彼得斯（WinstonPeters）表示，根据长期以来的既有规程，台湾在太平洋岛国论坛中享有观察员地位；明年由新西兰主办该论坛时，这一安排也不会改变。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260903-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%A4%96%E9%95%BF-%E4%B8%AD%E5%8F%B0%E8%AE%AE%E9%A2%98%E7%B4%A7%E5%BC%A0%E6%B0%94%E6%B0%9B%E5%9C%A8%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E4%BC%9A%E5%9C%BA%E5%A4%96%E6%98%BE%E8%80%8C%E6%98%93%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788439038000.webp","sourceId":"rfi"},{"id":1788435573000,"createdDate":"2026-09-03 11:39","name":"法国国际广播电台","title":"中使馆提醒赴俄留学若接到征兵类电话等及时与校方、使领馆联系","content":"中国驻俄罗斯大使馆周二发布有关“2026年中国公民赴（返）俄罗斯留学的相关提醒”的重要通知。其内容包括“外国公民在俄办理教育临时居留许可与兵役及服役领域的法律规定无关联。如接到‘征兵’类电话、短信、邮件等，请及时与校方、驻俄使（领）馆联系”的提醒。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260903-%E4%B8%AD%E4%BD%BF%E9%A6%86%E6%8F%90%E9%86%92%E8%B5%B4%E4%BF%84%E7%95%99%E5%AD%A6%E8%8B%A5%E6%8E%A5%E5%88%B0%E5%BE%81%E5%85%B5%E7%B1%BB%E7%94%B5%E8%AF%9D%E7%AD%89%E5%8F%8A%E6%97%B6%E4%B8%8E%E6%A0%A1%E6%96%B9-%E4%BD%BF%E9%A2%86%E9%A6%86%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788435573000.webp","sourceId":"rfi"},{"id":1788434298000,"createdDate":"2026-09-03 11:18","name":"法国国际广播电台","title":"香港高院驳回“612基金”五名信托人定罪上诉　信托人称将上诉终审法院","content":"香港已停运的“612人道支援基金”涉嫌违反《社团条例》一案最新进展。香港高等法院上诉庭今天（9月3日），驳回基金五名信托人的定罪上诉，维持原审裁决。五人表示，将一同向香港终审法院申请终极上诉。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260903-%E9%A6%99%E6%B8%AF%E9%AB%98%E9%99%A2%E9%A9%B3%E5%9B%9E-612%E5%9F%BA%E9%87%91-%E4%BA%94%E5%90%8D%E4%BF%A1%E6%89%98%E4%BA%BA%E5%AE%9A%E7%BD%AA%E4%B8%8A%E8%AF%89-%E4%BF%A1%E6%89%98%E4%BA%BA%E7%A7%B0%E5%B0%86%E4%B8%8A%E8%AF%89%E7%BB%88%E5%AE%A1%E6%B3%95%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788434298000.webp","sourceId":"rfi"},{"id":1788432970000,"createdDate":"2026-09-03 10:56","name":"法国国际广播电台","title":"地缘争端白热化 经济利益最大化","content":"9月初刚刚结束的G20财长会和上合组织峰会，向世界揭开了大国元首穿梭外交背后的政治与经济博弈序幕。东南亚观察意见认为，一个以“多极化”和“阵营对垒”为核心特征的新全球秩序正在加速确立，并以阵营化、碎片化的发展趋势取代先前由美国主导的单极全球秩序。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260903-%E5%9C%B0%E7%BC%98%E4%BA%89%E7%AB%AF%E7%99%BD%E7%83%AD%E5%8C%96-%E7%BB%8F%E6%B5%8E%E5%88%A9%E7%9B%8A%E6%9C%80%E5%A4%A7%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432970000.webp","sourceId":"rfi"},{"id":1788432510000,"createdDate":"2026-09-03 10:48","name":"法国国际广播电台","title":"欧洲如何才能“拍死”俄罗斯“这只咬人苍蝇”？传统亲美的东南亚正投向中国怀抱","content":"大家好，欢迎收听法国报纸摘要。作为基辅军事后勤枢纽的德国莱比锡机场8月初发生了针对货机的未遂袭击，令欧洲人陷入两难境地：一方面，俄罗斯否认参与其中；另一方面，俄罗斯却不断加大对乌克兰境内平民目标的打击力度。欧盟外交与安全政策高级代表卡拉斯周三直言，面对这个棘手的问题是“该怎么办？” 成为周四9月3日出刊的《解放报》与《费加罗报》头版共同关注的焦点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260903-%E6%AC%A7%E6%B4%B2%E5%A6%82%E4%BD%95%E6%89%8D%E8%83%BD-%E6%8B%8D%E6%AD%BB-%E4%BF%84%E7%BD%97%E6%96%AF-%E8%BF%99%E5%8F%AA%E5%92%AC%E4%BA%BA%E8%8B%8D%E8%9D%87-%E4%BC%A0%E7%BB%9F%E4%BA%B2%E7%BE%8E%E7%9A%84%E4%B8%9C%E5%8D%97%E4%BA%9A%E6%AD%A3%E6%8A%95%E5%90%91%E4%B8%AD%E5%9B%BD%E6%80%80%E6%8A%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432510000.webp","sourceId":"rfi"},{"id":1788432157000,"createdDate":"2026-09-03 10:42","name":"法国国际广播电台","title":"特朗普以打击生育旅游为名限制出生公民权政令遭法官叫停","content":"美国总统特朗普8月6日才推出的一项限制出生公民权的新政令，9月2日被马里兰州一名联邦法官叫停。特朗普这项政令原本意在打击外国人以旅游名义赴美生产，新生儿因此获得美国公民权的现象。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BB%A5%E6%89%93%E5%87%BB%E7%94%9F%E8%82%B2%E6%97%85%E6%B8%B8%E4%B8%BA%E5%90%8D%E9%99%90%E5%88%B6%E5%87%BA%E7%94%9F%E5%85%AC%E6%B0%91%E6%9D%83%E6%94%BF%E4%BB%A4%E9%81%AD%E6%B3%95%E5%AE%98%E5%8F%AB%E5%81%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432157000.webp","sourceId":"rfi"},{"id":1788432129000,"createdDate":"2026-09-03 10:42","name":"法国国际广播电台","title":"针对Shein等“超快时尚”产品经济处罚在法生效 北京：由此产生一切后果由法方承担","content":"针对Shein、Temu和AliExpress等中国大型电商平台销售的“超快时尚”产品，一项经济惩罚措施于周二（1日）在法国生效。这项措施规定，到2030年，每件商品最高将被处以19.50欧元的罚款，罚款上限为税前价格的50%。该措施是法国议会于6月下旬通过的一项旨在打击“快时尚”的法律的一部分；该法律还包含其他定于日后生效的措施。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260903-%E9%92%88%E5%AF%B9shein%E7%AD%89-%E8%B6%85%E5%BF%AB%E6%97%B6%E5%B0%9A-%E4%BA%A7%E5%93%81%E7%BB%8F%E6%B5%8E%E5%A4%84%E7%BD%9A%E5%9C%A8%E6%B3%95%E7%94%9F%E6%95%88-%E5%8C%97%E4%BA%AC-%E7%94%B1%E6%AD%A4%E4%BA%A7%E7%94%9F%E4%B8%80%E5%88%87%E5%90%8E%E6%9E%9C%E7%94%B1%E6%B3%95%E6%96%B9%E6%89%BF%E6%8B%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788432129000.webp","sourceId":"rfi"},{"id":1788429378000,"createdDate":"2026-09-03 09:56","name":"法国国际广播电台","title":"美驻华大使：美国呼吁立即释放艺术家高兟 他和家人已受尽苦难","content":"美国驻华大使庞德伟（DavidPerdue）周四通过社媒平台X表示，“艺术家高兟在遭到不公正的判刑之前已经在拘留所被关了两年。他和他的家人已经受尽了苦难。美国呼吁立即释放他”。庞德伟并转发了美国国务院负责民主、人权和劳工事务的助理国务卿巴恩斯（Riley M. Barnes）周三发表的呼吁立即释放高兟，并要求有关当局允许他的家人离开中国的贴文。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260903-%E7%BE%8E%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF-%E7%BE%8E%E5%9B%BD%E5%91%BC%E5%90%81%E7%AB%8B%E5%8D%B3%E9%87%8A%E6%94%BE%E8%89%BA%E6%9C%AF%E5%AE%B6%E9%AB%98%E5%85%9F-%E4%BB%96%E5%92%8C%E5%85%B6%E5%AE%B6%E4%BA%BA%E5%B7%B2%E5%8F%97%E5%B0%BD%E8%8B%A6%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788429378000.webp","sourceId":"rfi"},{"id":1788428290000,"createdDate":"2026-09-03 09:38","name":"法国国际广播电台","title":"美国对进口无人机及无人机零部件加征关税措施今起生效","content":"美国针对多种类型无人机及无人机零部件进口加征百分之百关税的措施2026年9月3日零时起，开始生效执行。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260903-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E8%BF%9B%E5%8F%A3%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%8F%8A%E6%97%A0%E4%BA%BA%E6%9C%BA%E9%9B%B6%E9%83%A8%E4%BB%B6%E5%8A%A0%E5%BE%81%E5%85%B3%E7%A8%8E%E6%8E%AA%E6%96%BD%E4%BB%8A%E8%B5%B7%E7%94%9F%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788428290000.webp","sourceId":"rfi"},{"id":1788427728000,"createdDate":"2026-09-03 09:28","name":"法国国际广播电台","title":"乌克兰警告国际民用航空组织使用俄罗斯领空存在的风险","content":"乌克兰已正式联系国际民用航空组织（ICAO），警告其使用俄罗斯领空存在的风险。基辅甚至要求该国际组织成员国禁止民用航班飞越俄罗斯领空。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260903-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%AD%A6%E5%91%8A%E5%9B%BD%E9%99%85%E6%B0%91%E7%94%A8%E8%88%AA%E7%A9%BA%E7%BB%84%E7%BB%87%E4%BD%BF%E7%94%A8%E4%BF%84%E7%BD%97%E6%96%AF%E9%A2%86%E7%A9%BA%E5%AD%98%E5%9C%A8%E7%9A%84%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788427728000.webp","sourceId":"rfi"},{"id":1788426915000,"createdDate":"2026-09-03 09:15","name":"法国国际广播电台","title":"光州双年展恢复台湾馆名称 中方策展团队撤展 韩国外交部：此事与政府对台立场无关","content":"中方策展团队决定撤回其在第十六届光州双年展上的展馆，以抗议“台湾馆”相关问题。周四，中方策展团队在光州河正雄美术馆举行新闻发布会，宣布：“我们一致决定撤展，以表达我们的强烈抗议”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260903-%E5%85%89%E5%B7%9E%E5%8F%8C%E5%B9%B4%E5%B1%95%E6%81%A2%E5%A4%8D%E5%8F%B0%E6%B9%BE%E9%A6%86%E5%90%8D%E7%A7%B0-%E4%B8%AD%E6%96%B9%E7%AD%96%E5%B1%95%E5%9B%A2%E9%98%9F%E6%92%A4%E5%B1%95-%E9%9F%A9%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8-%E6%AD%A4%E4%BA%8B%E4%B8%8E%E6%94%BF%E5%BA%9C%E5%AF%B9%E5%8F%B0%E7%AB%8B%E5%9C%BA%E6%97%A0%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788426915000.webp","sourceId":"rfi"},{"id":1788426304000,"createdDate":"2026-09-03 09:05","name":"法国国际广播电台","title":"港府成功收购九成九宏福苑火灾业权 有居民称被迫无奈 有卖楼者称续追责","content":"导致168人死亡的大埔宏福苑大火，不少居民要求原址重建，但随着香港政府拒绝公开根楼宇勘察报告丶扬言不排除立法强制收回业权等情况下，当局终於在限期前收到99.1%的业主签署「接受收购建议信件」，成为宏福苑最大业主，亦令一众原业主能否继续追责成为疑问。但不少出席极有可能是最後一次业主大会的居民均表示，出售业权是被迫和无奈，当中，在火灾中失去妻子的叶家驹表明，不会放弃追责，要讨回公道。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260903-%E6%B8%AF%E5%BA%9C%E6%88%90%E5%8A%9F%E6%94%B6%E8%B4%AD%E4%B9%9D%E6%88%90%E4%B9%9D%E5%AE%8F%E7%A6%8F%E8%8B%91%E7%81%AB%E7%81%BE%E4%B8%9A%E6%9D%83-%E6%9C%89%E5%B1%85%E6%B0%91%E7%A7%B0%E8%A2%AB%E8%BF%AB%E6%97%A0%E5%A5%88-%E6%9C%89%E5%8D%96%E6%A5%BC%E8%80%85%E7%A7%B0%E7%BB%AD%E8%BF%BD%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788426304000.webp","sourceId":"rfi"},{"id":1788420585000,"createdDate":"2026-09-03 07:29","name":"法国国际广播电台","title":"中友好议员联盟拟组织跨党派年轻议员访华","content":"据悉，由日本朝野各党议员组成的日中友好议员联盟，正在协调组织年轻议员代表团访华，目标是在9月内实现访问。日中友好议员联盟会长、自民党前干事长森山裕9月3日向记者透露了这一消息，目前议联正在与中国方面积极联系，以最后敲定行程与其他细节。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260903-%E4%B8%AD%E5%8F%8B%E5%A5%BD%E8%AE%AE%E5%91%98%E8%81%94%E7%9B%9F%E6%8B%9F%E7%BB%84%E7%BB%87%E8%B7%A8%E5%85%9A%E6%B4%BE%E5%B9%B4%E8%BD%BB%E8%AE%AE%E5%91%98%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/03/1788420585000.webp","sourceId":"rfi"}]