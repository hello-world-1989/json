[{"id":1788691601000,"createdDate":"2026-09-06 10:46","name":"法国国际广播电台","title":"继莫斯科之后 两位美国总统特使首次到访乌克兰","content":"美国特使威特科夫和库什纳于今天周日从波兰乘火车已经抵达基辅中央火车站，首次访问乌克兰，此前这两位美国特使与普京会晤并磋商俄乌停战。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260906-%E7%BB%A7%E8%8E%AB%E6%96%AF%E7%A7%91%E4%B9%8B%E5%90%8E-%E4%B8%A4%E4%BD%8D%E7%BE%8E%E5%9B%BD%E6%80%BB%E7%BB%9F%E7%89%B9%E4%BD%BF%E9%A6%96%E6%AC%A1%E5%88%B0%E8%AE%BF%E4%B9%8C%E5%85%8B%E5%85%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788691601000.webp","sourceId":"rfi"},{"id":1788685866000,"createdDate":"2026-09-06 09:11","name":"法国国际广播电台","title":"冯德莱恩访问格陵兰　欧盟强化北极伙伴关系","content":"欧盟委员会主席冯德莱恩周日（9月6日）将前往格陵兰首府努克，开启为期两天的访问。此行旨在重申欧盟对这一丹麦自治领土的支持，格陵兰正受到美国特朗普政府的觊觎。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9%E8%AE%BF%E9%97%AE%E6%A0%BC%E9%99%B5%E5%85%B0-%E6%AC%A7%E7%9B%9F%E5%BC%BA%E5%8C%96%E5%8C%97%E6%9E%81%E4%BC%99%E4%BC%B4%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788685866000.webp","sourceId":"rfi"},{"id":1788718033000,"createdDate":"2026-09-06 18:07","name":"法国国际广播电台","title":"油价再涨 美能源部长拒绝预测油价","content":"美国能源部长克里斯．莱特（ChrisWright）6日接受多个周日政论节目访问时，面对全国汽油平均价格升至每加仑4.15美元，以及美伊冲突持续升高的局面，拒绝明确预测油价走势，但表示，如果一定要猜测，汽油价格“更可能下跌，而不是上涨”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E6%B2%B9%E4%BB%B7%E5%86%8D%E6%B6%A8-%E7%BE%8E%E8%83%BD%E6%BA%90%E9%83%A8%E9%95%BF%E6%8B%92%E7%BB%9D%E9%A2%84%E6%B5%8B%E6%B2%B9%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788718033000.webp","sourceId":"rfi"},{"id":1788715010000,"createdDate":"2026-09-06 17:16","name":"法国国际广播电台","title":"德国萨克森-安哈尔特州选举 德国选择党取得历史性胜利","content":"法新社9月6日马格德堡消息，据公共广播电视机构的估算，德国极右翼政党选择党周日在萨克森-安哈尔特州选举中取得历史性胜利，并给保守派总理默茨以沉重打击，但该党仍需等待才能确定是否能在这个前东德联邦州执政。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E5%BE%B7%E5%9B%BD%E8%90%A8%E5%85%8B%E6%A3%AE-%E5%AE%89%E5%93%88%E5%B0%94%E7%89%B9%E5%B7%9E%E9%80%89%E4%B8%BE-%E5%BE%B7%E5%9B%BD%E9%80%89%E6%8B%A9%E5%85%9A%E5%8F%96%E5%BE%97%E5%8E%86%E5%8F%B2%E6%80%A7%E8%83%9C%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788715010000.webp","sourceId":"rfi"},{"id":1788713380000,"createdDate":"2026-09-06 16:49","name":"法国国际广播电台","title":"法国首座印度教BAPS寺庙开光典礼 数千印度教徒云集巴黎","content":"周日，数千名印度教徒在巴黎近郊庆祝由印度教斯瓦米纳拉扬派（BAPS）在法国建造的首座大型寺庙的开光典礼，该组织将其宣传为“印度文化和印度教的象征”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E6%B3%95%E5%9B%BD%E9%A6%96%E5%BA%A7%E5%8D%B0%E5%BA%A6%E6%95%99baps%E5%AF%BA%E5%BA%99%E5%BC%80%E5%85%89%E5%85%B8%E7%A4%BC-%E6%95%B0%E5%8D%83%E5%8D%B0%E5%BA%A6%E6%95%99%E5%BE%92%E4%BA%91%E9%9B%86%E5%B7%B4%E9%BB%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788713380000.webp","sourceId":"rfi"},{"id":1788710381000,"createdDate":"2026-09-06 15:59","name":"法国国际广播电台","title":"俄总统助理：举行有习近平参加的俄美中三方会谈“并非没有用”","content":"综合路透社、塔斯社9月6日消息，俄罗斯外交部副部长里亚布科夫表示，虽然中美俄三国首脑会晤迄今为止尚未得到践行，但“不能排除其可能”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E4%BF%84%E6%80%BB%E7%BB%9F%E5%8A%A9%E7%90%86-%E4%B8%BE%E8%A1%8C%E6%9C%89%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8F%82%E5%8A%A0%E7%9A%84%E4%BF%84%E7%BE%8E%E4%B8%AD%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88-%E5%B9%B6%E9%9D%9E%E6%B2%A1%E6%9C%89%E7%94%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788710381000.webp","sourceId":"rfi"},{"id":1788709798000,"createdDate":"2026-09-06 15:49","name":"法国国际广播电台","title":"印尼火山喷发导致八座机场关闭15万乘客受困","content":"阿纳克·克拉卡托火山于周六爆发，熔岩流涌出，爆炸声可传至700公里外，印尼8座机场被迫暂时关闭。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E5%8D%B0%E5%B0%BC%E7%81%AB%E5%B1%B1%E5%96%B7%E5%8F%91%E5%AF%BC%E8%87%B4%E5%85%AB%E5%BA%A7%E6%9C%BA%E5%9C%BA%E5%85%B3%E9%97%AD15%E4%B8%87%E4%B9%98%E5%AE%A2%E5%8F%97%E5%9B%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788709798000.webp","sourceId":"rfi"},{"id":1788708073000,"createdDate":"2026-09-06 15:21","name":"法国国际广播电台","title":"中国西藏、尼泊尔洪灾惨况传遍全球 但在中国境内却无法看到洪灾冲击画面？","content":"尼泊尔与中国西藏交界的喜马拉雅山区在8月26日发生暴洪与土石流，大规模暴洪和土石流淹没房屋、数百人奔逃保命等的监视器画面迅速在各国疯传，但许多家国际媒体却称中国政府全面防堵未经官方批准的灾情叙事。为何中国官方对洪灾画面也要审查？另外，中尼洪灾甚至意外引发皇马辱华争议，究竟中国网友怎么说？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260906-%E4%B8%AD%E5%9B%BD%E8%A5%BF%E8%97%8F-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE%E6%83%A8%E5%86%B5%E4%BC%A0%E9%81%8D%E5%85%A8%E7%90%83-%E4%BD%86%E5%9C%A8%E4%B8%AD%E5%9B%BD%E5%A2%83%E5%86%85%E5%8D%B4%E6%97%A0%E6%B3%95%E7%9C%8B%E5%88%B0%E6%B4%AA%E7%81%BE%E5%86%B2%E5%87%BB%E7%94%BB%E9%9D%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788708073000.webp","sourceId":"rfi"},{"id":1788705876000,"createdDate":"2026-09-06 14:44","name":"法国国际广播电台","title":"路透：在西藏失踪的朝圣者的家属要求中国提供更多信息","content":"一些失踪者的家属称，中国方面对相关信息实施了封锁，加剧了他们的痛苦。一些外交官表示，中国方面尚未提出提供其陆路口岸一侧的视频资料，包括人脸识别图像。而这些资料本可与遇难者家属分享或用于确认遇难者身份。中国表示已向23国使馆通报了情况。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E8%B7%AF%E9%80%8F-%E5%9C%A8%E8%A5%BF%E8%97%8F%E5%A4%B1%E8%B8%AA%E7%9A%84%E6%9C%9D%E5%9C%A3%E8%80%85%E7%9A%84%E5%AE%B6%E5%B1%9E%E8%A6%81%E6%B1%82%E4%B8%AD%E5%9B%BD%E6%8F%90%E4%BE%9B%E6%9B%B4%E5%A4%9A%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788705876000.webp","sourceId":"rfi"},{"id":1788699739000,"createdDate":"2026-09-06 13:02","name":"法国国际广播电台","title":"世界报访谈：“中国不会取代美国成为世界头号强国”","content":"周日《世界报》刊登一篇题为《“中国不会取代美国成为世界头号强国”》的访谈，采访华裔加拿大研究员、目前任职于美国斯坦福大学胡佛研究所的王丹。王丹是近年来研究中国经济、科技和产业政策颇具影响力的学者。本次节目我们就介绍这篇访谈的主要内容。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260906-%E4%B8%96%E7%95%8C%E6%8A%A5%E8%AE%BF%E8%B0%88-%E4%B8%AD%E5%9B%BD%E4%B8%8D%E4%BC%9A%E5%8F%96%E4%BB%A3%E7%BE%8E%E5%9B%BD%E6%88%90%E4%B8%BA%E4%B8%96%E7%95%8C%E5%A4%B4%E5%8F%B7%E5%BC%BA%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788699739000.webp","sourceId":"rfi"},{"id":1788698996000,"createdDate":"2026-09-06 12:49","name":"法国国际广播电台","title":"中国公布西藏洪灾遇难人数升至43人失踪519人 外媒不得自由进入西藏","content":"法新社9月6日引述中国官媒周日宣布，8月底发生在中国与尼泊尔边境喜马拉雅山脉的毁灭性洪灾，中国一侧的死亡人数已从31人上升至43人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%B8%83%E8%A5%BF%E8%97%8F%E6%B4%AA%E7%81%BE%E9%81%87%E9%9A%BE%E4%BA%BA%E6%95%B0%E5%8D%87%E8%87%B343%E4%BA%BA%E5%A4%B1%E8%B8%AA519%E4%BA%BA-%E5%A4%96%E5%AA%92%E4%B8%8D%E5%BE%97%E8%87%AA%E7%94%B1%E8%BF%9B%E5%85%A5%E8%A5%BF%E8%97%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788698996000.webp","sourceId":"rfi"},{"id":1788698202000,"createdDate":"2026-09-06 12:36","name":"法国国际广播电台","title":"日本首相等强烈要求俄罗斯撤除毁损象征日本的菊花纹章的铜像","content":"日本首相高市早苗9月5日在个人社交媒体X上用日语和俄语发文，就俄罗斯远东地区设置了一座描绘苏联士兵破坏刻有菊花纹章标石的雕像一事表示，这是“涉及日本国民感情的问题”，并透露“日本政府已强烈要求俄方撤除该雕像”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E7%AD%89%E5%BC%BA%E7%83%88%E8%A6%81%E6%B1%82%E4%BF%84%E7%BD%97%E6%96%AF%E6%92%A4%E9%99%A4%E6%AF%81%E6%8D%9F%E8%B1%A1%E5%BE%81%E6%97%A5%E6%9C%AC%E7%9A%84%E8%8F%8A%E8%8A%B1%E7%BA%B9%E7%AB%A0%E7%9A%84%E9%93%9C%E5%83%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788698202000.webp","sourceId":"rfi"},{"id":1788696935000,"createdDate":"2026-09-06 12:15","name":"法国国际广播电台","title":"德黑兰在美军袭三艘伊朗油轮后宣布袭击了一艘美国海军无人艇","content":"在美国周六对海湾地区三艘伊朗油轮发动打击后，伊朗革命卫队于周日凌晨宣称“袭击了一艘企图进入霍尔木兹海峡保护区的美军无人艇”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260906-%E5%BE%B7%E9%BB%91%E5%85%B0%E5%9C%A8%E7%BE%8E%E5%86%9B%E8%A2%AD%E4%B8%89%E8%89%98%E4%BC%8A%E6%9C%97%E6%B2%B9%E8%BD%AE%E5%90%8E%E5%AE%A3%E5%B8%83%E8%A2%AD%E5%87%BB%E4%BA%86%E4%B8%80%E8%89%98%E7%BE%8E%E5%9B%BD%E6%B5%B7%E5%86%9B%E6%97%A0%E4%BA%BA%E8%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788696935000.webp","sourceId":"rfi"},{"id":1788736717000,"createdDate":"2026-09-06 23:18","name":"法国国际广播电台","title":"法国摩洛哥双籍综合格斗手报捷","content":"拥有法国和摩洛哥双重国籍的综合格斗（MMA）选手SalahdineParnasse（中文可译作：萨拉赫丁·帕尔纳斯）于09月05日周六晚在位于法国首都巴黎第12区的[雅高体育馆]（AccorArenadeParis）旗开得胜，赢得了其在[终极格斗冠军赛]（UFC）中的首场对决。这是本台法广体育组（RFISports）2026年09月06号星期日更新的法文消息之一。这名现年28岁的摩洛哥裔法国选手在这场火爆的比赛中击倒（KO）此前位列轻量级选手排名前十的36岁新西兰职业选手丹·胡克（DanHooker）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260906-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E6%B3%95%E5%9B%BD%E6%91%A9%E6%B4%9B%E5%93%A5%E5%8F%8C%E7%B1%8D%E7%BB%BC%E5%90%88%E6%A0%BC%E6%96%97%E6%89%8B%E6%8A%A5%E6%8D%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788736717000.webp","sourceId":"rfi"},{"id":1788730090000,"createdDate":"2026-09-06 21:28","name":"法国国际广播电台","title":"中共党刊再谈经济问题 承认社会活力减弱不敢投资","content":"中共党刊“求是”最新一期文章再谈中国经济，坦言“一些微观主体的预期、信心和行为选择正在发生变化，部分领域活力有所减弱”，并指企业“倾向于持币观望，不敢扩大投资、不敢增加用工”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260906-%E4%B8%AD%E5%85%B1%E5%85%9A%E5%88%8A%E5%86%8D%E8%B0%88%E7%BB%8F%E6%B5%8E%E9%97%AE%E9%A2%98-%E6%89%BF%E8%AE%A4%E7%A4%BE%E4%BC%9A%E6%B4%BB%E5%8A%9B%E5%87%8F%E5%BC%B1%E4%B8%8D%E6%95%A2%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788730090000.webp","sourceId":"rfi"},{"id":1788729802000,"createdDate":"2026-09-06 21:23","name":"法国国际广播电台","title":"伊朗拟在霍尔木兹海峡附近划设“禁区” 警告将加大对美反击","content":"美伊双方近日在具有战略意义的霍尔木兹海峡等海域展开新一轮相互攻击后，伊朗周日（9月6日）威胁将以“更猛烈”的方式回应美国，并宣布准备在海峡附近划设一个新的“禁区”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260906-%E4%BC%8A%E6%9C%97%E6%8B%9F%E5%9C%A8%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E9%99%84%E8%BF%91%E5%88%92%E8%AE%BE-%E7%A6%81%E5%8C%BA-%E8%AD%A6%E5%91%8A%E5%B0%86%E5%8A%A0%E5%A4%A7%E5%AF%B9%E7%BE%8E%E5%8F%8D%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788729802000.webp","sourceId":"rfi"},{"id":1788729627000,"createdDate":"2026-09-06 21:20","name":"法国国际广播电台","title":"美国再推俄乌停战方案 乌方称会谈更具成效但仍忧战火延续","content":"美国总统特朗普派往莫斯科及基辅的特使周日（9月6日）提出旨在结束俄乌战争的新方案。乌克兰总统府称，这些建议较以往“更为有效”。乌克兰总统泽连斯基担心，由于俄罗斯总统普京不愿与他直接谈判，战事可能延续至今年冬季。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260906-%E7%BE%8E%E5%9B%BD%E5%86%8D%E6%8E%A8%E4%BF%84%E4%B9%8C%E5%81%9C%E6%88%98%E6%96%B9%E6%A1%88-%E4%B9%8C%E6%96%B9%E7%A7%B0%E4%BC%9A%E8%B0%88%E6%9B%B4%E5%85%B7%E6%88%90%E6%95%88%E4%BD%86%E4%BB%8D%E5%BF%A7%E6%88%98%E7%81%AB%E5%BB%B6%E7%BB%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788729627000.webp","sourceId":"rfi"},{"id":1788729370000,"createdDate":"2026-09-06 21:16","name":"法国国际广播电台","title":"德国极右翼萨安州历史性大胜 距绝对多数仅数席引发各界震动","content":"德国极右翼政党周日(9月6日）在萨克森-安哈尔特州取得历史性选举胜利，使保守派总理默茨遭遇重挫。德国选择党能否执掌这个位于前民主德国地区的州，目前仍有待确定，但反移民、亲俄并支持美国总统特朗普的德国选择党（AfD），已在2025年联邦议院选举中跃升为德国最大反对党。此次选举投票率，据ZDF估算，高达到78%，比2021年高出18个百分点。法国极左翼政党“不屈法国”总统候选人梅朗雄称，这一结果是“欧洲中间派政策盲目所酿成的灾难”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260906-%E5%BE%B7%E5%9B%BD%E6%9E%81%E5%8F%B3%E7%BF%BC%E8%90%A8%E5%AE%89%E5%B7%9E%E5%8E%86%E5%8F%B2%E6%80%A7%E5%A4%A7%E8%83%9C-%E8%B7%9D%E7%BB%9D%E5%AF%B9%E5%A4%9A%E6%95%B0%E4%BB%85%E6%95%B0%E5%B8%AD%E5%BC%95%E5%8F%91%E5%90%84%E7%95%8C%E9%9C%87%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788729370000.webp","sourceId":"rfi"},{"id":1788729240000,"createdDate":"2026-09-06 21:14","name":"法国国际广播电台","title":"美特使见普京后又见泽连斯基，俄乌止战最大困难依旧是领土问题","content":"综合乌克兰通讯社、路透社、美联社和塔斯社的报道，9月6日星期日，美国特使史蒂夫·维特科夫和贾里德·库什纳在基辅会见了乌克兰总统泽连斯基。二人此前已经多次以战争调解人的身份造访莫斯科，本次乘火车造访基辅，这是头一次。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260906-%E7%BE%8E%E7%89%B9%E4%BD%BF%E8%A7%81%E6%99%AE%E4%BA%AC%E5%90%8E%E5%8F%88%E8%A7%81%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%EF%BC%8C%E4%BF%84%E4%B9%8C%E6%AD%A2%E6%88%98%E6%9C%80%E5%A4%A7%E5%9B%B0%E9%9A%BE%E4%BE%9D%E6%97%A7%E6%98%AF%E9%A2%86%E5%9C%9F%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788729240000.webp","sourceId":"rfi"},{"id":1788723897000,"createdDate":"2026-09-06 19:44","name":"法国国际广播电台","title":"非洲:刚果(布)遭遇严重燃油短缺","content":"地处非洲中部、滨临大西洋的刚果共和国（laRépubliqueduCongo）遭遇严重燃油短缺。这是本台法广非洲组（RFIAfrique）今天2026年09月06号星期日刊出的最新法文实地报导（reportage）之一。在刚果（布）首都布拉柴维尔（Brazzaville）,当地的出租车司机们踊跃接受现场采访。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260906-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E5%B8%83-%E9%81%AD%E9%81%87%E4%B8%A5%E9%87%8D%E7%87%83%E6%B2%B9%E7%9F%AD%E7%BC%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/06/1788723897000.webp","sourceId":"rfi"}]