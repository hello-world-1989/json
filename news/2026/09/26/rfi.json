[{"id":1790426069000,"createdDate":"2026-09-26 12:34","name":"法国国际广播电台","title":"习近平尊重特朗普将“人工智能”改名为“超级智能” 双方就该智能开通“沟通渠道”","content":"中国国家主席习近平周五结束对美国的国事访问。被特朗普改名为“超级智能”的人工智能问题，是习近平此次访美期间双方主要讨论的议题之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260926-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%B0%8A%E9%87%8D%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%86-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD-%E6%94%B9%E5%90%8D%E4%B8%BA-%E8%B6%85%E7%BA%A7%E6%99%BA%E8%83%BD-%E5%8F%8C%E6%96%B9%E5%B0%B1%E8%AF%A5%E6%99%BA%E8%83%BD%E5%BC%80%E9%80%9A-%E6%B2%9F%E9%80%9A%E6%B8%A0%E9%81%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790426069000.webp","sourceId":"rfi"},{"id":1790425056000,"createdDate":"2026-09-26 12:17","name":"法国国际广播电台","title":"教皇良十四世巴黎协和广场超大型露天弥撒, 预计60万人参加","content":"日前到访法国的天主教教皇良十四世26日将在巴黎市中心的协和广场上主持大型露天弥撒。预计会有60万人到场聆听。在此之前，良十四在26日上午走访巴黎一个致力于帮助移民群体的教区协会团体，与那里接待的背井离乡者见面。他在讲话中强调要让不同人群彼此看见和在尊严与和平中共处的重要性。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260926-%E6%95%99%E7%9A%87%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%B7%B4%E9%BB%8E%E5%8D%8F%E5%92%8C%E5%B9%BF%E5%9C%BA%E8%B6%85%E5%A4%A7%E5%9E%8B%E9%9C%B2%E5%A4%A9%E5%BC%A5%E6%92%92-%E9%A2%84%E8%AE%A160%E4%B8%87%E4%BA%BA%E5%8F%82%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790425056000.webp","sourceId":"rfi"},{"id":1790422579000,"createdDate":"2026-09-26 11:36","name":"法国国际广播电台","title":"中国和美国如同“罐子里的蝎子” 人工智能正在搅动“罐子”迫使二者合作？","content":"大家好，欢迎收听法国报纸摘要。教宗良十四世配上“欢腾与虔诚”标题的照片登上了周六9月26日《费加罗报》的首页，照片中他面带微笑，从“ 教宗座驾 ”上向人群挥手致意，该报写道：“聚集在巴黎街头的人群，以及在法兰西体育场参加祈祷守夜活动的8万名年轻人，都为教宗献上令人难忘的欢迎。 ”与此同时《回声报》关注了美国和中国正在加强人工智能领域的合作。双方已启动前所未有的对话，以降低风险并提高透明度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260926-%E4%B8%AD%E5%9B%BD%E5%92%8C%E7%BE%8E%E5%9B%BD%E5%A6%82%E5%90%8C-%E7%BD%90%E5%AD%90%E9%87%8C%E7%9A%84%E8%9D%8E%E5%AD%90-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%AD%A3%E5%9C%A8%E6%90%85%E5%8A%A8-%E7%BD%90%E5%AD%90-%E8%BF%AB%E4%BD%BF%E4%BA%8C%E8%80%85%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790422579000.webp","sourceId":"rfi"},{"id":1790421352000,"createdDate":"2026-09-26 11:15","name":"法国国际广播电台","title":"中国#MeToo推手黄雪琴刑满出狱 中国女权运动因官方审查大幅退缩转向地下化","content":"中国「#MeToo」运动的领军人物记者黄雪琴在9月18日完成她五年的刑期。黄雪琴因揭露媒体产业内性别暴力问题的严重程度，遭中国官方依煽动颠覆国家政权判刑。如今服刑完毕已获释，据黄雪琴友人透露，她至今仍下落不明。中国女权运动空间被官方审查大幅退缩，只能从昔日的公开倡议转向地下化。中共官方言论封锁导致甚至出现像「女权禁词库」等的现象。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260926-%E4%B8%AD%E5%9B%BD-metoo%E6%8E%A8%E6%89%8B%E9%BB%84%E9%9B%AA%E7%90%B4%E5%88%91%E6%BB%A1%E5%87%BA%E7%8B%B1-%E4%B8%AD%E5%9B%BD%E5%A5%B3%E6%9D%83%E8%BF%90%E5%8A%A8%E5%9B%A0%E5%AE%98%E6%96%B9%E5%AE%A1%E6%9F%A5%E5%A4%A7%E5%B9%85%E9%80%80%E7%BC%A9%E8%BD%AC%E5%90%91%E5%9C%B0%E4%B8%8B%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790421352000.webp","sourceId":"rfi"},{"id":1790411984000,"createdDate":"2026-09-26 08:39","name":"法国国际广播电台","title":"针对特朗普称中国是“盟国” 高市首相谈日美关系","content":"围绕在中美首脑会谈中，美国总统特朗普称中国是“第二次世界大战中的盟国”一事，日本首相高市早苗正在协调尽快与特朗普通电话，直接听取有关会谈内容的传达。25日，高市首相强调了“日美是以牢固纽带紧密相连的盟国”这一认识。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260926-%E9%92%88%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%AD%E5%9B%BD%E6%98%AF-%E7%9B%9F%E5%9B%BD-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E8%B0%88%E6%97%A5%E7%BE%8E%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790411984000.webp","sourceId":"rfi"},{"id":1790409296000,"createdDate":"2026-09-26 07:54","name":"法国国际广播电台","title":"特习会后，台湾指出“武装台湾是美国的重要利益所在”","content":"路透社台北报道称，一名台湾高级外交官周六（9月26日）在中美两国领导人峰会结束后表示，美国向台湾提供武器，以维护其自由并向全球供应半导体，符合美国的国家利益。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260926-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%90%8E%EF%BC%8C%E5%8F%B0%E6%B9%BE%E6%8C%87%E5%87%BA-%E6%AD%A6%E8%A3%85%E5%8F%B0%E6%B9%BE%E6%98%AF%E7%BE%8E%E5%9B%BD%E7%9A%84%E9%87%8D%E8%A6%81%E5%88%A9%E7%9B%8A%E6%89%80%E5%9C%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790409296000.webp","sourceId":"rfi"},{"id":1790445409000,"createdDate":"2026-09-26 17:56","name":"法国国际广播电台","title":"曼谷洪灾：运河决堤、道路被淹、100万个沙袋 、学校避难所","content":"泰国首都曼谷遭遇连续48小时的暴雨袭击，导致民宅、商铺和道路被淹。当局于周六宣布全市所有50个行政区进入自然灾害状态。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260926-%E6%9B%BC%E8%B0%B7%E6%B4%AA%E7%81%BE-%E8%BF%90%E6%B2%B3%E5%86%B3%E5%A0%A4-%E9%81%93%E8%B7%AF%E8%A2%AB%E6%B7%B9-100%E4%B8%87%E4%B8%AA%E6%B2%99%E8%A2%8B-%E5%AD%A6%E6%A0%A1%E9%81%BF%E9%9A%BE%E6%89%80","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790445409000.webp","sourceId":"rfi"},{"id":1790442919000,"createdDate":"2026-09-26 17:15","name":"法国国际广播电台","title":"多米尼加共和国呼吁本国公民对俄罗斯招聘信息保持“警惕”","content":"多米尼加共和国周五警告本国公民，警惕那些声称在俄罗斯提供工作机会、但最终可能导致他们被派往乌克兰参战的招聘信息。此前该国已收到关于此类潜在招募活动的投诉。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260926-%E5%A4%9A%E7%B1%B3%E5%B0%BC%E5%8A%A0%E5%85%B1%E5%92%8C%E5%9B%BD%E5%91%BC%E5%90%81%E6%9C%AC%E5%9B%BD%E5%85%AC%E6%B0%91%E5%AF%B9%E4%BF%84%E7%BD%97%E6%96%AF%E6%8B%9B%E8%81%98%E4%BF%A1%E6%81%AF%E4%BF%9D%E6%8C%81-%E8%AD%A6%E6%83%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790442919000.webp","sourceId":"rfi"},{"id":1790439221000,"createdDate":"2026-09-26 16:13","name":"法国国际广播电台","title":"乌克兰和俄罗斯互袭造成两国至少16人亡 普京暗示不想谈判","content":"法新社基辅9月26日电：据当地当局周六表示，俄罗斯和乌克兰的空袭已在两国造成至少16人死亡。近几个月来，莫斯科和基辅均加剧了攻击力度，导致平民伤亡人数不断增加。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260926-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%92%8C%E4%BF%84%E7%BD%97%E6%96%AF%E4%BA%92%E8%A2%AD%E9%80%A0%E6%88%90%E4%B8%A4%E5%9B%BD%E8%87%B3%E5%B0%9116%E4%BA%BA%E4%BA%A1-%E6%99%AE%E4%BA%AC%E6%9A%97%E7%A4%BA%E4%B8%8D%E6%83%B3%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790439221000.webp","sourceId":"rfi"},{"id":1790437103000,"createdDate":"2026-09-26 15:38","name":"法国国际广播电台","title":"胡塞武装对沙特发动新一轮袭击 土耳其和巴基斯坦按兵不动","content":"也门亲伊朗的胡塞武装分子周六再次对沙特阿拉伯发动袭击，目标锁定其首都利雅得和西南部一座大城市。联合国安理会强烈谴责胡塞武装对沙特的进攻...而与沙特签署共同防务协议的土耳其和巴基斯坦没有动作。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260926-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E5%AF%B9%E6%B2%99%E7%89%B9%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E8%A2%AD%E5%87%BB-%E5%9C%9F%E8%80%B3%E5%85%B6%E5%92%8C%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E6%8C%89%E5%85%B5%E4%B8%8D%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790437103000.webp","sourceId":"rfi"},{"id":1790433555000,"createdDate":"2026-09-26 14:39","name":"法国国际广播电台","title":"对比中美各自公布的成果清单看这次形式大于内容的特习会","content":"中国国家主席习近平时隔11年对美国的国事访问25日落下帷幕。特朗普政府为这次习近平来访安排了极高规格的接待，但尽管美国总统一再强调他与中国国家主席之间的友谊，并肯定这次中美高层会谈取得了诸多成果，中国官方媒体也肯定这次访问“圆满”结束，但从中美双方最近24小时公布的成果清单来看，此次礼仪声势不凡的高峰会谈，取得的具体成果十分有限。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260926-%E5%AF%B9%E6%AF%94%E4%B8%AD%E7%BE%8E%E5%90%84%E8%87%AA%E5%85%AC%E5%B8%83%E7%9A%84%E6%88%90%E6%9E%9C%E6%B8%85%E5%8D%95%E7%9C%8B%E8%BF%99%E6%AC%A1%E5%BD%A2%E5%BC%8F%E5%A4%A7%E4%BA%8E%E5%86%85%E5%AE%B9%E7%9A%84%E7%89%B9%E4%B9%A0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790433555000.webp","sourceId":"rfi"},{"id":1790430667000,"createdDate":"2026-09-26 13:51","name":"法国国际广播电台","title":"WSJ: 特朗普拒绝伊朗7天重开霍尔木兹海峡计划 正考虑11月中期选举后恢复空袭","content":"伊朗已向华盛顿提交了一项在七天内重新开放霍尔木兹海峡的计划，但在周六等待美国官方答复之际，《华尔街日报》说唐纳德·特朗普已拒绝了该计划。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260926-wsj-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%92%E7%BB%9D%E4%BC%8A%E6%9C%977%E5%A4%A9%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E8%AE%A1%E5%88%92-%E6%AD%A3%E8%80%83%E8%99%9111%E6%9C%88%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%90%8E%E6%81%A2%E5%A4%8D%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/26/1790430667000.webp","sourceId":"rfi"}]