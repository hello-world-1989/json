[{"id":1789734640000,"createdDate":"2026-09-18 12:30","name":"法国国际广播电台","title":"视频 欧洲空客天津第二条总装线交付首架飞机","content":"由欧洲空客在天津第二条总装线（FAL）组装的首架A320飞机在9月16日正式交付给中国东方航空，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E8%A7%86%E9%A2%91-%E6%AC%A7%E6%B4%B2%E5%9C%A8%E7%A9%BA%E5%AE%A2%E5%A4%A9%E6%B4%A5%E7%AC%AC%E4%BA%8C%E6%9D%A1%E6%80%BB%E8%A3%85%E7%BA%BF%E4%BA%A4%E4%BB%98%E9%A6%96%E6%9E%B6%E9%A3%9E%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789734640000.webp","sourceId":"rfi"},{"id":1789732227000,"createdDate":"2026-09-18 11:50","name":"法国国际广播电台","title":"美国考虑允许美制药企业与中国公司达成多数医药许可交易 两种情况除外","content":"据路透社援引三位知情人士报导称，美国正在制定针对在华投资制药企业的相关规则；它们很可能会保留这些企业达成大多数中国药物许可交易的能力。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260918-%E7%BE%8E%E5%9B%BD%E8%80%83%E8%99%91%E5%85%81%E8%AE%B8%E7%BE%8E%E5%88%B6%E8%8D%AF%E4%BC%81%E4%B8%9A%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%8F%B8%E8%BE%BE%E6%88%90%E5%A4%A7%E5%A4%9A%E6%95%B0%E5%8C%BB%E8%8D%AF%E8%AE%B8%E5%8F%AF%E4%BA%A4%E6%98%93-%E4%B8%A4%E7%A7%8D%E6%83%85%E5%86%B5%E9%99%A4%E5%A4%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789732227000.webp","sourceId":"rfi"},{"id":1789729306000,"createdDate":"2026-09-18 11:01","name":"法国国际广播电台","title":"中国独立记者黄雪琴五年刑满，人权组织担心她无法真正自由","content":"被中国当局以“煽动颠覆国家政权罪”判刑入狱五年的黄雪琴9月18日服刑期满，预计可以走出监狱。但她的朋友以及国际人权组织都对她是否能真正获得自由抱持怀疑。国际特赦组织连同无国界记者等60个国际人权团体近日发布联署公开信，呼吁中国政府保证她获释后仍能继续从事新闻工作和人权工作。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E4%B8%AD%E5%9B%BD%E7%8B%AC%E7%AB%8B%E8%AE%B0%E8%80%85%E9%BB%84%E9%9B%AA%E7%90%B4%E4%BA%94%E5%B9%B4%E5%88%91%E6%BB%A1%EF%BC%8C%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%8B%85%E5%BF%83%E5%A5%B9%E6%97%A0%E6%B3%95%E7%9C%9F%E6%AD%A3%E8%87%AA%E7%94%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789729306000.webp","sourceId":"rfi"},{"id":1789728300000,"createdDate":"2026-09-18 10:45","name":"法国国际广播电台","title":"俄罗斯国家杜马选举：战争阴影下的投票","content":"在距离莫斯科东南500公里的坦波夫市（Tambov），鼓励选民前往投票站的宣布牌随处可见。9月18日开始的投票，正值当地居民在8月突然被卷入战争之际，当地一个物流中心遭到乌克兰无人机的袭击，造成7人死亡、25人受伤。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E4%BF%84%E7%BD%97%E6%96%AF%E5%9B%BD%E5%AE%B6%E6%9D%9C%E9%A9%AC%E9%80%89%E4%B8%BE-%E6%88%98%E4%BA%89%E9%98%B4%E5%BD%B1%E4%B8%8B%E7%9A%84%E6%8A%95%E7%A5%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789728300000.webp","sourceId":"rfi"},{"id":1789727155000,"createdDate":"2026-09-18 10:25","name":"法国国际广播电台","title":"菲防长提出菲律宾需要一支远征型海军 菲军方：自然且必要的发展","content":"菲律宾武装部队周五表示，支持建立一支具备在本土海域以外执行任务能力的远征海军，并指作为一个群岛国家，这对该国的国防是必要的。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260918-%E8%8F%B2%E9%98%B2%E9%95%BF%E6%8F%90%E5%87%BA%E8%8F%B2%E5%BE%8B%E5%AE%BE%E9%9C%80%E8%A6%81%E4%B8%80%E6%94%AF%E8%BF%9C%E5%BE%81%E5%9E%8B%E6%B5%B7%E5%86%9B-%E8%8F%B2%E5%86%9B%E6%96%B9-%E8%87%AA%E7%84%B6%E4%B8%94%E5%BF%85%E8%A6%81%E7%9A%84%E5%8F%91%E5%B1%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789727155000.webp","sourceId":"rfi"},{"id":1789726932000,"createdDate":"2026-09-18 10:22","name":"法国国际广播电台","title":"2027预算削减540亿：养老金、福利、病假... 法国政府将如何收紧社会支出","content":"据法新社报道，法国总理塞巴斯蒂安·勒科尔努周四晚表示，2027年的预算将“积极削减540亿欧元的公共支出，因为国家太过依赖公共支出”。勒科尔努保证，不会只有退休人员被要求做出贡献。周五《回声报》相关分析认为，总理的意图昭然若揭。在经济增长停滞、债务负担飙升的背景下，为了遏制公共财政状况的恶化，总理被迫控制社会支出。他不仅计划像之前宣布的那样向退休人员征求经济贡献，还打算要求家庭缴纳费用，甚至重新审视备受争议的病假问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20260918-2027%E9%A2%84%E7%AE%97%E5%89%8A%E5%87%8F540%E4%BA%BF-%E5%85%BB%E8%80%81%E9%87%91-%E7%A6%8F%E5%88%A9-%E7%97%85%E5%81%87-%E6%B3%95%E5%9B%BD%E6%94%BF%E5%BA%9C%E5%B0%86%E5%A6%82%E4%BD%95%E6%94%B6%E7%B4%A7%E7%A4%BE%E4%BC%9A%E6%94%AF%E5%87%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789726932000.webp","sourceId":"rfi"},{"id":1789725860000,"createdDate":"2026-09-18 10:04","name":"法国国际广播电台","title":"九一八中国猛批“新型军国主义” 日驻华使馆呼吁在华日本人注意反日情绪","content":"在九一八事变发生95周年之际，勿忘九一八撞钟鸣警仪式当地时间18日上午在辽宁省沈阳市“九·一八”历史博物馆残历碑广场举行。中共中央政治局委员、全国人大常委会副委员长李鸿忠出席仪式并讲话。《人民日报》发表题为《病根不除，日本没有未来》的评论，而日本驻华大使馆发出《关于9月18日柳条湖事件之日的注意事项》，提请特别注意反日情绪升高的情况。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E4%B9%9D%E4%B8%80%E5%85%AB%E4%B8%AD%E5%9B%BD%E7%8C%9B%E6%89%B9-%E6%96%B0%E5%9E%8B%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89-%E6%97%A5%E9%A9%BB%E5%8D%8E%E4%BD%BF%E9%A6%86%E5%91%BC%E5%90%81%E5%9C%A8%E5%8D%8E%E6%97%A5%E6%9C%AC%E4%BA%BA%E6%B3%A8%E6%84%8F%E5%8F%8D%E6%97%A5%E6%83%85%E7%BB%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789725860000.webp","sourceId":"rfi"},{"id":1789725579000,"createdDate":"2026-09-18 09:59","name":"法国国际广播电台","title":"加拿大民意一面倒支持「脱美亲欧」 为何特朗普会动怒？","content":"加拿大争取成为欧盟「准成员国」，得到加拿大国民压倒性支持。虽然投向欧洲短期内难以改变加拿大经济依赖美国的局面，但美国总统特朗普仍然表现得十分愤怒，形容这是「敌对行为」，威胁会对欧盟大加关税。究竟为何特朗普有如此巨大反应呢？","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260918-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%B0%91%E6%84%8F%E4%B8%80%E9%9D%A2%E5%80%92%E6%94%AF%E6%8C%81-%E8%84%B1%E7%BE%8E%E4%BA%B2%E6%AC%A7-%E4%B8%BA%E4%BD%95%E7%89%B9%E6%9C%97%E6%99%AE%E4%BC%9A%E5%8A%A8%E6%80%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789725579000.webp","sourceId":"rfi"},{"id":1789725374000,"createdDate":"2026-09-18 09:56","name":"法国国际广播电台","title":"美国据报将推迟针对产能过剩问题的关税措施，直至特习会后","content":"据知情人士透露，针对贸易伙伴存在过剩产能的指控，美国预计将推迟宣布相关新关税措施，至少要等到下周中国国家主席习近平与美国总统特朗普（DonaldTrump）计划举行的峰会之后。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260918-%E7%BE%8E%E5%9B%BD%E6%8D%AE%E6%8A%A5%E5%B0%86%E6%8E%A8%E8%BF%9F%E9%92%88%E5%AF%B9%E4%BA%A7%E8%83%BD%E8%BF%87%E5%89%A9%E9%97%AE%E9%A2%98%E7%9A%84%E5%85%B3%E7%A8%8E%E6%8E%AA%E6%96%BD%EF%BC%8C%E7%9B%B4%E8%87%B3%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%90%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789725374000.webp","sourceId":"rfi"},{"id":1789723504000,"createdDate":"2026-09-18 09:25","name":"法国国际广播电台","title":"中国海警艇与菲政府船相撞 菲海警司令指示提供援助、确保船员安全","content":"周五，在距离巴拉望岛约54海里的海域，一艘中国海警艇撞击了一艘菲律宾农业部下属的渔业和水产资源局船只，该船当时正负责向菲律宾渔民运送燃油补贴。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E8%89%87%E4%B8%8E%E8%8F%B2%E6%94%BF%E5%BA%9C%E8%88%B9%E7%9B%B8%E6%92%9E-%E8%8F%B2%E6%B5%B7%E8%AD%A6%E5%8F%B8%E4%BB%A4%E6%8C%87%E7%A4%BA%E6%8F%90%E4%BE%9B%E6%8F%B4%E5%8A%A9-%E7%A1%AE%E4%BF%9D%E8%88%B9%E5%91%98%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789723504000.webp","sourceId":"rfi"},{"id":1789720643000,"createdDate":"2026-09-18 08:37","name":"法国国际广播电台","title":"高市早苗与特朗普拟周二在美会晤 旨协调对华政策等议题","content":"日美两国政府已开始协调让高市早苗首相与特朗普总统于当地时间9月22日举行会晤，届时正值本月晚些时候在纽约举行的联合国大会期间。此次会晤旨在协调日美对华政策，为9月24日特朗普与中国国家主席习近平的会晤做准备。多位日美外交消息人士周五透露了这一消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%9F%E5%91%A8%E4%BA%8C%E5%9C%A8%E7%BE%8E%E4%BC%9A%E6%99%A4-%E6%97%A8%E5%8D%8F%E8%B0%83%E5%AF%B9%E5%8D%8E%E6%94%BF%E7%AD%96%E7%AD%89%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789720643000.webp","sourceId":"rfi"},{"id":1789720133000,"createdDate":"2026-09-18 08:28","name":"法国国际广播电台","title":"港府推动人民币作政府支付货币引热议 分析：削港元信誉 将成两币并存格局","content":"香港第一个「五年规划」提出进一步推动人民币国际化发展，为此，政府将带头「积极推动人民币作为政府的支付货币」，建议随即引发热议，有学者甚至忧虑此举会引发国际社会对港元信誉与独特地位的关注，加速外资撤离。特首李家超今(18日)早未有正面回应市场忧虑，只透露，会先考虑容许投资者在港使用人民币认购债券，以及用人民币缴付部分政府合约的交易；强调会循序渐进地推进人民币国际化，不会操之过急。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260918-%E6%B8%AF%E5%BA%9C%E6%8E%A8%E5%8A%A8%E4%BA%BA%E6%B0%91%E5%B8%81%E4%BD%9C%E6%94%BF%E5%BA%9C%E6%94%AF%E4%BB%98%E8%B4%A7%E5%B8%81%E5%BC%95%E7%83%AD%E8%AE%AE-%E5%88%86%E6%9E%90-%E5%89%8A%E6%B8%AF%E5%85%83%E4%BF%A1%E8%AA%89-%E5%B0%86%E6%88%90%E4%B8%A4%E5%B8%81%E5%B9%B6%E5%AD%98%E6%A0%BC%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789720133000.webp","sourceId":"rfi"},{"id":1789712049000,"createdDate":"2026-09-18 06:14","name":"法国国际广播电台","title":"美议员提法案 吁制裁致黎智英和政治犯死亡的中港人员 港府谴责称是恫吓","content":"在中美元首会晤前，美国跨党派议员因应香港传媒大亨黎智英在狱中的健康情况，向国会提交法案，一旦通过，若出现黎智英或其他政治犯在狱中因医疗疏忽等原因而致死的个案，国务院应向相关中港官员实施制裁，并推动联合国调查死因。香港政府对此发出强烈谴责，认为这是恫吓维护国家安全的特区人员。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260918-%E7%BE%8E%E8%AE%AE%E5%91%98%E6%8F%90%E6%B3%95%E6%A1%88-%E5%90%81%E5%88%B6%E8%A3%81%E8%87%B4%E9%BB%8E%E6%99%BA%E8%8B%B1%E5%92%8C%E6%94%BF%E6%B2%BB%E7%8A%AF%E6%AD%BB%E4%BA%A1%E7%9A%84%E4%B8%AD%E6%B8%AF%E4%BA%BA%E5%91%98-%E6%B8%AF%E5%BA%9C%E8%B0%B4%E8%B4%A3%E7%A7%B0%E6%98%AF%E6%81%AB%E5%90%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789712049000.webp","sourceId":"rfi"},{"id":1789749881000,"createdDate":"2026-09-18 16:44","name":"法国国际广播电台","title":"一中国留学生在瑞士被判15年监禁","content":"一名中国留学生因涉嫌于2024年10月在苏黎世厄利孔(Oerlikon)当街持刀袭击3名5岁幼童，于本周在苏黎世地区法院受审，并于9月18日被判15年监禁。主审法官表示，被告“冷酷无情”地策划并实施了幼童袭击案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E4%B8%80%E4%B8%AD%E5%9B%BD%E7%95%99%E5%AD%A6%E7%94%9F%E5%9C%A8%E7%91%9E%E5%A3%AB%E8%A2%AB%E5%88%A415%E5%B9%B4%E7%9B%91%E7%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789749881000.webp","sourceId":"rfi"},{"id":1789745286000,"createdDate":"2026-09-18 15:28","name":"法国国际广播电台","title":"美官员：中伊及以色列团体利用中国开源AI模型发动未见的社媒影响力运动","content":"近几个月来，伊朗、中国以及以色列境内的团体以新颖的方式利用人工智能，在社交媒体上发起了前所未有的影响力运动，这加剧了美国官员和安全研究人员对人工智能这项快速发展技术的担忧。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E7%BE%8E%E5%AE%98%E5%91%98-%E4%B8%AD%E4%BC%8A%E5%8F%8A%E4%BB%A5%E8%89%B2%E5%88%97%E5%9B%A2%E4%BD%93%E5%88%A9%E7%94%A8%E4%B8%AD%E5%9B%BD%E5%BC%80%E6%BA%90ai%E6%A8%A1%E5%9E%8B%E5%8F%91%E5%8A%A8%E5%89%8D%E6%89%80%E6%9C%AA%E6%9C%89%E7%9A%84%E7%A4%BE%E5%AA%92%E5%BD%B1%E5%93%8D%E5%8A%9B%E8%BF%90%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789745286000.webp","sourceId":"rfi"},{"id":1789743760000,"createdDate":"2026-09-18 15:02","name":"法国国际广播电台","title":"普京政权启动立法选举：排除异己声音，重塑支持对乌战争舆论","content":"俄罗斯全面入侵乌克兰的战争尚没有任何结束甚至停火迹象之际，普京政权18日启动自2022年2月开战以来的首次全国选举，更新议会下院450个议员席位。尽管没有人怀疑普京控制的执政党统一俄罗斯党会再次获得议会下院多数席位，但这次持续三天的投票活动无论对于深陷乌克兰战争泥潭的普京政权，还是对于在日益严厉的镇压政策下难以立足的反对党，对于密切关注普京政权人心向背的国际观察人士来说，都自有一番重要意义。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260918-%E6%99%AE%E4%BA%AC%E6%94%BF%E6%9D%83%E5%90%AF%E5%8A%A8%E7%AB%8B%E6%B3%95%E9%80%89%E4%B8%BE-%E6%8E%92%E9%99%A4%E5%BC%82%E5%B7%B1%E5%A3%B0%E9%9F%B3%EF%BC%8C%E9%87%8D%E5%A1%91%E6%94%AF%E6%8C%81%E5%AF%B9%E4%B9%8C%E6%88%98%E4%BA%89%E8%88%86%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789743760000.webp","sourceId":"rfi"},{"id":1789743378000,"createdDate":"2026-09-18 14:56","name":"法国国际广播电台","title":"视频 应对波罗的海海底基础设施受威胁 芬兰准备","content":"芬兰安全部队本周在芬兰湾进行了登船和夺船演练，旨在应对针对波罗的海海底基础设施的威胁，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260918-%E8%A7%86%E9%A2%91-%E5%BA%94%E5%AF%B9%E6%B3%A2%E7%BD%97%E7%9A%84%E6%B5%B7%E6%B5%B7%E5%BA%95%E5%9F%BA%E7%A1%80%E8%AE%BE%E6%96%BD%E5%8F%97%E5%A8%81%E8%83%81-%E8%8A%AC%E5%85%B0%E5%87%86%E5%A4%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789743378000.webp","sourceId":"rfi"},{"id":1789741308000,"createdDate":"2026-09-18 14:21","name":"法国国际广播电台","title":"德副总理访大众总部：促欧盟就插电混动车及本地成分要求采取具体措施","content":"在造访深陷危机的大众汽车总部时，德国副总理兼财政部长克林拜尔（LarsKlingbeil）要求欧盟对中国汽车制造商征收更严厉的关税；与此同时，中国品牌正朝着2026年在欧洲大陆年销量突破百万辆的目标迈进。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260918-%E5%BE%B7%E5%89%AF%E6%80%BB%E7%90%86%E8%AE%BF%E5%A4%A7%E4%BC%97%E6%80%BB%E9%83%A8-%E4%BF%83%E6%AC%A7%E7%9B%9F%E5%B0%B1%E6%8F%92%E7%94%B5%E6%B7%B7%E5%8A%A8%E8%BD%A6%E5%8F%8A%E6%9C%AC%E5%9C%B0%E6%88%90%E5%88%86%E8%A6%81%E6%B1%82%E9%87%87%E5%8F%96%E5%85%B7%E4%BD%93%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789741308000.webp","sourceId":"rfi"},{"id":1789738241000,"createdDate":"2026-09-18 13:30","name":"法国国际广播电台","title":"法媒关注：11月15日起北京全面禁止无人机，私人用户纷纷开始低价求售","content":"从11月15日起，北京和周围300公里半径范围内的民众将无法再拥有无人机。据《回声报》上海通讯员周五（9月18日）发来报道说，在中国网络上，用户纷纷以低价出售无人机，并表达了他们的不解不满之情。这项禁令预计将给北京市带来巨大的经济损失。北京市政府为此将回收所有流通中的无人机，并提供最高390欧元的补偿。仅在北京地区，闲鱼平台上就有超过1万架无人机在售，其价格平均比上海同款无人机低400至600元人民币。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E6%B3%95%E5%AA%92%E5%85%B3%E6%B3%A8-11%E6%9C%8815%E6%97%A5%E8%B5%B7%E5%8C%97%E4%BA%AC%E5%85%A8%E9%9D%A2%E7%A6%81%E6%AD%A2%E6%97%A0%E4%BA%BA%E6%9C%BA%EF%BC%8C%E7%A7%81%E4%BA%BA%E7%94%A8%E6%88%B7%E7%BA%B7%E7%BA%B7%E5%BC%80%E5%A7%8B%E4%BD%8E%E4%BB%B7%E6%B1%82%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789738241000.webp","sourceId":"rfi"},{"id":1789737551000,"createdDate":"2026-09-18 13:19","name":"法国国际广播电台","title":"比亚迪、小米等公司高管或随习近平访美 黄仁勋、奥特曼等美高管将出席国宴","content":"据路透社援引三位知情人士报导称，华盛顿和北京方面正在敲定一份随同中国国家主席习近平即将访美行程的中国商界领袖名单；名单中可能包括那些在寻求更大市场准入的同时、正面临美国监管审查的中企。消息人士称，最终邀请函将在未来几天内发出。其中一位人士补充道，预计美国国务院将批准该代表团成员的赴美签证。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260918-%E6%AF%94%E4%BA%9A%E8%BF%AA-%E5%B0%8F%E7%B1%B3%E7%AD%89%E5%85%AC%E5%8F%B8%E9%AB%98%E7%AE%A1%E6%88%96%E9%9A%8F%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E-%E9%BB%84%E4%BB%81%E5%8B%8B-%E5%A5%A5%E7%89%B9%E6%9B%BC%E7%AD%89%E7%BE%8E%E9%AB%98%E7%AE%A1%E5%B0%86%E5%87%BA%E5%B8%AD%E5%9B%BD%E5%AE%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789737551000.webp","sourceId":"rfi"},{"id":1789732937000,"createdDate":"2026-09-18 12:02","name":"法国国际广播电台","title":"AI、台湾与贸易角力 特朗普与习近平会谈面临多重考验","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平预计9月24日在华盛顿举行会谈，人工智能（AI）、关税、稀土与半导体、台湾，以及伊朗与俄乌战事等议题，都可能成为两国领导人谈判桌上的重点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260918-ai-%E5%8F%B0%E6%B9%BE%E4%B8%8E%E8%B4%B8%E6%98%93%E8%A7%92%E5%8A%9B-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BC%9A%E8%B0%88%E9%9D%A2%E4%B8%B4%E5%A4%9A%E9%87%8D%E8%80%83%E9%AA%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789732937000.webp","sourceId":"rfi"},{"id":1789770177000,"createdDate":"2026-09-18 22:22","name":"法国国际广播电台","title":"怀来恒大“鬼城”，变成廉价避风港，住进一批特殊的居民","content":"距离北京130公里的地方，曾经有一座由恒大打造的“理想之城”。这座城市原本计划容纳数万名居民。如今，这里的许多建筑仍然没有完工。各种设施也被废弃了。不过，这里已经变成了一个廉价的避风港。住进来的主要是退休老人和离婚人士。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260918-%E6%80%80%E6%9D%A5%E6%81%92%E5%A4%A7-%E9%AC%BC%E5%9F%8E-%EF%BC%8C%E5%8F%98%E6%88%90%E5%BB%89%E4%BB%B7%E9%81%BF%E9%A3%8E%E6%B8%AF%EF%BC%8C%E4%BD%8F%E8%BF%9B%E4%B8%80%E6%89%B9%E7%89%B9%E6%AE%8A%E7%9A%84%E5%B1%85%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789770177000.webp","sourceId":"rfi"},{"id":1789767691000,"createdDate":"2026-09-18 21:41","name":"法国国际广播电台","title":"就俄罗斯接管法国企业，法国呼吁莫斯科“撤销”决定","content":"法国政府周五呼吁俄罗斯当局“撤销”接管多家法国企业子公司的决定。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E5%B0%B1%E4%BF%84%E7%BD%97%E6%96%AF%E6%8E%A5%E7%AE%A1%E6%B3%95%E5%9B%BD%E4%BC%81%E4%B8%9A%EF%BC%8C%E6%B3%95%E5%9B%BD%E5%91%BC%E5%90%81%E8%8E%AB%E6%96%AF%E7%A7%91-%E6%92%A4%E9%94%80-%E5%86%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789767691000.webp","sourceId":"rfi"},{"id":1789765363000,"createdDate":"2026-09-18 21:02","name":"法国国际广播电台","title":"向基辅运送武器   莫斯科召见英国驻基辅临时代办","content":"俄罗斯周五召见了英国驻乌克兰临时代办，抗议伦敦方面持续“增加向乌克兰交付无人机和其他武器系统”。俄罗斯外交部在一份声明中强调：“双方强调，英国​​在乌克兰问题上采取的极端对抗路线，显然旨在延长和加剧武装冲突，只会阻碍政治解决的前景。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E5%90%91%E5%9F%BA%E8%BE%85%E8%BF%90%E9%80%81%E6%AD%A6%E5%99%A8-%E8%8E%AB%E6%96%AF%E7%A7%91%E5%8F%AC%E8%A7%81%E8%8B%B1%E5%9B%BD%E9%A9%BB%E5%9F%BA%E8%BE%85%E4%B8%B4%E6%97%B6%E4%BB%A3%E5%8A%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789765363000.webp","sourceId":"rfi"},{"id":1789764990000,"createdDate":"2026-09-18 20:56","name":"法国国际广播电台","title":"特朗普宣布禁止 CNN、MSNOW 和 Politico 进入白宫采访","content":"特朗普在针对媒体的战争中迈出了新的一步，他于周五宣布，他将“立即”禁止电视频道CNN和MSNOW（前身为MSNBC）以及网络媒体Politico进入白宫。美国总统在他的真相社交网络上做出了这一史无前例的宣布，但其实施仍充满不确定性。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260918-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E7%A6%81%E6%AD%A2-cnn-msnow-%E5%92%8C-politico-%E8%BF%9B%E5%85%A5%E7%99%BD%E5%AE%AB%E9%87%87%E8%AE%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789764990000.webp","sourceId":"rfi"},{"id":1789764352000,"createdDate":"2026-09-18 20:45","name":"法国国际广播电台","title":"俄罗斯一核电站冷却塔被无人机击中","content":"国际原子能机构18日说，获悉俄罗斯库尔斯克核电站一个反应堆机组的冷却塔于17日被无人机击中。国际原子能机构在社交媒体上发文说，据称该反应堆机组事发时正在运行，其运行状态未受影响，也未发生火灾。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E4%BF%84%E7%BD%97%E6%96%AF%E4%B8%80%E6%A0%B8%E7%94%B5%E7%AB%99%E5%86%B7%E5%8D%B4%E5%A1%94%E8%A2%AB%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%87%BB%E4%B8%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789764352000.webp","sourceId":"rfi"},{"id":1789764174000,"createdDate":"2026-09-18 20:42","name":"法国国际广播电台","title":"法再度取消网红杜阿莱姆（Doualemn）强制离境令","content":"据法新社18日报道，巴黎行政法院推翻了此前因在社交媒体上“煽动暴力”而被定罪的阿尔及利亚网红杜阿莱姆（Doualemn）的“紧急”驱逐令，并撤销了吊销其居留许可的决定。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260918-%E6%B3%95%E5%86%8D%E5%BA%A6%E5%8F%96%E6%B6%88%E7%BD%91%E7%BA%A2%E6%9D%9C%E9%98%BF%E8%8E%B1%E5%A7%86-doualemn-%E5%BC%BA%E5%88%B6%E7%A6%BB%E5%A2%83%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789764174000.webp","sourceId":"rfi"},{"id":1789763890000,"createdDate":"2026-09-18 20:38","name":"法国国际广播电台","title":"齐达内公布法国队的首期大名单","content":"9月18日，法国队公布了参加2026/27赛季欧国联的球员名单，这也是齐达内接手德尚之后，法国队的首期大名单。齐达内要强调的一点是“姆巴佩是队长”，这是对德尚卸任后的一种延续。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260918-%E9%BD%90%E8%BE%BE%E5%86%85%E5%85%AC%E5%B8%83%E6%B3%95%E5%9B%BD%E9%98%9F%E7%9A%84%E9%A6%96%E6%9C%9F%E5%A4%A7%E5%90%8D%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789763890000.webp","sourceId":"rfi"},{"id":1789763654000,"createdDate":"2026-09-18 20:34","name":"法国国际广播电台","title":"美国人担任世界粮食计划署（WFP）署长","content":"联合国世界粮食计划署（WFP）周五发表声明宣布，美国商人卢克·林德伯格（LukeLindberg）被任命为该机构新任署长。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260918-%E7%BE%8E%E5%9B%BD%E4%BA%BA%E6%8B%85%E4%BB%BB%E4%B8%96%E7%95%8C%E7%B2%AE%E9%A3%9F%E8%AE%A1%E5%88%92%E7%BD%B2-wfp-%E7%BD%B2%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789763654000.webp","sourceId":"rfi"},{"id":1789762958000,"createdDate":"2026-09-18 20:22","name":"法国国际广播电台","title":"美国汽车业游说团体要特朗普封堵中国汽车在美国生产","content":"在下周与中国领导人习近平举行峰会前夕，美国本土汽车制造商及供应商于周五敦促总统特朗普，将中国的汽车生产拒之门外。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E7%BE%8E%E5%9B%BD%E6%B1%BD%E8%BD%A6%E4%B8%9A%E6%B8%B8%E8%AF%B4%E5%9B%A2%E4%BD%93%E8%A6%81%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%81%E5%A0%B5%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%9C%A8%E7%BE%8E%E5%9B%BD%E7%94%9F%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789762958000.webp","sourceId":"rfi"},{"id":1789762594000,"createdDate":"2026-09-18 20:16","name":"法国国际广播电台","title":"大众和奥迪在中国市场尤为受到冲击","content":"德国汽车巨头大众汽车周五警告称，由于中国市场环境严峻、子公司保时捷遭遇困境以及重组成本，其年度盈利将减少100亿欧元（约合114亿美元）。大众正推进全球汽车行业规模最大的裁员计划，并表示预计2026年的利润率仅为1%，低于此前4%至5.5%的预期。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260918-%E5%A4%A7%E4%BC%97%E5%92%8C%E5%A5%A5%E8%BF%AA%E5%9C%A8%E4%B8%AD%E5%9B%BD%E5%B8%82%E5%9C%BA%E5%B0%A4%E4%B8%BA%E5%8F%97%E5%88%B0%E5%86%B2%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789762594000.webp","sourceId":"rfi"},{"id":1789761896000,"createdDate":"2026-09-18 20:04","name":"法国国际广播电台","title":"美向冈比亚返还前总统贾梅挪用的250万美元","content":"美国司法部周五发表声明称，美国政府将从被罢黜总统叶海亚·贾梅（YahyaJammeh）及其妻子的房产出售所得中，向冈比亚返还近250万美元。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260918-%E7%BE%8E%E5%90%91%E5%86%88%E6%AF%94%E4%BA%9A%E8%BF%94%E8%BF%98%E5%89%8D%E6%80%BB%E7%BB%9F%E8%B4%BE%E6%A2%85%E6%8C%AA%E7%94%A8%E7%9A%84250%E4%B8%87%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789761896000.webp","sourceId":"rfi"},{"id":1789761661000,"createdDate":"2026-09-18 20:01","name":"法国国际广播电台","title":"德国政府宣布采取措施降低燃油价格","content":"德国《图片报》称，德国政府计划将汽油能源税每升下调0.14欧元（约合0.16美元），另据悉正制定与油价挂钩的汽油价格上限。而两天后，两场至关重要的地区选举即将举行。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260918-%E5%BE%B7%E5%9B%BD%E6%94%BF%E5%BA%9C%E5%AE%A3%E5%B8%83%E9%87%87%E5%8F%96%E6%8E%AA%E6%96%BD%E9%99%8D%E4%BD%8E%E7%87%83%E6%B2%B9%E4%BB%B7%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789761661000.webp","sourceId":"rfi"},{"id":1789760872000,"createdDate":"2026-09-18 19:47","name":"法国国际广播电台","title":"美媒：国会对F-35零件被转运至香港一事展开调查","content":"美国政治新闻网站《政客》（POLITICO）独家报导，一批原本从澳大利亚运往美国维修的F-35战机敏感零组件，今年夏季在横越太平洋途中被意外改道，最终运抵香港，引发美国国会及国防部门调查，也使外界担心中国可能取得F-35关键技术。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260918-%E7%BE%8E%E5%AA%92-%E5%9B%BD%E4%BC%9A%E5%AF%B9f-35%E9%9B%B6%E4%BB%B6%E8%A2%AB%E8%BD%AC%E8%BF%90%E8%87%B3%E9%A6%99%E6%B8%AF%E4%B8%80%E4%BA%8B%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789760872000.webp","sourceId":"rfi"},{"id":1789760212000,"createdDate":"2026-09-18 19:36","name":"法国国际广播电台","title":"美国再次拒绝向阿巴斯发放签证","content":"联合国秘书长古特雷斯的发言人周五表示，美国连续第二年拒绝向巴勒斯坦权利机构主席阿巴斯发放参加下周联合国大会的签证，对此他“深感遗憾”。斯特凡·杜哈里克补充道：“秘书长担心这一决定对巴勒斯坦国充分参与联合国工作的能力的影响”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260918-%E7%BE%8E%E5%9B%BD%E5%86%8D%E6%AC%A1%E6%8B%92%E7%BB%9D%E5%90%91%E9%98%BF%E5%B7%B4%E6%96%AF%E5%8F%91%E6%94%BE%E7%AD%BE%E8%AF%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/18/1789760212000.webp","sourceId":"rfi"}]