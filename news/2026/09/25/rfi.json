[{"id":1790341512000,"createdDate":"2026-09-25 13:05","name":"法国国际广播电台","title":"教宗良十四世历史性访法，将讨论安乐死、AI等议题","content":"今天法国来说是个“大日子”。71岁的教宗良十四世到访法国，行程为期四天。从很长时间以来，法国就严格坚持世俗主义原则，天主教会对法国社会伦理议题的影响力逐渐减弱，并且，此前法国天主教会因性侵丑闻而声誉受损 ，引发了公众的信任危机。教宗良十四世是近20年来首位正式访问巴黎的教宗，此前教宗方济各曾多次拒绝对巴黎进行访问。这一次，良希望能在法国传递自己的声音，据悉，他在来时的飞机上就宣称，此行的目的是“宣扬和平”。此外，他还希望促使人们深入思考人工智能的道德伦理问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260925-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%8E%86%E5%8F%B2%E6%80%A7%E8%AE%BF%E6%B3%95%EF%BC%8C%E5%B0%86%E8%AE%A8%E8%AE%BA%E5%AE%89%E4%B9%90%E6%AD%BB-ai%E7%AD%89%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790341512000.webp","sourceId":"rfi"},{"id":1790341222000,"createdDate":"2026-09-25 13:00","name":"法国国际广播电台","title":"埃塞俄比亚北部彻夜激战，通讯网中断","content":"法新社发自亚的斯亚贝巴消息，周四夜至周五凌晨，在激烈的交火中，埃塞俄比亚军队阻止了“提格雷”叛军进入埃塞俄比亚北部的阿巴拉市。该市与邻近的“阿法尔”地区接壤，近期该地区再度爆发战事。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260925-%E5%9F%83%E5%A1%9E%E4%BF%84%E6%AF%94%E4%BA%9A%E5%8C%97%E9%83%A8%E5%BD%BB%E5%A4%9C%E6%BF%80%E6%88%98%EF%BC%8C%E9%80%9A%E8%AE%AF%E7%BD%91%E4%B8%AD%E6%96%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790341222000.webp","sourceId":"rfi"},{"id":1790338180000,"createdDate":"2026-09-25 12:09","name":"法国国际广播电台","title":"习近平：特朗普“唯一尊重的外国元首”","content":"9月25日出刊的法国主流日刊集中大篇幅关注了教皇利奥十四世访问法国引发的轰动与思考。国际版面，多家报刊分析了习近平访美之旅。在本期法国报纸摘要节目中，我们为您选取这些与中国相关的话题做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260925-%E4%B9%A0%E8%BF%91%E5%B9%B3-%E7%89%B9%E6%9C%97%E6%99%AE-%E5%94%AF%E4%B8%80%E5%B0%8A%E9%87%8D%E7%9A%84%E5%A4%96%E5%9B%BD%E5%85%83%E9%A6%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790338180000.webp","sourceId":"rfi"},{"id":1790337672000,"createdDate":"2026-09-25 12:01","name":"法国国际广播电台","title":"中国某些团体提供情报助伊朗对美国目标发动更有效袭击","content":"CNN25日引述4名知情人透露，美国情报评估显示，中国团体提供的卫星图像和情报支持，帮助伊朗在霍尔木兹海峡对船只实施威胁，并对中东地区的美国军事基地发动精准打击，这体现过去几个月来伊朗目标锁定能力的大幅提升。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E4%B8%AD%E5%9B%BD%E6%9F%90%E4%BA%9B%E5%9B%A2%E4%BD%93%E6%8F%90%E4%BE%9B%E6%83%85%E6%8A%A5%E5%8A%A9%E4%BC%8A%E6%9C%97%E5%AF%B9%E7%BE%8E%E5%9B%BD%E7%9B%AE%E6%A0%87%E5%8F%91%E5%8A%A8%E6%9B%B4%E6%9C%89%E6%95%88%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790337672000.webp","sourceId":"rfi"},{"id":1790336914000,"createdDate":"2026-09-25 11:48","name":"法国国际广播电台","title":"报道称，中国今年向伊朗运送了1300批无人机和导弹零部件","content":"以色列时报引述消息称，中国今年已向伊朗运送了1300批无人机和导弹零部件，包括GPS导航设备、电机和其他两用电子产品；自战争爆发以来，受美国制裁的伊朗马汉航空将中伊航线航班数量增加了近7倍。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E6%8A%A5%E9%81%93%E7%A7%B0%EF%BC%8C%E4%B8%AD%E5%9B%BD%E4%BB%8A%E5%B9%B4%E5%90%91%E4%BC%8A%E6%9C%97%E8%BF%90%E9%80%81%E4%BA%861300%E6%89%B9%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%92%8C%E5%AF%BC%E5%BC%B9%E9%9B%B6%E9%83%A8%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790336914000.webp","sourceId":"rfi"},{"id":1790333073000,"createdDate":"2026-09-25 10:44","name":"法国国际广播电台","title":"圣母院浴火重生后 钟声迎来教宗良十四世对巴黎历史性访问","content":"周五（9月25号）早上10点，当巴黎圣母院教堂钟声响起之际，意味着罗马天主教宗良十四世踏上了法国土地，开启四天历史性的访问。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260925-%E5%9C%A3%E6%AF%8D%E9%99%A2%E6%B5%B4%E7%81%AB%E9%87%8D%E7%94%9F%E5%90%8E-%E9%92%9F%E5%A3%B0%E8%BF%8E%E6%9D%A5%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%AF%B9%E5%B7%B4%E9%BB%8E%E5%8E%86%E5%8F%B2%E6%80%A7%E8%AE%BF%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790333073000.webp","sourceId":"rfi"},{"id":1790323731000,"createdDate":"2026-09-25 08:08","name":"法国国际广播电台","title":"特习会聚焦AI角力台湾议题无突破 美国民主党声明要求特朗普放行对台军售","content":"美国总统特朗普24日在白宫以高规格迎接中国国家主席习近平，中方希望美国坚持「反对」台独的正确立场，但白宫目前未有相关回覆。会后美国参议院民主党呼吁，特朗普政府对台军售不应再延宕。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E7%89%B9%E4%B9%A0%E4%BC%9A%E8%81%9A%E7%84%A6ai%E8%A7%92%E5%8A%9B%E5%8F%B0%E6%B9%BE%E8%AE%AE%E9%A2%98%E6%97%A0%E7%AA%81%E7%A0%B4-%E7%BE%8E%E5%9B%BD%E6%B0%91%E4%B8%BB%E5%85%9A%E5%A3%B0%E6%98%8E%E8%A6%81%E6%B1%82%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BE%E8%A1%8C%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790323731000.webp","sourceId":"rfi"},{"id":1790323718000,"createdDate":"2026-09-25 08:08","name":"法国国际广播电台","title":"也门政府再次呼吁国际社会帮助击败胡塞武装","content":"也门政府周四（9月24日）再次呼吁国际社会帮助击败受伊朗支持的胡塞武装，并警告称，胡塞武装如今控制着全球最繁忙航道之一附近的重要据点，已对国际经济构成风险。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260925-%E4%B9%9F%E9%97%A8%E6%94%BF%E5%BA%9C%E5%86%8D%E6%AC%A1%E5%91%BC%E5%90%81%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%B8%AE%E5%8A%A9%E5%87%BB%E8%B4%A5%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790323718000.webp","sourceId":"rfi"},{"id":1790322360000,"createdDate":"2026-09-25 07:46","name":"法国国际广播电台","title":"特朗普称中国为“盟国”震惊日本","content":"美国总统特朗普24日在白宫举行的欢迎中国国家主席习近平的仪式上表示，第二次世界大战期间，美国和中国曾是“盟国”（allies）。美国总统在谈及二战时称中国为“盟国”，这一说法极为罕见，在日本政府内部和媒体都引起很大波澜。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%AD%E5%9B%BD%E4%B8%BA-%E7%9B%9F%E5%9B%BD-%E9%9C%87%E6%83%8A%E6%97%A5%E6%9C%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790322360000.webp","sourceId":"rfi"},{"id":1790321332000,"createdDate":"2026-09-25 07:28","name":"法国国际广播电台","title":"「47人案」被告伍健伟中秋节出狱：以新方法续追公义自由","content":"今(25日)天是农历中秋节，在香港历来最大宗民主派人士被控国安罪行的「47人案」被告伍健伟，正好今天刑满出狱，他对此既感高兴，但亦为仍有前同事系狱而感到不舒服；在面对现时红线处处的新香港，他仍不愿放弃初心，表示会以新方法去贯彻追求自由丶公义和免於恐惧的香港的信念。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260925-47%E4%BA%BA%E6%A1%88-%E8%A2%AB%E5%91%8A%E4%BC%8D%E5%81%A5%E4%BC%9F%E4%B8%AD%E7%A7%8B%E8%8A%82%E5%87%BA%E7%8B%B1-%E4%BB%A5%E6%96%B0%E6%96%B9%E6%B3%95%E7%BB%AD%E8%BF%BD%E5%85%AC%E4%B9%89%E8%87%AA%E7%94%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790321332000.webp","sourceId":"rfi"},{"id":1790350059000,"createdDate":"2026-09-25 15:27","name":"法国国际广播电台","title":"特朗普习近平华盛顿会谈 美中关系向哪走？","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平在华盛顿举行会谈，双方都强调避免冲突及加强合作，但台湾、贸易、先进芯片、人工智能（AI）及伊朗等问题仍存在分歧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260925-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%BC%9A%E8%B0%88-%E7%BE%8E%E4%B8%AD%E5%85%B3%E7%B3%BB%E5%90%91%E5%93%AA%E8%B5%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790350059000.webp","sourceId":"rfi"},{"id":1790348634000,"createdDate":"2026-09-25 15:03","name":"法国国际广播电台","title":"泽连斯基称特朗普已同意向基辅提供生产“爱国者”导弹许可","content":"乌克兰总统泽连斯基周五表示，美国总统特朗普已就向乌克兰提供生产“爱国者”防空导弹所需的许可证一事作出“最终决定”，基辅方面此前曾要求获得该许可证，以应对俄罗斯的弹道导弹袭击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%A7%B0%E7%89%B9%E6%9C%97%E6%99%AE%E5%B7%B2%E5%90%8C%E6%84%8F%E5%90%91%E5%9F%BA%E8%BE%85%E6%8F%90%E4%BE%9B%E7%94%9F%E4%BA%A7-%E7%88%B1%E5%9B%BD%E8%80%85-%E5%AF%BC%E5%BC%B9%E8%AE%B8%E5%8F%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790348634000.webp","sourceId":"rfi"},{"id":1790346924000,"createdDate":"2026-09-25 14:35","name":"法国国际广播电台","title":"王维洛：平陆运河打破分水岭是对生态环境的绝对破坏","content":"中国广西长达134公里的人造运河平陆运河于9月16日正式通航，中国媒体高调报道了这一耗资727亿元的工程，声称它将改变西南地区未来与市场、产业乃至世界连接的“经济距离。9月23日，通过平陆运河的首艘外贸货轮抵达越南完成了首航。 不过，旅居德国的水利专家王维洛先生对平陆运河的环境后果深表担忧，他认为该运河的修建打破水利工程的一大禁忌，破坏了广西河流的分水岭，对当地近年来频频发生的水灾负有直接的责任。他还对平陆运河的经济收益存有疑虑，担心这或许又是一大赔钱的工程。此外，他还就环球网文章将平陆运河与苏伊士运河相提并论提出质疑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20260925-%E7%8E%8B%E7%BB%B4%E6%B4%9B-%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3%E6%89%93%E7%A0%B4%E5%88%86%E6%B0%B4%E5%B2%AD%E6%98%AF%E5%AF%B9%E7%94%9F%E6%80%81%E7%8E%AF%E5%A2%83%E7%9A%84%E7%BB%9D%E5%AF%B9%E7%A0%B4%E5%9D%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790346924000.webp","sourceId":"rfi"},{"id":1790346915000,"createdDate":"2026-09-25 14:35","name":"法国国际广播电台","title":"菲律宾指责中国阻挠其在仁爱礁补给任务","content":"菲律宾于9月25日指责中国海警和军舰阻挠其昨天前往南海阿云津礁（Ayungin）上进行补给任务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260925-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E6%8C%87%E8%B4%A3%E4%B8%AD%E5%9B%BD%E9%98%BB%E6%8C%A0%E5%85%B6%E5%9C%A8%E4%BB%81%E7%88%B1%E7%A4%81%E8%A1%A5%E7%BB%99%E4%BB%BB%E5%8A%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790346915000.webp","sourceId":"rfi"},{"id":1790339005000,"createdDate":"2026-09-25 12:23","name":"法国国际广播电台","title":"伊朗称满足条件后可在七天内重开霍尔木兹海峡","content":"伊朗外长阿拉格齐（AbbasAraghchi）表示，德黑兰已向美国提出一项方案，如果相关条件得到满足，伊朗将在七天内重新开放霍尔木兹海峡，并启动谈判。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260925-%E4%BC%8A%E6%9C%97%E7%A7%B0%E6%BB%A1%E8%B6%B3%E6%9D%A1%E4%BB%B6%E5%90%8E%E5%8F%AF%E5%9C%A8%E4%B8%83%E5%A4%A9%E5%86%85%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/25/1790339005000.webp","sourceId":"rfi"}]