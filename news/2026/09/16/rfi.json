[{"id":1789564831000,"createdDate":"2026-09-16 13:20","name":"法国国际广播电台","title":"2万港元奖励生育失败 香港加码续鼓励生育 惟仍较新加坡逊色","content":"在香港首次出现新生婴儿人数首次跌破3万大关丶距人口替代水准越来越远之际，政府在施政报告中推出11项鼓励生育的措施，包括延续生肯奖励金2万港元三年，并上调子女免税额，小学生可享课後托管服务以减轻家庭照顾担子；但与生育率较高的新加坡之鼓励金额和有措施照顾至中学相比，香港明显「不给力」。对此，香港特首李家超表示，措施是实事求是，而金钱只能有短期刺激作用，重要的是制造家庭友善环境，并不时检讨。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-2%E4%B8%87%E6%B8%AF%E5%85%83%E5%A5%96%E5%8A%B1%E7%94%9F%E8%82%B2%E5%A4%B1%E8%B4%A5-%E9%A6%99%E6%B8%AF%E5%8A%A0%E7%A0%81%E7%BB%AD%E9%BC%93%E5%8A%B1%E7%94%9F%E8%82%B2-%E6%83%9F%E4%BB%8D%E8%BE%83%E6%96%B0%E5%8A%A0%E5%9D%A1%E9%80%8A%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789564831000.webp","sourceId":"rfi"},{"id":1789563339000,"createdDate":"2026-09-16 12:55","name":"法国国际广播电台","title":"平陆运河与六蓝水库溃坝有关？","content":"中国官方9月16日宣布，从广西南宁横州市平塘江口，经钦州灵山县陆屋镇，沿钦江进入北部湾的全长134.2公里的平陆运河建成通航，据报道，平陆运河于2022年8月28日开工建设，是新中国成立以来第一条国家层面统筹建设的“通江达海”运河工程，按内河Ⅰ级航道标准建设，可通航5000吨级船舶。将使中国西南腹地和东盟之间货运较传统路径缩短内河航程560公里以上，综合物流成本降低18%至30%。不过，中国媒体无人提到平陆运河与两个月前广西六蓝水库溃坝所导致的一百多人死亡的灾难之间可能存在的关联，而旅居德国的水利专家王维洛当时在接受法广采访时就表示：","newsLink":"http://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260916-%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3%E4%B8%8E%E5%85%AD%E8%93%9D%E6%B0%B4%E5%BA%93%E6%BA%83%E5%9D%9D%E6%9C%89%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789563339000.webp","sourceId":"rfi"},{"id":1789561719000,"createdDate":"2026-09-16 12:28","name":"法国国际广播电台","title":"美国司法指控数千万美元伊朗石油收入被中国公司通过“币安”洗钱转至德黑兰","content":"美国司法部9月14日表示，多家公司利用加密货币交易所币安（Binance）转账中国买家购买伊朗黑市石油的款项，成为违反制裁、为伊朗军队提供资金计划的一部分。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E6%8C%87%E6%8E%A7%E6%95%B0%E5%8D%83%E4%B8%87%E7%BE%8E%E5%85%83%E4%BC%8A%E6%9C%97%E7%9F%B3%E6%B2%B9%E6%94%B6%E5%85%A5%E8%A2%AB%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%8F%B8%E9%80%9A%E8%BF%87-%E5%B8%81%E5%AE%89-%E6%B4%97%E9%92%B1%E8%BD%AC%E8%87%B3%E5%BE%B7%E9%BB%91%E5%85%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789561719000.webp","sourceId":"rfi"},{"id":1789560628000,"createdDate":"2026-09-16 12:10","name":"法国国际广播电台","title":"北京收紧出境条件引发忧惧之际 报告又揭囚犯仍遭酷刑与剥夺医疗权利","content":"大家好，周三9月16日的法国主流日报头版话题各有侧重，例如《费加罗报》关注法国政局：前文化部长拉希达·达蒂遭控“腐败”今将在巴黎法庭受审。《十字架报》聚焦人工智能的争论，指出这是一种”饥饿营销“。《解放报》封面则推出对朋克摇滚乐队Les的主唱之一、拥有永不满足的自由精神的RitaMitsouko纪念专题，《解放报》的国际版同时登出了对于中国出入境新规的观察报道，新规允许当局在某些含糊不清的情况下阻止公民离境。此外《费加罗报》也注意到，据中国人权捍卫者联盟（CHRD）周三发布的报告显示，中国仍在对囚犯实施酷刑，包括殴打和剥夺医疗权利。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260916-%E5%8C%97%E4%BA%AC%E6%94%B6%E7%B4%A7%E5%87%BA%E5%A2%83%E6%9D%A1%E4%BB%B6%E5%BC%95%E5%8F%91%E5%BF%A7%E6%83%A7%E4%B9%8B%E9%99%85-%E6%8A%A5%E5%91%8A%E5%8F%88%E6%8F%AD%E5%9B%9A%E7%8A%AF%E4%BB%8D%E9%81%AD%E9%85%B7%E5%88%91%E8%99%90%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789560628000.webp","sourceId":"rfi"},{"id":1789560114000,"createdDate":"2026-09-16 12:01","name":"法国国际广播电台","title":"王毅会伊朗外长：承诺捍卫伊朗利益 呼吁重开霍尔木兹海峡 不希望战火延至红海","content":"周三，伊朗外长阿巴斯-阿拉格齐访问北京，与中国外长王毅会面。一周之后，习近平将访美，与特朗普举行峰会。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E7%8E%8B%E6%AF%85%E4%BC%9A%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF-%E6%89%BF%E8%AF%BA%E6%8D%8D%E5%8D%AB%E4%BC%8A%E6%9C%97%E5%88%A9%E7%9B%8A-%E5%91%BC%E5%90%81%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E4%B8%8D%E5%B8%8C%E6%9C%9B%E6%88%98%E7%81%AB%E5%BB%B6%E8%87%B3%E7%BA%A2%E6%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789560114000.webp","sourceId":"rfi"},{"id":1789553710000,"createdDate":"2026-09-16 10:15","name":"法国国际广播电台","title":"人权组织报告：中国政府杜绝酷刑的制度性失败","content":"据一家人权非政府组织周三（9月16号）发布的报告显示，中国仍在对囚犯实施酷刑，包括殴打和剥夺医疗权利。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%8A%A5%E5%91%8A-%E4%B8%AD%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%9D%9C%E7%BB%9D%E9%85%B7%E5%88%91%E7%9A%84%E5%88%B6%E5%BA%A6%E6%80%A7%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789553710000.webp","sourceId":"rfi"},{"id":1789549955000,"createdDate":"2026-09-16 09:12","name":"法国国际广播电台","title":"香港首份五年规划公布：香港订发展指标靠垄北京 藉国际地位推人民币及中国标准","content":"实行资本主义的香港，今天一如实行计划经济的中国内地般，公布首份五年规划(香港「一五」规划)，特首李家超在当中为香港今後五年的经济及社会发展订定目标，包括积极推动人民币作为政府的支付货币来强化香港作为全球最大离岸人民币枢纽的地位丶本地创新活动总开支在本地生产总值的占比会在2030年後倍增至3%丶进一步融入大湾区，以及协助中国参与国际标准的订定。但李家超在公布规划前夕再次否认规划等同「计划经济」，强调只是指出发展方向丶优先范畴及蓝图。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-%E9%A6%99%E6%B8%AF%E9%A6%96%E4%BB%BD%E4%BA%94%E5%B9%B4%E8%A7%84%E5%88%92%E5%85%AC%E5%B8%83-%E9%A6%99%E6%B8%AF%E8%AE%A2%E5%8F%91%E5%B1%95%E6%8C%87%E6%A0%87%E9%9D%A0%E5%9E%84%E5%8C%97%E4%BA%AC-%E8%97%89%E5%9B%BD%E9%99%85%E5%9C%B0%E4%BD%8D%E6%8E%A8%E4%BA%BA%E6%B0%91%E5%B8%81%E5%8F%8A%E4%B8%AD%E5%9B%BD%E6%A0%87%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789549955000.webp","sourceId":"rfi"},{"id":1789548789000,"createdDate":"2026-09-16 08:53","name":"法国国际广播电台","title":"朝鲜炸毁朝韩联络办公室案 韩国法院判平壤赔偿2800万欧元","content":"韩国法院周三（9月16日）就朝鲜2020年爆破炸毁朝韩联络办公室大楼一案作出裁决，判处平壤方面赔偿韩国政府约2800万欧元，该联络办公室曾是朝韩关系缓和的象征。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260916-%E6%9C%9D%E9%B2%9C%E7%82%B8%E6%AF%81%E6%9C%9D%E9%9F%A9%E8%81%94%E7%BB%9C%E5%8A%9E%E5%85%AC%E5%AE%A4-%E9%9F%A9%E5%9B%BD%E6%B3%95%E9%99%A2%E5%88%A4%E5%B9%B3%E5%A3%A4%E8%B5%94%E5%81%BF2800%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789548789000.webp","sourceId":"rfi"},{"id":1789544625000,"createdDate":"2026-09-16 07:43","name":"法国国际广播电台","title":"特习二会预计24日登场 对台军售再次成为美中谈判最敏感筹码","content":"特习两人今年将第二度举行峰会，并预计在24日于华盛顿登场。有媒体报导，北京已向华盛顿传达讯息，如果美国在两国元首会晤前批准新的对台军售，中方可能取消峰会。不过美中官方目前均未证实相关说法。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-%E7%89%B9%E4%B9%A0%E4%BA%8C%E4%BC%9A%E9%A2%84%E8%AE%A124%E6%97%A5%E7%99%BB%E5%9C%BA-%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%E5%86%8D%E6%AC%A1%E6%88%90%E4%B8%BA%E7%BE%8E%E4%B8%AD%E8%B0%88%E5%88%A4%E6%9C%80%E6%95%8F%E6%84%9F%E7%AD%B9%E7%A0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789544625000.webp","sourceId":"rfi"},{"id":1789543676000,"createdDate":"2026-09-16 07:27","name":"法国国际广播电台","title":"香山论坛中国高层批判“军国主义复活” 日本官方被拒之门外","content":"中国国防部长董军16日在北京举行的年度安全保障会议第十三届北京香山论坛开幕式上致辞时表示：应对一切潜藏的霸权主义、军国主义，保持高度警惕。这一表态被视为对日本的间接批评。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260916-%E9%A6%99%E5%B1%B1%E8%AE%BA%E5%9D%9B%E4%B8%AD%E5%9B%BD%E9%AB%98%E5%B1%82%E6%89%B9%E5%88%A4-%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E5%A4%8D%E6%B4%BB-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%96%B9%E8%A2%AB%E6%8B%92%E4%B9%8B%E9%97%A8%E5%A4%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789543676000.webp","sourceId":"rfi"},{"id":1789579107000,"createdDate":"2026-09-16 17:18","name":"法国国际广播电台","title":"沙特指责也门胡塞武装无人机袭击麦加“触碰红线”","content":"穆斯林世界震惊：沙特阿拉伯周三指责也门胡塞武装对圣城麦加发动了无人机袭击，但这些亲伊朗武装分子对此予以否认。腹背受敌的沙特正面临境内威胁和海上双面夹击：一方面是红海地区的胡塞武装，另一方面是波斯湾地区的伊朗。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260916-%E6%B2%99%E7%89%B9%E6%8C%87%E8%B4%A3%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E9%BA%A6%E5%8A%A0-%E8%A7%A6%E7%A2%B0%E7%BA%A2%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789579107000.webp","sourceId":"rfi"},{"id":1789578167000,"createdDate":"2026-09-16 17:02","name":"法国国际广播电台","title":"视频 通往东南亚的贸易捷径 中国开通平陆运河","content":"平陆运河于今天投入运营，这条位于中国广西壮族自治区的运河，方便中国西南腹地与东盟之间货运，请看视频报道。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E8%A7%86%E9%A2%91-%E9%80%9A%E5%BE%80%E4%B8%9C%E5%8D%97%E4%BA%9A%E7%9A%84%E8%B4%B8%E6%98%93%E6%8D%B7%E5%BE%84-%E4%B8%AD%E5%9B%BD%E5%BC%80%E9%80%9A%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789578167000.webp","sourceId":"rfi"},{"id":1789572833000,"createdDate":"2026-09-16 15:33","name":"法国国际广播电台","title":"冯德莱恩：欧盟将使用一切工具削减对华贸易逆差","content":"欧盟委员会主席乌尔苏拉·冯德莱恩周三表示，欧盟将采取一切可能的手段来减少其与中国之间“不可持续的”贸易逆差。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E6%AC%A7%E7%9B%9F%E5%B0%86%E4%BD%BF%E7%94%A8%E4%B8%80%E5%88%87%E5%B7%A5%E5%85%B7%E5%89%8A%E5%87%8F%E5%AF%B9%E5%8D%8E%E8%B4%B8%E6%98%93%E9%80%86%E5%B7%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789572833000.webp","sourceId":"rfi"},{"id":1789572629000,"createdDate":"2026-09-16 15:30","name":"法国国际广播电台","title":"澳门首宗涉国安法审判：闭门审判被控“颠覆国家政权罪”的前民主派议员","content":"澳门这一于1999年回归中国的前葡萄牙殖民地，于周三闭门审理首宗涉《国家安全法》案件，审判一名被控犯有“颠覆国家政权罪”的前民主派议员。","newsLink":"http://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260916-%E6%BE%B3%E9%97%A8%E9%A6%96%E5%AE%97%E6%B6%89%E5%9B%BD%E5%AE%89%E6%B3%95%E5%AE%A1%E5%88%A4-%E9%97%AD%E9%97%A8%E5%AE%A1%E5%88%A4%E8%A2%AB%E6%8E%A7-%E9%A2%A0%E8%A6%86%E5%9B%BD%E5%AE%B6%E6%94%BF%E6%9D%83%E7%BD%AA-%E7%9A%84%E5%89%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E8%AE%AE%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789572629000.webp","sourceId":"rfi"},{"id":1789570087000,"createdDate":"2026-09-16 14:48","name":"法国国际广播电台","title":"FT：中国力主釜山协议延至特朗普任满 美国因稀土问题坚持只延6个月","content":"特朗普与习近平峰会在即。双方去年10月在韩国达成的贸易战“休战协议”将于今年11月到期。据金融时报透露，中方主张将该协议延至两年后特朗普任满，但美方只想延长半年，部分原因是稀土。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-ft-%E4%B8%AD%E5%9B%BD%E5%8A%9B%E4%B8%BB%E9%87%9C%E5%B1%B1%E5%8D%8F%E8%AE%AE%E5%BB%B6%E8%87%B3%E7%89%B9%E6%9C%97%E6%99%AE%E4%BB%BB%E6%BB%A1-%E7%BE%8E%E5%9B%BD%E5%9B%A0%E7%A8%80%E5%9C%9F%E9%97%AE%E9%A2%98%E5%9D%9A%E6%8C%81%E5%8F%AA%E5%BB%B66%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789570087000.webp","sourceId":"rfi"},{"id":1789568964000,"createdDate":"2026-09-16 14:29","name":"法国国际广播电台","title":"视频 人工智能安全警告日益紧迫 美国领导人的回应","content":"科技界针对人工智能潜在危害发出的警告日益紧迫，各国呼吁政府加强监管的呼声也不断上升，不过特朗普政府反对，请看视频报道。","newsLink":"http://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260916-%E8%A7%86%E9%A2%91-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%AE%89%E5%85%A8%E8%AD%A6%E5%91%8A%E6%97%A5%E7%9B%8A%E7%B4%A7%E8%BF%AB-%E7%BE%8E%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA%E7%9A%84%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789568964000.webp","sourceId":"rfi"},{"id":1789567852000,"createdDate":"2026-09-16 14:10","name":"法国国际广播电台","title":"从欧委会主席冯德莱恩“欧盟国情咨文”看欧盟未来走向","content":"周三（9月16号）所有人的目光都将聚焦斯特拉斯堡，欧盟委员会主席冯德莱恩向欧洲议会发表欧盟年度国情咨文。她的一言一行都受到欧洲议会议员、欧洲各国首都以及市场的密切关注。虽然这项活动很少会带来什么重大惊喜，但确实能让外界解读言外之意：布鲁塞尔认为哪些事情是当务之急，哪些事情是需要加快推进的，以及哪些权力格局将影响未来几个月的走向。近日，欧盟委员会发布了一份文件，概述了自去年国情咨文以来在竞争力、能源独立、外交政策、捍卫民主和国防等领域实施的各项举措。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260916-%E4%BB%8E%E6%AC%A7%E5%A7%94%E4%BC%9A%E4%B8%BB%E5%B8%AD%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E6%AC%A7%E7%9B%9F%E5%9B%BD%E6%83%85%E5%92%A8%E6%96%87-%E7%9C%8B%E6%AC%A7%E7%9B%9F%E6%9C%AA%E6%9D%A5%E8%B5%B0%E5%90%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789567852000.webp","sourceId":"rfi"},{"id":1789597741000,"createdDate":"2026-09-16 22:29","name":"法国国际广播电台","title":"指望美中联手管控人工智能是否过于天真","content":"有关人类发明的AI会把人类带向何方的质疑连日来此起彼伏，联合国大会即将开幕之际，该组织秘书长古德雷斯周三也敲响警钟：“我们不能对AI引发的问题装作不知，所有政府的首要责任是保护他们的公民，包括免遭与人工智能相关的威胁”。他呼吁在人工智能领域开展“全球协调”。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E6%8C%87%E6%9C%9B%E7%BE%8E%E4%B8%AD%E8%81%94%E6%89%8B%E7%AE%A1%E6%8E%A7%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%98%AF%E5%90%A6%E8%BF%87%E4%BA%8E%E5%A4%A9%E7%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789597741000.webp","sourceId":"rfi"},{"id":1789594176000,"createdDate":"2026-09-16 21:29","name":"法国国际广播电台","title":"欧盟警告英美资源镍业务转入中资旗下可能损害竞争","content":"欧盟周三（9月16日）警告，英国矿业巨头英美资源集团（AngloAmerican）将旗下镍业务出售给由中国国有集团控股的五矿资源有限公司（MMGLimited），可能损害市场竞争。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E6%AC%A7%E7%9B%9F%E8%AD%A6%E5%91%8A%E8%8B%B1%E7%BE%8E%E8%B5%84%E6%BA%90%E9%95%8D%E4%B8%9A%E5%8A%A1%E8%BD%AC%E5%85%A5%E4%B8%AD%E8%B5%84%E6%97%97%E4%B8%8B%E5%8F%AF%E8%83%BD%E6%8D%9F%E5%AE%B3%E7%AB%9E%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789594176000.webp","sourceId":"rfi"},{"id":1789593515000,"createdDate":"2026-09-16 21:18","name":"法国国际广播电台","title":"华为预计2035年全球活跃AI智能体达九千亿 安全与失控风险受关注","content":"中国科技和电信设备巨头华为预计，到2035年，智能体流量将占全球人工智能（AI）Token流量的90%以上。如此大规模的应用将显著推高算力需求，同时需要建立新的安全与隐私保护体系。华为希望其计算基础设施能够成为中国版的美国芯片巨头英伟达。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E5%8D%8E%E4%B8%BA%E9%A2%84%E8%AE%A12035%E5%B9%B4%E5%85%A8%E7%90%83%E6%B4%BB%E8%B7%83ai%E6%99%BA%E8%83%BD%E4%BD%93%E8%BE%BE%E4%B9%9D%E5%8D%83%E4%BA%BF-%E5%AE%89%E5%85%A8%E4%B8%8E%E5%A4%B1%E6%8E%A7%E9%A3%8E%E9%99%A9%E5%8F%97%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789593515000.webp","sourceId":"rfi"},{"id":1789593255000,"createdDate":"2026-09-16 21:14","name":"法国国际广播电台","title":"习近平访美前夕 黎智英家属呼吁释放黎智英","content":"中国国家主席习近平访问华盛顿前一周，因违反香港国安法被判处20年监禁的香港前民主派传媒大亨黎智英，其家人周三（9月16日）出席美国国会听证会，呼吁释放黎智英。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E%E5%89%8D%E5%A4%95-%E9%BB%8E%E6%99%BA%E8%8B%B1%E5%AE%B6%E5%B1%9E%E5%91%BC%E5%90%81%E9%87%8A%E6%94%BE%E9%BB%8E%E6%99%BA%E8%8B%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789593255000.webp","sourceId":"rfi"},{"id":1789593148000,"createdDate":"2026-09-16 21:12","name":"法国国际广播电台","title":"被视为科索沃独立英雄的前总统涉战争罪获刑25年","content":"九十年代为争取科索沃从塞尔维亚独立而发动武装斗争的科索沃前总统塔其，因犯下谋杀、酷刑、非法拘禁等战争罪而于周三被海牙国际法庭判处25年徒刑。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E8%A2%AB%E8%A7%86%E4%B8%BA%E7%A7%91%E7%B4%A2%E6%B2%83%E7%8B%AC%E7%AB%8B%E8%8B%B1%E9%9B%84%E7%9A%84%E5%89%8D%E6%80%BB%E7%BB%9F%E6%B6%89%E6%88%98%E4%BA%89%E7%BD%AA%E8%8E%B7%E5%88%9125%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789593148000.webp","sourceId":"rfi"},{"id":1789593122000,"createdDate":"2026-09-16 21:12","name":"法国国际广播电台","title":"冲绳县“变天了”：“直面中国威胁”，走上强化军事之路","content":"各位好，9月17日出刊的法国世界报没有与中国直接相关的报道。在本期节目中，我们为您选取与亚洲其他国家相关的两篇报道做综述。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260916-%E5%86%B2%E7%BB%B3%E5%8E%BF-%E5%8F%98%E5%A4%A9%E4%BA%86-%E7%9B%B4%E9%9D%A2%E4%B8%AD%E5%9B%BD%E5%A8%81%E8%83%81-%EF%BC%8C%E8%B5%B0%E4%B8%8A%E5%BC%BA%E5%8C%96%E5%86%9B%E4%BA%8B%E4%B9%8B%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789593122000.webp","sourceId":"rfi"},{"id":1789593056000,"createdDate":"2026-09-16 21:10","name":"法国国际广播电台","title":"美联储三年来首次加息 暗示将继续收紧政策 特朗普要求“迅速”下调利率","content":"美国联邦储备委员会周三（9月16日）宣布加息，将联邦基金利率目标区间上调至3.75%至4.00%，并暗示未来数月可能继续提高借贷成本，以应对油价飙升、中东冲突升级以及通胀压力持续不退。美联储主席凯文·沃什同时强调，央行将恪守自身职责边界，其独立性是“双向的”，贸易和财政政策应由行政部门负责。美联储宣布加息后，特朗普要求“迅速”下调利率。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E7%BE%8E%E8%81%94%E5%82%A8%E4%B8%89%E5%B9%B4%E6%9D%A5%E9%A6%96%E6%AC%A1%E5%8A%A0%E6%81%AF-%E6%9A%97%E7%A4%BA%E5%B0%86%E7%BB%A7%E7%BB%AD%E6%94%B6%E7%B4%A7%E6%94%BF%E7%AD%96-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E6%B1%82-%E8%BF%85%E9%80%9F-%E4%B8%8B%E8%B0%83%E5%88%A9%E7%8E%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789593056000.webp","sourceId":"rfi"},{"id":1789592195000,"createdDate":"2026-09-16 20:56","name":"法国国际广播电台","title":"德国选择党能否在萨安州上台执政?","content":"被视为极端右翼的德国选择党（AfD）在萨安州选举中获得历史性胜利后，能否上台执政，备受关注。潜在的联盟伙伴萨瓦联盟(BSW)已和选择党拉开距离。而德国政府则威胁可能对选择党采取“联邦强制”法规。一位政治学家表示：选择党即便执政，仍然可能继续使用“受害者”战略。","newsLink":"http://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260916-%E5%BE%B7%E5%9B%BD%E9%80%89%E6%8B%A9%E5%85%9A%E8%83%BD%E5%90%A6%E5%9C%A8%E8%90%A8%E5%AE%89%E5%B7%9E%E4%B8%8A%E5%8F%B0%E6%89%A7%E6%94%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789592195000.webp","sourceId":"rfi"},{"id":1789591588000,"createdDate":"2026-09-16 20:46","name":"法国国际广播电台","title":"美国会聚焦中国科技进口风险　吁降低供应链依赖","content":"美国国会众议院美中战略竞争特设委员会本周三举行听证会，讨论如何透过进口管制，降低美国对中国科技及供应链的依赖。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E8%81%9A%E7%84%A6%E4%B8%AD%E5%9B%BD%E7%A7%91%E6%8A%80%E8%BF%9B%E5%8F%A3%E9%A3%8E%E9%99%A9-%E5%90%81%E9%99%8D%E4%BD%8E%E4%BE%9B%E5%BA%94%E9%93%BE%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789591588000.webp","sourceId":"rfi"},{"id":1789589199000,"createdDate":"2026-09-16 20:06","name":"法国国际广播电台","title":"乌克兰2027年国防预算创纪录，战争成本飙升","content":"路透社9月16日消息，乌克兰议会当天为2027年国防预算开出了创纪录的数字，预计达到4.89万亿格里夫纳，约合970亿欧元，与2026年国防预算相比，上涨12％。在当天提交议会审议的2027年预算草案中，国防开支占总支出的大约三分之二。预算收入预计达到5.60万亿格里夫纳，约合1090亿欧元。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E4%B9%8C%E5%85%8B%E5%85%B02027%E5%B9%B4%E5%9B%BD%E9%98%B2%E9%A2%84%E7%AE%97%E5%88%9B%E7%BA%AA%E5%BD%95%EF%BC%8C%E6%88%98%E4%BA%89%E6%88%90%E6%9C%AC%E9%A3%99%E5%8D%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789589199000.webp","sourceId":"rfi"}]