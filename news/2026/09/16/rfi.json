[{"id":1789564831000,"createdDate":"2026-09-16 13:20","name":"法国国际广播电台","title":"2万港元奖励生育失败 香港加码续鼓励生育 惟仍较新加坡逊色","content":"在香港首次出现新生婴儿人数首次跌破3万大关丶距人口替代水准越来越远之际，政府在施政报告中推出11项鼓励生育的措施，包括延续生肯奖励金2万港元三年，并上调子女免税额，小学生可享课後托管服务以减轻家庭照顾担子；但与生育率较高的新加坡之鼓励金额和有措施照顾至中学相比，香港明显「不给力」。对此，香港特首李家超表示，措施是实事求是，而金钱只能有短期刺激作用，重要的是制造家庭友善环境，并不时检讨。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-2%E4%B8%87%E6%B8%AF%E5%85%83%E5%A5%96%E5%8A%B1%E7%94%9F%E8%82%B2%E5%A4%B1%E8%B4%A5-%E9%A6%99%E6%B8%AF%E5%8A%A0%E7%A0%81%E7%BB%AD%E9%BC%93%E5%8A%B1%E7%94%9F%E8%82%B2-%E6%83%9F%E4%BB%8D%E8%BE%83%E6%96%B0%E5%8A%A0%E5%9D%A1%E9%80%8A%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789564831000.webp","sourceId":"rfi"},{"id":1789563339000,"createdDate":"2026-09-16 12:55","name":"法国国际广播电台","title":"平陆运河与六蓝水库溃坝有关？","content":"中国官方9月16日宣布，从广西南宁横州市平塘江口，经钦州灵山县陆屋镇，沿钦江进入北部湾的全长134.2公里的平陆运河建成通航，据报道，平陆运河于2022年8月28日开工建设，是新中国成立以来第一条国家层面统筹建设的“通江达海”运河工程，按内河Ⅰ级航道标准建设，可通航5000吨级船舶。将使中国西南腹地和东盟之间货运较传统路径缩短内河航程560公里以上，综合物流成本降低18%至30%。不过，中国媒体无人提到平陆运河与两个月前广西六蓝水库溃坝所导致的一百多人死亡的灾难之间可能存在的关联，而旅居德国的水利专家王维洛当时在接受法广采访时就表示：","newsLink":"http://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260916-%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3%E4%B8%8E%E5%85%AD%E8%93%9D%E6%B0%B4%E5%BA%93%E6%BA%83%E5%9D%9D%E6%9C%89%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789563339000.webp","sourceId":"rfi"},{"id":1789561719000,"createdDate":"2026-09-16 12:28","name":"法国国际广播电台","title":"美国司法指控数千万美元伊朗石油收入被中国公司通过“币安”洗钱转至德黑兰","content":"美国司法部9月14日表示，多家公司利用加密货币交易所币安（Binance）转账中国买家购买伊朗黑市石油的款项，成为违反制裁、为伊朗军队提供资金计划的一部分。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E6%8C%87%E6%8E%A7%E6%95%B0%E5%8D%83%E4%B8%87%E7%BE%8E%E5%85%83%E4%BC%8A%E6%9C%97%E7%9F%B3%E6%B2%B9%E6%94%B6%E5%85%A5%E8%A2%AB%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%8F%B8%E9%80%9A%E8%BF%87-%E5%B8%81%E5%AE%89-%E6%B4%97%E9%92%B1%E8%BD%AC%E8%87%B3%E5%BE%B7%E9%BB%91%E5%85%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789561719000.webp","sourceId":"rfi"},{"id":1789560628000,"createdDate":"2026-09-16 12:10","name":"法国国际广播电台","title":"北京收紧出境条件引发忧惧之际 报告又揭囚犯仍遭酷刑与剥夺医疗权利","content":"大家好，周三9月16日的法国主流日报头版话题各有侧重，例如《费加罗报》关注法国政局：前文化部长拉希达·达蒂遭控“腐败”今将在巴黎法庭受审。《十字架报》聚焦人工智能的争论，指出这是一种”饥饿营销“。《解放报》封面则推出对朋克摇滚乐队Les的主唱之一、拥有永不满足的自由精神的RitaMitsouko纪念专题，《解放报》的国际版同时登出了对于中国出入境新规的观察报道，新规允许当局在某些含糊不清的情况下阻止公民离境。此外《费加罗报》也注意到，据中国人权捍卫者联盟（CHRD）周三发布的报告显示，中国仍在对囚犯实施酷刑，包括殴打和剥夺医疗权利。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260916-%E5%8C%97%E4%BA%AC%E6%94%B6%E7%B4%A7%E5%87%BA%E5%A2%83%E6%9D%A1%E4%BB%B6%E5%BC%95%E5%8F%91%E5%BF%A7%E6%83%A7%E4%B9%8B%E9%99%85-%E6%8A%A5%E5%91%8A%E5%8F%88%E6%8F%AD%E5%9B%9A%E7%8A%AF%E4%BB%8D%E9%81%AD%E9%85%B7%E5%88%91%E8%99%90%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789560628000.webp","sourceId":"rfi"},{"id":1789560114000,"createdDate":"2026-09-16 12:01","name":"法国国际广播电台","title":"王毅会伊朗外长：承诺捍卫伊朗利益 呼吁重开霍尔木兹海峡 不希望战火延至红海","content":"周三，伊朗外长阿巴斯-阿拉格齐访问北京，与中国外长王毅会面。一周之后，习近平将访美，与特朗普举行峰会。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E7%8E%8B%E6%AF%85%E4%BC%9A%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF-%E6%89%BF%E8%AF%BA%E6%8D%8D%E5%8D%AB%E4%BC%8A%E6%9C%97%E5%88%A9%E7%9B%8A-%E5%91%BC%E5%90%81%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E4%B8%8D%E5%B8%8C%E6%9C%9B%E6%88%98%E7%81%AB%E5%BB%B6%E8%87%B3%E7%BA%A2%E6%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789560114000.webp","sourceId":"rfi"},{"id":1789553710000,"createdDate":"2026-09-16 10:15","name":"法国国际广播电台","title":"人权组织报告：中国政府杜绝酷刑的制度性失败","content":"据一家人权非政府组织周三（9月16号）发布的报告显示，中国仍在对囚犯实施酷刑，包括殴打和剥夺医疗权利。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%8A%A5%E5%91%8A-%E4%B8%AD%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%9D%9C%E7%BB%9D%E9%85%B7%E5%88%91%E7%9A%84%E5%88%B6%E5%BA%A6%E6%80%A7%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789553710000.webp","sourceId":"rfi"},{"id":1789549955000,"createdDate":"2026-09-16 09:12","name":"法国国际广播电台","title":"香港首份五年规划公布：香港订发展指标靠垄北京 藉国际地位推人民币及中国标准","content":"实行资本主义的香港，今天一如实行计划经济的中国内地般，公布首份五年规划(香港「一五」规划)，特首李家超在当中为香港今後五年的经济及社会发展订定目标，包括积极推动人民币作为政府的支付货币来强化香港作为全球最大离岸人民币枢纽的地位丶本地创新活动总开支在本地生产总值的占比会在2030年後倍增至3%丶进一步融入大湾区，以及协助中国参与国际标准的订定。但李家超在公布规划前夕再次否认规划等同「计划经济」，强调只是指出发展方向丶优先范畴及蓝图。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-%E9%A6%99%E6%B8%AF%E9%A6%96%E4%BB%BD%E4%BA%94%E5%B9%B4%E8%A7%84%E5%88%92%E5%85%AC%E5%B8%83-%E9%A6%99%E6%B8%AF%E8%AE%A2%E5%8F%91%E5%B1%95%E6%8C%87%E6%A0%87%E9%9D%A0%E5%9E%84%E5%8C%97%E4%BA%AC-%E8%97%89%E5%9B%BD%E9%99%85%E5%9C%B0%E4%BD%8D%E6%8E%A8%E4%BA%BA%E6%B0%91%E5%B8%81%E5%8F%8A%E4%B8%AD%E5%9B%BD%E6%A0%87%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789549955000.webp","sourceId":"rfi"},{"id":1789548789000,"createdDate":"2026-09-16 08:53","name":"法国国际广播电台","title":"朝鲜炸毁朝韩联络办公室案 韩国法院判平壤赔偿2800万欧元","content":"韩国法院周三（9月16日）就朝鲜2020年爆破炸毁朝韩联络办公室大楼一案作出裁决，判处平壤方面赔偿韩国政府约2800万欧元，该联络办公室曾是朝韩关系缓和的象征。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260916-%E6%9C%9D%E9%B2%9C%E7%82%B8%E6%AF%81%E6%9C%9D%E9%9F%A9%E8%81%94%E7%BB%9C%E5%8A%9E%E5%85%AC%E5%AE%A4-%E9%9F%A9%E5%9B%BD%E6%B3%95%E9%99%A2%E5%88%A4%E5%B9%B3%E5%A3%A4%E8%B5%94%E5%81%BF2800%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789548789000.webp","sourceId":"rfi"},{"id":1789544625000,"createdDate":"2026-09-16 07:43","name":"法国国际广播电台","title":"特习二会预计24日登场 对台军售再次成为美中谈判最敏感筹码","content":"特习两人今年将第二度举行峰会，并预计在24日于华盛顿登场。有媒体报导，北京已向华盛顿传达讯息，如果美国在两国元首会晤前批准新的对台军售，中方可能取消峰会。不过美中官方目前均未证实相关说法。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260916-%E7%89%B9%E4%B9%A0%E4%BA%8C%E4%BC%9A%E9%A2%84%E8%AE%A124%E6%97%A5%E7%99%BB%E5%9C%BA-%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%E5%86%8D%E6%AC%A1%E6%88%90%E4%B8%BA%E7%BE%8E%E4%B8%AD%E8%B0%88%E5%88%A4%E6%9C%80%E6%95%8F%E6%84%9F%E7%AD%B9%E7%A0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789544625000.webp","sourceId":"rfi"},{"id":1789543676000,"createdDate":"2026-09-16 07:27","name":"法国国际广播电台","title":"香山论坛中国高层批判“军国主义复活” 日本官方被拒之门外","content":"中国国防部长董军16日在北京举行的年度安全保障会议第十三届北京香山论坛开幕式上致辞时表示：应对一切潜藏的霸权主义、军国主义，保持高度警惕。这一表态被视为对日本的间接批评。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260916-%E9%A6%99%E5%B1%B1%E8%AE%BA%E5%9D%9B%E4%B8%AD%E5%9B%BD%E9%AB%98%E5%B1%82%E6%89%B9%E5%88%A4-%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E5%A4%8D%E6%B4%BB-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%96%B9%E8%A2%AB%E6%8B%92%E4%B9%8B%E9%97%A8%E5%A4%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789543676000.webp","sourceId":"rfi"},{"id":1789579107000,"createdDate":"2026-09-16 17:18","name":"法国国际广播电台","title":"沙特指责也门胡塞武装无人机袭击麦加“触碰红线”","content":"穆斯林世界震惊：沙特阿拉伯周三指责也门胡塞武装对圣城麦加发动了无人机袭击，但这些亲伊朗武装分子对此予以否认。腹背受敌的沙特正面临境内威胁和海上双面夹击：一方面是红海地区的胡塞武装，另一方面是波斯湾地区的伊朗。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260916-%E6%B2%99%E7%89%B9%E6%8C%87%E8%B4%A3%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E9%BA%A6%E5%8A%A0-%E8%A7%A6%E7%A2%B0%E7%BA%A2%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789579107000.webp","sourceId":"rfi"},{"id":1789578167000,"createdDate":"2026-09-16 17:02","name":"法国国际广播电台","title":"视频 通往东南亚的贸易捷径 中国开通平陆运河","content":"平陆运河于今天投入运营，这条位于中国广西壮族自治区的运河，方便中国西南腹地与东盟之间货运，请看视频报道。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260916-%E8%A7%86%E9%A2%91-%E9%80%9A%E5%BE%80%E4%B8%9C%E5%8D%97%E4%BA%9A%E7%9A%84%E8%B4%B8%E6%98%93%E6%8D%B7%E5%BE%84-%E4%B8%AD%E5%9B%BD%E5%BC%80%E9%80%9A%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789578167000.webp","sourceId":"rfi"},{"id":1789572833000,"createdDate":"2026-09-16 15:33","name":"法国国际广播电台","title":"冯德莱恩：欧盟将使用一切工具削减对华贸易逆差","content":"欧盟委员会主席乌尔苏拉·冯德莱恩周三表示，欧盟将采取一切可能的手段来减少其与中国之间“不可持续的”贸易逆差。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E6%AC%A7%E7%9B%9F%E5%B0%86%E4%BD%BF%E7%94%A8%E4%B8%80%E5%88%87%E5%B7%A5%E5%85%B7%E5%89%8A%E5%87%8F%E5%AF%B9%E5%8D%8E%E8%B4%B8%E6%98%93%E9%80%86%E5%B7%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789572833000.webp","sourceId":"rfi"},{"id":1789572629000,"createdDate":"2026-09-16 15:30","name":"法国国际广播电台","title":"澳门首宗涉国安法审判：闭门审判被控“颠覆国家政权罪”的前民主派议员","content":"澳门这一于1999年回归中国的前葡萄牙殖民地，于周三闭门审理首宗涉《国家安全法》案件，审判一名被控犯有“颠覆国家政权罪”的前民主派议员。","newsLink":"http://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260916-%E6%BE%B3%E9%97%A8%E9%A6%96%E5%AE%97%E6%B6%89%E5%9B%BD%E5%AE%89%E6%B3%95%E5%AE%A1%E5%88%A4-%E9%97%AD%E9%97%A8%E5%AE%A1%E5%88%A4%E8%A2%AB%E6%8E%A7-%E9%A2%A0%E8%A6%86%E5%9B%BD%E5%AE%B6%E6%94%BF%E6%9D%83%E7%BD%AA-%E7%9A%84%E5%89%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E8%AE%AE%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789572629000.webp","sourceId":"rfi"},{"id":1789570087000,"createdDate":"2026-09-16 14:48","name":"法国国际广播电台","title":"FT：中国力主釜山协议延至特朗普任满 美国因稀土问题坚持只延6个月","content":"特朗普与习近平峰会在即。双方去年10月在韩国达成的贸易战“休战协议”将于今年11月到期。据金融时报透露，中方主张将该协议延至两年后特朗普任满，但美方只想延长半年，部分原因是稀土。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260916-ft-%E4%B8%AD%E5%9B%BD%E5%8A%9B%E4%B8%BB%E9%87%9C%E5%B1%B1%E5%8D%8F%E8%AE%AE%E5%BB%B6%E8%87%B3%E7%89%B9%E6%9C%97%E6%99%AE%E4%BB%BB%E6%BB%A1-%E7%BE%8E%E5%9B%BD%E5%9B%A0%E7%A8%80%E5%9C%9F%E9%97%AE%E9%A2%98%E5%9D%9A%E6%8C%81%E5%8F%AA%E5%BB%B66%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789570087000.webp","sourceId":"rfi"},{"id":1789568964000,"createdDate":"2026-09-16 14:29","name":"法国国际广播电台","title":"视频 人工智能安全警告日益紧迫 美国领导人的回应","content":"科技界针对人工智能潜在危害发出的警告日益紧迫，各国呼吁政府加强监管的呼声也不断上升，不过特朗普政府反对，请看视频报道。","newsLink":"http://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260916-%E8%A7%86%E9%A2%91-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%AE%89%E5%85%A8%E8%AD%A6%E5%91%8A%E6%97%A5%E7%9B%8A%E7%B4%A7%E8%BF%AB-%E7%BE%8E%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA%E7%9A%84%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789568964000.webp","sourceId":"rfi"},{"id":1789567852000,"createdDate":"2026-09-16 14:10","name":"法国国际广播电台","title":"从欧委会主席冯德莱恩“欧盟国情咨文”看欧盟未来走向","content":"周三（9月16号）所有人的目光都将聚焦斯特拉斯堡，欧盟委员会主席冯德莱恩向欧洲议会发表欧盟年度国情咨文。她的一言一行都受到欧洲议会议员、欧洲各国首都以及市场的密切关注。虽然这项活动很少会带来什么重大惊喜，但确实能让外界解读言外之意：布鲁塞尔认为哪些事情是当务之急，哪些事情是需要加快推进的，以及哪些权力格局将影响未来几个月的走向。近日，欧盟委员会发布了一份文件，概述了自去年国情咨文以来在竞争力、能源独立、外交政策、捍卫民主和国防等领域实施的各项举措。","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260916-%E4%BB%8E%E6%AC%A7%E5%A7%94%E4%BC%9A%E4%B8%BB%E5%B8%AD%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E6%AC%A7%E7%9B%9F%E5%9B%BD%E6%83%85%E5%92%A8%E6%96%87-%E7%9C%8B%E6%AC%A7%E7%9B%9F%E6%9C%AA%E6%9D%A5%E8%B5%B0%E5%90%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/16/1789567852000.webp","sourceId":"rfi"}]