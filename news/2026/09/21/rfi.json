[{"id":1790002231000,"createdDate":"2026-09-21 14:50","name":"法国国际广播电台","title":"白宫公布习近平国事访问安排细节 欢迎仪式将有B-2轰炸机和F-22战机编队飞越","content":"白宫周一以美国第一夫人梅拉尼娅的名义，公布了中国国家主席习近平夫妇本周访问白宫的相关安排细节。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260921-%E7%99%BD%E5%AE%AB%E5%85%AC%E5%B8%83%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%9B%BD%E4%BA%8B%E8%AE%BF%E9%97%AE%E5%AE%89%E6%8E%92%E7%BB%86%E8%8A%82-%E6%AC%A2%E8%BF%8E%E4%BB%AA%E5%BC%8F%E5%B0%86%E6%9C%89b-2%E8%BD%B0%E7%82%B8%E6%9C%BA%E5%92%8Cf-22%E6%88%98%E6%9C%BA%E7%BC%96%E9%98%9F%E9%A3%9E%E8%B6%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1790002231000.webp","sourceId":"rfi"},{"id":1790000601000,"createdDate":"2026-09-21 14:23","name":"法国国际广播电台","title":"美国会调查F-35零部件被转运香港 澳大利亚重视安全协议","content":"澳大利亚军方发言人周一就媒体报道称，一批在悉尼附近制造、原计划运往美国的F-35战斗机零部件被转运并出现在香港一事做出回应。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260921-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E8%B0%83%E6%9F%A5f-35%E9%9B%B6%E9%83%A8%E4%BB%B6%E8%A2%AB%E8%BD%AC%E8%BF%90%E9%A6%99%E6%B8%AF-%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E9%87%8D%E8%A7%86%E5%AE%89%E5%85%A8%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1790000601000.webp","sourceId":"rfi"},{"id":1789999636000,"createdDate":"2026-09-21 14:07","name":"法国国际广播电台","title":"巴拿马旗散货船在新加坡海峡与中国渔船惊险相撞 未有人员伤亡报告","content":"近日，一段视频在网上广泛流传，画面显示一艘散货船在新加坡海峡撞上了一艘中国渔船，巨大的冲击力导致海水涌上这艘小型渔船的甲板，船员们惊慌失措地紧抓船身以防被冲走。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260921-%E5%B7%B4%E6%8B%BF%E9%A9%AC%E6%97%97%E6%95%A3%E8%B4%A7%E8%88%B9%E5%9C%A8%E6%96%B0%E5%8A%A0%E5%9D%A1%E6%B5%B7%E5%B3%A1%E4%B8%8E%E4%B8%AD%E5%9B%BD%E6%B8%94%E8%88%B9%E6%83%8A%E9%99%A9%E7%9B%B8%E6%92%9E-%E6%9C%AA%E6%94%B6%E5%88%B0%E4%BA%BA%E5%91%98%E4%BC%A4%E4%BA%A1%E6%8A%A5%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789999636000.webp","sourceId":"rfi"},{"id":1789997982000,"createdDate":"2026-09-21 13:39","name":"法国国际广播电台","title":"焦点周刊：中国的崛起是否意味着西方的失败？","content":"今日出刊的法国报纸聚焦的重点均有不同，总的来说，有这么几点：第一，美国民众对AI产生的威胁日益担忧，并且有不少民众反对在住宅区附近建立数据中心，这进一步引发与特朗普政府的分歧，毕竟特朗普多次明确表示要大力发展AI产业，尤其不能输给中国，这是费加罗报今日的头条；第二，德国极右翼政党在地方选举中得势，对总理默茨的执政产生威胁，《费加罗报》和《回声报》等多家媒体就这个主题发布深度解析文章；第三是俄罗斯周末的选举，这是《解放报》今日的头条，有两位流亡记者接受《解放报》采访，详细描述了普京建立的类似黑手党的体系，以及这位独裁者并非无坚不摧，乌克兰周日的大规模袭击就是最好的例子。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260921-%E7%84%A6%E7%82%B9%E5%91%A8%E5%88%8A-%E4%B8%AD%E5%9B%BD%E7%9A%84%E5%B4%9B%E8%B5%B7%E6%98%AF%E5%90%A6%E6%84%8F%E5%91%B3%E7%9D%80%E8%A5%BF%E6%96%B9%E7%9A%84%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789997982000.webp","sourceId":"rfi"},{"id":1789997789000,"createdDate":"2026-09-21 13:36","name":"法国国际广播电台","title":"中国对日外交中的“吃水不忘挖井人”情结","content":"目前日中关系依旧非常严峻，中国继续拒绝与日本官方像以往一样交流，但是最近中国却接待了两个日本议员代表团访华。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260921-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E6%97%A5%E5%A4%96%E4%BA%A4%E4%B8%AD%E7%9A%84-%E5%90%83%E6%B0%B4%E4%B8%8D%E5%BF%98%E6%8C%96%E4%BA%95%E4%BA%BA-%E6%83%85%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789997789000.webp","sourceId":"rfi"},{"id":1789997264000,"createdDate":"2026-09-21 13:27","name":"法国国际广播电台","title":"“禁忌故事”（Forbidden Stories）：一项揭露美国大规模驱逐移民机制的调查","content":"从墨西哥到斯威士兰，途经巴拿马，超过25000名移民被美国遣返，但并非遣返回原籍国，而是遣返至第三国。法国国际广播电台（RFI）与其他25家媒体机构共同参与了由国际非营利新闻调查组织“禁忌故事”（ForbiddenStories）协调的调查，该调查题为《驱逐项目：揭露特朗普政府的大规模驱逐行动》（« TheDeportationProject :Révélationssurlesexpulsionsdemassedel'administrationTrump »）。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260921-%E7%A6%81%E5%BF%8C%E6%95%85%E4%BA%8B-forbidden-stories-%E4%B8%80%E9%A1%B9%E6%8F%AD%E9%9C%B2%E7%BE%8E%E5%9B%BD%E5%A4%A7%E8%A7%84%E6%A8%A1%E9%A9%B1%E9%80%90%E7%A7%BB%E6%B0%91%E6%9C%BA%E5%88%B6%E7%9A%84%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789997264000.webp","sourceId":"rfi"},{"id":1789996200000,"createdDate":"2026-09-21 13:10","name":"法国国际广播电台","title":"新西兰军舰穿越台湾海峡  总理称是“例行过境”","content":"新西兰两艘海军舰艇近日通过台湾海峡。新西兰总理卢克森周一表示，这是一次“例行过境”，舰艇是在国际水域内安全、专业地执行任务。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260921-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%86%9B%E8%88%B0%E7%A9%BF%E8%B6%8A%E5%8F%B0%E6%B9%BE%E6%B5%B7%E5%B3%A1-%E6%80%BB%E7%90%86%E7%A7%B0%E6%98%AF-%E4%BE%8B%E8%A1%8C%E8%BF%87%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789996200000.webp","sourceId":"rfi"},{"id":1789992705000,"createdDate":"2026-09-21 12:11","name":"法国国际广播电台","title":"回应国际社会关切，朝鲜再向日本海发射弹道导弹示威","content":"国际原子能署对朝鲜核武研发进展表达忧虑两天之后，日本和韩国有关部门均注意到，平壤当局20日先后向日本海发射两枚弹道导弹。朝鲜官方通讯社21日引述朝鲜外交部发言人指出，任何新的制裁措施都不会阻止朝鲜的发展步伐，也不会阻止朝鲜维护其核心利益。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260921-%E5%9B%9E%E5%BA%94%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%85%B3%E5%88%87%EF%BC%8C%E6%9C%9D%E9%B2%9C%E5%86%8D%E5%90%91%E6%97%A5%E6%9C%AC%E6%B5%B7%E5%8F%91%E5%B0%84%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9%E7%A4%BA%E5%A8%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789992705000.webp","sourceId":"rfi"},{"id":1789986853000,"createdDate":"2026-09-21 10:34","name":"法国国际广播电台","title":"官宣张又侠、刘振立严重违纪违法被开除党籍军籍","content":"官媒新华社周一报导指，经中共中央、中央军委批准，中央军委纪委监委对中央政治局委员、中央军委副主席张又侠，中央军委委员、军委联合参谋部原参谋长刘振立2人立案审查调查。9月21日，中共中央政治局会议审议并通过中央军委《关于张又侠问题审查结果和处理意见的报告》《关于刘振立问题审查结果和处理意见的报告》。决定给予张又侠、刘振立开除党籍处分，终止2人党的二十大代表资格，将涉嫌犯罪问题移送军事检察机关依法审查起诉；此前，中央军委已决定给予张又侠、刘振立开除军籍处分。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260921-%E5%AE%98%E5%AE%A3%E5%BC%A0%E5%8F%88%E4%BE%A0-%E5%88%98%E6%8C%AF%E7%AB%8B%E4%B8%A5%E9%87%8D%E8%BF%9D%E7%BA%AA%E8%BF%9D%E6%B3%95%E8%A2%AB%E5%BC%80%E9%99%A4%E5%85%9A%E7%B1%8D%E5%86%9B%E7%B1%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789986853000.webp","sourceId":"rfi"},{"id":1789985353000,"createdDate":"2026-09-21 10:09","name":"法国国际广播电台","title":"汽车行业危机：德国金属工业工会呼吁周一全国汽车工人举行抗议","content":"周一，德国汽车业工人举行全国性抗议活动。日前，欧洲最大汽车制造商大众汽车发布了一份令人震惊的盈利预警，凸显了该行业正面临高昂成本及来自亚洲竞争对手的激烈挑战所带来的前所未有的困境。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260921-%E6%B1%BD%E8%BD%A6%E8%A1%8C%E4%B8%9A%E5%8D%B1%E6%9C%BA-%E5%BE%B7%E5%9B%BD%E9%87%91%E5%B1%9E%E5%B7%A5%E4%B8%9A%E5%B7%A5%E4%BC%9A%E5%91%BC%E5%90%81%E5%91%A8%E4%B8%80%E5%85%A8%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%B7%A5%E4%BA%BA%E4%B8%BE%E8%A1%8C%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789985353000.webp","sourceId":"rfi"},{"id":1789983736000,"createdDate":"2026-09-21 09:42","name":"法国国际广播电台","title":"澳新海军达成深化合作协议：目标一体化度更高、互操作性更强","content":"新西兰与澳大利亚签署了一项旨在深化两国海军合作的协议。据两国发表的声明，这项名为“塔斯曼计划”（PlanTasman）的协议将加强双方在人员、训练、发展、作战、工程、法规及国际交流等方面的合作。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260921-%E6%BE%B3%E6%96%B0%E6%B5%B7%E5%86%9B%E8%BE%BE%E6%88%90%E6%B7%B1%E5%8C%96%E4%BD%9C%E5%8D%8F%E8%AE%AE-%E7%9B%AE%E6%A0%87%E4%B8%80%E4%BD%93%E5%8C%96%E5%BA%A6%E6%9B%B4%E9%AB%98-%E4%BA%92%E6%93%8D%E4%BD%9C%E6%80%A7%E6%9B%B4%E5%BC%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789983736000.webp","sourceId":"rfi"},{"id":1789981746000,"createdDate":"2026-09-21 09:09","name":"法国国际广播电台","title":"贝森特指美中同意建立AI对话机制重点国安关切 据报未就贸易战休战延期达成协议","content":"在美中两国领导人定于周四在华盛顿举行峰会之际，双方已同意建立人工智能（AI）对话机制。美国财政部长贝森特（ScottBessent）表示，在周日于纽约与中国国务院副总理何立峰的会谈中，双方商定建立这一人工智能对话机制；该构想最初是在特朗普总统5月份于北京会晤习近平主席期间提出的。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260921-%E8%B4%9D%E6%A3%AE%E7%89%B9%E6%8C%87%E7%BE%8E%E4%B8%AD%E5%90%8C%E6%84%8F%E5%BB%BA%E7%AB%8Bai%E5%AF%B9%E8%AF%9D%E6%9C%BA%E5%88%B6%E9%87%8D%E7%82%B9%E5%9B%BD%E5%AE%89%E5%85%B3%E5%88%87-%E6%8D%AE%E6%8A%A5%E6%9C%AA%E5%B0%B1%E8%B4%B8%E6%98%93%E6%88%98%E4%BC%91%E6%88%98%E5%BB%B6%E6%9C%9F%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789981746000.webp","sourceId":"rfi"},{"id":1789977709000,"createdDate":"2026-09-21 08:01","name":"法国国际广播电台","title":"北京官宣习近平将于23日至25日赴美国事访问 峰会前中企再购美国大豆","content":"中国外交部发言人周一（21日）宣布：应美利坚合众国总统特朗普（DonaldTrump）邀请，中国国家主席习近平将于9月23日至25日对美国进行国事访问。习近平上次对美国进行国事访问是在2015年9月，当时正值民主党人奥巴马执政期间。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260921-%E5%8C%97%E4%BA%AC%E8%AF%81%E5%AE%9E%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%B0%86%E4%BA%8E23%E6%97%A5%E8%87%B325%E6%97%A5%E8%B5%B4%E7%BE%8E%E5%9B%BD%E4%BA%8B%E8%AE%BF%E9%97%AE-%E5%B3%B0%E4%BC%9A%E5%89%8D%E4%B8%AD%E4%BC%81%E5%86%8D%E8%B4%AD%E7%BE%8E%E5%9B%BD%E5%A4%A7%E8%B1%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789977709000.webp","sourceId":"rfi"},{"id":1789976929000,"createdDate":"2026-09-21 07:48","name":"法国国际广播电台","title":"董建华「国葬级」丧礼　京官赞扬为「香港实践一国两制的开拓者」不忘提国安","content":"于本月初逝世的香港首任行政长官丶全国政协前副主席董建华，丧礼按「国葬级」规格安排，由中央官员到港主持公祭，并表扬董建华为「香港实践一国两制的开拓者」，更重提他卸任後仍在2019年的反修例运动期间批评「反中乱港」分子来突显他维护国家安全等方面。但有评论呼吁，执政者应以董建华因施政失民心而下台来思量如何落实首份五年计划。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260921-%E8%91%A3%E5%BB%BA%E5%8D%8E-%E5%9B%BD%E8%91%AC%E7%BA%A7-%E4%B8%A7%E7%A4%BC-%E4%BA%AC%E5%AE%98%E8%B5%9E%E6%89%AC%E4%B8%BA-%E9%A6%99%E6%B8%AF%E5%AE%9E%E8%B7%B5%E4%B8%80%E5%9B%BD%E4%B8%A4%E5%88%B6%E7%9A%84%E5%BC%80%E6%8B%93%E8%80%85-%E4%B8%8D%E5%BF%98%E6%8F%90%E5%9B%BD%E5%AE%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789976929000.webp","sourceId":"rfi"},{"id":1789976753000,"createdDate":"2026-09-21 07:45","name":"法国国际广播电台","title":"日本首相高市早苗将在联大讲说中宣布支援海湾国家能源供应计划","content":"日本首相高市早苗于9月21日至24日访问美国纽约，出席第81届联合国大会，并发表一般性辩论演说。据悉，高市早苗将在联合国大会发表的一般性辩论演说中，鉴于当前中东局势日趋紧张，宣布制定一项旨在增强海湾国家经济和能源供应韧性的综合合作计划。她希望通过基础设施建设等方式支持海湾国家，明确表明日本将致力于维护国际能源稳定供应的立场。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260921-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%B0%86%E5%9C%A8%E8%81%94%E5%A4%A7%E8%AE%B2%E8%AF%B4%E4%B8%AD%E5%AE%A3%E5%B8%83%E6%94%AF%E6%8F%B4%E6%B5%B7%E6%B9%BE%E5%9B%BD%E5%AE%B6%E8%83%BD%E6%BA%90%E4%BE%9B%E5%BA%94%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/21/1789976753000.webp","sourceId":"rfi"}]