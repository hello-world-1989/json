[{"id":1788350817000,"createdDate":"2026-09-02 12:06","name":"法国国际广播电台","title":"人权组织批港府加控黄之锋「勾外」罪是倒果为因 友人忧黄刑期或逾10年","content":"创办学民思潮的黄之锋在临近重获自由时被港府以寻求外国制裁香港而加控他勾结外国势力罪，主要理据包括部分国家停止供应香港一些武器或调查装备，香港人权资讯中心批评港府的指控是倒果为因丶推卸责任，而对社运领袖进行无休止的诉讼，是政治报复，目的是彻底消灭反对声音。而数名前学民思潮成员旁听今早的聆讯後估计，黄之锋刑期可能不会低於10年，只望他能有重获自由与家人团聚的一天。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260902-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%89%B9%E6%B8%AF%E5%BA%9C%E5%8A%A0%E6%8E%A7%E9%BB%84%E4%B9%8B%E9%94%8B-%E5%8B%BE%E5%A4%96-%E7%BD%AA%E6%98%AF%E5%80%92%E6%9E%9C%E4%B8%BA%E5%9B%A0-%E5%8F%8B%E4%BA%BA%E5%BF%A7%E9%BB%84%E5%88%91%E6%9C%9F%E6%88%96%E9%80%BE10%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788350817000.webp","sourceId":"rfi"},{"id":1788350079000,"createdDate":"2026-09-02 11:54","name":"法国国际广播电台","title":"中国生成式AI对台认知作战 成本低、效果佳更成功让愤怒、不信任的政治气氛垄罩全台","content":"中国已将认知作战提升为国家战略核心，并视为「第六作战领域」。在对台认知作战上，也因各种因素使其诱因和动机都大大增加。尤其是在科技因素，生成式AI的普及之下，瞬间生成海量的对抗内容更成功让愤怒、不信任与对抗的政治气氛垄罩全台。那么台湾又该如何面对中国的资讯战呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260902-%E4%B8%AD%E5%9B%BD%E7%94%9F%E6%88%90%E5%BC%8Fai%E5%AF%B9%E5%8F%B0%E8%AE%A4%E7%9F%A5%E4%BD%9C%E6%88%98-%E6%88%90%E6%9C%AC%E4%BD%8E-%E6%95%88%E6%9E%9C%E4%BD%B3%E6%9B%B4%E6%88%90%E5%8A%9F%E8%AE%A9%E6%84%A4%E6%80%92-%E4%B8%8D%E4%BF%A1%E4%BB%BB%E7%9A%84%E6%94%BF%E6%B2%BB%E6%B0%94%E6%B0%9B%E5%9E%84%E7%BD%A9%E5%85%A8%E5%8F%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788350079000.webp","sourceId":"rfi"},{"id":1788349465000,"createdDate":"2026-09-02 11:44","name":"法国国际广播电台","title":"任甘肃省代省长 孔绍逊：以实际行动坚决做到“两个维护”","content":"据官媒新华社报导，甘肃省第十四届人民代表大会常务委员会第二十五次会议周三（2日）决定，接受任振鹤因工作变动辞去甘肃省人民政府省长职务的请求，任命孔绍逊为甘肃省人民政府副省长、代省长。","newsLink":"https://www.rfi.fr/cn/%E4%BB%BB%E7%94%98%E8%82%83%E7%9C%81%E4%BB%A3%E7%9C%81%E9%95%BF-%E5%AD%94%E7%BB%8D%E9%80%8A-%E4%BB%A5%E5%AE%9E%E9%99%85%E8%A1%8C%E5%8A%A8%E5%9D%9A%E5%86%B3%E5%81%9A%E5%88%B0-%E4%B8%A4%E4%B8%AA%E7%BB%B4%E6%8A%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788349465000.webp","sourceId":"rfi"},{"id":1788346862000,"createdDate":"2026-09-02 11:01","name":"法国国际广播电台","title":"习近平开罗行将助华为“甩美”得标埃及AI数据中心？千年从未离开法国的《贝叶挂毯》“出使”英国","content":"大家好，欢迎收听法国报纸摘要，周三9月2日出刊的《费加罗报》头版着重在关税议题，指出自2025年1月以来，美国贸易政策已变动超过50次，其间充斥着威胁、反复和谈判。一年半过去了，特朗普这场孤注一掷的赌博，最终搬起石头砸了自己的脚！此外，中国国家主席习近平今对开罗进行十年来的首次正式访问。对此《回升报》分析称，中国希望利用埃及的地缘政治形势和苏伊士运河，而埃及则试图减少对其他伙伴的依赖。预计双方会谈将聚焦于开罗方面所希望的中美经济关系再平衡问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260902-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%BC%80%E7%BD%97%E8%A1%8C%E5%B0%86%E5%8A%A9%E5%8D%8E%E4%B8%BA-%E7%94%A9%E7%BE%8E-%E5%BE%97%E6%A0%87%E5%9F%83%E5%8F%8Aai%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83-%E5%8D%83%E5%B9%B4%E4%BB%8E%E6%9C%AA%E7%A6%BB%E5%BC%80%E6%B3%95%E5%9B%BD%E7%9A%84-%E8%B4%9D%E5%8F%B6%E6%8C%82%E6%AF%AF-%E5%87%BA%E4%BD%BF-%E8%8B%B1%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788346862000.webp","sourceId":"rfi"},{"id":1788343512000,"createdDate":"2026-09-02 10:05","name":"法国国际广播电台","title":"欧盟贸易委员：中方须在10月前拿出具体成果，否则将面临更严厉措施","content":"欧盟委员会贸易和经济安全委员谢夫乔维奇（MarošŠefčovič）在接受欧洲新闻台采访时表示，旨在平衡激增的贸易逆差的谈判“极具政治性”，而欧洲领导人正寻求北京方面作出明确承诺。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260902-%E6%AC%A7%E7%9B%9F%E8%B4%B8%E6%98%93%E5%A7%94%E5%91%98-%E4%B8%AD%E6%96%B9%E9%A1%BB%E5%9C%A810%E6%9C%88%E5%89%8D%E6%8B%BF%E5%87%BA%E5%85%B7%E4%BD%93%E6%88%90%E6%9E%9C%EF%BC%8C%E5%90%A6%E5%88%99%E5%B0%86%E9%9D%A2%E4%B8%B4%E6%9B%B4%E4%B8%A5%E5%8E%89%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788343512000.webp","sourceId":"rfi"},{"id":1788341836000,"createdDate":"2026-09-02 09:37","name":"法国国际广播电台","title":"索取“气候相关赔偿” 尼泊尔外长：中美印有历史责任向我国等脆弱国家提供赔偿","content":"尼泊尔正寻求就博特科希河（波曲下游尼泊尔边）发生的致命山洪灾害，向美国、印度和中国——这三个被该喜马拉雅国家指为主要温室气体排放国的国家——索取“气候相关赔偿”。一周前，这场洪水席卷了该国至少三个地区的村庄。尽管救援队迄今已寻获逾1100具遇难者遗体，但仍有近4500人下落不明；此前，高海拔冰川崩塌引发了裹挟着冰冷河水、岩石和碎屑的巨大洪流，于上周沿中尼边境奔腾而下。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260902-%E7%B4%A2%E5%8F%96-%E6%B0%94%E5%80%99%E7%9B%B8%E5%85%B3%E8%B5%94%E5%81%BF-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%A4%96%E9%95%BF-%E4%B8%AD%E7%BE%8E%E5%8D%B0%E6%9C%89%E5%8E%86%E5%8F%B2%E8%B4%A3%E4%BB%BB%E5%90%91%E6%88%91%E5%9B%BD%E7%AD%89%E8%84%86%E5%BC%B1%E5%9B%BD%E5%AE%B6%E6%8F%90%E4%BE%9B%E8%B5%94%E5%81%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788341836000.webp","sourceId":"rfi"},{"id":1788339962000,"createdDate":"2026-09-02 09:06","name":"法国国际广播电台","title":"德财长：德国产业界对中国看法变得更具批判性 企业呼吁恢复每周40小时工作制","content":"德国副总理兼财政部长克林拜尔（LarsKlingbeil）在访问位于美国南卡罗来纳州斯帕坦堡的宝马工厂后表示，德国计划在未来几周内就一系列措施达成一致，以应对其视为不公平的中国贸易做法。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260902-%E5%BE%B7%E8%B4%A2%E9%95%BF-%E5%BE%B7%E5%9B%BD%E4%BA%A7%E4%B8%9A%E7%95%8C%E5%AF%B9%E4%B8%AD%E5%9B%BD%E7%9C%8B%E6%B3%95%E5%8F%98%E5%BE%97%E6%9B%B4%E5%85%B7%E6%89%B9%E5%88%A4%E6%80%A7-%E4%BC%81%E4%B8%9A%E5%91%BC%E5%90%81%E6%81%A2%E5%A4%8D%E6%AF%8F%E5%91%A840%E5%B0%8F%E6%97%B6%E5%B7%A5%E4%BD%9C%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788339962000.webp","sourceId":"rfi"},{"id":1788338729000,"createdDate":"2026-09-02 08:45","name":"法国国际广播电台","title":"尼泊尔洪灾遇难人数攀升至近1200人，中方灾情信息更新明显滞后","content":"中尼边境的致命洪灾和泥石流发生至今已过去一周。周三，遇难人数持续攀升，尼泊尔官员表示，这起洪灾已造成至少1118人死亡，另有3900多人失踪。而中国方面公布的数据仍停留在29日，当局称，截至29日，中方有16人遇难，546人失联。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260902-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE%E9%81%87%E9%9A%BE%E4%BA%BA%E6%95%B0%E6%94%80%E5%8D%87%E8%87%B3%E8%BF%911200%E4%BA%BA%EF%BC%8C%E4%B8%AD%E6%96%B9%E7%81%BE%E6%83%85%E4%BF%A1%E6%81%AF%E6%9B%B4%E6%96%B0%E6%98%8E%E6%98%BE%E6%BB%9E%E5%90%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788338729000.webp","sourceId":"rfi"},{"id":1788338254000,"createdDate":"2026-09-02 08:37","name":"法国国际广播电台","title":"台湾企业计划对美投资三个月再增200亿美元","content":"台湾经济部长周三（9月2日）表示，受人工智能应用需求热络驱动，台湾企业计划对美国投资再追加200亿美元，但未透露具体细节。正在台湾出席展会的美国商务部官员对此表示欢迎。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260902-%E5%8F%B0%E6%B9%BE%E4%BC%81%E4%B8%9A%E8%AE%A1%E5%88%92%E5%AF%B9%E7%BE%8E%E6%8A%95%E8%B5%84%E5%86%8D%E5%A2%9E200%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788338254000.webp","sourceId":"rfi"},{"id":1788336642000,"createdDate":"2026-09-02 08:10","name":"法国国际广播电台","title":"前总统蔡英文现身挺绿营参选人 蓝营称新北一战「对手是蔡英文而非苏巧慧」","content":"九合一选举在8月31日起开放登记，蓝绿白阵营各县市参选人陆续完成参选登记。前总统蔡英文2日现身挺台北市长参选人沈伯洋。新北市参选人苏巧慧也找了蔡英文出任竞选总部主委。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260902-%E5%89%8D%E6%80%BB%E7%BB%9F%E8%94%A1%E8%8B%B1%E6%96%87%E7%8E%B0%E8%BA%AB%E6%8C%BA%E7%BB%BF%E8%90%A5%E5%8F%82%E9%80%89%E4%BA%BA-%E8%93%9D%E8%90%A5%E7%A7%B0%E6%96%B0%E5%8C%97%E4%B8%80%E6%88%98-%E5%AF%B9%E6%89%8B%E6%98%AF%E8%94%A1%E8%8B%B1%E6%96%87%E8%80%8C%E9%9D%9E%E8%8B%8F%E5%B7%A7%E6%85%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788336642000.webp","sourceId":"rfi"},{"id":1788336042000,"createdDate":"2026-09-02 08:00","name":"法国国际广播电台","title":"加拿大启动第二轮输入中国电动车计划 美资特斯拉成最大受益者","content":"加拿大政府于9月1日启动中国制电动车配额的第二期计划，供进口的中国制电动车可以达到33,397辆。至于第一阶段半年的执行结果，呈现出极具戏剧性一幕，15,000辆电动车中80%配额，竟然被美资的特斯拉（Tesla）占用。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260902-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%90%AF%E5%8A%A8%E7%AC%AC%E4%BA%8C%E8%BD%AE%E8%BE%93%E5%85%A5%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%8A%A8%E8%BD%A6%E8%AE%A1%E5%88%92-%E7%BE%8E%E8%B5%84%E7%89%B9%E6%96%AF%E6%8B%89%E6%88%90%E6%9C%80%E5%A4%A7%E5%8F%97%E7%9B%8A%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788336042000.webp","sourceId":"rfi"},{"id":1788335743000,"createdDate":"2026-09-02 07:55","name":"法国国际广播电台","title":"普京表示：日俄关系恶化责任“100%在日本”","content":"俄罗斯总统普京9月2在访问中亚国家吉尔吉斯斯坦期间向记者表示，对于日本方面对其访问北方四岛的反应，“并不感到意外”。他还声称，有关日俄关系恶化，“俄罗斯没有做任何导致与日本关系恶化的事情”，两国关系恶化的责任“100%在日本政府”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260902-%E6%99%AE%E4%BA%AC%E8%A1%A8%E7%A4%BA-%E6%97%A5%E4%BF%84%E5%85%B3%E7%B3%BB%E6%81%B6%E5%8C%96%E8%B4%A3%E4%BB%BB-100-%E5%9C%A8%E6%97%A5%E6%9C%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788335743000.webp","sourceId":"rfi"},{"id":1788335469000,"createdDate":"2026-09-02 07:51","name":"法国国际广播电台","title":"狱中黄之锋认游说外国制裁中港 港警调查软件因此被停 法官押後判刑","content":"曾在不同社运中带领学生参与的黄之锋，已被囚5年10个月，原本预计可於明年1月重获自由，但当局在狱中加控他与流亡英国的罗冠听等人串谋请求外国制裁中港政府，并导致以色列鉴证软件Cellebrite停止向香港警察提供服务，触犯「串谋勾结外国或者境外势力危害国家安全」(勾外)罪，黄之锋承认控罪，國安法指定法官将案押後判刑，但没有日期，只说会尽快。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260902-%E7%8B%B1%E4%B8%AD%E9%BB%84%E4%B9%8B%E9%94%8B%E8%AE%A4%E6%B8%B8%E8%AF%B4%E5%A4%96%E5%9B%BD%E5%88%B6%E8%A3%81%E4%B8%AD%E6%B8%AF-%E6%B8%AF%E8%AD%A6%E8%B0%83%E6%9F%A5%E8%BD%AF%E4%BB%B6%E5%9B%A0%E6%AD%A4%E8%A2%AB%E5%81%9C-%E6%B3%95%E5%AE%98%E6%8A%BC%E5%BE%8C%E5%88%A4%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/02/1788335469000.webp","sourceId":"rfi"}]