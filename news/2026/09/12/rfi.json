[{"id":1789214911000,"createdDate":"2026-09-12 12:08","name":"法国国际广播电台","title":"澳门将举行首场依据《国安法》的审判","content":"澳门法院周五宣布，将在下周闭门审理首起依据国家安全法提起的诉讼，被告是一位被控犯有“颠覆国家”罪的前民主派议员。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260912-%E6%BE%B3%E9%97%A8%E5%B0%86%E4%B8%BE%E8%A1%8C%E9%A6%96%E5%9C%BA%E4%BE%9D%E6%8D%AE-%E5%9B%BD%E5%AE%89%E6%B3%95-%E7%9A%84%E5%AE%A1%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789214911000.webp","sourceId":"rfi"},{"id":1789212403000,"createdDate":"2026-09-12 11:26","name":"法国国际广播电台","title":"中方据报告知美方若峰会前有新的对台军售将取消习特会","content":"据共同社报导，多位熟悉美中双边关系的消息人士周六透露称，中方已告知美方，如果华盛顿在此之前批准任何新的对台军售，中方有意将取消定于本月晚些时候举行的两国领导人会晤。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260912-%E4%B8%AD%E6%96%B9%E6%8D%AE%E6%8A%A5%E5%91%8A%E7%9F%A5%E7%BE%8E%E6%96%B9%E8%8B%A5%E5%B3%B0%E4%BC%9A%E5%89%8D%E6%9C%89%E6%96%B0%E7%9A%84%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%E5%B0%86%E5%8F%96%E6%B6%88%E4%B9%A0%E7%89%B9%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789212403000.webp","sourceId":"rfi"},{"id":1789207955000,"createdDate":"2026-09-12 10:12","name":"法国国际广播电台","title":"香港支联会案判刑 联合国人权高专呼吁撤销判决","content":"已解散的香港市民支援爱国民主运动联合会（简称支联会）、前主席李卓人、前副主席何俊仁及邹幸彤涉及煽动他人颠覆国家政权罪。何俊仁开审前认罪；支联会、李卓人及邹幸彤否认控罪，受审后被裁定罪成。案件周五在香港高等法院（借用西九龙裁判法院）作判刑。首被告支联会罚款150万元，李卓人判7年监禁、何俊仁判囚5年2个月、邹幸彤判囚7年3个月。对此，联合国人权高专办发言人马甘戈（SeifMagango）通过新闻稿表示，“今天对三名活动人士判处长期监禁，并对与其相关的民间社会组织处以巨额罚款，这是存在严重缺陷的该《国家安全法》带来的又一个令人遗憾的后果”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260912-%E9%A6%99%E6%B8%AF%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E5%88%A4%E5%88%91-%E8%81%94%E5%90%88%E5%9B%BD%E4%BA%BA%E6%9D%83%E9%AB%98%E4%B8%93%E5%91%BC%E5%90%81%E6%92%A4%E9%94%80%E5%88%A4%E5%86%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789207955000.webp","sourceId":"rfi"},{"id":1789205510000,"createdDate":"2026-09-12 09:31","name":"法国国际广播电台","title":"7月一美军基地遭袭酿3死 美官员称伊朗前后曾从中国实体获取卫星图像","content":"据《华尔街日报》援引熟悉事件细节的美国官员报导称，在伊朗于7月发动袭击、造成三名美军人员死亡之前，伊朗方面曾从多家中国实体获取了后来遭袭的约旦境内美军基地的高分辨率卫星图像。上述官员称，这是迄今为止最确凿的证据，表明中方在这场战争期间对伊朗的支持给美军造成了致命后果。他们还称，美方已将这些图像与此次袭击联系起来。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260912-7%E6%9C%88%E4%B8%80%E7%BE%8E%E5%86%9B%E5%9F%BA%E5%9C%B0%E9%81%AD%E8%A2%AD%E9%85%BF3%E6%AD%BB-%E7%BE%8E%E5%AE%98%E5%91%98%E7%A7%B0%E4%BC%8A%E6%9C%97%E5%89%8D%E5%90%8E%E6%9B%BE%E8%8E%B7%E5%8F%96%E4%B8%AD%E5%9B%BD%E5%AE%9E%E4%BD%93%E7%9A%84%E5%8D%AB%E6%98%9F%E5%9B%BE%E5%83%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789205510000.webp","sourceId":"rfi"},{"id":1789203276000,"createdDate":"2026-09-12 08:54","name":"法国国际广播电台","title":"特朗普表示不反对中国在美国建厂生产汽车","content":"尽管美国立法者和汽车公司普遍反对，但美国总统唐纳德·特朗普周五(9月11号)表示，他不会反对中国汽车制造商在美国建厂。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260912-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A1%A8%E7%A4%BA-%E4%B8%8D%E5%8F%8D%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%9C%A8%E7%BE%8E%E5%9B%BD%E5%BB%BA%E5%8E%82%E7%94%9F%E4%BA%A7%E6%B1%BD%E8%BD%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789203276000.webp","sourceId":"rfi"},{"id":1789200832000,"createdDate":"2026-09-12 08:13","name":"法国国际广播电台","title":"报复日本提高赴日签证费 中国将日本人赴华签证费提高至约7倍","content":"中国驻日本大使馆11日宣布，自14日起，将向赴华访问的日本人发放签证（Visa）的费用提高至原来的约7倍。日本政府已从7月起，将向访日外国人收取的签证签发费提高至与主要国家相当的水平，大幅上调约达5倍。中国驻日大使馆对此解释称，这是“基于对等原则采取的措施”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260912-%E6%8A%A5%E5%A4%8D%E6%97%A5%E6%9C%AC%E6%8F%90%E9%AB%98%E8%B5%B4%E6%97%A5%E7%AD%BE%E8%AF%81%E8%B4%B9-%E4%B8%AD%E5%9B%BD%E5%B0%86%E6%97%A5%E6%9C%AC%E4%BA%BA%E8%B5%B4%E5%8D%8E%E7%AD%BE%E8%AF%81%E8%B4%B9%E6%8F%90%E9%AB%98%E8%87%B3%E7%BA%A67%E5%80%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789200832000.webp","sourceId":"rfi"},{"id":1789238313000,"createdDate":"2026-09-12 18:38","name":"法国国际广播电台","title":"印度外交部：莫迪与习近平承诺以“公正合理”方式解决中印边界争端","content":"印度总理莫迪和中国国家主席习近平周六（9月12日）在金砖国家峰会期间举行会晤。印度外交部在会谈结束后发表声明称：“两国领导人承诺以公正、合理且双方均可接受的方式解决边界问题。”","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260912-%E5%8D%B0%E5%BA%A6%E5%A4%96%E4%BA%A4%E9%83%A8-%E8%8E%AB%E8%BF%AA%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%89%BF%E8%AF%BA%E4%BB%A5-%E5%85%AC%E6%AD%A3%E5%90%88%E7%90%86-%E6%96%B9%E5%BC%8F%E8%A7%A3%E5%86%B3%E4%B8%AD%E5%8D%B0%E8%BE%B9%E7%95%8C%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789238313000.webp","sourceId":"rfi"},{"id":1789236679000,"createdDate":"2026-09-12 18:11","name":"法国国际广播电台","title":"法国火车脱轨致44人受伤：事故现场发现超200公斤铁轨，检方称暂无迹象表明是恐袭","content":"法国西北部一列火车于周五晚间发生脱轨事故，造成44人受伤。法国警方一名消息人士周六（9月12日）向法新社透露，调查人员目前重点怀疑这起事故涉及恶意行为，原因是在事故现场的铁轨上发现了一段铁轨。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260912-%E6%B3%95%E5%9B%BD%E7%81%AB%E8%BD%A6%E8%84%B1%E8%BD%A8%E8%87%B444%E4%BA%BA%E5%8F%97%E4%BC%A4-%E4%BA%8B%E6%95%85%E7%8E%B0%E5%9C%BA%E5%8F%91%E7%8E%B0%E8%B6%85200%E5%85%AC%E6%96%A4%E9%93%81%E8%BD%A8%EF%BC%8C%E6%A3%80%E6%96%B9%E7%A7%B0%E6%9A%82%E6%97%A0%E8%BF%B9%E8%B1%A1%E8%A1%A8%E6%98%8E%E6%98%AF%E6%81%90%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789236679000.webp","sourceId":"rfi"},{"id":1789234320000,"createdDate":"2026-09-12 17:32","name":"法国国际广播电台","title":"特朗普就爱尔兰敏感议题发表意见：如果爱尔兰统一将是“一件很棒的事”","content":"美国总统特朗普周六（9月12日）就爱尔兰国内一项高度敏感的政治议题发表看法，他说，如果爱尔兰实现统一，那将是“一件很棒的事”。同时他补充道，“显然，英国也会对此有自己的看法。”他是在周末访问自己位于爱尔兰的高尔夫球场并观看高尔夫球赛事期间说出上述这番言论的，此次出访主要是为了观看比赛，但他在都柏林与爱尔兰总理米歇尔·马丁举行新闻发布会时，突然介入这一格外敏感的政治议题。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260912-%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%B1%E7%88%B1%E5%B0%94%E5%85%B0%E6%95%8F%E6%84%9F%E8%AE%AE%E9%A2%98%E5%8F%91%E8%A1%A8%E6%84%8F%E8%A7%81-%E5%A6%82%E6%9E%9C%E7%88%B1%E5%B0%94%E5%85%B0%E7%BB%9F%E4%B8%80%E5%B0%86%E6%98%AF-%E4%B8%80%E4%BB%B6%E5%BE%88%E6%A3%92%E7%9A%84%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789234320000.webp","sourceId":"rfi"},{"id":1789231123000,"createdDate":"2026-09-12 16:38","name":"法国国际广播电台","title":"Anthropic阿莫迪：AI研发竞赛亟需放缓 提与中方进行AI的类比冷战战略武器限制谈判","content":"美国人工智能企业Anthropic的首席执行官阿莫迪（DarioAmodei）在当地时间周六早些时候发表的一篇文章中表示，人工智能研发竞赛亟需放缓。阿莫迪在这篇题为“我们必须调控这一边疆的节奏”的文章中写道，“我们必须放慢改进人工智能模型能力的步伐。进展看起来仍然很快，我们必须明智地利用我们获得的时间”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260912-anthropic%E9%98%BF%E8%8E%AB%E8%BF%AA-ai%E7%A0%94%E5%8F%91%E7%AB%9E%E8%B5%9B%E4%BA%9F%E9%9C%80%E6%94%BE%E7%BC%93-%E6%8F%90%E4%B8%8E%E4%B8%AD%E6%96%B9%E8%BF%9B%E8%A1%8C%E7%B1%BB%E6%AF%94%E5%86%B7%E6%88%98%E6%88%98%E7%95%A5%E6%AD%A6%E5%99%A8%E9%99%90%E5%88%B6%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789231123000.webp","sourceId":"rfi"},{"id":1789228271000,"createdDate":"2026-09-12 15:51","name":"法国国际广播电台","title":"印度金砖国家峰会 伊朗战争考验团结","content":"年度金砖国家领导人峰会于9月12日至13日在印度首都新德里举行，印度总理莫迪主办的这次峰会力图提升该集团的全球地位。在全球地缘政治紧张局势加剧、能源市场、航运和全球贸易受到干扰的大背景下。预计战争、贸易和能源问题将成为此次峰会的核心议题。中东和乌克兰冲突，以及由此引发的全球贸易和能源动荡等主题，将主导此次峰会。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260912-%E5%8D%B0%E5%BA%A6%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A-%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E8%80%83%E9%AA%8C%E5%9B%A2%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789228271000.webp","sourceId":"rfi"},{"id":1789225424000,"createdDate":"2026-09-12 15:03","name":"法国国际广播电台","title":"泽连斯基表示愿在美G20峰会期间会见普京 克宫：他可以飞莫斯科","content":"在周六发布的一则采访中，乌克兰总统泽连斯基表示，愿意在定于12月中旬在美国迈阿密举行的二十国集团（G20）峰会上与俄罗斯总统普京会面，就结束俄乌战争进行磋商。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260912-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%A1%A8%E7%A4%BA%E6%84%BF%E5%9C%A8%E7%BE%8E%E5%8F%82%E5%8A%A0g20%E5%B3%B0%E4%BC%9A%E6%9C%9F%E9%97%B4%E4%BC%9A%E8%A7%81%E6%99%AE%E4%BA%AC-%E5%85%8B%E5%AE%AB-%E4%BB%96%E5%8F%AF%E4%BB%A5%E9%A3%9E%E8%8E%AB%E6%96%AF%E7%A7%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789225424000.webp","sourceId":"rfi"},{"id":1789220340000,"createdDate":"2026-09-12 13:39","name":"法国国际广播电台","title":"涉嫌在肯尼迪航天中心禁飞区操控无人机 一中国游客被起诉","content":"联邦检察官称，一名中国游客无视肯尼迪航天中心附近的禁飞规定，目前面临刑事指控。调查人员称，此人操作一架无人机飞越受保护的空域，并拍摄了美国国家航空航天局（NASA）重要设施的视频。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260912-%E6%B6%89%E5%AB%8C%E5%9C%A8%E8%82%AF%E5%B0%BC%E8%BF%AA%E8%88%AA%E5%A4%A9%E4%B8%AD%E5%BF%83%E7%A6%81%E9%A3%9E%E5%8C%BA%E6%93%8D%E6%8E%A7%E6%97%A0%E4%BA%BA%E6%9C%BA-%E4%B8%80%E4%B8%AD%E5%9B%BD%E6%B8%B8%E5%AE%A2%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789220340000.webp","sourceId":"rfi"},{"id":1789216800000,"createdDate":"2026-09-12 12:40","name":"法国国际广播电台","title":"韩国非洲为建人工智能枢纽签约","content":"在首尔（Séoul）召开的第八届韩国与非洲经济合作部长级会议(SommetKOAFEC2026)已于09月11日周五落下帷幕。这是本台法广非洲组（RFIAfrique）今天09月12日星期六刊出的最新法文消息之一。来自会议现场的消息说，韩国与非洲大陆就建立人工智能（AI）专用枢纽签署了一系列的协议。法国国际广播电台的法语通讯员发回了对[非洲开发银行]（AfDB/BAD）一名与会部门主管的实地采访录音片段。这位出自塞内加尔（leSénégal）的金融界人士为非洲开发与基础设施融资领域资深专家。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260912-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9F%A9%E5%9B%BD%E9%9D%9E%E6%B4%B2%E4%B8%BA%E5%BB%BA%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%9E%A2%E7%BA%BD%E7%AD%BE%E7%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789216800000.webp","sourceId":"rfi"},{"id":1789216468000,"createdDate":"2026-09-12 12:34","name":"法国国际广播电台","title":"韩国海警、海军行动打击中国渔船非法捕捞 查扣1艘渔船 驱离91艘","content":"韩国中部地方海洋警察厅周六（12日）宣布，海警10日在仁川市瓮津郡大青岛近海打击中国渔船的非法捕捞，查扣一艘70吨级中国渔船A号，并驱离91艘渔船。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260912-%E9%9F%A9%E5%9B%BD%E6%B5%B7%E8%AD%A6-%E6%B5%B7%E5%86%9B%E8%A1%8C%E5%8A%A8%E6%89%93%E5%87%BB%E4%B8%AD%E5%9B%BD%E6%B8%94%E8%88%B9%E9%9D%9E%E6%B3%95%E6%8D%95%E6%8D%9E-%E6%9F%A5%E6%89%A31%E8%89%98%E6%B8%94%E8%88%B9-%E9%A9%B1%E7%A6%BB91%E8%89%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/12/1789216468000.webp","sourceId":"rfi"}]