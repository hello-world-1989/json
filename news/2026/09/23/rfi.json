[{"id":1790168910000,"createdDate":"2026-09-23 13:08","name":"法国国际广播电台","title":"习近平启程前往美国 将与特朗普举行峰会","content":"中国国家主席习近平于周三下午启程前往美国，将与唐纳德·特朗普举行峰会，届时两国领导人预计将寻求延续两国关系缓和的态势。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%AF%E7%A8%8B%E5%89%8D%E5%BE%80%E7%BE%8E%E5%9B%BD-%E5%B0%86%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%BE%E8%A1%8C%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790168910000.webp","sourceId":"rfi"},{"id":1790166713000,"createdDate":"2026-09-23 12:31","name":"法国国际广播电台","title":"伊朗总统抵纽约将在联大发言 美国首次向交战敌国首脑发签证 特朗普称对话已恢复","content":"伊朗总统马苏德·佩泽什基安已经抵达纽约，他将于周三在联合国年度大会期间，于联合国大会堂发表讲话。分析指这是美国首次向与美国处于战争状态的国家元首签发签证。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E6%8A%B5%E7%BA%BD%E7%BA%A6%E5%B0%86%E5%9C%A8%E8%81%94%E5%A4%A7%E5%8F%91%E8%A8%80-%E7%BE%8E%E5%9B%BD%E9%A6%96%E6%AC%A1%E5%90%91%E4%BA%A4%E6%88%98%E6%95%8C%E5%9B%BD%E9%A6%96%E8%84%91%E5%8F%91%E7%AD%BE%E8%AF%81-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%AF%B9%E8%AF%9D%E5%B7%B2%E6%81%A2%E5%A4%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790166713000.webp","sourceId":"rfi"},{"id":1790159726000,"createdDate":"2026-09-23 10:35","name":"法国国际广播电台","title":"韩国确认首个对美3500亿美元投资项目","content":"韩国总统府周三宣布，韩国总统李在明和美国总统特朗普在联合国大会期间举行了30分钟会晤，双方对战略投资项目讨论取得的“显著进展”表示欢迎。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260923-%E9%9F%A9%E5%9B%BD%E7%A1%AE%E8%AE%A4%E9%A6%96%E4%B8%AA%E5%AF%B9%E7%BE%8E3500%E4%BA%BF%E7%BE%8E%E5%85%83%E6%8A%95%E8%B5%84%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790159726000.webp","sourceId":"rfi"},{"id":1790156312000,"createdDate":"2026-09-23 09:38","name":"法国国际广播电台","title":"法广2026年9月23日第一次播音北京时间6至7点","content":"","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%AC%AC%E4%B8%80%E6%AC%A1%E6%92%AD%E9%9F%B3-06-00-07-00-%E5%8C%97%E4%BA%AC%E6%97%B6%E9%97%B4/20260923-%E6%B3%95%E5%B9%BF2026%E5%B9%B49%E6%9C%8823%E6%97%A5%E7%AC%AC%E4%B8%80%E6%AC%A1%E6%92%AD%E9%9F%B3%E5%8C%97%E4%BA%AC%E6%97%B6%E9%97%B46%E8%87%B37%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790156312000.webp","sourceId":"rfi"},{"id":1790154084000,"createdDate":"2026-09-23 09:01","name":"法国国际广播电台","title":"日美首脑举行会谈 围绕中国问题等坦率交换意见","content":"高市早苗首相于当地时间22日在访问美国纽约期间，与美国总统特朗普举行了会谈。高市日本时间23日在社交媒体“X”上表示，就中国、朝鲜等问题，与特朗普总统进行了坦率的意见交换。特别是对于她本人正下定决心致力解决的绑架问题，她再次强调了立即解决这一问题的重要性，并获得了特朗普总统的全面支持。她指出：除此之外，双方还就国际刑事法院（ICC）问题坦率交换了的意见。此前高市首相表示：美国制裁国际刑事法院日本籍院长赤根智子，“与重视法治的日本立场并不相容。我们对此高度重视，并认为事态非常严重”。而美国总统特朗普22日批评国际刑事法院是一个“失控的机构”，并呼吁所有成员国立即退出该机构。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260923-%E6%97%A5%E7%BE%8E%E9%A6%96%E8%84%91%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88-%E5%9B%B4%E7%BB%95%E4%B8%AD%E5%9B%BD%E9%97%AE%E9%A2%98%E7%AD%89%E5%9D%A6%E7%8E%87%E4%BA%A4%E6%8D%A2%E6%84%8F%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790154084000.webp","sourceId":"rfi"},{"id":1790153662000,"createdDate":"2026-09-23 08:54","name":"法国国际广播电台","title":"特习会前 台湾称将继续与美国就军售问题保持“密切联系”","content":"在中国国家主席习近平抵达华盛顿与美国总统唐纳德·特朗普会晤之际，台湾方面表示，尽管面临来自中国的压力，他们仍然相信美国对台军售将继续进行。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%89%8D-%E5%8F%B0%E6%B9%BE%E7%A7%B0%E5%B0%86%E7%BB%A7%E7%BB%AD%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%B0%B1%E5%86%9B%E5%94%AE%E9%97%AE%E9%A2%98%E4%BF%9D%E6%8C%81-%E5%AF%86%E5%88%87%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790153662000.webp","sourceId":"rfi"},{"id":1790151057000,"createdDate":"2026-09-23 08:10","name":"法国国际广播电台","title":"高雄市举办国际儿童及青少年嘉年华 法国主题馆庆经典文学《小王子》80周年","content":"台湾国际儿童与青少年嘉年华于23到27日在高雄登场，法国作为今年主题馆展示《小王子》80周年纪念版。多位法国图文创作者受邀来台举办讲座与工作坊。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E9%AB%98%E9%9B%84%E5%B8%82%E4%B8%BE%E5%8A%9E%E5%9B%BD%E9%99%85%E5%84%BF%E7%AB%A5%E5%8F%8A%E9%9D%92%E5%B0%91%E5%B9%B4%E5%98%89%E5%B9%B4%E5%8D%8E-%E6%B3%95%E5%9B%BD%E4%B8%BB%E9%A2%98%E9%A6%86%E5%BA%86%E7%BB%8F%E5%85%B8%E6%96%87%E5%AD%A6-%E5%B0%8F%E7%8E%8B%E5%AD%90-80%E5%91%A8%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790151057000.webp","sourceId":"rfi"},{"id":1790150554000,"createdDate":"2026-09-23 08:02","name":"法国国际广播电台","title":"欧盟指国安已融入香港管治　港府压制性使用国安法律损人权 影响续扩大","content":"欧盟发表最新的香港政治与经济发展年度报告，批评港府在多宗国家安全案件中，压制性地使用国安相关法律，对异见者施以长期审前羁押等，侵犯人权，关注港府利用打击「软对抗」，针对独立书店丶文化活动和媒体等情况，敦促中国和香港政府恢复全面尊重法治丶基本自由及民主原则。港府对报告内容表示强烈不满和反对，重申任何外国或外部势力诋毁香港，均不会得逞。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E6%AC%A7%E7%9B%9F%E6%8C%87%E5%9B%BD%E5%AE%89%E5%B7%B2%E8%9E%8D%E5%85%A5%E9%A6%99%E6%B8%AF%E7%AE%A1%E6%B2%BB-%E6%B8%AF%E5%BA%9C%E5%8E%8B%E5%88%B6%E6%80%A7%E4%BD%BF%E7%94%A8%E5%9B%BD%E5%AE%89%E6%B3%95%E5%BE%8B%E6%8D%9F%E4%BA%BA%E6%9D%83-%E5%BD%B1%E5%93%8D%E7%BB%AD%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790150554000.webp","sourceId":"rfi"},{"id":1790150154000,"createdDate":"2026-09-23 07:55","name":"法国国际广播电台","title":"「无国界记者」指国安法后港媒成中国宣传工具 新闻工作刑事化成香港新常态","content":"「无国界记者」（RSF）最新的研究追踪中国全球宣传机器的运作，指中国不仅压制境内媒体和言论自由，更试图把这类威权式的信息控制模式向外输出，建立「世界媒体新秩序」，以取代新闻工作，并指出，曾经是新闻自由堡垒的香港，已成为习近平治下中国宣传机器的一部分，成为替中共宣传的工具。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E6%97%A0%E5%9B%BD%E7%95%8C%E8%AE%B0%E8%80%85-%E6%8C%87%E5%9B%BD%E5%AE%89%E6%B3%95%E5%90%8E%E6%B8%AF%E5%AA%92%E6%88%90%E4%B8%AD%E5%9B%BD%E5%AE%A3%E4%BC%A0%E5%B7%A5%E5%85%B7-%E6%96%B0%E9%97%BB%E5%B7%A5%E4%BD%9C%E5%88%91%E4%BA%8B%E5%8C%96%E6%88%90%E9%A6%99%E6%B8%AF%E6%96%B0%E5%B8%B8%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790150154000.webp","sourceId":"rfi"},{"id":1790149417000,"createdDate":"2026-09-23 07:43","name":"法国国际广播电台","title":"华盛顿习特会：看台湾人的担忧","content":"在习近平即将访问华盛顿和特朗普会谈之际，法国世界报特派记者从台北发回报道说，台湾人担心美国会推迟对台军售，担心美国长期以来对台湾的安全支持可能受到影响。因为特朗普5月访问中国后，曾把对台军售称为是与中国谈判的“筹码”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260923-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%B9%A0%E7%89%B9%E4%BC%9A-%E5%8F%B0%E6%B9%BE%E4%BA%BA%E6%8B%85%E5%BF%83%E7%BE%8E%E5%9B%BD%E4%BC%9A%E6%8E%A8%E8%BF%9F%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790149417000.webp","sourceId":"rfi"},{"id":1790149166000,"createdDate":"2026-09-23 07:39","name":"法国国际广播电台","title":"联大：秘书长古特雷斯敦促美中建立AI对话机制","content":"联合国秘书长古特雷斯22日呼吁美国和中国在人工智能领域“建立对话、透明、信任与合作的渠道”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E8%81%94%E5%A4%A7-%E7%A7%98%E4%B9%A6%E9%95%BF%E5%8F%A4%E7%89%B9%E9%9B%B7%E6%96%AF%E6%95%A6%E4%BF%83%E7%BE%8E%E4%B8%AD%E5%BB%BA%E7%AB%8Bai%E5%AF%B9%E8%AF%9D%E6%9C%BA%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790149166000.webp","sourceId":"rfi"}]