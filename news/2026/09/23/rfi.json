[{"id":1790168910000,"createdDate":"2026-09-23 13:08","name":"法国国际广播电台","title":"习近平启程前往美国 将与特朗普举行峰会","content":"中国国家主席习近平于周三下午启程前往美国，将与唐纳德·特朗普举行峰会，届时两国领导人预计将寻求延续两国关系缓和的态势。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%AF%E7%A8%8B%E5%89%8D%E5%BE%80%E7%BE%8E%E5%9B%BD-%E5%B0%86%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%BE%E8%A1%8C%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790168910000.webp","sourceId":"rfi"},{"id":1790166713000,"createdDate":"2026-09-23 12:31","name":"法国国际广播电台","title":"伊朗总统抵纽约将在联大发言 美国首次向交战敌国首脑发签证 特朗普称对话已恢复","content":"伊朗总统马苏德·佩泽什基安已经抵达纽约，他将于周三在联合国年度大会期间，于联合国大会堂发表讲话。分析指这是美国首次向与美国处于战争状态的国家元首签发签证。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E6%8A%B5%E7%BA%BD%E7%BA%A6%E5%B0%86%E5%9C%A8%E8%81%94%E5%A4%A7%E5%8F%91%E8%A8%80-%E7%BE%8E%E5%9B%BD%E9%A6%96%E6%AC%A1%E5%90%91%E4%BA%A4%E6%88%98%E6%95%8C%E5%9B%BD%E9%A6%96%E8%84%91%E5%8F%91%E7%AD%BE%E8%AF%81-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%AF%B9%E8%AF%9D%E5%B7%B2%E6%81%A2%E5%A4%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790166713000.webp","sourceId":"rfi"},{"id":1790159726000,"createdDate":"2026-09-23 10:35","name":"法国国际广播电台","title":"韩国确认首个对美3500亿美元投资项目","content":"韩国总统府周三宣布，韩国总统李在明和美国总统特朗普在联合国大会期间举行了30分钟会晤，双方对战略投资项目讨论取得的“显著进展”表示欢迎。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260923-%E9%9F%A9%E5%9B%BD%E7%A1%AE%E8%AE%A4%E9%A6%96%E4%B8%AA%E5%AF%B9%E7%BE%8E3500%E4%BA%BF%E7%BE%8E%E5%85%83%E6%8A%95%E8%B5%84%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790159726000.webp","sourceId":"rfi"},{"id":1790156312000,"createdDate":"2026-09-23 09:38","name":"法国国际广播电台","title":"法广2026年9月23日第一次播音北京时间6至7点","content":"","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%AC%AC%E4%B8%80%E6%AC%A1%E6%92%AD%E9%9F%B3-06-00-07-00-%E5%8C%97%E4%BA%AC%E6%97%B6%E9%97%B4/20260923-%E6%B3%95%E5%B9%BF2026%E5%B9%B49%E6%9C%8823%E6%97%A5%E7%AC%AC%E4%B8%80%E6%AC%A1%E6%92%AD%E9%9F%B3%E5%8C%97%E4%BA%AC%E6%97%B6%E9%97%B46%E8%87%B37%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790156312000.webp","sourceId":"rfi"},{"id":1790154084000,"createdDate":"2026-09-23 09:01","name":"法国国际广播电台","title":"日美首脑举行会谈 围绕中国问题等坦率交换意见","content":"高市早苗首相于当地时间22日在访问美国纽约期间，与美国总统特朗普举行了会谈。高市日本时间23日在社交媒体“X”上表示，就中国、朝鲜等问题，与特朗普总统进行了坦率的意见交换。特别是对于她本人正下定决心致力解决的绑架问题，她再次强调了立即解决这一问题的重要性，并获得了特朗普总统的全面支持。她指出：除此之外，双方还就国际刑事法院（ICC）问题坦率交换了的意见。此前高市首相表示：美国制裁国际刑事法院日本籍院长赤根智子，“与重视法治的日本立场并不相容。我们对此高度重视，并认为事态非常严重”。而美国总统特朗普22日批评国际刑事法院是一个“失控的机构”，并呼吁所有成员国立即退出该机构。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260923-%E6%97%A5%E7%BE%8E%E9%A6%96%E8%84%91%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88-%E5%9B%B4%E7%BB%95%E4%B8%AD%E5%9B%BD%E9%97%AE%E9%A2%98%E7%AD%89%E5%9D%A6%E7%8E%87%E4%BA%A4%E6%8D%A2%E6%84%8F%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790154084000.webp","sourceId":"rfi"},{"id":1790153662000,"createdDate":"2026-09-23 08:54","name":"法国国际广播电台","title":"特习会前 台湾称将继续与美国就军售问题保持“密切联系”","content":"在中国国家主席习近平抵达华盛顿与美国总统唐纳德·特朗普会晤之际，台湾方面表示，尽管面临来自中国的压力，他们仍然相信美国对台军售将继续进行。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%89%8D-%E5%8F%B0%E6%B9%BE%E7%A7%B0%E5%B0%86%E7%BB%A7%E7%BB%AD%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%B0%B1%E5%86%9B%E5%94%AE%E9%97%AE%E9%A2%98%E4%BF%9D%E6%8C%81-%E5%AF%86%E5%88%87%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790153662000.webp","sourceId":"rfi"},{"id":1790151057000,"createdDate":"2026-09-23 08:10","name":"法国国际广播电台","title":"高雄市举办国际儿童及青少年嘉年华 法国主题馆庆经典文学《小王子》80周年","content":"台湾国际儿童与青少年嘉年华于23到27日在高雄登场，法国作为今年主题馆展示《小王子》80周年纪念版。多位法国图文创作者受邀来台举办讲座与工作坊。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E9%AB%98%E9%9B%84%E5%B8%82%E4%B8%BE%E5%8A%9E%E5%9B%BD%E9%99%85%E5%84%BF%E7%AB%A5%E5%8F%8A%E9%9D%92%E5%B0%91%E5%B9%B4%E5%98%89%E5%B9%B4%E5%8D%8E-%E6%B3%95%E5%9B%BD%E4%B8%BB%E9%A2%98%E9%A6%86%E5%BA%86%E7%BB%8F%E5%85%B8%E6%96%87%E5%AD%A6-%E5%B0%8F%E7%8E%8B%E5%AD%90-80%E5%91%A8%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790151057000.webp","sourceId":"rfi"},{"id":1790150554000,"createdDate":"2026-09-23 08:02","name":"法国国际广播电台","title":"欧盟指国安已融入香港管治　港府压制性使用国安法律损人权 影响续扩大","content":"欧盟发表最新的香港政治与经济发展年度报告，批评港府在多宗国家安全案件中，压制性地使用国安相关法律，对异见者施以长期审前羁押等，侵犯人权，关注港府利用打击「软对抗」，针对独立书店丶文化活动和媒体等情况，敦促中国和香港政府恢复全面尊重法治丶基本自由及民主原则。港府对报告内容表示强烈不满和反对，重申任何外国或外部势力诋毁香港，均不会得逞。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E6%AC%A7%E7%9B%9F%E6%8C%87%E5%9B%BD%E5%AE%89%E5%B7%B2%E8%9E%8D%E5%85%A5%E9%A6%99%E6%B8%AF%E7%AE%A1%E6%B2%BB-%E6%B8%AF%E5%BA%9C%E5%8E%8B%E5%88%B6%E6%80%A7%E4%BD%BF%E7%94%A8%E5%9B%BD%E5%AE%89%E6%B3%95%E5%BE%8B%E6%8D%9F%E4%BA%BA%E6%9D%83-%E5%BD%B1%E5%93%8D%E7%BB%AD%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790150554000.webp","sourceId":"rfi"},{"id":1790150154000,"createdDate":"2026-09-23 07:55","name":"法国国际广播电台","title":"「无国界记者」指国安法后港媒成中国宣传工具 新闻工作刑事化成香港新常态","content":"「无国界记者」（RSF）最新的研究追踪中国全球宣传机器的运作，指中国不仅压制境内媒体和言论自由，更试图把这类威权式的信息控制模式向外输出，建立「世界媒体新秩序」，以取代新闻工作，并指出，曾经是新闻自由堡垒的香港，已成为习近平治下中国宣传机器的一部分，成为替中共宣传的工具。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260923-%E6%97%A0%E5%9B%BD%E7%95%8C%E8%AE%B0%E8%80%85-%E6%8C%87%E5%9B%BD%E5%AE%89%E6%B3%95%E5%90%8E%E6%B8%AF%E5%AA%92%E6%88%90%E4%B8%AD%E5%9B%BD%E5%AE%A3%E4%BC%A0%E5%B7%A5%E5%85%B7-%E6%96%B0%E9%97%BB%E5%B7%A5%E4%BD%9C%E5%88%91%E4%BA%8B%E5%8C%96%E6%88%90%E9%A6%99%E6%B8%AF%E6%96%B0%E5%B8%B8%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790150154000.webp","sourceId":"rfi"},{"id":1790149417000,"createdDate":"2026-09-23 07:43","name":"法国国际广播电台","title":"华盛顿习特会：看台湾人的担忧","content":"在习近平即将访问华盛顿和特朗普会谈之际，法国世界报特派记者从台北发回报道说，台湾人担心美国会推迟对台军售，担心美国长期以来对台湾的安全支持可能受到影响。因为特朗普5月访问中国后，曾把对台军售称为是与中国谈判的“筹码”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260923-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%B9%A0%E7%89%B9%E4%BC%9A-%E5%8F%B0%E6%B9%BE%E4%BA%BA%E6%8B%85%E5%BF%83%E7%BE%8E%E5%9B%BD%E4%BC%9A%E6%8E%A8%E8%BF%9F%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790149417000.webp","sourceId":"rfi"},{"id":1790149166000,"createdDate":"2026-09-23 07:39","name":"法国国际广播电台","title":"联大：秘书长古特雷斯敦促美中建立AI对话机制","content":"联合国秘书长古特雷斯22日呼吁美国和中国在人工智能领域“建立对话、透明、信任与合作的渠道”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E8%81%94%E5%A4%A7-%E7%A7%98%E4%B9%A6%E9%95%BF%E5%8F%A4%E7%89%B9%E9%9B%B7%E6%96%AF%E6%95%A6%E4%BF%83%E7%BE%8E%E4%B8%AD%E5%BB%BA%E7%AB%8Bai%E5%AF%B9%E8%AF%9D%E6%9C%BA%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790149166000.webp","sourceId":"rfi"},{"id":1790188452000,"createdDate":"2026-09-23 18:34","name":"法国国际广播电台","title":"对台军售，北京耍了特朗普？","content":"2026年9月24日出刊的法国世界报与中国相关的报道有两则，首先一起来关注“台湾军售，北京耍了特朗普”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260923-%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%EF%BC%8C%E5%8C%97%E4%BA%AC%E8%80%8D%E4%BA%86%E7%89%B9%E6%9C%97%E6%99%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790188452000.webp","sourceId":"rfi"},{"id":1790187279000,"createdDate":"2026-09-23 18:14","name":"法国国际广播电台","title":"柬埔寨总理在反诈峰会表示：柬埔寨绝不当诈骗“避风港”","content":"柬埔寨首相周三在打击网络诈骗全球大会开幕式上表示，柬埔寨不会成为跨国诈骗集团的避风港。柬埔寨政府希望借此机会展示其打击数十亿美元诈骗行业的成果。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E-%E6%9F%A5%E5%85%8B%E8%88%92%E9%BB%98%E5%B0%B1ai%E5%8F%8A%E8%8A%AF%E7%89%87%E8%AD%A6%E5%91%8A%E7%89%B9%E6%9C%97%E6%99%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790187279000.webp","sourceId":"rfi"},{"id":1790185800000,"createdDate":"2026-09-23 17:50","name":"法国国际广播电台","title":"习近平访美：参院少数党领袖查克舒默警告特朗普勿放松AI及芯片管制","content":"美国参议院少数党领袖查克·舒默警告唐纳德·特朗普总统不要放松对向中国销售先进人工智能芯片的管制。他称，尽管白宫正寻求让美国在该技术领域占据主导地位，但总统在此问题上的做法正相反。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E-%E5%8F%82%E9%99%A2%E5%B0%91%E6%95%B0%E5%85%9A%E9%A2%86%E8%A2%96%E6%9F%A5%E5%85%8B%E8%88%92%E9%BB%98%E8%AD%A6%E5%91%8A%E7%89%B9%E6%9C%97%E6%99%AE%E5%8B%BF%E6%94%BE%E6%9D%BEai%E5%8F%8A%E8%8A%AF%E7%89%87%E7%AE%A1%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790185800000.webp","sourceId":"rfi"},{"id":1790184830000,"createdDate":"2026-09-23 17:33","name":"法国国际广播电台","title":"法国推动下，欧盟解除对两名俄富豪制裁","content":"9月23日星期三路透社消息，鉴于法国施压，欧盟前一日解除了对两名俄罗斯富豪的制裁。这引发了欧盟成员国强烈反应。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E6%B3%95%E5%9B%BD%E6%8E%A8%E5%8A%A8%E4%B8%8B%EF%BC%8C%E6%AC%A7%E7%9B%9F%E8%A7%A3%E9%99%A4%E5%AF%B9%E4%B8%A4%E5%90%8D%E4%BF%84%E5%AF%8C%E8%B1%AA%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790184830000.webp","sourceId":"rfi"},{"id":1790182764000,"createdDate":"2026-09-23 16:59","name":"法国国际广播电台","title":"美共和党参院军事委员会主席抨击白宫欢迎中国领导人","content":"美国参议员罗杰·威克敦促唐纳德·特朗普总统就中国的军事扩张和人权问题向习近平施压。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E7%BE%8E%E5%85%B1%E5%92%8C%E5%85%9A%E5%8F%82%E9%99%A2%E5%86%9B%E4%BA%8B%E5%A7%94%E5%91%98%E4%BC%9A%E4%B8%BB%E5%B8%AD%E6%8A%A8%E5%87%BB%E7%99%BD%E5%AE%AB%E6%AC%A2%E8%BF%8E%E4%B8%AD%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790182764000.webp","sourceId":"rfi"},{"id":1790179060000,"createdDate":"2026-09-23 15:57","name":"法国国际广播电台","title":"中共5中全会前夕，西藏甘肃青海 安徽福建河南6省区书记换人","content":"继西藏、甘肃和青海三省区书记换人后，9月23日安徽、福建和河南三省的省委书记换人。据报中共二十届五中全会定于2026年10月26日至29日在北京召开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260923-%E4%B8%AD%E5%85%B15%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%89%8D%E5%A4%95%EF%BC%8C%E8%A5%BF%E8%97%8F%E7%94%98%E8%82%83%E9%9D%92%E6%B5%B7-%E5%AE%89%E5%BE%BD%E7%A6%8F%E5%BB%BA%E6%B2%B3%E5%8D%976%E7%9C%81%E5%8C%BA%E4%B9%A6%E8%AE%B0%E6%8D%A2%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790179060000.webp","sourceId":"rfi"},{"id":1790174910000,"createdDate":"2026-09-23 14:48","name":"法国国际广播电台","title":"英国首相请求特朗普与习近平会晤时提出释放黎智英","content":"据政客Politico网站9月22日引述两位知情人士透露，英国首相伯纳姆请求特朗普总统在周四与中国国家主席习近平举行的峰会上，提及被囚禁的香港异见人士黎智英一案。据一位知情人士透露，英国代表团表示，这位香港异见人士可以在英国定居。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E8%8B%B1%E5%9B%BD%E9%A6%96%E7%9B%B8%E8%AF%B7%E6%B1%82%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BC%9A%E6%99%A4%E6%97%B6%E6%8F%90%E5%87%BA%E9%87%8A%E6%94%BE%E9%BB%8E%E6%99%BA%E8%8B%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790174910000.webp","sourceId":"rfi"},{"id":1790172279000,"createdDate":"2026-09-23 14:04","name":"法国国际广播电台","title":"一架伊朗民航客机在中国降落 尽管面临美国制裁威胁","content":"据航班追踪网站Flightradar24报道，尽管美国威胁将严惩任何协助伊朗航空公司运营的实体，一架伊朗航空公司的民航客机仍于周三在中国降落。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260923-%E4%B8%80%E6%9E%B6%E4%BC%8A%E6%9C%97%E6%B0%91%E8%88%AA%E5%AE%A2%E6%9C%BA%E5%9C%A8%E4%B8%AD%E5%9B%BD%E9%99%8D%E8%90%BD-%E5%B0%BD%E7%AE%A1%E9%9D%A2%E4%B8%B4%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790172279000.webp","sourceId":"rfi"},{"id":1790171798000,"createdDate":"2026-09-23 13:56","name":"法国国际广播电台","title":"《解放报》：尼泊尔泥石流洪灾唤醒对墨脱大型水电站风险的担忧","content":"23日出版的法国全国性大报头版头条大部分以国内话题开篇。《回声报》今天将燃油价格上涨而财政捉襟见肘的法国政府难有作为放在头版头条；法共《人道报》侧重法国社会伴随燃油价格上涨而不断升温的不满情绪。政府为新年度财政预算头痛之际，右翼倾向的《费加罗报》将目光对准了法国的公务员体系，认为法国公务员的退休金制度对国家财政构成沉重负担。天主教报刊《十字架报》则重点聚焦罗马教皇良十四两天后的法国之行。人工智能技术快速发展引发各种忧虑之际，《解放报》以大版篇幅介绍围绕魁北克作家ThélysonOrélien涉嫌用人工智能写作的争议。在国际版，各报都从不同角度，观察在多重全球性危机中开幕的联合国大会高级别周。《费加罗报》特别刊登文章，介绍韩国目前面对中东战争以及朝鲜构成的安全隐患，夹在华盛顿、德黑兰和北京之间的艰难处境。我们也借本次节目时间，向大家介绍《解放报》网站一篇梳理各方对中国刚刚启动墨脱超大型水电站修建计划引发的各种忧虑的文章。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260923-%E8%A7%A3%E6%94%BE%E6%8A%A5-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B3%A5%E7%9F%B3%E6%B5%81%E6%B4%AA%E7%81%BE%E5%94%A4%E9%86%92%E5%AF%B9%E5%A2%A8%E8%84%B1%E5%A4%A7%E5%9E%8B%E6%B0%B4%E7%94%B5%E7%AB%99%E9%A3%8E%E9%99%A9%E7%9A%84%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790171798000.webp","sourceId":"rfi"},{"id":1790171378000,"createdDate":"2026-09-23 13:49","name":"法国国际广播电台","title":"联合国气候行动峰会及IPCC成员的利益冲突","content":"即将离任的联合国秘书长安东尼奥·古特雷斯今天周三将于纽约联合国大会主持他任期内的最后一次气候行动峰会，由全球各国的最高级代表参与的首次联合国气候行动峰会是由古特雷斯在2019年推动举办的，其目的是进一步提高气候行动的力度。七年来，古特雷斯一次又一次的拉响了气候警钟，他将气候变化作为其任期内的决定性议题，在周二联合国大会的开幕式上，古特雷斯谴责石油巨头将大气层视为排污的下水道”,他指出，自俄罗斯入侵乌克兰以来,西方五家主要石油公司已经获得了近五万亿美元的利润。这一数额与为帮助发展中国家适应全球变暖而必须筹集的340亿美元融资不可同日而语。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20260923-%E8%81%94%E5%90%88%E5%9B%BD%E6%B0%94%E5%80%99%E8%A1%8C%E5%8A%A8%E5%B3%B0%E4%BC%9A%E5%8F%8Aipcc%E6%88%90%E5%91%98%E7%9A%84%E5%88%A9%E7%9B%8A%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790171378000.webp","sourceId":"rfi"},{"id":1790151612000,"createdDate":"2026-09-23 08:20","name":"法国国际广播电台","title":"台湾学者：特习二会在台湾议题上难有新的重大宣示 且仪式性大于实质性","content":"台湾学者表示，在这次特习会上台湾仍然会是特习会可能讨论的敏感议题之一，北京依然会重申一贯立场，但美中双方达成新的重大宣示或重大交易的机率「微乎其微」。并且，仪式性大于实质性，在台海议题上的著墨幅度不会太大。但尽管如此，美国智库仍建议在峰会后应注意三项重点观察。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260923-%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85-%E7%89%B9%E4%B9%A0%E4%BA%8C%E4%BC%9A%E5%9C%A8%E5%8F%B0%E6%B9%BE%E8%AE%AE%E9%A2%98%E4%B8%8A%E9%9A%BE%E6%9C%89%E6%96%B0%E7%9A%84%E9%87%8D%E5%A4%A7%E5%AE%A3%E7%A4%BA-%E4%B8%94%E4%BB%AA%E5%BC%8F%E6%80%A7%E5%A4%A7%E4%BA%8E%E5%AE%9E%E8%B4%A8%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/23/1790151612000.webp","sourceId":"rfi"}]