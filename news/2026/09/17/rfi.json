[{"id":1789648360000,"createdDate":"2026-09-17 12:32","name":"法国国际广播电台","title":"俄罗斯空袭基辅传剧烈爆炸声 乌克兰袭击俄罗斯大型炼油厂","content":"几乎在基辅传出剧烈爆炸声的同时，周四传出消息：美国众议院批准了针对俄罗斯及其盟友的新一轮制裁法案，以惩罚其在乌克兰战争中所扮演的角色，得到唐纳德·特朗普的支持，基辅方面周四对该法案通过表示欢迎。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A9%BA%E8%A2%AD%E5%9F%BA%E8%BE%85%E4%BC%A0%E5%89%A7%E7%83%88%E7%88%86%E7%82%B8%E5%A3%B0-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%A2%AD%E5%87%BB%E4%BF%84%E7%BD%97%E6%96%AF%E5%A4%A7%E5%9E%8B%E7%82%BC%E6%B2%B9%E5%8E%82","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789648360000.webp","sourceId":"rfi"},{"id":1789646550000,"createdDate":"2026-09-17 12:02","name":"法国国际广播电台","title":"美国会通过制裁俄罗斯新法案授权总统对中印等5大俄油气进口国征100%关税","content":"美国众议院批准了针对俄罗斯及其盟友的新一轮制裁法案，以惩罚其在乌克兰战争中所扮演的角色，得到唐纳德·特朗普的支持，基辅方面周四对该法案通过表示欢迎。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E9%80%9A%E8%BF%87%E5%88%B6%E8%A3%81%E4%BF%84%E7%BD%97%E6%96%AF%E6%96%B0%E6%B3%95%E6%A1%88%E6%8E%88%E6%9D%83%E6%80%BB%E7%BB%9F%E5%AF%B9%E4%B8%AD%E5%8D%B0%E7%AD%895%E5%A4%A7%E4%BF%84%E6%B0%94%E8%BF%9B%E5%8F%A3%E5%9B%BD%E5%BE%81100-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789646550000.webp","sourceId":"rfi"},{"id":1789646542000,"createdDate":"2026-09-17 12:02","name":"法国国际广播电台","title":"费加罗报：中国新规主挡AI人才出境，唤醒人们对毛泽东时代的记忆","content":"大家好，周四9月17日的法国主流日报的头版主要话题聚焦在法国预算与民生事务。中国方面《费加罗报》持续关注出入境新规的寒蝉效应，该报亚洲通讯员发来报道说，中国借此加强了边境管控，防止人工智能人才流失，并引用中国侨民的贴文：“我再也不敢回国了，生怕再也出不去了。”","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260917-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E6%96%B0%E8%A7%84%E4%B8%BB%E6%8C%A1ai%E4%BA%BA%E6%89%8D%E5%87%BA%E5%A2%83%EF%BC%8C%E5%94%A4%E9%86%92%E4%BA%BA%E4%BB%AC%E5%AF%B9%E6%AF%9B%E6%B3%BD%E4%B8%9C%E6%97%B6%E4%BB%A3%E7%9A%84%E8%AE%B0%E5%BF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789646542000.webp","sourceId":"rfi"},{"id":1789640912000,"createdDate":"2026-09-17 10:28","name":"法国国际广播电台","title":"欧盟寻求限制进口中国混合动力汽车 以避免引发贸易争端","content":"欧盟已要求中国限制其混合动力汽车出口，以避免贸易战。据知情人士称，布鲁塞尔希望北京将出口限制在欧盟市场份额在15%左右。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E6%AC%A7%E7%9B%9F%E5%AF%BB%E6%B1%82%E9%99%90%E5%88%B6%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E6%B7%B7%E5%90%88%E5%8A%A8%E5%8A%9B%E6%B1%BD%E8%BD%A6-%E4%BB%A5%E9%81%BF%E5%85%8D%E5%BC%95%E5%8F%91%E8%B4%B8%E6%98%93%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789640912000.webp","sourceId":"rfi"},{"id":1789636885000,"createdDate":"2026-09-17 09:21","name":"法国国际广播电台","title":"高市首相组建第二次改组内阁并改组自民党领导班子 不见推进日中关系改善安排","content":"日本首相高市早苗17日敲定第二次内阁改组的人选，16日进行了自民党高层改组，官房长官木原稔公布了新的阁僚名单。此前一直采取“阁外合作”方式的日本维新会，此次首次有成员进入内阁担任大臣，但是从阁僚安排上看，涉及外交的外务与防卫大臣没有换人，在内政、外交上仍将坚持保守鹰派方针，不见推动日中关系改善的安排。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260917-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E7%BB%84%E5%BB%BA%E7%AC%AC%E4%BA%8C%E6%AC%A1%E6%94%B9%E7%BB%84%E5%86%85%E9%98%81%E5%B9%B6%E6%94%B9%E7%BB%84%E8%87%AA%E6%B0%91%E5%85%9A%E9%A2%86%E5%AF%BC%E7%8F%AD%E5%AD%90-%E4%B8%8D%E8%A7%81%E6%8E%A8%E8%BF%9B%E6%97%A5%E4%B8%AD%E5%85%B3%E7%B3%BB%E6%94%B9%E5%96%84%E5%AE%89%E6%8E%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789636885000.webp","sourceId":"rfi"},{"id":1789635259000,"createdDate":"2026-09-17 08:54","name":"法国国际广播电台","title":"中国举行先进制造业大会 习近平吁持续“做大做强”","content":"中国先进制造业大会9月16日至17日在北京召开，路透社援引新华社报道，中国国家主席习近平近日就该领域发展作出指示，表示要持续“做大做强”中国先进制造业，并加强关键产业链的自主可控。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%81%E6%8C%81%E7%BB%AD-%E5%81%9A%E5%A4%A7%E5%81%9A%E5%BC%BA-%E4%B8%AD%E5%9B%BD%E5%85%88%E8%BF%9B%E5%88%B6%E9%80%A0%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789635259000.webp","sourceId":"rfi"},{"id":1789630755000,"createdDate":"2026-09-17 07:39","name":"法国国际广播电台","title":"面向北京 港「一五」规划与施政报告被指「离地」 评论更忧财源不足以落实规划","content":"香港政府公布了第一份「经济和社会发展五年规划」(「一五」规划)，目标明显是与中国的第十五个五年规划对接，而被指明要落实一五规划的施政报告，今年亦以描绘五年後的蓝图为主，被指「离地」(脱离现实)，以致部分基层或中产市民均关心失业问题，并指因失业及看不到香港的未来而不敢生育；而评论亦指出，规划缺乏落实政策最需要的财政问题，以香港现时只有六千多亿元财政储备看来，能否落实还须拭目以待。不过，不同法定组织和团体都发文表示支持，而中央驻港机构亦认为，香港定能把规划「愿景图」转化为发展「实景图」。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260917-%E9%9D%A2%E5%90%91%E5%8C%97%E4%BA%AC-%E6%B8%AF-%E4%B8%80%E4%BA%94-%E8%A7%84%E5%88%92%E4%B8%8E%E6%96%BD%E6%94%BF%E6%8A%A5%E5%91%8A%E8%A2%AB%E6%8C%87-%E7%A6%BB%E5%9C%B0-%E8%AF%84%E8%AE%BA%E6%9B%B4%E5%BF%A7%E8%B4%A2%E6%BA%90%E4%B8%8D%E8%B6%B3%E4%BB%A5%E8%90%BD%E5%AE%9E%E8%A7%84%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789630755000.webp","sourceId":"rfi"},{"id":1789667975000,"createdDate":"2026-09-17 17:59","name":"法国国际广播电台","title":"澳大利亚收紧学生签证和背包客签证发放条件以遏制移民潮","content":"在围绕移民激增辩论日益激烈的背景下，澳大利亚政府拟收紧签证政策，包括：禁止外国学生携带伴侣和子女；推出针对背包客签证延期的抽签制度；游客签证将不再包含延长停留期限的规定...","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E6%94%B6%E7%B4%A7%E5%AD%A6%E7%94%9F%E7%AD%BE%E8%AF%81%E5%92%8C%E8%83%8C%E5%8C%85%E5%AE%A2%E7%AD%BE%E8%AF%81%E5%8F%91%E6%94%BE%E6%9D%A1%E4%BB%B6%E4%BB%A5%E9%81%8F%E5%88%B6%E7%A7%BB%E6%B0%91%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789667975000.webp","sourceId":"rfi"},{"id":1789664680000,"createdDate":"2026-09-17 17:04","name":"法国国际广播电台","title":"沙特阿拉伯与也门胡塞武装再次爆发致命交火","content":"周四，也门胡塞武装与沙特阿拉伯之间爆发了致命冲突，造成5人死亡。此前几天，亲伊朗武装分子胡塞曾在红海沿岸发动了闪电式进攻。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260917-%E6%B2%99%E7%89%B9%E9%98%BF%E6%8B%89%E4%BC%AF%E4%B8%8E%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E5%86%8D%E6%AC%A1%E7%88%86%E5%8F%91%E8%87%B4%E5%91%BD%E4%BA%A4%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789664680000.webp","sourceId":"rfi"},{"id":1789659648000,"createdDate":"2026-09-17 15:40","name":"法国国际广播电台","title":"斐济群岛艾滋病例激增 宣布“国家紧急状态”","content":"斐济群岛感染艾滋病毒人数6年暴增16倍，据估计，每60名成年人中就有1人携带艾滋病病毒。2025年出生的59名携带艾滋病病毒的儿童中，有18名在满一岁前死亡。澳洲，新西兰，印度，全球基金及联合国正向斐济提供支持。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E6%96%90%E6%B5%8E%E7%BE%A4%E5%B2%9B%E8%89%BE%E6%BB%8B%E7%97%85%E4%BE%8B%E6%BF%80%E5%A2%9E-%E5%AE%A3%E5%B8%83-%E5%9B%BD%E5%AE%B6%E7%B4%A7%E6%80%A5%E7%8A%B6%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789659648000.webp","sourceId":"rfi"},{"id":1789658400000,"createdDate":"2026-09-17 15:20","name":"法国国际广播电台","title":"从领土争议、二战历史到远东军演，日俄关系如何搅动东北亚局势","content":"8月到9月期间，日本与俄罗斯之间围绕二战历史、军事活动和领土问题等的矛盾不断升级。从日本、澳大利亚和美国的联合军事演习，到俄罗斯远东城市哈巴洛夫斯克设立引发日本强烈抗议的二战纪念碑，再到俄罗斯机构在台北组织放映日本军国主义的苏联纪录片…一系列事件密集出现，将这两个国家的“新仇旧恨”推到了前台，桩桩件件不离同一段历史，以及二战后的现存区域秩序。又因为两国之间的诸多争议，往往夹杂着美国、中国、朝鲜半岛等区域重要角色各自的利益，同时远涉乌克兰战争，日俄关系愈发成为印太区域的一个重要变量。值得一提的是，中国和俄罗斯在今年8月发表了联合声明，对亚太地区重新军事化示警。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20260917-%E4%BB%8E%E9%A2%86%E5%9C%9F%E4%BA%89%E8%AE%AE-%E4%BA%8C%E6%88%98%E5%8E%86%E5%8F%B2%E5%88%B0%E8%BF%9C%E4%B8%9C%E5%86%9B%E6%BC%94%EF%BC%8C%E6%97%A5%E4%BF%84%E5%85%B3%E7%B3%BB%E5%A6%82%E4%BD%95%E6%90%85%E5%8A%A8%E4%B8%9C%E5%8C%97%E4%BA%9A%E5%B1%80%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789658400000.webp","sourceId":"rfi"},{"id":1789657284000,"createdDate":"2026-09-17 15:01","name":"法国国际广播电台","title":"朝鲜外派劳工约10万 部分在俄生产军用无人机","content":"平壤向俄乌战场派遣上万军人帮助俄军作战的同时，也向俄罗斯派遣劳工弥补该国劳力不足。据一份国际调查报告指出，部分朝鲜劳工正在为俄罗斯生产军用无人机，预计朝鲜劳工赴俄人数将进一步增加。但该报告指出，目前中国仍是朝鲜外劳第一大输出地。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E6%9C%9D%E9%B2%9C%E5%A4%96%E6%B4%BE%E5%8A%B3%E5%B7%A5%E7%BA%A610%E4%B8%87-%E9%83%A8%E5%88%86%E5%9C%A8%E4%BF%84%E7%94%9F%E4%BA%A7%E5%86%9B%E7%94%A8%E6%97%A0%E4%BA%BA%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789657284000.webp","sourceId":"rfi"},{"id":1789657063000,"createdDate":"2026-09-17 14:57","name":"法国国际广播电台","title":"欧加靠拢引特朗普嘲讽威胁 欧盟安抚强调“不针对第三方”","content":"在欧盟表示愿让加拿大以首个“联席成员”身份成为其特殊伙伴之后，美国总统特朗普嘲讽其提议“荒谬”，并威胁如果推进这一他可能视为“敌对行为性质”的计划，将对欧洲采取关税报复，甚至停止部分领域的对欧贸易。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260917-%E6%AC%A7%E5%8A%A0%E9%9D%A0%E6%8B%A2%E5%BC%95%E7%89%B9%E6%9C%97%E6%99%AE%E5%98%B2%E8%AE%BD%E5%A8%81%E8%83%81-%E6%AC%A7%E7%9B%9F%E5%AE%89%E6%8A%9A%E5%BC%BA%E8%B0%83-%E4%B8%8D%E9%92%88%E5%AF%B9%E7%AC%AC%E4%B8%89%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789657063000.webp","sourceId":"rfi"},{"id":1789655488000,"createdDate":"2026-09-17 14:31","name":"法国国际广播电台","title":"纽伦堡文革60周年研讨会对文革的反思","content":"9月16号到18号在德国纽伦堡举行由 “北京之春“和”全球支持中国和亚洲民主化论坛“共同举办的文革六十周年研讨会，邀请中国和海外专家学者、民运人士和媒体人士参加。这次研讨会的组织者之一，“全球支持中国和亚洲民主化论坛”理事长费良勇先生指出，文革过去60年了，世界格局发生了重大变化。在与自由民主制度的竞争中，专制体制、尤其是共产专制完全失败。20世纪90年代东欧变色，苏联解体，德国统一，冷战结束，众多共产专制国家纷纷宣布放弃马克思列宁主义路线。中国从1979年改革开放以来，已经抛弃了阶级斗争、无产阶级专政、公有制和计划经济那一套。但中国1989年的六四大屠杀中断了民主化进程。中共蜕变为一个利益集团，在一党专制的保护伞下，走特权腐败之路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE/20260917-%E7%BA%BD%E4%BC%A6%E5%A0%A1%E6%96%87%E9%9D%A960%E5%91%A8%E5%B9%B4%E7%A0%94%E8%AE%A8%E4%BC%9A%E5%AF%B9%E6%96%87%E9%9D%A9%E7%9A%84%E5%8F%8D%E6%80%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789655488000.webp","sourceId":"rfi"},{"id":1789654586000,"createdDate":"2026-09-17 14:16","name":"法国国际广播电台","title":"曼德海峡为何如此重要？","content":"受伊朗支持的胡塞武装正试图控制整个也门红海沿岸，这将进一步巩固其对曼德海峡的掌控力。曼德海峡是全球最繁忙、争夺最激烈的海上咽喉要道之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260917-%E6%9B%BC%E5%BE%B7%E6%B5%B7%E5%B3%A1%E4%B8%BA%E4%BD%95%E5%A6%82%E6%AD%A4%E9%87%8D%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789654586000.webp","sourceId":"rfi"},{"id":1789684093000,"createdDate":"2026-09-17 22:28","name":"法国国际广播电台","title":"白宫特习会 北京放长线钓大鱼？","content":"如果不出意外的话，中国国家主席习近平将于9月24日对美国展开国事访问。中美在人工智能、中东战争以及贸易问题上分歧重大，但据白宫官员周四向法新社透露，特朗普仍准备以最高礼遇接待来宾。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E7%99%BD%E5%AE%AB%E7%89%B9%E4%B9%A0%E4%BC%9A-%E5%8C%97%E4%BA%AC%E6%94%BE%E9%95%BF%E7%BA%BF%E9%92%93%E5%A4%A7%E9%B1%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789684093000.webp","sourceId":"rfi"},{"id":1789683213000,"createdDate":"2026-09-17 22:13","name":"法国国际广播电台","title":"中美对抗：在某种程度上，特朗普正服务于中国的利益","content":"9月24日，美国总统将在华盛顿接待习近平。这将是习近平十年来首次对美国进行国事访问。法国世界报专栏作者弗拉雄周四写道，在中美对抗中，习近平正受益于特朗普领导下的美国信誉越来越差。甚至，在某种程度上，特朗普似乎正在服务于中国的利益。为什么这么说呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260917-%E4%B8%AD%E7%BE%8E%E5%AF%B9%E6%8A%97-%E5%9C%A8%E6%9F%90%E7%A7%8D%E7%A8%8B%E5%BA%A6%E4%B8%8A%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E6%AD%A3%E6%9C%8D%E5%8A%A1%E4%BA%8E%E4%B8%AD%E5%9B%BD%E7%9A%84%E5%88%A9%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789683213000.webp","sourceId":"rfi"},{"id":1789681566000,"createdDate":"2026-09-17 21:46","name":"法国国际广播电台","title":"法国总理公布“进攻型”2027国家财政预算，计划节省540亿欧元","content":"法国总理勒科尔尼周四公布了2027年法国国家预算计划的主要内容。其中，政府的开支被大幅削减，总共将节省540亿欧元。这份预算计划将于10月1日提交部长会议讨论。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260917-%E6%B3%95%E5%9B%BD%E6%80%BB%E7%90%86%E5%85%AC%E5%B8%83-%E8%BF%9B%E6%94%BB%E5%9E%8B-2027%E5%9B%BD%E5%AE%B6%E8%B4%A2%E6%94%BF%E9%A2%84%E7%AE%97%EF%BC%8C%E8%AE%A1%E5%88%92%E8%8A%82%E7%9C%81540%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789681566000.webp","sourceId":"rfi"},{"id":1789681511000,"createdDate":"2026-09-17 21:45","name":"法国国际广播电台","title":"美国批准向沙特出售48架F-35隐形战机 总额243亿美元","content":"美国政府周四（9月17日）批准向沙特阿拉伯出售48架F-35隐形战斗机，合同总额达243亿美元。正值中东战事持续之际，这笔巨额军售备受关注。美国部分议员担忧，中国可能借助与沙特的合作关系，获取F-35战机的尖端军事技术。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E7%BE%8E%E5%9B%BD%E6%89%B9%E5%87%86%E5%90%91%E6%B2%99%E7%89%B9%E5%87%BA%E5%94%AE48%E6%9E%B6f-35%E9%9A%90%E5%BD%A2%E6%88%98%E6%9C%BA-%E6%80%BB%E9%A2%9D243%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789681511000.webp","sourceId":"rfi"},{"id":1789681210000,"createdDate":"2026-09-17 21:40","name":"法国国际广播电台","title":"“特习会”前 王毅与鲁比奥通话讨论中东局势","content":"在中美两国元首即将举行会晤前，中国外长王毅周四（9月17日）与美国国务卿鲁比奥通电话，讨论中东局势等问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E7%89%B9%E4%B9%A0%E4%BC%9A-%E5%89%8D-%E7%8E%8B%E6%AF%85%E4%B8%8E%E9%B2%81%E6%AF%94%E5%A5%A5%E9%80%9A%E8%AF%9D%E8%AE%A8%E8%AE%BA%E4%B8%AD%E4%B8%9C%E5%B1%80%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789681210000.webp","sourceId":"rfi"},{"id":1789681052000,"createdDate":"2026-09-17 21:37","name":"法国国际广播电台","title":"美国批准伊朗高层代表团签证 可赴纽约出席联大","content":"美国国务院周四（9月17日）表示，尽管美伊冲突仍在持续，美国已决定允许包括伊朗总统佩泽希齐扬在内的伊朗代表团前往纽约，参加下周举行的联合国大会。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E7%BE%8E%E5%9B%BD%E6%89%B9%E5%87%86%E4%BC%8A%E6%9C%97%E9%AB%98%E5%B1%82%E4%BB%A3%E8%A1%A8%E5%9B%A2%E7%AD%BE%E8%AF%81-%E5%8F%AF%E8%B5%B4%E7%BA%BD%E7%BA%A6%E5%87%BA%E5%B8%AD%E8%81%94%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789681052000.webp","sourceId":"rfi"},{"id":1789680788000,"createdDate":"2026-09-17 21:33","name":"法国国际广播电台","title":"路透社：中国应沙特请求 私下促伊朗遏制胡塞武装","content":"路透社周四（9月17日）报道，三名伊朗消息人士透露，在伊朗支持的也门胡塞武装过去一周发动迅猛攻势后，中国应沙特请求，已私下要求德黑兰协助约束胡塞武装。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E8%B7%AF%E9%80%8F%E7%A4%BE-%E4%B8%AD%E5%9B%BD%E5%BA%94%E6%B2%99%E7%89%B9%E8%AF%B7%E6%B1%82-%E7%A7%81%E4%B8%8B%E4%BF%83%E4%BC%8A%E6%9C%97%E9%81%8F%E5%88%B6%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789680788000.webp","sourceId":"rfi"},{"id":1789680542000,"createdDate":"2026-09-17 21:29","name":"法国国际广播电台","title":"欧盟贸易委员10月访华 寻求欧中经贸关系再平衡","content":"欧盟委员会一名发言人周四（9月17日）宣布，欧盟委员会负责贸易事务的委员谢夫乔维奇将于10月8日至9日访问北京，继续与中方磋商，推动欧中贸易关系实现“再平衡”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E6%AC%A7%E7%9B%9F%E8%B4%B8%E6%98%93%E5%A7%94%E5%91%9810%E6%9C%88%E8%AE%BF%E5%8D%8E-%E5%AF%BB%E6%B1%82%E6%AC%A7%E4%B8%AD%E7%BB%8F%E8%B4%B8%E5%85%B3%E7%B3%BB%E5%86%8D%E5%B9%B3%E8%A1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789680542000.webp","sourceId":"rfi"},{"id":1789678832000,"createdDate":"2026-09-17 21:00","name":"法国国际广播电台","title":"柏林《日报》：冯德莱恩大话连篇 行动寥寥","content":"欧盟委员会主席冯德莱恩周三发表盟情咨文，引发德国媒体多方质疑和批评。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260917-%E6%9F%8F%E6%9E%97-%E6%97%A5%E6%8A%A5-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9%E5%A4%A7%E8%AF%9D%E8%BF%9E%E7%AF%87-%E8%A1%8C%E5%8A%A8%E5%AF%A5%E5%AF%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789678832000.webp","sourceId":"rfi"},{"id":1789677928000,"createdDate":"2026-09-17 20:45","name":"法国国际广播电台","title":"特朗普将以最高礼遇接待习近平  包括亲自接机","content":"法新社从白宫官员获知，中国国家主席习近平下周抵达美国开启国事访问时，特朗普总统将亲自前往机场接机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%86%E4%BB%A5%E6%9C%80%E9%AB%98%E7%A4%BC%E9%81%87%E6%8E%A5%E5%BE%85%E4%B9%A0%E8%BF%91%E5%B9%B3-%E5%8C%85%E6%8B%AC%E4%BA%B2%E8%87%AA%E6%8E%A5%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789677928000.webp","sourceId":"rfi"}]