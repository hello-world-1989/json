[{"id":1789648360000,"createdDate":"2026-09-17 12:32","name":"法国国际广播电台","title":"俄罗斯空袭基辅传剧烈爆炸声 乌克兰袭击俄罗斯大型炼油厂","content":"几乎在基辅传出剧烈爆炸声的同时，周四传出消息：美国众议院批准了针对俄罗斯及其盟友的新一轮制裁法案，以惩罚其在乌克兰战争中所扮演的角色，得到唐纳德·特朗普的支持，基辅方面周四对该法案通过表示欢迎。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A9%BA%E8%A2%AD%E5%9F%BA%E8%BE%85%E4%BC%A0%E5%89%A7%E7%83%88%E7%88%86%E7%82%B8%E5%A3%B0-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%A2%AD%E5%87%BB%E4%BF%84%E7%BD%97%E6%96%AF%E5%A4%A7%E5%9E%8B%E7%82%BC%E6%B2%B9%E5%8E%82","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789648360000.webp","sourceId":"rfi"},{"id":1789646550000,"createdDate":"2026-09-17 12:02","name":"法国国际广播电台","title":"美国会通过制裁俄罗斯新法案授权总统对中印等5大俄油气进口国征100%关税","content":"美国众议院批准了针对俄罗斯及其盟友的新一轮制裁法案，以惩罚其在乌克兰战争中所扮演的角色，得到唐纳德·特朗普的支持，基辅方面周四对该法案通过表示欢迎。","newsLink":"http://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260917-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E9%80%9A%E8%BF%87%E5%88%B6%E8%A3%81%E4%BF%84%E7%BD%97%E6%96%AF%E6%96%B0%E6%B3%95%E6%A1%88%E6%8E%88%E6%9D%83%E6%80%BB%E7%BB%9F%E5%AF%B9%E4%B8%AD%E5%8D%B0%E7%AD%895%E5%A4%A7%E4%BF%84%E6%B0%94%E8%BF%9B%E5%8F%A3%E5%9B%BD%E5%BE%81100-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789646550000.webp","sourceId":"rfi"},{"id":1789646542000,"createdDate":"2026-09-17 12:02","name":"法国国际广播电台","title":"费加罗报：中国新规主挡AI人才出境，唤醒人们对毛泽东时代的记忆","content":"大家好，周四9月17日的法国主流日报的头版主要话题聚焦在法国预算与民生事务。中国方面《费加罗报》持续关注出入境新规的寒蝉效应，该报亚洲通讯员发来报道说，中国借此加强了边境管控，防止人工智能人才流失，并引用中国侨民的贴文：“我再也不敢回国了，生怕再也出不去了。”","newsLink":"http://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260917-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E6%96%B0%E8%A7%84%E4%B8%BB%E6%8C%A1ai%E4%BA%BA%E6%89%8D%E5%87%BA%E5%A2%83%EF%BC%8C%E5%94%A4%E9%86%92%E4%BA%BA%E4%BB%AC%E5%AF%B9%E6%AF%9B%E6%B3%BD%E4%B8%9C%E6%97%B6%E4%BB%A3%E7%9A%84%E8%AE%B0%E5%BF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789646542000.webp","sourceId":"rfi"},{"id":1789640912000,"createdDate":"2026-09-17 10:28","name":"法国国际广播电台","title":"欧盟寻求限制进口中国混合动力汽车 以避免引发贸易争端","content":"欧盟已要求中国限制其混合动力汽车出口，以避免贸易战。据知情人士称，布鲁塞尔希望北京将出口限制在欧盟市场份额在15%左右。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E6%AC%A7%E7%9B%9F%E5%AF%BB%E6%B1%82%E9%99%90%E5%88%B6%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E6%B7%B7%E5%90%88%E5%8A%A8%E5%8A%9B%E6%B1%BD%E8%BD%A6-%E4%BB%A5%E9%81%BF%E5%85%8D%E5%BC%95%E5%8F%91%E8%B4%B8%E6%98%93%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789640912000.webp","sourceId":"rfi"},{"id":1789636885000,"createdDate":"2026-09-17 09:21","name":"法国国际广播电台","title":"高市首相组建第二次改组内阁并改组自民党领导班子 不见推进日中关系改善安排","content":"日本首相高市早苗17日敲定第二次内阁改组的人选，16日进行了自民党高层改组，官房长官木原稔公布了新的阁僚名单。此前一直采取“阁外合作”方式的日本维新会，此次首次有成员进入内阁担任大臣，但是从阁僚安排上看，涉及外交的外务与防卫大臣没有换人，在内政、外交上仍将坚持保守鹰派方针，不见推动日中关系改善的安排。","newsLink":"http://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260917-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E7%BB%84%E5%BB%BA%E7%AC%AC%E4%BA%8C%E6%AC%A1%E6%94%B9%E7%BB%84%E5%86%85%E9%98%81%E5%B9%B6%E6%94%B9%E7%BB%84%E8%87%AA%E6%B0%91%E5%85%9A%E9%A2%86%E5%AF%BC%E7%8F%AD%E5%AD%90-%E4%B8%8D%E8%A7%81%E6%8E%A8%E8%BF%9B%E6%97%A5%E4%B8%AD%E5%85%B3%E7%B3%BB%E6%94%B9%E5%96%84%E5%AE%89%E6%8E%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789636885000.webp","sourceId":"rfi"},{"id":1789635259000,"createdDate":"2026-09-17 08:54","name":"法国国际广播电台","title":"中国举行先进制造业大会 习近平吁持续“做大做强”","content":"中国先进制造业大会9月16日至17日在北京召开，路透社援引新华社报道，中国国家主席习近平近日就该领域发展作出指示，表示要持续“做大做强”中国先进制造业，并加强关键产业链的自主可控。","newsLink":"http://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260917-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%81%E6%8C%81%E7%BB%AD-%E5%81%9A%E5%A4%A7%E5%81%9A%E5%BC%BA-%E4%B8%AD%E5%9B%BD%E5%85%88%E8%BF%9B%E5%88%B6%E9%80%A0%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789635259000.webp","sourceId":"rfi"},{"id":1789630755000,"createdDate":"2026-09-17 07:39","name":"法国国际广播电台","title":"面向北京 港「一五」规划与施政报告被指「离地」 评论更忧财源不足以落实规划","content":"香港政府公布了第一份「经济和社会发展五年规划」(「一五」规划)，目标明显是与中国的第十五个五年规划对接，而被指明要落实一五规划的施政报告，今年亦以描绘五年後的蓝图为主，被指「离地」(脱离现实)，以致部分基层或中产市民均关心失业问题，并指因失业及看不到香港的未来而不敢生育；而评论亦指出，规划缺乏落实政策最需要的财政问题，以香港现时只有六千多亿元财政储备看来，能否落实还须拭目以待。不过，不同法定组织和团体都发文表示支持，而中央驻港机构亦认为，香港定能把规划「愿景图」转化为发展「实景图」。","newsLink":"http://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260917-%E9%9D%A2%E5%90%91%E5%8C%97%E4%BA%AC-%E6%B8%AF-%E4%B8%80%E4%BA%94-%E8%A7%84%E5%88%92%E4%B8%8E%E6%96%BD%E6%94%BF%E6%8A%A5%E5%91%8A%E8%A2%AB%E6%8C%87-%E7%A6%BB%E5%9C%B0-%E8%AF%84%E8%AE%BA%E6%9B%B4%E5%BF%A7%E8%B4%A2%E6%BA%90%E4%B8%8D%E8%B6%B3%E4%BB%A5%E8%90%BD%E5%AE%9E%E8%A7%84%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/17/1789630755000.webp","sourceId":"rfi"}]