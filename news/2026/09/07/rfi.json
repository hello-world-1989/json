[{"id":1788789897000,"createdDate":"2026-09-07 14:04","name":"法国国际广播电台","title":"台国安官员猜中共20大的中央委员超过四分之一將被清洗","content":"中共预计10月召开五中全会，政军高层清洗仍持续进行，包括日前人大常委会决议免去张又侠、刘振立的中国国家军委副主席及军委委员职务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E5%8F%B0%E5%9B%BD%E5%AE%89%E5%AE%98%E5%91%98%E7%8C%9C%E4%B8%AD%E5%85%B120%E5%A4%A7%E7%9A%84%E4%B8%AD%E5%A4%AE%E5%A7%94%E5%91%98%E8%B6%85%E8%BF%87%E5%9B%9B%E5%88%86%E4%B9%8B%E4%B8%80%E5%B0%87%E8%A2%AB%E6%B8%85%E6%B4%97","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788789897000.webp","sourceId":"rfi"},{"id":1788788555000,"createdDate":"2026-09-07 13:42","name":"法国国际广播电台","title":"伊朗警告韩国勿介入霍尔木兹海峡 首尔宣布放缓派兵筹备","content":"伊朗外交部周一警告韩国，切勿在霍尔木兹海峡部署军队或参与美国的军事行动，并警告称此类举动将带来“严重后果”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E9%9F%A9%E5%9B%BD%E5%8B%BF%E4%BB%8B%E5%85%A5%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E9%A6%96%E5%B0%94%E5%AE%A3%E5%B8%83%E6%94%BE%E7%BC%93%E6%B4%BE%E5%85%B5%E7%AD%B9%E5%A4%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788788555000.webp","sourceId":"rfi"},{"id":1788787747000,"createdDate":"2026-09-07 13:29","name":"法国国际广播电台","title":"地区冲突不断 粮食价格升至三年来最高水平","content":"受霍尔木兹海峡和俄乌冲突等因素的影响，国际市场谷物价格近期攀升至三年多来的最高水平。面对日益动荡的世界局势，从北京到德里，从奥斯陆到伯尔尼，世界各国正在重启或巩固其粮食储备计划，这些国家正准备应对艰难的局面：由极其严重的地缘政治或环境危机引发的粮食价格攀升。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20260907-%E5%9C%B0%E5%8C%BA%E5%86%B2%E7%AA%81%E4%B8%8D%E6%96%AD-%E7%B2%AE%E9%A3%9F%E4%BB%B7%E6%A0%BC%E5%8D%87%E8%87%B3%E4%B8%89%E5%B9%B4%E6%9D%A5%E6%9C%80%E9%AB%98%E6%B0%B4%E5%B9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788787747000.webp","sourceId":"rfi"},{"id":1788787473000,"createdDate":"2026-09-07 13:24","name":"法国国际广播电台","title":"菲律宾防长 : 美韩军演减少 中国或将伺机而动","content":"菲律宾国防部长特奥多罗周一表示，中国可能将近期美韩缩减联合军演视为在印太地区重振其作用的时机，并表示华盛顿已向马尼拉保证其军事承诺不变。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E9%98%B2%E9%95%BF-%E7%BE%8E%E9%9F%A9%E5%86%9B%E6%BC%94%E5%87%8F%E5%B0%91-%E4%B8%AD%E5%9B%BD%E6%88%96%E5%B0%86%E4%BC%BA%E6%9C%BA%E8%80%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788787473000.webp","sourceId":"rfi"},{"id":1788780186000,"createdDate":"2026-09-07 11:23","name":"法国国际广播电台","title":"金正恩携女儿出席新驱逐舰服役仪式：该舰将被纳入核反击体系","content":"朝鲜新型5000吨级驱逐舰“姜健”号正式开始服役。朝鲜国家电视台周一（9月7日）播出的画面显示，领导人金正恩携女儿金主爱出席了这艘新驱逐舰的服役仪式,称“姜健”号将被纳入核反击体系。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E9%87%91%E6%AD%A3%E6%81%A9%E6%90%BA%E5%A5%B3%E5%84%BF%E5%87%BA%E5%B8%AD%E6%96%B0%E9%A9%B1%E9%80%90%E8%88%B0%E6%9C%8D%E5%BD%B9%E4%BB%AA%E5%BC%8F-%E8%AF%A5%E8%88%B0%E5%B0%86%E8%A2%AB%E7%BA%B3%E5%85%A5%E6%A0%B8%E5%8F%8D%E5%87%BB%E4%BD%93%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788780186000.webp","sourceId":"rfi"},{"id":1788779415000,"createdDate":"2026-09-07 11:10","name":"法国国际广播电台","title":"尼泊尔洪灾后第13天 ：全国哀悼、遇难家属焦急等待救援消息","content":"尽管尼泊尔搜救泥石流幸存者的行动仍在持续，但随着数千名失踪者家属的焦灼情绪日益加剧，尼泊尔周一举行全国哀悼，来纪念8月26日那场致命洪灾中的遇难者。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE%E5%90%8E%E7%AC%AC13%E5%A4%A9-%E5%85%A8%E5%9B%BD%E5%93%80%E6%82%BC-%E5%AE%B6%E5%B1%9E%E7%84%A6%E6%80%A5%E7%AD%89%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788779415000.webp","sourceId":"rfi"},{"id":1788778876000,"createdDate":"2026-09-07 11:01","name":"法国国际广播电台","title":"法媒纷纷关注“德国最危险的人”能否出任萨安州长？凭自己的“梅斯默计划”中国核电装机容量超越法国","content":"星期天举行的德国萨安州州议会的选举结果引发轰动，一向被视为党纲偏向极右翼主张的德国“选择党”获得历史性胜利，给德国总理默茨带来新的执政难题，不约而同地成为今天周一9月7日法国《费加罗报》、《解放报》和《回声报》的头版焦点。此外，周刊《快报》登文指出，中国这个亚洲巨头目前拥有全球第二大核反应堆群。与此同时，法国则跌至第三位。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260907-%E6%B3%95%E5%AA%92%E7%BA%B7%E7%BA%B7%E5%85%B3%E6%B3%A8-%E5%BE%B7%E5%9B%BD%E6%9C%80%E5%8D%B1%E9%99%A9%E7%9A%84%E4%BA%BA-%E8%83%BD%E5%90%A6%E5%87%BA%E4%BB%BB%E8%90%A8%E5%AE%89%E5%B7%9E%E9%95%BF-%E5%87%AD%E8%87%AA%E5%B7%B1%E7%9A%84-%E6%A2%85%E6%96%AF%E9%BB%98%E8%AE%A1%E5%88%92-%E4%B8%AD%E5%9B%BD%E6%A0%B8%E7%94%B5%E8%A3%85%E6%9C%BA%E5%AE%B9%E9%87%8F%E8%B6%85%E8%B6%8A%E6%B3%95%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788778876000.webp","sourceId":"rfi"},{"id":1788775941000,"createdDate":"2026-09-07 10:12","name":"法国国际广播电台","title":"日本10年期国债收益率猛涨为什么引起日美异常紧张？","content":"日本10年期国债收益率9月1日一度升至年利率3.005%。10年期国债收益率升至3%区间，是自1996年9月以来时隔30年再次出现这一水平。与此同时，在上月日美协调干预汇市之后，日元再度贬值，目前已接近1美元兑160日元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260907-%E6%97%A5%E6%9C%AC10%E5%B9%B4%E6%9C%9F%E5%9B%BD%E5%80%BA%E6%94%B6%E7%9B%8A%E7%8E%87%E7%8C%9B%E6%B6%A8%E4%B8%BA%E4%BB%80%E4%B9%88%E5%BC%95%E8%B5%B7%E6%97%A5%E7%BE%8E%E5%BC%82%E5%B8%B8%E7%B4%A7%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788775941000.webp","sourceId":"rfi"},{"id":1788772214000,"createdDate":"2026-09-07 09:10","name":"法国国际广播电台","title":"日本战机紧急起飞对应中俄军机","content":"日本防卫省X9月7日报道，日本时间2026年9月6日下午，日本方面确认，中国军队1架Y-9型情报收集机从大陆方向飞来，沿东海上空飞行至长崎县男女群岛以南海域，随后向西南方向飞行，在冲绳本岛附近海域掉头向东北方向飞行，之后又在男女群岛以南海域改变航向，向大陆方向飞行。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E6%97%A5%E6%9C%AC%E6%88%98%E6%9C%BA%E7%B4%A7%E6%80%A5%E8%B5%B7%E9%A3%9E%E5%AF%B9%E5%BA%94%E4%B8%AD%E4%BF%84%E5%86%9B%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788772214000.webp","sourceId":"rfi"},{"id":1788770802000,"createdDate":"2026-09-07 08:46","name":"法国国际广播电台","title":"50年后台湾人口数将腰斩 比少子化更危急的是「有多少人能让社会继续运转」？","content":"国发会公布数据台湾总人口在2075年可能只剩1215万人，工作年龄人口更可能减至513万人。比起台湾未来没有小孩，缺乏能让台湾社会继续运转的人将成棘手问题。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260907-50%E5%B9%B4%E5%90%8E%E5%8F%B0%E6%B9%BE%E4%BA%BA%E5%8F%A3%E6%95%B0%E5%B0%86%E8%85%B0%E6%96%A9-%E6%AF%94%E5%B0%91%E5%AD%90%E5%8C%96%E6%9B%B4%E5%8D%B1%E6%80%A5%E7%9A%84%E6%98%AF-%E6%9C%89%E5%A4%9A%E5%B0%91%E4%BA%BA%E8%83%BD%E8%AE%A9%E7%A4%BE%E4%BC%9A%E7%BB%A7%E7%BB%AD%E8%BF%90%E8%BD%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788770802000.webp","sourceId":"rfi"},{"id":1788768761000,"createdDate":"2026-09-07 08:12","name":"法国国际广播电台","title":"朝鲜最新驱逐舰“姜健号”入列 将纳入核反击系统","content":"朝鲜领导人金正恩表示，朝鲜最新型驱逐舰“姜健号”（KangKon）将成为朝鲜核反击的一部分，可实施“毁灭性报复打击”。朝鲜官媒朝中社周一（9月7日）的报道中未说明该舰是否搭载核武器。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E6%9C%9D%E9%B2%9C%E6%9C%80%E6%96%B0%E9%A9%B1%E9%80%90%E8%88%B0-%E5%A7%9C%E5%81%A5%E5%8F%B7-%E5%85%A5%E5%88%97-%E5%B0%86%E7%BA%B3%E5%85%A5%E6%A0%B8%E5%8F%8D%E5%87%BB%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768761000.webp","sourceId":"rfi"},{"id":1788768692000,"createdDate":"2026-09-07 08:11","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第7：雅典的黄金时代之2：戏剧的繁盛","content":"黄金时代的雅典百花齐放，但有几株奇葩格外醒目，戏剧就是其中一株。这些戏剧无论是悲剧还是喜剧，一出现就站到了人类戏剧史的巅峰。它们不仅从古代神话与历史中汲取精神力量，也从雅典的现实政治与精神生活中反思人类社会的普遍法则。它以戏剧的艺术形式开掘出人类精神生活的深层维度，以极具穿透力的批判性思维面对历史与现实。这些伟大的剧作家是人类文明价值最清醒的守卫者。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260907-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC7-%E9%9B%85%E5%85%B8%E7%9A%84%E9%BB%84%E9%87%91%E6%97%B6%E4%BB%A3%E4%B9%8B2-%E6%88%8F%E5%89%A7%E7%9A%84%E7%B9%81%E7%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768692000.webp","sourceId":"rfi"},{"id":1788768162000,"createdDate":"2026-09-07 08:02","name":"法国国际广播电台","title":"德国萨安州选民为何踊跃选择了选择党","content":"周日的德国萨安州州议会选举初步结果引起轰动，被德国宪法保护局定为有极右翼嫌疑的选择党获历史性胜利，给德国带来新的难题。选举当晚，各党派纷纷作出反应。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260907-%E5%BE%B7%E5%9B%BD%E8%90%A8%E5%AE%89%E5%B7%9E%E9%80%89%E6%B0%91%E4%B8%BA%E4%BD%95%E8%B8%8A%E8%B7%83%E9%80%89%E6%8B%A9%E4%BA%86%E9%80%89%E6%8B%A9%E5%85%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768162000.webp","sourceId":"rfi"},{"id":1788764952000,"createdDate":"2026-09-07 07:09","name":"法国国际广播电台","title":"三人疑因持鲜花悼「831」冲突七周年兼求真相 遭国安警以涉煽动拘捕","content":"3名市民疑因于8月31日在港铁太子站外，以手持花束等行动纪念反修例运动「831」事件七周年，并要求警方提供831事件的真相，被港警国安处引用《维护国家安全条例》（简称《基本法》23条）拘捕。警方指，被捕者涉嫌散播假消息，强调，2019年所谓「831事件」并无事实根据，拘捕行动仍然继续。但警方并没有说明，所谓的假消息是指831当日没有人死或是没有人受伤。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260907-%E4%B8%89%E4%BA%BA%E7%96%91%E5%9B%A0%E6%8C%81%E9%B2%9C%E8%8A%B1%E6%82%BC-831-%E5%86%B2%E7%AA%81%E4%B8%83%E5%91%A8%E5%B9%B4%E5%85%BC%E6%B1%82%E7%9C%9F%E7%9B%B8-%E9%81%AD%E5%9B%BD%E5%AE%89%E8%AD%A6%E4%BB%A5%E6%B6%89%E7%85%BD%E5%8A%A8%E6%8B%98%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788764952000.webp","sourceId":"rfi"}]