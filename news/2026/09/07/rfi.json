[{"id":1788789897000,"createdDate":"2026-09-07 14:04","name":"法国国际广播电台","title":"台国安官员猜中共20大的中央委员超过四分之一將被清洗","content":"中共预计10月召开五中全会，政军高层清洗仍持续进行，包括日前人大常委会决议免去张又侠、刘振立的中国国家军委副主席及军委委员职务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E5%8F%B0%E5%9B%BD%E5%AE%89%E5%AE%98%E5%91%98%E7%8C%9C%E4%B8%AD%E5%85%B120%E5%A4%A7%E7%9A%84%E4%B8%AD%E5%A4%AE%E5%A7%94%E5%91%98%E8%B6%85%E8%BF%87%E5%9B%9B%E5%88%86%E4%B9%8B%E4%B8%80%E5%B0%87%E8%A2%AB%E6%B8%85%E6%B4%97","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788789897000.webp","sourceId":"rfi"},{"id":1788788555000,"createdDate":"2026-09-07 13:42","name":"法国国际广播电台","title":"伊朗警告韩国勿介入霍尔木兹海峡 首尔宣布放缓派兵筹备","content":"伊朗外交部周一警告韩国，切勿在霍尔木兹海峡部署军队或参与美国的军事行动，并警告称此类举动将带来“严重后果”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E9%9F%A9%E5%9B%BD%E5%8B%BF%E4%BB%8B%E5%85%A5%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E9%A6%96%E5%B0%94%E5%AE%A3%E5%B8%83%E6%94%BE%E7%BC%93%E6%B4%BE%E5%85%B5%E7%AD%B9%E5%A4%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788788555000.webp","sourceId":"rfi"},{"id":1788787747000,"createdDate":"2026-09-07 13:29","name":"法国国际广播电台","title":"地区冲突不断 粮食价格升至三年来最高水平","content":"受霍尔木兹海峡和俄乌冲突等因素的影响，国际市场谷物价格近期攀升至三年多来的最高水平。面对日益动荡的世界局势，从北京到德里，从奥斯陆到伯尔尼，世界各国正在重启或巩固其粮食储备计划，这些国家正准备应对艰难的局面：由极其严重的地缘政治或环境危机引发的粮食价格攀升。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20260907-%E5%9C%B0%E5%8C%BA%E5%86%B2%E7%AA%81%E4%B8%8D%E6%96%AD-%E7%B2%AE%E9%A3%9F%E4%BB%B7%E6%A0%BC%E5%8D%87%E8%87%B3%E4%B8%89%E5%B9%B4%E6%9D%A5%E6%9C%80%E9%AB%98%E6%B0%B4%E5%B9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788787747000.webp","sourceId":"rfi"},{"id":1788787473000,"createdDate":"2026-09-07 13:24","name":"法国国际广播电台","title":"菲律宾防长 : 美韩军演减少 中国或将伺机而动","content":"菲律宾国防部长特奥多罗周一表示，中国可能将近期美韩缩减联合军演视为在印太地区重振其作用的时机，并表示华盛顿已向马尼拉保证其军事承诺不变。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E9%98%B2%E9%95%BF-%E7%BE%8E%E9%9F%A9%E5%86%9B%E6%BC%94%E5%87%8F%E5%B0%91-%E4%B8%AD%E5%9B%BD%E6%88%96%E5%B0%86%E4%BC%BA%E6%9C%BA%E8%80%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788787473000.webp","sourceId":"rfi"},{"id":1788780186000,"createdDate":"2026-09-07 11:23","name":"法国国际广播电台","title":"金正恩携女儿出席新驱逐舰服役仪式：该舰将被纳入核反击体系","content":"朝鲜新型5000吨级驱逐舰“姜健”号正式开始服役。朝鲜国家电视台周一（9月7日）播出的画面显示，领导人金正恩携女儿金主爱出席了这艘新驱逐舰的服役仪式,称“姜健”号将被纳入核反击体系。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E9%87%91%E6%AD%A3%E6%81%A9%E6%90%BA%E5%A5%B3%E5%84%BF%E5%87%BA%E5%B8%AD%E6%96%B0%E9%A9%B1%E9%80%90%E8%88%B0%E6%9C%8D%E5%BD%B9%E4%BB%AA%E5%BC%8F-%E8%AF%A5%E8%88%B0%E5%B0%86%E8%A2%AB%E7%BA%B3%E5%85%A5%E6%A0%B8%E5%8F%8D%E5%87%BB%E4%BD%93%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788780186000.webp","sourceId":"rfi"},{"id":1788779415000,"createdDate":"2026-09-07 11:10","name":"法国国际广播电台","title":"尼泊尔洪灾后第13天 ：全国哀悼、遇难家属焦急等待救援消息","content":"尽管尼泊尔搜救泥石流幸存者的行动仍在持续，但随着数千名失踪者家属的焦灼情绪日益加剧，尼泊尔周一举行全国哀悼，来纪念8月26日那场致命洪灾中的遇难者。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE%E5%90%8E%E7%AC%AC13%E5%A4%A9-%E5%85%A8%E5%9B%BD%E5%93%80%E6%82%BC-%E5%AE%B6%E5%B1%9E%E7%84%A6%E6%80%A5%E7%AD%89%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788779415000.webp","sourceId":"rfi"},{"id":1788778876000,"createdDate":"2026-09-07 11:01","name":"法国国际广播电台","title":"法媒纷纷关注“德国最危险的人”能否出任萨安州长？凭自己的“梅斯默计划”中国核电装机容量超越法国","content":"星期天举行的德国萨安州州议会的选举结果引发轰动，一向被视为党纲偏向极右翼主张的德国“选择党”获得历史性胜利，给德国总理默茨带来新的执政难题，不约而同地成为今天周一9月7日法国《费加罗报》、《解放报》和《回声报》的头版焦点。此外，周刊《快报》登文指出，中国这个亚洲巨头目前拥有全球第二大核反应堆群。与此同时，法国则跌至第三位。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260907-%E6%B3%95%E5%AA%92%E7%BA%B7%E7%BA%B7%E5%85%B3%E6%B3%A8-%E5%BE%B7%E5%9B%BD%E6%9C%80%E5%8D%B1%E9%99%A9%E7%9A%84%E4%BA%BA-%E8%83%BD%E5%90%A6%E5%87%BA%E4%BB%BB%E8%90%A8%E5%AE%89%E5%B7%9E%E9%95%BF-%E5%87%AD%E8%87%AA%E5%B7%B1%E7%9A%84-%E6%A2%85%E6%96%AF%E9%BB%98%E8%AE%A1%E5%88%92-%E4%B8%AD%E5%9B%BD%E6%A0%B8%E7%94%B5%E8%A3%85%E6%9C%BA%E5%AE%B9%E9%87%8F%E8%B6%85%E8%B6%8A%E6%B3%95%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788778876000.webp","sourceId":"rfi"},{"id":1788775941000,"createdDate":"2026-09-07 10:12","name":"法国国际广播电台","title":"日本10年期国债收益率猛涨为什么引起日美异常紧张？","content":"日本10年期国债收益率9月1日一度升至年利率3.005%。10年期国债收益率升至3%区间，是自1996年9月以来时隔30年再次出现这一水平。与此同时，在上月日美协调干预汇市之后，日元再度贬值，目前已接近1美元兑160日元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260907-%E6%97%A5%E6%9C%AC10%E5%B9%B4%E6%9C%9F%E5%9B%BD%E5%80%BA%E6%94%B6%E7%9B%8A%E7%8E%87%E7%8C%9B%E6%B6%A8%E4%B8%BA%E4%BB%80%E4%B9%88%E5%BC%95%E8%B5%B7%E6%97%A5%E7%BE%8E%E5%BC%82%E5%B8%B8%E7%B4%A7%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788775941000.webp","sourceId":"rfi"},{"id":1788772214000,"createdDate":"2026-09-07 09:10","name":"法国国际广播电台","title":"日本战机紧急起飞对应中俄军机","content":"日本防卫省X9月7日报道，日本时间2026年9月6日下午，日本方面确认，中国军队1架Y-9型情报收集机从大陆方向飞来，沿东海上空飞行至长崎县男女群岛以南海域，随后向西南方向飞行，在冲绳本岛附近海域掉头向东北方向飞行，之后又在男女群岛以南海域改变航向，向大陆方向飞行。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260907-%E6%97%A5%E6%9C%AC%E6%88%98%E6%9C%BA%E7%B4%A7%E6%80%A5%E8%B5%B7%E9%A3%9E%E5%AF%B9%E5%BA%94%E4%B8%AD%E4%BF%84%E5%86%9B%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788772214000.webp","sourceId":"rfi"},{"id":1788770802000,"createdDate":"2026-09-07 08:46","name":"法国国际广播电台","title":"50年后台湾人口数将腰斩 比少子化更危急的是「有多少人能让社会继续运转」？","content":"国发会公布数据台湾总人口在2075年可能只剩1215万人，工作年龄人口更可能减至513万人。比起台湾未来没有小孩，缺乏能让台湾社会继续运转的人将成棘手问题。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260907-50%E5%B9%B4%E5%90%8E%E5%8F%B0%E6%B9%BE%E4%BA%BA%E5%8F%A3%E6%95%B0%E5%B0%86%E8%85%B0%E6%96%A9-%E6%AF%94%E5%B0%91%E5%AD%90%E5%8C%96%E6%9B%B4%E5%8D%B1%E6%80%A5%E7%9A%84%E6%98%AF-%E6%9C%89%E5%A4%9A%E5%B0%91%E4%BA%BA%E8%83%BD%E8%AE%A9%E7%A4%BE%E4%BC%9A%E7%BB%A7%E7%BB%AD%E8%BF%90%E8%BD%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788770802000.webp","sourceId":"rfi"},{"id":1788768761000,"createdDate":"2026-09-07 08:12","name":"法国国际广播电台","title":"朝鲜最新驱逐舰“姜健号”入列 将纳入核反击系统","content":"朝鲜领导人金正恩表示，朝鲜最新型驱逐舰“姜健号”（KangKon）将成为朝鲜核反击的一部分，可实施“毁灭性报复打击”。朝鲜官媒朝中社周一（9月7日）的报道中未说明该舰是否搭载核武器。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E6%9C%9D%E9%B2%9C%E6%9C%80%E6%96%B0%E9%A9%B1%E9%80%90%E8%88%B0-%E5%A7%9C%E5%81%A5%E5%8F%B7-%E5%85%A5%E5%88%97-%E5%B0%86%E7%BA%B3%E5%85%A5%E6%A0%B8%E5%8F%8D%E5%87%BB%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768761000.webp","sourceId":"rfi"},{"id":1788768692000,"createdDate":"2026-09-07 08:11","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第7：雅典的黄金时代之2：戏剧的繁盛","content":"黄金时代的雅典百花齐放，但有几株奇葩格外醒目，戏剧就是其中一株。这些戏剧无论是悲剧还是喜剧，一出现就站到了人类戏剧史的巅峰。它们不仅从古代神话与历史中汲取精神力量，也从雅典的现实政治与精神生活中反思人类社会的普遍法则。它以戏剧的艺术形式开掘出人类精神生活的深层维度，以极具穿透力的批判性思维面对历史与现实。这些伟大的剧作家是人类文明价值最清醒的守卫者。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260907-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC7-%E9%9B%85%E5%85%B8%E7%9A%84%E9%BB%84%E9%87%91%E6%97%B6%E4%BB%A3%E4%B9%8B2-%E6%88%8F%E5%89%A7%E7%9A%84%E7%B9%81%E7%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768692000.webp","sourceId":"rfi"},{"id":1788768162000,"createdDate":"2026-09-07 08:02","name":"法国国际广播电台","title":"德国萨安州选民为何踊跃选择了选择党","content":"周日的德国萨安州州议会选举初步结果引起轰动，被德国宪法保护局定为有极右翼嫌疑的选择党获历史性胜利，给德国带来新的难题。选举当晚，各党派纷纷作出反应。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260907-%E5%BE%B7%E5%9B%BD%E8%90%A8%E5%AE%89%E5%B7%9E%E9%80%89%E6%B0%91%E4%B8%BA%E4%BD%95%E8%B8%8A%E8%B7%83%E9%80%89%E6%8B%A9%E4%BA%86%E9%80%89%E6%8B%A9%E5%85%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788768162000.webp","sourceId":"rfi"},{"id":1788764952000,"createdDate":"2026-09-07 07:09","name":"法国国际广播电台","title":"三人疑因持鲜花悼「831」冲突七周年兼求真相 遭国安警以涉煽动拘捕","content":"3名市民疑因于8月31日在港铁太子站外，以手持花束等行动纪念反修例运动「831」事件七周年，并要求警方提供831事件的真相，被港警国安处引用《维护国家安全条例》（简称《基本法》23条）拘捕。警方指，被捕者涉嫌散播假消息，强调，2019年所谓「831事件」并无事实根据，拘捕行动仍然继续。但警方并没有说明，所谓的假消息是指831当日没有人死或是没有人受伤。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260907-%E4%B8%89%E4%BA%BA%E7%96%91%E5%9B%A0%E6%8C%81%E9%B2%9C%E8%8A%B1%E6%82%BC-831-%E5%86%B2%E7%AA%81%E4%B8%83%E5%91%A8%E5%B9%B4%E5%85%BC%E6%B1%82%E7%9C%9F%E7%9B%B8-%E9%81%AD%E5%9B%BD%E5%AE%89%E8%AD%A6%E4%BB%A5%E6%B6%89%E7%85%BD%E5%8A%A8%E6%8B%98%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788764952000.webp","sourceId":"rfi"},{"id":1788823367000,"createdDate":"2026-09-07 23:22","name":"法国国际广播电台","title":"尼日尔:未遂兵变后军内清洗持续","content":"在非洲内陆国尼日尔（leNiger）,08月29日星期六的未遂兵变过去十天后，针对军方人员及同谋嫌疑人的逮捕行动仍在继续之中。这是本台法广非洲组（RFIAfrique）于2026年09月07星期一刊出的法文消息话题之一。据地区安全消息渠道透露，被捕者人数众多。尼日尔的中文国名也有译作[尼日共和国](RepublicofNiger)。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260907-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%B0%BC%E6%97%A5%E5%B0%94-%E6%9C%AA%E9%81%82%E5%85%B5%E5%8F%98%E5%90%8E%E5%86%9B%E5%86%85%E6%B8%85%E6%B4%97%E6%8C%81%E7%BB%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788823367000.webp","sourceId":"rfi"},{"id":1788821425000,"createdDate":"2026-09-07 22:50","name":"法国国际广播电台","title":"德国选择党历史性大胜逼近州级执政，法国政界拉响警报","content":"德国东部萨克森-安哈尔特州的州议会在9月6日举行选举，极右翼德国选择党的历史性胜利，7日起在欧洲引发震动和思考。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260907-%E5%BE%B7%E5%9B%BD%E9%80%89%E6%8B%A9%E5%85%9A%E5%8E%86%E5%8F%B2%E6%80%A7%E5%A4%A7%E8%83%9C%E9%80%BC%E8%BF%91%E5%B7%9E%E7%BA%A7%E6%89%A7%E6%94%BF%EF%BC%8C%E6%B3%95%E5%9B%BD%E6%94%BF%E7%95%8C%E6%8B%89%E5%93%8D%E8%AD%A6%E6%8A%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788821425000.webp","sourceId":"rfi"},{"id":1788818381000,"createdDate":"2026-09-07 21:59","name":"法国国际广播电台","title":"下滑，这是2026年中国汽车市场最重要的关键词","content":"2026年的中国汽车市场，最突出的关键词不是增长，而是下滑。市场在下滑，销量在下滑，消费者需求在下滑，车企利润也在下滑。而且，下滑已经不是短期的波动，而正在演变成一种持续性的市场趋势。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260907-%E4%B8%8B%E6%BB%91%EF%BC%8C%E8%BF%99%E6%98%AF2026%E5%B9%B4%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%B8%82%E5%9C%BA%E6%9C%80%E9%87%8D%E8%A6%81%E7%9A%84%E5%85%B3%E9%94%AE%E8%AF%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788818381000.webp","sourceId":"rfi"},{"id":1788817411000,"createdDate":"2026-09-07 21:43","name":"法国国际广播电台","title":"马克龙推动在整个欧盟禁止15岁以下使用社交媒体","content":"法新社报道，法国总统马克龙给欧盟委员会主席冯德莱恩写信，要求冯德莱恩在欧盟层面推动制定法律，以禁止15岁以下未成年人使用社交媒体。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260907-%E9%A9%AC%E5%85%8B%E9%BE%99%E6%8E%A8%E5%8A%A8%E5%9C%A8%E6%95%B4%E4%B8%AA%E6%AC%A7%E7%9B%9F%E7%A6%81%E6%AD%A215%E5%B2%81%E4%BB%A5%E4%B8%8B%E4%BD%BF%E7%94%A8%E7%A4%BE%E4%BA%A4%E5%AA%92%E4%BD%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788817411000.webp","sourceId":"rfi"},{"id":1788816704000,"createdDate":"2026-09-07 21:31","name":"法国国际广播电台","title":"印度教代表团要求女员工“隐身”引众怒 埃菲尔铁塔罢工关闭一天","content":"巴黎埃菲尔铁塔周一(9月7日）因员工罢工全天关闭。此前，一个印度教代表团参观铁塔时，女性工作人员被要求“回避”，令员工深感震惊，这一事件在法国引发强烈愤慨。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E5%8D%B0%E5%BA%A6%E6%95%99%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%A6%81%E6%B1%82%E5%A5%B3%E5%91%98%E5%B7%A5-%E9%9A%90%E8%BA%AB-%E5%BC%95%E4%BC%97%E6%80%92-%E5%9F%83%E8%8F%B2%E5%B0%94%E9%93%81%E5%A1%94%E7%BD%A2%E5%B7%A5%E5%85%B3%E9%97%AD%E4%B8%80%E5%A4%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788816704000.webp","sourceId":"rfi"},{"id":1788816467000,"createdDate":"2026-09-07 21:27","name":"法国国际广播电台","title":"路透：中国军方加速研究人形机器人 探索未来战场应用","content":"路透社查阅超过100份中国军方招标文件、学术论文、专利、出版物及此前未披露的官方文件后，周一（9月7日）发文称，中国军方正加速研究人形机器人的军事应用，并为未来可能在战时部署这类机器人做准备。相关文件显示，中国军方已在模拟实战环境中测试机器人，并探索其与士兵协同执行任务的可能性。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E8%B7%AF%E9%80%8F-%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E5%8A%A0%E9%80%9F%E7%A0%94%E7%A9%B6%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA-%E6%8E%A2%E7%B4%A2%E6%9C%AA%E6%9D%A5%E6%88%98%E5%9C%BA%E5%BA%94%E7%94%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788816467000.webp","sourceId":"rfi"},{"id":1788816255000,"createdDate":"2026-09-07 21:24","name":"法国国际广播电台","title":"美加贸易争端升级 特朗普威胁封杀庞巴迪飞机在美销售","content":"加拿大针对一系列美国产品加征的关税即将生效之际，美国总统特朗普周一（9月7日）威胁限制加拿大飞机制造商庞巴迪在美国销售产品，使这美加之间的贸易冲突进一步升级。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E7%BE%8E%E5%8A%A0%E8%B4%B8%E6%98%93%E4%BA%89%E7%AB%AF%E5%8D%87%E7%BA%A7-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A8%81%E8%83%81%E5%B0%81%E6%9D%80%E5%BA%9E%E5%B7%B4%E8%BF%AA%E9%A3%9E%E6%9C%BA%E5%9C%A8%E7%BE%8E%E9%94%80%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788816255000.webp","sourceId":"rfi"},{"id":1788816053000,"createdDate":"2026-09-07 21:20","name":"法国国际广播电台","title":"冯德莱恩结束格陵兰之行 宣布提供2亿欧元资金","content":"欧盟委员会主席冯德莱恩周一(9月7日）访问格陵兰期间宣布，将向这一自治领地提供2亿欧元资金。在美国总统特朗普声称有意控制格陵兰之际，欧盟希望以此表明坚定支持格陵兰的立场。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260907-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9%E7%BB%93%E6%9D%9F%E6%A0%BC%E9%99%B5%E5%85%B0%E4%B9%8B%E8%A1%8C-%E5%AE%A3%E5%B8%83%E6%8F%90%E4%BE%9B2%E4%BA%BF%E6%AC%A7%E5%85%83%E8%B5%84%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788816053000.webp","sourceId":"rfi"},{"id":1788815956000,"createdDate":"2026-09-07 21:19","name":"法国国际广播电台","title":"美收紧移民政策冲击学界 中国科研人才回流、国际学生转向","content":"美国收紧移民及国际学生政策之际，中国科研人才回流增加，美国大学则面临国际学生申请、签证及入学人数下降压力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E7%BE%8E%E6%94%B6%E7%B4%A7%E7%A7%BB%E6%B0%91%E6%94%BF%E7%AD%96%E5%86%B2%E5%87%BB%E5%AD%A6%E7%95%8C-%E4%B8%AD%E5%9B%BD%E7%A7%91%E7%A0%94%E4%BA%BA%E6%89%8D%E5%9B%9E%E6%B5%81-%E5%9B%BD%E9%99%85%E5%AD%A6%E7%94%9F%E8%BD%AC%E5%90%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788815956000.webp","sourceId":"rfi"},{"id":1788815900000,"createdDate":"2026-09-07 21:18","name":"法国国际广播电台","title":"德国《巴登报》看萨安州选举：德国的转折点","content":"有极右翼嫌疑的选择党在德国萨安州选举中获得历史性胜利，使执政党基民盟陷入危机。选择党的巨大胜利不仅引发德国政坛大地震，也引发国际社会关注。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E5%BE%B7%E5%9B%BD-%E5%B7%B4%E7%99%BB%E6%8A%A5-%E7%9C%8B%E8%90%A8%E5%AE%89%E5%B7%9E%E9%80%89%E4%B8%BE-%E5%BE%B7%E5%9B%BD%E7%9A%84%E8%BD%AC%E6%8A%98%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788815900000.webp","sourceId":"rfi"},{"id":1788811553000,"createdDate":"2026-09-07 20:05","name":"法国国际广播电台","title":"肯尼亚要外国小商铺关门惹争议","content":"在位于非洲东部、濒临印度洋的肯尼亚（leKenya），该国总统日前要求由外国人经营的小型商铺自今天（2026年09月07日星期一）起停业。这是本台法广非洲组（RFIAfrique）法文报道当天的关注话题之一。这一原本旨在平息当地商户因反对上调进口税而发起的抗议示威的宣布，引发舆论强烈担忧助长歧视和仇外。有众多侨民在肯尼亚境内谋生的非洲内陆国布隆迪（leBurundi）当局现已做出外交反应。肯尼亚的中文国名也有译作肯亚（JamhuriyaKenya）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260907-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E8%82%AF%E5%B0%BC%E4%BA%9A%E8%A6%81%E5%A4%96%E5%9B%BD%E5%B0%8F%E5%95%86%E8%B4%A9%E5%85%B3%E9%97%A8%E6%83%B9%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788811553000.webp","sourceId":"rfi"},{"id":1788811304000,"createdDate":"2026-09-07 20:01","name":"法国国际广播电台","title":"俄罗斯要求德国关闭德驻圣彼得堡总领馆和两所歌德学院","content":"俄罗斯外交部9月7日星期二宣布，已要求德国关闭、停止运营其驻俄罗斯圣彼得堡总领事馆，该领馆工作人员9月18日前必须离开俄罗斯。俄方表示，这是对德国近期涉俄决策的反制措施。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E4%BF%84%E7%BD%97%E6%96%AF%E8%A6%81%E6%B1%82%E5%BE%B7%E5%9B%BD%E5%85%B3%E9%97%AD%E5%BE%B7%E9%A9%BB%E5%9C%A3%E5%BD%BC%E5%BE%97%E5%A0%A1%E6%80%BB%E9%A2%86%E9%A6%86%E5%92%8C%E4%B8%A4%E6%89%80%E6%AD%8C%E5%BE%B7%E5%AD%A6%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788811304000.webp","sourceId":"rfi"},{"id":1788803093000,"createdDate":"2026-09-07 17:44","name":"法国国际广播电台","title":"泽连斯基与美国特使会谈后表示正筹备后续谈判","content":"乌克兰总统周一表示，在唐纳德·特朗普的特使访问莫斯科和基辅、试图重启旨在结束俄罗斯入侵乌克兰的外交进程后，他正在筹备后续谈判。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E4%B8%8E%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF%E4%BC%9A%E8%B0%88%E5%90%8E%E8%A1%A8%E7%A4%BA%E6%AD%A3%E7%AD%B9%E5%A4%87%E5%90%8E%E7%BB%AD%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788803093000.webp","sourceId":"rfi"},{"id":1788801579000,"createdDate":"2026-09-07 17:19","name":"法国国际广播电台","title":"所罗门群岛总理成功抵御弹劾 即将与澳洲签署原则性协议","content":"正逐步使所罗门群岛与中国保持距离的总理马修·瓦莱（MatthewWale）周一成功抵御了一次不信任动议，并暂停了议会工作，以避免再次发生叛乱。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E6%89%80%E7%BD%97%E9%97%A8%E7%BE%A4%E5%B2%9B%E6%80%BB%E7%90%86%E6%88%90%E5%8A%9F%E6%8A%B5%E5%BE%A1%E5%BC%B9%E5%8A%BE-%E5%8D%B3%E5%B0%86%E4%B8%8E%E6%BE%B3%E6%B4%B2%E7%AD%BE%E7%BD%B2%E5%8E%9F%E5%88%99%E6%80%A7%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788801579000.webp","sourceId":"rfi"},{"id":1788800564000,"createdDate":"2026-09-07 17:02","name":"法国国际广播电台","title":"比利时拘留一名涉半导体间谍活动的中国男","content":"路透社9月7日布鲁塞尔消息，比利时检察官表示，他们已将一名拥有中国和比利时双重国籍的男子拘留，该男子涉嫌在半导体技术案件中从事间谍活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E6%AF%94%E5%88%A9%E6%97%B6%E6%8B%98%E7%95%99%E4%B8%80%E5%90%8D%E6%B6%89%E5%8D%8A%E5%AF%BC%E4%BD%93%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E4%B8%AD%E5%9B%BD%E7%94%B7%E5%AD%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788800564000.webp","sourceId":"rfi"},{"id":1788798928000,"createdDate":"2026-09-07 16:35","name":"法国国际广播电台","title":"中国惊险赛车事故：荷兰“超级英雄”从火中救出一名比赛对手","content":"英国车手奥利·米尔罗伊感谢他的“超级英雄”洛克·哈托格，在中国超级跑车锦标赛GT一场比赛中发生严重事故后，从燃烧的赛车中将他救了出来。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E4%B8%AD%E5%9B%BD%E6%83%8A%E9%99%A9%E8%B5%9B%E8%BD%A6%E4%BA%8B%E6%95%85-%E8%8D%B7%E5%85%B0-%E8%B6%85%E7%BA%A7%E8%8B%B1%E9%9B%84-%E4%BB%8E%E7%81%AB%E4%B8%AD%E6%95%91%E5%87%BA%E4%B8%80%E5%90%8D%E6%AF%94%E8%B5%9B%E5%AF%B9%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788798928000.webp","sourceId":"rfi"},{"id":1788793003000,"createdDate":"2026-09-07 14:56","name":"法国国际广播电台","title":"贝尔格莱德数千人为姆拉迪奇送葬 欧盟谴责美化战犯","content":"法新社报道，周一，数千人聚集在贝尔格莱德，参加波斯尼亚塞族前军事首脑拉特科·姆拉迪奇的隆重葬礼。布鲁塞尔方面再次谴责任何“美化”因在1990年代波斯尼亚战争期间犯有种族灭绝罪而被定罪之人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E8%B4%9D%E5%B0%94%E6%A0%BC%E8%8E%B1%E5%BE%B7%E6%95%B0%E5%8D%83%E4%BA%BA%E4%B8%BA%E5%A7%86%E6%8B%89%E8%BF%AA%E5%A5%87%E9%80%81%E8%91%AC-%E6%AC%A7%E7%9B%9F%E8%B0%B4%E8%B4%A3%E7%BE%8E%E5%8C%96%E6%88%98%E7%8A%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788793003000.webp","sourceId":"rfi"},{"id":1788792332000,"createdDate":"2026-09-07 14:45","name":"法国国际广播电台","title":"联合国人权事务高级专员警告：人工智能可能对人类构成“生存威胁\"","content":"联合国人权事务高级专员沃尔克·图尔克（VolkerTürk）周一（9月7日）警告称，人工智能可能变得足够强大，足以威胁人类，并表示他将在未来几天敦促各公司降低风险。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260907-%E8%81%94%E5%90%88%E5%9B%BD%E4%BA%BA%E6%9D%83%E4%BA%8B%E5%8A%A1%E9%AB%98%E7%BA%A7%E4%B8%93%E5%91%98%E8%AD%A6%E5%91%8A-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%8F%AF%E8%83%BD%E5%AF%B9%E4%BA%BA%E7%B1%BB%E6%9E%84%E6%88%90-%E7%94%9F%E5%AD%98%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788792332000.webp","sourceId":"rfi"},{"id":1788790278000,"createdDate":"2026-09-07 14:11","name":"法国国际广播电台","title":"卢米埃尔峰会 ：法、韩宣布投10亿欧元支持全球电影业","content":"由法国发起、电影界首个国际峰会“卢米埃尔峰会”今天在法国南部圣保罗-德旺斯举行，来自全球55个国家约200名电影和视听行业重量级人物及代表参加这一“电影届达沃斯论坛”，共同探讨面临AI、流媒体、观众流失威胁的第七艺术的未来，法国总统马克龙与韩国总统李在明共同主持峰会。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260907-%E5%8D%A2%E7%B1%B3%E5%9F%83%E5%B0%94%E5%B3%B0%E4%BC%9A-%E6%B3%95-%E9%9F%A9%E6%8A%95%E5%85%A510%E4%BA%BF%E6%AC%A7%E5%85%83%E6%94%AF%E6%8C%81%E7%94%B5%E5%BD%B1%E4%B8%9A%E5%8F%91%E5%B1%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/07/1788790278000.webp","sourceId":"rfi"}]