[{"id":1788954917000,"createdDate":"2026-09-09 11:55","name":"法国国际广播电台","title":"PISA排名：中国和新加坡名列前茅 OECD国家如法国成绩垫底 因耽溺于屏幕和社媒","content":"在法国、欧洲乃至全世界，学生成绩都像自由落体式般地下滑……这是PISA（ProgrammeforInternationalStudentAssessment）国际学生评估项目排名得出的结论。该项目由经合组织（OECD）每三年进行一次评估。这项全球性研究的结果于昨日9月8日发布，今天9日法国各大报纸头版无不聚焦在这份报告的解读与分析。结果指出，四个中国省份和都市区（北京、上海、江苏和浙江）在科学和数学项目领先。阅读理解能力方面，新加坡居首，而15岁的法国学生却获得了这项调查以来的最差成绩。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260909-pisa%E6%8E%92%E5%90%8D-%E4%B8%AD%E5%9B%BD%E5%92%8C%E6%96%B0%E5%8A%A0%E5%9D%A1%E5%90%8D%E5%88%97%E5%89%8D%E8%8C%85-oecd%E5%9B%BD%E5%AE%B6%E5%A6%82%E6%B3%95%E5%9B%BD%E6%88%90%E7%BB%A9%E5%9E%AB%E5%BA%95-%E5%9B%A0%E8%80%BD%E6%BA%BA%E4%BA%8E%E5%B1%8F%E5%B9%95%E5%92%8C%E7%A4%BE%E5%AA%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788954917000.webp","sourceId":"rfi"},{"id":1788954622000,"createdDate":"2026-09-09 11:50","name":"法国国际广播电台","title":"印度严重欺诈调查局建议对小米在印业务展开“深入”调查","content":"一份政府文件显示，印度公司事务部下属的严重欺诈调查局（SFIO）建议对小米展开调查，理由是该公司在商业模式及遵守外商投资法规方面涉嫌违规；此举可能导致这家智能手机制造商在印度面临更严格的监管审查。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260909-%E5%8D%B0%E5%BA%A6%E4%B8%A5%E9%87%8D%E6%AC%BA%E8%AF%88%E8%B0%83%E6%9F%A5%E5%B1%80%E5%BB%BA%E8%AE%AE%E5%AF%B9%E5%B0%8F%E7%B1%B3%E5%9C%A8%E5%8D%B0%E4%B8%9A%E5%8A%A1%E5%B1%95%E5%BC%80-%E6%B7%B1%E5%85%A5-%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788954622000.webp","sourceId":"rfi"},{"id":1788952581000,"createdDate":"2026-09-09 11:16","name":"法国国际广播电台","title":"回声报论坛：别再幻想中国向欧洲转移技术了！","content":"布鲁塞尔希望像北京长期以来所做的那样，对其境内的战略性外国投资进行更多控制。然而，罗宾·里瓦通（RobinRivaton）这位RealEstech创办人兼时评作家9月8日晚投书《回声报》论坛版提醒道，中国确实拥有欧洲所不具备的独特性，但请别再幻想中国会向欧洲转移技术了。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E5%9B%9E%E5%A3%B0%E6%8A%A5%E8%AE%BA%E5%9D%9B-%E5%88%AB%E5%86%8D%E5%B9%BB%E6%83%B3%E4%B8%AD%E5%9B%BD%E5%90%91%E6%AC%A7%E6%B4%B2%E8%BD%AC%E7%A7%BB%E6%8A%80%E6%9C%AF%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788952581000.webp","sourceId":"rfi"},{"id":1788951522000,"createdDate":"2026-09-09 10:58","name":"法国国际广播电台","title":"外交筹码不再是造桥铺路 台湾芯片外交助邦交危地马拉开发首颗本土芯片","content":"危地马拉山谷大学师生团队开发出首颗本土设计奈米芯片「大美洲虎」，预计采用65奈米制程及台积电技术进行生产。这或许要归功于危地马拉手中的那张「台湾牌」，台湾与危地马拉自2025年开始打造「芯片之路」计画协助产业转型升级。而过去为了利益选择与台湾分道扬镳的拉美国家，如今却也重新把目光投向台湾半导体实力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260909-%E5%A4%96%E4%BA%A4%E7%AD%B9%E7%A0%81%E4%B8%8D%E5%86%8D%E6%98%AF%E9%80%A0%E6%A1%A5%E9%93%BA%E8%B7%AF-%E5%8F%B0%E6%B9%BE%E8%8A%AF%E7%89%87%E5%A4%96%E4%BA%A4%E5%8A%A9%E9%82%A6%E4%BA%A4%E5%8D%B1%E5%9C%B0%E9%A9%AC%E6%8B%89%E5%BC%80%E5%8F%91%E9%A6%96%E9%A2%97%E6%9C%AC%E5%9C%9F%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788951522000.webp","sourceId":"rfi"},{"id":1788949544000,"createdDate":"2026-09-09 10:25","name":"法国国际广播电台","title":"宇树科技股价大跌 中国证监会据报正收紧对人形机器人初创企业的IPO审批","content":"据科技媒体《TheInformation》周三报导称，在人形机器人行业领军企业宇树科技（UnitreeRobotics）上市首日表现剧烈波动之后，中国监管机构正收紧对计划首次公开募股（IPO）的人形机器人初创企业的审批。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E5%AE%87%E6%A0%91%E7%A7%91%E6%8A%80%E8%82%A1%E4%BB%B7%E5%A4%A7%E8%B7%8C-%E4%B8%AD%E5%9B%BD%E8%AF%81%E7%9B%91%E4%BC%9A%E6%8D%AE%E6%8A%A5%E6%AD%A3%E6%94%B6%E7%B4%A7%E5%AF%B9%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%88%9D%E5%88%9B%E4%BC%81%E4%B8%9A%E7%9A%84ipo%E5%AE%A1%E6%89%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788949544000.webp","sourceId":"rfi"},{"id":1788948400000,"createdDate":"2026-09-09 10:06","name":"法国国际广播电台","title":"乌外交部：中方曾请求在丁薛祥访俄期间勿对符拉迪沃斯托克发动袭击","content":"乌克兰外交部发言人季希（HeorhiiTykhyi）证实，中方曾正式请求乌克兰在中国国务院副总理丁薛祥访问俄罗斯期间避免袭击符拉迪沃斯托克（海参崴）。据乌通社报导，季希是在周二举行的新闻发布会上说了这番话。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260909-%E4%B9%8C%E5%A4%96%E4%BA%A4%E9%83%A8-%E4%B8%AD%E6%96%B9%E6%9B%BE%E8%AF%B7%E6%B1%82%E5%9C%A8%E4%B8%81%E8%96%9B%E7%A5%A5%E8%AE%BF%E4%BF%84%E6%9C%9F%E9%97%B4%E5%8B%BF%E5%AF%B9%E7%AC%A6%E6%8B%89%E8%BF%AA%E6%B2%83%E6%96%AF%E6%89%98%E5%85%8B%E5%8F%91%E5%8A%A8%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788948400000.webp","sourceId":"rfi"},{"id":1788947137000,"createdDate":"2026-09-09 09:45","name":"法国国际广播电台","title":"贝森特：若中方在AI上将我们甩在身后，那一切都将变得无关紧要","content":"美国财政部长贝森特（ScottBessent）警告，如果美国在与中国的人工智能（AI）竞赛中落败，将面临严重后果；这番言论凸显了华盛顿对于中方在该领域技术进步的忧虑。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260909-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E8%8B%A5%E4%B8%AD%E6%96%B9%E5%9C%A8ai%E4%B8%8A%E5%B0%86%E6%88%91%E4%BB%AC%E7%94%A9%E5%9C%A8%E8%BA%AB%E5%90%8E%EF%BC%8C%E9%82%A3%E4%B8%80%E5%88%87%E9%83%BD%E5%B0%86%E5%8F%98%E5%BE%97%E6%97%A0%E5%85%B3%E7%B4%A7%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788947137000.webp","sourceId":"rfi"},{"id":1788945567000,"createdDate":"2026-09-09 09:19","name":"法国国际广播电台","title":"美政府指责DeepSeek、阿里等6家中国AI公司“恶意”蒸馏美企前沿模型","content":"美国政府周二指责中国人工智能（AI）公司“以工业规模恶意”蒸馏美国人工智能企业的前沿模型。这一指控可能会使美中领导人定于本月晚些时候举行的会晤面临更复杂的局面。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260909-%E7%BE%8E%E6%94%BF%E5%BA%9C%E6%8C%87%E8%B4%A3deepseek-%E9%98%BF%E9%87%8C%E7%AD%896%E5%AE%B6%E4%B8%AD%E5%9B%BDai%E5%85%AC%E5%8F%B8-%E6%81%B6%E6%84%8F-%E8%92%B8%E9%A6%8F%E7%BE%8E%E5%89%8D%E6%B2%BF%E6%A8%A1%E5%9E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788945567000.webp","sourceId":"rfi"},{"id":1788943906000,"createdDate":"2026-09-09 08:51","name":"法国国际广播电台","title":"AIT处长谷立言：台海若爆发冲突 全球经济损失恐超越二战","content":"台北周三举行“2026台北安全对话”。据台湾媒体报道，美国在台协会（AIT）处长谷立言表示，台海若爆发冲突，对全球经济造成的损失将超越第二次世界大战，因此维护台海与印太地区和平，是美国的重要战略目标。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-ait%E5%A4%84%E9%95%BF%E8%B0%B7%E7%AB%8B%E8%A8%80-%E5%8F%B0%E6%B5%B7%E8%8B%A5%E7%88%86%E5%8F%91%E5%86%B2%E7%AA%81-%E5%85%A8%E7%90%83%E7%BB%8F%E6%B5%8E%E6%8D%9F%E5%A4%B1%E6%81%90%E8%B6%85%E8%B6%8A%E4%BA%8C%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788943906000.webp","sourceId":"rfi"},{"id":1788943430000,"createdDate":"2026-09-09 08:43","name":"法国国际广播电台","title":"针对中国占据主导地位的行业 欧洲议会拟收紧投资条件 确立“欧洲优先”原则","content":"欧洲议会负责拟议《工业加速法案》（IndustrialAcceleratorAct）的报告员们正计划针对中国占据主导地位的行业，限制中国投资进入欧盟市场，这一立场比欧盟委员会此前的建议更为严厉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8D%A0%E6%8D%AE%E4%B8%BB%E5%AF%BC%E5%9C%B0%E4%BD%8D%E7%9A%84%E8%A1%8C%E4%B8%9A-%E6%AC%A7%E6%B4%B2%E8%AE%AE%E4%BC%9A%E6%8B%9F%E6%94%B6%E7%B4%A7%E6%AC%A7%E7%9B%9F%E6%8A%95%E8%B5%84%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788943430000.webp","sourceId":"rfi"},{"id":1788939934000,"createdDate":"2026-09-09 07:45","name":"法国国际广播电台","title":"评论：董建华尊重香港制度和价值 港人续享自由 与中国当年仍需香港大势相关","content":"香港首任特首董建华逝世，引发市民怀念他在任时的香港仍能享有与港英年代相若的自由，但原因则颇为两极，既有指是因为董建华的个人仍尊重香港制度和价值，亦有指是因为中国仍需要不变的香港来吸引资本有关，更有评论认为是两者再加上时任领导人的性格有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-%E8%AF%84%E8%AE%BA-%E8%91%A3%E5%BB%BA%E5%8D%8E%E5%B0%8A%E9%87%8D%E9%A6%99%E6%B8%AF%E5%88%B6%E5%BA%A6%E5%92%8C%E4%BB%B7%E5%80%BC-%E6%B8%AF%E4%BA%BA%E7%BB%AD%E4%BA%AB%E8%87%AA%E7%94%B1-%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%BD%93%E5%B9%B4%E4%BB%8D%E9%9C%80%E9%A6%99%E6%B8%AF%E5%A4%A7%E5%8A%BF%E7%9B%B8%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939934000.webp","sourceId":"rfi"},{"id":1788939582000,"createdDate":"2026-09-09 07:39","name":"法国国际广播电台","title":"香港首任特首董建华逝世 京称「一国两制」贡献者 23条立法失败後提早下台","content":"因健康问题已超过五年没有公开露面的香港特区首任行政长官(简称特首)兼中国政协副主席董建华，昨晚（8日）逝世，享年89岁。中国官方新华社称他是「一国两制」杰出贡献者，然而，由於他任内推动的《基本法》23条立法引发50万港人上街抗议而最终搁置，他未能完成两任任期而提早「脚痛下台」，开启香港特区成立29年来没有一位特首可以当满两任十年任期的先例。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-%E9%A6%99%E6%B8%AF%E9%A6%96%E4%BB%BB%E7%89%B9%E9%A6%96%E8%91%A3%E5%BB%BA%E5%8D%8E%E9%80%9D%E4%B8%96-%E4%BA%AC%E7%A7%B0-%E4%B8%80%E5%9B%BD%E4%B8%A4%E5%88%B6-%E8%B4%A1%E7%8C%AE%E8%80%85-23%E6%9D%A1%E7%AB%8B%E6%B3%95%E5%A4%B1%E8%B4%A5%E5%BE%8C%E6%8F%90%E6%97%A9%E4%B8%8B%E5%8F%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939582000.webp","sourceId":"rfi"},{"id":1788939027000,"createdDate":"2026-09-09 07:30","name":"法国国际广播电台","title":"日本外相与伊朗外长举行电话会谈 强烈要求不要攻击民用船只","content":"日本时间9月8日下午5时30分起，茂木敏充外务大臣与伊朗外长阿拉格齐举行了电话会谈，通话持续25分钟。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260909-%E6%97%A5%E6%9C%AC%E5%A4%96%E7%9B%B8%E4%B8%8E%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88-%E5%BC%BA%E7%83%88%E8%A6%81%E6%B1%82%E4%B8%8D%E8%A6%81%E6%94%BB%E5%87%BB%E6%B0%91%E7%94%A8%E8%88%B9%E5%8F%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939027000.webp","sourceId":"rfi"}]