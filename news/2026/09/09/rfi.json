[{"id":1788954917000,"createdDate":"2026-09-09 11:55","name":"法国国际广播电台","title":"PISA排名：中国和新加坡名列前茅 OECD国家如法国成绩垫底 因耽溺于屏幕和社媒","content":"在法国、欧洲乃至全世界，学生成绩都像自由落体式般地下滑……这是PISA（ProgrammeforInternationalStudentAssessment）国际学生评估项目排名得出的结论。该项目由经合组织（OECD）每三年进行一次评估。这项全球性研究的结果于昨日9月8日发布，今天9日法国各大报纸头版无不聚焦在这份报告的解读与分析。结果指出，四个中国省份和都市区（北京、上海、江苏和浙江）在科学和数学项目领先。阅读理解能力方面，新加坡居首，而15岁的法国学生却获得了这项调查以来的最差成绩。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260909-pisa%E6%8E%92%E5%90%8D-%E4%B8%AD%E5%9B%BD%E5%92%8C%E6%96%B0%E5%8A%A0%E5%9D%A1%E5%90%8D%E5%88%97%E5%89%8D%E8%8C%85-oecd%E5%9B%BD%E5%AE%B6%E5%A6%82%E6%B3%95%E5%9B%BD%E6%88%90%E7%BB%A9%E5%9E%AB%E5%BA%95-%E5%9B%A0%E8%80%BD%E6%BA%BA%E4%BA%8E%E5%B1%8F%E5%B9%95%E5%92%8C%E7%A4%BE%E5%AA%92","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788954917000.webp","sourceId":"rfi"},{"id":1788954622000,"createdDate":"2026-09-09 11:50","name":"法国国际广播电台","title":"印度严重欺诈调查局建议对小米在印业务展开“深入”调查","content":"一份政府文件显示，印度公司事务部下属的严重欺诈调查局（SFIO）建议对小米展开调查，理由是该公司在商业模式及遵守外商投资法规方面涉嫌违规；此举可能导致这家智能手机制造商在印度面临更严格的监管审查。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260909-%E5%8D%B0%E5%BA%A6%E4%B8%A5%E9%87%8D%E6%AC%BA%E8%AF%88%E8%B0%83%E6%9F%A5%E5%B1%80%E5%BB%BA%E8%AE%AE%E5%AF%B9%E5%B0%8F%E7%B1%B3%E5%9C%A8%E5%8D%B0%E4%B8%9A%E5%8A%A1%E5%B1%95%E5%BC%80-%E6%B7%B1%E5%85%A5-%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788954622000.webp","sourceId":"rfi"},{"id":1788952581000,"createdDate":"2026-09-09 11:16","name":"法国国际广播电台","title":"回声报论坛：别再幻想中国向欧洲转移技术了！","content":"布鲁塞尔希望像北京长期以来所做的那样，对其境内的战略性外国投资进行更多控制。然而，罗宾·里瓦通（RobinRivaton）这位RealEstech创办人兼时评作家9月8日晚投书《回声报》论坛版提醒道，中国确实拥有欧洲所不具备的独特性，但请别再幻想中国会向欧洲转移技术了。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E5%9B%9E%E5%A3%B0%E6%8A%A5%E8%AE%BA%E5%9D%9B-%E5%88%AB%E5%86%8D%E5%B9%BB%E6%83%B3%E4%B8%AD%E5%9B%BD%E5%90%91%E6%AC%A7%E6%B4%B2%E8%BD%AC%E7%A7%BB%E6%8A%80%E6%9C%AF%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788952581000.webp","sourceId":"rfi"},{"id":1788951522000,"createdDate":"2026-09-09 10:58","name":"法国国际广播电台","title":"外交筹码不再是造桥铺路 台湾芯片外交助邦交危地马拉开发首颗本土芯片","content":"危地马拉山谷大学师生团队开发出首颗本土设计奈米芯片「大美洲虎」，预计采用65奈米制程及台积电技术进行生产。这或许要归功于危地马拉手中的那张「台湾牌」，台湾与危地马拉自2025年开始打造「芯片之路」计画协助产业转型升级。而过去为了利益选择与台湾分道扬镳的拉美国家，如今却也重新把目光投向台湾半导体实力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260909-%E5%A4%96%E4%BA%A4%E7%AD%B9%E7%A0%81%E4%B8%8D%E5%86%8D%E6%98%AF%E9%80%A0%E6%A1%A5%E9%93%BA%E8%B7%AF-%E5%8F%B0%E6%B9%BE%E8%8A%AF%E7%89%87%E5%A4%96%E4%BA%A4%E5%8A%A9%E9%82%A6%E4%BA%A4%E5%8D%B1%E5%9C%B0%E9%A9%AC%E6%8B%89%E5%BC%80%E5%8F%91%E9%A6%96%E9%A2%97%E6%9C%AC%E5%9C%9F%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788951522000.webp","sourceId":"rfi"},{"id":1788949544000,"createdDate":"2026-09-09 10:25","name":"法国国际广播电台","title":"宇树科技股价大跌 中国证监会据报正收紧对人形机器人初创企业的IPO审批","content":"据科技媒体《TheInformation》周三报导称，在人形机器人行业领军企业宇树科技（UnitreeRobotics）上市首日表现剧烈波动之后，中国监管机构正收紧对计划首次公开募股（IPO）的人形机器人初创企业的审批。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E5%AE%87%E6%A0%91%E7%A7%91%E6%8A%80%E8%82%A1%E4%BB%B7%E5%A4%A7%E8%B7%8C-%E4%B8%AD%E5%9B%BD%E8%AF%81%E7%9B%91%E4%BC%9A%E6%8D%AE%E6%8A%A5%E6%AD%A3%E6%94%B6%E7%B4%A7%E5%AF%B9%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%88%9D%E5%88%9B%E4%BC%81%E4%B8%9A%E7%9A%84ipo%E5%AE%A1%E6%89%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788949544000.webp","sourceId":"rfi"},{"id":1788948400000,"createdDate":"2026-09-09 10:06","name":"法国国际广播电台","title":"乌外交部：中方曾请求在丁薛祥访俄期间勿对符拉迪沃斯托克发动袭击","content":"乌克兰外交部发言人季希（HeorhiiTykhyi）证实，中方曾正式请求乌克兰在中国国务院副总理丁薛祥访问俄罗斯期间避免袭击符拉迪沃斯托克（海参崴）。据乌通社报导，季希是在周二举行的新闻发布会上说了这番话。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260909-%E4%B9%8C%E5%A4%96%E4%BA%A4%E9%83%A8-%E4%B8%AD%E6%96%B9%E6%9B%BE%E8%AF%B7%E6%B1%82%E5%9C%A8%E4%B8%81%E8%96%9B%E7%A5%A5%E8%AE%BF%E4%BF%84%E6%9C%9F%E9%97%B4%E5%8B%BF%E5%AF%B9%E7%AC%A6%E6%8B%89%E8%BF%AA%E6%B2%83%E6%96%AF%E6%89%98%E5%85%8B%E5%8F%91%E5%8A%A8%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788948400000.webp","sourceId":"rfi"},{"id":1788947137000,"createdDate":"2026-09-09 09:45","name":"法国国际广播电台","title":"贝森特：若中方在AI上将我们甩在身后，那一切都将变得无关紧要","content":"美国财政部长贝森特（ScottBessent）警告，如果美国在与中国的人工智能（AI）竞赛中落败，将面临严重后果；这番言论凸显了华盛顿对于中方在该领域技术进步的忧虑。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260909-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E8%8B%A5%E4%B8%AD%E6%96%B9%E5%9C%A8ai%E4%B8%8A%E5%B0%86%E6%88%91%E4%BB%AC%E7%94%A9%E5%9C%A8%E8%BA%AB%E5%90%8E%EF%BC%8C%E9%82%A3%E4%B8%80%E5%88%87%E9%83%BD%E5%B0%86%E5%8F%98%E5%BE%97%E6%97%A0%E5%85%B3%E7%B4%A7%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788947137000.webp","sourceId":"rfi"},{"id":1788945567000,"createdDate":"2026-09-09 09:19","name":"法国国际广播电台","title":"美政府指责DeepSeek、阿里等6家中国AI公司“恶意”蒸馏美企前沿模型","content":"美国政府周二指责中国人工智能（AI）公司“以工业规模恶意”蒸馏美国人工智能企业的前沿模型。这一指控可能会使美中领导人定于本月晚些时候举行的会晤面临更复杂的局面。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260909-%E7%BE%8E%E6%94%BF%E5%BA%9C%E6%8C%87%E8%B4%A3deepseek-%E9%98%BF%E9%87%8C%E7%AD%896%E5%AE%B6%E4%B8%AD%E5%9B%BDai%E5%85%AC%E5%8F%B8-%E6%81%B6%E6%84%8F-%E8%92%B8%E9%A6%8F%E7%BE%8E%E5%89%8D%E6%B2%BF%E6%A8%A1%E5%9E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788945567000.webp","sourceId":"rfi"},{"id":1788943906000,"createdDate":"2026-09-09 08:51","name":"法国国际广播电台","title":"AIT处长谷立言：台海若爆发冲突 全球经济损失恐超越二战","content":"台北周三举行“2026台北安全对话”。据台湾媒体报道，美国在台协会（AIT）处长谷立言表示，台海若爆发冲突，对全球经济造成的损失将超越第二次世界大战，因此维护台海与印太地区和平，是美国的重要战略目标。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-ait%E5%A4%84%E9%95%BF%E8%B0%B7%E7%AB%8B%E8%A8%80-%E5%8F%B0%E6%B5%B7%E8%8B%A5%E7%88%86%E5%8F%91%E5%86%B2%E7%AA%81-%E5%85%A8%E7%90%83%E7%BB%8F%E6%B5%8E%E6%8D%9F%E5%A4%B1%E6%81%90%E8%B6%85%E8%B6%8A%E4%BA%8C%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788943906000.webp","sourceId":"rfi"},{"id":1788943430000,"createdDate":"2026-09-09 08:43","name":"法国国际广播电台","title":"针对中国占据主导地位的行业 欧洲议会拟收紧投资条件 确立“欧洲优先”原则","content":"欧洲议会负责拟议《工业加速法案》（IndustrialAcceleratorAct）的报告员们正计划针对中国占据主导地位的行业，限制中国投资进入欧盟市场，这一立场比欧盟委员会此前的建议更为严厉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8D%A0%E6%8D%AE%E4%B8%BB%E5%AF%BC%E5%9C%B0%E4%BD%8D%E7%9A%84%E8%A1%8C%E4%B8%9A-%E6%AC%A7%E6%B4%B2%E8%AE%AE%E4%BC%9A%E6%8B%9F%E6%94%B6%E7%B4%A7%E6%AC%A7%E7%9B%9F%E6%8A%95%E8%B5%84%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788943430000.webp","sourceId":"rfi"},{"id":1788939934000,"createdDate":"2026-09-09 07:45","name":"法国国际广播电台","title":"评论：董建华尊重香港制度和价值 港人续享自由 与中国当年仍需香港大势相关","content":"香港首任特首董建华逝世，引发市民怀念他在任时的香港仍能享有与港英年代相若的自由，但原因则颇为两极，既有指是因为董建华的个人仍尊重香港制度和价值，亦有指是因为中国仍需要不变的香港来吸引资本有关，更有评论认为是两者再加上时任领导人的性格有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-%E8%AF%84%E8%AE%BA-%E8%91%A3%E5%BB%BA%E5%8D%8E%E5%B0%8A%E9%87%8D%E9%A6%99%E6%B8%AF%E5%88%B6%E5%BA%A6%E5%92%8C%E4%BB%B7%E5%80%BC-%E6%B8%AF%E4%BA%BA%E7%BB%AD%E4%BA%AB%E8%87%AA%E7%94%B1-%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%BD%93%E5%B9%B4%E4%BB%8D%E9%9C%80%E9%A6%99%E6%B8%AF%E5%A4%A7%E5%8A%BF%E7%9B%B8%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939934000.webp","sourceId":"rfi"},{"id":1788939582000,"createdDate":"2026-09-09 07:39","name":"法国国际广播电台","title":"香港首任特首董建华逝世 京称「一国两制」贡献者 23条立法失败後提早下台","content":"因健康问题已超过五年没有公开露面的香港特区首任行政长官(简称特首)兼中国政协副主席董建华，昨晚（8日）逝世，享年89岁。中国官方新华社称他是「一国两制」杰出贡献者，然而，由於他任内推动的《基本法》23条立法引发50万港人上街抗议而最终搁置，他未能完成两任任期而提早「脚痛下台」，开启香港特区成立29年来没有一位特首可以当满两任十年任期的先例。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260909-%E9%A6%99%E6%B8%AF%E9%A6%96%E4%BB%BB%E7%89%B9%E9%A6%96%E8%91%A3%E5%BB%BA%E5%8D%8E%E9%80%9D%E4%B8%96-%E4%BA%AC%E7%A7%B0-%E4%B8%80%E5%9B%BD%E4%B8%A4%E5%88%B6-%E8%B4%A1%E7%8C%AE%E8%80%85-23%E6%9D%A1%E7%AB%8B%E6%B3%95%E5%A4%B1%E8%B4%A5%E5%BE%8C%E6%8F%90%E6%97%A9%E4%B8%8B%E5%8F%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939582000.webp","sourceId":"rfi"},{"id":1788939027000,"createdDate":"2026-09-09 07:30","name":"法国国际广播电台","title":"日本外相与伊朗外长举行电话会谈 强烈要求不要攻击民用船只","content":"日本时间9月8日下午5时30分起，茂木敏充外务大臣与伊朗外长阿拉格齐举行了电话会谈，通话持续25分钟。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260909-%E6%97%A5%E6%9C%AC%E5%A4%96%E7%9B%B8%E4%B8%8E%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88-%E5%BC%BA%E7%83%88%E8%A6%81%E6%B1%82%E4%B8%8D%E8%A6%81%E6%94%BB%E5%87%BB%E6%B0%91%E7%94%A8%E8%88%B9%E5%8F%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788939027000.webp","sourceId":"rfi"},{"id":1788980678000,"createdDate":"2026-09-09 19:04","name":"法国国际广播电台","title":"挪威首相称：飞往奥斯陆途中，泽连斯基所乘飞机险遭无人机袭击","content":"挪威首相乔纳斯·加尔·斯特勒周三（9月9日）晚间表示，乌克兰总统泽连斯基乘坐的飞机从摩尔多瓦飞往奥斯陆途中，险些遭无人机撞击。泽连斯基当天在奥斯陆出席了挪威国王哈拉尔的葬礼。不过，乌克兰方面随后对这一说法作出了澄清。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260909-%E6%8C%AA%E5%A8%81%E9%A6%96%E7%9B%B8%E7%A7%B0-%E9%A3%9E%E5%BE%80%E5%A5%A5%E6%96%AF%E9%99%86%E9%80%94%E4%B8%AD%EF%BC%8C%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%89%80%E4%B9%98%E9%A3%9E%E6%9C%BA%E9%99%A9%E9%81%AD%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788980678000.webp","sourceId":"rfi"},{"id":1788980060000,"createdDate":"2026-09-09 18:54","name":"法国国际广播电台","title":"苹果新CEO发布首款折叠屏手机iPhone Duo，折叠后大小相当于护照","content":"在三星推出折叠屏手机七年后，苹果公司周三（9月9日）终于发布了自己的首款折叠屏手机——iPhoneDuo。这款手机折叠后大小相当于一本护照。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260909-%E8%8B%B9%E6%9E%9C%E6%96%B0ceo%E5%8F%91%E5%B8%83%E9%A6%96%E6%AC%BE%E6%8A%98%E5%8F%A0%E5%B1%8F%E6%89%8B%E6%9C%BAiphone-duo%EF%BC%8C%E6%8A%98%E5%8F%A0%E5%90%8E%E5%A4%A7%E5%B0%8F%E7%9B%B8%E5%BD%93%E4%BA%8E%E6%8A%A4%E7%85%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788980060000.webp","sourceId":"rfi"},{"id":1788978948000,"createdDate":"2026-09-09 18:35","name":"法国国际广播电台","title":"欧盟拟允许地方政府在公共采购招标中直接排除中国供应商","content":"欧盟委员会周三（9月9日）提议，允许各地方政府在公共采购招标中直接排除中国企业，同时希望鼓励公共部门更多采用欧洲企业或本地供应商。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260909-%E6%AC%A7%E7%9B%9F%E6%8B%9F%E5%85%81%E8%AE%B8%E5%9C%B0%E6%96%B9%E6%94%BF%E5%BA%9C%E5%9C%A8%E5%85%AC%E5%85%B1%E9%87%87%E8%B4%AD%E6%8B%9B%E6%A0%87%E4%B8%AD%E7%9B%B4%E6%8E%A5%E6%8E%92%E9%99%A4%E4%B8%AD%E5%9B%BD%E4%BE%9B%E5%BA%94%E5%95%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788978948000.webp","sourceId":"rfi"},{"id":1788978945000,"createdDate":"2026-09-09 18:35","name":"法国国际广播电台","title":"美国警告禁用劣质中国制安全气囊零件　已致11死3重伤","content":"美国国家公路交通安全管理局（NHTSA）本月初警告，一款遭美国政府禁止进口及销售的劣质安全气囊充气器，已在全美造成14起车祸，包括11人死亡及3人重伤。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260909-%E7%BE%8E%E5%9B%BD%E8%AD%A6%E5%91%8A%E7%A6%81%E7%94%A8%E5%8A%A3%E8%B4%A8%E4%B8%AD%E5%9B%BD%E5%88%B6%E5%AE%89%E5%85%A8%E6%B0%94%E5%9B%8A%E9%9B%B6%E4%BB%B6-%E5%B7%B2%E8%87%B411%E6%AD%BB3%E9%87%8D%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788978945000.webp","sourceId":"rfi"},{"id":1788977173000,"createdDate":"2026-09-09 18:06","name":"法国国际广播电台","title":"美国称协助马达加斯加捣毁13处诈骗中心，均由中国籍人员运营","content":"美国司法部门周三（9月9日）表示，美国当局在捣毁马达加斯加境内由中国籍人员运营的网络诈骗中心的行动中发挥了决定性作用。此前，美国司法部于2025年11月成立了一个专门部门，负责打击与加密货币有关的网络诈骗网络。这些网络主要从东南亚运营，据称受中国犯罪集团控制。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260909-%E7%BE%8E%E5%9B%BD%E7%A7%B0%E5%8D%8F%E5%8A%A9%E9%A9%AC%E8%BE%BE%E5%8A%A0%E6%96%AF%E5%8A%A0%E6%8D%A3%E6%AF%8113%E5%A4%84%E8%AF%88%E9%AA%97%E4%B8%AD%E5%BF%83%EF%BC%8C%E5%9D%87%E7%94%B1%E4%B8%AD%E5%9B%BD%E7%B1%8D%E4%BA%BA%E5%91%98%E8%BF%90%E8%90%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788977173000.webp","sourceId":"rfi"},{"id":1788976156000,"createdDate":"2026-09-09 17:49","name":"法国国际广播电台","title":"欧盟拟收紧Airbnb等短租监管，欧洲房价15年涨60%","content":"欧盟周三（9月9日）公布了一项计划，旨在支持希望限制Airbnb等短租房的城市。近年来，从纽约到东京，再到巴塞罗那和巴黎，短租带动房地产市场价格大幅上涨，生活在这些地区的居民如今越来越难以找到住房。因此，欧盟这项计划的目标是希望能够为地方政府提供法律依据，对旅游热点地区的短期租赁进行监管。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260909-%E6%AC%A7%E7%9B%9F%E6%8B%9F%E6%94%B6%E7%B4%A7airbnb%E7%AD%89%E7%9F%AD%E7%A7%9F%E7%9B%91%E7%AE%A1%EF%BC%8C%E6%AC%A7%E6%B4%B2%E6%88%BF%E4%BB%B715%E5%B9%B4%E6%B6%A860","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788976156000.webp","sourceId":"rfi"},{"id":1788972155000,"createdDate":"2026-09-09 16:42","name":"法国国际广播电台","title":"伊朗镐山“施工激增” 五角大楼测试能够针对伊朗埋藏最深地下设施方法","content":"一组分析师在审视了长达六年的卫星图像后指出，随着伊朗与美国之间的冲突局势的发展，一处位于花岗岩层之下的疑似伊朗核设施今年出现了密集的施工活动。这处被称为镐山（PickaxeMountain）的设施位于德黑兰以南约225公里处的纳坦兹核设施附近，长期以来一直是情报机构关注的焦点；这些机构认为，该地点很可能是伊朗政权为保护其未来核计划相关活动而选定的场所。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260909-%E4%BC%8A%E6%9C%97%E9%95%90%E5%B1%B1-%E6%96%BD%E5%B7%A5%E6%BF%80%E5%A2%9E-%E4%BA%94%E8%A7%92%E5%A4%A7%E6%A5%BC%E6%B5%8B%E8%AF%95%E8%83%BD%E5%A4%9F%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%9F%8B%E8%97%8F%E6%9C%80%E6%B7%B1%E5%9C%B0%E4%B8%8B%E8%AE%BE%E6%96%BD%E6%96%B9%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788972155000.webp","sourceId":"rfi"},{"id":1788969131000,"createdDate":"2026-09-09 15:52","name":"法国国际广播电台","title":"外交压力渐增，以色列历史性在斯洛文尼亚开首个常驻大使馆","content":"9月9日星期三，以色列在斯洛文尼亚历史性开设其首个大使馆。这是斯洛文尼亚境内第一个以色列常驻大使馆。今年早些时候，这个位于东欧的阿尔卑斯山区国家的民族主义政治人物雅内兹·扬沙组建了中右翼政府，其与以色列的关系由此出现重大转折。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260909-%E5%A4%96%E4%BA%A4%E5%8E%8B%E5%8A%9B%E6%B8%90%E5%A2%9E%EF%BC%8C%E4%BB%A5%E8%89%B2%E5%88%97%E5%8E%86%E5%8F%B2%E6%80%A7%E5%9C%A8%E6%96%AF%E6%B4%9B%E6%96%87%E5%B0%BC%E4%BA%9A%E5%BC%80%E9%A6%96%E4%B8%AA%E5%B8%B8%E9%A9%BB%E5%A4%A7%E4%BD%BF%E9%A6%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788969131000.webp","sourceId":"rfi"},{"id":1788968638000,"createdDate":"2026-09-09 15:43","name":"法国国际广播电台","title":"澳驻日大使：中俄朝在导弹上遥遥领先，日本正采取合理恰当步骤，建立威慑能力","content":"澳大利亚新任驻日本大使希勒（AndrewShearer）周三在日本记者俱乐部会见媒体时，结合其此前担任澳大利亚国家情报办公室总监的经历，对中方的军备扩张及他口中的经济胁迫行为作出了直言不讳的评估。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260909-%E6%BE%B3%E9%A9%BB%E6%97%A5%E5%A4%A7%E4%BD%BF-%E4%B8%AD%E4%BF%84%E6%9C%9D%E5%9C%A8%E5%AF%BC%E5%BC%B9%E4%B8%8A%E9%81%A5%E9%81%A5%E9%A2%86%E5%85%88%EF%BC%8C%E6%97%A5%E6%9C%AC%E6%AD%A3%E9%87%87%E5%8F%96%E5%90%88%E7%90%86%E6%81%B0%E5%BD%93%E6%AD%A5%E9%AA%A4%EF%BC%8C%E5%BB%BA%E7%AB%8B%E5%A8%81%E6%85%91%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788968638000.webp","sourceId":"rfi"},{"id":1788967538000,"createdDate":"2026-09-09 15:25","name":"法国国际广播电台","title":"俄中完善自杀式卫星好与美欧“缠斗”：太空中的“战争”已然打响","content":"在巴黎国际航天峰会本周三（9月9日）召开前夕，《回声报》国防与太空记者安娜·德里夫发表长篇报道指，当莫斯科据信正在研发轨道核武器之际，西方阵营的声音却出现分裂：与法国的立场相左，美国已将太空定义为“作战领域”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260909-%E4%BF%84%E4%B8%AD%E5%AE%8C%E5%96%84%E8%87%AA%E6%9D%80%E5%BC%8F%E5%8D%AB%E6%98%9F%E5%A5%BD%E4%B8%8E%E7%BE%8E%E6%AC%A7-%E7%BC%A0%E6%96%97-%E5%A4%AA%E7%A9%BA%E4%B8%AD%E7%9A%84%E6%88%98%E4%BA%89%E5%B7%B2%E7%84%B6%E6%89%93%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788967538000.webp","sourceId":"rfi"},{"id":1788964028000,"createdDate":"2026-09-09 14:27","name":"法国国际广播电台","title":"被美交通部长要求切断与中国伙伴企业联系 福特汽车硬刚指“博取头条新闻的错误尝试”","content":"美国特朗普政府周二猛烈抨击了福特汽车（FordMotor）与中国企业的业务合作，称这些合作引发了国家安全方面的关切。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260909-%E8%A2%AB%E7%BE%8E%E4%BA%A4%E9%80%9A%E9%83%A8%E9%95%BF%E8%A6%81%E6%B1%82%E5%88%87%E6%96%AD%E4%B8%8E%E4%B8%AD%E5%9B%BD%E4%BC%99%E4%BC%B4%E4%BC%81%E4%B8%9A%E8%81%94%E7%B3%BB-%E7%A6%8F%E7%89%B9%E6%B1%BD%E8%BD%A6%E7%A1%AC%E5%88%9A%E6%8C%87-%E5%8D%9A%E5%8F%96%E5%A4%B4%E6%9D%A1%E6%96%B0%E9%97%BB%E7%9A%84%E9%94%99%E8%AF%AF%E5%B0%9D%E8%AF%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788964028000.webp","sourceId":"rfi"},{"id":1788961805000,"createdDate":"2026-09-09 13:50","name":"法国国际广播电台","title":"意大利汽车工业协会主席促对超过特定门槛的中国产汽车及零部件征收80%关税","content":"意大利汽车工业协会（ANFIA）主席瓦瓦索里（RobertoVavassori）敦促欧盟对超过特定门槛的中国产汽车及零部件征收80%的关税，以保护欧洲汽车产业。意大利汽车工业协会自称拥有超过520家会员企业，是该国最大的行业协会之一。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260909-%E6%84%8F%E5%A4%A7%E5%88%A9%E6%B1%BD%E8%BD%A6%E5%B7%A5%E4%B8%9A%E5%8D%8F%E4%BC%9A%E4%B8%BB%E5%B8%AD%E4%BF%83%E5%AF%B9%E8%B6%85%E8%BF%87%E7%89%B9%E5%AE%9A%E9%97%A8%E6%A7%9B%E7%9A%84%E4%B8%AD%E5%9B%BD%E4%BA%A7%E6%B1%BD%E8%BD%A6%E5%8F%8A%E9%9B%B6%E9%83%A8%E4%BB%B6%E5%BE%81%E6%94%B680-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788961805000.webp","sourceId":"rfi"},{"id":1788959808000,"createdDate":"2026-09-09 13:16","name":"法国国际广播电台","title":"毛泽东逝世50年 “阴魂”何以不散？","content":"今天是中国前领导人毛泽东逝世50年纪念日，作为中华人民共和国的缔造者之一，毛泽东从1949年到1976年9月9日以铁腕统治着中国。这位曾将全球约四分之一的人口置于共产党的统治之下的独裁者影响至今仍笼罩着中国的未来。分析认为，在他逝世50年后，以现任国家领导人习近平为代表的中国政权正在恢复毛泽东权力的某些方面，并复兴这位“伟大舵手”的政治遗产。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260909-%E6%AF%9B%E6%B3%BD%E4%B8%9C%E9%80%9D%E4%B8%9650%E5%B9%B4-%E9%98%B4%E9%AD%82-%E4%BD%95%E4%BB%A5%E4%B8%8D%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/09/1788959808000.webp","sourceId":"rfi"}]