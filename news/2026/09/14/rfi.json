[{"id":1789397169000,"createdDate":"2026-09-14 14:46","name":"法国国际广播电台","title":"担心新一波征兵及自由受限 俄罗斯今夏再现人员外流潮","content":"美联社报道，今年夏季以来，俄罗斯国内再次出现一波移民焦虑。乌克兰无人机袭击俄罗斯境内引发燃料短缺、俄罗斯国内可能再次军事动员的传言以及日益严格的互联网限制，让一些俄罗斯人开始重新考虑离开自己的国家。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260914-%E6%8B%85%E5%BF%83%E6%96%B0%E4%B8%80%E6%B3%A2%E5%BE%81%E5%85%B5%E5%8F%8A%E8%87%AA%E7%94%B1%E5%8F%97%E9%99%90-%E4%BF%84%E7%BD%97%E6%96%AF%E4%BB%8A%E5%A4%8F%E5%86%8D%E7%8E%B0%E4%BA%BA%E5%91%98%E5%A4%96%E6%B5%81%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789397169000.webp","sourceId":"rfi"},{"id":1789395487000,"createdDate":"2026-09-14 14:18","name":"法国国际广播电台","title":"中东战火持续 美国休斯顿召开G20能源会议","content":"随着迈阿密G20峰会的临近，美国于周一与世界主要经济体的代表团举行一系列能源会议，华盛顿的优先事项之一是“扩大获得价格合理、可靠和安全的能源”，来应对中东战争推高了全球石油价格。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260914-%E4%B8%AD%E4%B8%9C%E6%88%98%E7%81%AB%E6%8C%81%E7%BB%AD-%E7%BE%8E%E5%9B%BD%E4%BC%91%E6%96%AF%E9%A1%BF%E5%8F%AC%E5%BC%80g20%E8%83%BD%E6%BA%90%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789395487000.webp","sourceId":"rfi"},{"id":1789394197000,"createdDate":"2026-09-14 13:56","name":"法国国际广播电台","title":"俄无人机袭击险波及欧洲外交官列车，芬兰宣布加入法国核威慑倡议","content":"围绕乌克兰和波兰边境一列火车被俄罗斯无人机袭击一事，欧洲多名政要在9月14日星期一作出回应，芬兰更是宣布加入法国的“先进核威慑”合作框架。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260914-%E4%BF%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E9%99%A9%E6%B3%A2%E5%8F%8A%E6%AC%A7%E6%B4%B2%E5%A4%96%E4%BA%A4%E5%AE%98%E5%88%97%E8%BD%A6%EF%BC%8C%E8%8A%AC%E5%85%B0%E5%AE%A3%E5%B8%83%E5%8A%A0%E5%85%A5%E6%B3%95%E5%9B%BD%E6%A0%B8%E5%A8%81%E6%85%91%E5%80%A1%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789394197000.webp","sourceId":"rfi"},{"id":1789394009000,"createdDate":"2026-09-14 13:53","name":"法国国际广播电台","title":"回声报：遭中国“窃取”科技机密，韩国强化其“反工业间谍”武器库","content":"据《回声报》驻东京通讯员扬·卢梭的报道，韩国政府周日（9月13日）启动一项新法，严惩窃取其科技巨头机密的个人与机构，并直指部分中国企业在半导体技术领域的惊人跃升。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260914-%E5%9B%9E%E5%A3%B0%E6%8A%A5-%E9%81%AD%E4%B8%AD%E5%9B%BD-%E7%AA%83%E5%8F%96-%E7%A7%91%E6%8A%80%E6%9C%BA%E5%AF%86%EF%BC%8C%E9%9F%A9%E5%9B%BD%E5%BC%BA%E5%8C%96%E5%85%B6-%E5%8F%8D%E5%B7%A5%E4%B8%9A%E9%97%B4%E8%B0%8D-%E6%AD%A6%E5%99%A8%E5%BA%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789394009000.webp","sourceId":"rfi"},{"id":1789390670000,"createdDate":"2026-09-14 12:57","name":"法国国际广播电台","title":"特朗普：将和习近平讨论几乎所有议题","content":"预计中国国家主席习近平将于本月晚些时候前往美国与美国总统特朗普会晤。特朗普周日（9月13日）在结束爱尔兰访问、搭乘“空军一号”返程途中回答了记者相关话题。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260914-%E7%89%B9%E6%9C%97%E6%99%AE-%E5%B0%86%E5%92%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%A8%E8%AE%BA%E5%87%A0%E4%B9%8E%E6%89%80%E6%9C%89%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789390670000.webp","sourceId":"rfi"},{"id":1789389535000,"createdDate":"2026-09-14 12:38","name":"法国国际广播电台","title":"波兰外长: 这场战争正合中国心意","content":"波兰外长西科尔斯基（RadosławSikorski）评估俄罗斯对中国的战略从属关系及波罗的海地区平衡时表示：这场战争对中国来说非常有利，俄罗斯的市场正被中国全面掌控。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260914-%E6%B3%A2%E5%85%B0%E5%A4%96%E9%95%BF-%E8%BF%99%E5%9C%BA%E6%88%98%E4%BA%89%E6%AD%A3%E5%90%88%E4%B8%AD%E5%9B%BD%E5%BF%83%E6%84%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789389535000.webp","sourceId":"rfi"},{"id":1789385394000,"createdDate":"2026-09-14 11:29","name":"法国国际广播电台","title":"地缘政治紧张局势加剧背景下召开的欧盟北极峰会","content":"欧盟领导人周一（9月14日）齐聚芬兰北部城市罗瓦涅米举行会议，商讨如何加强欧盟在北极地区的存在感；近几个月来，该地区的地缘政治紧张局势已升至新高。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260914-%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E7%B4%A7%E5%BC%A0%E5%B1%80%E5%8A%BF%E5%8A%A0%E5%89%A7%E8%83%8C%E6%99%AF%E4%B8%8B%E5%8F%AC%E5%BC%80%E7%9A%84%E6%AC%A7%E7%9B%9F%E5%8C%97%E6%9E%81%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789385394000.webp","sourceId":"rfi"},{"id":1789385326000,"createdDate":"2026-09-14 11:28","name":"法国国际广播电台","title":"人工智能：中国提议为金砖国家建立“开源”区；伊朗问题：金砖成员有分歧但也展团结","content":"围绕法国债务的担忧日益加剧。周一914日上午，法国10年期 国债收益率一度突破4.5%的象征性关口。上一次10年期国债收益率超过4.5%是在2008年7月，当时正值次贷危机高峰期。国债收益率升高意味著所有资产市场里的资金都变少了，法国国债的风险也因此升高。与此同时，有关预算的辩论正在推高投资者要求的利率，在当前严峻的经济和政治形势下，法国必须节省300亿欧元，以将公共赤字控制在GDP的5.1%以内，总理勒科尔努希望让退休人员也能分摊责任……成为今天（9月14日）法国主流日报头版的共同关注话题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260914-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD-%E4%B8%AD%E5%9B%BD%E6%8F%90%E8%AE%AE%E4%B8%BA%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%BB%BA%E7%AB%8B-%E5%BC%80%E6%BA%90-%E5%8C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789385326000.webp","sourceId":"rfi"},{"id":1789383995000,"createdDate":"2026-09-14 11:06","name":"法国国际广播电台","title":"被俄罗斯斥为“军国主义象征”的日本菊花纹章究竟代表什么？","content":"9月4日，俄罗斯哈巴罗夫斯克市举行了纪念对日战争胜利纪念铜像揭幕仪式。该雕像表现的是苏联士兵正在破坏一块刻有菊花纹章的标石。日本首相高市早苗9月5日在个人社交媒体X上用日语和俄语发文，就设置这一雕像表示，这是“涉及日本国民感情的问题”，并透露“日本政府已强烈要求俄方撤除该雕像”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260914-%E8%A2%AB%E4%BF%84%E7%BD%97%E6%96%AF%E6%96%A5%E4%B8%BA-%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89%E8%B1%A1%E5%BE%81-%E7%9A%84%E6%97%A5%E6%9C%AC%E8%8F%8A%E8%8A%B1%E7%BA%B9%E7%AB%A0%E7%A9%B6%E7%AB%9F%E4%BB%A3%E8%A1%A8%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789383995000.webp","sourceId":"rfi"},{"id":1789380059000,"createdDate":"2026-09-14 10:00","name":"法国国际广播电台","title":"应沙特要求，阿曼推迟原定今日举行的霍尔木兹海峡安全会议","content":"原计划于9月14日星期一在阿曼首都马斯喀特举行的区域国家间会议当天被宣布推迟。该会议原本将为伊朗、沙特等区域国家讨论霍尔木兹海峡相关事宜提供交换意见的平台，寻求对霍尔木兹海峡进行更安全的管理。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260914-%E5%BA%94%E6%B2%99%E7%89%B9%E8%A6%81%E6%B1%82%EF%BC%8C%E9%98%BF%E6%9B%BC%E6%8E%A8%E8%BF%9F%E5%8E%9F%E5%AE%9A%E4%BB%8A%E6%97%A5%E4%B8%BE%E8%A1%8C%E7%9A%84%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E5%AE%89%E5%85%A8%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789380059000.webp","sourceId":"rfi"},{"id":1789376957000,"createdDate":"2026-09-14 09:09","name":"法国国际广播电台","title":"特朗普淡化据称中国向伊朗提供情报酿三名美军死亡一事 中国否认指控","content":"美国总统唐纳德·特朗普周日淡化了有关中国实体在伊朗发动袭击致三名美军士兵死亡前后，向德黑兰提供了约旦某军事基地卫星图像的报道。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260914-%E7%89%B9%E6%9C%97%E6%99%AE%E6%B7%A1%E5%8C%96%E6%8D%AE%E7%A7%B0%E4%B8%AD%E5%9B%BD%E5%90%91%E4%BC%8A%E6%9C%97%E6%8F%90%E4%BE%9B%E6%83%85%E6%8A%A5%E9%85%BF%E4%B8%89%E5%90%8D%E7%BE%8E%E5%86%9B%E6%AD%BB%E4%BA%A1%E4%B8%80%E4%BA%8B-%E4%B8%AD%E5%9B%BD%E5%90%A6%E8%AE%A4%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789376957000.webp","sourceId":"rfi"},{"id":1789375048000,"createdDate":"2026-09-14 08:37","name":"法国国际广播电台","title":"RFI 推出《世界镜头》庆祝摄影技术诞生200周年  《坦克人》入选","content":"2026年，法国迎来人类历史上第一张已知永久性照片诞生200周年纪念。这张《勒格拉庄园窗外景色》（PointdevueduGras）照片由尼塞福尔·涅普斯（NicéphoreNiépce）在圣卢普－德瓦伦（Saint-Loup-de-Varennes）拍摄成照。作为摄影开创性发明的见证，标志着一场技术、文化与纪实革命的开端，深刻改变了人类认识和记录世界的方式。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260914-rfi-%E6%8E%A8%E5%87%BA-%E4%B8%96%E7%95%8C%E9%95%9C%E5%A4%B4-%E5%BA%86%E7%A5%9D%E6%91%84%E5%BD%B1%E6%8A%80%E6%9C%AF%E8%AF%9E%E7%94%9F200%E5%91%A8%E5%B9%B4-%E5%9D%A6%E5%85%8B%E4%BA%BA-%E5%85%A5%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789375048000.webp","sourceId":"rfi"},{"id":1789372846000,"createdDate":"2026-09-14 08:00","name":"法国国际广播电台","title":"副总统萧美琴结束意大利论坛返台 此行就是为了让台湾声音被听见","content":"台湾副总统萧美琴返台后受访表示，透过此次出访希望让台湾的声音在具有民主历史意义的地方被更多国际友人听见。赖清德也强调，和世界交朋友本来就是台湾人民不可剥夺的天赋权利。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260914-%E5%89%AF%E6%80%BB%E7%BB%9F%E8%90%A7%E7%BE%8E%E7%90%B4%E7%BB%93%E6%9D%9F%E6%84%8F%E5%A4%A7%E5%88%A9%E8%AE%BA%E5%9D%9B%E8%BF%94%E5%8F%B0-%E6%AD%A4%E8%A1%8C%E5%B0%B1%E6%98%AF%E4%B8%BA%E4%BA%86%E8%AE%A9%E5%8F%B0%E6%B9%BE%E5%A3%B0%E9%9F%B3%E8%A2%AB%E5%90%AC%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789372846000.webp","sourceId":"rfi"},{"id":1789371827000,"createdDate":"2026-09-14 07:43","name":"法国国际广播电台","title":"被称为“亲华派”的冲绳县知事落选","content":"在9月13日举行投票的冲绳县知事选举中，现任知事玉城丹尼落选。这是2014年以反对美军基地搬迁工程为旗号组建的政治势力“全冲绳”所推举的候选人首次在知事选举中落败。玉城知事在2018年的知事选举中以“3D”，即民主主义、多样性、外交为竞选主张当选，此后一直积极推动冲绳县独有的“地方外交”。玉城知事2019年访华时，在谈及中国提出的“一带一路”这一巨大经济圈构想时，曾提议：“希望利用冲绳作为日本的出入口。”2023月7月3日至7日，作为日本国际贸易促进协会代表团成员访华，玉城和该会会长河野洋平一起与中国国务院总理李强、商务部部长王文涛等高级官员举行会谈，而在此次选举中也因与中国关系良好在社交媒体上受到攻击。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260914-%E8%A2%AB%E7%A7%B0%E4%B8%BA-%E4%BA%B2%E5%8D%8E%E6%B4%BE-%E7%9A%84%E5%86%B2%E7%BB%B3%E5%8E%BF%E7%9F%A5%E4%BA%8B%E8%90%BD%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789371827000.webp","sourceId":"rfi"},{"id":1789369887000,"createdDate":"2026-09-14 07:11","name":"法国国际广播电台","title":"「天安门母亲」感谢支联会系狱仍守信念 人权团体齐声谴责重判 美国促立法追责香港之声再起","content":"香港市民支援爱国民主运动联合会（支联会）及其领导人因煽动颠覆国家政权罪遭重判，由六四事件死难者家属成立的「天安门母亲」群体感谢李卓人丶何俊仁和邹幸彤等人即使身陷牢狱，依然没有放弃谴责六四事件的信念。英美政界和国际特赦组织等人权组织则谴责港府的重判，美国国会一个委员会更促请国会通过《香港司法制裁法案》，追究将法院变成打压工具的人士的责任。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260914-%E5%A4%A9%E5%AE%89%E9%97%A8%E6%AF%8D%E4%BA%B2-%E6%84%9F%E8%B0%A2%E6%94%AF%E8%81%94%E4%BC%9A%E7%B3%BB%E7%8B%B1%E4%BB%8D%E5%AE%88%E4%BF%A1%E5%BF%B5-%E4%BA%BA%E6%9D%83%E5%9B%A2%E4%BD%93%E9%BD%90%E5%A3%B0%E8%B0%B4%E8%B4%A3%E9%87%8D%E5%88%A4-%E7%BE%8E%E5%9B%BD%E4%BF%83%E7%AB%8B%E6%B3%95%E8%BF%BD%E8%B4%A3%E9%A6%99%E6%B8%AF%E4%B9%8B%E5%A3%B0%E5%86%8D%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/14/1789369887000.webp","sourceId":"rfi"}]