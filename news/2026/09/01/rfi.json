[{"id":1788265408000,"createdDate":"2026-09-01 12:23","name":"法国国际广播电台","title":"上合比什凯克峰会释出的中俄关系讯息：北京正蚕食莫斯科在中亚的地位","content":"上合组织包括中国、俄罗斯、印度和伊朗在内的10个成员国，周一在比什凯克召开第25届峰会。外界普遍认为，这是中国进一步巩固其在中亚影响力的大好机会。据专家指出，自2022年俄乌战争爆发以来，中国改变战略，正蚕食俄罗斯在中亚的地位。换言之，双方的“竞争领域正在扩大”，传统的角色分配“正在被打破”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260901-%E4%B8%8A%E5%90%88%E6%AF%94%E4%BB%80%E5%87%AF%E5%85%8B%E5%B3%B0%E4%BC%9A%E9%87%8A%E5%87%BA%E7%9A%84%E4%B8%AD%E4%BF%84%E5%85%B3%E7%B3%BB%E8%AE%AF%E6%81%AF-%E4%B8%AD%E5%9B%BD%E6%AD%A3%E8%9A%95%E9%A3%9F%E4%BF%84%E7%BD%97%E6%96%AF%E5%9C%A8%E4%B8%AD%E4%BA%9A%E7%9A%84%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788265408000.webp","sourceId":"rfi"},{"id":1788262645000,"createdDate":"2026-09-01 11:37","name":"法国国际广播电台","title":"视频 面对中国企业扩张 德国制造业正努力应对","content":"几十年来，德国经济的核心支柱一直是制造并出口那些支撑全球商业运转的高价值、复杂工业品，从豪华汽车、火车头到工厂机械、飞机和推土机，应有尽有。然而这一增长由制造业带动经济增长的模式正面临来自一个新竞争对手中国的严峻挑战。中国的出口产品往往在质量上能与德国产品媲美，但价格却低得多，德国企业如何应对 ?请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E8%A7%86%E9%A2%91-%E9%9D%A2%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E6%89%A9%E5%BC%A0-%E5%BE%B7%E5%9B%BD%E5%88%B6%E9%80%A0%E4%B8%9A%E6%AD%A3%E5%8A%AA%E5%8A%9B%E5%BA%94%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788262645000.webp","sourceId":"rfi"},{"id":1788260745000,"createdDate":"2026-09-01 11:05","name":"法国国际广播电台","title":"中国警告台湾出席太平洋岛国论坛会有“后果” 澳总理回应","content":"太平洋岛国领导人于周一（8月31日）开始在帕劳举行一年一度的太平洋岛国论坛。中国周二表示反对台湾出席，称这个民主统治的岛屿没有资格出席峰会，同时威胁“会有后果“，但澳大利亚和新西兰表示，太平洋岛国集团自己决定嘉宾名单。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%8F%B0%E6%B9%BE%E5%87%BA%E5%B8%AD%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E4%BC%9A%E6%9C%89-%E5%90%8E%E6%9E%9C-%E6%BE%B3%E6%80%BB%E7%90%86%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788260745000.webp","sourceId":"rfi"},{"id":1788259809000,"createdDate":"2026-09-01 10:50","name":"法国国际广播电台","title":"美官员指控中远船只利用隐蔽设备为中方收集情报 中使馆否认","content":"据路透社报导，两名特朗普政府高级官员称，中国国有航运巨头中国远洋海运集团有限公司（COSCO、以下简称中远海运）在其船只上安装隐蔽设备，用于监听包括美国在内的目标国家沿海地区的军事通信。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260901-%E7%BE%8E%E5%AE%98%E5%91%98%E6%8C%87%E6%8E%A7%E4%B8%AD%E8%BF%9C%E8%88%B9%E5%8F%AA%E5%88%A9%E7%94%A8%E9%9A%90%E8%94%BD%E8%AE%BE%E5%A4%87%E4%B8%BA%E4%B8%AD%E6%96%B9%E6%94%B6%E9%9B%86%E6%83%85%E6%8A%A5-%E4%B8%AD%E4%BD%BF%E9%A6%86%E5%90%A6%E8%AE%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788259809000.webp","sourceId":"rfi"},{"id":1788259264000,"createdDate":"2026-09-01 10:41","name":"法国国际广播电台","title":"中俄首脑会谈 日本官房长官对中俄联合军事行动深表担忧","content":"针对中国国家主席习近平和俄罗斯总统普京31日在访问地吉尔吉斯坦首都比什凯克举行会谈一事，日本内阁官房长官木原稔在9月1日的记者会上，对中俄两国在日本周边开展联合军事活动表示担忧。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260901-%E4%B8%AD%E4%BF%84%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E5%AF%B9%E4%B8%AD%E4%BF%84%E8%81%94%E5%90%88%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8%E6%B7%B1%E8%A1%A8%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788259264000.webp","sourceId":"rfi"},{"id":1788258056000,"createdDate":"2026-09-01 10:20","name":"法国国际广播电台","title":"涉嫌在北约从事间谍活动的加拿大华裔女子被拒绝保释","content":"涉嫌在位于比利时蒙斯的北约欧洲盟军最高司令部从事间谍活动的加拿大籍女子预计将被继续拘留至审判，而审判可能要一年或更久之后才会进行。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E6%B6%89%E5%AB%8C%E5%9C%A8%E5%8C%97%E7%BA%A6%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%A5%B3%E5%AD%90%E8%A2%AB%E6%8B%92%E7%BB%9D%E4%BF%9D%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788258056000.webp","sourceId":"rfi"},{"id":1788256387000,"createdDate":"2026-09-01 09:53","name":"法国国际广播电台","title":"芬兰总统称王毅告诉他中方不会允许俄罗斯使用核武器 中国外交部回应","content":"就乌通社记者提问，芬兰总统斯图布近日在受访时表示，中国外交部长王毅今夏曾向他保证中方不会允许俄罗斯在俄乌战争中使用核武器，外交部对芬兰总统的表态有何评论？中国外交部发言人郭嘉昆周二在例行记者会上回答说：“关于王毅外长访问芬兰的相关情况，中方已经发布过消息”。郭嘉昆说，中方在乌克兰危机以及涉核问题上的立场是一贯的、明确的，将继续致力于劝和促谈，推动危机政治解决。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E8%8A%AC%E5%85%B0%E6%80%BB%E7%BB%9F%E7%A7%B0%E7%8E%8B%E6%AF%85%E5%91%8A%E8%AF%89%E4%BB%96%E4%B8%AD%E6%96%B9%E4%B8%8D%E4%BC%9A%E5%85%81%E8%AE%B8%E4%BF%84%E7%BD%97%E6%96%AF%E4%BD%BF%E7%94%A8%E6%A0%B8%E6%AD%A6%E5%99%A8-%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788256387000.webp","sourceId":"rfi"},{"id":1788255692000,"createdDate":"2026-09-01 09:41","name":"法国国际广播电台","title":"俄日再起争端：俄抗议美澳日军演，称日本部署美“台风”导弹“绝不可接受”","content":"9月1日星期二，俄罗斯就日本、澳大利亚、美国即将举行的远东联合军演提出抗议，对该军演靠近俄罗斯边境表示担忧。由于本次演习涵盖美国“台风”陆基系统，将首次涉及该中程导弹系统发射SM-6导弹和“战斧”巡航导弹的能力，俄方已向日方指出，在日本领土上部署此类武器，对俄罗斯的安全构成威胁，不可接受。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E4%BF%84%E6%97%A5%E5%86%8D%E8%B5%B7%E4%BA%89%E7%AB%AF-%E4%BF%84%E6%8A%97%E8%AE%AE%E7%BE%8E%E6%BE%B3%E6%97%A5%E5%86%9B%E6%BC%94%EF%BC%8C%E7%A7%B0%E6%97%A5%E6%9C%AC%E9%83%A8%E7%BD%B2%E7%BE%8E-%E5%8F%B0%E9%A3%8E-%E5%AF%BC%E5%BC%B9-%E7%BB%9D%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788255692000.webp","sourceId":"rfi"},{"id":1788255086000,"createdDate":"2026-09-01 09:31","name":"法国国际广播电台","title":"欧盟高官谈欧中贸易谈判：需要在10月份前取得切实成果，望中方限制对欧盟出口","content":"欧盟委员会贸易和经济安全委员谢夫乔维奇（MarošŠefčovič）周一表示，欧盟委员会正在探索各种途径，试图说服北京限制中方对欧盟的出口，以期减少欧盟对华巨额贸易逆差。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260901-%E6%AC%A7%E7%9B%9F%E9%AB%98%E5%AE%98%E8%B0%88%E6%AC%A7%E4%B8%AD%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4-%E9%9C%80%E8%A6%81%E5%9C%A810%E6%9C%88%E4%BB%BD%E5%89%8D%E5%8F%96%E5%BE%97%E5%88%87%E5%AE%9E%E6%88%90%E6%9E%9C%EF%BC%8C%E6%9C%9B%E4%B8%AD%E6%96%B9%E9%99%90%E5%88%B6%E5%AF%B9%E6%AC%A7%E7%9B%9F%E5%87%BA%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788255086000.webp","sourceId":"rfi"},{"id":1788252996000,"createdDate":"2026-09-01 08:56","name":"法国国际广播电台","title":"官员：美公司将接管此前由中俄公司运营的部分委内瑞拉油田 涉中石油、中石化","content":"两名美方官员周一向路透社透露称，美国石油公司——北美蓝色能源合作伙伴公司（NABEP）将接管此前由多家中国公司和一家俄罗斯公司控制的部分油田。他们表示，此次接管是美国总统特朗普与委内瑞拉宣布的一项全面石油生产协议的一部分。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E5%AE%98%E5%91%98-%E7%BE%8E%E5%85%AC%E5%8F%B8%E5%B0%86%E6%8E%A5%E7%AE%A1%E6%AD%A4%E5%89%8D%E7%94%B1%E4%B8%AD%E4%BF%84%E5%85%AC%E5%8F%B8%E8%BF%90%E8%90%A5%E7%9A%84%E9%83%A8%E5%88%86%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%B2%B9%E7%94%B0-%E6%B6%89%E4%B8%AD%E7%9F%B3%E6%B2%B9-%E4%B8%AD%E7%9F%B3%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788252996000.webp","sourceId":"rfi"},{"id":1788250589000,"createdDate":"2026-09-01 08:16","name":"法国国际广播电台","title":"赖清德：台湾的半导体实力建立在民主与法治之上，正在世界各地形成新的产业连结","content":"路透社台北消息，台湾总统赖清德于周二表示，台湾的半导体实力建立在民主与法治的基础之上，已成为一个值得信赖的国际合作伙伴，并始终践行对全球的供应承诺。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260901-%E8%B5%96%E6%B8%85%E5%BE%B7-%E5%8F%B0%E6%B9%BE%E7%9A%84%E5%8D%8A%E5%AF%BC%E4%BD%93%E5%AE%9E%E5%8A%9B%E5%BB%BA%E7%AB%8B%E5%9C%A8%E6%B0%91%E4%B8%BB%E4%B8%8E%E6%B3%95%E6%B2%BB%E4%B9%8B%E4%B8%8A%EF%BC%8C%E6%AD%A3%E5%9C%A8%E4%B8%96%E7%95%8C%E5%90%84%E5%9C%B0%E5%BD%A2%E6%88%90%E6%96%B0%E7%9A%84%E4%BA%A7%E4%B8%9A%E8%BF%9E%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788250589000.webp","sourceId":"rfi"},{"id":1788245753000,"createdDate":"2026-09-01 06:55","name":"法国国际广播电台","title":"加国港人救生艇计划结束 3.5万人待批 可能要等逾15年","content":"加拿大因应《港区国安法》实施而推出的「救生艇」移民计划，已於昨(8月31日)天如期终止，并未因应当地团体指香港人权受国安法进一步假蚀而延长。争取团体会长黄冠能向本台表示，该会当然希望尽力争取更多移民名额拨给港人救生艇，但至少要力保名额不变，否则，香港申请人可能要等超过15年才能取得加国永久居民身份。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260901-%E5%8A%A0%E5%9B%BD%E6%B8%AF%E4%BA%BA%E6%95%91%E7%94%9F%E8%89%87%E8%AE%A1%E5%88%92%E7%BB%93%E6%9D%9F-3-5%E4%B8%87%E4%BA%BA%E5%BE%85%E6%89%B9-%E5%8F%AF%E8%83%BD%E8%A6%81%E7%AD%89%E9%80%BE15%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788245753000.webp","sourceId":"rfi"},{"id":1788287319000,"createdDate":"2026-09-01 18:28","name":"法国国际广播电台","title":"【视频】法国前总理巴拉迪尔97岁高龄去世","content":"爱德华·巴拉迪尔于2026年8月31日去世，他曾在1993年3月至1995年5月期间担任弗朗索瓦·密特朗（FrançoisMitterrand）政府的最后一任总理。在法国政治史上，他作为雅克·希拉克（JacquesChirac）“三十年老友”而留名，但这份友谊在1995年那场激烈的总统竞选中，却让两人成了竞争对手，这场竞选最终也终结了他的政治抱负。和法广同属法国世界媒体集团的法国电视24台的同行回顾了巴拉迪尔的政治生涯。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260901-%E8%A7%86%E9%A2%91-%E6%B3%95%E5%9B%BD%E5%89%8D%E6%80%BB%E7%90%86%E5%B7%B4%E6%8B%89%E8%BF%AA%E5%B0%9497%E5%B2%81%E9%AB%98%E9%BE%84%E5%8E%BB%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788287319000.webp","sourceId":"rfi"},{"id":1788286331000,"createdDate":"2026-09-01 18:12","name":"法国国际广播电台","title":"中国国家主席习近平抵达埃及","content":"中国国家主席习近平周二晚抵达埃及，这是他十年来首次访问埃及。习近平和夫人彭丽媛抵达开罗国际机场时，塞西总统（AbdelFattahal-Sissi）夫妇到场热情迎接。埃及总统办公室发表声明称，在为期两天的访问中，两人预计将讨论“一系列共同关心的地区和国际问题”，包括地区战争、贸易和投资。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E4%B8%AD%E5%9B%BD%E5%9B%BD%E5%AE%B6%E4%B8%BB%E5%B8%AD%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8A%B5%E8%BE%BE%E5%9F%83%E5%8F%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788286331000.webp","sourceId":"rfi"},{"id":1788282500000,"createdDate":"2026-09-01 17:08","name":"法国国际广播电台","title":"德内政部长简短声明说了些什么？","content":"德国联邦内政部长亚历山大·多布林特（AlexanderDobrindt）9月1日在简短声明中表示，从“观察到的方法”符合“俄罗斯在欧洲惯用的混合行动模式”。他解释说：他解释说，“无人机的配置”以及“各种部件、炸药和引爆装置的使用”令人联想起“俄在对乌克兰战争中实施的其他混合行动”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260901-%E5%BE%B7%E5%86%85%E6%94%BF%E9%83%A8%E9%95%BF%E7%AE%80%E7%9F%AD%E5%A3%B0%E6%98%8E%E8%AF%B4%E4%BA%86%E4%BA%9B%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788282500000.webp","sourceId":"rfi"},{"id":1788282030000,"createdDate":"2026-09-01 17:00","name":"法国国际广播电台","title":"德国下令关闭俄罗斯驻波恩领事馆","content":"德国对俄罗斯采取外交报复措施。外交部长周二宣布，德国将关闭波恩的最后一个俄罗斯领事馆以及位于柏林的俄罗斯文化中心，这家文化中心被怀疑窝藏俄罗斯间谍，同时德国指责俄方涉嫌策划莱比锡哈雷机场无人机袭击。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260901-%E5%BE%B7%E5%9B%BD%E4%B8%8B%E4%BB%A4%E5%85%B3%E9%97%AD%E4%BF%84%E7%BD%97%E6%96%AF%E9%A9%BB%E6%B3%A2%E6%81%A9%E9%A2%86%E4%BA%8B%E9%A6%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788282030000.webp","sourceId":"rfi"},{"id":1788281419000,"createdDate":"2026-09-01 16:50","name":"法国国际广播电台","title":"马克·吕特：北约将捍卫其成员国免受“任何威胁”","content":"德国指责俄罗斯涉嫌策划莱比锡哈雷机场无人机袭击之后，北约秘书长马克·吕特9月1日表示，在8月份德国莱比锡机场遭受被指为俄方发动的混合袭击后，北约将捍卫其成员国免受“任何威胁”。默茨和吕特将于周三在布鲁塞尔举行会晤，讨论这一问题。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260901-%E9%A9%AC%E5%85%8B%C2%B7%E5%90%95%E7%89%B9-%E5%8C%97%E7%BA%A6%E5%B0%86%E6%8D%8D%E5%8D%AB%E5%85%B6%E6%88%90%E5%91%98%E5%9B%BD%E5%85%8D%E5%8F%97-%E4%BB%BB%E4%BD%95%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788281419000.webp","sourceId":"rfi"},{"id":1788277298000,"createdDate":"2026-09-01 15:41","name":"法国国际广播电台","title":"贝森特：在伊朗问题上与中方的共同点多于分歧，双方并就相关目标进行了私下探讨","content":"美国财政部长贝森特（Scott Bessent）周二在北卡罗来纳州阿什维尔举行的二十国集团财长和央行行长会议期间参加活动时表示，美方在伊朗问题上与中国的共同点多于分歧，美中并就相关问题进行了私下的探讨。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260901-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E5%9C%A8%E4%BC%8A%E6%9C%97%E9%97%AE%E9%A2%98%E4%B8%8A%E4%B8%8E%E4%B8%AD%E6%96%B9%E7%9A%84%E5%85%B1%E5%90%8C%E7%82%B9%E5%A4%9A%E4%BA%8E%E5%88%86%E6%AD%A7%EF%BC%8C%E5%8F%8C%E6%96%B9%E5%B9%B6%E5%B0%B1%E7%9B%B8%E5%85%B3%E7%9B%AE%E6%A0%87%E8%BF%9B%E8%A1%8C%E4%BA%86%E7%A7%81%E4%B8%8B%E6%8E%A2%E8%AE%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788277298000.webp","sourceId":"rfi"},{"id":1788275478000,"createdDate":"2026-09-01 15:11","name":"法国国际广播电台","title":"法国专家：为何有必要强调尼泊尔泥石流的核心诱因是山崩而非冰崩","content":"上周中尼边界突发的泥石流洪灾到今天周二已经造成900多人死亡，近5000人失踪，中国官方在上周日公布了对此次灾难的原因的分析，中国专家一致认为其主因是位于尼泊尔境内的冰川的崩溃，“冰川崩解下来带动了岩崩，所有的崩解下来形成冰川泥石流。”不过，上述说法与国际学者近日发表在科学网站上的文章颇有出入，这篇文章十分明确的指出：造成此一灾难的原因是一場山崩，而非冰川崩潰，是山崩引發了一連串事件的連鎖反應。那西方学者的说法的论据是什么？区分灾难的核心原因是冰崩还是山崩又有什么意义？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20260901-%E6%B3%95%E5%9B%BD%E4%B8%93%E5%AE%B6-%E4%B8%BA%E4%BD%95%E6%9C%89%E5%BF%85%E8%A6%81%E5%BC%BA%E8%B0%83%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%9A%84%E6%A0%B8%E5%BF%83%E8%AF%B1%E5%9B%A0%E6%98%AF%E5%B1%B1%E5%B4%A9%E8%80%8C%E9%9D%9E%E5%86%B0%E5%B4%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788275478000.webp","sourceId":"rfi"},{"id":1788274968000,"createdDate":"2026-09-01 15:02","name":"法国国际广播电台","title":"未及时披露NASA资助项目研究员是千人计划参与者 俄亥俄州立大学将付210万美元和解金","content":"美国司法部周一通报称，公立大学俄亥俄州立大学已同意支付总计210万美元，以解决有关其未披露该校员工与中华人民共和国（PRC）的联系和支持，以及与联邦研究经费相关的民事指控。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260901-%E6%9C%AA%E5%8F%8A%E6%97%B6%E6%8A%AB%E9%9C%B2nasa%E8%B5%84%E5%8A%A9%E9%A1%B9%E7%9B%AE%E7%A0%94%E7%A9%B6%E5%91%98%E6%98%AF%E5%8D%83%E4%BA%BA%E8%AE%A1%E5%88%92%E5%8F%82%E4%B8%8E%E8%80%85-%E4%BF%84%E4%BA%A5%E4%BF%84%E5%B7%9E%E7%AB%8B%E5%A4%A7%E5%AD%A6%E5%B0%86%E4%BB%98210%E4%B8%87%E7%BE%8E%E5%85%83%E5%92%8C%E8%A7%A3%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788274968000.webp","sourceId":"rfi"},{"id":1788273832000,"createdDate":"2026-09-01 14:43","name":"法国国际广播电台","title":"正蓬勃发展的登山徒步","content":"每两个法国人中就有一人喜欢徒步旅行，法国徒步协会报告称，2025年62%的法国人在过去12个月内进行过徒步旅行，人数接近3000万，这比2021年增加了约300万人。这项活动之所以吸引人，是因为徒步简单易行、成本低廉且对身体益处多多，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260901-%E6%AD%A3%E8%93%AC%E5%8B%83%E5%8F%91%E5%B1%95%E7%9A%84%E7%99%BB%E5%B1%B1%E5%BE%92%E6%AD%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788273832000.webp","sourceId":"rfi"},{"id":1788273817000,"createdDate":"2026-09-01 14:43","name":"法国国际广播电台","title":"尼泊尔继续艰难救援  清理工作也已开始","content":"一场史无前例的冰雪、岩石、泥浆与碎石洪流于上周三（8月26日）席卷了尼泊尔的河谷城镇村庄以及边境另一侧的中国西藏边境地区，已知造成900多人丧生，另有近5000人失踪。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260901-%E5%B0%BC%E6%B3%8A%E5%B0%94%E7%BB%A7%E7%BB%AD%E8%89%B0%E9%9A%BE%E6%95%91%E6%8F%B4-%E6%B8%85%E7%90%86%E5%B7%A5%E4%BD%9C%E4%B9%9F%E5%B7%B2%E5%BC%80%E5%A7%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788273817000.webp","sourceId":"rfi"},{"id":1788273060000,"createdDate":"2026-09-01 14:31","name":"法国国际广播电台","title":"尼泊尔冰岩崩搜救：当人无法进入时，无人机能做什么？","content":"今天我们跟随电影制作人兼无人机飞手马尼什·马哈詹的脚步，从中国的西藏，经由拉苏瓦佳迪口岸，进入尼泊尔。本次震惊世界的冰岩崩发生的两天前，马哈詹利用无人机进行拍摄的地点距离泥石流的爆发很近。但他当时不知道，不久之后，他多年的高山拍摄经验，和无人机专业技能，将为尼泊尔的大规模救援行动提供宝贵的支撑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%A7%91%E6%8A%80%E6%97%B6%E7%A9%BA/20260901-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%86%B0%E5%B2%A9%E5%B4%A9%E6%90%9C%E6%95%91-%E5%BD%93%E4%BA%BA%E6%97%A0%E6%B3%95%E8%BF%9B%E5%85%A5%E6%97%B6%EF%BC%8C%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%83%BD%E5%81%9A%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788273060000.webp","sourceId":"rfi"},{"id":1788272863000,"createdDate":"2026-09-01 14:27","name":"法国国际广播电台","title":"尼泊尔仍未解除对中国在这次泥石流洪灾中应负责任的怀疑","content":"9月1日上市的法国全国性大报在国际版关注的主题各有侧重。《回声报》从不同角度介绍俄乌战争的最新进展以及战争给周边国家带来的安全隐患；《十字架报》特别报道俄罗斯人开始越来越担心普京政权为继续这场战争可能要扩大招兵；《费加罗报》则注意到支持乌克兰的志愿者国家联盟正试图成为北大西洋公约组织的欧洲支柱；尼泊尔遭遇的严重泥石流洪灾仍然是《解放报》重点关注的话题，特别报道灾情过后，尼泊尔人追找灾难发生的各种原因的努力。中国方面是否因为未及时提供相关资讯而应当对这次灾情如此之重承担责任？《解放报》就此发表文章，梳理对中方资讯通报缺失或迟缓的种种质疑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260901-%E5%B0%BC%E6%B3%8A%E5%B0%94%E4%BA%BA%E4%BB%8D%E6%9C%AA%E8%A7%A3%E9%99%A4%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%9C%A8%E8%BF%99%E6%AC%A1%E6%B3%A5%E7%9F%B3%E6%B5%81%E6%B4%AA%E7%81%BE%E4%B8%AD%E7%9A%84%E8%B4%A3%E4%BB%BB%E7%9A%84%E8%B4%A8%E7%96%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788272863000.webp","sourceId":"rfi"},{"id":1788271547000,"createdDate":"2026-09-01 14:05","name":"法国国际广播电台","title":"中国终止逾30年优惠政策 9月1日起外籍个人股息红利不再免征个税","content":"中国财政部、税务总局周一对外发布公告，明确自9月1日起，外籍个人从外商投资企业取得的股息红利所得，应按照20%税率缴纳个人所得税。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E4%B8%AD%E5%9B%BD%E7%BB%88%E6%AD%A2%E9%80%BE30%E5%B9%B4%E4%BC%98%E6%83%A0%E6%94%BF%E7%AD%96-9%E6%9C%881%E6%97%A5%E8%B5%B7%E5%A4%96%E7%B1%8D%E4%B8%AA%E4%BA%BA%E8%82%A1%E6%81%AF%E7%BA%A2%E5%88%A9%E4%B8%8D%E5%86%8D%E5%85%8D%E5%BE%81%E4%B8%AA%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788271547000.webp","sourceId":"rfi"},{"id":1788270959000,"createdDate":"2026-09-01 13:55","name":"法国国际广播电台","title":"中国给德国经济带来的压力不断增长——德国将如何应对？","content":"近年来，中德经济关系正在发生明显变化。过去几十年，中国经济快速增长为德国企业提供了巨大的市场，也成为德国工业全球化战略的重要组成部分。汽车、机械、化工、电气设备等德国优势产业，都从中国市场中获得了大量收益。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20260901-%E4%B8%AD%E5%9B%BD%E7%BB%99%E5%BE%B7%E5%9B%BD%E7%BB%8F%E6%B5%8E%E5%B8%A6%E6%9D%A5%E7%9A%84%E5%8E%8B%E5%8A%9B%E4%B8%8D%E6%96%AD%E5%A2%9E%E9%95%BF-%E5%BE%B7%E5%9B%BD%E5%B0%86%E5%A6%82%E4%BD%95%E5%BA%94%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788270959000.webp","sourceId":"rfi"},{"id":1788270181000,"createdDate":"2026-09-01 13:43","name":"法国国际广播电台","title":"新西兰和美国将资助库克群岛最北端彭林岛的二战港口升级改造","content":"新西兰、美国和位于南太平洋的库克群岛政府周二宣布，美新两国将共同出资对库克群岛一个环礁上的二战港口进行大规模升级改造。此举再次表明美新等国正努力加强与太平洋地区的关系，而北京在该地区的影响力正日益扩大。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%92%8C%E7%BE%8E%E5%9B%BD%E5%B0%86%E8%B5%84%E5%8A%A9%E5%BA%93%E5%85%8B%E7%BE%A4%E5%B2%9B%E6%9C%80%E5%8C%97%E7%AB%AF%E5%BD%AD%E6%9E%97%E5%B2%9B%E7%9A%84%E4%BA%8C%E6%88%98%E6%B8%AF%E5%8F%A3%E5%8D%87%E7%BA%A7%E6%94%B9%E9%80%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788270181000.webp","sourceId":"rfi"},{"id":1788266993000,"createdDate":"2026-09-01 12:49","name":"法国国际广播电台","title":"莫迪促普京在乌克兰终战：须朝着这个方向前进，对全人类至关重要","content":"印度总理莫迪（NarendraModi）周一告诉俄罗斯总统普京，为了全人类的福祉，乌克兰战争必须结束，印方将支持一切旨在制止战火的和平努力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E8%8E%AB%E8%BF%AA%E4%BF%83%E6%99%AE%E4%BA%AC%E5%9C%A8%E4%B9%8C%E5%85%8B%E5%85%B0%E7%BB%88%E6%88%98-%E6%88%91%E4%BB%AC%E5%BF%85%E9%A1%BB%E6%9C%9D%E7%9D%80%E8%BF%99%E4%B8%AA%E6%96%B9%E5%90%91%E5%89%8D%E8%BF%9B%EF%BC%8C%E5%AF%B9%E5%85%A8%E4%BA%BA%E7%B1%BB%E8%87%B3%E5%85%B3%E9%87%8D%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788266993000.webp","sourceId":"rfi"}]