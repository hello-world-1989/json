[{"id":1788265408000,"createdDate":"2026-09-01 12:23","name":"法国国际广播电台","title":"上合比什凯克峰会释出的中俄关系讯息：北京正蚕食莫斯科在中亚的地位","content":"上合组织包括中国、俄罗斯、印度和伊朗在内的10个成员国，周一在比什凯克召开第25届峰会。外界普遍认为，这是中国进一步巩固其在中亚影响力的大好机会。据专家指出，自2022年俄乌战争爆发以来，中国改变战略，正蚕食俄罗斯在中亚的地位。换言之，双方的“竞争领域正在扩大”，传统的角色分配“正在被打破”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260901-%E4%B8%8A%E5%90%88%E6%AF%94%E4%BB%80%E5%87%AF%E5%85%8B%E5%B3%B0%E4%BC%9A%E9%87%8A%E5%87%BA%E7%9A%84%E4%B8%AD%E4%BF%84%E5%85%B3%E7%B3%BB%E8%AE%AF%E6%81%AF-%E4%B8%AD%E5%9B%BD%E6%AD%A3%E8%9A%95%E9%A3%9F%E4%BF%84%E7%BD%97%E6%96%AF%E5%9C%A8%E4%B8%AD%E4%BA%9A%E7%9A%84%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788265408000.webp","sourceId":"rfi"},{"id":1788262645000,"createdDate":"2026-09-01 11:37","name":"法国国际广播电台","title":"视频 面对中国企业扩张 德国制造业正努力应对","content":"几十年来，德国经济的核心支柱一直是制造并出口那些支撑全球商业运转的高价值、复杂工业品，从豪华汽车、火车头到工厂机械、飞机和推土机，应有尽有。然而这一增长由制造业带动经济增长的模式正面临来自一个新竞争对手中国的严峻挑战。中国的出口产品往往在质量上能与德国产品媲美，但价格却低得多，德国企业如何应对 ?请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E8%A7%86%E9%A2%91-%E9%9D%A2%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E6%89%A9%E5%BC%A0-%E5%BE%B7%E5%9B%BD%E5%88%B6%E9%80%A0%E4%B8%9A%E6%AD%A3%E5%8A%AA%E5%8A%9B%E5%BA%94%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788262645000.webp","sourceId":"rfi"},{"id":1788260745000,"createdDate":"2026-09-01 11:05","name":"法国国际广播电台","title":"中国警告台湾出席太平洋岛国论坛会有“后果” 澳总理回应","content":"太平洋岛国领导人于周一（8月31日）开始在帕劳举行一年一度的太平洋岛国论坛。中国周二表示反对台湾出席，称这个民主统治的岛屿没有资格出席峰会，同时威胁“会有后果“，但澳大利亚和新西兰表示，太平洋岛国集团自己决定嘉宾名单。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260901-%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%8F%B0%E6%B9%BE%E5%87%BA%E5%B8%AD%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E4%BC%9A%E6%9C%89-%E5%90%8E%E6%9E%9C-%E6%BE%B3%E6%80%BB%E7%90%86%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788260745000.webp","sourceId":"rfi"},{"id":1788259809000,"createdDate":"2026-09-01 10:50","name":"法国国际广播电台","title":"美官员指控中远船只利用隐蔽设备为中方收集情报 中使馆否认","content":"据路透社报导，两名特朗普政府高级官员称，中国国有航运巨头中国远洋海运集团有限公司（COSCO、以下简称中远海运）在其船只上安装隐蔽设备，用于监听包括美国在内的目标国家沿海地区的军事通信。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260901-%E7%BE%8E%E5%AE%98%E5%91%98%E6%8C%87%E6%8E%A7%E4%B8%AD%E8%BF%9C%E8%88%B9%E5%8F%AA%E5%88%A9%E7%94%A8%E9%9A%90%E8%94%BD%E8%AE%BE%E5%A4%87%E4%B8%BA%E4%B8%AD%E6%96%B9%E6%94%B6%E9%9B%86%E6%83%85%E6%8A%A5-%E4%B8%AD%E4%BD%BF%E9%A6%86%E5%90%A6%E8%AE%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788259809000.webp","sourceId":"rfi"},{"id":1788259264000,"createdDate":"2026-09-01 10:41","name":"法国国际广播电台","title":"中俄首脑会谈 日本官房长官对中俄联合军事行动深表担忧","content":"针对中国国家主席习近平和俄罗斯总统普京31日在访问地吉尔吉斯坦首都比什凯克举行会谈一事，日本内阁官房长官木原稔在9月1日的记者会上，对中俄两国在日本周边开展联合军事活动表示担忧。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260901-%E4%B8%AD%E4%BF%84%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E5%AF%B9%E4%B8%AD%E4%BF%84%E8%81%94%E5%90%88%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8%E6%B7%B1%E8%A1%A8%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788259264000.webp","sourceId":"rfi"},{"id":1788258056000,"createdDate":"2026-09-01 10:20","name":"法国国际广播电台","title":"涉嫌在北约从事间谍活动的加拿大华裔女子被拒绝保释","content":"涉嫌在位于比利时蒙斯的北约欧洲盟军最高司令部从事间谍活动的加拿大籍女子预计将被继续拘留至审判，而审判可能要一年或更久之后才会进行。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E6%B6%89%E5%AB%8C%E5%9C%A8%E5%8C%97%E7%BA%A6%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%A5%B3%E5%AD%90%E8%A2%AB%E6%8B%92%E7%BB%9D%E4%BF%9D%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788258056000.webp","sourceId":"rfi"},{"id":1788256387000,"createdDate":"2026-09-01 09:53","name":"法国国际广播电台","title":"芬兰总统称王毅告诉他中方不会允许俄罗斯使用核武器 中国外交部回应","content":"就乌通社记者提问，芬兰总统斯图布近日在受访时表示，中国外交部长王毅今夏曾向他保证中方不会允许俄罗斯在俄乌战争中使用核武器，外交部对芬兰总统的表态有何评论？中国外交部发言人郭嘉昆周二在例行记者会上回答说：“关于王毅外长访问芬兰的相关情况，中方已经发布过消息”。郭嘉昆说，中方在乌克兰危机以及涉核问题上的立场是一贯的、明确的，将继续致力于劝和促谈，推动危机政治解决。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E8%8A%AC%E5%85%B0%E6%80%BB%E7%BB%9F%E7%A7%B0%E7%8E%8B%E6%AF%85%E5%91%8A%E8%AF%89%E4%BB%96%E4%B8%AD%E6%96%B9%E4%B8%8D%E4%BC%9A%E5%85%81%E8%AE%B8%E4%BF%84%E7%BD%97%E6%96%AF%E4%BD%BF%E7%94%A8%E6%A0%B8%E6%AD%A6%E5%99%A8-%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788256387000.webp","sourceId":"rfi"},{"id":1788255692000,"createdDate":"2026-09-01 09:41","name":"法国国际广播电台","title":"俄日再起争端：俄抗议美澳日军演，称日本部署美“台风”导弹“绝不可接受”","content":"9月1日星期二，俄罗斯就日本、澳大利亚、美国即将举行的远东联合军演提出抗议，对该军演靠近俄罗斯边境表示担忧。由于本次演习涵盖美国“台风”陆基系统，将首次涉及该中程导弹系统发射SM-6导弹和“战斧”巡航导弹的能力，俄方已向日方指出，在日本领土上部署此类武器，对俄罗斯的安全构成威胁，不可接受。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E4%BF%84%E6%97%A5%E5%86%8D%E8%B5%B7%E4%BA%89%E7%AB%AF-%E4%BF%84%E6%8A%97%E8%AE%AE%E7%BE%8E%E6%BE%B3%E6%97%A5%E5%86%9B%E6%BC%94%EF%BC%8C%E7%A7%B0%E6%97%A5%E6%9C%AC%E9%83%A8%E7%BD%B2%E7%BE%8E-%E5%8F%B0%E9%A3%8E-%E5%AF%BC%E5%BC%B9-%E7%BB%9D%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788255692000.webp","sourceId":"rfi"},{"id":1788255086000,"createdDate":"2026-09-01 09:31","name":"法国国际广播电台","title":"欧盟高官谈欧中贸易谈判：需要在10月份前取得切实成果，望中方限制对欧盟出口","content":"欧盟委员会贸易和经济安全委员谢夫乔维奇（MarošŠefčovič）周一表示，欧盟委员会正在探索各种途径，试图说服北京限制中方对欧盟的出口，以期减少欧盟对华巨额贸易逆差。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260901-%E6%AC%A7%E7%9B%9F%E9%AB%98%E5%AE%98%E8%B0%88%E6%AC%A7%E4%B8%AD%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4-%E9%9C%80%E8%A6%81%E5%9C%A810%E6%9C%88%E4%BB%BD%E5%89%8D%E5%8F%96%E5%BE%97%E5%88%87%E5%AE%9E%E6%88%90%E6%9E%9C%EF%BC%8C%E6%9C%9B%E4%B8%AD%E6%96%B9%E9%99%90%E5%88%B6%E5%AF%B9%E6%AC%A7%E7%9B%9F%E5%87%BA%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788255086000.webp","sourceId":"rfi"},{"id":1788252996000,"createdDate":"2026-09-01 08:56","name":"法国国际广播电台","title":"官员：美公司将接管此前由中俄公司运营的部分委内瑞拉油田 涉中石油、中石化","content":"两名美方官员周一向路透社透露称，美国石油公司——北美蓝色能源合作伙伴公司（NABEP）将接管此前由多家中国公司和一家俄罗斯公司控制的部分油田。他们表示，此次接管是美国总统特朗普与委内瑞拉宣布的一项全面石油生产协议的一部分。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260901-%E5%AE%98%E5%91%98-%E7%BE%8E%E5%85%AC%E5%8F%B8%E5%B0%86%E6%8E%A5%E7%AE%A1%E6%AD%A4%E5%89%8D%E7%94%B1%E4%B8%AD%E4%BF%84%E5%85%AC%E5%8F%B8%E8%BF%90%E8%90%A5%E7%9A%84%E9%83%A8%E5%88%86%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%B2%B9%E7%94%B0-%E6%B6%89%E4%B8%AD%E7%9F%B3%E6%B2%B9-%E4%B8%AD%E7%9F%B3%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788252996000.webp","sourceId":"rfi"},{"id":1788250589000,"createdDate":"2026-09-01 08:16","name":"法国国际广播电台","title":"赖清德：台湾的半导体实力建立在民主与法治之上，正在世界各地形成新的产业连结","content":"路透社台北消息，台湾总统赖清德于周二表示，台湾的半导体实力建立在民主与法治的基础之上，已成为一个值得信赖的国际合作伙伴，并始终践行对全球的供应承诺。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260901-%E8%B5%96%E6%B8%85%E5%BE%B7-%E5%8F%B0%E6%B9%BE%E7%9A%84%E5%8D%8A%E5%AF%BC%E4%BD%93%E5%AE%9E%E5%8A%9B%E5%BB%BA%E7%AB%8B%E5%9C%A8%E6%B0%91%E4%B8%BB%E4%B8%8E%E6%B3%95%E6%B2%BB%E4%B9%8B%E4%B8%8A%EF%BC%8C%E6%AD%A3%E5%9C%A8%E4%B8%96%E7%95%8C%E5%90%84%E5%9C%B0%E5%BD%A2%E6%88%90%E6%96%B0%E7%9A%84%E4%BA%A7%E4%B8%9A%E8%BF%9E%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788250589000.webp","sourceId":"rfi"},{"id":1788245753000,"createdDate":"2026-09-01 06:55","name":"法国国际广播电台","title":"加国港人救生艇计划结束 3.5万人待批 可能要等逾15年","content":"加拿大因应《港区国安法》实施而推出的「救生艇」移民计划，已於昨(8月31日)天如期终止，并未因应当地团体指香港人权受国安法进一步假蚀而延长。争取团体会长黄冠能向本台表示，该会当然希望尽力争取更多移民名额拨给港人救生艇，但至少要力保名额不变，否则，香港申请人可能要等超过15年才能取得加国永久居民身份。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260901-%E5%8A%A0%E5%9B%BD%E6%B8%AF%E4%BA%BA%E6%95%91%E7%94%9F%E8%89%87%E8%AE%A1%E5%88%92%E7%BB%93%E6%9D%9F-3-5%E4%B8%87%E4%BA%BA%E5%BE%85%E6%89%B9-%E5%8F%AF%E8%83%BD%E8%A6%81%E7%AD%89%E9%80%BE15%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/01/1788245753000.webp","sourceId":"rfi"}]