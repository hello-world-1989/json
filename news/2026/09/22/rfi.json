[{"id":1790079296000,"createdDate":"2026-09-22 12:14","name":"法国国际广播电台","title":"亚运会两名朝鲜代表团成员据报欲在日本寻求政治庇护","content":"据韩国《月刊朝鲜》周二报导，两名参加日本爱知-名古屋亚运会的朝鲜代表团成员有意寻求政治庇护。该杂志援引日本情报官员报导称，这两人是出席本届亚运会的180人朝鲜代表团成员；第20届亚运会于上周六（19日）在日本爱知·名古屋开幕。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260922-%E4%BA%9A%E8%BF%90%E4%BC%9A%E4%B8%A4%E5%90%8D%E6%9C%9D%E9%B2%9C%E4%BB%A3%E8%A1%A8%E5%9B%A2%E6%88%90%E5%91%98%E6%AC%B2%E5%9C%A8%E6%97%A5%E6%9C%AC%E5%AF%BB%E6%B1%82%E6%94%BF%E6%B2%BB%E5%BA%87%E6%8A%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790079296000.webp","sourceId":"rfi"},{"id":1790077645000,"createdDate":"2026-09-22 11:47","name":"法国国际广播电台","title":"20多位民主党议员致信特朗普 要求确保中国车企不得进入美国市场","content":"本周，在美国总统特朗普（DonaldTrump）即将与中国国家主席习近平在白宫举行会谈之际，二十多位民主党议员于周一敦促特朗普维持针对中国汽车制造商进入美国市场的禁令。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260922-20%E5%A4%9A%E4%BD%8D%E6%B0%91%E4%B8%BB%E5%85%9A%E8%AE%AE%E5%91%98%E8%87%B4%E4%BF%A1%E7%89%B9%E6%9C%97%E6%99%AE-%E8%A6%81%E6%B1%82%E7%A1%AE%E4%BF%9D%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E4%B8%8D%E5%BE%97%E8%BF%9B%E5%85%A5%E7%BE%8E%E5%9B%BD%E5%B8%82%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790077645000.webp","sourceId":"rfi"},{"id":1790075927000,"createdDate":"2026-09-22 11:18","name":"法国国际广播电台","title":"F-35战机部件运输中丢失 澳洲防长称“不属于敏感物资”","content":"一批原本从澳大利亚运往美国的F-35战斗机零部件，在运输途中意外转运至香港，并在此后数月下落不明。澳大利亚政府对此展开调查。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260922-f-35%E6%88%98%E6%9C%BA%E9%83%A8%E4%BB%B6%E8%BF%90%E8%BE%93%E4%B8%AD%E4%B8%A2%E5%A4%B1-%E6%BE%B3%E6%B4%B2%E9%98%B2%E9%95%BF%E7%A7%B0-%E4%B8%8D%E5%B1%9E%E4%BA%8E%E6%95%8F%E6%84%9F%E7%89%A9%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790075927000.webp","sourceId":"rfi"},{"id":1790072646000,"createdDate":"2026-09-22 10:24","name":"法国国际广播电台","title":"苏林：非常接近与美国达成贸易协议，我们不接受货物转运","content":"越共中央总书记、国家主席苏林在纽约与特朗普政府官员会谈前表示，越南距离与美国达成贸易协议已“非常接近”；他同时承诺将购买更多美产飞机等高科技产品，以缩小贸易逆差。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260922-%E8%8B%8F%E6%9E%97-%E9%9D%9E%E5%B8%B8%E6%8E%A5%E8%BF%91%E4%B8%8E%E7%BE%8E%E5%9B%BD%E8%BE%BE%E6%88%90%E8%B4%B8%E6%98%93%E5%8D%8F%E8%AE%AE%EF%BC%8C%E6%88%91%E4%BB%AC%E4%B8%8D%E6%8E%A5%E5%8F%97%E8%B4%A7%E7%89%A9%E8%BD%AC%E8%BF%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790072646000.webp","sourceId":"rfi"},{"id":1790071009000,"createdDate":"2026-09-22 09:56","name":"法国国际广播电台","title":"习近平据报将促特朗普依《八一七公报》停止对台军售 中方提协助向伊朗施压","content":"据路透社援引知情人士报导称，中国国家主席习近平本周访问华盛顿期间，预计将敦促美国总统特朗普（DonaldTrump）依据1982年《八一七公报》停止对台军售；他可能会在参观美国国家档案馆时提出这一要求。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260922-%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8D%AE%E6%8A%A5%E5%B0%86%E4%BF%83%E7%89%B9%E6%9C%97%E6%99%AE%E4%BE%9D-%E5%85%AB%E4%B8%80%E4%B8%83%E5%85%AC%E6%8A%A5-%E5%81%9C%E6%AD%A2%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE-%E4%B8%AD%E6%96%B9%E6%8F%90%E5%87%BA%E5%8D%8F%E5%8A%A9%E5%90%91%E4%BC%8A%E6%9C%97%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790071009000.webp","sourceId":"rfi"},{"id":1790067879000,"createdDate":"2026-09-22 09:04","name":"法国国际广播电台","title":"国民党主席郑丽文坦言今年选情较冷 没有任何县市稳赢、稳上","content":"郑丽文曾提到，国民党对抗民进党对她而言不是最难的。国民党最难的挑战，从来都是来自内部。首先她要确立游戏规则，并尝试用最大的包容、最高的智慧去化解。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260922-%E5%9B%BD%E6%B0%91%E5%85%9A%E4%B8%BB%E5%B8%AD%E9%83%91%E4%B8%BD%E5%9D%A6%E8%A8%80%E4%BB%8A%E5%B9%B4%E9%80%89%E6%83%85%E8%BE%83%E5%86%B7-%E6%B2%A1%E6%9C%89%E4%BB%BB%E4%BD%95%E5%8E%BF%E5%B8%82%E7%A8%B3%E8%B5%A2-%E7%A8%B3%E4%B8%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790067879000.webp","sourceId":"rfi"},{"id":1790067578000,"createdDate":"2026-09-22 08:59","name":"法国国际广播电台","title":"美日韩外长会：强调维护台海和平稳定重要性，反对单方面改变现状企图","content":"周一，美国重申保卫其亚洲关键盟友日韩“如钢铁般牢固的承诺”。在本周美国总统特朗普（DonaldTrump）与中国国家主席习近平举行峰会前夕，美日韩外长还强调了维护台湾海峡和平与稳定的重要性。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260922-%E7%BE%8E%E6%97%A5%E9%9F%A9%E5%A4%96%E9%95%BF%E4%BC%9A-%E5%BC%BA%E8%B0%83%E7%BB%B4%E6%8A%A4%E5%8F%B0%E6%B5%B7%E5%92%8C%E5%B9%B3%E7%A8%B3%E5%AE%9A%E9%87%8D%E8%A6%81%E6%80%A7%EF%BC%8C%E5%8F%8D%E5%AF%B9%E5%8D%95%E6%96%B9%E9%9D%A2%E6%94%B9%E5%8F%98%E7%8E%B0%E7%8A%B6%E4%BC%81%E5%9B%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790067578000.webp","sourceId":"rfi"},{"id":1790065906000,"createdDate":"2026-09-22 08:31","name":"法国国际广播电台","title":"高市首相到达纽约  日美外相围绕中国问题等举行会谈","content":"前往纽约参加联合国大会的日本首相高市早苗，因受台风影响，比原定计划晚了约4个小时，于日本时间今天中午左右乘政府专机抵达纽约，并进入下榻酒店。她将于日本时间23日凌晨与特朗普总统举行首脑会谈。在美中首脑会谈之前，日方希望就对华认识与美方进行协调。随后，高市首相将出席联合国大会，并发表一般性辩论演说。而当地时间9月21日上午11时55分起，而为出席联合国大会正在美国纽约访问的日本外务大臣茂木敏充与美国国务卿鲁比奥举行会谈,茂木敏充21日还与韩国外长赵显举行会谈，三国发表了强调维护台湾海峡和平与稳定重要性等的联合声明。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260922-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%88%B0%E8%BE%BE%E7%BA%BD%E7%BA%A6-%E6%97%A5%E7%BE%8E%E5%A4%96%E7%9B%B8%E5%9B%B4%E7%BB%95%E4%B8%AD%E5%9B%BD%E9%97%AE%E9%A2%98%E7%AD%89%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790065906000.webp","sourceId":"rfi"},{"id":1790065896000,"createdDate":"2026-09-22 08:31","name":"法国国际广播电台","title":"欧洲思想文化长廊:希腊：欧洲文化永不磨灭的光辉第9：埃斯库罗斯 ：战士剧作家","content":"希腊三大悲剧作家中，埃斯库罗斯的成名最早。他本人是一位奋勇杀敌的战士，亲身参加了马拉松战役与萨拉米海战。在希腊与波斯的生死存亡之战中，埃斯库罗斯战功卓著。所以，他笔下的人物多是不畏强暴的英雄，他的戏剧语言也格外英勇豪迈，铿锵有力。从他的戏剧中我们能见出剧作家本人的身影。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260922-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC9-%E5%9F%83%E6%96%AF%E5%BA%93%E7%BD%97%E6%96%AF-%E6%88%98%E5%A3%AB%E5%89%A7%E4%BD%9C%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790065896000.webp","sourceId":"rfi"},{"id":1790065269000,"createdDate":"2026-09-22 08:21","name":"法国国际广播电台","title":"中国欧盟商会报告：对中国出口主导的经济结构性失衡感到担忧","content":"中国欧盟商会周二（9月22日）发布最新年度报告，对中国出口的强劲与国内消费疲软之间持续失衡表达担忧，认为这种状况以难以为继。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260922-%E4%B8%AD%E5%9B%BD%E6%AC%A7%E7%9B%9F%E5%95%86%E4%BC%9A%E6%8A%A5%E5%91%8A-%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%87%BA%E5%8F%A3%E4%B8%BB%E5%AF%BC%E7%9A%84%E7%BB%93%E6%9E%84%E6%80%A7%E5%A4%B1%E8%A1%A1%E6%84%9F%E5%88%B0%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790065269000.webp","sourceId":"rfi"},{"id":1790064839000,"createdDate":"2026-09-22 08:13","name":"法国国际广播电台","title":"27岁女子遭狗袭击至死 港府急欲撇清与北都无关 却承认收地或令流浪狗增加","content":"香港元朗发生年轻女子疑遭狗只袭击至死的事件，有动物组织认为，该处流浪狗只增加，与北部都会区（北都）收地发展有关。港府高层闻言即澄清，指狗咬人事件与北都发展无关，但承认有留意北都收地后可能会出现流浪狗问题，又证实事发地点早前已有居民投诉被流浪狗咬。评论认为，事件证明当局已知事发地一带是流浪狗袭击人的黑点，但却没有及早处理，呼吁部门认真处理投诉以避免事故再次发生。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260922-27%E5%B2%81%E5%A5%B3%E5%AD%90%E9%81%AD%E7%8B%97%E8%A2%AD%E5%87%BB%E8%87%B3%E6%AD%BB-%E6%B8%AF%E5%BA%9C%E6%80%A5%E6%AC%B2%E6%92%87%E6%B8%85%E4%B8%8E%E5%8C%97%E9%83%BD%E6%97%A0%E5%85%B3-%E5%8D%B4%E6%89%BF%E8%AE%A4%E6%94%B6%E5%9C%B0%E6%88%96%E4%BB%A4%E6%B5%81%E6%B5%AA%E7%8B%97%E5%A2%9E%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790064839000.webp","sourceId":"rfi"},{"id":1790064597000,"createdDate":"2026-09-22 08:09","name":"法国国际广播电台","title":"港国安高层为打击「软对抗」护航 否认搜捕独立书店属滥捕","content":"香港法律虽未有禁止「软对抗」，并被人权组织评为易被当局滥用来打压人权，但负责香港警方国安工作的警务处副处长简启恩退休前仍为「软对抗」辩解，指「软对抗」在香港国安相关法例实施后并无减少，而日前搜捕独立书店的行动前，有阅读相关书本及咨询法律意见，不存在滥捕。另外，保安局局长邓炳强亦辩称，「软对抗」是香港面对的四大国安风险之一。评论指，港府应深思持续「凡事皆国安」的态度是否对香港发展有利。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260922-%E6%B8%AF%E5%9B%BD%E5%AE%89%E9%AB%98%E5%B1%82%E4%B8%BA%E6%89%93%E5%87%BB-%E8%BD%AF%E5%AF%B9%E6%8A%97-%E6%8A%A4%E8%88%AA-%E5%90%A6%E8%AE%A4%E6%90%9C%E6%8D%95%E7%8B%AC%E7%AB%8B%E4%B9%A6%E5%BA%97%E5%B1%9E%E6%BB%A5%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790064597000.webp","sourceId":"rfi"},{"id":1790064191000,"createdDate":"2026-09-22 08:03","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉：普罗米修斯的象征意义","content":"埃斯库罗斯塑造了普罗米修斯叛逆的英雄形象，但是这个形象的象征意义不仅于此。他还宣示了希腊人的一些终极诉求，如正义、平等、博爱,自由等等。尤其是埃斯库罗斯通过伊俄这个人物，表达对男权世界霸凌女性的批判。这引发后来人的仿效，索福克勒斯，欧里庇德斯都有张扬女性权利的杰作问世。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260922-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E6%99%AE%E7%BD%97%E7%B1%B3%E4%BF%AE%E6%96%AF%E7%9A%84%E8%B1%A1%E5%BE%81%E6%84%8F%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/09/22/1790064191000.webp","sourceId":"rfi"}]