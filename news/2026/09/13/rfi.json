[{"id":1789304429000,"createdDate":"2026-09-13 13:00","name":"法国国际广播电台","title":"从前现任美官员处获取信息 一中国女子在底特律机场被拦下控非法代理人","content":"9月11日，底特律联邦检察官对一名中国籍女子提起诉讼，指控其在与现任和前任美国政府官员会面期间，为中国政府的情报机构工作。这是近期一系列引发国家安全担忧的反间谍案件中的最新一起。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260913-%E4%BB%8E%E5%89%8D%E7%8E%B0%E4%BB%BB%E7%BE%8E%E5%AE%98%E5%91%98%E5%A4%84%E8%8E%B7%E5%8F%96%E4%BF%A1%E6%81%AF-%E4%B8%80%E4%B8%AD%E5%9B%BD%E5%A5%B3%E5%AD%90%E5%9C%A8%E5%BA%95%E7%89%B9%E5%BE%8B%E6%9C%BA%E5%9C%BA%E8%A2%AB%E6%8B%A6%E4%B8%8B%E6%8E%A7%E9%9D%9E%E6%B3%95%E4%BB%A3%E7%90%86%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789304429000.webp","sourceId":"rfi"},{"id":1789296050000,"createdDate":"2026-09-13 10:40","name":"法国国际广播电台","title":"研究：上半年，德国企业在华投资额增加三分之一，大幅削减在美投资","content":"据路透社周日看到的德国经济研究所（IW）的一项研究显示，2026年上半年，德国企业在中国的投资额增加了三分之一，同时大幅削减了在美国的投资额。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260913-%E7%A0%94%E7%A9%B6-%E4%B8%8A%E5%8D%8A%E5%B9%B4%EF%BC%8C%E5%BE%B7%E5%9B%BD%E4%BC%81%E4%B8%9A%E5%9C%A8%E5%8D%8E%E6%8A%95%E8%B5%84%E9%A2%9D%E5%A2%9E%E5%8A%A0%E4%B8%89%E5%88%86%E4%B9%8B%E4%B8%80%EF%BC%8C%E5%A4%A7%E5%B9%85%E5%89%8A%E5%87%8F%E5%9C%A8%E7%BE%8E%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789296050000.webp","sourceId":"rfi"},{"id":1789294749000,"createdDate":"2026-09-13 10:19","name":"法国国际广播电台","title":"日本日中友好议联8名议员13日起访华","content":"由日本执政党和在野党议员组成的日中友好议员联盟的年轻成员访华代表团，13日起访问中国，他们已经从羽田机场出发。他们计划在当地会见负责民间外交机构的负责人等。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260913-%E6%97%A5%E6%9C%AC%E6%97%A5%E4%B8%AD%E5%8F%8B%E5%A5%BD%E8%AE%AE%E8%81%948%E5%90%8D%E8%AE%AE%E5%91%9813%E6%97%A5%E8%B5%B7%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294749000.webp","sourceId":"rfi"},{"id":1789294562000,"createdDate":"2026-09-13 10:16","name":"法国国际广播电台","title":"克宫：习近平和莫迪均提到乌克兰问题 普京高度赞赏二人意愿","content":"据俄新社报导，俄罗斯总统普京的新闻秘书佩斯科夫表示，普京高度赞赏印度总理莫迪和中国国家主席习近平为推动乌克兰问题解决所表现出的意愿。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E5%85%8B%E5%AE%AB-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%92%8C%E8%8E%AB%E8%BF%AA%E5%9D%87%E6%8F%90%E5%88%B0%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98-%E6%99%AE%E4%BA%AC%E9%AB%98%E5%BA%A6%E8%B5%9E%E8%B5%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294562000.webp","sourceId":"rfi"},{"id":1789294447000,"createdDate":"2026-09-13 10:14","name":"法国国际广播电台","title":"北京进一步收紧无人机管制：11月15日全域禁飞禁存禁运","content":"在5月禁止销售无人机后，北京周日（9月13号）宣布的新规进一步收紧监管，禁止在市区范围内持有无人机，这项禁令将于11月中旬生效。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260913-%E5%8C%97%E4%BA%AC%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%94%B6%E7%B4%A7%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%AE%A1%E5%88%B6-11%E6%9C%8815%E6%97%A5%E5%85%A8%E5%9F%9F%E7%A6%81%E9%A3%9E%E7%A6%81%E5%AD%98%E7%A6%81%E8%BF%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294447000.webp","sourceId":"rfi"},{"id":1789294338000,"createdDate":"2026-09-13 10:12","name":"法国国际广播电台","title":"金砖国家峰会：“包容性”经济增长成为峰会第二天的焦点议题","content":"周日在新德里举行的金砖国家峰会的第二天，也是最后一天，与会成员国领导人讨论了如何促进“包容性全球经济增长”的议题。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A-%E5%8C%85%E5%AE%B9%E6%80%A7-%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF%E6%88%90%E4%B8%BA%E5%B3%B0%E4%BC%9A%E7%AC%AC%E4%BA%8C%E5%A4%A9%E7%9A%84%E7%84%A6%E7%82%B9%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294338000.webp","sourceId":"rfi"},{"id":1789293280000,"createdDate":"2026-09-13 09:54","name":"法国国际广播电台","title":"加拿大总理卡尼访欧推“入欧”蓝图 进一步脱离对美国依赖","content":"正当美国特朗普（Trump）政府对加拿大展现的敌意不断升级，加拿大总理卡尼（MarkCarney）正启动外交政策大转向。卡尼将于下周二启程（9月15日至17日）到法国，应欧洲议会议长梅措拉（RobertaMetsola）邀请发表演说，并出席欧盟委员会主席冯德莱恩的年度国情咨文大会，随后转往英国利物浦会晤英国工党新任首相伯纳姆（AndyBurnham）。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260913-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%80%BB%E7%90%86%E5%8D%A1%E5%B0%BC%E8%AE%BF%E6%AC%A7%E6%8E%A8-%E5%85%A5%E6%AC%A7-%E8%93%9D%E5%9B%BE-%E8%BF%9B%E4%B8%80%E6%AD%A5%E8%84%B1%E7%A6%BB%E5%AF%B9%E7%BE%8E%E5%9B%BD%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789293280000.webp","sourceId":"rfi"},{"id":1789292806000,"createdDate":"2026-09-13 09:46","name":"法国国际广播电台","title":"OpenAI奥特曼：若特习能就AI安全发展达成协议，两人应获诺贝尔和平奖","content":"美国人工智能企业OpenAI首席执行官奥特曼（SamAltman）在周五的一则专访中表示，OpenAI不会在2026年上市。他指出，人工智能的安全隐患使得即使该技术在未来十年内导致人类灭绝的风险仅有10%，也是“不可接受的”。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260913-openai%E5%A5%A5%E7%89%B9%E6%9B%BC-%E8%8B%A5%E7%89%B9%E4%B9%A0%E8%83%BD%E5%B0%B1ai%E5%AE%89%E5%85%A8%E5%8F%91%E5%B1%95%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE%EF%BC%8C%E4%B8%A4%E4%BA%BA%E5%BA%94%E8%8E%B7%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789292806000.webp","sourceId":"rfi"},{"id":1789323413000,"createdDate":"2026-09-13 18:16","name":"法国国际广播电台","title":"法国民粹化趋势加剧？总统选举民调：极右翼勒庞遥遥领先，极左翼梅朗雄紧随其后","content":"法新社周日（9月13日）消息称，在一项备受期待的民调（ Ipsos-BVA ）中，结果显示，有33%至35%的人表示打算投票支持极右翼国民联盟候选人勒庞，她大幅领先于其他候选人。在所测试的六种候选人组合中，极左翼法国不屈服党候选人梅朗雄有四种情形能够进入第二轮，排名第二，以15.5%至17%的投票意向率与勒庞一同进入第二轮。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260913-%E6%B3%95%E5%9B%BD%E6%B0%91%E7%B2%B9%E5%8C%96%E8%B6%8B%E5%8A%BF%E5%8A%A0%E5%89%A7-%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E6%B0%91%E8%B0%83-%E6%9E%81%E5%8F%B3%E7%BF%BC%E5%8B%92%E5%BA%9E%E9%81%A5%E9%81%A5%E9%A2%86%E5%85%88%EF%BC%8C%E6%9E%81%E5%B7%A6%E7%BF%BC%E6%A2%85%E6%9C%97%E9%9B%84%E7%B4%A7%E9%9A%8F%E5%85%B6%E5%90%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789323413000.webp","sourceId":"rfi"},{"id":1789321903000,"createdDate":"2026-09-13 17:51","name":"法国国际广播电台","title":"AI问题已成为中期选举核心议题：特朗普政府不愿放缓AI发展，民主党人呼吁立即采取行动","content":"美国总统特朗普及其阵营中的多位重要人物周日（9月13日）表示反对放缓人工智能（AI）的发展，当前，人工智能问题目前已成为美国中期选举竞选活动中的重要议题之一。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260913-ai%E9%97%AE%E9%A2%98%E5%B7%B2%E6%88%90%E4%B8%BA%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E6%A0%B8%E5%BF%83%E8%AE%AE%E9%A2%98-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E4%B8%8D%E6%84%BF%E6%94%BE%E7%BC%93ai%E5%8F%91%E5%B1%95%EF%BC%8C%E6%B0%91%E4%B8%BB%E5%85%9A%E4%BA%BA%E5%91%BC%E5%90%81%E7%AB%8B%E5%8D%B3%E9%87%87%E5%8F%96%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789321903000.webp","sourceId":"rfi"},{"id":1789318685000,"createdDate":"2026-09-13 16:58","name":"法国国际广播电台","title":"华尔街日报：欧盟或对加拿大成为“准成员国”持开放态度","content":"法新社援引周日（9月13日）《华尔街日报》的报道称，加拿大总理卡尼希望进一步加强与欧盟的关系，并正在考虑让加拿大成为欧盟“准成员国”的可能性。该报援引欧盟和加拿大双方匿名官员的话称，欧盟过去在成员资格规则方面一直不太灵活，但目前可能对赋予加拿大一种尚待创设的“准成员国”地位持开放态度。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260913-%E5%8D%8E%E5%B0%94%E8%A1%97%E6%97%A5%E6%8A%A5-%E6%AC%A7%E7%9B%9F%E6%88%96%E5%AF%B9%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%88%90%E4%B8%BA-%E5%87%86%E6%88%90%E5%91%98%E5%9B%BD-%E6%8C%81%E5%BC%80%E6%94%BE%E6%80%81%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789318685000.webp","sourceId":"rfi"},{"id":1789318186000,"createdDate":"2026-09-13 16:49","name":"法国国际广播电台","title":"德国两州选举前民调：选择党得分将大增 基民盟得分仍将下滑","content":"离9月20日柏林和梅前州州议会选举还有一周，德国民调显示的是什么走向？德国笼罩着什么气氛？","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260913-%E5%BE%B7%E5%9B%BD%E4%B8%A4%E5%B7%9E%E9%80%89%E4%B8%BE%E5%89%8D%E6%B0%91%E8%B0%83-%E9%80%89%E6%8B%A9%E5%85%9A%E5%BE%97%E5%88%86%E5%B0%86%E5%A4%A7%E5%A2%9E-%E5%9F%BA%E6%B0%91%E7%9B%9F%E5%BE%97%E5%88%86%E4%BB%8D%E5%B0%86%E4%B8%8B%E6%BB%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789318186000.webp","sourceId":"rfi"},{"id":1789314780000,"createdDate":"2026-09-13 15:53","name":"法国国际广播电台","title":"俄袭击基辅至华沙客运列车 英前首相约翰逊等一众政要所乘临近列车被疏散","content":"周日，一架俄罗斯无人机在波兰边境附近的一列已疏散的列车上击中目标。此前不久，包括瑞典前首相比尔特（CarlBildt）在内的多位访乌外国政要曾使用该过境点。俄方对乌克兰发动了数月来最大规模的无人机袭击。乌克兰当局称，无人机击中的是列车的机车车厢，该车厢在乌方得知即将遭受袭击后，已被与列车其他部分分离，随后列车开始疏散。袭击地点位于距离波兰边境2公里的亚戈丁过境点附近，目前尚无人员伤亡报告。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E4%BF%84%E8%A2%AD%E5%87%BB%E5%9F%BA%E8%BE%85%E8%87%B3%E5%8D%8E%E6%B2%99%E5%AE%A2%E8%BF%90%E5%88%97%E8%BD%A6-%E8%8B%B1%E5%89%8D%E9%A6%96%E7%9B%B8%E7%BA%A6%E7%BF%B0%E9%80%8A%E7%AD%89%E4%B8%80%E4%BC%97%E6%94%BF%E8%A6%81%E6%89%80%E4%B9%98%E4%B8%B4%E8%BF%91%E5%88%97%E8%BD%A6%E8%A2%AB%E7%96%8F%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789314780000.webp","sourceId":"rfi"},{"id":1789311237000,"createdDate":"2026-09-13 14:53","name":"法国国际广播电台","title":"特朗普指不担心习近平可能会取消峰会：我们关系很好","content":"美国总统特朗普周日在爱尔兰访问期间向记者表示，他“并不担心”中国国家主席习近平可能会取消即将在美国举行的峰会。特朗普说道：“我们关系很好，他想和睦相处，我们也想，而且我们会和睦相处。在我（担任总统）的这些年里，我认为中国一直对我们很公平”，并称“但是几十年来，几年来，在拜登和奥巴马执政的这些年里，中国占了美国极大的便宜”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260913-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8C%87%E4%B8%8D%E6%8B%85%E5%BF%83%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8F%AF%E8%83%BD%E4%BC%9A%E5%8F%96%E6%B6%88%E5%B3%B0%E4%BC%9A-%E6%88%91%E4%BB%AC%E5%85%B3%E7%B3%BB%E5%BE%88%E5%A5%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789311237000.webp","sourceId":"rfi"},{"id":1789309654000,"createdDate":"2026-09-13 14:27","name":"法国国际广播电台","title":"俄袭击基辅至华沙客运列车 波兰外长指普京正升级事态 特朗普促乌方停止打击俄柴油","content":"乌克兰和波兰方面表示，周日，一架俄罗斯无人机在靠近波兰边境的基辅至华沙客运列车上空袭击了该列车，但未造成人员伤亡。与此同时，俄罗斯在全面入侵乌克兰的第五年加大了袭击力度。此次袭击地点距离波兰边境仅两公里。几天前，特朗普政府特使访问了基辅和莫斯科，希望重启由华盛顿推动的、旨在结束这场二战以来欧洲最血腥冲突的谈判，但未能取得突破。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E4%BF%84%E8%A2%AD%E5%87%BB%E5%9F%BA%E8%BE%85%E8%87%B3%E5%8D%8E%E6%B2%99%E5%AE%A2%E8%BF%90%E5%88%97%E8%BD%A6-%E6%B3%A2%E5%85%B0%E5%A4%96%E9%95%BF%E6%8C%87%E6%99%AE%E4%BA%AC%E6%AD%A3%E5%8D%87%E7%BA%A7%E4%BA%8B%E6%80%81-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BF%83%E4%B9%8C%E6%96%B9%E5%81%9C%E6%AD%A2%E6%89%93%E5%87%BB%E4%BF%84%E6%9F%B4%E6%B2%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789309654000.webp","sourceId":"rfi"},{"id":1789307862000,"createdDate":"2026-09-13 13:57","name":"法国国际广播电台","title":"人工智能为何突然出现“减速”呼声？","content":"最近几天，美国人工智能领域出现了一个罕见现象：几家投入数百亿美元、激烈争夺下一代AI优势的科技企业，其负责人却开始公开讨论一个看似矛盾的问题——人工智能的发展速度，是不是应该适当放慢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260913-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%BA%E4%BD%95%E7%AA%81%E7%84%B6%E5%87%BA%E7%8E%B0-%E5%87%8F%E9%80%9F-%E5%91%BC%E5%A3%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789307862000.webp","sourceId":"rfi"},{"id":1789305696000,"createdDate":"2026-09-13 13:21","name":"法国国际广播电台","title":"冲绳县知事选举：自民党等6党支持的新人古谢玄太击败现任知事获胜","content":"据日本放送协会（NHK）报导，在周日举行的冲绳县知事选举中，获得包括自民党、日本革新会和国民民主党在内的六个政党支持的新人、42岁的古谢玄太取得了他的首次胜利，击败了寻求连任第三届的现任知事玉城丹尼等候选人。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260913-%E5%86%B2%E7%BB%B3%E5%8E%BF%E7%9F%A5%E4%BA%8B%E9%80%89%E4%B8%BE-%E8%87%AA%E6%B0%91%E5%85%9A%E6%94%AF%E6%8C%81%E7%9A%84%E6%96%B0%E4%BA%BA%E5%8F%A4%E8%B0%A2%E7%8E%84%E5%A4%AA%E5%87%BB%E8%B4%A5%E7%8E%B0%E4%BB%BB%E7%9F%A5%E4%BA%8B%E8%8E%B7%E8%83%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789305696000.webp","sourceId":"rfi"}]