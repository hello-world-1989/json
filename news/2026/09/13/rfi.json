[{"id":1789304429000,"createdDate":"2026-09-13 13:00","name":"法国国际广播电台","title":"从前现任美官员处获取信息 一中国女子在底特律机场被拦下控非法代理人","content":"9月11日，底特律联邦检察官对一名中国籍女子提起诉讼，指控其在与现任和前任美国政府官员会面期间，为中国政府的情报机构工作。这是近期一系列引发国家安全担忧的反间谍案件中的最新一起。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260913-%E4%BB%8E%E5%89%8D%E7%8E%B0%E4%BB%BB%E7%BE%8E%E5%AE%98%E5%91%98%E5%A4%84%E8%8E%B7%E5%8F%96%E4%BF%A1%E6%81%AF-%E4%B8%80%E4%B8%AD%E5%9B%BD%E5%A5%B3%E5%AD%90%E5%9C%A8%E5%BA%95%E7%89%B9%E5%BE%8B%E6%9C%BA%E5%9C%BA%E8%A2%AB%E6%8B%A6%E4%B8%8B%E6%8E%A7%E9%9D%9E%E6%B3%95%E4%BB%A3%E7%90%86%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789304429000.webp","sourceId":"rfi"},{"id":1789296050000,"createdDate":"2026-09-13 10:40","name":"法国国际广播电台","title":"研究：上半年，德国企业在华投资额增加三分之一，大幅削减在美投资","content":"据路透社周日看到的德国经济研究所（IW）的一项研究显示，2026年上半年，德国企业在中国的投资额增加了三分之一，同时大幅削减了在美国的投资额。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260913-%E7%A0%94%E7%A9%B6-%E4%B8%8A%E5%8D%8A%E5%B9%B4%EF%BC%8C%E5%BE%B7%E5%9B%BD%E4%BC%81%E4%B8%9A%E5%9C%A8%E5%8D%8E%E6%8A%95%E8%B5%84%E9%A2%9D%E5%A2%9E%E5%8A%A0%E4%B8%89%E5%88%86%E4%B9%8B%E4%B8%80%EF%BC%8C%E5%A4%A7%E5%B9%85%E5%89%8A%E5%87%8F%E5%9C%A8%E7%BE%8E%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789296050000.webp","sourceId":"rfi"},{"id":1789294749000,"createdDate":"2026-09-13 10:19","name":"法国国际广播电台","title":"日本日中友好议联8名议员13日起访华","content":"由日本执政党和在野党议员组成的日中友好议员联盟的年轻成员访华代表团，13日起访问中国，他们已经从羽田机场出发。他们计划在当地会见负责民间外交机构的负责人等。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260913-%E6%97%A5%E6%9C%AC%E6%97%A5%E4%B8%AD%E5%8F%8B%E5%A5%BD%E8%AE%AE%E8%81%948%E5%90%8D%E8%AE%AE%E5%91%9813%E6%97%A5%E8%B5%B7%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294749000.webp","sourceId":"rfi"},{"id":1789294562000,"createdDate":"2026-09-13 10:16","name":"法国国际广播电台","title":"克宫：习近平和莫迪均提到乌克兰问题 普京高度赞赏二人意愿","content":"据俄新社报导，俄罗斯总统普京的新闻秘书佩斯科夫表示，普京高度赞赏印度总理莫迪和中国国家主席习近平为推动乌克兰问题解决所表现出的意愿。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E5%85%8B%E5%AE%AB-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%92%8C%E8%8E%AB%E8%BF%AA%E5%9D%87%E6%8F%90%E5%88%B0%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98-%E6%99%AE%E4%BA%AC%E9%AB%98%E5%BA%A6%E8%B5%9E%E8%B5%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294562000.webp","sourceId":"rfi"},{"id":1789294447000,"createdDate":"2026-09-13 10:14","name":"法国国际广播电台","title":"北京进一步收紧无人机管制：11月15日全域禁飞禁存禁运","content":"在5月禁止销售无人机后，北京周日（9月13号）宣布的新规进一步收紧监管，禁止在市区范围内持有无人机，这项禁令将于11月中旬生效。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260913-%E5%8C%97%E4%BA%AC%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%94%B6%E7%B4%A7%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%AE%A1%E5%88%B6-11%E6%9C%8815%E6%97%A5%E5%85%A8%E5%9F%9F%E7%A6%81%E9%A3%9E%E7%A6%81%E5%AD%98%E7%A6%81%E8%BF%90","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294447000.webp","sourceId":"rfi"},{"id":1789294338000,"createdDate":"2026-09-13 10:12","name":"法国国际广播电台","title":"金砖国家峰会：“包容性”经济增长成为峰会第二天的焦点议题","content":"周日在新德里举行的金砖国家峰会的第二天，也是最后一天，与会成员国领导人讨论了如何促进“包容性全球经济增长”的议题。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260913-%E9%87%91%E7%A0%96%E5%9B%BD%E5%AE%B6%E5%B3%B0%E4%BC%9A-%E5%8C%85%E5%AE%B9%E6%80%A7-%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF%E6%88%90%E4%B8%BA%E5%B3%B0%E4%BC%9A%E7%AC%AC%E4%BA%8C%E5%A4%A9%E7%9A%84%E7%84%A6%E7%82%B9%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789294338000.webp","sourceId":"rfi"},{"id":1789293280000,"createdDate":"2026-09-13 09:54","name":"法国国际广播电台","title":"加拿大总理卡尼访欧推“入欧”蓝图 进一步脱离对美国依赖","content":"正当美国特朗普（Trump）政府对加拿大展现的敌意不断升级，加拿大总理卡尼（MarkCarney）正启动外交政策大转向。卡尼将于下周二启程（9月15日至17日）到法国，应欧洲议会议长梅措拉（RobertaMetsola）邀请发表演说，并出席欧盟委员会主席冯德莱恩的年度国情咨文大会，随后转往英国利物浦会晤英国工党新任首相伯纳姆（AndyBurnham）。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260913-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%80%BB%E7%90%86%E5%8D%A1%E5%B0%BC%E8%AE%BF%E6%AC%A7%E6%8E%A8-%E5%85%A5%E6%AC%A7-%E8%93%9D%E5%9B%BE-%E8%BF%9B%E4%B8%80%E6%AD%A5%E8%84%B1%E7%A6%BB%E5%AF%B9%E7%BE%8E%E5%9B%BD%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789293280000.webp","sourceId":"rfi"},{"id":1789292806000,"createdDate":"2026-09-13 09:46","name":"法国国际广播电台","title":"OpenAI奥特曼：若特习能就AI安全发展达成协议，两人应获诺贝尔和平奖","content":"美国人工智能企业OpenAI首席执行官奥特曼（SamAltman）在周五的一则专访中表示，OpenAI不会在2026年上市。他指出，人工智能的安全隐患使得即使该技术在未来十年内导致人类灭绝的风险仅有10%，也是“不可接受的”。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260913-openai%E5%A5%A5%E7%89%B9%E6%9B%BC-%E8%8B%A5%E7%89%B9%E4%B9%A0%E8%83%BD%E5%B0%B1ai%E5%AE%89%E5%85%A8%E5%8F%91%E5%B1%95%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE%EF%BC%8C%E4%B8%A4%E4%BA%BA%E5%BA%94%E8%8E%B7%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/13/1789292806000.webp","sourceId":"rfi"}]