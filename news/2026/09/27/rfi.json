[{"id":1790514108000,"createdDate":"2026-09-27 13:01","name":"法国国际广播电台","title":"法国参议院选举，极右翼国民联盟寻求首次在参院组建党团","content":"法国约60个省份的选举人团成员今天周日开始参加参议院选举投票。被称为极右翼的法国第一大党“国民联盟”（Rassemblementnational）正寻求打破传统右翼阵营对参议院的长期把持，争取在参院组党团。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260927-%E6%B3%95%E5%9B%BD%E5%8F%82%E8%AE%AE%E9%99%A2%E9%80%89%E4%B8%BE%EF%BC%8C%E6%9E%81%E5%8F%B3%E7%BF%BC%E5%9B%BD%E6%B0%91%E8%81%94%E7%9B%9F%E5%AF%BB%E6%B1%82%E9%A6%96%E6%AC%A1%E5%9C%A8%E5%8F%82%E9%99%A2%E7%BB%84%E5%BB%BA%E5%85%9A%E5%9B%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790514108000.webp","sourceId":"rfi"},{"id":1790513151000,"createdDate":"2026-09-27 12:45","name":"法国国际广播电台","title":"在特朗普拒绝后 伊朗坚持其重开霍尔木兹海峡条件","content":"伊朗周日表示仍坚持其重开战略要地霍尔木兹海峡的条件，尽管美国总统·特朗普拒绝了伊朗的相关计划。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260927-%E5%9C%A8%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%92%E7%BB%9D%E5%90%8E-%E4%BC%8A%E6%9C%97%E5%9D%9A%E6%8C%81%E5%85%B6%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790513151000.webp","sourceId":"rfi"},{"id":1790512144000,"createdDate":"2026-09-27 12:29","name":"法国国际广播电台","title":"教皇良十四世在朝圣地卢尔德举行大弥撒并会见教会性暴力受害者","content":"教皇良十四世在巴黎停留两天吸引超过百万民众后，今天周日前往法国西南部接纳病患的朝圣地卢尔德。他鼓励法国主教们“继续”采取行动，应对教会内针对未成年人性犯罪这一“令人痛心的祸患”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260927-%E6%95%99%E7%9A%87%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%9C%A8%E6%9C%9D%E5%9C%A3%E5%9C%B0%E5%8D%A2%E5%B0%94%E5%BE%B7%E4%B8%BE%E8%A1%8C%E5%A4%A7%E5%BC%A5%E6%92%92%E5%B9%B6%E4%BC%9A%E8%A7%81%E6%95%99%E4%BC%9A%E6%80%A7%E6%9A%B4%E5%8A%9B%E5%8F%97%E5%AE%B3%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790512144000.webp","sourceId":"rfi"},{"id":1790511163000,"createdDate":"2026-09-27 12:12","name":"法国国际广播电台","title":"台湾问题：特朗普冷处理，习近平亦搁置？","content":"特习会结束后，据路透社报道，台湾外交部次长陈明祺星期天（9月27日）在中华亚太菁英交流协会举办的「習近平訪美後的美中台新局」座谈会上称，美国对台的政策一直不变，并强调美国已了解台湾所面临的情势以及对于国防投资的决心。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260927-%E5%8F%B0%E6%B9%BE%E9%97%AE%E9%A2%98-%E7%89%B9%E6%9C%97%E6%99%AE%E5%86%B7%E5%A4%84%E7%90%86%EF%BC%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BA%A6%E6%90%81%E7%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790511163000.webp","sourceId":"rfi"},{"id":1790510750000,"createdDate":"2026-09-27 12:05","name":"法国国际广播电台","title":"《世界报》: 亚洲疑美论抬头，日本成地缘政治重组核心","content":"周末版法国《世界报》头版两大凸出主题分别是法国宣布向沙特阿拉伯派出军队和军备的决定，以及天主教教皇良十四世在万众簇拥下在法国各地的访问。该报关注的其它主题有：即将举行总统大选的巴西两位主要候选人伯仲难分的胶着状态、加沙走廊医疗卫生系统在以色列军队的封锁下的困境、前苏联加盟共和国格鲁吉亚重新与欧洲渐行渐远的趋势、国际刑事法院当前面对的存亡危机等等。该报今天没有关于中国的特别报道，但地缘政治专栏今天特别聚焦美国总统特朗普任下，亚洲地区地缘政治格局的重组。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260927-%E4%B8%96%E7%95%8C%E6%8A%A5-%E4%BA%9A%E6%B4%B2%E7%96%91%E7%BE%8E%E8%AE%BA%E6%8A%AC%E5%A4%B4%EF%BC%8C%E6%97%A5%E6%9C%AC%E6%88%90%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E9%87%8D%E7%BB%84%E6%A0%B8%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790510750000.webp","sourceId":"rfi"},{"id":1790499270000,"createdDate":"2026-09-27 08:54","name":"法国国际广播电台","title":"旅法藏人27日巴黎集会游行，呼吁保护藏文化，抵制强制汉化","content":"旅居法国的藏人团体27日下午在巴黎市中心举行游行活动，呼吁保护藏文化，抵制《民族团结进步法》强行推动的汉化进程。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260927-%E6%97%85%E6%B3%95%E8%97%8F%E4%BA%BA27%E6%97%A5%E5%B7%B4%E9%BB%8E%E9%9B%86%E4%BC%9A%E6%B8%B8%E8%A1%8C%EF%BC%8C%E5%91%BC%E5%90%81%E4%BF%9D%E6%8A%A4%E8%97%8F%E6%96%87%E5%8C%96%EF%BC%8C%E6%8A%B5%E5%88%B6%E5%BC%BA%E5%88%B6%E6%B1%89%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790499270000.webp","sourceId":"rfi"},{"id":1790496089000,"createdDate":"2026-09-27 08:01","name":"法国国际广播电台","title":"两只大熊猫启程前往亚特兰大动物园 中国与美恢复“熊猫外交”","content":"法新社北京消息，据中国官媒报道，在华盛顿举行了一场充满象征意义但缺乏重大突破的美中元首峰会后，中国于周日（9月27日）向美国送去了两只大熊猫。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260927-%E4%B8%A4%E5%8F%AA%E5%A4%A7%E7%86%8A%E7%8C%AB%E5%90%AF%E7%A8%8B%E5%89%8D%E5%BE%80%E4%BA%9A%E7%89%B9%E5%85%B0%E5%A4%A7%E5%8A%A8%E7%89%A9%E5%9B%AD-%E4%B8%AD%E5%9B%BD%E4%B8%8E%E7%BE%8E%E6%81%A2%E5%A4%8D-%E7%86%8A%E7%8C%AB%E5%A4%96%E4%BA%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790496089000.webp","sourceId":"rfi"},{"id":1790495022000,"createdDate":"2026-09-27 07:43","name":"法国国际广播电台","title":"日美首脑举行电话会谈","content":"9月26日，从日本时间晚上9时开始，日本首相高市早苗与美国总统特朗普举行了约20分钟的电话会谈。会谈开始时，特朗普总统详细介绍了此次中美首脑会谈的情况。双方围绕包括经济安全保障在内的中国相关问题交换了意见，并确认了日美之间的合作。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260927-%E6%97%A5%E7%BE%8E%E9%A6%96%E8%84%91%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/09/27/1790495022000.webp","sourceId":"rfi"}]