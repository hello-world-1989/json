[{"id":1788597275000,"createdDate":"2026-09-05 08:34","name":"法国国际广播电台","title":"以色列空袭黎巴嫩 至少3人死亡23人受伤","content":"黎巴嫩卫生部初步消息显示，以色列军队周五晚间加强了对黎巴嫩的空袭，造成黎巴嫩南部和东部至少3人死亡，23人受伤。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260905-%E4%BB%A5%E8%89%B2%E5%88%97%E7%A9%BA%E8%A2%AD%E9%BB%8E%E5%B7%B4%E5%AB%A9-%E8%87%B3%E5%B0%913%E4%BA%BA%E6%AD%BB%E4%BA%A123%E4%BA%BA%E5%8F%97%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788597275000.webp","sourceId":"rfi"},{"id":1788596968000,"createdDate":"2026-09-05 08:29","name":"法国国际广播电台","title":"日本各界访华掀起“小高潮” 双方释放改善关系信息","content":"最近，日本各界相继访华的消息不断，日中双方似乎正在释放改善关系的信息。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260905-%E6%97%A5%E6%9C%AC%E5%90%84%E7%95%8C%E8%AE%BF%E5%8D%8E%E6%8E%80%E8%B5%B7-%E5%B0%8F%E9%AB%98%E6%BD%AE-%E5%8F%8C%E6%96%B9%E9%87%8A%E6%94%BE%E6%94%B9%E5%96%84%E5%85%B3%E7%B3%BB%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788596968000.webp","sourceId":"rfi"},{"id":1788595631000,"createdDate":"2026-09-05 08:07","name":"法国国际广播电台","title":"中国江西遂川县发生泥石流 导致一人遇难 11人失联","content":"受热带气旋“沙德尔”带来的连日强降雨影响，中国江西遂川县周六（9月5日）凌晨发生泥石流，导致一人死亡，11人失联。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260905-%E4%B8%AD%E5%9B%BD%E6%B1%9F%E8%A5%BF%E9%81%82%E5%B7%9D%E5%8E%BF%E5%8F%91%E7%94%9F%E6%B3%A5%E7%9F%B3%E6%B5%81-%E5%AF%BC%E8%87%B4%E4%B8%80%E4%BA%BA%E9%81%87%E9%9A%BE-11%E4%BA%BA%E5%A4%B1%E8%81%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788595631000.webp","sourceId":"rfi"},{"id":1788632332000,"createdDate":"2026-09-05 18:18","name":"法国国际广播电台","title":"法国外长驳斥尼日尔臆念之辞","content":"在非洲内陆国尼日尔,继08月29日未遂兵变一周后，军政府在昨天（2026年9月4日星期五）召开兵变后的首次内阁会议时再次指责法国卷入其中。对此，法国外长巴罗（Jean-NoëlBarrot）在接受本台（RFI）法国国际广播电台法语节目[国际大咖嘉宾]节目（Legrandinvitéinternational）专栏记者采访时驳斥说，这一指责纯属臆念（depuresfantaisies ）。尼日尔的中文也有译作尼日共和国（leNiger）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260905-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E6%B3%95%E5%9B%BD%E5%A4%96%E9%95%BF%E9%A9%B3%E6%96%A5%E5%B0%BC%E6%97%A5%E5%B0%94%E8%87%86%E5%BF%B5%E4%B9%8B%E8%BE%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788632332000.webp","sourceId":"rfi"},{"id":1788627534000,"createdDate":"2026-09-05 16:58","name":"法国国际广播电台","title":"面临逮捕令：菲律宾副总统杜特尔特前往法院缴纳了保释金","content":"菲律宾副总统萨拉·杜特尔特周六在马尼拉一家法院缴纳了保释金，此前一天，法院对她签发了逮捕令，因她对总统费迪南德·马科斯、其夫人及一名前议员发出死亡威胁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E9%9D%A2%E4%B8%B4%E9%80%AE%E6%8D%95%E4%BB%A4-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%89%AF%E6%80%BB%E7%BB%9F%E6%9D%9C%E7%89%B9%E5%B0%94%E7%89%B9%E5%89%8D%E5%BE%80%E6%B3%95%E9%99%A2%E7%BC%B4%E7%BA%B3%E4%BA%86%E4%BF%9D%E9%87%8A%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788627534000.webp","sourceId":"rfi"},{"id":1788626343000,"createdDate":"2026-09-05 16:39","name":"法国国际广播电台","title":"美中商业委员会代表团访北京　为特习会铺路","content":"美中商业关系在关税、贸易失衡及地缘政治议题等多重压力下，美国主要企业高层代表近日赴北京，与中国国务院总理李强等高级官员会面，讨论美国企业在中国的营商环境及双边经贸关系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E7%BE%8E%E4%B8%AD%E5%95%86%E4%B8%9A%E5%A7%94%E5%91%98%E4%BC%9A%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8C%97%E4%BA%AC-%E4%B8%BA%E7%89%B9%E4%B9%A0%E4%BC%9A%E9%93%BA%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788626343000.webp","sourceId":"rfi"},{"id":1788624397000,"createdDate":"2026-09-05 16:06","name":"法国国际广播电台","title":"柬埔寨军队将于明年恢复与美国联合军演","content":"柬埔寨军方周五宣布，在暂停近十年后，将于明年初恢复与美国的联合军事演习。柬埔寨在2017年停止了与美国的此类联合军演。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E6%9F%AC%E5%9F%94%E5%AF%A8%E5%86%9B%E9%98%9F%E5%B0%86%E4%BA%8E%E6%98%8E%E5%B9%B4%E6%81%A2%E5%A4%8D%E4%B8%8E%E7%BE%8E%E5%9B%BD%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788624397000.webp","sourceId":"rfi"},{"id":1788622401000,"createdDate":"2026-09-05 15:33","name":"法国国际广播电台","title":"德国东部1州议会选举 民调显示反移民的“选择党”可能赢","content":"德国萨克森-安哈尔特州议会选举明9月6日周日投票。据法新社报道，该州选民可能在周日让反移民的极右翼政党“德国选择党”（AfD）赢得胜利。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E5%BE%B7%E5%9B%BD%E4%B8%9C%E9%83%A81%E5%B7%9E%E8%AE%AE%E4%BC%9A%E9%80%89%E4%B8%BE-%E6%B0%91%E8%B0%83%E6%98%BE%E7%A4%BA%E5%8F%8D%E7%A7%BB%E6%B0%91%E7%9A%84-%E9%80%89%E6%8B%A9%E5%85%9A-%E5%8F%AF%E8%83%BD%E8%B5%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788622401000.webp","sourceId":"rfi"},{"id":1788620243000,"createdDate":"2026-09-05 14:57","name":"法国国际广播电台","title":"特朗普特使到访前 基辅机场遭莫斯科轰炸","content":"乌克兰总统泽连斯基谴责俄罗斯在周五至周六夜间对基辅两座机场发动的空袭，认为此举意在干扰美国总统唐纳德·特朗普的特使访问基辅。美方特使已在周六抵达莫斯科。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E5%9C%A8%E7%89%B9%E6%9C%97%E6%99%AE%E7%89%B9%E4%BD%BF%E5%88%B0%E8%AE%BF%E5%89%8D%EF%BC%8C%E5%9F%BA%E8%BE%85%E6%9C%BA%E5%9C%BA%E9%81%AD%E8%8E%AB%E6%96%AF%E7%A7%91%E8%BD%B0%E7%82%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788620243000.webp","sourceId":"rfi"},{"id":1788618296000,"createdDate":"2026-09-05 14:24","name":"法国国际广播电台","title":"波斯湾哈尔格岛附近发生爆炸 美军称袭击了3艘伊朗油轮","content":"伊朗媒体报道称，周六在哈尔格岛附近听到了“多次爆炸声”，该岛是伊朗在波斯湾的主要石油终端码头所在地。美军随后宣布，在伊朗袭击两艘美军战舰后，美中央司令部击沉3艘伊朗革命卫队油轮。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E6%B3%A2%E6%96%AF%E6%B9%BE%E5%93%88%E5%B0%94%E6%A0%BC%E5%B2%9B%E9%99%84%E8%BF%91%E5%8F%91%E7%94%9F%E7%88%86%E7%82%B8-%E7%BE%8E%E5%86%9B%E7%A7%B0%E8%A2%AD%E5%87%BB%E4%BA%863%E8%89%98%E4%BC%8A%E6%9C%97%E6%B2%B9%E8%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788618296000.webp","sourceId":"rfi"},{"id":1788613912000,"createdDate":"2026-09-05 13:11","name":"法国国际广播电台","title":"喜马拉雅洪灾 尼泊尔灾区一名中国籍男子和一名妇女获救","content":"喜马拉雅洪灾：周六，救援人员成功从尼泊尔北部被掩埋的隧道中救出第三名幸存者，是一名中国公民。自8月26日喜马拉雅致命洪灾发生以来，救援人员一直不间断地在这些隧道中搜救。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E6%B4%AA%E7%81%BE-%E5%B0%BC%E6%B3%8A%E5%B0%94%E7%81%BE%E5%8C%BA%E4%B8%80%E5%90%8D%E4%B8%AD%E5%9B%BD%E7%B1%8D%E7%94%B7%E5%AD%90%E5%92%8C%E4%B8%80%E5%90%8D%E5%A6%87%E5%A5%B3%E8%8E%B7%E6%95%91","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788613912000.webp","sourceId":"rfi"},{"id":1788611361000,"createdDate":"2026-09-05 12:29","name":"法国国际广播电台","title":"移民：丹麦等欧盟五国推境外设立“遣返中心” 最早明年或可启用","content":"欧盟是否很快在欧盟之外建立首个移民“遣返中心”？本周五（9月5日），五个欧盟成员国丹麦、奥地利、德国、荷兰和希腊在哥本哈根举行会议，就设立此类中心迈出第一步，五国计划与欧盟以外的第三国展开协商，将部分寻求庇护被拒、但暂时无法返回原籍国的移民安置在当地，计划最快于明年开始实施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260905-%E7%A7%BB%E6%B0%91-%E6%AC%A7%E7%9B%9F%E4%BA%94%E5%9B%BD%E5%8A%9B%E6%8E%A8%E5%A2%83%E5%A4%96%E8%AE%BE%E7%AB%8B-%E9%81%A3%E8%BF%94%E4%B8%AD%E5%BF%83-%E6%9C%80%E6%97%A9%E6%98%8E%E5%B9%B4%E5%90%AF%E7%94%A8-1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788611361000.webp","sourceId":"rfi"},{"id":1788647036000,"createdDate":"2026-09-05 22:23","name":"法国国际广播电台","title":"美特使与普京长谈3小时10分钟: 谈停战, 谈合作, 承诺把俄方主张带到基辅, 俄乌“三日不袭首都”","content":"9月5日星期六，俄罗斯总统普京在克里姆林宫会见了到访的美国总统特使史蒂夫·维特科夫和贾里德·库什纳，会谈持续了3小时10分钟。二人将在次日造访乌克兰首都基辅。俄方在俄美会谈后指出，本次会面，双方并未局限于谈乌克兰战争，还详细讨论了经济话题，以及双边大型互惠互利的项目。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260905-%E7%BE%8E%E7%89%B9%E4%BD%BF%E4%B8%8E%E6%99%AE%E4%BA%AC%E9%95%BF%E8%B0%883%E5%B0%8F%E6%97%B610%E5%88%86%E9%92%9F-%E8%B0%88%E5%81%9C%E6%88%98-%E8%B0%88%E5%90%88%E4%BD%9C-%E6%89%BF%E8%AF%BA%E6%8A%8A%E4%BF%84%E6%96%B9%E4%B8%BB%E5%BC%A0%E5%B8%A6%E5%88%B0%E5%9F%BA%E8%BE%85-%E4%BF%84%E4%B9%8C-%E4%B8%89%E6%97%A5%E4%B8%8D%E8%A2%AD%E9%A6%96%E9%83%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788647036000.webp","sourceId":"rfi"},{"id":1788643730000,"createdDate":"2026-09-05 21:28","name":"法国国际广播电台","title":"埃博拉:染疫医务人员近30%殉职","content":"在非洲国家刚果民主共和国（laRDCongo），埃博拉疫情（Ebola）现已导致3072人死亡，累计确诊病例高达6342宗。这是本台法广非洲组（RFIAfrique）今天2026年09月05日星期六法文报导有关非洲的关注焦点之一。自疫情爆发以来，至少已有45名医务人员因染疫殉职，占感染医护人员总数近30%。在金沙萨（Kinshasa），刚果(金)政府于昨天09月04日星期五启动一项新的应对计划，目标旨在遏制本迪布焦型（Bundibugyo）病毒的传播，尤其是要致力于减少与第17轮疫情相关的死亡人数。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260905-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%9F%83%E5%8D%9A%E6%8B%89-%E6%9F%93%E7%96%AB%E5%8C%BB%E5%8A%A1%E4%BA%BA%E5%91%98%E8%BF%9130-%E6%AE%89%E8%81%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788643730000.webp","sourceId":"rfi"},{"id":1788643564000,"createdDate":"2026-09-05 21:26","name":"法国国际广播电台","title":"约旦河西岸以色列定居者打死巴勒斯坦裔美国人，美大使谴责“恐怖行径”","content":"9月5日星期六，美国驻以色列大使麦克·哈卡比访问约旦河西岸土尔姆斯·阿亚村，公开谴责以色列定居者对巴勒斯坦人制造的暴力，将相关暴力行为称为“犯罪”和“恐怖行径”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260905-%E7%BA%A6%E6%97%A6%E6%B2%B3%E8%A5%BF%E5%B2%B8%E4%BB%A5%E8%89%B2%E5%88%97%E5%AE%9A%E5%B1%85%E8%80%85%E6%89%93%E6%AD%BB%E5%B7%B4%E5%8B%92%E6%96%AF%E5%9D%A6%E8%A3%94%E7%BE%8E%E5%9B%BD%E4%BA%BA%EF%BC%8C%E7%BE%8E%E5%A4%A7%E4%BD%BF%E8%B0%B4%E8%B4%A3-%E6%81%90%E6%80%96%E8%A1%8C%E5%BE%84","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788643564000.webp","sourceId":"rfi"},{"id":1788643552000,"createdDate":"2026-09-05 21:25","name":"法国国际广播电台","title":"欧洲五国拟与第三国签署协议 在欧盟境外设立移民遣返中心","content":"德国、奥地利、希腊、丹麦和荷兰周五（9月4日）表示，计划今年与欧盟以外的第三国签署协议，将没有合法居留身份的移民送往设在欧盟境外的遣返中心。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260905-%E6%AC%A7%E6%B4%B2%E4%BA%94%E5%9B%BD%E6%8B%9F%E4%B8%8E%E7%AC%AC%E4%B8%89%E5%9B%BD%E7%AD%BE%E7%BD%B2%E5%8D%8F%E8%AE%AE-%E5%9C%A8%E6%AC%A7%E7%9B%9F%E5%A2%83%E5%A4%96%E8%AE%BE%E7%AB%8B%E7%A7%BB%E6%B0%91%E9%81%A3%E8%BF%94%E4%B8%AD%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788643552000.webp","sourceId":"rfi"},{"id":1788643381000,"createdDate":"2026-09-05 21:23","name":"法国国际广播电台","title":"援乌立场与英法移民协议引争议: 法国极右翼遭各方围攻","content":"法国极右翼国民联盟近日因援乌和移民政策接连遭到批评：该党高层先是提出，如果上台可能中断对乌克兰的财政援助；党主席巴尔德拉随后又与英国改革党领袖法拉奇签署一份涉及将移民遣返法国的象征性备忘录。法国各派政治对手借此指责国民联盟在国际事务上立场矛盾。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260905-%E6%8F%B4%E4%B9%8C%E7%AB%8B%E5%9C%BA%E4%B8%8E%E8%8B%B1%E6%B3%95%E7%A7%BB%E6%B0%91%E5%8D%8F%E8%AE%AE%E5%BC%95%E4%BA%89%E8%AE%AE-%E6%B3%95%E5%9B%BD%E6%9E%81%E5%8F%B3%E7%BF%BC%E9%81%AD%E5%90%84%E6%96%B9%E5%9B%B4%E6%94%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788643381000.webp","sourceId":"rfi"},{"id":1788643033000,"createdDate":"2026-09-05 21:17","name":"法国国际广播电台","title":"美军打击三艘伊朗油轮 伊朗警告将对美国军舰发动更猛烈打击","content":"伊朗军方周六（9月5日）警告：如果美国继续袭击及骚扰伊朗船只，并维持对伊朗的海上封锁，伊朗将对地区内的美国军舰发动“比以往更强硬”的打击，行动范围也可能进一步扩大。此前，美军宣布在海湾地区打击三艘伊朗油轮。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260905-%E7%BE%8E%E5%86%9B%E6%89%93%E5%87%BB%E4%B8%89%E8%89%98%E4%BC%8A%E6%9C%97%E6%B2%B9%E8%BD%AE-%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E5%B0%86%E5%AF%B9%E7%BE%8E%E5%9B%BD%E5%86%9B%E8%88%B0%E5%8F%91%E5%8A%A8%E6%9B%B4%E7%8C%9B%E7%83%88%E6%89%93%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788643033000.webp","sourceId":"rfi"},{"id":1788642783000,"createdDate":"2026-09-05 21:13","name":"法国国际广播电台","title":"美国特使会晤普京磋商俄乌停战 拟于6日访问基辅","content":"俄罗斯总统普京周六（9月5日）在莫斯科会晤美国总统特朗普的两名特使史蒂夫·威特科夫和贾里德·库什纳。特朗普此前表示，两名特使此行向俄方转交一项旨在结束乌克兰战争的方案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260905-%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF%E4%BC%9A%E6%99%A4%E6%99%AE%E4%BA%AC%E7%A3%8B%E5%95%86%E4%BF%84%E4%B9%8C%E5%81%9C%E6%88%98-%E6%8B%9F%E4%BA%8E6%E6%97%A5%E8%AE%BF%E9%97%AE%E5%9F%BA%E8%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/05/1788642783000.webp","sourceId":"rfi"}]