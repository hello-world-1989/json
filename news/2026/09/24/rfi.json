[{"id":1790256475000,"createdDate":"2026-09-24 13:27","name":"法国国际广播电台","title":"习近平访美：争取小幅进展，避免破裂冲突","content":"9月24日，美国总统特朗普和中国国家主席习近平在华盛顿举行会谈。习近平已经在前一日抵达华盛顿。两人会面前，中国国防部表示，美国应该在任何向台湾出售武器的行为上极度慎重，中美两国军事关系应当保持稳定、健康和可持续。中国国防部再次强调，台湾问题是中美关系当中，最重要的问题，维护台海和平稳定，是中美两国最大的共同议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260924-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E-%E4%BA%89%E5%8F%96%E5%B0%8F%E5%B9%85%E8%BF%9B%E5%B1%95%EF%BC%8C%E9%81%BF%E5%85%8D%E7%A0%B4%E8%A3%82%E4%B8%8E%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790256475000.webp","sourceId":"rfi"},{"id":1790253733000,"createdDate":"2026-09-24 12:42","name":"法国国际广播电台","title":"F-35敏感零部件从澳洲返美途中在韩国降落离奇改飞香港被中国扣押","content":"据海峡时报24日报道，知情人士透露，中国政府已扣押了一批可能属于敏感物资的F-35隐形战机部件；这批部件原定从澳大利亚运往美国，却在途中从韩国离奇转运至香港。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-f-35%E6%95%8F%E6%84%9F%E9%9B%B6%E9%83%A8%E4%BB%B6%E4%BB%8E%E6%BE%B3%E6%B4%B2%E8%BF%94%E7%BE%8E%E9%80%94%E4%B8%AD%E5%9C%A8%E9%9F%A9%E5%9B%BD%E9%99%8D%E8%90%BD%E7%A6%BB%E5%A5%87%E6%94%B9%E9%A3%9E%E9%A6%99%E6%B8%AF%E8%A2%AB%E4%B8%AD%E5%9B%BD%E6%89%A3%E6%8A%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790253733000.webp","sourceId":"rfi"},{"id":1790250585000,"createdDate":"2026-09-24 11:49","name":"法国国际广播电台","title":"习近平受到特朗普空前盛大礼遇迎接 表示中美应成为“伙伴而非对手”","content":"据法新社周四报道，中国国家主席习近平呼吁与华盛顿开展合作。此前数小时，他于周三晚间在美国首都受到美国总统唐纳德·特朗普的空前盛大礼遇迎接。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8F%97%E5%88%B0%E7%89%B9%E6%9C%97%E6%99%AE%E7%A9%BA%E5%89%8D%E7%9B%9B%E5%A4%A7%E7%A4%BC%E9%81%87%E8%BF%8E%E6%8E%A5-%E8%A1%A8%E7%A4%BA%E4%B8%AD%E7%BE%8E%E5%BA%94%E6%88%90%E4%B8%BA-%E4%BC%99%E4%BC%B4%E8%80%8C%E9%9D%9E%E5%AF%B9%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790250585000.webp","sourceId":"rfi"},{"id":1790246695000,"createdDate":"2026-09-24 10:44","name":"法国国际广播电台","title":"泽连斯基联大发言抨击普京 呼吁继续制裁","content":"乌克兰总统泽连斯基周三在联合国大会上发表讲话，抨击普京发动战争，并强调继续对俄罗斯实施制裁措施的必要。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260924-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%81%94%E5%A4%A7%E5%8F%91%E8%A8%80%E6%8A%A8%E5%87%BB%E6%99%AE%E4%BA%AC-%E5%91%BC%E5%90%81%E7%BB%A7%E7%BB%AD%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790246695000.webp","sourceId":"rfi"},{"id":1790240257000,"createdDate":"2026-09-24 08:57","name":"法国国际广播电台","title":"两名朝鲜战俘已从乌克兰抵达韩国","content":"9月23日星期三，乌克兰总统泽连斯基在联大发表讲话时表示，乌克兰已经将两名朝鲜战俘移交给了韩国。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%B8%A4%E5%90%8D%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BF%98%E9%80%81%E5%B7%B2%E4%BB%8E%E4%B9%8C%E5%85%8B%E5%85%B0%E6%8A%B5%E8%BE%BE%E9%9F%A9%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790240257000.webp","sourceId":"rfi"},{"id":1790233795000,"createdDate":"2026-09-24 07:09","name":"法国国际广播电台","title":"日本首相在联合国呼吁删除“敌国条款” 中国外交部反对","content":"日本首相高市早苗当地时间22日在美国纽约举行的联合国大会演讲中主张，应尽快删除针对第二次世界大战战败国的《联合国宪章》“敌国条款”。中国外交部发言人郭嘉昆23日在例行记者会上答问时表示，当年日本以承认军国主义罪行、接受《联合国宪章》全部内容为前提加入联合国。《联合国宪章》中的“敌国条款”是重要制度安排，旨在防止法西斯主义、军国主义再度对国际和平与安全构成威胁，为捍卫战后国际秩序提供了重要制度保障，时至今日仍然具有重要现实意义。中方敦促日方以史为鉴、深刻反省，以实际行动取信于亚洲邻国和国际社会。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E5%9C%A8%E8%81%94%E5%90%88%E5%9B%BD%E5%91%BC%E5%90%81%E5%88%A0%E9%99%A4-%E6%95%8C%E5%9B%BD%E6%9D%A1%E6%AC%BE-%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%8D%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790233795000.webp","sourceId":"rfi"},{"id":1790233191000,"createdDate":"2026-09-24 06:59","name":"法国国际广播电台","title":"海外港人民调：逾六成不信香港主流媒体 九成四指媒体偏向政府","content":"在海外成立的「海内外香港人民意研究计划」有关传媒可信度的调查发现，62%受访的海内外港人不满香港主流媒体的表现，大部分人均认为，香港主流媒体有自我审查和偏向政府，没有发挥言论自由。相较之下，逾八成受访者认为，海外港人媒体较香港主流媒体可信。海外香港传媒组织认为，调查结果反映港人对媒体有要求，希望媒体和新闻工作者能以独立和全面的角度报道香港和国际的情况，但香港主流媒体未能反映社会实况，表现令人失望。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E6%B5%B7%E5%A4%96%E6%B8%AF%E4%BA%BA%E6%B0%91%E8%B0%83-%E9%80%BE%E5%85%AD%E6%88%90%E4%B8%8D%E4%BF%A1%E9%A6%99%E6%B8%AF%E4%B8%BB%E6%B5%81%E5%AA%92%E4%BD%93-%E4%B9%9D%E6%88%90%E5%9B%9B%E6%8C%87%E5%AA%92%E4%BD%93%E5%81%8F%E5%90%91%E6%94%BF%E5%BA%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790233191000.webp","sourceId":"rfi"},{"id":1790232637000,"createdDate":"2026-09-24 06:50","name":"法国国际广播电台","title":"习特会举行在即 「拯救黎智英」再成焦点　黎崇恩及多个团体促放人","content":"中国国家主席习近平已抵达美国，展开三日国事访问，并在美国时间今(24日)早与总统特朗普举行峰会。在中美元首会面前夕，被香港法庭重判的《苹果日报》创办人黎智英，其儿子黎崇恩再次呼吁特朗普协助营救父亲；美国政界与新闻及人权团体均促请特习会应优先讨论释放黎智英等政治犯的议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E4%B9%A0%E7%89%B9%E4%BC%9A%E4%B8%BE%E8%A1%8C%E5%9C%A8%E5%8D%B3-%E6%8B%AF%E6%95%91%E9%BB%8E%E6%99%BA%E8%8B%B1-%E5%86%8D%E6%88%90%E7%84%A6%E7%82%B9-%E9%BB%8E%E5%B4%87%E6%81%A9%E5%8F%8A%E5%A4%9A%E4%B8%AA%E5%9B%A2%E4%BD%93%E4%BF%83%E6%94%BE%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790232637000.webp","sourceId":"rfi"}]