[{"id":1790256475000,"createdDate":"2026-09-24 13:27","name":"法国国际广播电台","title":"习近平访美：争取小幅进展，避免破裂冲突","content":"9月24日，美国总统特朗普和中国国家主席习近平在华盛顿举行会谈。习近平已经在前一日抵达华盛顿。两人会面前，中国国防部表示，美国应该在任何向台湾出售武器的行为上极度慎重，中美两国军事关系应当保持稳定、健康和可持续。中国国防部再次强调，台湾问题是中美关系当中，最重要的问题，维护台海和平稳定，是中美两国最大的共同议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260924-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E-%E4%BA%89%E5%8F%96%E5%B0%8F%E5%B9%85%E8%BF%9B%E5%B1%95%EF%BC%8C%E9%81%BF%E5%85%8D%E7%A0%B4%E8%A3%82%E4%B8%8E%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790256475000.webp","sourceId":"rfi"},{"id":1790253733000,"createdDate":"2026-09-24 12:42","name":"法国国际广播电台","title":"F-35敏感零部件从澳洲返美途中在韩国降落离奇改飞香港被中国扣押","content":"据海峡时报24日报道，知情人士透露，中国政府已扣押了一批可能属于敏感物资的F-35隐形战机部件；这批部件原定从澳大利亚运往美国，却在途中从韩国离奇转运至香港。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-f-35%E6%95%8F%E6%84%9F%E9%9B%B6%E9%83%A8%E4%BB%B6%E4%BB%8E%E6%BE%B3%E6%B4%B2%E8%BF%94%E7%BE%8E%E9%80%94%E4%B8%AD%E5%9C%A8%E9%9F%A9%E5%9B%BD%E9%99%8D%E8%90%BD%E7%A6%BB%E5%A5%87%E6%94%B9%E9%A3%9E%E9%A6%99%E6%B8%AF%E8%A2%AB%E4%B8%AD%E5%9B%BD%E6%89%A3%E6%8A%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790253733000.webp","sourceId":"rfi"},{"id":1790250585000,"createdDate":"2026-09-24 11:49","name":"法国国际广播电台","title":"习近平受到特朗普空前盛大礼遇迎接 表示中美应成为“伙伴而非对手”","content":"据法新社周四报道，中国国家主席习近平呼吁与华盛顿开展合作。此前数小时，他于周三晚间在美国首都受到美国总统唐纳德·特朗普的空前盛大礼遇迎接。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8F%97%E5%88%B0%E7%89%B9%E6%9C%97%E6%99%AE%E7%A9%BA%E5%89%8D%E7%9B%9B%E5%A4%A7%E7%A4%BC%E9%81%87%E8%BF%8E%E6%8E%A5-%E8%A1%A8%E7%A4%BA%E4%B8%AD%E7%BE%8E%E5%BA%94%E6%88%90%E4%B8%BA-%E4%BC%99%E4%BC%B4%E8%80%8C%E9%9D%9E%E5%AF%B9%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790250585000.webp","sourceId":"rfi"},{"id":1790246695000,"createdDate":"2026-09-24 10:44","name":"法国国际广播电台","title":"泽连斯基联大发言抨击普京 呼吁继续制裁","content":"乌克兰总统泽连斯基周三在联合国大会上发表讲话，抨击普京发动战争，并强调继续对俄罗斯实施制裁措施的必要。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260924-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%81%94%E5%A4%A7%E5%8F%91%E8%A8%80%E6%8A%A8%E5%87%BB%E6%99%AE%E4%BA%AC-%E5%91%BC%E5%90%81%E7%BB%A7%E7%BB%AD%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790246695000.webp","sourceId":"rfi"},{"id":1790240257000,"createdDate":"2026-09-24 08:57","name":"法国国际广播电台","title":"两名朝鲜战俘已从乌克兰抵达韩国","content":"9月23日星期三，乌克兰总统泽连斯基在联大发表讲话时表示，乌克兰已经将两名朝鲜战俘移交给了韩国。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%B8%A4%E5%90%8D%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BF%98%E9%80%81%E5%B7%B2%E4%BB%8E%E4%B9%8C%E5%85%8B%E5%85%B0%E6%8A%B5%E8%BE%BE%E9%9F%A9%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790240257000.webp","sourceId":"rfi"},{"id":1790233795000,"createdDate":"2026-09-24 07:09","name":"法国国际广播电台","title":"日本首相在联合国呼吁删除“敌国条款” 中国外交部反对","content":"日本首相高市早苗当地时间22日在美国纽约举行的联合国大会演讲中主张，应尽快删除针对第二次世界大战战败国的《联合国宪章》“敌国条款”。中国外交部发言人郭嘉昆23日在例行记者会上答问时表示，当年日本以承认军国主义罪行、接受《联合国宪章》全部内容为前提加入联合国。《联合国宪章》中的“敌国条款”是重要制度安排，旨在防止法西斯主义、军国主义再度对国际和平与安全构成威胁，为捍卫战后国际秩序提供了重要制度保障，时至今日仍然具有重要现实意义。中方敦促日方以史为鉴、深刻反省，以实际行动取信于亚洲邻国和国际社会。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E5%9C%A8%E8%81%94%E5%90%88%E5%9B%BD%E5%91%BC%E5%90%81%E5%88%A0%E9%99%A4-%E6%95%8C%E5%9B%BD%E6%9D%A1%E6%AC%BE-%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%8D%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790233795000.webp","sourceId":"rfi"},{"id":1790233191000,"createdDate":"2026-09-24 06:59","name":"法国国际广播电台","title":"海外港人民调：逾六成不信香港主流媒体 九成四指媒体偏向政府","content":"在海外成立的「海内外香港人民意研究计划」有关传媒可信度的调查发现，62%受访的海内外港人不满香港主流媒体的表现，大部分人均认为，香港主流媒体有自我审查和偏向政府，没有发挥言论自由。相较之下，逾八成受访者认为，海外港人媒体较香港主流媒体可信。海外香港传媒组织认为，调查结果反映港人对媒体有要求，希望媒体和新闻工作者能以独立和全面的角度报道香港和国际的情况，但香港主流媒体未能反映社会实况，表现令人失望。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E6%B5%B7%E5%A4%96%E6%B8%AF%E4%BA%BA%E6%B0%91%E8%B0%83-%E9%80%BE%E5%85%AD%E6%88%90%E4%B8%8D%E4%BF%A1%E9%A6%99%E6%B8%AF%E4%B8%BB%E6%B5%81%E5%AA%92%E4%BD%93-%E4%B9%9D%E6%88%90%E5%9B%9B%E6%8C%87%E5%AA%92%E4%BD%93%E5%81%8F%E5%90%91%E6%94%BF%E5%BA%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790233191000.webp","sourceId":"rfi"},{"id":1790232637000,"createdDate":"2026-09-24 06:50","name":"法国国际广播电台","title":"习特会举行在即 「拯救黎智英」再成焦点　黎崇恩及多个团体促放人","content":"中国国家主席习近平已抵达美国，展开三日国事访问，并在美国时间今(24日)早与总统特朗普举行峰会。在中美元首会面前夕，被香港法庭重判的《苹果日报》创办人黎智英，其儿子黎崇恩再次呼吁特朗普协助营救父亲；美国政界与新闻及人权团体均促请特习会应优先讨论释放黎智英等政治犯的议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E4%B9%A0%E7%89%B9%E4%BC%9A%E4%B8%BE%E8%A1%8C%E5%9C%A8%E5%8D%B3-%E6%8B%AF%E6%95%91%E9%BB%8E%E6%99%BA%E8%8B%B1-%E5%86%8D%E6%88%90%E7%84%A6%E7%82%B9-%E9%BB%8E%E5%B4%87%E6%81%A9%E5%8F%8A%E5%A4%9A%E4%B8%AA%E5%9B%A2%E4%BD%93%E4%BF%83%E6%94%BE%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790232637000.webp","sourceId":"rfi"},{"id":1790264941000,"createdDate":"2026-09-24 15:49","name":"法国国际广播电台","title":"伊朗航空公司不再获准飞往阿联酋","content":"阿联酋周四暂停了伊朗航空公司的所有航班，以遵守美国针对伊朗航空业的制裁；此前，周三已有前往其他目的地的多趟航班被取消。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%BC%8A%E6%9C%97%E8%88%AA%E7%A9%BA%E5%85%AC%E5%8F%B8%E4%B8%8D%E5%86%8D%E8%8E%B7%E5%87%86%E9%A3%9E%E5%BE%80%E9%98%BF%E8%81%94%E9%85%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790264941000.webp","sourceId":"rfi"},{"id":1790264377000,"createdDate":"2026-09-24 15:39","name":"法国国际广播电台","title":"习特会：中美贸易休战再延期  路透社盘点两国贸易战重要时间线","content":"中国国家主席习近平正在对华盛顿进行为期三天的国事访问，美国总统唐纳德·特朗普于周四（9月24号）在白宫接待习近平夫妇。这是今年世界两大经济体领导人之间的第二次会晤，也是习近平十多年来首次访问华盛顿。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260924-%E4%B9%A0%E7%89%B9%E4%BC%9A-%E4%B8%AD%E7%BE%8E%E8%B4%B8%E6%98%93%E4%BC%91%E6%88%98%E5%86%8D%E5%BB%B6%E6%9C%9F-%E8%B7%AF%E9%80%8F%E7%A4%BE%E7%9B%98%E7%82%B9%E4%B8%AD%E7%BE%8E%E8%B4%B8%E6%98%93%E6%88%98%E9%87%8D%E8%A6%81%E6%97%B6%E9%97%B4%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790264377000.webp","sourceId":"rfi"},{"id":1790261872000,"createdDate":"2026-09-24 14:57","name":"法国国际广播电台","title":"阿里巴巴计划在欧洲和中东扩大AI数据中心规模","content":"中国数字巨头阿里巴巴周三宣布了在海外扩建数据中心的计划，目标市场为欧洲和中东地区。法新社说，阿里巴巴是中国人工智能（AI）领域的先驱之一，其AI模型千问（Qwen）是全球下载量最大的AI模型之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E9%98%BF%E9%87%8C%E5%B7%B4%E5%B7%B4%E8%AE%A1%E5%88%92%E5%9C%A8%E6%AC%A7%E6%B4%B2%E5%92%8C%E4%B8%AD%E4%B8%9C%E6%89%A9%E5%A4%A7ai%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E8%A7%84%E6%A8%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790261872000.webp","sourceId":"rfi"},{"id":1790260493000,"createdDate":"2026-09-24 14:34","name":"法国国际广播电台","title":"日本自民党前外相岩屋毅将于9月27日访华","content":"据共同社消息，日本前外相岩屋毅9月24日在东京出席中国国庆节招待会时透露，他将从27日起访问中国。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E6%97%A5%E6%9C%AC%E8%87%AA%E6%B0%91%E5%85%9A%E5%89%8D%E5%A4%96%E7%9B%B8%E5%B2%A9%E5%B1%8B%E6%AF%85%E5%B0%86%E4%BA%8E9%E6%9C%8827%E6%97%A5%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790260493000.webp","sourceId":"rfi"},{"id":1790259014000,"createdDate":"2026-09-24 14:10","name":"法国国际广播电台","title":"伊朗总统称伊朗是美国“恐怖主义”受害者 其最高领袖顾问称战线可扩至印度洋","content":"伊朗总统周三在联合国大会发表了一篇极具攻击性的演讲，他向唐纳德·特朗普保证，伊朗绝不会“低头”，并称该国是美国“恐怖主义”的受害者。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E7%A7%B0%E4%BC%8A%E6%9C%97%E6%98%AF%E7%BE%8E%E5%9B%BD-%E6%81%90%E6%80%96%E4%B8%BB%E4%B9%89-%E5%8F%97%E5%AE%B3%E8%80%85-%E5%85%B6%E6%9C%80%E9%AB%98%E9%A2%86%E8%A2%96%E9%A1%BE%E9%97%AE%E7%A7%B0%E6%88%98%E7%BA%BF%E5%8F%AF%E6%89%A9%E8%87%B3%E5%8D%B0%E5%BA%A6%E6%B4%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790259014000.webp","sourceId":"rfi"},{"id":1790257930000,"createdDate":"2026-09-24 13:52","name":"法国国际广播电台","title":"世界危机四伏  联合国趋向弱化","content":"近期一系列重要事件正在世界范围内发生，全球眼光聚焦各国领导人出席第81届联合国大会，人们关注俄乌战争、中东冲突到中美元首会晤。面对战争与分裂不断蔓延，自然资源治理与核武战争风险与日俱增，人工智能由造福人类转向未来或将毁灭人类的担忧。联合国秘书长发出的呼吁振聋发聩：不断恶化且濒临危险的世界需要一个强大的联合国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260924-%E4%B8%96%E7%95%8C%E5%8D%B1%E6%9C%BA%E5%9B%9B%E4%BC%8F-%E8%81%94%E5%90%88%E5%9B%BD%E8%B6%8B%E5%90%91%E5%BC%B1%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790257930000.webp","sourceId":"rfi"},{"id":1790257666000,"createdDate":"2026-09-24 13:47","name":"法国国际广播电台","title":"安琪巴黎「自由谈」沙龙孟明论诗纪要与述评――“人在黑夜里为自己点亮一盏灯”","content":"在去岁（2025）复活节樱花盛开之时，我非常荣幸地邀请大家期盼已久的诗人、翻译家孟明先生莅临巴黎「自由谈」沙龙演讲，题目是「什么叫做诗？」","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260924-%E5%AE%89%E7%90%AA%E5%B7%B4%E9%BB%8E-%E8%87%AA%E7%94%B1%E8%B0%88-%E6%B2%99%E9%BE%99%E7%BA%AA%E8%A6%81%E4%B8%8E%E8%BF%B0%E8%AF%84%E2%80%95%E2%80%95-%E4%BA%BA%E5%9C%A8%E9%BB%91%E5%A4%9C%E9%87%8C%E4%B8%BA%E8%87%AA%E5%B7%B1%E7%82%B9%E4%BA%AE%E4%B8%80%E7%9B%8F%E7%81%AF","thumbnail":"","detailImage":"","sourceId":"rfi"},{"id":1790289474000,"createdDate":"2026-09-24 22:37","name":"法国国际广播电台","title":"中美力量对比逆转了，习近平访美获高规格接待","content":"法国世界报周四表示，中国成功地让中美力量对比发生了逆转。最重要的转折点，是关税战。美国原本希望依靠自身优势通过关税战迫使中国让步，但最终却没有达到预期。相反，中国通过承受压力、进行反制，并利用自身掌握的关键筹码，逐渐改变了双方在谈判中的地位。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260924-%E4%B8%AD%E7%BE%8E%E5%8A%9B%E9%87%8F%E5%AF%B9%E6%AF%94%E9%80%86%E8%BD%AC%E4%BA%86%EF%BC%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E%E8%8E%B7%E9%AB%98%E8%A7%84%E6%A0%BC%E6%8E%A5%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790289474000.webp","sourceId":"rfi"},{"id":1790289422000,"createdDate":"2026-09-24 22:37","name":"法国国际广播电台","title":"特习会排场大效果小 重大问题难突破","content":"美国总统特朗普对来访的中国国家主席习近平给予了极高的礼遇，周三晚间极其罕见地与夫人亲自前往安德鲁联合基地接机，周四又在白宫举行盛大欢迎仪式，身着古装的乐队，身着礼服的军人仪仗队，战斗机编队表演，豪华晚宴，在细致而周到的礼仪中间，特朗普与习近平在白宫椭圆形白宫室举行了会谈。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E7%89%B9%E4%B9%A0%E4%BC%9A%E6%8E%92%E5%9C%BA%E5%A4%A7%E6%95%88%E6%9E%9C%E5%B0%8F-%E9%87%8D%E5%A4%A7%E9%97%AE%E9%A2%98%E9%9A%BE%E7%AA%81%E7%A0%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790289422000.webp","sourceId":"rfi"},{"id":1790286602000,"createdDate":"2026-09-24 21:50","name":"法国国际广播电台","title":"两名朝鲜战俘被送去韩国，韩国总统指责乌克兰泄露消息","content":"韩国总统李在明指责乌克兰泄露两名朝鲜战俘被送往韩国一事。2025年，乌克兰军队俘获了两名朝鲜士兵。这两名士兵属于朝鲜派往俄罗斯、协助俄国部队作战的人员。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260924-%E4%B8%A4%E5%90%8D%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BF%98%E8%A2%AB%E9%80%81%E5%8E%BB%E9%9F%A9%E5%9B%BD%EF%BC%8C%E9%9F%A9%E5%9B%BD%E6%80%BB%E7%BB%9F%E6%8C%87%E8%B4%A3%E4%B9%8C%E5%85%8B%E5%85%B0%E6%B3%84%E9%9C%B2%E6%B6%88%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790286602000.webp","sourceId":"rfi"},{"id":1790286330000,"createdDate":"2026-09-24 21:45","name":"法国国际广播电台","title":"法国将向沙特派兵并部署防御系统 保护延布石油设施","content":"法国总统马克龙周四（9月24日）晚间表示，法国将向沙特阿拉伯派遣军事人员，并部署雷达和防御系统，保护位于沙特西部红海沿岸、对其油气出口至关重要的延布石油设施。法国宣布这一决定之际，沙特与也门胡塞武装的冲突再度升级。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E6%B3%95%E5%9B%BD%E5%B0%86%E5%90%91%E6%B2%99%E7%89%B9%E6%B4%BE%E5%85%B5%E5%B9%B6%E9%83%A8%E7%BD%B2%E9%98%B2%E5%BE%A1%E7%B3%BB%E7%BB%9F-%E4%BF%9D%E6%8A%A4%E5%BB%B6%E5%B8%83%E7%9F%B3%E6%B2%B9%E8%AE%BE%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790286330000.webp","sourceId":"rfi"},{"id":1790286118000,"createdDate":"2026-09-24 21:41","name":"法国国际广播电台","title":"特朗普与习近平在华盛顿会晤 美中第一夫人同访亚洲艺术博物馆","content":"中国国家主席习近平对美国进行国事访问期间，美国第一夫人梅拉尼娅·特朗普与中国国家主席夫人彭丽媛周四（9月24日）参观了华盛顿的美国国家亚洲艺术博物馆。两位第一夫人的行程及着装也受到关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%9C%A8%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%BC%9A%E6%99%A4-%E4%B8%A4%E5%9B%BD%E7%AC%AC%E4%B8%80%E5%A4%AB%E4%BA%BA%E5%90%8C%E8%AE%BF%E4%BA%9A%E6%B4%B2%E8%89%BA%E6%9C%AF%E5%8D%9A%E7%89%A9%E9%A6%86","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790286118000.webp","sourceId":"rfi"},{"id":1790285933000,"createdDate":"2026-09-24 21:38","name":"法国国际广播电台","title":"马克龙称俄或再征召30万人 反对美国限售柴油 排除解散国民议会","content":"法国总统马克龙周四(9月24日）表示，俄罗斯可能为继续对乌克兰作战而再征召约30万人。马克龙同时警告，法国可能面临携带爆炸物的无人机袭击，他并表示反对美国限制柴油出口。在法国国内政治问题上，马克龙排除了再次解散国民议会的可能性。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E9%A9%AC%E5%85%8B%E9%BE%99%E7%A7%B0%E4%BF%84%E6%88%96%E5%86%8D%E5%BE%81%E5%8F%AC30%E4%B8%87%E4%BA%BA-%E5%8F%8D%E5%AF%B9%E7%BE%8E%E5%9B%BD%E9%99%90%E5%94%AE%E6%9F%B4%E6%B2%B9-%E6%8E%92%E9%99%A4%E8%A7%A3%E6%95%A3%E5%9B%BD%E6%B0%91%E8%AE%AE%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790285933000.webp","sourceId":"rfi"},{"id":1790285699000,"createdDate":"2026-09-24 21:34","name":"法国国际广播电台","title":"特朗普白宫高规格接待习近平 美中峰会料难取得重大突破","content":"美国总统特朗普周四（9月24日）在白宫迎接中国国家主席习近平。路透社报道，此次美中峰会场面盛大、仪式隆重，但预计难有重大实质成果。尽管双方在人工智能、贸易、台湾问题及伊朗战争等议题上存在分歧，两位领导人仍希望展现美中关系的稳定。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E7%89%B9%E6%9C%97%E6%99%AE%E7%99%BD%E5%AE%AB%E9%AB%98%E8%A7%84%E6%A0%BC%E6%8E%A5%E5%BE%85%E4%B9%A0%E8%BF%91%E5%B9%B3-%E7%BE%8E%E4%B8%AD%E5%B3%B0%E4%BC%9A%E6%96%99%E9%9A%BE%E5%8F%96%E5%BE%97%E9%87%8D%E5%A4%A7%E7%AA%81%E7%A0%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790285699000.webp","sourceId":"rfi"},{"id":1790283750000,"createdDate":"2026-09-24 21:02","name":"法国国际广播电台","title":"抗议团体华盛顿“迎”习近平　中使馆外数百人高喊“不受欢迎”","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平在华盛顿举行会晤之际，多个人权及西藏、香港团体9月23日至24日接连在美国首都举行抗议，从街头示威、车队展示到大型投影，要求外界关注中国的人权、西藏及香港议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E6%8A%97%E8%AE%AE%E5%9B%A2%E4%BD%93%E5%8D%8E%E7%9B%9B%E9%A1%BF-%E8%BF%8E-%E4%B9%A0%E8%BF%91%E5%B9%B3-%E4%B8%AD%E4%BD%BF%E9%A6%86%E5%A4%96%E6%95%B0%E7%99%BE%E4%BA%BA%E9%AB%98%E5%96%8A-%E4%B8%8D%E5%8F%97%E6%AC%A2%E8%BF%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790283750000.webp","sourceId":"rfi"},{"id":1790283410000,"createdDate":"2026-09-24 20:56","name":"法国国际广播电台","title":"习近平要求美方“坚持反对台独”","content":"继周三晚间亲自接机后，美国总统特朗普夫妇周四在白宫隆重欢迎中国国家主席习近平夫妇，据新华社报道称，习近平与特朗普随后在白宫椭圆形办公室“小范围交流”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260924-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%A6%81%E6%B1%82%E7%BE%8E%E6%96%B9-%E5%9D%9A%E6%8C%81%E5%8F%8D%E5%AF%B9%E5%8F%B0%E7%8B%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/09/24/1790283410000.webp","sourceId":"rfi"}]