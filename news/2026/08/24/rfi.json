[{"id":1787562685000,"createdDate":"2026-08-24 09:11","name":"法国国际广播电台","title":"台湾南部和东部遭遇暴雨，洪水中已有4人失踪，预计周五还有台风过境北部","content":"周一（8月24日），台湾南部和东部地区遭遇暴雨，导致多地办公室和学校停课停班，目前已有4人失踪。与此同时，当局正为本周晚些时候台风可能袭击台湾做准备。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260824-%E5%8F%B0%E6%B9%BE%E5%8D%97%E9%83%A8%E5%92%8C%E4%B8%9C%E9%83%A8%E9%81%AD%E9%81%87%E6%9A%B4%E9%9B%A8%EF%BC%8C%E6%B4%AA%E6%B0%B4%E4%B8%AD%E5%B7%B2%E6%9C%894%E4%BA%BA%E5%A4%B1%E8%B8%AA%EF%BC%8C%E9%A2%84%E8%AE%A1%E5%91%A8%E4%BA%94%E8%BF%98%E6%9C%89%E5%8F%B0%E9%A3%8E%E8%BF%87%E5%A2%83%E5%8C%97%E9%83%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787562685000.webp","sourceId":"rfi"},{"id":1787561585000,"createdDate":"2026-08-24 08:53","name":"法国国际广播电台","title":"美国公布制裁伊朗方案前，中国警告将“采取必要措施维护自身合法权益”","content":"中国外交部周一（8月24日）表示，在美国准备公布新一轮对伊朗制裁措施之际，北京将密切关注事态发展，并采取必要措施维护自身合法权益。因为预计此次美国制裁将针对与伊朗开展贸易的合作伙伴，而中国购买了伊朗海运石油的80%以上。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E7%BE%8E%E5%9B%BD%E5%85%AC%E5%B8%83%E5%88%B6%E8%A3%81%E4%BC%8A%E6%9C%97%E6%96%B9%E6%A1%88%E5%89%8D%EF%BC%8C%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%B0%86-%E9%87%87%E5%8F%96%E5%BF%85%E8%A6%81%E6%8E%AA%E6%96%BD%E7%BB%B4%E6%8A%A4%E8%87%AA%E8%BA%AB%E5%90%88%E6%B3%95%E6%9D%83%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561585000.webp","sourceId":"rfi"},{"id":1787561031000,"createdDate":"2026-08-24 08:43","name":"法国国际广播电台","title":"台湾总统宣布全民普发一万元遭在野批政治意味浓厚，究竟是「钱坑」还是「AI红利」？","content":"台湾总统赖清德17日宣布「AI红利，全民共享」，将编列预算全民普发一万元。此声明一出，引来在野党的质疑双重标准，且此举是否为选举绑桩。经济学家则担忧，台湾经济热潮下的K型经济，无法靠普发现金来解决。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E5%8F%B0%E6%B9%BE%E6%80%BB%E7%BB%9F%E5%AE%A3%E5%B8%83%E5%85%A8%E6%B0%91%E6%99%AE%E5%8F%91%E4%B8%80%E4%B8%87%E5%85%83%E9%81%AD%E5%9C%A8%E9%87%8E%E6%89%B9%E6%94%BF%E6%B2%BB%E6%84%8F%E5%91%B3%E6%B5%93%E5%8E%9A%EF%BC%8C%E7%A9%B6%E7%AB%9F%E6%98%AF-%E9%92%B1%E5%9D%91-%E8%BF%98%E6%98%AF-ai%E7%BA%A2%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561031000.webp","sourceId":"rfi"},{"id":1787558881000,"createdDate":"2026-08-24 08:08","name":"法国国际广播电台","title":"欧盟再援乌61亿欧元，多国领导人周一会盟商讨援乌方案","content":"周一（8月24日），乌克兰的欧洲支持者们以线上或线下的方式齐聚一堂，共同商讨对乌援助。此次“志愿者联盟”成员国会议恰逢乌克兰独立35周年，会议将由英国、法国和德国共同主持。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E6%AC%A7%E7%9B%9F%E5%86%8D%E6%8F%B4%E4%B9%8C61%E4%BA%BF%E6%AC%A7%E5%85%83%EF%BC%8C%E5%A4%9A%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%91%A8%E4%B8%80%E4%BC%9A%E7%9B%9F%E5%95%86%E8%AE%A8%E6%8F%B4%E4%B9%8C%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787558881000.webp","sourceId":"rfi"},{"id":1787553029000,"createdDate":"2026-08-24 06:30","name":"法国国际广播电台","title":"阿里巴巴在港以IPO集资800亿 港股史上最大宗 评论料科网巨头会仿效","content":"人工智能（AI）热潮席卷全球，科技巨头纷纷跟投，阿里巴巴更率先公布，拟向美国境外的非美国人士配售新股，筹资总额800亿港元(下同，折算约87.4亿欧元)，全部投资AI。这是阿里自2019年港股上市以来首次配售新股，一旦成功，将是港股史上最大公司配售新股集资行动。市场消息指，阿里的新股已获超额认购，但其股价今早在香港下跌约一成。不过，分析预料，其他科网巨头会跟随阿里集资「抽水」。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E9%98%BF%E9%87%8C%E5%B7%B4%E5%B7%B4%E5%9C%A8%E6%B8%AF%E4%BB%A5ipo%E9%9B%86%E8%B5%84800%E4%BA%BF-%E6%B8%AF%E8%82%A1%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E5%AE%97-%E8%AF%84%E8%AE%BA%E6%96%99%E7%A7%91%E7%BD%91%E5%B7%A8%E5%A4%B4%E4%BC%9A%E4%BB%BF%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787553029000.webp","sourceId":"rfi"},{"id":1787552803000,"createdDate":"2026-08-24 06:26","name":"法国国际广播电台","title":"美法四国要求释放支联会案被告 国际社会对香港人权案件回响减弱","content":"在香港举办逾三十年「六四(事件)」烛光晚会的香港市民支援爱国民主运动联合会(支联会)及其正副主席李卓人和邹幸彤被裁定煽动颠覆国家政权罪名成立後，至今有七个国家表态关注或谴责，当中四个要求立即释放被告；联合国秘书长古特罗斯的发言人被问及裁决时，亦只是重申任何人均应有和平表达和抗议的自由的立场。整体回响较之前广泛被视为侵扰港人权利的两宗国家安全案件弱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E7%BE%8E%E6%B3%95%E5%9B%9B%E5%9B%BD%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E8%A2%AB%E5%91%8A-%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%AF%B9%E9%A6%99%E6%B8%AF%E4%BA%BA%E6%9D%83%E6%A1%88%E4%BB%B6%E5%9B%9E%E5%93%8D%E5%87%8F%E5%BC%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787552803000.webp","sourceId":"rfi"},{"id":1787586182000,"createdDate":"2026-08-24 15:43","name":"法国国际广播电台","title":"国内竞争激烈国外监管压力加剧影响 拼多多二季度利润下滑","content":"中国电商折扣平台拼多多周一（8月24日）公布财报，受国内激烈竞争及海外监管压力加剧影响，其第二季度利润下滑12%，营收低于市场预期。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260824-%E5%9B%BD%E5%86%85%E7%AB%9E%E4%BA%89%E5%9B%BD%E5%A4%96%E7%9B%91%E7%AE%A1%E5%8E%8B%E5%8A%9B%E5%8A%A0%E5%89%A7%E5%BD%B1%E5%93%8D-%E6%8B%BC%E5%A4%9A%E5%A4%9A%E4%BA%8C%E5%AD%A3%E5%BA%A6%E5%88%A9%E6%B6%A6%E4%B8%8B%E6%BB%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787586182000.webp","sourceId":"rfi"},{"id":1787581647000,"createdDate":"2026-08-24 14:27","name":"法国国际广播电台","title":"乌克兰在外患内忧中迎来独立35周年纪念，志愿者联盟重申支持","content":"8月24日，乌克兰在战争中迎来独立35周年。英、法、德三国在这一天主持支持乌克兰的志愿者联盟线上和线下会议。法国总统府21日强调，这次会议象征性地选择在乌克兰独立日召开，意在再次向乌克兰人民表达坚定支持，支持他们捍卫主权和独立的战斗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260824-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%9C%A8%E5%A4%96%E6%82%A3%E5%86%85%E5%BF%A7%E4%B8%AD%E8%BF%8E%E6%9D%A5%E7%8B%AC%E7%AB%8B35%E5%91%A8%E5%B9%B4%E7%BA%AA%E5%BF%B5%EF%BC%8C%E5%BF%97%E6%84%BF%E8%80%85%E8%81%94%E7%9B%9F%E9%87%8D%E7%94%B3%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787581647000.webp","sourceId":"rfi"},{"id":1787580624000,"createdDate":"2026-08-24 14:10","name":"法国国际广播电台","title":"路透：消息人士透露，习近平9月或将率大规模代表团访印，时隔七年再赴印度","content":"路透社报道称，三名消息人士周一（8月24日）表示，中国国家主席习近平可能出席下个月在新德里举行的金砖国家峰会，并率领一个规模庞大的代表团。这将是习近平七年来首次访问印度，也将是中印这两个竞争对手关系出现缓和的又一迹象。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E4%B9%A0%E8%BF%91%E5%B9%B39%E6%9C%88%E6%88%96%E5%B0%86%E7%8E%87%E5%A4%A7%E8%A7%84%E6%A8%A1%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8D%B0%EF%BC%8C%E6%97%B6%E9%9A%94%E4%B8%83%E5%B9%B4%E5%86%8D%E8%B5%B4%E5%8D%B0%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787580624000.webp","sourceId":"rfi"},{"id":1787579462000,"createdDate":"2026-08-24 13:51","name":"法国国际广播电台","title":"伊朗货币跌至历史新低，特朗普称“伊朗正在彻底崩溃”","content":"周一(8月24日)，伊朗货币里亚尔跌至历史新低。与此同时，美国政府准备宣布新一轮制裁，并表示这些措施将进一步加大对伊朗的压力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E4%BC%8A%E6%9C%97%E8%B4%A7%E5%B8%81%E8%B7%8C%E8%87%B3%E5%8E%86%E5%8F%B2%E6%96%B0%E4%BD%8E%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0-%E4%BC%8A%E6%9C%97%E6%AD%A3%E5%9C%A8%E5%BD%BB%E5%BA%95%E5%B4%A9%E6%BA%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787579462000.webp","sourceId":"rfi"},{"id":1787579415000,"createdDate":"2026-08-24 13:50","name":"法国国际广播电台","title":"中俄如何松解美国对伊朗的经济绞刑？","content":"8月24日出刊的法国主流日刊当中，有多则和中国相关的报道，涉及地缘政治、人工智能经济和民航领域。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260824-%E4%B8%AD%E4%BF%84%E5%A6%82%E4%BD%95%E6%9D%BE%E8%A7%A3%E7%BE%8E%E5%9B%BD%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%9A%84%E7%BB%8F%E6%B5%8E%E7%BB%9E%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787579415000.webp","sourceId":"rfi"},{"id":1787572963000,"createdDate":"2026-08-24 12:02","name":"法国国际广播电台","title":"台湾基隆地检署以涉嫌非法向中国出售高阶芯片伺服器罪名起诉九人","content":"台湾基隆地检署24日宣布对包括英伟达（Nvidia)和超微电脑(SuperMicroSMCI)在台湾合作企业员工在内的九人提起诉讼，理由是他们涉嫌参与向中国非法出售英伟达高级人工智能芯片伺服器。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260824-%E5%8F%B0%E6%B9%BE%E5%9F%BA%E9%9A%86%E5%9C%B0%E6%A3%80%E7%BD%B2%E4%BB%A5%E6%B6%89%E5%AB%8C%E9%9D%9E%E6%B3%95%E5%90%91%E4%B8%AD%E5%9B%BD%E5%87%BA%E5%94%AE%E9%AB%98%E9%98%B6%E8%8A%AF%E7%89%87%E4%BC%BA%E6%9C%8D%E5%99%A8%E7%BD%AA%E5%90%8D%E8%B5%B7%E8%AF%89%E4%B9%9D%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787572963000.webp","sourceId":"rfi"},{"id":1787571177000,"createdDate":"2026-08-24 11:32","name":"法国国际广播电台","title":"应对伊朗威胁：“爱国者”导弹系统被重新部署至克里特岛","content":"由于伊朗威胁针对欧洲境内的美军基地，一套“爱国者”导弹系统从希腊最东端的卡尔帕索斯岛（Karpathos）转移至克里特岛。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E5%BA%94%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%A8%81%E8%83%81-%E7%88%B1%E5%9B%BD%E8%80%85-%E5%AF%BC%E5%BC%B9%E7%B3%BB%E7%BB%9F%E8%A2%AB%E9%87%8D%E6%96%B0%E9%83%A8%E7%BD%B2%E8%87%B3%E5%85%8B%E9%87%8C%E7%89%B9%E5%B2%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787571177000.webp","sourceId":"rfi"},{"id":1787566983000,"createdDate":"2026-08-24 10:23","name":"法国国际广播电台","title":"日本超党派议员代表团前往北京  在复交以来关系最坏之际访华","content":"在日中关系日趋紧张之际，由日本跨党派国会议员组成的代表团24日早晨从羽田机场启程前往背景，将与中国共产党干部举行会谈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E6%97%A5%E6%9C%AC%E8%B6%85%E5%85%9A%E6%B4%BE%E8%AE%AE%E5%91%98%E4%BB%A3%E8%A1%A8%E5%9B%A2%E5%89%8D%E5%BE%80%E5%8C%97%E4%BA%AC-%E5%9C%A8%E5%A4%8D%E4%BA%A4%E4%BB%A5%E6%9D%A5%E5%85%B3%E7%B3%BB%E6%9C%80%E5%9D%8F%E4%B9%8B%E9%99%85%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787566983000.webp","sourceId":"rfi"},{"id":1787565530000,"createdDate":"2026-08-24 09:58","name":"法国国际广播电台","title":"韩国军方：伊朗战争导致美军兵力调配受限，美韩下月联合军演被迫取消","content":"韩国军方周一（8月24日）宣布，由于伊朗战争导致美军兵力调配受到限制，美国取消了原定于下月举行的一项重要美韩联合两栖登陆演习。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E9%9F%A9%E5%9B%BD%E5%86%9B%E6%96%B9-%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E5%AF%BC%E8%87%B4%E7%BE%8E%E5%86%9B%E5%85%B5%E5%8A%9B%E8%B0%83%E9%85%8D%E5%8F%97%E9%99%90%EF%BC%8C%E4%B8%8B%E6%9C%88%E7%BE%8E%E9%9F%A9%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94%E8%A2%AB%E8%BF%AB%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787565530000.webp","sourceId":"rfi"},{"id":1787564149000,"createdDate":"2026-08-24 09:35","name":"法国国际广播电台","title":"小米发布新一代自研手机芯片，消息人士透露：将由台积电进行生产","content":"中国智能手机制造商小米周一（8月24日）发布新一代自研手机处理器XringO3，希望通过进一步掌控关键零部件，加强供应链韧性，并降低对外部芯片供应商的依赖。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260824-%E5%B0%8F%E7%B1%B3%E5%8F%91%E5%B8%83%E6%96%B0%E4%B8%80%E4%BB%A3%E8%87%AA%E7%A0%94%E6%89%8B%E6%9C%BA%E8%8A%AF%E7%89%87%EF%BC%8C%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E5%B0%86%E7%