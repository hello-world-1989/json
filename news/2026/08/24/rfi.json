[{"id":1787562685000,"createdDate":"2026-08-24 09:11","name":"法国国际广播电台","title":"台湾南部和东部遭遇暴雨，洪水中已有4人失踪，预计周五还有台风过境北部","content":"周一（8月24日），台湾南部和东部地区遭遇暴雨，导致多地办公室和学校停课停班，目前已有4人失踪。与此同时，当局正为本周晚些时候台风可能袭击台湾做准备。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260824-%E5%8F%B0%E6%B9%BE%E5%8D%97%E9%83%A8%E5%92%8C%E4%B8%9C%E9%83%A8%E9%81%AD%E9%81%87%E6%9A%B4%E9%9B%A8%EF%BC%8C%E6%B4%AA%E6%B0%B4%E4%B8%AD%E5%B7%B2%E6%9C%894%E4%BA%BA%E5%A4%B1%E8%B8%AA%EF%BC%8C%E9%A2%84%E8%AE%A1%E5%91%A8%E4%BA%94%E8%BF%98%E6%9C%89%E5%8F%B0%E9%A3%8E%E8%BF%87%E5%A2%83%E5%8C%97%E9%83%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787562685000.webp","sourceId":"rfi"},{"id":1787561585000,"createdDate":"2026-08-24 08:53","name":"法国国际广播电台","title":"美国公布制裁伊朗方案前，中国警告将“采取必要措施维护自身合法权益”","content":"中国外交部周一（8月24日）表示，在美国准备公布新一轮对伊朗制裁措施之际，北京将密切关注事态发展，并采取必要措施维护自身合法权益。因为预计此次美国制裁将针对与伊朗开展贸易的合作伙伴，而中国购买了伊朗海运石油的80%以上。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E7%BE%8E%E5%9B%BD%E5%85%AC%E5%B8%83%E5%88%B6%E8%A3%81%E4%BC%8A%E6%9C%97%E6%96%B9%E6%A1%88%E5%89%8D%EF%BC%8C%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%B0%86-%E9%87%87%E5%8F%96%E5%BF%85%E8%A6%81%E6%8E%AA%E6%96%BD%E7%BB%B4%E6%8A%A4%E8%87%AA%E8%BA%AB%E5%90%88%E6%B3%95%E6%9D%83%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561585000.webp","sourceId":"rfi"},{"id":1787561031000,"createdDate":"2026-08-24 08:43","name":"法国国际广播电台","title":"台湾总统宣布全民普发一万元遭在野批政治意味浓厚，究竟是「钱坑」还是「AI红利」？","content":"台湾总统赖清德17日宣布「AI红利，全民共享」，将编列预算全民普发一万元。此声明一出，引来在野党的质疑双重标准，且此举是否为选举绑桩。经济学家则担忧，台湾经济热潮下的K型经济，无法靠普发现金来解决。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E5%8F%B0%E6%B9%BE%E6%80%BB%E7%BB%9F%E5%AE%A3%E5%B8%83%E5%85%A8%E6%B0%91%E6%99%AE%E5%8F%91%E4%B8%80%E4%B8%87%E5%85%83%E9%81%AD%E5%9C%A8%E9%87%8E%E6%89%B9%E6%94%BF%E6%B2%BB%E6%84%8F%E5%91%B3%E6%B5%93%E5%8E%9A%EF%BC%8C%E7%A9%B6%E7%AB%9F%E6%98%AF-%E9%92%B1%E5%9D%91-%E8%BF%98%E6%98%AF-ai%E7%BA%A2%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561031000.webp","sourceId":"rfi"},{"id":1787558881000,"createdDate":"2026-08-24 08:08","name":"法国国际广播电台","title":"欧盟再援乌61亿欧元，多国领导人周一会盟商讨援乌方案","content":"周一（8月24日），乌克兰的欧洲支持者们以线上或线下的方式齐聚一堂，共同商讨对乌援助。此次“志愿者联盟”成员国会议恰逢乌克兰独立35周年，会议将由英国、法国和德国共同主持。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E6%AC%A7%E7%9B%9F%E5%86%8D%E6%8F%B4%E4%B9%8C61%E4%BA%BF%E6%AC%A7%E5%85%83%EF%BC%8C%E5%A4%9A%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%91%A8%E4%B8%80%E4%BC%9A%E7%9B%9F%E5%95%86%E8%AE%A8%E6%8F%B4%E4%B9%8C%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787558881000.webp","sourceId":"rfi"},{"id":1787553029000,"createdDate":"2026-08-24 06:30","name":"法国国际广播电台","title":"阿里巴巴在港以IPO集资800亿 港股史上最大宗 评论料科网巨头会仿效","content":"人工智能（AI）热潮席卷全球，科技巨头纷纷跟投，阿里巴巴更率先公布，拟向美国境外的非美国人士配售新股，筹资总额800亿港元(下同，折算约87.4亿欧元)，全部投资AI。这是阿里自2019年港股上市以来首次配售新股，一旦成功，将是港股史上最大公司配售新股集资行动。市场消息指，阿里的新股已获超额认购，但其股价今早在香港下跌约一成。不过，分析预料，其他科网巨头会跟随阿里集资「抽水」。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E9%98%BF%E9%87%8C%E5%B7%B4%E5%B7%B4%E5%9C%A8%E6%B8%AF%E4%BB%A5ipo%E9%9B%86%E8%B5%84800%E4%BA%BF-%E6%B8%AF%E8%82%A1%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E5%AE%97-%E8%AF%84%E8%AE%BA%E6%96%99%E7%A7%91%E7%BD%91%E5%B7%A8%E5%A4%B4%E4%BC%9A%E4%BB%BF%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787553029000.webp","sourceId":"rfi"},{"id":1787552803000,"createdDate":"2026-08-24 06:26","name":"法国国际广播电台","title":"美法四国要求释放支联会案被告 国际社会对香港人权案件回响减弱","content":"在香港举办逾三十年「六四(事件)」烛光晚会的香港市民支援爱国民主运动联合会(支联会)及其正副主席李卓人和邹幸彤被裁定煽动颠覆国家政权罪名成立後，至今有七个国家表态关注或谴责，当中四个要求立即释放被告；联合国秘书长古特罗斯的发言人被问及裁决时，亦只是重申任何人均应有和平表达和抗议的自由的立场。整体回响较之前广泛被视为侵扰港人权利的两宗国家安全案件弱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E7%BE%8E%E6%B3%95%E5%9B%9B%E5%9B%BD%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E8%A2%AB%E5%91%8A-%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%AF%B9%E9%A6%99%E6%B8%AF%E4%BA%BA%E6%9D%83%E6%A1%88%E4%BB%B6%E5%9B%9E%E5%93%8D%E5%87%8F%E5%BC%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787552803000.webp","sourceId":"rfi"},{"id":1787586182000,"createdDate":"2026-08-24 15:43","name":"法国国际广播电台","title":"国内竞争激烈国外监管压力加剧影响 拼多多二季度利润下滑","content":"中国电商折扣平台拼多多周一（8月24日）公布财报，受国内激烈竞争及海外监管压力加剧影响，其第二季度利润下滑12%，营收低于市场预期。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260824-%E5%9B%BD%E5%86%85%E7%AB%9E%E4%BA%89%E5%9B%BD%E5%A4%96%E7%9B%91%E7%AE%A1%E5%8E%8B%E5%8A%9B%E5%8A%A0%E5%89%A7%E5%BD%B1%E5%93%8D-%E6%8B%BC%E5%A4%9A%E5%A4%9A%E4%BA%8C%E5%AD%A3%E5%BA%A6%E5%88%A9%E6%B6%A6%E4%B8%8B%E6%BB%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787586182000.webp","sourceId":"rfi"},{"id":1787581647000,"createdDate":"2026-08-24 14:27","name":"法国国际广播电台","title":"乌克兰在外患内忧中迎来独立35周年纪念，志愿者联盟重申支持","content":"8月24日，乌克兰在战争中迎来独立35周年。英、法、德三国在这一天主持支持乌克兰的志愿者联盟线上和线下会议。法国总统府21日强调，这次会议象征性地选择在乌克兰独立日召开，意在再次向乌克兰人民表达坚定支持，支持他们捍卫主权和独立的战斗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260824-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%9C%A8%E5%A4%96%E6%82%A3%E5%86%85%E5%BF%A7%E4%B8%AD%E8%BF%8E%E6%9D%A5%E7%8B%AC%E7%AB%8B35%E5%91%A8%E5%B9%B4%E7%BA%AA%E5%BF%B5%EF%BC%8C%E5%BF%97%E6%84%BF%E8%80%85%E8%81%94%E7%9B%9F%E9%87%8D%E7%94%B3%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787581647000.webp","sourceId":"rfi"},{"id":1787580624000,"createdDate":"2026-08-24 14:10","name":"法国国际广播电台","title":"路透：消息人士透露，习近平9月或将率大规模代表团访印，时隔七年再赴印度","content":"路透社报道称，三名消息人士周一（8月24日）表示，中国国家主席习近平可能出席下个月在新德里举行的金砖国家峰会，并率领一个规模庞大的代表团。这将是习近平七年来首次访问印度，也将是中印这两个竞争对手关系出现缓和的又一迹象。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E4%B9%A0%E8%BF%91%E5%B9%B39%E6%9C%88%E6%88%96%E5%B0%86%E7%8E%87%E5%A4%A7%E8%A7%84%E6%A8%A1%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8D%B0%EF%BC%8C%E6%97%B6%E9%9A%94%E4%B8%83%E5%B9%B4%E5%86%8D%E8%B5%B4%E5%8D%B0%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787580624000.webp","sourceId":"rfi"},{"id":1787579462000,"createdDate":"2026-08-24 13:51","name":"法国国际广播电台","title":"伊朗货币跌至历史新低，特朗普称“伊朗正在彻底崩溃”","content":"周一(8月24日)，伊朗货币里亚尔跌至历史新低。与此同时，美国政府准备宣布新一轮制裁，并表示这些措施将进一步加大对伊朗的压力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E4%BC%8A%E6%9C%97%E8%B4%A7%E5%B8%81%E8%B7%8C%E8%87%B3%E5%8E%86%E5%8F%B2%E6%96%B0%E4%BD%8E%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0-%E4%BC%8A%E6%9C%97%E6%AD%A3%E5%9C%A8%E5%BD%BB%E5%BA%95%E5%B4%A9%E6%BA%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787579462000.webp","sourceId":"rfi"},{"id":1787579415000,"createdDate":"2026-08-24 13:50","name":"法国国际广播电台","title":"中俄如何松解美国对伊朗的经济绞刑？","content":"8月24日出刊的法国主流日刊当中，有多则和中国相关的报道，涉及地缘政治、人工智能经济和民航领域。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260824-%E4%B8%AD%E4%BF%84%E5%A6%82%E4%BD%95%E6%9D%BE%E8%A7%A3%E7%BE%8E%E5%9B%BD%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%9A%84%E7%BB%8F%E6%B5%8E%E7%BB%9E%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787579415000.webp","sourceId":"rfi"},{"id":1787572963000,"createdDate":"2026-08-24 12:02","name":"法国国际广播电台","title":"台湾基隆地检署以涉嫌非法向中国出售高阶芯片伺服器罪名起诉九人","content":"台湾基隆地检署24日宣布对包括英伟达（Nvidia)和超微电脑(SuperMicroSMCI)在台湾合作企业员工在内的九人提起诉讼，理由是他们涉嫌参与向中国非法出售英伟达高级人工智能芯片伺服器。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260824-%E5%8F%B0%E6%B9%BE%E5%9F%BA%E9%9A%86%E5%9C%B0%E6%A3%80%E7%BD%B2%E4%BB%A5%E6%B6%89%E5%AB%8C%E9%9D%9E%E6%B3%95%E5%90%91%E4%B8%AD%E5%9B%BD%E5%87%BA%E5%94%AE%E9%AB%98%E9%98%B6%E8%8A%AF%E7%89%87%E4%BC%BA%E6%9C%8D%E5%99%A8%E7%BD%AA%E5%90%8D%E8%B5%B7%E8%AF%89%E4%B9%9D%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787572963000.webp","sourceId":"rfi"},{"id":1787571177000,"createdDate":"2026-08-24 11:32","name":"法国国际广播电台","title":"应对伊朗威胁：“爱国者”导弹系统被重新部署至克里特岛","content":"由于伊朗威胁针对欧洲境内的美军基地，一套“爱国者”导弹系统从希腊最东端的卡尔帕索斯岛（Karpathos）转移至克里特岛。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E5%BA%94%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%A8%81%E8%83%81-%E7%88%B1%E5%9B%BD%E8%80%85-%E5%AF%BC%E5%BC%B9%E7%B3%BB%E7%BB%9F%E8%A2%AB%E9%87%8D%E6%96%B0%E9%83%A8%E7%BD%B2%E8%87%B3%E5%85%8B%E9%87%8C%E7%89%B9%E5%B2%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787571177000.webp","sourceId":"rfi"},{"id":1787566983000,"createdDate":"2026-08-24 10:23","name":"法国国际广播电台","title":"日本超党派议员代表团前往北京  在复交以来关系最坏之际访华","content":"在日中关系日趋紧张之际，由日本跨党派国会议员组成的代表团24日早晨从羽田机场启程前往背景，将与中国共产党干部举行会谈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E6%97%A5%E6%9C%AC%E8%B6%85%E5%85%9A%E6%B4%BE%E8%AE%AE%E5%91%98%E4%BB%A3%E8%A1%A8%E5%9B%A2%E5%89%8D%E5%BE%80%E5%8C%97%E4%BA%AC-%E5%9C%A8%E5%A4%8D%E4%BA%A4%E4%BB%A5%E6%9D%A5%E5%85%B3%E7%B3%BB%E6%9C%80%E5%9D%8F%E4%B9%8B%E9%99%85%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787566983000.webp","sourceId":"rfi"},{"id":1787565530000,"createdDate":"2026-08-24 09:58","name":"法国国际广播电台","title":"韩国军方：伊朗战争导致美军兵力调配受限，美韩下月联合军演被迫取消","content":"韩国军方周一（8月24日）宣布，由于伊朗战争导致美军兵力调配受到限制，美国取消了原定于下月举行的一项重要美韩联合两栖登陆演习。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E9%9F%A9%E5%9B%BD%E5%86%9B%E6%96%B9-%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E5%AF%BC%E8%87%B4%E7%BE%8E%E5%86%9B%E5%85%B5%E5%8A%9B%E8%B0%83%E9%85%8D%E5%8F%97%E9%99%90%EF%BC%8C%E4%B8%8B%E6%9C%88%E7%BE%8E%E9%9F%A9%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94%E8%A2%AB%E8%BF%AB%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787565530000.webp","sourceId":"rfi"},{"id":1787564149000,"createdDate":"2026-08-24 09:35","name":"法国国际广播电台","title":"小米发布新一代自研手机芯片，消息人士透露：将由台积电进行生产","content":"中国智能手机制造商小米周一（8月24日）发布新一代自研手机处理器XringO3，希望通过进一步掌控关键零部件，加强供应链韧性，并降低对外部芯片供应商的依赖。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260824-%E5%B0%8F%E7%B1%B3%E5%8F%91%E5%B8%83%E6%96%B0%E4%B8%80%E4%BB%A3%E8%87%AA%E7%A0%94%E6%89%8B%E6%9C%BA%E8%8A%AF%E7%89%87%EF%BC%8C%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E5%B0%86%E7%94%B1%E5%8F%B0%E7%A7%AF%E7%94%B5%E8%BF%9B%E8%A1%8C%E7%94%9F%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787564149000.webp","sourceId":"rfi"},{"id":1787563614000,"createdDate":"2026-08-24 09:26","name":"法国国际广播电台","title":"中国外交部对“支联会案”作出回应：个别国家“恶意诋毁香港法治”，呼吁停止“干涉中国内政”","content":"8月24日，外交部发言人林剑对上周香港法庭判决的支联会案作出表态，该案一度成为国际社会关注的焦点。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%AF%B9-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88-%E4%BD%9C%E5%87%BA%E5%9B%9E%E5%BA%94-%E4%B8%AA%E5%88%AB%E5%9B%BD%E5%AE%B6-%E6%81%B6%E6%84%8F%E8%AF%8B%E6%AF%81%E9%A6%99%E6%B8%AF%E6%B3%95%E6%B2%BB-%EF%BC%8C%E5%91%BC%E5%90%81%E5%81%9C%E6%AD%A2-%E5%B9%B2%E6%B6%89%E4%B8%AD%E5%9B%BD%E5%86%85%E6%94%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787563614000.webp","sourceId":"rfi"},{"id":1787613513000,"createdDate":"2026-08-24 23:18","name":"法国国际广播电台","title":"美国宣布，把叙利亚从“支持恐怖主义国家”名单中移除","content":"美国周一正式取消叙利亚“支持恐怖主义国家”的认定，此举将为更多商业投资进入这个饱受战争蹂躏的国家铺平道路。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E7%BE%8E%E5%9B%BD%E5%AE%A3%E5%B8%83%EF%BC%8C%E6%8A%8A%E5%8F%99%E5%88%A9%E4%BA%9A%E4%BB%8E-%E6%94%AF%E6%8C%81%E6%81%90%E6%80%96%E4%B8%BB%E4%B9%89%E5%9B%BD%E5%AE%B6-%E5%90%8D%E5%8D%95%E4%B8%AD%E7%A7%BB%E9%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787613513000.webp","sourceId":"rfi"},{"id":1787613342000,"createdDate":"2026-08-24 23:15","name":"法国国际广播电台","title":"非洲:乍得指控苏丹军队一再入侵","content":"非洲内陆国乍得（leTchad）指控其邻国苏丹军方的飞行器于2026年08月20日上周四晚，闯入乍得境内追击并轰炸了从利比亚出发的车队。这是本台法广非洲组（RFIAfrique）在2026年08月24日周一上网的法文消息之一。恩贾梅纳（Ndjamena）的军事当局表示，苏丹军队的无人机和飞机侵入乍得领土，追击和轰炸了来自利比亚的车队。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260824-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E4%B9%8D%E5%BE%97%E6%8C%87%E6%8E%A7%E8%8B%8F%E4%B8%B9%E5%86%9B%E9%98%9F%E4%B8%80%E5%86%8D%E5%85%A5%E4%BE%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787613342000.webp","sourceId":"rfi"},{"id":1787613250000,"createdDate":"2026-08-24 23:14","name":"法国国际广播电台","title":"多次尝试上市失败后，增长放缓的超快时尚巨头Shein宣布赴香港上市","content":"中国快时尚企业希音（Shein）周一宣布将于9月1日在香港上市，当天法国世界报就此发表文章表示，增长放缓的Shein，仍然希望吸引国际投资者。同时，在中国国内，希音在努力确保自己处于一个高度受控的媒体环境中。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260824-%E5%A4%9A%E6%AC%A1%E5%B0%9D%E8%AF%95%E4%B8%8A%E5%B8%82%E5%A4%B1%E8%B4%A5%E5%90%8E%EF%BC%8C%E5%A2%9E%E9%95%BF%E6%94%BE%E7%BC%93%E7%9A%84%E8%B6%85%E5%BF%AB%E6%97%B6%E5%B0%9A%E5%B7%A8%E5%A4%B4shein%E5%AE%A3%E5%B8%83%E8%B5%B4%E9%A6%99%E6%B8%AF%E4%B8%8A%E5%B8%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787613250000.webp","sourceId":"rfi"},{"id":1787607649000,"createdDate":"2026-08-24 21:40","name":"法国国际广播电台","title":"英国新首相到访乌克兰 英法合力在乌境内打造“暴风阴影”","content":"英国首相安迪·伯纳姆（AndyBurnham）周一抵达乌克兰首都基辅，展开就任首相后的首次海外访问。伯纳姆与乌克兰总统泽连斯基会面，并宣布英国支持乌克兰扩大远程导弹国产化生产。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260824-%E8%8B%B1%E5%9B%BD%E6%96%B0%E9%A6%96%E7%9B%B8%E5%88%B0%E8%AE%BF%E4%B9%8C%E5%85%8B%E5%85%B0-%E8%8B%B1%E6%B3%95%E5%90%88%E5%8A%9B%E5%9C%A8%E4%B9%8C%E5%A2%83%E5%86%85%E6%89%93%E9%80%A0-%E6%9A%B4%E9%A3%8E%E9%98%B4%E5%BD%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787607649000.webp","sourceId":"rfi"},{"id":1787605972000,"createdDate":"2026-08-24 21:12","name":"法国国际广播电台","title":"喀麦隆总统为女足非洲夺冠授勋","content":"非洲国家喀麦隆总统保罗·比亚（présidentcamerounaisPaulBiya）在离境近两个半月后于2026年08月20日上星期四从日内瓦（Genève）飞回雅温得（Yaoundé）。现已93岁高龄的喀麦隆国家元首在境外74天里的健康状况，一直是该国政坛及国际舆论的关注焦点。本台法广非洲组（RFIAfrique）通讯员注意到，喀麦隆总统回国后的主要公开活动之一是在08月22日星期六接见和嘉奖了于一周前刚刚摘取2026年女子足球非洲国家杯（laCANféminine2026）桂冠的本国[不屈雌狮]或[不屈的母狮]（lesLionnesindomptables）女足队。在喀麦隆总统官邸（Palaisdel'Unité)举行的这场庆功仪式对媒体部分开放。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260824-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E5%96%80%E9%BA%A6%E9%9A%86%E6%80%BB%E7%BB%9F%E4%B8%BA%E5%A5%B3%E8%B6%B3%E9%9D%9E%E6%B4%B2%E5%A4%BA%E5%86%A0%E6%8E%88%E5%8B%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787605972000.webp","sourceId":"rfi"},{"id":1787604924000,"createdDate":"2026-08-24 20:55","name":"法国国际广播电台","title":"贝森特：美对伊朗正发动全面经济攻势","content":"伊朗在美国宣布了经济攻势后表示，该国制定了应对美国制裁的“两年计划”；伊朗回应说，制裁之后美国将“再次失败”。伊朗对外界表示，美国将对黄金、技术、航空和海运实施新的制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260824-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E7%BE%8E%E5%AF%B9%E4%BC%8A%E6%9C%97%E6%AD%A3%E5%8F%91%E5%8A%A8%E5%85%A8%E9%9D%A2%E7%BB%8F%E6%B5%8E%E6%94%BB%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787604924000.webp","sourceId":"rfi"},{"id":1787604553000,"createdDate":"2026-08-24 20:49","name":"法国国际广播电台","title":"伊朗：美国威胁德黑兰的盟友","content":"8月24日，美国财政部长贝森特召开新闻发布会。贝森特表示，美国总统特朗普正致电各国领导人，明确要求其停止与伊朗的往来。美国财政部长贝森特23日晚在社交媒体上说，美国同伊朗的战事正进入“终局”，扬言要切断伊朗政权“每一条经济命脉”，直至德黑兰“孤立无援”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260824-%E4%BC%8A%E6%9C%97-%E7%BE%8E%E5%9B%BD%E5%A8%81%E8%83%81%E5%BE%B7%E9%BB%91%E5%85%B0%E7%9A%84%E7%9B%9F%E5%8F%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787604553000.webp","sourceId":"rfi"},{"id":1787604156000,"createdDate":"2026-08-24 20:42","name":"法国国际广播电台","title":"沙特60亿投资   搞活地区经济","content":"巴黎以北的瓦勒德瓦兹（Vald'Oise）成为24日新闻的焦点。沙特在这个地区投了巨资将法国曾经规模最大的老牌废弃主题乐园改造为日系漫画IP龙珠主题游乐园区。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260824-%E6%B2%99%E7%89%B960%E4%BA%BF%E6%8A%95%E8%B5%84-%E6%90%9E%E6%B4%BB%E5%9C%B0%E5%8C%BA%E7%BB%8F%E6%B5%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787604156000.webp","sourceId":"rfi"},{"id":1787603783000,"createdDate":"2026-08-24 20:36","name":"法国国际广播电台","title":"达飞集团和阿尔斯通与沙特签署重大基础设施合作协议","content":"沙特阿拉伯王储穆罕默德·本·萨勒曼周一访问巴黎期间，沙特阿拉伯与法国阿尔斯通和达飞集团签署了公共交通和海运领域的合同，总金额近10亿欧元。爱丽舍宫宣布了这一消息。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260824-%E8%BE%BE%E9%A3%9E%E9%9B%86%E5%9B%A2%E5%92%8C%E9%98%BF%E5%B0%94%E6%96%AF%E9%80%9A%E4%B8%8E%E6%B2%99%E7%89%B9%E7%AD%BE%E7%BD%B2%E9%87%8D%E5%A4%A7%E5%9F%BA%E7%A1%80%E8%AE%BE%E6%96%BD%E5%90%88%E4%BD%9C%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787603783000.webp","sourceId":"rfi"},{"id":1787603640000,"createdDate":"2026-08-24 20:34","name":"法国国际广播电台","title":"周一为制裁伊朗的“诺曼底登陆日” 美国财长宣布“经济弃儿行动”","content":"周一（8月24日）是美国宣称经济制裁伊朗的“诺曼底登陆日”，美国财政部长斯科特‧贝森特（ScottBessent）在新闻发布会上宣布：扩大对伊朗的经济制裁，包括部分二级制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260824-%E5%91%A8%E4%B8%80%E4%B8%BA%E5%88%B6%E8%A3%81%E4%BC%8A%E6%9C%97%E7%9A%84-%E8%AF%BA%E6%9B%BC%E5%BA%95%E7%99%BB%E9%99%86%E6%97%A5-%E7%BE%8E%E5%9B%BD%E8%B4%A2%E9%95%BF%E5%AE%A3%E5%B8%83-%E7%BB%8F%E6%B5%8E%E5%BC%83%E5%84%BF%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787603640000.webp","sourceId":"rfi"},{"id":1787603500000,"createdDate":"2026-08-24 20:31","name":"法国国际广播电台","title":"哥伦比亚遣返非法移民","content":"哥伦比亚总统阿韦拉多·德拉埃斯普里利亚（AbelardodelaEspriella）已下令移民局和警方本周开展联合行动，遣返非法移民。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260824-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E9%81%A3%E8%BF%94%E9%9D%9E%E6%B3%95%E7%A7%BB%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787603500000.webp","sourceId":"rfi"},{"id":1787603043000,"createdDate":"2026-08-24 20:24","name":"法国国际广播电台","title":"美国财长周一宣布扩大对伊朗经济制裁的措施","content":"周一（8月24日）是美国宣称经济制裁伊朗的“诺曼底登陆日”，美国财政部长斯科特‧贝森特（ScottBessent）在新闻发布会上宣布：扩大对伊朗的经济制裁，包括部分二级制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260824-%E7%BE%8E%E5%9B%BD%E8%B4%A2%E9%95%BF%E5%91%A8%E4%B8%80%E5%AE%A3%E5%B8%83%E6%89%A9%E5%A4%A7%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%E7%9A%84%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787603043000.webp","sourceId":"rfi"},{"id":1787602918000,"createdDate":"2026-08-24 20:21","name":"法国国际广播电台","title":"60 亿投资    数千个工作岗位   沙特在巴黎近郊打造《龙珠》主题乐园","content":"法国总统马克龙与沙特王储达成共识，将在巴黎周边投资60亿欧元建设三个漫画主题公园项目，其中有《龙珠》主题乐园；另外两个还没有确认主题。法国总统马克龙表示：：沙特阿拉伯将投资60亿欧元在瓦勒德瓦兹省（Val-d'Oise）塞尔吉-蓬图瓦兹（Cergy-Pontoise）兴建三座主题公园，预计将创造2.2万个直接就业岗位。“自巴黎迪士尼乐园以来，从未有过如此规模的项目”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260824-60-%E4%BA%BF%E6%8A%95%E8%B5%84-%E6%95%B0%E5%8D%83%E4%B8%AA%E5%B7%A5%E4%BD%9C%E5%B2%97%E4%BD%8D-%E6%B2%99%E7%89%B9%E5%9C%A8%E5%B7%B4%E9%BB%8E%E8%BF%91%E9%83%8A%E6%89%93%E9%80%A0-%E9%BE%99%E7%8F%A0-%E4%B8%BB%E9%A2%98%E4%B9%90%E5%9B%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787602918000.webp","sourceId":"rfi"},{"id":1787597357000,"createdDate":"2026-08-24 18:49","name":"法国国际广播电台","title":"特朗普政府提议对H-1B签证申请收取10.3万美元费用","content":"美国国土安全部（DHS）周一提出新规，计划把所有受年度名额限制的H-1B工作签证申请费，提高至每件10万3265美元，且这笔费用将在提交申请时缴交，并加在现有各项H-1B费用之上。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260824-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E6%8F%90%E8%AE%AE%E5%AF%B9h-1b%E7%AD%BE%E8%AF%81%E7%94%B3%E8%AF%B7%E6%94%B6%E5%8F%9610-3%E4%B8%87%E7%BE%8E%E5%85%83%E8%B4%B9%E7%94%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787597357000.webp","sourceId":"rfi"}]