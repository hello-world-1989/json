[{"id":1787562685000,"createdDate":"2026-08-24 09:11","name":"法国国际广播电台","title":"台湾南部和东部遭遇暴雨，洪水中已有4人失踪，预计周五还有台风过境北部","content":"周一（8月24日），台湾南部和东部地区遭遇暴雨，导致多地办公室和学校停课停班，目前已有4人失踪。与此同时，当局正为本周晚些时候台风可能袭击台湾做准备。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260824-%E5%8F%B0%E6%B9%BE%E5%8D%97%E9%83%A8%E5%92%8C%E4%B8%9C%E9%83%A8%E9%81%AD%E9%81%87%E6%9A%B4%E9%9B%A8%EF%BC%8C%E6%B4%AA%E6%B0%B4%E4%B8%AD%E5%B7%B2%E6%9C%894%E4%BA%BA%E5%A4%B1%E8%B8%AA%EF%BC%8C%E9%A2%84%E8%AE%A1%E5%91%A8%E4%BA%94%E8%BF%98%E6%9C%89%E5%8F%B0%E9%A3%8E%E8%BF%87%E5%A2%83%E5%8C%97%E9%83%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787562685000.webp","sourceId":"rfi"},{"id":1787561585000,"createdDate":"2026-08-24 08:53","name":"法国国际广播电台","title":"美国公布制裁伊朗方案前，中国警告将“采取必要措施维护自身合法权益”","content":"中国外交部周一（8月24日）表示，在美国准备公布新一轮对伊朗制裁措施之际，北京将密切关注事态发展，并采取必要措施维护自身合法权益。因为预计此次美国制裁将针对与伊朗开展贸易的合作伙伴，而中国购买了伊朗海运石油的80%以上。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E7%BE%8E%E5%9B%BD%E5%85%AC%E5%B8%83%E5%88%B6%E8%A3%81%E4%BC%8A%E6%9C%97%E6%96%B9%E6%A1%88%E5%89%8D%EF%BC%8C%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%B0%86-%E9%87%87%E5%8F%96%E5%BF%85%E8%A6%81%E6%8E%AA%E6%96%BD%E7%BB%B4%E6%8A%A4%E8%87%AA%E8%BA%AB%E5%90%88%E6%B3%95%E6%9D%83%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561585000.webp","sourceId":"rfi"},{"id":1787561031000,"createdDate":"2026-08-24 08:43","name":"法国国际广播电台","title":"台湾总统宣布全民普发一万元遭在野批政治意味浓厚，究竟是「钱坑」还是「AI红利」？","content":"台湾总统赖清德17日宣布「AI红利，全民共享」，将编列预算全民普发一万元。此声明一出，引来在野党的质疑双重标准，且此举是否为选举绑桩。经济学家则担忧，台湾经济热潮下的K型经济，无法靠普发现金来解决。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260824-%E5%8F%B0%E6%B9%BE%E6%80%BB%E7%BB%9F%E5%AE%A3%E5%B8%83%E5%85%A8%E6%B0%91%E6%99%AE%E5%8F%91%E4%B8%80%E4%B8%87%E5%85%83%E9%81%AD%E5%9C%A8%E9%87%8E%E6%89%B9%E6%94%BF%E6%B2%BB%E6%84%8F%E5%91%B3%E6%B5%93%E5%8E%9A%EF%BC%8C%E7%A9%B6%E7%AB%9F%E6%98%AF-%E9%92%B1%E5%9D%91-%E8%BF%98%E6%98%AF-ai%E7%BA%A2%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787561031000.webp","sourceId":"rfi"},{"id":1787558881000,"createdDate":"2026-08-24 08:08","name":"法国国际广播电台","title":"欧盟再援乌61亿欧元，多国领导人周一会盟商讨援乌方案","content":"周一（8月24日），乌克兰的欧洲支持者们以线上或线下的方式齐聚一堂，共同商讨对乌援助。此次“志愿者联盟”成员国会议恰逢乌克兰独立35周年，会议将由英国、法国和德国共同主持。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260824-%E6%AC%A7%E7%9B%9F%E5%86%8D%E6%8F%B4%E4%B9%8C61%E4%BA%BF%E6%AC%A7%E5%85%83%EF%BC%8C%E5%A4%9A%E5%9B%BD%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%91%A8%E4%B8%80%E4%BC%9A%E7%9B%9F%E5%95%86%E8%AE%A8%E6%8F%B4%E4%B9%8C%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787558881000.webp","sourceId":"rfi"},{"id":1787553029000,"createdDate":"2026-08-24 06:30","name":"法国国际广播电台","title":"阿里巴巴在港以IPO集资800亿 港股史上最大宗 评论料科网巨头会仿效","content":"人工智能（AI）热潮席卷全球，科技巨头纷纷跟投，阿里巴巴更率先公布，拟向美国境外的非美国人士配售新股，筹资总额800亿港元(下同，折算约87.4亿欧元)，全部投资AI。这是阿里自2019年港股上市以来首次配售新股，一旦成功，将是港股史上最大公司配售新股集资行动。市场消息指，阿里的新股已获超额认购，但其股价今早在香港下跌约一成。不过，分析预料，其他科网巨头会跟随阿里集资「抽水」。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E9%98%BF%E9%87%8C%E5%B7%B4%E5%B7%B4%E5%9C%A8%E6%B8%AF%E4%BB%A5ipo%E9%9B%86%E8%B5%84800%E4%BA%BF-%E6%B8%AF%E8%82%A1%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E5%AE%97-%E8%AF%84%E8%AE%BA%E6%96%99%E7%A7%91%E7%BD%91%E5%B7%A8%E5%A4%B4%E4%BC%9A%E4%BB%BF%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787553029000.webp","sourceId":"rfi"},{"id":1787552803000,"createdDate":"2026-08-24 06:26","name":"法国国际广播电台","title":"美法四国要求释放支联会案被告 国际社会对香港人权案件回响减弱","content":"在香港举办逾三十年「六四(事件)」烛光晚会的香港市民支援爱国民主运动联合会(支联会)及其正副主席李卓人和邹幸彤被裁定煽动颠覆国家政权罪名成立後，至今有七个国家表态关注或谴责，当中四个要求立即释放被告；联合国秘书长古特罗斯的发言人被问及裁决时，亦只是重申任何人均应有和平表达和抗议的自由的立场。整体回响较之前广泛被视为侵扰港人权利的两宗国家安全案件弱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260824-%E7%BE%8E%E6%B3%95%E5%9B%9B%E5%9B%BD%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E8%A2%AB%E5%91%8A-%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%AF%B9%E9%A6%99%E6%B8%AF%E4%BA%BA%E6%9D%83%E6%A1%88%E4%BB%B6%E5%9B%9E%E5%93%8D%E5%87%8F%E5%BC%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/24/1787552803000.webp","sourceId":"rfi"}]