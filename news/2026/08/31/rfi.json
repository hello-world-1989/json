[{"id":1788191322000,"createdDate":"2026-08-31 15:48","name":"法国国际广播电台","title":"普京会见习近平提愿推动免签政策实现永久化 称铭记江泽民对俄中关系贡献","content":"当地时间周一下午，中国国家主席习近平在吉尔吉斯共和国首都比什凯克出席2026年上合组织峰会期间会见了俄罗斯总统普京。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E6%99%AE%E4%BA%AC%E4%BC%9A%E8%A7%81%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8F%90%E6%84%BF%E6%8E%A8%E5%8A%A8%E5%85%8D%E7%AD%BE%E6%94%BF%E7%AD%96%E5%AE%9E%E7%8E%B0%E6%B0%B8%E4%B9%85%E5%8C%96-%E7%A7%B0%E9%93%AD%E8%AE%B0%E6%B1%9F%E6%B3%BD%E6%B0%91%E5%AF%B9%E4%BF%84%E4%B8%AD%E5%85%B3%E7%B3%BB%E8%B4%A1%E7%8C%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788191322000.webp","sourceId":"rfi"},{"id":1788188202000,"createdDate":"2026-08-31 14:56","name":"法国国际广播电台","title":"驻华大使馆指“甲醛白菜”未入韩 韩国食药处负责人视察进口食品检验所","content":"韩国食品医药品安全处（下称“韩国食药处”）周一宣布，已通过韩国驻华大使馆确认，产自中国河北张家口的“甲醛白菜”并未进入韩国。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF%E9%A6%86%E6%8C%87-%E7%94%B2%E9%86%9B%E7%99%BD%E8%8F%9C-%E6%9C%AA%E5%85%A5%E9%9F%A9-%E9%9F%A9%E5%9B%BD%E9%A3%9F%E8%8D%AF%E5%A4%84%E8%B4%9F%E8%B4%A3%E4%BA%BA%E8%A7%86%E5%AF%9F%E8%BF%9B%E5%8F%A3%E9%A3%9F%E5%93%81%E6%A3%80%E9%AA%8C%E6%89%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788188202000.webp","sourceId":"rfi"},{"id":1788187861000,"createdDate":"2026-08-31 14:51","name":"法国国际广播电台","title":"连线国际空间站 法广/France24独家专访索菲·阿德诺-太空行走的首位法国女宇航员","content":"法国国际广播电台(RFI)和法国电视24日前独家专访正在国际太空站的法国女宇航员索菲·阿德诺(SophieAdenot)，作为法国在欧洲宇航局的新一代宇航员，44岁的阿德诺8月15日和25日先后两次从国际太空站出舱，执行更换太空站通讯天线的任务。她也成为首位完成太空行走的法国女宇航员。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260831-%E8%BF%9E%E7%BA%BF%E5%9B%BD%E9%99%85%E7%A9%BA%E9%97%B4%E7%AB%99-%E6%B3%95%E5%B9%BF-france24%E7%8B%AC%E5%AE%B6%E4%B8%93%E8%AE%BF%E7%B4%A2%E8%8F%B2%C2%B7%E9%98%BF%E5%BE%B7%E8%AF%BA-%E5%A4%AA%E7%A9%BA%E8%A1%8C%E8%B5%B0%E7%9A%84%E9%A6%96%E4%BD%8D%E6%B3%95%E5%9B%BD%E5%A5%B3%E5%AE%87%E8%88%AA%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788187861000.webp","sourceId":"rfi"},{"id":1788185962000,"createdDate":"2026-08-31 14:19","name":"法国国际广播电台","title":"欧盟气候委员：在清洁能源技术诸多领域对华依赖过大，现在就应采取行动","content":"欧盟委员会气候、净零与清洁增长委员胡克斯特拉（WopkeHoekstra）警告称，对中国的依赖将推高欧盟绿色转型的成本，并表示要实现公平竞争环境，“别无他选”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260831-%E6%AC%A7%E7%9B%9F%E6%B0%94%E5%80%99%E5%A7%94%E5%91%98-%E5%9C%A8%E6%B8%85%E6%B4%81%E8%83%BD%E6%BA%90%E6%8A%80%E6%9C%AF%E8%AF%B8%E5%A4%9A%E9%A2%86%E5%9F%9F%E5%AF%B9%E5%8D%8E%E4%BE%9D%E8%B5%96%E8%BF%87%E4%BA%8E%E5%BA%9E%E5%A4%A7%EF%BC%8C%E7%8E%B0%E5%9C%A8%E5%B0%B1%E5%BA%94%E9%87%87%E5%8F%96%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788185962000.webp","sourceId":"rfi"},{"id":1788185886000,"createdDate":"2026-08-31 14:18","name":"法国国际广播电台","title":"日本超党派议员代表团访华能为冰河期的日中关系找到突破口吗？","content":"在日中关系分外紧张之际，由日本跨党派国会议员组成的代表团8月24日从羽田机场启程前往北京，在“日中关系处于1972年以来最糟糕的状态”（见伊佐进一8月19日X）中访华。此次访华的是超党派议员联盟“日中次世代交流委员会”3名议员，他们分别是：自民党前厚生劳动副大臣桥本岳、中道改革联盟宣传委员长伊佐进一、公明党参议院议员川村雄大。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260831-%E6%97%A5%E6%9C%AC%E8%B6%85%E5%85%9A%E6%B4%BE%E8%AE%AE%E5%91%98%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8D%8E%E8%83%BD%E4%B8%BA%E5%86%B0%E6%B2%B3%E6%9C%9F%E7%9A%84%E6%97%A5%E4%B8%AD%E5%85%B3%E7%B3%BB%E6%89%BE%E5%88%B0%E7%AA%81%E7%A0%B4%E5%8F%A3%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788185886000.webp","sourceId":"rfi"},{"id":1788185624000,"createdDate":"2026-08-31 14:13","name":"法国国际广播电台","title":"20大上成功带走胡锦涛 孔绍逊今传晋官","content":"据台媒今天透露，2022年中共二十大闭幕式上，前总书记胡锦涛突然被带离会场；当时奉中国国家主席习近平之命，在现场协助架走胡锦涛的中共中央办公厅副主任孔绍逊，如今仕途再进一步。在中共今年8月28日召开中央政治局会议后，孔绍逊29日即首度以甘肃省委副书记、甘肃省政府党组书记身份亮相。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260831-20%E5%A4%A7%E4%B8%8A%E6%88%90%E5%8A%9F%E5%B8%A6%E8%B5%B0%E8%83%A1%E9%94%A6%E6%B6%9B-%E5%AD%94%E7%BB%8D%E9%80%8A%E4%BB%8A%E4%BC%A0%E6%99%8B%E5%AE%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788185624000.webp","sourceId":"rfi"},{"id":1788185366000,"createdDate":"2026-08-31 14:09","name":"法国国际广播电台","title":"专访台湾学者方天赐：中印关系的未来，是“龙象之争”还是“龙象共舞”？","content":"在上一期节目中，台湾国立清华大学印度中心主任方天赐先生做客本台，为我们详细解读了近期由印度Z世代年轻人推动的“蟑螂人民党”抗议运动。方先生长期关注印度政治、中印关系以及南亚地区的发展，并曾多年驻地印度，对印度社会有着深入的观察和研究。本期节目，我们将继续围绕印度这一主题，将目光从印度国内转向中印关系，与方先生一起探讨：随着印度不断崛起，中印之间的竞争正在发生怎样的变化？这种竞争又将对两国关系以及未来的亚洲格局产生怎样的影响？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20260831-%E4%B8%AD%E5%8D%B0%E5%85%B3%E7%B3%BB%E7%9A%84%E6%9C%AA%E6%9D%A5%EF%BC%8C%E6%98%AF-%E9%BE%99%E8%B1%A1%E4%B9%8B%E4%BA%89-%E8%BF%98%E6%98%AF-%E9%BE%99%E8%B1%A1%E5%85%B1%E8%88%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788185366000.webp","sourceId":"rfi"},{"id":1788185311000,"createdDate":"2026-08-31 14:08","name":"法国国际广播电台","title":"解放报：泛谈“中、美、俄帝国主义”的特征","content":"本台订阅的8月31日出刊的法国主流日刊当中，解放报以大篇幅聚焦了两位法国历史研究者的新作，该书题为“帝国主义的世界史”，当中重点提到了中国。我们在本期节目中，为您做综述。本台订阅的8月31日出刊的法国主流日刊当中，解放报以大篇幅聚焦了两位法国历史研究者的新作，该书题为“帝国主义的世界史”，当中重点提到了中国。我们在本期节目中为您做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260831-%E8%A7%A3%E6%94%BE%E6%8A%A5-%E6%B3%9B%E8%B0%88-%E4%B8%AD-%E7%BE%8E-%E4%BF%84%E5%B8%9D%E5%9B%BD%E4%B8%BB%E4%B9%89-%E7%9A%84%E7%89%B9%E5%BE%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788185311000.webp","sourceId":"rfi"},{"id":1788184292000,"createdDate":"2026-08-31 13:51","name":"法国国际广播电台","title":"上合组织峰会25周年：地区和国际影响力仍不大？","content":"成立25周年的上海合作组织（上合组织）周一开始在吉尔吉斯斯坦首都比什凯克举行峰会。除俄罗斯总统普京和中国国家主席习近平外，印度总理莫迪和伊朗总统佩泽什基扬等十几位国家元首带着各自的目的出席。有专家认为，这个组织更是“中国外交政策的工具”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260831-%E4%B8%8A%E5%90%88%E7%BB%84%E7%BB%87%E5%B3%B0%E4%BC%9A25%E5%91%A8%E5%B9%B4-%E5%9C%B0%E5%8C%BA%E5%92%8C%E5%9B%BD%E9%99%85%E6%95%88%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788184292000.webp","sourceId":"rfi"},{"id":1788183090000,"createdDate":"2026-08-31 13:31","name":"法国国际广播电台","title":"中国广东东莞中级法院裁定冻结安世约3 亿美元资产","content":"中国一家法院冻结了荷兰芯片制造商安世半导体(Nexperia)及其设备部门高达21.4亿元人民币约合3亿美元在中国的资产，冻结措施自2026年8月25日生效，并将持续至2029年8月。此前该公司在中国母公司闻泰科技曾经提起诉讼。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260831-%E4%B8%AD%E5%9B%BD%E5%B9%BF%E4%B8%9C%E4%B8%9C%E8%8E%9E%E4%B8%AD%E7%BA%A7%E6%B3%95%E9%99%A2%E8%A3%81%E5%AE%9A%E5%86%BB%E7%BB%93%E5%AE%89%E4%B8%96%E7%BA%A63-%E4%BA%BF%E7%BE%8E%E5%85%83%E8%B5%84%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788183090000.webp","sourceId":"rfi"},{"id":1788182154000,"createdDate":"2026-08-31 13:15","name":"法国国际广播电台","title":"中方批评将泥石流灾害归咎于中国的“恶意揣测” 网警公布10起网络谣言案例","content":"针对一些印度评论人士的说法，中国外交部发言人进行了反驳；这些评论人士曾就中方是否应为上周发生在中尼边境的致命泥石流事件负责展开了争论。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E4%B8%AD%E6%96%B9%E6%89%B9%E8%AF%84%E5%B0%86%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%81%BE%E5%AE%B3%E5%BD%92%E5%92%8E%E4%BA%8E%E4%B8%AD%E5%9B%BD%E7%9A%84-%E6%81%B6%E6%84%8F%E6%8F%A3%E6%B5%8B-%E7%BD%91%E8%AD%A6%E5%85%AC%E5%B8%8310%E8%B5%B7%E7%BD%91%E7%BB%9C%E8%B0%A3%E8%A8%80%E6%A1%88%E4%BE%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788182154000.webp","sourceId":"rfi"},{"id":1788176903000,"createdDate":"2026-08-31 11:48","name":"法国国际广播电台","title":"贝森特否认特朗普政府不愿就伊朗问题与中国对抗 称“所有选项都在桌上”","content":"美国财政部长贝森特（ScottBessent）周日在受访时表示，美国财政部可能会出台每周一次的新二级制裁，旨在加大对伊朗政权的经济压力，而首要目标将是相关银行。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E8%B4%9D%E6%A3%AE%E7%89%B9%E5%90%A6%E8%AE%A4%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E4%B8%8D%E6%84%BF%E5%B0%B1%E4%BC%8A%E6%9C%97%E9%97%AE%E9%A2%98%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%AF%B9%E6%8A%97-%E7%A7%B0-%E6%89%80%E6%9C%89%E9%80%89%E9%A1%B9%E9%83%BD%E5%9C%A8%E6%A1%8C%E4%B8%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788176903000.webp","sourceId":"rfi"},{"id":1788175171000,"createdDate":"2026-08-31 11:19","name":"法国国际广播电台","title":"美国财政部禁止部分记者采访G20财长会议","content":"美国财政部拒绝向部分美国媒体记者发放二十国集团（G20）财长会议的采访证，特别是《纽约时报》和彭博社的记者。这两家媒体认为，财政部此举侵犯了新闻自由。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E7%BE%8E%E5%9B%BD%E8%B4%A2%E6%94%BF%E9%83%A8%E7%A6%81%E6%AD%A2%E9%83%A8%E5%88%86%E8%AE%B0%E8%80%85%E9%87%87%E8%AE%BFg20%E8%B4%A2%E9%95%BF%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788175171000.webp","sourceId":"rfi"},{"id":1788171989000,"createdDate":"2026-08-31 10:26","name":"法国国际广播电台","title":"日防卫省2027财年预算申请创新高达8.89万亿日元 年底或进一步增加","content":"据共同社报导，日本防卫省周一（31日）公布了2027财年预算申请。为加强“反击能力”（原“对敌基地攻击能力”），将研发结合长射程导弹使用的攻击型无人机。为应对“新型作战方式”，将在日本自卫队的指挥控制中引入人工智能（AI）。此外还写入，为能够应对战事长期化的事态，将实现防备装备品的制造工厂国有化，并设立委托民间企业管理的制度。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E6%97%A5%E9%98%B2%E5%8D%AB%E7%9C%812027%E8%B4%A2%E5%B9%B4%E9%A2%84%E7%AE%97%E7%94%B3%E8%AF%B7%E5%88%9B%E6%96%B0%E9%AB%98%E8%BE%BE8-89%E4%B8%87%E4%BA%BF%E6%97%A5%E5%85%83-%E5%B9%B4%E5%BA%95%E6%88%96%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%A2%9E%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788171989000.webp","sourceId":"rfi"},{"id":1788168994000,"createdDate":"2026-08-31 09:36","name":"法国国际广播电台","title":"中国将开展军品产业链、供应链安全评估工作 提升韧性和安全水平","content":"中国将着手审查其军事供应链的安全性，致力于提升国防工业的自主能力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260831-%E4%B8%AD%E5%9B%BD%E5%B0%86%E5%BC%80%E5%B1%95%E5%86%9B%E5%93%81%E4%BA%A7%E4%B8%9A%E9%93%BE-%E4%BE%9B%E5%BA%94%E9%93%BE%E5%AE%89%E5%85%A8%E8%AF%84%E4%BC%B0%E5%B7%A5%E4%BD%9C-%E6%8F%90%E5%8D%87%E9%9F%A7%E6%80%A7%E5%92%8C%E5%AE%89%E5%85%A8%E6%B0%B4%E5%B9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788168994000.webp","sourceId":"rfi"},{"id":1788167317000,"createdDate":"2026-08-31 09:08","name":"法国国际广播电台","title":"贝森特：世界不能有一个拥有1.2万亿美元贸易顺差的中国","content":"美国财政部长贝森特（ScottBessent）周日表示，将鼓励二十国集团（G20）成员重新审视与中国的贸易条款，以缩小全球贸易失衡，并敦促中方调整经济结构，从依赖出口转向依靠国内消费。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260831-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E4%B8%96%E7%95%8C%E4%B8%8D%E8%83%BD%E6%9C%89%E4%B8%80%E4%B8%AA%E6%8B%A5%E6%9C%891-2%E4%B8%87%E4%BA%BF%E7%BE%8E%E5%85%83%E8%B4%B8%E6%98%93%E9%A1%BA%E5%B7%AE%E7%9A%84%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788167317000.webp","sourceId":"rfi"},{"id":1788166898000,"createdDate":"2026-08-31 09:01","name":"法国国际广播电台","title":"多位领导人“缺席”帕劳太平洋岛国论坛峰会 中国无处不在？","content":"太平洋岛国论坛峰会周一在帕劳召开，但最终有五位领导人缺席“抵制”或面临代表权变动，引发了外界对该区域组织内部团结的关注。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E5%A4%9A%E4%BD%8D%E9%A2%86%E5%AF%BC%E4%BA%BA-%E7%BC%BA%E5%B8%AD-%E5%B8%95%E5%8A%B3%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B3%B0%E4%BC%9A-%E4%B8%AD%E5%9B%BD%E6%97%A0%E5%A4%84%E4%B8%8D%E5%9C%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788166898000.webp","sourceId":"rfi"},{"id":1788165344000,"createdDate":"2026-08-31 08:35","name":"法国国际广播电台","title":"欧洲思想文化长廊: 希腊:欧洲文化永不磨灭的光辉第7：雅典的黄金时代之1：建造雅典","content":"伯里克利主政雅典带来了民主政治的成熟和精神文化的繁荣。同时他重建被波斯人破坏的雅典城，使雅典呈现出雄伟壮丽的新面貌。在自由的氛围中，各路天才汇集雅典，艺术、哲学、戏剧、文学杰作层出不穷，留下的遗产让后世享受不尽。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260831-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC7-%E9%9B%85%E5%85%B8%E7%9A%84%E9%BB%84%E9%87%91%E6%97%B6%E4%BB%A3%E4%B9%8B1-%E5%BB%BA%E9%80%A0%E9%9B%85%E5%85%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788165344000.webp","sourceId":"rfi"},{"id":1788165097000,"createdDate":"2026-08-31 08:31","name":"法国国际广播电台","title":"日本首相高市早苗宣布日本船只全部安全撤离波斯湾","content":"日本首相高市早苗首相于2026年8月30日在X上发文称：由于霍尔木兹海峡危机，滞留在波斯湾内的日本船舶中全部日本籍船员已于6月19日前安全撤出，所有日本籍船舶也已于7月9日前安全驶离波斯湾。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%AE%A3%E5%B8%83%E6%97%A5%E6%9C%AC%E8%88%B9%E5%8F%AA%E5%85%A8%E9%83%A8%E5%AE%89%E5%85%A8%E6%92%A4%E7%A6%BB%E6%B3%A2%E6%96%AF%E6%B9%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788165097000.webp","sourceId":"rfi"},{"id":1788164989000,"createdDate":"2026-08-31 08:29","name":"法国国际广播电台","title":"中国修订《国防动员法》加入平战快速转换 为台海冲突进行法律铺路？","content":"中国修订新版《国防动员法》，新增保障平战快速转换。民进党表示，此举释放政治讯号，台湾位在第一岛链最前线，应加强国家安全防卫意识，与整体防卫韧性。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260831-%E4%B8%AD%E5%9B%BD%E4%BF%AE%E8%AE%A2-%E5%9B%BD%E9%98%B2%E5%8A%A8%E5%91%98%E6%B3%95-%E5%8A%A0%E5%85%A5%E5%B9%B3%E6%88%98%E5%BF%AB%E9%80%9F%E8%BD%AC%E6%8D%A2-%E4%B8%BA%E5%8F%B0%E6%B5%B7%E5%86%B2%E7%AA%81%E8%BF%9B%E8%A1%8C%E6%B3%95%E5%BE%8B%E9%93%BA%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788164989000.webp","sourceId":"rfi"},{"id":1788210933000,"createdDate":"2026-08-31 21:15","name":"法国国际广播电台","title":"民主刚果埃博拉病毒确诊病例已超过6000例，其中2911人病逝","content":"刚果民主共和国政府8月31日公布的资料显示，当地埃博拉病毒确诊病例已超过6000例，其中2911人病逝。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260831-%E6%B0%91%E4%B8%BB%E5%88%9A%E6%9E%9C%E5%9F%83%E5%8D%9A%E6%8B%89%E7%97%85%E6%AF%92%E7%A1%AE%E8%AF%8A%E7%97%85%E4%BE%8B%E5%B7%B2%E8%B6%85%E8%BF%876000%E4%BE%8B%EF%BC%8C%E5%85%B6%E4%B8%AD2911%E4%BA%BA%E7%97%85%E9%80%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788210933000.webp","sourceId":"rfi"},{"id":1788209879000,"createdDate":"2026-08-31 20:57","name":"法国国际广播电台","title":"中非:山体滑坡后金矿坍塌停产","content":"在中非共和国（RCA-Républiquecentrafricaine）纳纳-曼贝雷省（Nana-Mambéré）境内、与邻国喀麦隆（leCameroun）接壤的边境村庄赞波伊（Zamboï）或赞博耶（Zamboyé），一座手工开采的金矿于两周前2026年08月18日因山体滑坡造成坍塌，人员伤亡惨重。本台法广非洲组（RFIAfrique）今天2026年08月31日周一刊出特派记者（envoyéspécial）发自矿难现场的法文采访报导说，官方统计显示，这出悲剧的死亡人数现已攀升至近50人。事发矿山目前仍处于关闭状态，当地经济陷入瘫痪。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260831-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E4%B8%AD%E9%9D%9E-%E5%B1%B1%E4%BD%93%E6%BB%91%E5%9D%A1%E5%90%8E%E9%87%91%E7%9F%BF%E5%9D%8D%E5%A1%8C%E5%81%9C%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788209879000.webp","sourceId":"rfi"},{"id":1788208715000,"createdDate":"2026-08-31 20:38","name":"法国国际广播电台","title":"法前总理巴拉迪尔（Édouard Balladur）去世  享年97岁","content":"法国前总理爱德华·巴拉迪尔（ÉdouardBalladur）周一在巴黎去世，享年97岁，这是他家属向法新社透露的消息。法国总统马克龙赞扬他心系法国、人民的公仆。前总统萨科齐表示，多我而言，我失去了一位榜样、恩师、挚友。萨科齐说，今晚，我为失去生命中最重要的人而感到悲哀。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260831-%E6%B3%95%E5%89%8D%E6%80%BB%E7%90%86%E5%B7%B4%E6%8B%89%E8%BF%AA%E5%B0%94-%C3%A9douard-balladur-%E5%8E%BB%E4%B8%96-%E4%BA%AB%E5%B9%B497%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788208715000.webp","sourceId":"rfi"},{"id":1788208502000,"createdDate":"2026-08-31 20:35","name":"法国国际广播电台","title":"欧盟宣布暂停进口巴西肉类","content":"欧盟宣布将从周四起暂停进口巴西禽肉和牛肉，等待巴西方面就其产品是否符合欧盟卫生法规做出保证。欧盟委员会批评巴西未能提供充分保证，证明其产品符合欧盟关于畜牧业滥用抗生素的规定。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260831-%E6%AC%A7%E7%9B%9F%E5%AE%A3%E5%B8%83%E6%9A%82%E5%81%9C%E8%BF%9B%E5%8F%A3%E5%B7%B4%E8%A5%BF%E8%82%89%E7%B1%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788208502000.webp","sourceId":"rfi"},{"id":1788208239000,"createdDate":"2026-08-31 20:30","name":"法国国际广播电台","title":"为中期选举过关   特朗普将会见石油公司高管","content":"白宫周一宣布，美国总统特朗普将于周二会见石油公司高管。此举旨在遏制不断上涨的汽油价格，而汽油价格上涨对于即将到来的11月中期选举至关重要，目前共和党的选情并不乐观。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260831-%E4%B8%BA%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E8%BF%87%E5%85%B3-%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%86%E4%BC%9A%E8%A7%81%E7%9F%B3%E6%B2%B9%E5%85%AC%E5%8F%B8%E9%AB%98%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788208239000.webp","sourceId":"rfi"},{"id":1788208081000,"createdDate":"2026-08-31 20:28","name":"法国国际广播电台","title":"华盛顿否认油轮试图穿越霍尔木兹时触雷","content":"美国军方否认伊朗方面关于一艘油轮在“非法”穿越霍尔木兹海峡时触雷而无法航行的报道。美国中央司令部中东分部在X网站上发文谴责该说法为“虚假信息”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%90%A6%E8%AE%A4%E6%B2%B9%E8%BD%AE%E8%AF%95%E5%9B%BE%E7%A9%BF%E8%B6%8A%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%97%B6%E8%A7%A6%E9%9B%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788208081000.webp","sourceId":"rfi"},{"id":1788207950000,"createdDate":"2026-08-31 20:25","name":"法国国际广播电台","title":"Shein在香港上市   筹集17亿美元","content":"快时尚巨头Shein周一宣布，其备受瞩目的香港首次公开募股（IPO）筹集了17亿美元资金，该在线零售商的估值为263亿美元，低于之前的预期。希音控股国际有限公司（Shein）以每股48.56港元的价格发售了2.8亿股股票，这一价格低于此前公布的最高发行价49.50港元。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-shein%E5%9C%A8%E9%A6%99%E6%B8%AF%E4%B8%8A%E5%B8%82-%E7%AD%B9%E9%9B%8617%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788207950000.webp","sourceId":"rfi"},{"id":1788207843000,"createdDate":"2026-08-31 20:24","name":"法国国际广播电台","title":"霍尔木兹海峡：美国军事金融双施压逼伊朗重回谈判桌","content":"伊朗伊斯兰革命卫队（IRGC）周一（8月31日）称，一艘超级油轮在通过霍尔木兹海峡时触雷并被迫停航。美军中央司令部（U.S.CentralCommand）随即予以驳斥。此次言语交锋发生在美伊于该战略咽喉要道爆发新一轮冲突之后。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260831-%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E7%BE%8E%E5%9B%BD%E5%86%9B%E4%BA%8B%E9%87%91%E8%9E%8D%E5%8F%8C%E6%96%BD%E5%8E%8B%E9%80%BC%E4%BC%8A%E6%9C%97%E9%87%8D%E5%9B%9E%E8%B0%88%E5%88%A4%E6%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788207843000.webp","sourceId":"rfi"},{"id":1788207793000,"createdDate":"2026-08-31 20:23","name":"法国国际广播电台","title":"第六届世界游牧民族运动会开幕","content":"第六届世界游牧民族运动会开幕式于2026年8月31日在比什凯克的\"比什凯克\"体育场举行，并与吉尔吉斯共和国独立日庆典一起举办。俄罗斯总统普京、伊朗总统佩泽什基扬、土耳其总统埃尔多安和联合国秘书长古特雷斯出席了开幕式。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E7%AC%AC%E5%85%AD%E5%B1%8A%E4%B8%96%E7%95%8C%E6%B8%B8%E7%89%A7%E6%B0%91%E6%97%8F%E8%BF%90%E5%8A%A8%E4%BC%9A%E5%BC%80%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788207793000.webp","sourceId":"rfi"},{"id":1788207502000,"createdDate":"2026-08-31 20:18","name":"法国国际广播电台","title":"伊朗因2026年抗议活动判处两名女性死刑","content":"伊朗法院判处两名因参与一月份反政府抗议活动而被控的女性死刑；与此同时，德黑兰方面正加紧处决在这些示威活动中被捕的人员。这两名女性的案件虽各自独立，但均与中部城市伊斯法罕（Isfahan）发生的事件有关；该市是全国性抗议活动的中心之一，抗议浪潮在1月8日和9日晚间达到顶峰。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E4%BC%8A%E6%9C%97%E5%9B%A02026%E5%B9%B4%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8%E5%88%A4%E5%A4%84%E4%B8%A4%E5%90%8D%E5%A5%B3%E6%80%A7%E6%AD%BB%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788207502000.webp","sourceId":"rfi"},{"id":1788207271000,"createdDate":"2026-08-31 20:14","name":"法国国际广播电台","title":"“吉他之都”：中国政府成功扶持的行业","content":"中国吉他制造之乡是2015年国家机械委质量司授予贵州省遵义市正安县的称号。该县自2013年起发展吉他产业并建设产业园，已入驻134家吉他及配套企业，年产吉他200余万把。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E5%90%89%E4%BB%96%E4%B9%8B%E9%83%BD-%E4%B8%AD%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%88%90%E5%8A%9F%E6%89%B6%E6%8C%81%E7%9A%84%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788207271000.webp","sourceId":"rfi"},{"id":1788203651000,"createdDate":"2026-08-31 19:14","name":"法国国际广播电台","title":"特朗普称美国反对数据中心“中国会很高兴”","content":"美国总统特朗普（DonaldTrump）强力捍卫人工智能（AI）资料中心，警告反对这类设施的美国社区可能错失投资、工作与税收，甚至变得“落后又贫穷”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260831-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E7%BE%8E%E5%9B%BD%E5%8F%8D%E5%AF%B9%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83-%E4%B8%AD%E5%9B%BD%E4%BC%9A%E5%BE%88%E9%AB%98%E5%85%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788203651000.webp","sourceId":"rfi"},{"id":1788200370000,"createdDate":"2026-08-31 18:19","name":"法国国际广播电台","title":"瑞典向法国采购4艘新型护卫舰","content":"瑞典首相克里斯特松（UlfKristersson）与法国总统马克龙于2026年8月31日在斯德哥尔摩正式签署了总金额约43亿欧元的军购合同，瑞典将向法国海军集团采购4艘新型“防御与干预护卫舰”（FDI）。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260831-%E7%91%9E%E5%85%B8%E5%90%91%E6%B3%95%E5%9B%BD%E9%87%87%E8%B4%AD4%E8%89%98%E6%96%B0%E5%9E%8B%E6%8A%A4%E5%8D%AB%E8%88%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788200370000.webp","sourceId":"rfi"},{"id":1788197001000,"createdDate":"2026-08-31 17:23","name":"法国国际广播电台","title":"梅西挥泪告别国家队","content":"里奥·梅西（LionelMessi）已于2026年8月31日正式宣布从阿根廷国家队退役。不过，他目前并未完全退役，他与美国职业足球大联盟（MLS）俱乐部迈阿密国际（InterMiami）的合同将一直持续到2028年底。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260831-%E6%A2%85%E8%A5%BF%E6%8C%A5%E6%B3%AA%E5%91%8A%E5%88%AB%E5%9B%BD%E5%AE%B6%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788197001000.webp","sourceId":"rfi"},{"id":1788193133000,"createdDate":"2026-08-31 16:18","name":"法国国际广播电台","title":"芬兰总统：王毅告诉我中方绝不会允许俄罗斯使用核武器","content":"芬兰总统斯图布（AlexanderStubb）近日在受访时表示，中方已私下向其保证，不会允许俄罗斯使用核武器。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260831-%E8%8A%AC%E5%85%B0%E6%80%BB%E7%BB%9F-%E7%8E%8B%E6%AF%85%E5%91%8A%E8%AF%89%E6%88%91%E4%B8%AD%E6%96%B9%E7%BB%9D%E4%B8%8D%E4%BC%9A%E5%85%81%E8%AE%B8%E4%BF%84%E7%BD%97%E6%96%AF%E4%BD%BF%E7%94%A8%E6%A0%B8%E6%AD%A6%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788193133000.webp","sourceId":"rfi"},{"id":1788219883000,"createdDate":"2026-08-31 23:44","name":"法国国际广播电台","title":"一场泥石流灾害暴露了习近平喜马拉雅战略的最大弱点","content":"","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260831-%E4%B8%80%E5%9C%BA%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%81%BE%E5%AE%B3%E6%9A%B4%E9%9C%B2%E4%BA%86%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E6%88%98%E7%95%A5%E7%9A%84%E6%9C%80%E5%A4%A7%E5%BC%B1%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788219883000.webp","sourceId":"rfi"},{"id":1788218272000,"createdDate":"2026-08-31 23:17","name":"法国国际广播电台","title":"非洲:尼日尔未遂兵变引发疑问","content":"在非洲萨赫勒地区（SAHEL），内陆国尼日尔（leNiger）军政府首脑在挫败2026年08月29日上周六发生的未遂兵变两天后，该国首都度过了第二个相对平静的夜晚。这是本台法广非洲组（RFIAfrique）2026年08月31日周一上网的法文消息之一。事发时，哗变的特种部队士兵与获俄罗斯雇佣兵支持的总统卫队之间发生激烈冲突，当局至今尚未公布伤亡人数。接受本台法语记者采访的贝宁学者分析认为，这次的兵变会在尼日尔军中留下创伤。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260831-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%B0%BC%E6%97%A5%E5%B0%94%E6%9C%AA%E9%81%82%E5%85%B5%E5%8F%98%E5%BC%95%E5%8F%91%E7%96%91%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788218272000.webp","sourceId":"rfi"},{"id":1788212912000,"createdDate":"2026-08-31 21:48","name":"法国国际广播电台","title":"尼泊尔泥石流灾害共已造成950人死亡，近4500人失踪","content":"法新社报导，8月26日在尼泊尔与西藏边境发生的泥石流共已造成950人死亡，近4500人失踪。欧盟气候监测机构数据则指出，这场灾难已导致2500多栋建筑毁坏。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260831-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%81%BE%E5%AE%B3%E5%85%B1%E5%B7%B2%E9%80%A0%E6%88%90950%E4%BA%BA%E6%AD%BB%E4%BA%A1%EF%BC%8C%E8%BF%914500%E4%BA%BA%E5%A4%B1%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/31/1788212912000.webp","sourceId":"rfi"}]