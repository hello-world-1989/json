[{"id":1786956846000,"createdDate":"2026-08-17 08:54","name":"法国国际广播电台","title":"特朗普女婿库什纳赴耶路撒冷会晤以色列总理以期推进加沙和平方案","content":"美国总统特朗普的女婿兼总统特使贾里德-库什纳17日在耶路撒冷与以色列总理内塔尼亚胡会谈，以期推进特朗普的加沙和平方案。此前一天，库什纳在埃及首都开罗曾与巴勒斯坦激进伊斯兰武装哈马斯的领导人会晤。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260817-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A5%B3%E5%A9%BF%E5%BA%93%E4%BB%80%E7%BA%B3%E8%B5%B4%E8%80%B6%E8%B7%AF%E6%92%92%E5%86%B7%E4%BC%9A%E6%99%A4%E4%BB%A5%E8%89%B2%E5%88%97%E6%80%BB%E7%90%86%E4%BB%A5%E6%9C%9F%E6%8E%A8%E8%BF%9B%E5%8A%A0%E6%B2%99%E5%92%8C%E5%B9%B3%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786956846000.webp","sourceId":"rfi"},{"id":1786956687000,"createdDate":"2026-08-17 08:51","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第6.：伯里克利心目中的雅典特质","content":"在阐述了雅典民主制度的基本要素之后，伯里克利转而谈论公民的义务和这种义务带来的雅典人的道德观，以及他们所持守的人文价值。这些价值是雅典人所坚持和实行的。它实际上也是人类文明社会的核心价值。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260817-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC6-%E4%BC%AF%E9%87%8C%E5%85%8B%E5%88%A9%E5%BF%83%E7%9B%AE%E4%B8%AD%E7%9A%84%E9%9B%85%E5%85%B8%E7%89%B9%E8%B4%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786956687000.webp","sourceId":"rfi"},{"id":1786955992000,"createdDate":"2026-08-17 08:39","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第5：伯里克利的民主信念","content":"梭伦改革确立了雅典的民主制度。但在100多年的时间里，这个制度经历了严峻的考验。它经历庇西斯特拉图的僭主专制和希波战争，又在克里斯提尼的推动下重建，最后在古希腊最伟大的政治家伯里克利的领导下，雅典再次确定了它的民主信念。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260817-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC5-%E4%BC%AF%E9%87%8C%E5%85%8B%E5%88%A9%E7%9A%84%E6%B0%91%E4%B8%BB%E4%BF%A1%E5%BF%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786955992000.webp","sourceId":"rfi"},{"id":1786954943000,"createdDate":"2026-08-17 08:22","name":"法国国际广播电台","title":"日本外务大臣访问沙特、阿曼 谋取霍尔木兹海峡早期免费开放","content":"8月17日至8月22日，日本外务大臣茂木敏充访问沙特阿拉伯和阿曼，这是伊朗遭到攻击后，日本外务大臣首次访问中东。鉴于伊朗正在考虑向通过霍尔木兹海峡的船舶收取费用，日本此行旨在营造尽快实现霍尔木兹海峡的开放并继续实行免费通航的氛围。日本还将向海湾国家传达，日方将制定一揽子措施，支持那些受到伊朗袭击，基础设施受到影响的国家进行修复和重建。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260817-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E5%A4%A7%E8%87%A3%E8%AE%BF%E9%97%AE%E6%B2%99%E7%89%B9-%E9%98%BF%E6%9B%BC-%E8%B0%8B%E5%8F%96%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%97%A9%E6%9C%9F%E5%85%8D%E8%B4%B9%E5%BC%80%E6%94%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786954943000.webp","sourceId":"rfi"},{"id":1786951099000,"createdDate":"2026-08-17 07:18","name":"法国国际广播电台","title":"《经济学人》专栏指台湾民主被狭持中国成赢家 引蓝绿互相指责","content":"英国《经济学人》日前刊登一篇题为「狭持台湾民主」为题的文章，指出台湾自私自利的政客非但没有珍视台湾的民主，反而正在摧毁它。文章发表后，在台湾的媒体、社群和政坛上出现了「一篇专栏、各自表述」的景象。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E7%BB%8F%E6%B5%8E%E5%AD%A6%E4%BA%BA-%E4%B8%93%E6%A0%8F%E6%8C%87%E5%8F%B0%E6%B9%BE%E6%B0%91%E4%B8%BB%E8%A2%AB%E7%8B%AD%E6%8C%81%E4%B8%AD%E5%9B%BD%E6%88%90%E8%B5%A2%E5%AE%B6-%E5%BC%95%E8%93%9D%E7%BB%BF%E4%BA%92%E7%9B%B8%E6%8C%87%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786951099000.webp","sourceId":"rfi"},{"id":1786949673000,"createdDate":"2026-08-17 06:54","name":"法国国际广播电台","title":"朱鎔基遗体明天火化 为何悼念出现官凉民热现象？","content":"中国原总理朱鎔基的火化仪式将於明(18日)早在北京举行，从消息发放看来，规格应与「正国级」党和国家领导人标准看齐，但朱离世消息的发放和处理所展示的官凉民热丶内冷外热，却颇为突出。中国事务评论员刘锐绍向本台解释，这与不欲朱离世的消息遮盖今早举行的江泽民诞辰100周年大会，以致忧虑民情高涨会触发不安有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E6%9C%B1%E9%8E%94%E5%9F%BA%E9%81%97%E4%BD%93%E6%98%8E%E5%A4%A9%E7%81%AB%E5%8C%96-%E4%B8%BA%E4%BD%95%E6%82%BC%E5%BF%B5%E5%87%BA%E7%8E%B0%E5%AE%98%E5%87%89%E6%B0%91%E7%83%AD%E7%8E%B0%E8%B1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786949673000.webp","sourceId":"rfi"},{"id":1786949450000,"createdDate":"2026-08-17 06:50","name":"法国国际广播电台","title":"香港首半年GDP升 港府上调全年预测至3.5%至4.5% 惟仍较台湾和星洲逊色","content":"基於全球对人工智能(AI)相关电子产品需求殷切而带动外质，香港第二季的本地生产总值(GDP)增长达4.3%，增幅虽较第一季放缓，但仍令香港上半年的经济增长达5.1%，创近五年的半年新高，港府随之把全年经济增长预测调高一个百分点到「3.5%至4.5%」。不过，与同样受惠於AI相关产品的的台湾和区内竞争对手新加坡相比，香港的增幅却略为逊色，因为两地分别把全年经济预测上调至11.05%和「4.5%至5.5%」。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E9%A6%99%E6%B8%AF%E9%A6%96%E5%8D%8A%E5%B9%B4gdp%E5%8D%87-%E6%B8%AF%E5%BA%9C%E4%B8%8A%E8%B0%83%E5%85%A8%E5%B9%B4%E9%A2%84%E6%B5%8B%E8%87%B33-5-%E8%87%B34-5-%E6%83%9F%E4%BB%8D%E8%BE%83%E5%8F%B0%E6%B9%BE%E5%92%8C%E6%98%9F%E6%B4%B2%E9%80%8A%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786949450000.webp","sourceId":"rfi"},{"id":1786981807000,"createdDate":"2026-08-17 15:50","name":"法国国际广播电台","title":"乌克兰导弹袭俄罗斯别尔哥罗德州6人亡","content":"法新社17日周一引述当地当局宣布，乌克兰导弹袭击了俄罗斯边境附近的别尔哥罗德州，造成6人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260817-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%AF%BC%E5%BC%B9%E8%A2%AD%E4%BF%84%E7%BD%97%E6%96%AF%E5%88%AB%E5%B0%94%E5%93%A5%E7%BD%97%E5%BE%B7%E5%B7%9E6%E4%BA%BA%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786981807000.webp","sourceId":"rfi"},{"id":1786981296000,"createdDate":"2026-08-17 15:41","name":"法国国际广播电台","title":"法国野火：总理宣布向灾区提供财经援助","content":"法国总理勒克努周一宣布，将即刻展开对受大火肆虐的吉伦特省和朗德省的财务资助，以助当地受影响居民和企业赈灾。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260817-%E6%B3%95%E5%9B%BD%E9%87%8E%E7%81%AB-%E6%80%BB%E7%90%86%E5%8B%92%E5%85%8B%E5%8A%AA%E5%AE%A3%E5%B8%83%E6%8F%90%E4%BE%9B%E5%90%89%E4%BC%A6%E7%89%B9%E7%9C%81%E5%92%8C%E6%9C%97%E5%BE%B7%E7%9C%811%E5%8D%832%E7%99%BE%E4%B8%87%E6%AC%A7%E5%85%83%E5%8D%8F%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786981296000.webp","sourceId":"rfi"},{"id":1786981137000,"createdDate":"2026-08-17 15:38","name":"法国国际广播电台","title":"习近平主持纪念江泽民百年诞辰 警告中共准备应对重大考验","content":"习近平等一干中共高官周一在北京纪念已故中共领导人江泽民诞辰100周年。温家宝和王岐山出席了活动，但未见胡锦涛的身影。习近平警告说，新征程上，我们要积极应对风高浪急甚至惊涛骇浪的重大考验...","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260817-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%BB%E6%8C%81%E7%BA%AA%E5%BF%B5%E6%B1%9F%E6%B3%BD%E6%B0%91%E7%99%BE%E5%B9%B4%E8%AF%9E%E8%BE%B0-%E8%AD%A6%E5%91%8A%E4%B8%AD%E5%85%B1%E5%87%86%E5%A4%87%E5%BA%94%E5%AF%B9%E9%87%8D%E5%A4%A7%E8%80%83%E9%AA%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786981137000.webp","sourceId":"rfi"},{"id":1786980929000,"createdDate":"2026-08-17 15:35","name":"法国国际广播电台","title":"特朗普为大幅减少美韩联合军演规模辩称:首尔拒参与美国对伊朗无核化行动","content":"美国总统特朗普宣布“大幅减少”参与周一启动的美韩年度联合军演，除了提到他与金正恩的“非常良好的关系”之外，还批评首尔拒绝参与美国推动的伊朗无核化行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260817-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%BA%E5%A4%A7%E5%B9%85%E5%87%8F%E5%B0%91%E7%BE%8E%E9%9F%A9%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94%E8%A7%84%E6%A8%A1%E8%BE%A9%E7%A7%B0-%E9%A6%96%E5%B0%94%E6%8B%92%E5%8F%82%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%AF%B9%E4%BC%8A%E6%9C%97%E6%97%A0%E6%A0%B8%E5%8C%96%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786980929000.webp","sourceId":"rfi"},{"id":1786975504000,"createdDate":"2026-08-17 14:05","name":"法国国际广播电台","title":"特朗普宣布大幅缩编美韩年度军演规模意在向平壤示好？","content":"美国与韩国17日启动年度联合军演“乙支自由护盾”。然而就在演习启动前几小时，美国总统特朗普16日在他旗下的社交媒体“真相社交“平台上贴文称，他已要求五角大楼大幅缩减美韩联合军演规模。韩国国防部17日宣布这次联合军演已经如期启动。特朗普此番表述是否只是对韩国此前不愿参与美国对伊朗的军事行动而发泄不满不得而知，但它无疑令美国的东亚战略以及印太战略更多了一层模糊的面纱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260817-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%A4%A7%E5%B9%85%E7%BC%A9%E7%BC%96%E7%BE%8E%E9%9F%A9%E5%B9%B4%E5%BA%A6%E5%86%9B%E6%BC%94%E8%A7%84%E6%A8%A1%E6%84%8F%E5%9C%A8%E5%90%91%E5%B9%B3%E5%A3%A4%E7%A4%BA%E5%A5%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786975504000.webp","sourceId":"rfi"},{"id":1786965972000,"createdDate":"2026-08-17 11:26","name":"法国国际广播电台","title":"解放报谈：北戴河政治地位的变迁，其“不可见”黑幕始终如初","content":"据《解放报》亚太版日前（8月14日）报道，每年7月底至8月初，当北京进入一年中最闷热的时节，中国政治却悄然进入一个特殊的“夏季会议期”。自1953年以来，位于渤海之畔的北戴河便成为中国高官们每年度假的胜地，他们从七月底开始便在此秘密集会，商议国家重大政治决策。这一切都发生在暗流涌动的清洗与清算的背景下。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E8%A7%A3%E6%94%BE%E6%8A%A5%E8%B0%88-%E5%8C%97%E6%88%B4%E6%B2%B3%E6%94%BF%E6%B2%BB%E5%9C%B0%E4%BD%8D%E7%9A%84%E5%8F%98%E8%BF%81%EF%BC%8C%E5%85%B6-%E4%B8%8D%E5%8F%AF%E8%A7%81-%E9%BB%91%E5%B9%95%E5%A7%8B%E7%BB%88%E5%A6%82%E5%88%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786965972000.webp","sourceId":"rfi"},{"id":1786963888000,"createdDate":"2026-08-17 10:51","name":"法国国际广播电台","title":"法国宪法委员会的“中立性”与何谓“自由”的争议","content":"大家好，欢迎收听法国报纸摘要。周一8月17日出刊的法国日报的头版话题，除接连不断的热浪、干旱及随之而来的山火肆虐外，以国内事务为主。例如《回声报》关注债务问题指出：法国国债收益率飙升至2009年6月以来的最高水平。该报表示，全球债券市场再度出现紧张局势，推动法国10年期国债收益率在上周末升至4.05%。投资者对全球各地公共债务的失控状况日益担忧。另外，左翼《解放报》和右翼《费加罗报》同时评析了上周五（8月14日）法国宪法委员会公布了六项重大裁决，涉及社交媒体监管、安乐死合法化、农药使用等敏感话题，引发了政治界的全面争议。这些裁决让各政治派别既满意又不满，但也凸显了宪法委员会在政治极化背景下的独立性。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260817-%E6%B3%95%E5%9B%BD%E5%AE%AA%E6%B3%95%E5%A7%94%E5%91%98%E4%BC%9A%E7%9A%84-%E4%B8%AD%E7%AB%8B%E6%80%A7-%E4%B8%8E%E4%BD%95%E8%B0%93-%E8%87%AA%E7%94%B1-%E7%9A%84%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786963888000.webp","sourceId":"rfi"},{"id":1786961438000,"createdDate":"2026-08-17 10:10","name":"法国国际广播电台","title":"普京登上北方四岛中的择捉岛 中国持什么样的立场？","content":"俄罗斯总统普京13日登上北方四岛中的择捉岛，约2个小时后，中国驻日大使吴江浩与俄罗斯驻日大使诺兹德列夫联合发表署名文章《中国与俄罗斯——携手迈上新高度》的文章指出：“中俄双方一贯坚决反对一切歪曲否定二战胜利成果、为法西斯和军国主义翻案招魂的行径，严厉驳斥各类历史修正主义言行。”强调“二战胜利成果”不得否认。8月14日，在中国外交部发言人郭嘉昆主持的记者会上，《读卖新闻》记者问：13日，俄罗斯总统普京访问“北方四岛”（俄称“南千岛群岛”）中的“择捉岛”（俄称“伊图鲁普岛”）。然而“北方四岛”是日本领土。中方对此次访问有何评论？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260817-%E6%99%AE%E4%BA%AC%E7%99%BB%E4%B8%8A%E5%8C%97%E6%96%B9%E5%9B%9B%E5%B2%9B%E4%B8%AD%E7%9A%84%E6%8B%A9%E6%8D%89%E5%B2%9B-%E4%B8%AD%E5%9B%BD%E6%8C%81%E4%BB%80%E4%B9%88%E6%A0%B7%E7%9A%84%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786961438000.webp","sourceId":"rfi"},{"id":1786960897000,"createdDate":"2026-08-17 10:01","name":"法国国际广播电台","title":"赖清德宣布台湾2027年创纪录国防预算开支  称 “投资国防就是投资和平”","content":"台湾总统赖清德周一（8月17号）宣布，台湾政府将提出2027年度创纪录的国防预算，以“展现了台湾强化自我防卫能力的决心”。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E8%B5%96%E6%B8%85%E5%BE%B7%E5%AE%A3%E5%B8%83%E5%8F%B0%E6%B9%BE2027%E5%B9%B4%E5%88%9B%E7%BA%AA%E5%BD%95%E5%9B%BD%E9%98%B2%E9%A2%84%E7%AE%97%E5%BC%80%E6%94%AF-%E7%A7%B0-%E6%8A%95%E8%B5%84%E5%9B%BD%E9%98%B2%E5%B0%B1%E6%98%AF%E6%8A%95%E8%B5%84%E5%92%8C%E5%B9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786960897000.webp","sourceId":"rfi"},{"id":1786960182000,"createdDate":"2026-08-17 09:49","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第4：希腊城邦的政治运作与梭伦改革","content":"亚里士多德断言”人是政治的动物,天生适合生活在城邦中.”这就把人独具的政治特性与城邦生活联系在一起了。雅典公民的生活离不开政治，柏拉图甚至认为人的良好的道德生活就是良好的政治生活。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260817-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC4-%E5%B8%8C%E8%85%8A%E5%9F%8E%E9%82%A6%E7%9A%84%E6%94%BF%E6%B2%BB%E8%BF%90%E4%BD%9C%E4%B8%8E%E6%A2%AD%E4%BC%A6%E6%94%B9%E9%9D%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786960182000.webp","sourceId":"rfi"},{"id":1787003876000,"createdDate":"2026-08-17 21:57","name":"法国国际广播电台","title":"纪念江泽民习近平何以罕见地屡次提及六四","content":"8月17日召开的已故中共总书记江泽民纪念大会一如预测，规格极高，和毛邓看齐。中共领导人习近平发表长篇讲话，之前不少观察人士猜测其为何如此高调纪念江泽民冥诞百年，似乎能从今天的庄严然而暗含杀机的讲话中找到部分答案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E7%BA%AA%E5%BF%B5%E6%B1%9F%E6%B3%BD%E6%B0%91%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BD%95%E4%BB%A5%E7%BD%95%E8%A7%81%E5%9C%B0%E5%B1%A1%E6%AC%A1%E6%8F%90%E5%8F%8A%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787003876000.webp","sourceId":"rfi"},{"id":1787002696000,"createdDate":"2026-08-17 21:38","name":"法国国际广播电台","title":"美国战争部审查高校对外合作 转型孔子学院列入“受关注外国实体”范围","content":"美国战争部（原国防部）周一（8月17日）要求全美30所学术机构强制审查与中国、俄罗斯和伊朗等国机构开展的学术合作项目。由孔子学院转型或更名而来的机构，也被列入“受关注外国实体”范围。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E7%BE%8E%E5%9B%BD%E6%88%98%E4%BA%89%E9%83%A8%E5%AE%A1%E6%9F%A5%E9%AB%98%E6%A0%A1%E5%AF%B9%E5%A4%96%E5%90%88%E4%BD%9C-%E8%BD%AC%E5%9E%8B%E5%AD%94%E5%AD%90%E5%AD%A6%E9%99%A2%E5%88%97%E5%85%A5-%E5%8F%97%E5%85%B3%E6%B3%A8%E5%A4%96%E5%9B%BD%E5%AE%9E%E4%BD%93-%E8%8C%83%E5%9B%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787002696000.webp","sourceId":"rfi"},{"id":1787002370000,"createdDate":"2026-08-17 21:32","name":"法国国际广播电台","title":"法国推出山火灾后援助措施 总额或超过一亿欧元","content":"法国总统马克龙周一（8月17日）承诺，今年夏季遭受严重山火侵袭的瓦尔省将获得与吉伦特省相同的援助；总理勒科尔尼当天宣布一系列灾后纾困措施，整体援助金额可能超过一亿欧元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E6%B3%95%E5%9B%BD%E6%8E%A8%E5%87%BA%E5%B1%B1%E7%81%AB%E7%81%BE%E5%90%8E%E6%8F%B4%E5%8A%A9%E6%8E%AA%E6%96%BD-%E6%80%BB%E9%A2%9D%E6%88%96%E8%B6%85%E8%BF%87%E4%B8%80%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787002370000.webp","sourceId":"rfi"},{"id":1787002149000,"createdDate":"2026-08-17 21:29","name":"法国国际广播电台","title":"伊朗警告将升级对美行动 特朗普要求德黑兰让步","content":"一名伊朗高级官员周一（8月17日）对路透社表示，如果美国未来数周内不能全面落实临时和平协议，伊朗将升级霍尔木兹海峡及其他地区的紧张局势，并发动军事打击。美国总统特朗普威胁称，如果阿曼与伊朗就霍尔木兹海峡通航问题达成协议，美国将对阿曼实施打击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E5%B0%86%E5%8D%87%E7%BA%A7%E5%AF%B9%E7%BE%8E%E8%A1%8C%E5%8A%A8-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E6%B1%82%E5%BE%B7%E9%BB%91%E5%85%B0%E8%AE%A9%E6%AD%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787002149000.webp","sourceId":"rfi"},{"id":1787001993000,"createdDate":"2026-08-17 21:26","name":"法国国际广播电台","title":"特朗普宣布大幅减少美韩军演规模遭议员批评荒谬","content":"特朗普决定“大幅减少”美韩军演规模，不仅受到多位民主党议员谴责，还遭到一名共和党参议员批评。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%A4%A7%E5%B9%85%E5%87%8F%E5%B0%91%E7%BE%8E%E9%9F%A9%E5%86%9B%E6%BC%94%E8%A7%84%E6%A8%A1%E9%81%AD%E8%AE%AE%E5%91%98%E6%89%B9%E8%AF%84%E8%8D%92%E8%B0%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787001993000.webp","sourceId":"rfi"},{"id":1787001971000,"createdDate":"2026-08-17 21:26","name":"法国国际广播电台","title":"美国特使库什纳：希望哈马斯未来30天内开始解除武装","content":"美国特使库什纳周一（8月17日）表示，希望巴勒斯坦伊斯兰抵抗运动（哈马斯）在未来“30天内”开始解除武装，相关进程将由美国将军负责监督。库什纳周一与以色列总理内塔尼亚胡举行了会谈。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF%E5%BA%93%E4%BB%80%E7%BA%B3-%E5%B8%8C%E6%9C%9B%E5%93%88%E9%A9%AC%E6%96%AF%E6%9C%AA%E6%9D%A530%E5%A4%A9%E5%86%85%E5%BC%80%E5%A7%8B%E8%A7%A3%E9%99%A4%E6%AD%A6%E8%A3%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787001971000.webp","sourceId":"rfi"},{"id":1787001709000,"createdDate":"2026-08-17 21:21","name":"法国国际广播电台","title":"美媒：习近平9月访美与特朗普会谈 “无意参加联合国大会”","content":"美国政治新闻媒体Politico周一（8月17日）报导，中国国家主席习近平9月访美将在华盛顿与美国总统特朗普会面，届时习近平不会顺道前往纽约参加联合国大会发表演说。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-%E7%BE%8E%E5%AA%92-%E4%B9%A0%E8%BF%91%E5%B9%B39%E6%9C%88%E8%AE%BF%E7%BE%8E%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E4%BC%9A%E8%B0%88-%E6%97%A0%E6%84%8F%E5%8F%82%E5%8A%A0%E8%81%94%E5%90%88%E5%9B%BD%E5%A4%A7%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1787001709000.webp","sourceId":"rfi"},{"id":1786998649000,"createdDate":"2026-08-17 20:30","name":"法国国际广播电台","title":"联合国允毛里求斯印度洋拓海疆","content":"联合国（ONU）于上周刚刚批准印度洋中的非洲岛国毛里求斯（Maurice）享有围绕罗德里格斯岛（Rodrigues）周边14万7千平方公里面积的领海。就此，本台法广（RFI）非洲通讯员自路易港（Port-Louis）发回了毛里求斯总理办公室大陆架事务部(plateaucontinental)负责人的谈话录音片段。依照国际法，领海主权指沿海国对其领海及上空、海床、底土享有的主权和管辖权，是国家领土组成部分。毛里求斯的中文国名也有译作模里西斯（Mauritius）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260817-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E8%81%94%E5%90%88%E5%9B%BD%E5%85%81%E6%AF%9B%E9%87%8C%E6%B1%82%E6%96%AF%E5%8D%B0%E5%BA%A6%E6%B4%8B%E6%8B%93%E6%B5%B7%E7%96%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786998649000.webp","sourceId":"rfi"},{"id":1786995118000,"createdDate":"2026-08-17 19:31","name":"法国国际广播电台","title":"中俄拟在远东开展无人机、无人驾驶卡车等跨境合作","content":"综合路透社和塔斯社8月17日消息，中国和俄罗斯远东地区之间或将在不久后开展涉及无人机和自动驾驶卡车的相关合作。这是目前正在俄罗斯喀山举行的论坛上宣布的消息。据该论坛消息，俄罗斯计划启动国内低空经济建设试点项目。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260817-%E4%B8%AD%E4%BF%84%E6%8B%9F%E5%9C%A8%E8%BF%9C%E4%B8%9C%E5%BC%80%E5%B1%95%E6%97%A0%E4%BA%BA%E6%9C%BA-%E6%97%A0%E4%BA%BA%E9%A9%BE%E9%A9%B6%E5%8D%A1%E8%BD%A6%E7%AD%89%E8%B7%A8%E5%A2%83%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786995118000.webp","sourceId":"rfi"},{"id":1786991816000,"createdDate":"2026-08-17 18:36","name":"法国国际广播电台","title":"[南部非洲发展共同体]2026峰会","content":"简称[南共体]（SADC/CDAA）的[南部非洲发展共同体]旗下16个非洲国家于2026年08月17日星期一在南非港口城市德班（Durban）召开第46届首脑峰会。这是本台法广非洲组（RFIAfrique）的最新关注焦点之一。尤其是鉴于刚果民主共和国（RDCongo）东部地区冲突对军事和调动能力所带来的严峻考验，这一非洲次区组织是否还能在化解地区危机中起到作用？这成为了国际舆论的看点。就此，非洲的经济和革新战略专家AlKitenge在接受本台[非洲大咖嘉宾]栏目（LegrandinvitéAfrique）采访时谈到其个人分析。此外，本台非洲通讯员在来稿中则特别提到区内的非法移民问题。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260817-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E5%8D%97%E9%83%A8%E9%9D%9E%E6%B4%B2%E5%8F%91%E5%B1%95%E5%85%B1%E5%90%8C%E4%BD%93-2026%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786991816000.webp","sourceId":"rfi"},{"id":1786987860000,"createdDate":"2026-08-17 17:31","name":"法国国际广播电台","title":"约旦国王8月18日开始对中国进行正式访问","content":"中国外交部周一宣布，约旦国王阿卜杜拉二世将于周二起对中国进行为期数天的正式访问。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260817-%E7%BA%A6%E6%97%A6%E5%9B%BD%E7%8E%8B8%E6%9C%8818%E6%97%A5%E5%BC%80%E5%A7%8B%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%BF%9B%E8%A1%8C%E6%AD%A3%E5%BC%8F%E8%AE%BF%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786987860000.webp","sourceId":"rfi"},{"id":1786986154000,"createdDate":"2026-08-17 17:02","name":"法国国际广播电台","title":"巴基斯坦突袭一个电诈中心258人被捕 其中越南籍170人中国籍40人","content":"巴基斯坦当局周一宣布，在伊斯兰堡对一家诈骗呼叫中心进行突击搜查时，逮捕了258名外国人，其中包括40名中国公民。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260817-%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E7%AA%81%E8%A2%AD%E4%B8%80%E4%B8%AA%E7%94%B5%E8%AF%88%E4%B8%AD%E5%BF%83258%E4%BA%BA%E8%A2%AB%E6%8D%95-%E5%85%B6%E4%B8%AD%E8%B6%8A%E5%8D%97%E7%B1%8D170%E4%BA%BA%E4%B8%AD%E5%9B%BD%E7%B1%8D40%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786986154000.webp","sourceId":"rfi"},{"id":1786980955000,"createdDate":"2026-08-17 15:35","name":"法国国际广播电台","title":"SHEIN香港上市估值降至约250亿美元 较四年前大幅缩水四分之三","content":"路透社8月17日报道，中国快时尚电商巨头SHEIN在香港上市、最快本周开始接受IPO认购，公司估值为约250亿美元，仅为四年前一轮私募融资1000亿美元估值的四分之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260817-shein%E9%A6%99%E6%B8%AF%E4%B8%8A%E5%B8%82%E4%BC%B0%E5%80%BC%E9%99%8D%E8%87%B3%E7%BA%A6250%E4%BA%BF%E7%BE%8E%E5%85%83-%E8%BE%83%E5%9B%9B%E5%B9%B4%E5%89%8D%E4%BC%B0%E5%80%BC%E5%A4%A7%E5%B9%85%E7%BC%A9%E6%B0%B4%E5%9B%9B%E5%88%86%E4%B9%8B%E4%B8%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786980955000.webp","sourceId":"rfi"}]