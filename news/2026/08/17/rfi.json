[{"id":1786956846000,"createdDate":"2026-08-17 08:54","name":"法国国际广播电台","title":"特朗普女婿库什纳赴耶路撒冷会晤以色列总理以期推进加沙和平方案","content":"美国总统特朗普的女婿兼总统特使贾里德-库什纳17日在耶路撒冷与以色列总理内塔尼亚胡会谈，以期推进特朗普的加沙和平方案。此前一天，库什纳在埃及首都开罗曾与巴勒斯坦激进伊斯兰武装哈马斯的领导人会晤。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260817-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A5%B3%E5%A9%BF%E5%BA%93%E4%BB%80%E7%BA%B3%E8%B5%B4%E8%80%B6%E8%B7%AF%E6%92%92%E5%86%B7%E4%BC%9A%E6%99%A4%E4%BB%A5%E8%89%B2%E5%88%97%E6%80%BB%E7%90%86%E4%BB%A5%E6%9C%9F%E6%8E%A8%E8%BF%9B%E5%8A%A0%E6%B2%99%E5%92%8C%E5%B9%B3%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786956846000.webp","sourceId":"rfi"},{"id":1786956687000,"createdDate":"2026-08-17 08:51","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第6.：伯里克利心目中的雅典特质","content":"在阐述了雅典民主制度的基本要素之后，伯里克利转而谈论公民的义务和这种义务带来的雅典人的道德观，以及他们所持守的人文价值。这些价值是雅典人所坚持和实行的。它实际上也是人类文明社会的核心价值。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260817-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC6-%E4%BC%AF%E9%87%8C%E5%85%8B%E5%88%A9%E5%BF%83%E7%9B%AE%E4%B8%AD%E7%9A%84%E9%9B%85%E5%85%B8%E7%89%B9%E8%B4%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786956687000.webp","sourceId":"rfi"},{"id":1786955992000,"createdDate":"2026-08-17 08:39","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第5：伯里克利的民主信念","content":"梭伦改革确立了雅典的民主制度。但在100多年的时间里，这个制度经历了严峻的考验。它经历庇西斯特拉图的僭主专制和希波战争，又在克里斯提尼的推动下重建，最后在古希腊最伟大的政治家伯里克利的领导下，雅典再次确定了它的民主信念。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260817-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC5-%E4%BC%AF%E9%87%8C%E5%85%8B%E5%88%A9%E7%9A%84%E6%B0%91%E4%B8%BB%E4%BF%A1%E5%BF%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786955992000.webp","sourceId":"rfi"},{"id":1786954943000,"createdDate":"2026-08-17 08:22","name":"法国国际广播电台","title":"日本外务大臣访问沙特、阿曼 谋取霍尔木兹海峡早期免费开放","content":"8月17日至8月22日，日本外务大臣茂木敏充访问沙特阿拉伯和阿曼，这是伊朗遭到攻击后，日本外务大臣首次访问中东。鉴于伊朗正在考虑向通过霍尔木兹海峡的船舶收取费用，日本此行旨在营造尽快实现霍尔木兹海峡的开放并继续实行免费通航的氛围。日本还将向海湾国家传达，日方将制定一揽子措施，支持那些受到伊朗袭击，基础设施受到影响的国家进行修复和重建。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260817-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E5%A4%A7%E8%87%A3%E8%AE%BF%E9%97%AE%E6%B2%99%E7%89%B9-%E9%98%BF%E6%9B%BC-%E8%B0%8B%E5%8F%96%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%97%A9%E6%9C%9F%E5%85%8D%E8%B4%B9%E5%BC%80%E6%94%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786954943000.webp","sourceId":"rfi"},{"id":1786951099000,"createdDate":"2026-08-17 07:18","name":"法国国际广播电台","title":"《经济学人》专栏指台湾民主被狭持中国成赢家 引蓝绿互相指责","content":"英国《经济学人》日前刊登一篇题为「狭持台湾民主」为题的文章，指出台湾自私自利的政客非但没有珍视台湾的民主，反而正在摧毁它。文章发表后，在台湾的媒体、社群和政坛上出现了「一篇专栏、各自表述」的景象。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E7%BB%8F%E6%B5%8E%E5%AD%A6%E4%BA%BA-%E4%B8%93%E6%A0%8F%E6%8C%87%E5%8F%B0%E6%B9%BE%E6%B0%91%E4%B8%BB%E8%A2%AB%E7%8B%AD%E6%8C%81%E4%B8%AD%E5%9B%BD%E6%88%90%E8%B5%A2%E5%AE%B6-%E5%BC%95%E8%93%9D%E7%BB%BF%E4%BA%92%E7%9B%B8%E6%8C%87%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786951099000.webp","sourceId":"rfi"},{"id":1786949673000,"createdDate":"2026-08-17 06:54","name":"法国国际广播电台","title":"朱鎔基遗体明天火化 为何悼念出现官凉民热现象？","content":"中国原总理朱鎔基的火化仪式将於明(18日)早在北京举行，从消息发放看来，规格应与「正国级」党和国家领导人标准看齐，但朱离世消息的发放和处理所展示的官凉民热丶内冷外热，却颇为突出。中国事务评论员刘锐绍向本台解释，这与不欲朱离世的消息遮盖今早举行的江泽民诞辰100周年大会，以致忧虑民情高涨会触发不安有关。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E6%9C%B1%E9%8E%94%E5%9F%BA%E9%81%97%E4%BD%93%E6%98%8E%E5%A4%A9%E7%81%AB%E5%8C%96-%E4%B8%BA%E4%BD%95%E6%82%BC%E5%BF%B5%E5%87%BA%E7%8E%B0%E5%AE%98%E5%87%89%E6%B0%91%E7%83%AD%E7%8E%B0%E8%B1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786949673000.webp","sourceId":"rfi"},{"id":1786949450000,"createdDate":"2026-08-17 06:50","name":"法国国际广播电台","title":"香港首半年GDP升 港府上调全年预测至3.5%至4.5% 惟仍较台湾和星洲逊色","content":"基於全球对人工智能(AI)相关电子产品需求殷切而带动外质，香港第二季的本地生产总值(GDP)增长达4.3%，增幅虽较第一季放缓，但仍令香港上半年的经济增长达5.1%，创近五年的半年新高，港府随之把全年经济增长预测调高一个百分点到「3.5%至4.5%」。不过，与同样受惠於AI相关产品的的台湾和区内竞争对手新加坡相比，香港的增幅却略为逊色，因为两地分别把全年经济预测上调至11.05%和「4.5%至5.5%」。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260817-%E9%A6%99%E6%B8%AF%E9%A6%96%E5%8D%8A%E5%B9%B4gdp%E5%8D%87-%E6%B8%AF%E5%BA%9C%E4%B8%8A%E8%B0%83%E5%85%A8%E5%B9%B4%E9%A2%84%E6%B5%8B%E8%87%B33-5-%E8%87%B34-5-%E6%83%9F%E4%BB%8D%E8%BE%83%E5%8F%B0%E6%B9%BE%E5%92%8C%E6%98%9F%E6%B4%B2%E9%80%8A%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/17/1786949450000.webp","sourceId":"rfi"}]