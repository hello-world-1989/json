[{"id":1785802405000,"createdDate":"2026-08-04 00:13","name":"法国国际广播电台","title":"安踏：如何成了中国最成功的体育用品集团之一","content":"法国世界报周一刊出长篇报道，介绍中国体育运动集团安踏的发展战略。该报指出，安踏通过收购斐乐（Fila）、萨洛蒙（Salomon）、始祖鸟（Arc'teryx）、彪马（Puma）等国际品牌，并利用中国市场和高效管理，推动这些品牌实现增长。文章同时指出，安踏自主品牌的高端化进展却不及预期，反映出收购国际品牌与打造自主全球高端品牌之间仍然存在差距。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260804-%E5%AE%89%E8%B8%8F-%E5%A6%82%E4%BD%95%E6%88%90%E4%BA%86%E4%B8%AD%E5%9B%BD%E6%9C%80%E6%88%90%E5%8A%9F%E7%9A%84%E4%BD%93%E8%82%B2%E7%94%A8%E5%93%81%E9%9B%86%E5%9B%A2%E4%B9%8B%E4%B8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785802405000.webp","sourceId":"rfi"},{"id":1785802249000,"createdDate":"2026-08-04 00:10","name":"法国国际广播电台","title":"乌克兰消防员正在协助法国扑灭森林大火","content":"70名乌克兰消防员赶赴吉伦特省协助继续扑灭森林大火，法国是首次获得乌克兰消防队的增援。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260804-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%B6%88%E9%98%B2%E5%91%98%E6%AD%A3%E5%9C%A8%E5%8D%8F%E5%8A%A9%E6%B3%95%E5%9B%BD%E6%89%91%E7%81%AD%E6%A3%AE%E6%9E%97%E5%A4%A7%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785802249000.webp","sourceId":"rfi"},{"id":1785841123000,"createdDate":"2026-08-04 10:58","name":"法国国际广播电台","title":"“北戴河时间开启”：蔡奇现身却不见谌贻琴 官媒罕提战略科技专家受邀","content":"据路透社周一8月3日报道，中国共产党似乎已在海滨度假胜地北戴河启动其年度闭门会议。这一非正式的聚会每年都会引发高层干部权力角逐的传言，而今年会议前，党内将在10月召开一场关于党内治理的重要会议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260804-%E5%8C%97%E6%88%B4%E6%B2%B3%E6%97%B6%E9%97%B4%E5%BC%80%E5%90%AF-%E8%94%A1%E5%A5%87%E7%8E%B0%E8%BA%AB%E5%8D%B4%E4%B8%8D%E8%A7%81%E8%B0%8C%E8%B4%BB%E7%90%B4-%E5%AE%98%E5%AA%92%E7%BD%95%E6%8F%90%E6%88%98%E7%95%A5%E7%A7%91%E6%8A%80%E4%B8%93%E5%AE%B6%E5%8F%97%E9%82%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785841123000.webp","sourceId":"rfi"},{"id":1785840275000,"createdDate":"2026-08-04 10:44","name":"法国国际广播电台","title":"加拿大首个外国影响力登记制度周二正式生效 谁须进行登记含三项标准","content":"一个旨在进一步揭示加拿大境内由国家支持的外国影响力活动的、备受期待的登记制度于周二（8月4日）正式启动，但关于哪些主体必须进行登记的问题仍存在不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260804-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E9%A6%96%E4%B8%AA%E5%A4%96%E5%9B%BD%E5%BD%B1%E5%93%8D%E5%8A%9B%E7%99%BB%E8%AE%B0%E5%88%B6%E5%BA%A6%E5%91%A8%E4%BA%8C%E6%AD%A3%E5%BC%8F%E7%94%9F%E6%95%88-%E8%B0%81%E9%A1%BB%E8%BF%9B%E8%A1%8C%E7%99%BB%E8%AE%B0%E5%90%AB%E4%B8%89%E9%A1%B9%E6%A0%87%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785840275000.webp","sourceId":"rfi"},{"id":1785838127000,"createdDate":"2026-08-04 10:08","name":"法国国际广播电台","title":"台外交部未就菲律宾民主礁领海基线表态  学者：显示台湾在南海政策缺乏整体战略思维","content":"菲律宾在7月29日向联合国提交民主礁及其周边海域的官方海图。国民党批评，菲律宾已严重侵害台湾南海主权，但台湾外交部却迟迟未主张主权立场。台湾学者分析，此事件显示台湾南海政策缺乏整体战略思维。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E5%8F%B0%E5%A4%96%E4%BA%A4%E9%83%A8%E6%9C%AA%E5%B0%B1%E8%8F%B2%E5%BE%8B%E5%AE%BE%E6%B0%91%E4%B8%BB%E7%A4%81%E9%A2%86%E6%B5%B7%E5%9F%BA%E7%BA%BF%E8%A1%A8%E6%80%81-%E5%AD%A6%E8%80%85-%E6%98%BE%E7%A4%BA%E5%8F%B0%E6%B9%BE%E5%9C%A8%E5%8D%97%E6%B5%B7%E6%94%BF%E7%AD%96%E7%BC%BA%E4%B9%8F%E6%95%B4%E4%BD%93%E6%88%98%E7%95%A5%E6%80%9D%E7%BB%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785838127000.webp","sourceId":"rfi"},{"id":1785836784000,"createdDate":"2026-08-04 09:46","name":"法国国际广播电台","title":"在华被拘捷克商人面临间谍罪指控 布拉格高院取消周二杨艺明案拘留听证会","content":"一名捷克商人自6月下旬起因涉嫌危害国家安全在中国被拘留，但中方有关部门迄今拒绝透露更多细节。捷克媒体《DeníkN》已获悉该男子涉嫌的具体罪名，以及他与捷克外交官首次会面的情况。中国有关部门拘押这名捷克商人已有一个月，但对其具体指控的罪名一直秘而不宣；捷克方面也未对此作出明确说明。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260804-%E5%9C%A8%E5%8D%8E%E8%A2%AB%E6%8B%98%E6%8D%B7%E5%85%8B%E5%95%86%E4%BA%BA%E9%9D%A2%E4%B8%B4%E9%97%B4%E8%B0%8D%E7%BD%AA%E6%8C%87%E6%8E%A7-%E5%B8%83%E6%8B%89%E6%A0%BC%E9%AB%98%E9%99%A2%E5%8F%96%E6%B6%88%E5%91%A8%E4%BA%8C%E6%9D%A8%E8%89%BA%E6%98%8E%E6%A1%88%E6%8B%98%E7%95%99%E5%90%AC%E8%AF%81%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785836784000.webp","sourceId":"rfi"},{"id":1785833715000,"createdDate":"2026-08-04 08:55","name":"法国国际广播电台","title":"赖清德：台日最大的威胁不是台风地震，而是中国侵扰胁迫","content":"台湾总统赖清德周二在接见“日本自民党青年局海外研修团”时表示，台湾和日本最大的威胁不是台风、地震或传染病，而是中国持续对周边国家进行灰色地带侵扰及海上胁迫。他称，中国上月更实施“跨国镇压”专法，意图将政治管辖与恐惧治理延伸到台湾、日本及全球民主国家，台日唯有团结，才能共同守护民主自由、和平与繁荣。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E8%B5%96%E6%B8%85%E5%BE%B7-%E5%8F%B0%E6%97%A5%E6%9C%80%E5%A4%A7%E7%9A%84%E5%A8%81%E8%83%81%E4%B8%8D%E6%98%AF%E5%8F%B0%E9%A3%8E%E5%9C%B0%E9%9C%87%EF%BC%8C%E8%80%8C%E6%98%AF%E4%B8%AD%E5%9B%BD%E4%BE%B5%E6%89%B0%E8%83%81%E8%BF%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785833715000.webp","sourceId":"rfi"},{"id":1785833392000,"createdDate":"2026-08-04 08:49","name":"法国国际广播电台","title":"平壤谴责美日韩等11国联合发布涉朝IT人员警示是抹黑朝鲜形象","content":"朝鲜官媒朝中社周二发表外交部发言人讲话，谴责美国及其盟国借对其网络活动毫无根据的指控，抹黑朝鲜形象，并以此为手段向主权国家施压。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-%E5%B9%B3%E5%A3%A4%E8%B0%B4%E8%B4%A3%E7%BE%8E%E6%97%A5%E9%9F%A9%E7%AD%8911%E5%9B%BD%E8%81%94%E5%90%88%E5%8F%91%E5%B8%83%E6%B6%89%E6%9C%9Dit%E4%BA%BA%E5%91%98%E8%AD%A6%E7%A4%BA%E6%98%AF%E6%8A%B9%E9%BB%91%E6%9C%9D%E9%B2%9C%E5%BD%A2%E8%B1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785833392000.webp","sourceId":"rfi"},{"id":1785831382000,"createdDate":"2026-08-04 08:16","name":"法国国际广播电台","title":"日本白皮书：严重关切中国军方太平洋活动不断扩大、军备投资为保卫国家和促进经济双赢途径","content":"日本防卫相小泉进次郎在4日的内阁会议上报告了2026年版《防卫白皮书》。其中指出中国军方航母等在太平洋上的活动不断扩大，强调中国军事动向“是严重关切事项，是前所未有的最大战略性挑战”，提出应通过与盟国及志同道合国家等的合作进行应对。在最新公布的防卫白皮书中，还将加速军事扩张描绘为保护国家与促进经济繁荣的双赢之路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260804-%E6%97%A5%E6%9C%AC%E7%99%BD%E7%9A%AE%E4%B9%A6-%E4%B8%A5%E9%87%8D%E5%85%B3%E5%88%87%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E5%A4%AA%E5%B9%B3%E6%B4%8B%E6%B4%BB%E5%8A%A8%E4%B8%8D%E6%96%AD%E6%89%A9%E5%A4%A7-%E5%86%9B%E5%A4%87%E6%8A%95%E8%B5%84%E4%B8%BA%E4%BF%9D%E5%8D%AB%E5%9B%BD%E5%AE%B6%E5%92%8C%E4%BF%83%E8%BF%9B%E7%BB%8F%E6%B5%8E%E5%8F%8C%E8%B5%A2%E9%80%94%E5%BE%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785831382000.webp","sourceId":"rfi"},{"id":1785830809000,"createdDate":"2026-08-04 08:06","name":"法国国际广播电台","title":"加拿大卑诗省面临近年最严重山火  墨西哥、澳洲派数百救援人员协助","content":"继加拿大安大略省后，西岸的卑诗省亦正面临多年来最严重的山火危机。据卑诗山火服务处（BCWildfireService）截至8月3日（周一）傍晚，全省活跃山火达130宗，其中57宗（占比44%）处于失控状态，更有6宗被列为对公众安全构成直接威胁的“重点山火”。全省已有超过5,000名居民被迫撤离家园，涉及逾8,500户房屋要疏散。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%91%E8%AF%97%E7%9C%81%E9%9D%A2%E4%B8%B4%E8%BF%91%E5%B9%B4%E6%9C%80%E4%B8%A5%E9%87%8D%E5%B1%B1%E7%81%AB-%E5%A2%A8%E8%A5%BF%E5%93%A5-%E6%BE%B3%E6%B4%B2%E6%B4%BE%E6%95%B0%E7%99%BE%E6%95%91%E6%8F%B4%E4%BA%BA%E5%91%98%E5%8D%8F%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785830809000.webp","sourceId":"rfi"},{"id":1785829727000,"createdDate":"2026-08-04 07:48","name":"法国国际广播电台","title":"中俄舰队完成环绕日本一周航行","content":"日本防卫省3日宣布，已确认3艘中国海军舰艇南下通过对马海峡，进入东海。这些舰艇此前与俄罗斯舰艇一同从冲绳方向驶入太平洋，随后转移至日本海。由此，中俄舰艇实际上完成了绕日本列岛一周的航行，舆论认为此次行动包含威慑日本的意图。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E4%B8%AD%E4%BF%84%E8%88%B0%E9%98%9F%E5%AE%8C%E6%88%90%E7%8E%AF%E7%BB%95%E6%97%A5%E6%9C%AC%E4%B8%80%E5%91%A8%E8%88%AA%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785829727000.webp","sourceId":"rfi"},{"id":1785829113000,"createdDate":"2026-08-04 07:38","name":"法国国际广播电台","title":"赴加前遭泰警扣留 「香港议会议员」张信燕终平安抵加 中方跨境镇压失败案例","content":"在前赴加拿大最後一刻疑因中方介入而再遭泰国警方拘留的港府通缉人员张信燕，在各方营救和加国努力三星期後，终於安全在当地时间8月3日(周一)晚抵达温哥华，她的未婚夫和她所属的民间自治组织「香港议会」成员到机场迎接她。为她赴加奔走的居加华籍作家盛雪形容，张信燕是中共费尽心机要绑回中国的人，但终能踏足自由之地，是「中共的外交霸权跨境镇压彻底失败。」","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260804-%E8%B5%B4%E5%8A%A0%E5%89%8D%E9%81%AD%E6%B3%B0%E8%AD%A6%E6%89%A3%E7%95%99-%E9%A6%99%E6%B8%AF%E8%AE%AE%E4%BC%9A%E8%AE%AE%E5%91%98-%E5%BC%A0%E4%BF%A1%E7%87%95%E7%BB%88%E5%B9%B3%E5%AE%89%E6%8A%B5%E5%8A%A0-%E4%B8%AD%E6%96%B9%E8%B7%A8%E5%A2%83%E9%95%87%E5%8E%8B%E5%A4%B1%E8%B4%A5%E6%A1%88%E4%BE%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785829113000.webp","sourceId":"rfi"},{"id":1785826785000,"createdDate":"2026-08-04 06:59","name":"法国国际广播电台","title":"美媒揭中国监控平台涵「五眼」及港台人士 未到当地亦有资料","content":"综合欧美两个传媒报道，中国一个公安局透过设置未加密的监控平台，追踪七百多名在当地居住的外籍人员，但储存资料包括1.2万项，涵盖香港丶台湾人士及外国记者，当中甚至包括从未到过当地的人。资料来源相信结合了官方丶监视器丶及消费纪录等资讯。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260804-%E7%BE%8E%E5%AA%92%E6%8F%AD%E4%B8%AD%E5%9B%BD%E7%9B%91%E6%8E%A7%E5%B9%B3%E5%8F%B0%E6%B6%B5-%E4%BA%94%E7%9C%BC-%E5%8F%8A%E6%B8%AF%E5%8F%B0%E4%BA%BA%E5%A3%AB-%E6%9C%AA%E5%88%B0%E5%BD%93%E5%9C%B0%E4%BA%A6%E6%9C%89%E8%B5%84%E6%96%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785826785000.webp","sourceId":"rfi"},{"id":1785817678000,"createdDate":"2026-08-04 04:27","name":"法国国际广播电台","title":"2026年8月12日日全食：十年一遇的天文奇观 何时开始的天气预报较可靠","content":"再过几天，法国人将屏息凝神，因为2026年8月12日的日全食终于要来了。2026年8月12日的日全食，也是十年一遇的天文奇观。对于是能否在法国或其他能见度区域观测到2026年8月12日日全食，天气状况是一个关键因素。但过早查看天气预报是没什么用的。那么，日食发生前多少天的天气预报才比较可靠呢？","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-2026%E5%B9%B48%E6%9C%8812%E6%97%A5%E6%97%A5%E5%85%A8%E9%A3%9F-%E5%8D%81%E5%B9%B4%E4%B8%80%E9%81%87%E7%9A%84%E5%A4%A9%E6%96%87%E5%A5%87%E8%A7%82-%E4%BD%95%E6%97%B6%E5%BC%80%E5%A7%8B%E7%9A%84%E5%A4%A9%E6%B0%94%E9%A2%84%E6%8A%A5%E8%BE%83%E5%8F%AF%E9%9D%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785817678000.webp","sourceId":"rfi"}]