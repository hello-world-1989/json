[{"id":1785802405000,"createdDate":"2026-08-04 00:13","name":"法国国际广播电台","title":"安踏：如何成了中国最成功的体育用品集团之一","content":"法国世界报周一刊出长篇报道，介绍中国体育运动集团安踏的发展战略。该报指出，安踏通过收购斐乐（Fila）、萨洛蒙（Salomon）、始祖鸟（Arc'teryx）、彪马（Puma）等国际品牌，并利用中国市场和高效管理，推动这些品牌实现增长。文章同时指出，安踏自主品牌的高端化进展却不及预期，反映出收购国际品牌与打造自主全球高端品牌之间仍然存在差距。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260804-%E5%AE%89%E8%B8%8F-%E5%A6%82%E4%BD%95%E6%88%90%E4%BA%86%E4%B8%AD%E5%9B%BD%E6%9C%80%E6%88%90%E5%8A%9F%E7%9A%84%E4%BD%93%E8%82%B2%E7%94%A8%E5%93%81%E9%9B%86%E5%9B%A2%E4%B9%8B%E4%B8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785802405000.webp","sourceId":"rfi"},{"id":1785802249000,"createdDate":"2026-08-04 00:10","name":"法国国际广播电台","title":"乌克兰消防员正在协助法国扑灭森林大火","content":"70名乌克兰消防员赶赴吉伦特省协助继续扑灭森林大火，法国是首次获得乌克兰消防队的增援。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260804-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%B6%88%E9%98%B2%E5%91%98%E6%AD%A3%E5%9C%A8%E5%8D%8F%E5%8A%A9%E6%B3%95%E5%9B%BD%E6%89%91%E7%81%AD%E6%A3%AE%E6%9E%97%E5%A4%A7%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785802249000.webp","sourceId":"rfi"},{"id":1785841123000,"createdDate":"2026-08-04 10:58","name":"法国国际广播电台","title":"“北戴河时间开启”：蔡奇现身却不见谌贻琴 官媒罕提战略科技专家受邀","content":"据路透社周一8月3日报道，中国共产党似乎已在海滨度假胜地北戴河启动其年度闭门会议。这一非正式的聚会每年都会引发高层干部权力角逐的传言，而今年会议前，党内将在10月召开一场关于党内治理的重要会议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260804-%E5%8C%97%E6%88%B4%E6%B2%B3%E6%97%B6%E9%97%B4%E5%BC%80%E5%90%AF-%E8%94%A1%E5%A5%87%E7%8E%B0%E8%BA%AB%E5%8D%B4%E4%B8%8D%E8%A7%81%E8%B0%8C%E8%B4%BB%E7%90%B4-%E5%AE%98%E5%AA%92%E7%BD%95%E6%8F%90%E6%88%98%E7%95%A5%E7%A7%91%E6%8A%80%E4%B8%93%E5%AE%B6%E5%8F%97%E9%82%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785841123000.webp","sourceId":"rfi"},{"id":1785840275000,"createdDate":"2026-08-04 10:44","name":"法国国际广播电台","title":"加拿大首个外国影响力登记制度周二正式生效 谁须进行登记含三项标准","content":"一个旨在进一步揭示加拿大境内由国家支持的外国影响力活动的、备受期待的登记制度于周二（8月4日）正式启动，但关于哪些主体必须进行登记的问题仍存在不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260804-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E9%A6%96%E4%B8%AA%E5%A4%96%E5%9B%BD%E5%BD%B1%E5%93%8D%E5%8A%9B%E7%99%BB%E8%AE%B0%E5%88%B6%E5%BA%A6%E5%91%A8%E4%BA%8C%E6%AD%A3%E5%BC%8F%E7%94%9F%E6%95%88-%E8%B0%81%E9%A1%BB%E8%BF%9B%E8%A1%8C%E7%99%BB%E8%AE%B0%E5%90%AB%E4%B8%89%E9%A1%B9%E6%A0%87%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785840275000.webp","sourceId":"rfi"},{"id":1785838127000,"createdDate":"2026-08-04 10:08","name":"法国国际广播电台","title":"台外交部未就菲律宾民主礁领海基线表态  学者：显示台湾在南海政策缺乏整体战略思维","content":"菲律宾在7月29日向联合国提交民主礁及其周边海域的官方海图。国民党批评，菲律宾已严重侵害台湾南海主权，但台湾外交部却迟迟未主张主权立场。台湾学者分析，此事件显示台湾南海政策缺乏整体战略思维。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E5%8F%B0%E5%A4%96%E4%BA%A4%E9%83%A8%E6%9C%AA%E5%B0%B1%E8%8F%B2%E5%BE%8B%E5%AE%BE%E6%B0%91%E4%B8%BB%E7%A4%81%E9%A2%86%E6%B5%B7%E5%9F%BA%E7%BA%BF%E8%A1%A8%E6%80%81-%E5%AD%A6%E8%80%85-%E6%98%BE%E7%A4%BA%E5%8F%B0%E6%B9%BE%E5%9C%A8%E5%8D%97%E6%B5%B7%E6%94%BF%E7%AD%96%E7%BC%BA%E4%B9%8F%E6%95%B4%E4%BD%93%E6%88%98%E7%95%A5%E6%80%9D%E7%BB%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785838127000.webp","sourceId":"rfi"},{"id":1785836784000,"createdDate":"2026-08-04 09:46","name":"法国国际广播电台","title":"在华被拘捷克商人面临间谍罪指控 布拉格高院取消周二杨艺明案拘留听证会","content":"一名捷克商人自6月下旬起因涉嫌危害国家安全在中国被拘留，但中方有关部门迄今拒绝透露更多细节。捷克媒体《DeníkN》已获悉该男子涉嫌的具体罪名，以及他与捷克外交官首次会面的情况。中国有关部门拘押这名捷克商人已有一个月，但对其具体指控的罪名一直秘而不宣；捷克方面也未对此作出明确说明。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260804-%E5%9C%A8%E5%8D%8E%E8%A2%AB%E6%8B%98%E6%8D%B7%E5%85%8B%E5%95%86%E4%BA%BA%E9%9D%A2%E4%B8%B4%E9%97%B4%E8%B0%8D%E7%BD%AA%E6%8C%87%E6%8E%A7-%E5%B8%83%E6%8B%89%E6%A0%BC%E9%AB%98%E9%99%A2%E5%8F%96%E6%B6%88%E5%91%A8%E4%BA%8C%E6%9D%A8%E8%89%BA%E6%98%8E%E6%A1%88%E6%8B%98%E7%95%99%E5%90%AC%E8%AF%81%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785836784000.webp","sourceId":"rfi"},{"id":1785833715000,"createdDate":"2026-08-04 08:55","name":"法国国际广播电台","title":"赖清德：台日最大的威胁不是台风地震，而是中国侵扰胁迫","content":"台湾总统赖清德周二在接见“日本自民党青年局海外研修团”时表示，台湾和日本最大的威胁不是台风、地震或传染病，而是中国持续对周边国家进行灰色地带侵扰及海上胁迫。他称，中国上月更实施“跨国镇压”专法，意图将政治管辖与恐惧治理延伸到台湾、日本及全球民主国家，台日唯有团结，才能共同守护民主自由、和平与繁荣。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E8%B5%96%E6%B8%85%E5%BE%B7-%E5%8F%B0%E6%97%A5%E6%9C%80%E5%A4%A7%E7%9A%84%E5%A8%81%E8%83%81%E4%B8%8D%E6%98%AF%E5%8F%B0%E9%A3%8E%E5%9C%B0%E9%9C%87%EF%BC%8C%E8%80%8C%E6%98%AF%E4%B8%AD%E5%9B%BD%E4%BE%B5%E6%89%B0%E8%83%81%E8%BF%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785833715000.webp","sourceId":"rfi"},{"id":1785833392000,"createdDate":"2026-08-04 08:49","name":"法国国际广播电台","title":"平壤谴责美日韩等11国联合发布涉朝IT人员警示是抹黑朝鲜形象","content":"朝鲜官媒朝中社周二发表外交部发言人讲话，谴责美国及其盟国借对其网络活动毫无根据的指控，抹黑朝鲜形象，并以此为手段向主权国家施压。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-%E5%B9%B3%E5%A3%A4%E8%B0%B4%E8%B4%A3%E7%BE%8E%E6%97%A5%E9%9F%A9%E7%AD%8911%E5%9B%BD%E8%81%94%E5%90%88%E5%8F%91%E5%B8%83%E6%B6%89%E6%9C%9Dit%E4%BA%BA%E5%91%98%E8%AD%A6%E7%A4%BA%E6%98%AF%E6%8A%B9%E9%BB%91%E6%9C%9D%E9%B2%9C%E5%BD%A2%E8%B1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785833392000.webp","sourceId":"rfi"},{"id":1785831382000,"createdDate":"2026-08-04 08:16","name":"法国国际广播电台","title":"日本白皮书：严重关切中国军方太平洋活动不断扩大、军备投资为保卫国家和促进经济双赢途径","content":"日本防卫相小泉进次郎在4日的内阁会议上报告了2026年版《防卫白皮书》。其中指出中国军方航母等在太平洋上的活动不断扩大，强调中国军事动向“是严重关切事项，是前所未有的最大战略性挑战”，提出应通过与盟国及志同道合国家等的合作进行应对。在最新公布的防卫白皮书中，还将加速军事扩张描绘为保护国家与促进经济繁荣的双赢之路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260804-%E6%97%A5%E6%9C%AC%E7%99%BD%E7%9A%AE%E4%B9%A6-%E4%B8%A5%E9%87%8D%E5%85%B3%E5%88%87%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E5%A4%AA%E5%B9%B3%E6%B4%8B%E6%B4%BB%E5%8A%A8%E4%B8%8D%E6%96%AD%E6%89%A9%E5%A4%A7-%E5%86%9B%E5%A4%87%E6%8A%95%E8%B5%84%E4%B8%BA%E4%BF%9D%E5%8D%AB%E5%9B%BD%E5%AE%B6%E5%92%8C%E4%BF%83%E8%BF%9B%E7%BB%8F%E6%B5%8E%E5%8F%8C%E8%B5%A2%E9%80%94%E5%BE%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785831382000.webp","sourceId":"rfi"},{"id":1785830809000,"createdDate":"2026-08-04 08:06","name":"法国国际广播电台","title":"加拿大卑诗省面临近年最严重山火  墨西哥、澳洲派数百救援人员协助","content":"继加拿大安大略省后，西岸的卑诗省亦正面临多年来最严重的山火危机。据卑诗山火服务处（BCWildfireService）截至8月3日（周一）傍晚，全省活跃山火达130宗，其中57宗（占比44%）处于失控状态，更有6宗被列为对公众安全构成直接威胁的“重点山火”。全省已有超过5,000名居民被迫撤离家园，涉及逾8,500户房屋要疏散。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%91%E8%AF%97%E7%9C%81%E9%9D%A2%E4%B8%B4%E8%BF%91%E5%B9%B4%E6%9C%80%E4%B8%A5%E9%87%8D%E5%B1%B1%E7%81%AB-%E5%A2%A8%E8%A5%BF%E5%93%A5-%E6%BE%B3%E6%B4%B2%E6%B4%BE%E6%95%B0%E7%99%BE%E6%95%91%E6%8F%B4%E4%BA%BA%E5%91%98%E5%8D%8F%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785830809000.webp","sourceId":"rfi"},{"id":1785829727000,"createdDate":"2026-08-04 07:48","name":"法国国际广播电台","title":"中俄舰队完成环绕日本一周航行","content":"日本防卫省3日宣布，已确认3艘中国海军舰艇南下通过对马海峡，进入东海。这些舰艇此前与俄罗斯舰艇一同从冲绳方向驶入太平洋，随后转移至日本海。由此，中俄舰艇实际上完成了绕日本列岛一周的航行，舆论认为此次行动包含威慑日本的意图。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260804-%E4%B8%AD%E4%BF%84%E8%88%B0%E9%98%9F%E5%AE%8C%E6%88%90%E7%8E%AF%E7%BB%95%E6%97%A5%E6%9C%AC%E4%B8%80%E5%91%A8%E8%88%AA%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785829727000.webp","sourceId":"rfi"},{"id":1785829113000,"createdDate":"2026-08-04 07:38","name":"法国国际广播电台","title":"赴加前遭泰警扣留 「香港议会议员」张信燕终平安抵加 中方跨境镇压失败案例","content":"在前赴加拿大最後一刻疑因中方介入而再遭泰国警方拘留的港府通缉人员张信燕，在各方营救和加国努力三星期後，终於安全在当地时间8月3日(周一)晚抵达温哥华，她的未婚夫和她所属的民间自治组织「香港议会」成员到机场迎接她。为她赴加奔走的居加华籍作家盛雪形容，张信燕是中共费尽心机要绑回中国的人，但终能踏足自由之地，是「中共的外交霸权跨境镇压彻底失败。」","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260804-%E8%B5%B4%E5%8A%A0%E5%89%8D%E9%81%AD%E6%B3%B0%E8%AD%A6%E6%89%A3%E7%95%99-%E9%A6%99%E6%B8%AF%E8%AE%AE%E4%BC%9A%E8%AE%AE%E5%91%98-%E5%BC%A0%E4%BF%A1%E7%87%95%E7%BB%88%E5%B9%B3%E5%AE%89%E6%8A%B5%E5%8A%A0-%E4%B8%AD%E6%96%B9%E8%B7%A8%E5%A2%83%E9%95%87%E5%8E%8B%E5%A4%B1%E8%B4%A5%E6%A1%88%E4%BE%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785829113000.webp","sourceId":"rfi"},{"id":1785826785000,"createdDate":"2026-08-04 06:59","name":"法国国际广播电台","title":"美媒揭中国监控平台涵「五眼」及港台人士 未到当地亦有资料","content":"综合欧美两个传媒报道，中国一个公安局透过设置未加密的监控平台，追踪七百多名在当地居住的外籍人员，但储存资料包括1.2万项，涵盖香港丶台湾人士及外国记者，当中甚至包括从未到过当地的人。资料来源相信结合了官方丶监视器丶及消费纪录等资讯。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260804-%E7%BE%8E%E5%AA%92%E6%8F%AD%E4%B8%AD%E5%9B%BD%E7%9B%91%E6%8E%A7%E5%B9%B3%E5%8F%B0%E6%B6%B5-%E4%BA%94%E7%9C%BC-%E5%8F%8A%E6%B8%AF%E5%8F%B0%E4%BA%BA%E5%A3%AB-%E6%9C%AA%E5%88%B0%E5%BD%93%E5%9C%B0%E4%BA%A6%E6%9C%89%E8%B5%84%E6%96%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785826785000.webp","sourceId":"rfi"},{"id":1785817678000,"createdDate":"2026-08-04 04:27","name":"法国国际广播电台","title":"2026年8月12日日全食：十年一遇的天文奇观 何时开始的天气预报较可靠","content":"再过几天，法国人将屏息凝神，因为2026年8月12日的日全食终于要来了。2026年8月12日的日全食，也是十年一遇的天文奇观。对于是能否在法国或其他能见度区域观测到2026年8月12日日全食，天气状况是一个关键因素。但过早查看天气预报是没什么用的。那么，日食发生前多少天的天气预报才比较可靠呢？","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-2026%E5%B9%B48%E6%9C%8812%E6%97%A5%E6%97%A5%E5%85%A8%E9%A3%9F-%E5%8D%81%E5%B9%B4%E4%B8%80%E9%81%87%E7%9A%84%E5%A4%A9%E6%96%87%E5%A5%87%E8%A7%82-%E4%BD%95%E6%97%B6%E5%BC%80%E5%A7%8B%E7%9A%84%E5%A4%A9%E6%B0%94%E9%A2%84%E6%8A%A5%E8%BE%83%E5%8F%AF%E9%9D%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785817678000.webp","sourceId":"rfi"},{"id":1785858554000,"createdDate":"2026-08-04 15:49","name":"法国国际广播电台","title":"在与伊朗战争中 美陆军已使用“几乎所有”ATACMS等精准地对地导弹","content":"据路透社援引三位知情人士报导称，美国陆军在与伊朗长达五个月的冲突中，已消耗了其大部分高精度远程导弹库存，这引发了人们对美军应对未来冲突的战备能力的担忧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260804-%E5%9C%A8%E4%B8%8E%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E4%B8%AD-%E7%BE%8E%E5%9B%BD%E9%99%86%E5%86%9B%E5%B7%B2%E5%8A%A8%E7%94%A8%E4%BA%86-%E5%87%A0%E4%B9%8E%E6%89%80%E6%9C%89-atacms%E7%AD%89%E9%AB%98%E7%B2%BE%E5%BA%A6%E5%9C%B0%E5%AF%B9%E5%9C%B0%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785858554000.webp","sourceId":"rfi"},{"id":1785856086000,"createdDate":"2026-08-04 15:08","name":"法国国际广播电台","title":"泽连斯基：需要寻求与中国对话，希望加强与日本的关系","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周一在与该国驻外外交机构负责人年度会议上表示，“我们必须找到一种能增强自身实力且务实的对印关系模式，同时也需要寻求与中国对话——尤其是如果我们不希望中国完全且排他性地支持俄罗斯，或者不希望中国在构想未来时只看到俄罗斯而忽略其他国家的话。这一切都需要从头构建，而这些都是极具挑战性的难题”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E9%9C%80%E8%A6%81%E5%AF%BB%E6%B1%82%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%AF%B9%E8%AF%9D%EF%BC%8C%E5%B8%8C%E6%9C%9B%E5%8A%A0%E5%BC%BA%E4%B8%8E%E6%97%A5%E6%9C%AC%E7%9A%84%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785856086000.webp","sourceId":"rfi"},{"id":1785851231000,"createdDate":"2026-08-04 13:47","name":"法国国际广播电台","title":"美联邦通信委员会拟禁止进口中国产新型数据中心组件","content":"据路透社援引四位知情人士报导，特朗普政府正在起草一项禁令，禁止进口中国产的新型数据中心组件，此举旨在保护支撑人工智能（AI）热潮的基础设施。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260804-%E7%BE%8E%E8%81%94%E9%82%A6%E9%80%9A%E4%BF%A1%E5%A7%94%E5%91%98%E4%BC%9A%E6%8B%9F%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E4%BA%A7%E6%96%B0%E5%9E%8B%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E7%BB%84%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785851231000.webp","sourceId":"rfi"},{"id":1785848798000,"createdDate":"2026-08-04 13:06","name":"法国国际广播电台","title":"中方正制定预案，就美国针对人工智能领域中企预备反制","content":"中国据称日益担忧美国人工智能（AI）企业Anthropic公司的旗舰AI模型Mythos可能被用来针对这个世界第二大经济体；在中国国家主席习近平与美国总统特朗普计划举行峰会之际，这一问题为本已高度紧张的局势增添了一个充满变数的新因素。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260804-%E4%B8%AD%E6%96%B9%E6%AD%A3%E5%88%B6%E5%AE%9A%E9%A2%84%E6%A1%88%EF%BC%8C%E5%B0%B1%E7%BE%8E%E5%9B%BD%E9%92%88%E5%AF%B9%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E9%A2%86%E5%9F%9F%E4%B8%AD%E4%BC%81%E9%A2%84%E5%A4%87%E5%8F%8D%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785848798000.webp","sourceId":"rfi"},{"id":1785887976000,"createdDate":"2026-08-04 23:59","name":"法国国际广播电台","title":"人工智能：我们还能真正控制它吗？","content":"今年7月，美国两家人工智能公司OpenAI和Anthropic都承认发生了安全事件。7月21日，OpenAI表示，在一次测试中，一个AI模型竟然突破了实验环境的限制，随后还攻击了平台HuggingFace的服务器。7月30日，Anthropic也承认，在网络安全演练中，它的三个AI模型进入了三家外部机构的生产系统。原因不是模型自己突破限制，而是测试合作伙伴配置错误，让模型意外连接到了互联网。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260804-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD-%E6%88%91%E4%BB%AC%E8%BF%98%E8%83%BD%E7%9C%9F%E6%AD%A3%E6%8E%A7%E5%88%B6%E5%AE%83%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785887976000.webp","sourceId":"rfi"},{"id":1785887742000,"createdDate":"2026-08-04 23:55","name":"法国国际广播电台","title":"美国政府思考如何加强对人工智能工具的监管","content":"美国总统特朗普近来曾表示，在近期发生一系列网络安全事件后，政府正考虑加强对人工智能工具的监管和控制权限。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E7%BE%8E%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%80%9D%E8%80%83%E5%A6%82%E4%BD%95%E5%8A%A0%E5%BC%BA%E5%AF%B9%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%B7%A5%E5%85%B7%E7%9A%84%E7%9B%91%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785887742000.webp","sourceId":"rfi"},{"id":1785877432000,"createdDate":"2026-08-04 21:03","name":"法国国际广播电台","title":"赖清德：中国“民促法”是一部国际社会应该团结反制的恶法","content":"凯达格兰论坛：2026印太安全对话”8月4日在台北君悦酒店举行。台湾总统赖清德出席开幕式并讲话。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260804-%E8%B5%96%E6%B8%85%E5%BE%B7-%E4%B8%AD%E5%9B%BD-%E6%B0%91%E4%BF%83%E6%B3%95-%E6%98%AF%E4%B8%80%E9%83%A8%E5%9B%BD%E9%99%85%E7%A4%BE%E4%BC%9A%E5%BA%94%E8%AF%A5%E5%9B%A2%E7%BB%93%E5%8F%8D%E5%88%B6%E7%9A%84%E6%81%B6%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785877432000.webp","sourceId":"rfi"},{"id":1785876936000,"createdDate":"2026-08-04 20:55","name":"法国国际广播电台","title":"作为反击     华盛顿吊销巴西驻美国大使签证","content":"美国国务院一位官员8月4日表示，就在巴西政府拒绝向美国官员发放签证几天后，美国已吊销了巴西驻华盛顿大使的签证。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E4%BD%9C%E4%B8%BA%E5%8F%8D%E5%87%BB-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%90%8A%E9%94%80%E5%B7%B4%E8%A5%BF%E9%A9%BB%E7%BE%8E%E5%9B%BD%E5%A4%A7%E4%BD%BF%E7%AD%BE%E8%AF%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785876936000.webp","sourceId":"rfi"},{"id":1785875973000,"createdDate":"2026-08-04 20:39","name":"法国国际广播电台","title":"福埃哥火山（Fuego）喷发      危地马拉发出红色警报","content":"危地马拉首都附近的福埃哥火山（VolcándeFuego）爆发后，当局已开始疏散周围居民。福埃哥火山被认为是中美洲最活跃的火山，于周一清晨开始喷发，并在周二凌晨活动加剧。滚滚熔岩顺着山坡倾泻而下，巨大的气体和火山灰柱直冲云霄。当局发出最高级别-红色警报。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E7%A6%8F%E5%9F%83%E5%93%A5%E7%81%AB%E5%B1%B1-fuego-%E5%96%B7%E5%8F%91-%E5%8D%B1%E5%9C%B0%E9%A9%AC%E6%8B%89%E5%8F%91%E5%87%BA%E7%BA%A2%E8%89%B2%E8%AD%A6%E6%8A%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785875973000.webp","sourceId":"rfi"},{"id":1785875611000,"createdDate":"2026-08-04 20:33","name":"法国国际广播电台","title":"歌星在波尔多举办大型义演      演出所得捐给灾民","content":"一场汇集了多名法国乐坛巨星的慈善音乐会将于8月27日在波尔多附近的弗洛拉克阿尔凯亚（ARKEAARENA-FLOIRAC）体育馆举行，这场名为“SOS救助灾民”的慈善活动完全是民间发起的。音乐会演出出入全部将捐给灾民、观众也被邀请向灾民提供资助。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260804-%E6%AD%8C%E6%98%9F%E5%9C%A8%E6%B3%A2%E5%B0%94%E5%A4%9A%E4%B8%BE%E5%8A%9E%E5%A4%A7%E5%9E%8B%E4%B9%89%E6%BC%94-%E6%BC%94%E5%87%BA%E6%89%80%E5%BE%97%E6%8D%90%E7%BB%99%E7%81%BE%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785875611000.webp","sourceId":"rfi"},{"id":1785875317000,"createdDate":"2026-08-04 20:28","name":"法国国际广播电台","title":"古巴全国性大停电之后逐步恢复供电","content":"古巴周二宣布，在周日晚至周一凌晨发生的全国性大停电后，已恢复电网供电。这是今年古巴第六次大停电，而此次停电正值该国面临严重的能源危机和美国实施的石油封锁之际。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260804-%E5%8F%A4%E5%B7%B4%E5%85%A8%E5%9B%BD%E6%80%A7%E5%A4%A7%E5%81%9C%E7%94%B5%E4%B9%8B%E5%90%8E%E9%80%90%E6%AD%A5%E6%81%A2%E5%A4%8D%E4%BE%9B%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785875317000.webp","sourceId":"rfi"},{"id":1785875147000,"createdDate":"2026-08-04 20:25","name":"法国国际广播电台","title":"休达危机：法在比利牛斯省两端设37个过境检查点","content":"8月4日上午，欧盟各国内政部长举行了三个小时的视频会议，讨论西班牙休达非法移民危机。上周，摩洛哥西北部7.2万名移民蜂拥而上。据西班牙内政部长提供的数据，其中7万人已在警方护送下迅速离开。这一事件引发了人们对边境管控和成员国间合作的关注。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260804-%E4%BC%91%E8%BE%BE%E5%8D%B1%E6%9C%BA-%E6%B3%95%E5%9C%A8%E6%AF%94%E5%88%A9%E7%89%9B%E6%96%AF%E7%9C%81%E4%B8%A4%E7%AB%AF%E8%AE%BE37%E4%B8%AA%E8%BF%87%E5%A2%83%E6%A3%80%E6%9F%A5%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785875147000.webp","sourceId":"rfi"},{"id":1785874859000,"createdDate":"2026-08-04 20:20","name":"法国国际广播电台","title":"享誉全球的日本钢琴家向红十字会捐款   资助法国灾民","content":"法国《费加罗报》4日报道，日本传奇摇滚乐队XJapan的队长林佳树（Yoshiki）向法国红十字会捐赠了5万欧元，同时向西班牙红十字会捐赠了同样的金额。她对记者表示：“虽然我在洛杉矶生活多年，但日本永远是我的故乡，欧洲——尤其是法国——也已成为我的第二个家园。看到法国、西班牙和日本人民遭受如此毁灭性的灾难，我感到无比痛心。”","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260804-%E4%BA%AB%E8%AA%89%E5%85%A8%E7%90%83%E7%9A%84%E6%97%A5%E6%9C%AC%E9%92%A2%E7%90%B4%E5%AE%B6%E5%90%91%E7%BA%A2%E5%8D%81%E5%AD%97%E4%BC%9A%E6%8D%90%E6%AC%BE-%E8%B5%84%E5%8A%A9%E6%B3%95%E5%9B%BD%E7%81%BE%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785874859000.webp","sourceId":"rfi"},{"id":1785874531000,"createdDate":"2026-08-04 20:15","name":"法国国际广播电台","title":"埃博拉疫苗研究同步推进     莫德纳加入","content":"加拿大卫生部周二宣布，已授权美国制药巨头莫德纳（Moderna）公司启动其针对本迪布焦（Bundibugyo）病毒埃博拉病毒株的疫苗临床试验。据加拿大当局称，这项I期临床试验“将评估候选疫苗的安全性，确定安全剂量范围，并识别任何潜在的副作用”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260804-%E5%9F%83%E5%8D%9A%E6%8B%89%E7%96%AB%E8%8B%97%E7%A0%94%E7%A9%B6%E5%90%8C%E6%AD%A5%E6%8E%A8%E8%BF%9B-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E8%8E%AB%E5%BE%B7%E7%BA%B3%E5%8A%A0%E5%85%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785874531000.webp","sourceId":"rfi"},{"id":1785873012000,"createdDate":"2026-08-04 19:50","name":"法国国际广播电台","title":"美称与伊朗霍尔木兹海峡谈判近完成 油价重挫美股创新高","content":"美国与伊朗围绕霍尔木兹海峡（StraitofHormuz）商业船只通行的谈判持续取得进展。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260804-%E7%BE%8E%E7%A7%B0%E4%B8%8E%E4%BC%8A%E6%9C%97%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E8%B0%88%E5%88%A4%E8%BF%91%E5%AE%8C%E6%88%90-%E6%B2%B9%E4%BB%B7%E9%87%8D%E6%8C%AB%E7%BE%8E%E8%82%A1%E5%88%9B%E6%96%B0%E9%AB%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785873012000.webp","sourceId":"rfi"},{"id":1785871742000,"createdDate":"2026-08-04 19:29","name":"法国国际广播电台","title":"中国经济持续低迷让德国面临新风险","content":"据德国N-TV电视台报道：中国持续大规模投资本国经济，并在许多领域赶超西方企业。然而，这种发展模式正逐渐演变为一个问题：长期经济停滞的风险正在显现。对于德国工业而言，这无疑是一个坏消息。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260804-%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E%E6%8C%81%E7%BB%AD%E4%BD%8E%E8%BF%B7%E8%AE%A9%E5%BE%B7%E5%9B%BD%E9%9D%A2%E4%B8%B4%E6%96%B0%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785871742000.webp","sourceId":"rfi"},{"id":1785871248000,"createdDate":"2026-08-04 19:20","name":"法国国际广播电台","title":"休达移民潮后欧盟强化保护边境安全","content":"针对摩洛哥移民涌入西班牙飞地休达（Ceuta）一事，欧盟本周一起召开内政部长紧急视讯会议。欧盟内政和移民事务专员布伦纳（MagnusBrunner）周二下午主持记者会，说明会议情形与讨论的内容。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260804-%E4%BC%91%E8%BE%BE%E7%A7%BB%E6%B0%91%E6%BD%AE%E5%90%8E%E6%AC%A7%E7%9B%9F%E5%BC%BA%E5%8C%96%E4%BF%9D%E6%8A%A4%E8%BE%B9%E5%A2%83%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785871248000.webp","sourceId":"rfi"},{"id":1785870849000,"createdDate":"2026-08-04 19:14","name":"法国国际广播电台","title":"一艘货船在红海遭袭击后沉没   万幸船员获救","content":"据也门官员和新德里方面报道，一艘印度货船周二在红海遭到袭击后沉没，船上14名船员全部获救。据也门官方通讯社萨巴（Saba）通讯社报道，也门政府将此次袭击归咎于胡塞武装。胡塞武装是亲伊朗的也门反政府武装，他们最近宣布对沙特阿拉伯港口实施海上封锁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260804-%E4%B8%80%E8%89%98%E8%B4%A7%E8%88%B9%E5%9C%A8%E7%BA%A2%E6%B5%B7%E9%81%AD%E8%A2%AD%E5%87%BB%E5%90%8E%E6%B2%89%E6%B2%A1-%E4%B8%87%E5%B9%B8%E8%88%B9%E5%91%98%E8%8E%B7%E6%95%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/04/1785870849000.webp","sourceId":"rfi"}]