[{"id":1786177161000,"createdDate":"2026-08-08 08:19","name":"法国国际广播电台","title":"哥伦比亚极右翼新总统宣誓就职 美国宣布拟对哥提供10亿美元安全援助","content":"哥伦比亚新当选总统阿韦拉多·德拉埃斯普列亚周五（8月7日）宣誓就职，任期4年。他在就职演说中承诺铁腕整治贩毒和治安，并实施财政紧缩、推动税制改革，以恢复市场对哥伦比亚经济的信心。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260808-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%96%B0%E6%80%BB%E7%BB%9F%E5%AE%A3%E8%AA%93%E5%B0%B1%E8%81%8C-%E7%BE%8E%E5%9B%BD%E5%AE%A3%E5%B8%83%E6%8B%9F%E5%AF%B9%E5%93%A5%E6%8F%90%E4%BE%9B10%E4%BA%BF%E7%BE%8E%E5%85%83%E5%AE%89%E5%85%A8%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786177161000.webp","sourceId":"rfi"},{"id":1786175938000,"createdDate":"2026-08-08 07:58","name":"法国国际广播电台","title":"台湾将重返太平洋岛国论坛尽管北京反对","content":"尽管北京反对台湾在外交舞台上以任何形式出现，但太平洋岛国年度峰会秘书长周五表示，台湾将能够参加即将在帕劳举行的下一届年度论坛。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260808-%E5%8F%B0%E6%B9%BE%E5%B0%86%E9%87%8D%E8%BF%94%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B0%BD%E7%AE%A1%E5%8C%97%E4%BA%AC%E5%8F%8D%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786175938000.webp","sourceId":"rfi"},{"id":1786171274000,"createdDate":"2026-08-08 06:41","name":"法国国际广播电台","title":"日本自卫队试射“战斧”巡航导弹  中国呼吁联合遏制“新型军国主义”","content":"据日本防卫省介绍，日本时间7月29日，派往美国的海上自卫队宙斯盾舰在太平洋海域实施“战斧”巡航导弹实弹发射试验。中国国防部发言人8月7日表示：国际社会必须团结起来、行动起来，共同遏制日本“新型军国主义”成势为患、祸乱世界。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260808-%E6%97%A5%E6%9C%AC%E8%87%AA%E5%8D%AB%E9%98%9F%E8%AF%95%E5%B0%84-%E6%88%98%E6%96%A7-%E5%B7%A1%E8%88%AA%E5%AF%BC%E5%BC%B9-%E4%B8%AD%E5%9B%BD%E5%91%BC%E5%90%81%E8%81%94%E5%90%88%E9%81%8F%E5%88%B6-%E6%96%B0%E5%9E%8B%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786171274000.webp","sourceId":"rfi"},{"id":1786171077000,"createdDate":"2026-08-08 06:37","name":"法国国际广播电台","title":"美国将向关键矿产领域投资30亿美元，以增强国防供应链，降低对中国依赖","content":"美国总统特朗普周五（8月7日）表示，美国政府将向关键矿产和电池项目投资30亿美元，以推动国内生产，并加强国家安全和产业政策。路透社称，这一政策和伊朗战争对武器库存的消耗与中国对关键矿产的垄断有关。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260808-%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%90%91%E5%85%B3%E9%94%AE%E7%9F%BF%E4%BA%A7%E9%A2%86%E5%9F%9F%E6%8A%95%E8%B5%8430%E4%BA%BF%E7%BE%8E%E5%85%83%EF%BC%8C%E4%BB%A5%E5%A2%9E%E5%BC%BA%E5%9B%BD%E9%98%B2%E4%BE%9B%E5%BA%94%E9%93%BE%EF%BC%8C%E9%99%8D%E4%BD%8E%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786171077000.webp","sourceId":"rfi"},{"id":1786203398000,"createdDate":"2026-08-08 15:36","name":"法国国际广播电台","title":"俄罗斯老牌反对党打算重出江湖要求“停止杀戮”","content":"“停止杀戮”：在异见声音遭到打压的俄罗斯，老牌自由派反对党“亚布洛科”希望借9月议会选举之机重出江湖，并就莫斯科于2022年在乌克兰挑起的冲突提出一项和平的替代方案。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260808-%E4%BF%84%E7%BD%97%E6%96%AF%E8%80%81%E7%89%8C%E5%8F%8D%E5%AF%B9%E5%85%9A%E6%89%93%E7%AE%97%E9%87%8D%E5%87%BA%E6%B1%9F%E6%B9%96%E8%A6%81%E6%B1%82-%E5%81%9C%E6%AD%A2%E6%9D%80%E6%88%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786203398000.webp","sourceId":"rfi"},{"id":1786201618000,"createdDate":"2026-08-08 15:06","name":"法国国际广播电台","title":"特朗普提名托德·布兰奇出任司法部长在参议院惊险过关","content":"美国参议院周六批准了唐纳德·特朗普的前私人律师托德·布兰奇的提名，使其正式出任新任司法部长，此前他自4月起便一直担任该职的代理职务。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260808-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8F%90%E5%90%8D%E6%89%98%E5%BE%B7%C2%B7%E5%B8%83%E5%85%B0%E5%A5%87%E5%87%BA%E4%BB%BB%E5%8F%B8%E6%B3%95%E9%83%A8%E9%95%BF%E5%9C%A8%E5%8F%82%E8%AE%AE%E9%99%A2%E6%83%8A%E9%99%A9%E8%BF%87%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786201618000.webp","sourceId":"rfi"},{"id":1786198598000,"createdDate":"2026-08-08 14:16","name":"法国国际广播电台","title":"美参院通过制裁俄罗斯法案“打在普京最痛处”拟对中印等国征100%关税","content":"美国参议院周五以压倒多数，通过了一项针对俄罗斯的全面制裁法案，该法案特别针对石油和天然气行业，包括对中印等五大俄油进口国征100%关税。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260808-%E7%BE%8E%E5%8F%82%E9%99%A2%E9%80%9A%E8%BF%87%E5%88%B6%E8%A3%81%E4%BF%84%E7%BD%97%E6%96%AF%E6%B3%95%E6%A1%88-%E6%89%93%E5%9C%A8%E6%99%AE%E4%BA%AC%E6%9C%80%E7%97%9B%E5%A4%84-%E6%8B%9F%E5%AF%B9%E4%B8%AD%E5%8D%B0%E7%AD%89%E5%9B%BD%E5%BE%81100-%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786198598000.webp","sourceId":"rfi"},{"id":1786197062000,"createdDate":"2026-08-08 13:51","name":"法国国际广播电台","title":"中国数学家获菲尔兹奖感言却独漏北京大学 中国高等教育是如何让王虹感到挫败？","content":"中国数学家王虹荣获菲尔兹奖，成为史上第三位女性得。但王虹的故事却意外让中国高等教育迷思成为话题。她在得奖受访时提到，在北京大学就读期间感到「挫败」，甚至一度萌生放弃的念头。在网上引起广大民众的回应，表示这正是他们曾感受到却说不清的痛苦。到底中国网民们是怎么看其教育体系的？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260808-%E4%B8%AD%E5%9B%BD%E6%95%B0%E5%AD%A6%E5%AE%B6%E8%8E%B7%E8%8F%B2%E5%B0%94%E5%85%B9%E5%A5%96%E6%84%9F%E8%A8%80%E5%8D%B4%E7%8B%AC%E6%BC%8F%E5%8C%97%E4%BA%AC%E5%A4%A7%E5%AD%A6-%E4%B8%AD%E5%9B%BD%E9%AB%98%E7%AD%89%E6%95%99%E8%82%B2%E6%98%AF%E5%A6%82%E4%BD%95%E8%AE%A9%E7%8E%8B%E8%99%B9%E6%84%9F%E5%88%B0%E6%8C%AB%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786197062000.webp","sourceId":"rfi"},{"id":1786194142000,"createdDate":"2026-08-08 13:02","name":"法国国际广播电台","title":"中国首任国家金管总局局长李云泽涉嫌严重违纪违法遭罢免","content":"2026年8月官方首次证实首任中国国家金管总局局长李云泽因涉嫌严重违纪违法被罢免第十四届全国人大代表职务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E4%B8%AD%E5%9B%BD%E9%A6%96%E4%BB%BB%E5%9B%BD%E5%AE%B6%E9%87%91%E7%AE%A1%E6%80%BB%E5%B1%80%E5%B1%80%E9%95%BF%E6%9D%8E%E4%BA%91%E6%B3%BD%E6%B6%89%E5%AB%8C%E4%B8%A5%E9%87%8D%E8%BF%9D%E7%BA%AA%E8%BF%9D%E6%B3%95%E9%81%AD%E7%BD%A2%E5%85%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786194142000.webp","sourceId":"rfi"},{"id":1786193342000,"createdDate":"2026-08-08 12:49","name":"法国国际广播电台","title":"泽连斯基首访塞尔维亚：贝尔格莱德为何向基辅靠近？","content":"乌克兰总统泽连斯基周五（8月7日）晚抵达贝尔格莱德，开启对塞尔维亚的正式访问。这是泽连斯基自2019年就任乌克兰总统以来首次访问这个传统上与俄罗斯关系密切的巴尔干国家。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260808-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E9%A6%96%E6%AC%A1%E8%AE%BF%E9%97%AE%E5%A1%9E%E5%B0%94%E7%BB%B4%E4%BA%9A-%E8%B4%9D%E5%B0%94%E6%A0%BC%E8%8E%B1%E5%BE%B7%E4%B8%BA%E4%BD%95%E5%90%91%E5%9F%BA%E8%BE%85%E9%9D%A0%E8%BF%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786193342000.webp","sourceId":"rfi"},{"id":1786182541000,"createdDate":"2026-08-08 09:49","name":"法国国际广播电台","title":"费加罗报：俄境外势力用假新闻干预操控法国大选 法国失业率居高不下","content":"今日出刊的费加罗报没有关于中国方面的报道，报纸的头条是法国国内经济，主要聚焦失业问题。报纸的2和3版则以相当篇幅的内容讲述境外势力，主要是俄罗斯方面如何影响甚至操控法国2027年总统大选，还有一些生活方面的实用信息，我们为您一一详细介绍。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260808-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%BF%84%E5%A2%83%E5%A4%96%E5%8A%BF%E5%8A%9B%E7%94%A8%E5%81%87%E6%96%B0%E9%97%BB%E5%B9%B2%E9%A2%84%E6%93%8D%E6%8E%A7%E6%B3%95%E5%9B%BD%E5%A4%A7%E9%80%89-%E6%B3%95%E5%9B%BD%E5%A4%B1%E4%B8%9A%E7%8E%87%E5%B1%85%E9%AB%98%E4%B8%8D%E4%B8%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786182541000.webp","sourceId":"rfi"},{"id":1786227985000,"createdDate":"2026-08-08 22:26","name":"法国国际广播电台","title":"上将断层 中将治军？","content":"中国全国人大常委会最新公报一公布，至少消失一段时间的一批解放军上将有了名目，同时又增添了新的疑问：上将水土流失这么严重，整个军队的指挥系统七零八落，“战斗力”几何？","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E4%B8%8A%E5%B0%86%E6%96%AD%E5%B1%82-%E4%B8%AD%E5%B0%86%E6%B2%BB%E5%86%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786227985000.webp","sourceId":"rfi"},{"id":1786225142000,"createdDate":"2026-08-08 21:39","name":"法国国际广播电台","title":"阿曼与伊朗霍尔木兹海峡谈判取得进展 油轮再遭导弹袭击","content":"海湾国家阿曼周六(8月8日）表示，与伊朗就未来管理霍尔木兹海峡举行的谈判取得“积极”进展。阿曼同时警告不要在这一处于中东战争核心的海域袭击船只。分析指：如果伊朗与阿曼达成协议，将为德黑兰与华盛顿重启谈判铺平道路，以寻求持久结束这场战争。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E9%98%BF%E6%9B%BC%E4%B8%8E%E4%BC%8A%E6%9C%97%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E8%B0%88%E5%88%A4%E5%8F%96%E5%BE%97%E8%BF%9B%E5%B1%95-%E6%B2%B9%E8%BD%AE%E5%86%8D%E9%81%AD%E5%AF%BC%E5%BC%B9%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786225142000.webp","sourceId":"rfi"},{"id":1786224948000,"createdDate":"2026-08-08 21:35","name":"法国国际广播电台","title":"泰国校园枪击事件死亡人数升至9人","content":"泰国卫生部周六（8月8日）表示，泰国曼谷附近高中发生校园枪击案后，一名12岁女孩因伤势过重死亡，使枪击事件死亡人数升至9人。目前仍有14人住院治疗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E6%B3%B0%E5%9B%BD%E6%A0%A1%E5%9B%AD%E6%9E%AA%E5%87%BB%E4%BA%8B%E4%BB%B6%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%8D%87%E8%87%B39%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786224948000.webp","sourceId":"rfi"},{"id":1786224737000,"createdDate":"2026-08-08 21:32","name":"法国国际广播电台","title":"无人机爆炸事件:保加利亚传召乌克兰大使 德国军事设施上空发现无人机","content":"一架装有爆炸物的无人机周六（8月8日）坠毁在保加利亚境内，地点靠近罗马尼亚边境及一条连接土耳其与乌克兰的天然气管道。保加利亚称残骸所属机型被乌克兰军队广泛使用，并已召见乌克兰驻索非亚大使；基辅则表示，这起事件并非蓄意行为，并承诺展开调查。德国军事设施上空也发现无人机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%88%86%E7%82%B8%E4%BA%8B%E4%BB%B6-%E4%BF%9D%E5%8A%A0%E5%88%A9%E4%BA%9A%E4%BC%A0%E5%8F%AC%E4%B9%8C%E5%85%8B%E5%85%B0%E5%A4%A7%E4%BD%BF-%E5%BE%B7%E5%9B%BD%E5%86%9B%E4%BA%8B%E8%AE%BE%E6%96%BD%E4%B8%8A%E7%A9%BA%E5%8F%91%E7%8E%B0%E6%97%A0%E4%BA%BA%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786224737000.webp","sourceId":"rfi"},{"id":1786224197000,"createdDate":"2026-08-08 21:23","name":"法国国际广播电台","title":"台军“汉光”演习举行海岸打击演练 赖清德登导弹快艇督导","content":"台湾总统赖清德周六（8月8日）现场督导“汉光42号”演习的滨海打击及近岸防御科目，登上导弹快艇，并观看低空攻击无人机群出动，模拟击退中国可能发动的进攻。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E5%8F%B0%E5%86%9B-%E6%B1%89%E5%85%89-%E6%BC%94%E4%B9%A0%E4%B8%BE%E8%A1%8C%E6%B5%B7%E5%B2%B8%E6%89%93%E5%87%BB%E6%BC%94%E7%BB%83-%E8%B5%96%E6%B8%85%E5%BE%B7%E7%99%BB%E5%AF%BC%E5%BC%B9%E5%BF%AB%E8%89%87%E7%9D%A3%E5%AF%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786224197000.webp","sourceId":"rfi"},{"id":1786224021000,"createdDate":"2026-08-08 21:20","name":"法国国际广播电台","title":"强台风“白海豚”逼近浙江 料9日晚至10日早登陆浙闽沿海 为多地带来持续强风暴雨","content":"强台风“白海豚”正逼近中国东部浙江省沿海。中国中央气象台已发布台风橙色预警，预计“白海豚”将于周日（8月9日）晚间至周一（10日）早晨，以台风级或强台风级强度在浙江舟山至福建福鼎一带沿海登陆，并给华东沿海及多个内陆省份带来持续性强风暴雨。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E5%BC%BA%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E9%80%BC%E8%BF%91%E6%B5%99%E6%B1%9F-%E6%96%999%E6%97%A5%E6%99%9A%E8%87%B310%E6%97%A5%E6%97%A9%E7%99%BB%E9%99%86%E6%B5%99%E9%97%BD%E6%B2%BF%E6%B5%B7-%E4%B8%BA%E5%A4%9A%E5%9C%B0%E5%B8%A6%E6%9D%A5%E6%8C%81%E7%BB%AD%E5%BC%BA%E9%A3%8E%E9%9B%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786224021000.webp","sourceId":"rfi"},{"id":1786223502000,"createdDate":"2026-08-08 21:11","name":"法国国际广播电台","title":"华盛顿谴责北京在南海“破坏稳定”","content":"美国周六再次指责中国以设立自然保护区为借口，在南中国海与菲律宾存在争议的斯卡伯勒浅滩(中国称之为黄岩岛)附近“推行破坏稳定的政策”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E8%B0%B4%E8%B4%A3%E5%8C%97%E4%BA%AC%E5%9C%A8%E5%8D%97%E6%B5%B7-%E7%A0%B4%E5%9D%8F%E7%A8%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786223502000.webp","sourceId":"rfi"},{"id":1786223086000,"createdDate":"2026-08-08 21:04","name":"法国国际广播电台","title":"中国对德国出口再次大幅增长","content":"据德国《商报》报道：中国商品的出口热潮仍在持续，中国对德国出口再次大幅增长，给德国带来影响。与此同时，中国国内经济失衡正在进一步加剧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E5%BE%B7%E5%9B%BD%E5%87%BA%E5%8F%A3%E5%86%8D%E6%AC%A1%E5%A4%A7%E5%B9%85%E5%A2%9E%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786223086000.webp","sourceId":"rfi"},{"id":1786222582000,"createdDate":"2026-08-08 20:56","name":"法国国际广播电台","title":"美拟取消H-1B劳工60天宽限期 RFE补件规定收紧可直接拒签","content":"美国国土安全部（DHS）正考虑取消部分外籍劳工，失去工作后可享有的60天宽限期，若这项提案最终实施，持H-1B、L-1、O-1等工作签证的外籍人士遭解雇后，寻找新雇主、转换移民身分或安排离境的时间将大幅缩短。这项措施目前仍在白宫管理及预算办公室（OMB）审查，尚未生效，现行60天宽限期仍然有效。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260808-%E7%BE%8E%E6%8B%9F%E5%8F%96%E6%B6%88h-1b%E5%8A%B3%E5%B7%A560%E5%A4%A9%E5%AE%BD%E9%99%90%E6%9C%9F-rfe%E8%A1%A5%E4%BB%B6%E8%A7%84%E5%AE%9A%E6%94%B6%E7%B4%A7%E5%8F%AF%E7%9B%B4%E6%8E%A5%E6%8B%92%E7%AD%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786222582000.webp","sourceId":"rfi"},{"id":1786210228000,"createdDate":"2026-08-08 17:30","name":"法国国际广播电台","title":"法国总统大选：马克龙党派候选人阿塔尔提起诉讼谴责俄罗斯干预","content":"目前法国已有三名候选人或潜在的候选人受到来自疑似俄罗斯网络的造谣污蔑，这场网络攻击的目标，似乎未涉及被视为亲莫斯科的极左翼和对俄较温和的极右翼...","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260808-%E6%B3%95%E5%9B%BD%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%85%9A%E6%B4%BE%E5%80%99%E9%80%89%E4%BA%BA%E9%98%BF%E5%A1%94%E5%B0%94%E6%8F%90%E8%B5%B7%E8%AF%89%E8%AE%BC%E8%B0%B4%E8%B4%A3%E4%BF%84%E7%BD%97%E6%96%AF%E5%B9%B2%E9%A2%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786210228000.webp","sourceId":"rfi"}]