[{"id":1786177161000,"createdDate":"2026-08-08 08:19","name":"法国国际广播电台","title":"哥伦比亚极右翼新总统宣誓就职 美国宣布拟对哥提供10亿美元安全援助","content":"哥伦比亚新当选总统阿韦拉多·德拉埃斯普列亚周五（8月7日）宣誓就职，任期4年。他在就职演说中承诺铁腕整治贩毒和治安，并实施财政紧缩、推动税制改革，以恢复市场对哥伦比亚经济的信心。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260808-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%96%B0%E6%80%BB%E7%BB%9F%E5%AE%A3%E8%AA%93%E5%B0%B1%E8%81%8C-%E7%BE%8E%E5%9B%BD%E5%AE%A3%E5%B8%83%E6%8B%9F%E5%AF%B9%E5%93%A5%E6%8F%90%E4%BE%9B10%E4%BA%BF%E7%BE%8E%E5%85%83%E5%AE%89%E5%85%A8%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786177161000.webp","sourceId":"rfi"},{"id":1786175938000,"createdDate":"2026-08-08 07:58","name":"法国国际广播电台","title":"台湾将重返太平洋岛国论坛尽管北京反对","content":"尽管北京反对台湾在外交舞台上以任何形式出现，但太平洋岛国年度峰会秘书长周五表示，台湾将能够参加即将在帕劳举行的下一届年度论坛。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260808-%E5%8F%B0%E6%B9%BE%E5%B0%86%E9%87%8D%E8%BF%94%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%B0%BD%E7%AE%A1%E5%8C%97%E4%BA%AC%E5%8F%8D%E5%AF%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786175938000.webp","sourceId":"rfi"},{"id":1786171274000,"createdDate":"2026-08-08 06:41","name":"法国国际广播电台","title":"日本自卫队试射“战斧”巡航导弹  中国呼吁联合遏制“新型军国主义”","content":"据日本防卫省介绍，日本时间7月29日，派往美国的海上自卫队宙斯盾舰在太平洋海域实施“战斧”巡航导弹实弹发射试验。中国国防部发言人8月7日表示：国际社会必须团结起来、行动起来，共同遏制日本“新型军国主义”成势为患、祸乱世界。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260808-%E6%97%A5%E6%9C%AC%E8%87%AA%E5%8D%AB%E9%98%9F%E8%AF%95%E5%B0%84-%E6%88%98%E6%96%A7-%E5%B7%A1%E8%88%AA%E5%AF%BC%E5%BC%B9-%E4%B8%AD%E5%9B%BD%E5%91%BC%E5%90%81%E8%81%94%E5%90%88%E9%81%8F%E5%88%B6-%E6%96%B0%E5%9E%8B%E5%86%9B%E5%9B%BD%E4%B8%BB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786171274000.webp","sourceId":"rfi"},{"id":1786171077000,"createdDate":"2026-08-08 06:37","name":"法国国际广播电台","title":"美国将向关键矿产领域投资30亿美元，以增强国防供应链，降低对中国依赖","content":"美国总统特朗普周五（8月7日）表示，美国政府将向关键矿产和电池项目投资30亿美元，以推动国内生产，并加强国家安全和产业政策。路透社称，这一政策和伊朗战争对武器库存的消耗与中国对关键矿产的垄断有关。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260808-%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%90%91%E5%85%B3%E9%94%AE%E7%9F%BF%E4%BA%A7%E9%A2%86%E5%9F%9F%E6%8A%95%E8%B5%8430%E4%BA%BF%E7%BE%8E%E5%85%83%EF%BC%8C%E4%BB%A5%E5%A2%9E%E5%BC%BA%E5%9B%BD%E9%98%B2%E4%BE%9B%E5%BA%94%E9%93%BE%EF%BC%8C%E9%99%8D%E4%BD%8E%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/08/1786171077000.webp","sourceId":"rfi"}]