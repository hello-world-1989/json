[{"id":1785574997000,"createdDate":"2026-08-01 09:03","name":"法国国际广播电台","title":"为平息争议，国际足联宣布放弃引入私人投资计划","content":"面对连日来此起彼伏的批评声浪，国际足球联合会主席因凡蒂诺8月1日宣布放弃他几天前提出的开放私人投资入股的计划。因凡蒂诺在公报中表示，这项提案的初始目的不是制造分裂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E4%B8%BA%E5%B9%B3%E6%81%AF%E4%BA%89%E8%AE%AE%EF%BC%8C%E5%9B%BD%E9%99%85%E8%B6%B3%E8%81%94%E5%AE%A3%E5%B8%83%E6%94%BE%E5%BC%83%E5%BC%95%E5%85%A5%E7%A7%81%E4%BA%BA%E6%8A%95%E8%B5%84%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785574997000.webp","sourceId":"rfi"},{"id":1785572538000,"createdDate":"2026-08-01 08:22","name":"法国国际广播电台","title":"路透社照片曝光贝森特“待办”清单：拟投50亿至100亿美元买日元，意图干预日圆汇率？","content":"据路透社在戴维营拍摄的一张照片显示，美国财长贝森特（ScottBessent）周五（7月31日）在总统特朗普的内阁会议期间，无意中曝光了一份“待办”清单，显示他正考虑由美国出资50亿至100亿美元来买入日元，此举或意味着美国财政部计划出手干预日圆汇率。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260801-%E8%B7%AF%E9%80%8F%E7%A4%BE%E7%85%A7%E7%89%87%E6%9B%9D%E5%85%89%E8%B4%9D%E6%A3%AE%E7%89%B9-%E5%BE%85%E5%8A%9E-%E6%B8%85%E5%8D%95-%E6%8B%9F%E6%8A%9550%E4%BA%BF%E8%87%B3100%E4%BA%BF%E7%BE%8E%E5%85%83%E4%B9%B0%E6%97%A5%E5%85%83%EF%BC%8C%E6%84%8F%E5%9B%BE%E5%B9%B2%E9%A2%84%E6%97%A5%E5%9C%86%E6%B1%87%E7%8E%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785572538000.webp","sourceId":"rfi"},{"id":1785605046000,"createdDate":"2026-08-01 17:24","name":"法国国际广播电台","title":"路透：习近平敦促加大军队反腐力度 推现代化进程","content":"路透社引述中国官媒新华社31日报道，中国国家主席习近平周五在中共最高领导机构政治局小组会议上敦促执政的共产党高级领导人深化军队反腐败斗争，推进国防现代化建设。习近平强调“枪必须始终服从党的命令”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260801-%E8%B7%AF%E9%80%8F-%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%95%A6%E4%BF%83%E5%8A%A0%E5%A4%A7%E5%86%9B%E9%98%9F%E5%8F%8D%E8%85%90%E5%8A%9B%E5%BA%A6-%E6%8E%A8%E7%8E%B0%E4%BB%A3%E5%8C%96%E8%BF%9B%E7%A8%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785605046000.webp","sourceId":"rfi"},{"id":1785604223000,"createdDate":"2026-08-01 17:10","name":"法国国际广播电台","title":"菲律宾在民主礁划设领海基线 中国在黄岩岛附近海空演习","content":"法新社8月1日报道说，中国称，周六在与菲律宾存在主权争议的斯卡伯勒礁（中国称黄岩岛）附近进行了军事演习和海岸警卫队演习，这是继上周发生冲突后，中方将回应力度进一步升级。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%9C%A8%E6%B0%91%E4%B8%BB%E7%A4%81%E5%88%92%E8%AE%BE%E9%A2%86%E6%B5%B7%E5%9F%BA%E7%BA%BF-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E9%BB%84%E5%B2%A9%E5%B2%9B%E9%99%84%E8%BF%91%E6%B5%B7%E7%A9%BA%E6%BC%94%E4%B9%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785604223000.webp","sourceId":"rfi"},{"id":1785600763000,"createdDate":"2026-08-01 16:12","name":"法国国际广播电台","title":"山西精神科女医「10级美颜证件照」爆红 网民笑疯：没挂号抑郁症就好了","content":"综合多家华文媒体报道，中国山西医科大学第一医院精神科医师郎小娥，近日意外成为网络话题人物，原因并非其医疗事迹，而是一张美颜效果明显的证件照。照片曝光后，由于修图滤镜相当强烈，与一般医疗院所常见的写实证件照风格差异甚大，引发大批网友热烈讨论，也让她迅速登上中国社群平台热搜。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260801-%E5%B1%B1%E8%A5%BF%E7%B2%BE%E7%A5%9E%E7%A7%91%E5%A5%B3%E5%8C%BB-10%E7%BA%A7%E7%BE%8E%E9%A2%9C%E8%AF%81%E4%BB%B6%E7%85%A7-%E7%88%86%E7%BA%A2-%E7%BD%91%E6%B0%91%E7%AC%91%E7%96%AF-%E6%B2%A1%E6%8C%82%E5%8F%B7%E6%8A%91%E9%83%81%E7%97%87%E5%B0%B1%E5%A5%BD%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785600763000.webp","sourceId":"rfi"},{"id":1785599875000,"createdDate":"2026-08-01 15:57","name":"法国国际广播电台","title":"伊朗指控美国助长“紧张局势升级” 阿曼附近一油轮遭袭","content":"伊朗军方周六指责美国助长中东战争中的“紧张局势升级”，并警告华盛顿在该地区的盟友，要求他们“重新考虑（与美国）合作”。一艘油轮在阿曼一侧的霍尔木兹海峡入口出遭“不明弹体”袭击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E4%BC%8A%E6%9C%97%E6%8C%87%E6%8E%A7%E7%BE%8E%E5%9B%BD%E5%8A%A9%E9%95%BF-%E7%B4%A7%E5%BC%A0%E5%B1%80%E5%8A%BF%E5%8D%87%E7%BA%A7-%E9%98%BF%E6%9B%BC%E9%99%84%E8%BF%91%E4%B8%80%E6%B2%B9%E8%BD%AE%E9%81%AD%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785599875000.webp","sourceId":"rfi"},{"id":1785598600000,"createdDate":"2026-08-01 15:36","name":"法国国际广播电台","title":"「中国制造」不再等同于廉价、粗劣的产品 中国鹅肝及「黑黄金」鱼子酱成全球霸主","content":"中国品牌逐渐在高端美食领域占据主导地位，鹅肝、松露及与鱼子酱并列「西方三大珍馐」，这几年默默地在中国起革命。当中国以完整供应链、现代化养殖技术及成本控制能力介入，不单使中国成为全球最大规模的生产基地，还把价格大大拉低，令更多家庭可享受这些美味食材。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260801-%E4%B8%AD%E5%9B%BD%E5%88%B6%E9%80%A0-%E4%B8%8D%E5%86%8D%E7%AD%89%E5%90%8C%E4%BA%8E%E5%BB%89%E4%BB%B7-%E7%B2%97%E5%8A%A3%E7%9A%84%E4%BA%A7%E5%93%81-%E4%B8%AD%E5%9B%BD%E9%B9%85%E8%82%9D%E5%8F%8A-%E9%BB%91%E9%BB%84%E9%87%91-%E9%B1%BC%E5%AD%90%E9%85%B1%E6%88%90%E5%85%A8%E7%90%83%E9%9C%B8%E4%B8%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785598600000.webp","sourceId":"rfi"},{"id":1785598018000,"createdDate":"2026-08-01 15:26","name":"法国国际广播电台","title":"中国在日中中间线附近建立新设施 日本强烈抗议","content":"日本政府31日宣布，已确认中国方面正在东海日中中间线中国一侧海域进行设置一座新设施的相关动向。该设施被认为与资源开发有关。同日，日本外务省亚洲大洋洲局局长金井正彰向中国驻日本大使馆公使衔参赞施泳提出强烈抗议，表示“不能接受单方面开发行为”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260801-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E6%97%A5%E4%B8%AD%E4%B8%AD%E9%97%B4%E7%BA%BF%E9%99%84%E8%BF%91%E5%BB%BA%E7%AB%8B%E6%96%B0%E8%AE%BE%E6%96%BD-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785598018000.webp","sourceId":"rfi"},{"id":1785592332000,"createdDate":"2026-08-01 13:52","name":"法国国际广播电台","title":"俄罗斯导弹狂炸基辅 至少9人遇难 乌克兰急需爱国者拦截系统","content":"基辅8月1日凌晨再遭俄罗斯夜袭，导弹倾泻到市区，据周六上午公布的统计数据，已知9人遇难，28人伤。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E4%BF%84%E7%BD%97%E6%96%AF%E5%AF%BC%E5%BC%B9%E7%8B%82%E7%82%B8%E5%9F%BA%E8%BE%85-%E8%87%B3%E5%B0%919%E4%BA%BA%E9%81%87%E9%9A%BE-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%80%A5%E9%9C%80%E7%88%B1%E5%9B%BD%E8%80%85%E6%8B%A6%E6%88%AA%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785592332000.webp","sourceId":"rfi"},{"id":1785591409000,"createdDate":"2026-08-01 13:36","name":"法国国际广播电台","title":"西班牙飞地爆移民潮 法国意大利加强边控 芬兰丹麦支持将西班牙逐出申根","content":"本周约有6万名来自摩洛哥的移民非法进入西班牙飞地休达，引发欧盟内部危机，意大利和法国于周六加强了与西班牙的边境管控。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E8%A5%BF%E7%8F%AD%E7%89%99%E9%A3%9E%E5%9C%B0%E7%88%86%E7%A7%BB%E6%B0%91%E6%BD%AE-%E6%B3%95%E5%9B%BD%E6%84%8F%E5%A4%A7%E5%88%A9%E5%8A%A0%E5%BC%BA%E8%BE%B9%E6%8E%A7-%E8%8A%AC%E5%85%B0%E4%B8%B9%E9%BA%A6%E6%94%AF%E6%8C%81%E5%B0%86%E8%A5%BF%E7%8F%AD%E7%89%99%E9%80%90%E5%87%BA%E7%94%B3%E6%A0%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785591409000.webp","sourceId":"rfi"},{"id":1785590564000,"createdDate":"2026-08-01 13:22","name":"法国国际广播电台","title":"特朗普政府官员据报正商讨接手伦敦中国“超级大使馆”地块","content":"英国政府高层消息人士透露：“美国国务院最高层官员已就这一想法商讨数月，并对此非常赞赏。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%AE%98%E5%91%98%E6%8D%AE%E6%8A%A5%E6%AD%A3%E5%95%86%E8%AE%A8%E6%8E%A5%E6%89%8B%E4%BC%A6%E6%95%A6%E4%B8%AD%E5%9B%BD-%E8%B6%85%E7%BA%A7%E5%A4%A7%E4%BD%BF%E9%A6%86-%E5%9C%B0%E5%9D%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785590564000.webp","sourceId":"rfi"},{"id":1785588956000,"createdDate":"2026-08-01 12:55","name":"法国国际广播电台","title":"台湾向林荣基致敬 表彰他对抗中共政权的精神 承诺不让铜锣湾书店消失","content":"邱垂正向媒体表示，林荣基在香港经历铜锣湾书店事件，一度遭到中共关押，后来挺身揭露中共作为；他在2019年移居台湾，在台湾重启铜锣湾书店，他经常对身边的人说，台湾的人权、自由、民主、法治等基本价值和生活方式不是天上掉下来的，必须好好呵护。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260801-%E5%8F%B0%E6%B9%BE%E5%90%91%E6%9E%97%E8%8D%A3%E5%9F%BA%E8%87%B4%E6%95%AC-%E8%A1%A8%E5%BD%B0%E4%BB%96%E5%AF%B9%E6%8A%97%E4%B8%AD%E5%85%B1%E6%94%BF%E6%9D%83%E7%9A%84%E7%B2%BE%E7%A5%9E-%E6%89%BF%E8%AF%BA%E4%B8%8D%E8%AE%A9%E9%93%9C%E9%94%A3%E6%B9%BE%E4%B9%A6%E5%BA%97%E6%B6%88%E5%A4%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785588956000.webp","sourceId":"rfi"},{"id":1785587745000,"createdDate":"2026-08-01 12:35","name":"法国国际广播电台","title":"中国非洲大布局：摩洛哥停发台湾人签证 台外交部依对等原则反制","content":"摩洛哥23日骤然停止发放台湾人签证，台湾外交部30日表示依对等原则暂停受理摩洛哥人来台签证。台湾媒体人分析，这是中国长年非洲大布局下的最新间接效应。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E4%B8%AD%E5%9B%BD%E9%9D%9E%E6%B4%B2%E5%A4%A7%E5%B8%83%E5%B1%80-%E6%91%A9%E6%B4%9B%E5%93%A5%E5%81%9C%E5%8F%91%E5%8F%B0%E6%B9%BE%E4%BA%BA%E7%AD%BE%E8%AF%81-%E5%8F%B0%E5%A4%96%E4%BA%A4%E9%83%A8%E4%BE%9D%E5%AF%B9%E7%AD%89%E5%8E%9F%E5%88%99%E5%8F%8D%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785587745000.webp","sourceId":"rfi"},{"id":1785581084000,"createdDate":"2026-08-01 10:44","name":"法国国际广播电台","title":"路透社调查：中国军方利用美国AI模型提升国防能力，“模型蒸馏”技术成中美争端新爆点","content":"在八一建军节中国国家主席习近平强调要“高质量推进国防和军队现代化，如期实现建军一百年奋斗目标”的前夕，据路透社独家对80多篇中国学术论文和专利的审查显示，中国军事研究人员利用OpenAI和Anthropic开发的美国领先人工智能模型的输出结果，训练国内人工智能系统，以加速提升中国的国防能力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260801-%E8%B7%AF%E9%80%8F%E7%A4%BE%E8%B0%83%E6%9F%A5-%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E5%88%A9%E7%94%A8%E7%BE%8E%E5%9B%BDai%E6%A8%A1%E5%9E%8B%E6%8F%90%E5%8D%87%E5%9B%BD%E9%98%B2%E8%83%BD%E5%8A%9B%EF%BC%8C-%E6%A8%A1%E5%9E%8B%E8%92%B8%E9%A6%8F-%E6%8A%80%E6%9C%AF%E6%88%90%E4%B8%AD%E7%BE%8E%E4%BA%89%E7%AB%AF%E6%96%B0%E7%88%86%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785581084000.webp","sourceId":"rfi"}]