[{"id":1785574997000,"createdDate":"2026-08-01 09:03","name":"法国国际广播电台","title":"为平息争议，国际足联宣布放弃引入私人投资计划","content":"面对连日来此起彼伏的批评声浪，国际足球联合会主席因凡蒂诺8月1日宣布放弃他几天前提出的开放私人投资入股的计划。因凡蒂诺在公报中表示，这项提案的初始目的不是制造分裂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260801-%E4%B8%BA%E5%B9%B3%E6%81%AF%E4%BA%89%E8%AE%AE%EF%BC%8C%E5%9B%BD%E9%99%85%E8%B6%B3%E8%81%94%E5%AE%A3%E5%B8%83%E6%94%BE%E5%BC%83%E5%BC%95%E5%85%A5%E7%A7%81%E4%BA%BA%E6%8A%95%E8%B5%84%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785574997000.webp","sourceId":"rfi"},{"id":1785572538000,"createdDate":"2026-08-01 08:22","name":"法国国际广播电台","title":"路透社照片曝光贝森特“待办”清单：拟投50亿至100亿美元买日元，意图干预日圆汇率？","content":"据路透社在戴维营拍摄的一张照片显示，美国财长贝森特（ScottBessent）周五（7月31日）在总统特朗普的内阁会议期间，无意中曝光了一份“待办”清单，显示他正考虑由美国出资50亿至100亿美元来买入日元，此举或意味着美国财政部计划出手干预日圆汇率。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260801-%E8%B7%AF%E9%80%8F%E7%A4%BE%E7%85%A7%E7%89%87%E6%9B%9D%E5%85%89%E8%B4%9D%E6%A3%AE%E7%89%B9-%E5%BE%85%E5%8A%9E-%E6%B8%85%E5%8D%95-%E6%8B%9F%E6%8A%9550%E4%BA%BF%E8%87%B3100%E4%BA%BF%E7%BE%8E%E5%85%83%E4%B9%B0%E6%97%A5%E5%85%83%EF%BC%8C%E6%84%8F%E5%9B%BE%E5%B9%B2%E9%A2%84%E6%97%A5%E5%9C%86%E6%B1%87%E7%8E%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/01/1785572538000.webp","sourceId":"rfi"}]