[{"id":1786756889000,"createdDate":"2026-08-15 01:21","name":"法国国际广播电台","title":"火灾中，西班牙救回中世纪君主遗骨和珍贵文物","content":"周五，西班牙东北部的一场山火愈演愈烈，迫使人们紧急转移安葬于阿拉贡地区的中世纪君主遗骨；与此同时，消防人员正争分夺秒地抢救一座拥有千年历史的修道院。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260815-%E7%81%AB%E7%81%BE%E4%B8%AD%EF%BC%8C%E8%A5%BF%E7%8F%AD%E7%89%99%E6%95%91%E5%9B%9E%E4%B8%AD%E4%B8%96%E7%BA%AA%E5%90%9B%E4%B8%BB%E9%81%97%E9%AA%A8%E5%92%8C%E7%8F%8D%E8%B4%B5%E6%96%87%E7%89%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786756889000.webp","sourceId":"rfi"},{"id":1786809145000,"createdDate":"2026-08-15 15:52","name":"法国国际广播电台","title":"2021年喀布尔陷落带来的三个关键启示","content":"2021年8月15日，在总统阿什拉夫·加尼（AshrafGhani）仓促出逃后，塔​​利班占领了首都喀布尔；与此同时，已在该国驻扎20年的美国也加速了撤离步伐。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260815-2021%E5%B9%B4%E5%96%80%E5%B8%83%E5%B0%94%E9%99%B7%E8%90%BD%E5%B8%A6%E6%9D%A5%E7%9A%84%E4%B8%89%E4%B8%AA%E5%85%B3%E9%94%AE%E5%90%AF%E7%A4%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786809145000.webp","sourceId":"rfi"},{"id":1786808727000,"createdDate":"2026-08-15 15:45","name":"法国国际广播电台","title":"仅靠对华“去风险”已经不够了","content":"据德国《商报》报道，在对华事务上，问题已不再只涉及贸易和投资前景，而早已涉及就业岗位的流失以及政治行动能力。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260815-%E4%BB%85%E9%9D%A0%E5%AF%B9%E5%8D%8E-%E5%8E%BB%E9%A3%8E%E9%99%A9-%E5%B7%B2%E7%BB%8F%E4%B8%8D%E5%A4%9F%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786808727000.webp","sourceId":"rfi"},{"id":1786807481000,"createdDate":"2026-08-15 15:24","name":"法国国际广播电台","title":"非法拍摄美怀特曼空军基地及B-2轰炸机 中国男子判囚六个月 将被遣返","content":"去年12月，中国公民吴麒麟（QilinWu、音译）因涉嫌拍摄美国空军基地及其军事装备，包括B-2“幽灵”隐形战略轰炸机而被捕。吴麒麟当时在被警告不得拍摄位于密苏里州的怀特曼空军基地后仍返回该基地，随后被判处六个月联邦监禁；来自美国空军的消息指，该案的定罪依据是一项由前总统杜鲁门（HarryTruman）在76年前签署的行政命令。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260815-%E9%9D%9E%E6%B3%95%E6%8B%8D%E6%91%84%E7%BE%8E%E6%80%80%E7%89%B9%E6%9B%BC%E7%A9%BA%E5%86%9B%E5%9F%BA%E5%9C%B0%E5%8F%8Ab-2%E8%BD%B0%E7%82%B8%E6%9C%BA%E4%B8%AD%E5%9B%BD%E7%94%B7%E5%AD%90%E5%88%A4%E5%9B%9A%E5%85%AD%E4%B8%AA%E6%9C%88-%E5%B0%86%E8%A2%AB%E9%81%A3%E8%BF%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786807481000.webp","sourceId":"rfi"},{"id":1786804495000,"createdDate":"2026-08-15 14:34","name":"法国国际广播电台","title":"习近平访美前 特朗普政府据报准备无序令中方不安 可交付成果进展甚微","content":"据《南华早报》报导称，距离中国国家主席习近平计划中的华盛顿之行——这也将是他自2015年以来首次以国事访问规格访美——已不足六周，特朗普政府内部的混乱局面令北京方面日益感到不安。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260815-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E%E5%89%8D-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E6%8D%AE%E6%8A%A5%E5%87%86%E5%A4%87%E6%97%A0%E5%BA%8F%E4%BB%A4%E4%B8%AD%E6%96%B9%E4%B8%8D%E5%AE%89-%E5%8F%AF%E4%BA%A4%E4%BB%98%E6%88%90%E6%9E%9C%E8%BF%9B%E5%B1%95%E7%94%9A%E5%BE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786804495000.webp","sourceId":"rfi"},{"id":1786802464000,"createdDate":"2026-08-15 14:01","name":"法国国际广播电台","title":"美海岸警卫队人员在台与海巡署开展交流培训 为期两周","content":"台湾海洋委员会海巡署（简称海巡署）周五通过新闻稿表示，“为持续深化台美海巡专业交流，提升海上执法及勤务应处能力，美国海岸防卫队（又译作美国海岸警卫队、USCG）机动辅训团（MTT）来台办理‘小艇操作：团队部署与巡逻’训练，8月10日于海洋委员会海巡署教育训练测考中心举行开训典礼，透过美方专业教官实务经验与训练模式，强化海巡人员小艇操作、团队协同及海上巡逻等专业能力”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260815-%E7%BE%8E%E6%B5%B7%E5%B2%B8%E8%AD%A6%E5%8D%AB%E9%98%9F%E4%BA%BA%E5%91%98%E5%9C%A8%E5%8F%B0%E4%B8%8E%E6%B5%B7%E5%B7%A1%E7%BD%B2%E5%BC%80%E5%B1%95%E4%BA%A4%E6%B5%81%E5%9F%B9%E8%AE%AD-%E4%B8%BA%E6%9C%9F%E4%B8%A4%E5%91%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786802464000.webp","sourceId":"rfi"},{"id":1786800954000,"createdDate":"2026-08-15 13:35","name":"法国国际广播电台","title":"英军火巨头贝宜系统向中国等国出口技术数据 违反美法规将支付3600万美元罚款","content":"英国最大防务企业贝宜系统公司（BAESystems）因违反美国武器出口法规逾百次，将支付3600万美元的民事罚款。美国国务院周四宣布，已与贝宜系统的美国分公司达成行政和解，以解决涉及违反美《武器出口管制法》及《国际武器贸易条例》的104起违规行为。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260815-%E8%8B%B1%E5%86%9B%E7%81%AB%E5%B7%A8%E5%A4%B4%E8%B4%9D%E5%AE%9C%E7%B3%BB%E7%BB%9F%E5%90%91%E4%B8%AD%E5%9B%BD%E7%AD%89%E5%9B%BD%E5%87%BA%E5%8F%A3%E6%8A%80%E6%9C%AF%E6%95%B0%E6%8D%AE-%E8%BF%9D%E5%8F%8D%E7%BE%8E%E6%B3%95%E8%A7%84%E5%B0%86%E6%94%AF%E4%BB%983600%E4%B8%87%E7%BE%8E%E5%85%83%E7%BD%9A%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786800954000.webp","sourceId":"rfi"},{"id":1786798458000,"createdDate":"2026-08-15 12:54","name":"法国国际广播电台","title":"小马科斯：望年底前完成菲日海域划界谈判，不认为存在任何重大障碍","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）周五表示，希望能于今年年底前完成与日本的海域划界谈判。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260815-%E5%B0%8F%E9%A9%AC%E7%A7%91%E6%96%AF-%E6%9C%9B%E5%B9%B4%E5%BA%95%E5%89%8D%E5%AE%8C%E6%88%90%E8%8F%B2%E6%97%A5%E6%B5%B7%E5%9F%9F%E5%88%92%E7%95%8C%E8%B0%88%E5%88%A4%EF%BC%8C%E4%B8%8D%E8%AE%A4%E4%B8%BA%E5%AD%98%E5%9C%A8%E4%BB%BB%E4%BD%95%E9%87%8D%E5%A4%A7%E9%9A%9C%E7%A2%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786798458000.webp","sourceId":"rfi"},{"id":1786794212000,"createdDate":"2026-08-15 11:43","name":"法国国际广播电台","title":"澳外长以国家安全为由叫停山东大学澳国立联合理学院","content":"澳大利亚外交部长黄英贤以国家安全为由叫停了澳大利亚国立大学和昆士兰大学分别与两所中国院校和机构达成的合作协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260815-%E6%BE%B3%E5%A4%96%E9%95%BF%E4%BB%A5%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8%E4%B8%BA%E7%94%B1%E5%8F%AB%E5%81%9C%E5%B1%B1%E4%B8%9C%E5%A4%A7%E5%AD%A6%E6%BE%B3%E5%9B%BD%E7%AB%8B%E8%81%94%E5%90%88%E7%90%86%E5%AD%A6%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786794212000.webp","sourceId":"rfi"},{"id":1786794067000,"createdDate":"2026-08-15 11:41","name":"法国国际广播电台","title":"高市“8·15”致辞不谈“反省”  四阁僚参拜靖国神社","content":"在8月15日日本终战纪念日，日本首相高市早苗就任后首次出席了在东京日本武道馆由日本政府主办的全国战殁者追悼仪式，并发表致辞称：“绝不让战争的惨祸重演。我们将把这一坚定的誓言跨越世代传承下去，并贯彻到底。”她没有使用石破茂前首相在2025年时隔13年重新恢复使用的“反省”和“不战的誓言”等表述。中国外交部发言人15日则就日本政要当日参拜供奉甲级战犯的靖国神社答问时表示，中方强烈谴责日方涉靖国神社消极动向，已向日方提出严正交涉、强烈抗议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260815-%E9%AB%98%E5%B8%82-8%C2%B715-%E8%87%B4%E8%BE%9E%E4%B8%8D%E8%B0%88-%E5%8F%8D%E7%9C%81-%E5%9B%9B%E9%98%81%E5%83%9A%E5%8F%82%E6%8B%9C%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786794067000.webp","sourceId":"rfi"},{"id":1786789830000,"createdDate":"2026-08-15 10:30","name":"法国国际广播电台","title":"被白宫涉华“大转运骗局”报告点名 新加坡贸工部：公司应准确申报原产地国家和地区","content":"新加坡贸易与工业部周六（15日）表示，通过该国转运货物的公司应完全遵守新加坡的法律法规，包括准确申报原产地国家和地区。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260815-%E8%A2%AB%E7%99%BD%E5%AE%AB%E6%B6%89%E5%8D%8E-%E5%A4%A7%E8%BD%AC%E8%BF%90%E9%AA%97%E5%B1%80-%E6%8A%A5%E5%91%8A%E7%82%B9%E5%90%8D-%E6%96%B0%E5%8A%A0%E5%9D%A1%E8%B4%B8%E5%B7%A5%E9%83%A8-%E5%85%AC%E5%8F%B8%E5%BA%94%E5%87%86%E7%A1%AE%E7%94%B3%E6%8A%A5%E5%8E%9F%E4%BA%A7%E5%9C%B0%E5%9B%BD%E5%AE%B6%E5%92%8C%E5%9C%B0%E5%8C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786789830000.webp","sourceId":"rfi"},{"id":1786788346000,"createdDate":"2026-08-15 10:05","name":"法国国际广播电台","title":"美商务部长：已清楚告知苹果不希望其从中国采购存储芯片","content":"美国商务部长卢特尼克（HowardLutnick）在受访时表示，特朗普政府不希望苹果公司从中国采购存储芯片。不过，苹果仍可能执意这么做。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260815-%E7%BE%8E%E5%95%86%E5%8A%A1%E9%83%A8%E9%95%BF-%E5%B7%B2%E6%B8%85%E6%A5%9A%E5%91%8A%E7%9F%A5%E8%8B%B9%E6%9E%9C%E4%B8%8D%E5%B8%8C%E6%9C%9B%E5%85%B6%E4%BB%8E%E4%B8%AD%E5%9B%BD%E9%87%87%E8%B4%AD%E5%AD%98%E5%82%A8%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786788346000.webp","sourceId":"rfi"},{"id":1786786439000,"createdDate":"2026-08-15 09:33","name":"法国国际广播电台","title":"为遏制朝鲜核能力发展，韩国总统提议通过与朝鲜举行会谈正式结束朝鲜战争","content":"韩国总统李在明提议与朝鲜举行会谈，以正式结束旷日持久的朝鲜战争；与此同时，平壤正加深与俄罗斯的联系，并坚持朝鲜作为“不可逆转”核国家的地位。法新社报道，朝韩双方在技术上仍处于战争状态，因为1950年至1953年由朝鲜发起的冲突最终以停战协定而非和平条约收场。李在明是在纪念朝鲜半岛摆脱日本1910年至1945年殖民统治的仪式上发表讲话时提出这一建议的。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260815-%E4%B8%BA%E9%81%8F%E5%88%B6%E6%9C%9D%E9%B2%9C%E6%A0%B8%E8%83%BD%E5%8A%9B%E5%8F%91%E5%B1%95%EF%BC%8C%E9%9F%A9%E5%9B%BD%E6%80%BB%E7%BB%9F%E6%8F%90%E8%AE%AE%E9%80%9A%E8%BF%87%E4%B8%8E%E6%9C%9D%E9%B2%9C%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88%E6%AD%A3%E5%BC%8F%E7%BB%93%E6%9D%9F%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786786439000.webp","sourceId":"rfi"},{"id":1786784995000,"createdDate":"2026-08-15 09:09","name":"法国国际广播电台","title":"无人水面艇摄像头被发现向中国IP地址发送信号 英国防部加强对供应链审查","content":"在发现部分海军无人机向中国发送信号后，英国国防部正加强对其供应链的审查。该部门本周早些时候透露，一项例行网络漏洞评估发现了一个问题，涉及英国皇家海军使用的、由英国海事防务技术公司北海巨妖技术集团（KrakenTechnologyGroup）制造的K3Scout无人水面艇。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260815-%E6%97%A0%E4%BA%BA%E6%B0%B4%E9%9D%A2%E8%89%87%E6%91%84%E5%83%8F%E5%A4%B4%E8%A2%AB%E5%8F%91%E7%8E%B0%E5%90%91%E4%B8%AD%E5%9B%BDip%E5%9C%B0%E5%9D%80%E5%8F%91%E9%80%81%E4%BF%A1%E5%8F%B7-%E8%8B%B1%E5%9B%BD%E9%98%B2%E9%83%A8%E5%8A%A0%E5%BC%BA%E5%AF%B9%E4%BE%9B%E5%BA%94%E9%93%BE%E5%AE%A1%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786784995000.webp","sourceId":"rfi"},{"id":1786784634000,"createdDate":"2026-08-15 09:03","name":"法国国际广播电台","title":"路透独家 ：美国将告知合作伙伴必须在与中国的 AI竞赛中选边  “鱼和熊掌不可兼得”","content":"据一位美国官员及路透社查阅的一份内部草案显示，美国正准备告知数十个国家，它们必须在与中国的“人工智能竞赛”中选边站队；美方警告称，如果这些国家同时也加入北京方面提出的竞争性框架，将被排除在美国主导的人工智能联盟之外。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260815-%E8%B7%AF%E9%80%8F%E7%8B%AC%E5%AE%B6-%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%91%8A%E7%9F%A5%E5%90%88%E4%BD%9C%E4%BC%99%E4%BC%B4%E5%BF%85%E9%A1%BB%E5%9C%A8%E4%B8%8E%E4%B8%AD%E5%9B%BD%E7%9A%84-ai%E7%AB%9E%E8%B5%9B%E4%B8%AD%E9%80%89%E8%BE%B9-%E9%B1%BC%E5%92%8C%E7%86%8A%E6%8E%8C%E4%B8%8D%E5%8F%AF%E5%85%BC%E5%BE%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/15/1786784634000.webp","sourceId":"rfi"}]