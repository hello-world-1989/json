[{"id":1786613771000,"createdDate":"2026-08-13 09:36","name":"法国国际广播电台","title":"朱镕基逝世 日本驻华大使馆发降半旗照片表悼念","content":"中共政治局原常委、中国国务院原总理朱镕基于当地时间周三上午在北京逝世。日本驻华大使馆周四通过其多个社媒平台发布降半旗的日本国旗的照片，并配文：“悼念中华人民共和国前总理朱镕基阁下#朱镕基同志逝世”。在微博上，这则贴文吸引许多中国网友的留言，留下“愿中日友好”、“谢谢”等留言。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E6%9C%B1%E9%95%95%E5%9F%BA%E9%80%9D%E4%B8%96-%E6%97%A5%E6%9C%AC%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF%E9%A6%86%E5%8F%91%E9%99%8D%E5%8D%8A%E6%97%97%E7%85%A7%E7%89%87%E8%A1%A8%E6%82%BC%E5%BF%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786613771000.webp","sourceId":"rfi"},{"id":1786613145000,"createdDate":"2026-08-13 09:25","name":"法国国际广播电台","title":"新西兰安全情报局长：在外国干预和间谍活动方面，中国最令我们关切","content":"新西兰安全情报局发出警告称，地缘政治动荡加剧了对该国安全与保障的威胁。在该机构的最新评估中，新西兰安全情报局局长汉普顿（AndrewHampton）形容当前面临的威胁环境是近年来最严峻的。汉普顿表示：“鉴于新西兰的体量和我们位于南太平洋的地理位置，过去12个月里我们所看到的那些具有危害性的行为和活动，对新西兰这样的国家来说威胁性更大”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%AE%89%E5%85%A8%E6%83%85%E6%8A%A5%E5%B1%80%E9%95%BF-%E5%9C%A8%E5%A4%96%E5%9B%BD%E5%B9%B2%E9%A2%84%E5%92%8C%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E6%96%B9%E9%9D%A2%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%9C%80%E4%BB%A4%E6%88%91%E4%BB%AC%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786613145000.webp","sourceId":"rfi"},{"id":1786610910000,"createdDate":"2026-08-13 08:48","name":"法国国际广播电台","title":"库克群岛大选 与中国关系成关键议题","content":"库克群岛星期四（8月13日）开始举行大选投票，近年来，这个小岛国的政治格局主要围绕深海采矿的激烈辩论、与盟友新西兰的外交裂痕以及该国外交伙伴关系的重大调整展开。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E5%BA%93%E5%85%8B%E7%BE%A4%E5%B2%9B%E5%A4%A7%E9%80%89-%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%85%B3%E7%B3%BB%E6%88%90%E5%85%B3%E9%94%AE%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786610910000.webp","sourceId":"rfi"},{"id":1786609783000,"createdDate":"2026-08-13 08:29","name":"法国国际广播电台","title":"普京访问北方四岛中的择捉岛 日本强烈抗议","content":"俄罗斯总统府消息，13日，俄罗斯总统普京访问了日本认为是其“北方领土”的择捉岛（俄称伊图鲁普岛）。这是普京首次访问北方四岛（俄称南千岛群岛）中的岛屿。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260813-%E6%99%AE%E4%BA%AC%E8%AE%BF%E9%97%AE%E5%8C%97%E6%96%B9%E5%9B%9B%E5%B2%9B%E4%B8%AD%E7%9A%84%E6%8B%A9%E6%8D%89%E5%B2%9B-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786609783000.webp","sourceId":"rfi"},{"id":1786604668000,"createdDate":"2026-08-13 07:04","name":"法国国际广播电台","title":"自闭少年因厕格内写「光时」口号判感化令 成新煽动罪获判非监禁首案","content":"患有自闭症的一名大专生，去年三度在尖沙咀中港城男厕内，写下被香港法院裁定具有煽动意图的「光复香港，时代革命」（简称「光时」）等字句，被裁定煽动罪名成立，被判接受监管和辅导的感化令，毋须监禁。这是《维护国家安全条例》（即《基本法》23条）实施后，首宗煽动罪罪成但被判非监禁式刑罚的案件。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260813-%E8%87%AA%E9%97%AD%E5%B0%91%E5%B9%B4%E5%9B%A0%E5%8E%95%E6%A0%BC%E5%86%85%E5%86%99-%E5%85%89%E6%97%B6-%E5%8F%A3%E5%8F%B7%E5%88%A4%E6%84%9F%E5%8C%96%E4%BB%A4-%E6%88%90%E6%96%B0%E7%85%BD%E5%8A%A8%E7%BD%AA%E8%8E%B7%E5%88%A4%E9%9D%9E%E7%9B%91%E7%A6%81%E9%A6%96%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786604668000.webp","sourceId":"rfi"},{"id":1786604352000,"createdDate":"2026-08-13 06:59","name":"法国国际广播电台","title":"悼朱镕基大不同：民间广传朱称治港不好北京有责 官方大谈朱助港度金融风暴","content":"国务院前总理朱镕基是与香港交集甚深的中国领导人之一，曾四度访港，还曾高呼「我爱香港」，深受港人熟悉和爱戴。中港官方盛赞他在亚洲金融危机时，力挺香港免受国际炒家狙击，维护了金融中心的稳定，自然亦保住了香港凡繁荣；但市民留言悼念他之馀，更多是广传他的名句：「香港回归祖国，在我们的手里搞坏了，那我们岂不成了民族罪人？不会的」，藉此怀缅名以古喻今。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260813-%E6%82%BC%E6%9C%B1%E9%95%95%E5%9F%BA%E5%A4%A7%E4%B8%8D%E5%90%8C-%E6%B0%91%E9%97%B4%E5%B9%BF%E4%BC%A0%E6%9C%B1%E7%A7%B0%E6%B2%BB%E6%B8%AF%E4%B8%8D%E5%A5%BD%E5%8C%97%E4%BA%AC%E6%9C%89%E8%B4%A3-%E5%AE%98%E6%96%B9%E5%A4%A7%E8%B0%88%E6%9C%B1%E5%8A%A9%E6%B8%AF%E5%BA%A6%E9%87%91%E8%9E%8D%E9%A3%8E%E6%9A%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786604352000.webp","sourceId":"rfi"}]