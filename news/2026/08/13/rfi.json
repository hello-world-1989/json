[{"id":1786613771000,"createdDate":"2026-08-13 09:36","name":"法国国际广播电台","title":"朱镕基逝世 日本驻华大使馆发降半旗照片表悼念","content":"中共政治局原常委、中国国务院原总理朱镕基于当地时间周三上午在北京逝世。日本驻华大使馆周四通过其多个社媒平台发布降半旗的日本国旗的照片，并配文：“悼念中华人民共和国前总理朱镕基阁下#朱镕基同志逝世”。在微博上，这则贴文吸引许多中国网友的留言，留下“愿中日友好”、“谢谢”等留言。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E6%9C%B1%E9%95%95%E5%9F%BA%E9%80%9D%E4%B8%96-%E6%97%A5%E6%9C%AC%E9%A9%BB%E5%8D%8E%E5%A4%A7%E4%BD%BF%E9%A6%86%E5%8F%91%E9%99%8D%E5%8D%8A%E6%97%97%E7%85%A7%E7%89%87%E8%A1%A8%E6%82%BC%E5%BF%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786613771000.webp","sourceId":"rfi"},{"id":1786613145000,"createdDate":"2026-08-13 09:25","name":"法国国际广播电台","title":"新西兰安全情报局长：在外国干预和间谍活动方面，中国最令我们关切","content":"新西兰安全情报局发出警告称，地缘政治动荡加剧了对该国安全与保障的威胁。在该机构的最新评估中，新西兰安全情报局局长汉普顿（AndrewHampton）形容当前面临的威胁环境是近年来最严峻的。汉普顿表示：“鉴于新西兰的体量和我们位于南太平洋的地理位置，过去12个月里我们所看到的那些具有危害性的行为和活动，对新西兰这样的国家来说威胁性更大”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%AE%89%E5%85%A8%E6%83%85%E6%8A%A5%E5%B1%80%E9%95%BF-%E5%9C%A8%E5%A4%96%E5%9B%BD%E5%B9%B2%E9%A2%84%E5%92%8C%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E6%96%B9%E9%9D%A2%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%9C%80%E4%BB%A4%E6%88%91%E4%BB%AC%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786613145000.webp","sourceId":"rfi"},{"id":1786610910000,"createdDate":"2026-08-13 08:48","name":"法国国际广播电台","title":"库克群岛大选 与中国关系成关键议题","content":"库克群岛星期四（8月13日）开始举行大选投票，近年来，这个小岛国的政治格局主要围绕深海采矿的激烈辩论、与盟友新西兰的外交裂痕以及该国外交伙伴关系的重大调整展开。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E5%BA%93%E5%85%8B%E7%BE%A4%E5%B2%9B%E5%A4%A7%E9%80%89-%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%85%B3%E7%B3%BB%E6%88%90%E5%85%B3%E9%94%AE%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786610910000.webp","sourceId":"rfi"},{"id":1786609783000,"createdDate":"2026-08-13 08:29","name":"法国国际广播电台","title":"普京访问北方四岛中的择捉岛 日本强烈抗议","content":"俄罗斯总统府消息，13日，俄罗斯总统普京访问了日本认为是其“北方领土”的择捉岛（俄称伊图鲁普岛）。这是普京首次访问北方四岛（俄称南千岛群岛）中的岛屿。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260813-%E6%99%AE%E4%BA%AC%E8%AE%BF%E9%97%AE%E5%8C%97%E6%96%B9%E5%9B%9B%E5%B2%9B%E4%B8%AD%E7%9A%84%E6%8B%A9%E6%8D%89%E5%B2%9B-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786609783000.webp","sourceId":"rfi"},{"id":1786604668000,"createdDate":"2026-08-13 07:04","name":"法国国际广播电台","title":"自闭少年因厕格内写「光时」口号判感化令 成新煽动罪获判非监禁首案","content":"患有自闭症的一名大专生，去年三度在尖沙咀中港城男厕内，写下被香港法院裁定具有煽动意图的「光复香港，时代革命」（简称「光时」）等字句，被裁定煽动罪名成立，被判接受监管和辅导的感化令，毋须监禁。这是《维护国家安全条例》（即《基本法》23条）实施后，首宗煽动罪罪成但被判非监禁式刑罚的案件。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260813-%E8%87%AA%E9%97%AD%E5%B0%91%E5%B9%B4%E5%9B%A0%E5%8E%95%E6%A0%BC%E5%86%85%E5%86%99-%E5%85%89%E6%97%B6-%E5%8F%A3%E5%8F%B7%E5%88%A4%E6%84%9F%E5%8C%96%E4%BB%A4-%E6%88%90%E6%96%B0%E7%85%BD%E5%8A%A8%E7%BD%AA%E8%8E%B7%E5%88%A4%E9%9D%9E%E7%9B%91%E7%A6%81%E9%A6%96%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786604668000.webp","sourceId":"rfi"},{"id":1786604352000,"createdDate":"2026-08-13 06:59","name":"法国国际广播电台","title":"悼朱镕基大不同：民间广传朱称治港不好北京有责 官方大谈朱助港度金融风暴","content":"国务院前总理朱镕基是与香港交集甚深的中国领导人之一，曾四度访港，还曾高呼「我爱香港」，深受港人熟悉和爱戴。中港官方盛赞他在亚洲金融危机时，力挺香港免受国际炒家狙击，维护了金融中心的稳定，自然亦保住了香港凡繁荣；但市民留言悼念他之馀，更多是广传他的名句：「香港回归祖国，在我们的手里搞坏了，那我们岂不成了民族罪人？不会的」，藉此怀缅名以古喻今。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260813-%E6%82%BC%E6%9C%B1%E9%95%95%E5%9F%BA%E5%A4%A7%E4%B8%8D%E5%90%8C-%E6%B0%91%E9%97%B4%E5%B9%BF%E4%BC%A0%E6%9C%B1%E7%A7%B0%E6%B2%BB%E6%B8%AF%E4%B8%8D%E5%A5%BD%E5%8C%97%E4%BA%AC%E6%9C%89%E8%B4%A3-%E5%AE%98%E6%96%B9%E5%A4%A7%E8%B0%88%E6%9C%B1%E5%8A%A9%E6%B8%AF%E5%BA%A6%E9%87%91%E8%9E%8D%E9%A3%8E%E6%9A%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786604352000.webp","sourceId":"rfi"},{"id":1786640632000,"createdDate":"2026-08-13 17:03","name":"法国国际广播电台","title":"涉嫌收受中方贿赂上千万欧元 德国威能子公司前经理被起诉","content":"据德国N-TV电视台报道，德国北威州威能集团（VaillantGroup）一名前经理，涉嫌从中国供应商处收取了1750万欧元的贿赂。伍珀塔尔（Wuppertal）检察院发言人沃尔夫-蒂尔曼·鲍默特（Wolf-TilmanBaumert）表示，检方已对这名53岁男子提起124项指控，包括受贿罪和背信罪（侵害公司利益、滥用职务等）。但嫌疑人否认指控，反而指责自己的妻子。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260813-%E6%B6%89%E5%AB%8C%E6%94%B6%E5%8F%97%E4%B8%AD%E6%96%B9%E8%B4%BF%E8%B5%82%E4%B8%8A%E5%8D%83%E4%B8%87%E6%AC%A7%E5%85%83-%E5%BE%B7%E5%9B%BD%E5%A8%81%E8%83%BD%E5%AD%90%E5%85%AC%E5%8F%B8%E5%89%8D%E7%BB%8F%E7%90%86%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786640632000.webp","sourceId":"rfi"},{"id":1786639848000,"createdDate":"2026-08-13 16:50","name":"法国国际广播电台","title":"非洲:卢旺达足协会长被控涉跳票","content":"在非洲的大湖区（L'AfriquedesGrandsLacs），卢旺达（leRwanda）足球协会（Ferwafa-Fédérationrwandaisedefootball)会长法布里斯·谢马·恩戈加（FabriceShemaNgoga）现已遭逮捕。他被控涉嫌“跳票”（chèqueenblanc），即开空头支票，或引申意思为：未履行承诺。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260813-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%8D%A2%E6%97%BA%E8%BE%BE%E8%B6%B3%E5%8D%8F%E4%BC%9A%E9%95%BF%E8%A2%AB%E6%8E%A7%E6%B6%89%E8%B7%B3%E7%A5%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786639848000.webp","sourceId":"rfi"},{"id":1786638301000,"createdDate":"2026-08-13 16:25","name":"法国国际广播电台","title":"美战争部副部长谈印太司令部为何改回旧名：美军的战略重点确实在于第一岛链","content":"美国战争部负责政策事务的副部长科尔比（ElbridgeColby）周四表示，目前正在审查的美国新核战略并不是为了强调可能使用战区范围的核武器，而是为了通过设定明确的门槛来吓阻其他国家可能使用核武器。科尔比本周在菲律宾、印尼、泰国和柬埔寨访问。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E7%BE%8E%E6%88%98%E4%BA%89%E9%83%A8%E5%89%AF%E9%83%A8%E9%95%BF%E8%B0%88%E5%8D%B0%E5%A4%AA%E5%8F%B8%E4%BB%A4%E9%83%A8%E4%B8%BA%E4%BD%95%E6%9B%B4%E5%9B%9E%E6%97%A7%E5%90%8D-%E7%BE%8E%E5%86%9B%E7%9A%84%E6%88%98%E7%95%A5%E9%87%8D%E7%82%B9%E7%A1%AE%E5%AE%9E%E5%9C%A8%E4%BA%8E%E7%AC%AC%E4%B8%80%E5%B2%9B%E9%93%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786638301000.webp","sourceId":"rfi"},{"id":1786635003000,"createdDate":"2026-08-13 15:30","name":"法国国际广播电台","title":"中国科研船多次进入帕劳海域引发安全担忧","content":"一艘中国科研船今年5月下旬在未经帕劳方面邀请情况下进入其专属经济区74公里，并在该国海域缓慢航行约14小时，引发帕劳当局的安全担忧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260813-%E4%B8%AD%E5%9B%BD%E7%A7%91%E7%A0%94%E8%88%B9%E5%A4%9A%E6%AC%A1%E8%BF%9B%E5%85%A5%E5%B8%95%E5%8A%B3%E6%B5%B7%E5%9F%9F%E5%BC%95%E5%8F%91%E5%AE%89%E5%85%A8%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786635003000.webp","sourceId":"rfi"},{"id":1786630840000,"createdDate":"2026-08-13 14:20","name":"法国国际广播电台","title":"百余名菲律宾公民在华被处理 菲防长批勒索敲诈 菲外交部促保障被捕国人福祉","content":"菲律宾国防部长特奥多罗（GilbertoTeodoroJr.）周四批评称，针对逾100名涉嫌在中国非法务工及居住的菲律宾人，中方采取的所谓移民执法行动，“纯粹是勒索与敲诈”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260813-%E7%99%BE%E4%BD%99%E5%90%8D%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%85%AC%E6%B0%91%E5%9C%A8%E5%8D%8E%E8%A2%AB%E5%A4%84%E7%90%86-%E8%8F%B2%E9%98%B2%E9%95%BF%E6%89%B9%E5%8B%92%E7%B4%A2%E6%95%B2%E8%AF%88-%E8%8F%B2%E5%A4%96%E4%BA%A4%E9%83%A8%E4%BF%83%E4%BF%9D%E9%9A%9C%E8%A2%AB%E6%8D%95%E5%9B%BD%E4%BA%BA%E7%A6%8F%E7%A5%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786630840000.webp","sourceId":"rfi"},{"id":1786628326000,"createdDate":"2026-08-13 13:38","name":"法国国际广播电台","title":"白宫报告称40余国存在较高的涉华非法转运风险 正开发AI“侦测边境”系统","content":"据彭博社报导，特朗普政府正在开发一套由人工智能驱动的“侦测边境”系统，旨在打击那些涉嫌协助中国规避美国进口关税的贸易伙伴。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260813-%E7%99%BD%E5%AE%AB%E6%8A%A5%E5%91%8A%E7%A7%B040%E4%BD%99%E5%9B%BD%E5%AD%98%E5%9C%A8%E8%BE%83%E9%AB%98%E7%9A%84%E6%B6%89%E5%8D%8E%E9%9D%9E%E6%B3%95%E8%BD%AC%E8%BF%90%E9%A3%8E%E9%99%A9-%E6%AD%A3%E5%BC%80%E5%8F%91ai-%E4%BE%A6%E6%B5%8B%E8%BE%B9%E5%A2%83-%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786628326000.webp","sourceId":"rfi"},{"id":1786626596000,"createdDate":"2026-08-13 13:09","name":"法国国际广播电台","title":"一审被判有罪后 涉擅拍韩军设施和美航母的中国留学生上诉","content":"一名中国留学生因使用无人机非法拍摄停泊有美国海军航空母舰及其他舰艇的釜山海军基地，在一审中被判入狱；他在上诉期间继续对案件的法律依据提出异议，主张“一般利敌罪”的指控适用不当。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260813-%E4%B8%80%E5%AE%A1%E8%A2%AB%E5%88%A4%E6%9C%89%E7%BD%AA%E5%90%8E-%E6%B6%89%E6%93%85%E6%8B%8D%E9%9F%A9%E5%86%9B%E8%AE%BE%E6%96%BD%E5%92%8C%E7%BE%8E%E8%88%AA%E6%AF%8D%E7%9A%84%E4%B8%AD%E5%9B%BD%E7%95%99%E5%AD%A6%E7%94%9F%E4%B8%8A%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786626596000.webp","sourceId":"rfi"},{"id":1786623102000,"createdDate":"2026-08-13 12:11","name":"法国国际广播电台","title":"江泽民官方纪录片触及六四 形容1989年“临危受命”","content":"为纪念中国前领导人江泽民诞辰100周年，由中共中央宣传部、中共中央党史和文献研究院、国家广播电视总局、中央广播电视总台联合摄制十二集文献纪录片《江泽民》。官媒央视从本周二（11日）开始，在晚间黄金时段播出该纪录片。周三晚间播出的第三集《临危受命》，触及江泽民政治生涯从上海市委书记到中共总书记的重大转折，包括以“1989年春夏之交，我国发生严重政治风波”等描述间接提及六四事件。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E6%B1%9F%E6%B3%BD%E6%B0%91%E5%AE%98%E6%96%B9%E7%BA%AA%E5%BD%95%E7%89%87-%E8%A7%A6%E5%8F%8A%E5%85%AD%E5%9B%9B%E5%BD%A2%E5%AE%B91989%E5%B9%B4-%E4%B8%B4%E5%8D%B1%E5%8F%97%E5%91%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786623102000.webp","sourceId":"rfi"},{"id":1786619207000,"createdDate":"2026-08-13 11:06","name":"法国国际广播电台","title":"中美对抗激烈 亚太军演频繁","content":"在不断演变的全球地缘格局中，亚太地区频繁上演多国联合军事演习。今年8月几乎同时登场的韩美军演和中国-印尼军演，分别招致北朝鲜和台湾强烈反弹。评论认为，无论是东北亚的实战化刚性防御，抑或是东南亚灰色地带的政治化外交试探，背后尽显中美大国体系的激烈对抗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260813-%E4%B8%AD%E7%BE%8E%E5%AF%B9%E6%8A%97%E6%BF%80%E7%83%88-%E4%BA%9A%E5%A4%AA%E5%86%9B%E6%BC%94%E9%A2%91%E7%B9%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786619207000.webp","sourceId":"rfi"},{"id":1786618922000,"createdDate":"2026-08-13 11:02","name":"法国国际广播电台","title":"C919国际首航的象征性大于实际突破、中国汽车市场也难逃“快时尚”恶果","content":"大家好，欢迎收听法国报纸摘要。周三8月13日出刊的《解放报》头版指出金融诈骗激增受害者却投诉无门，以及重温周二12日晚难得一见日全食的感动。《十字架报》推出文学专题表示，今年秋季文学季有望呈现开放多元的面貌。在当前充满挑战的图书市场环境下，知名作家和新锐作家都备受期待。与此同时，伴随连续高温而来的农作与畜牧土地干涸问题，将对法国下半年经济产生负面影响，损失可能高达150亿欧元，则是《费加罗报》和《回声报》的关注重点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260813-c919%E9%A6%96%E8%88%AA%E5%9B%BD%E9%99%85%E7%9A%84%E8%B1%A1%E5%BE%81%E6%80%A7%E5%A4%A7%E4%BA%8E%E5%AE%9E%E9%99%85%E7%AA%81%E7%A0%B4-%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%B8%82%E5%9C%BA%E4%B9%9F%E9%9A%BE%E9%80%83-%E5%BF%AB%E6%97%B6%E5%B0%9A-%E6%81%B6%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786618922000.webp","sourceId":"rfi"},{"id":1786618821000,"createdDate":"2026-08-13 11:00","name":"法国国际广播电台","title":"摩洛哥宣布加强安保防非法越境","content":"在北非马格里布地区的摩洛哥王国（le RoyaumeduMaroc），面对民间呼吁在本周末（2026年08月15日星期六）进行新的集会，拉巴特（Rabat）当局宣布加强安保措施，以防民众再次大规模非法越境，强行闯入西班牙飞地休达（Ceuta）的突发事件。这是本台法广非洲组（RFIAfrique）今天（2026年08月13号星期四）上网的最新法文消息之一。摩洛哥内政部宣布已经逮捕了一批煽动民众的肇事者。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260813-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E6%91%A9%E6%B4%9B%E5%93%A5%E5%AE%A3%E5%B8%83%E5%8A%A0%E5%BC%BA%E5%AE%89%E4%BF%9D%E9%98%B2%E9%9D%9E%E6%B3%95%E8%B6%8A%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786618821000.webp","sourceId":"rfi"},{"id":1786617762000,"createdDate":"2026-08-13 10:42","name":"法国国际广播电台","title":"郭德纲演出即兴改编红歌未报备 武汉市文旅局立案调查","content":"综合消息显示，8月12日，有网友爆料称，郭德纲今年7月在武汉演出中即兴改编红歌《弹起我心爱的土琵琶》，因改编内容未经报备涉嫌违规，武汉市文旅局已于8月11日正式立案调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260813-%E9%83%AD%E5%BE%B7%E7%BA%B2%E6%BC%94%E5%87%BA%E5%8D%B3%E5%85%B4%E6%94%B9%E7%BC%96%E7%BA%A2%E6%AD%8C%E6%9C%AA%E6%8A%A5%E5%A4%87-%E6%AD%A6%E6%B1%89%E5%B8%82%E6%96%87%E6%97%85%E5%B1%80%E7%AB%8B%E6%A1%88%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786617762000.webp","sourceId":"rfi"},{"id":1786614905000,"createdDate":"2026-08-13 09:55","name":"法国国际广播电台","title":"日本政府加快研究设立对外情报机构 目标在2027财年末前设立","content":"据共同社报导，为加强海外情报活动，日本政府正在加快对设立对外情报机构的探讨。政府计划在2027财年末前完成该机构的设立，并将于今年秋季前成立专家会议。目前正加紧梳理法律和运作两方面的课题，并推进制度设计。日本的财年为每年的4月1日至次年的3月31日。不过，要使该机构具备与欧美各国情报机构同等的水准——后者据称在收集情报时会运用提供资金、使用假护照等广泛手段——门槛颇高，能否获得国民的理解尚不明朗。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260813-%E6%97%A5%E6%9C%AC%E6%94%BF%E5%BA%9C%E5%8A%A0%E5%BF%AB%E7%A0%94%E7%A9%B6%E8%AE%BE%E7%AB%8B%E5%AF%B9%E5%A4%96%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84-%E7%9B%AE%E6%A0%87%E5%9C%A82027%E8%B4%A2%E5%B9%B4%E6%9C%AB%E5%89%8D%E8%AE%BE%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786614905000.webp","sourceId":"rfi"},{"id":1786659417000,"createdDate":"2026-08-13 22:16","name":"法国国际广播电台","title":"美国法院裁定：进入美国境内的小额包裹可被征收关税","content":"美国一家法院周四（8月13日）裁定，进入美国境内的小额包裹可以被征收关税。这一裁决对美国总统特朗普而言是一场胜利，此前他曾签署行政令，要求取消针对这类包裹的关税豁免。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E7%BE%8E%E5%9B%BD%E6%B3%95%E9%99%A2%E8%A3%81%E5%AE%9A-%E8%BF%9B%E5%85%A5%E7%BE%8E%E5%9B%BD%E5%A2%83%E5%86%85%E7%9A%84%E5%B0%8F%E9%A2%9D%E5%8C%85%E8%A3%B9%E5%8F%AF%E8%A2%AB%E5%BE%81%E6%94%B6%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786659417000.webp","sourceId":"rfi"},{"id":1786657753000,"createdDate":"2026-08-13 21:49","name":"法国国际广播电台","title":"处处留名，特朗普欲再将姓名刻上肯尼迪中心，挑战法院禁令","content":"围绕肯尼迪中心的争议周四（8月13日）进一步升级。由美国总统特朗普的亲信掌控的肯尼迪中心董事会周四投票决定，恢复特朗普的名字在建筑外墙上的标识。此前，法院曾下令将其撤除。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E5%A4%84%E5%A4%84%E7%95%99%E5%90%8D%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E6%AC%B2%E5%86%8D%E5%B0%86%E5%A7%93%E5%90%8D%E5%88%BB%E4%B8%8A%E8%82%AF%E5%B0%BC%E8%BF%AA%E4%B8%AD%E5%BF%83%EF%BC%8C%E6%8C%91%E6%88%98%E6%B3%95%E9%99%A2%E7%A6%81%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786657753000.webp","sourceId":"rfi"},{"id":1786653358000,"createdDate":"2026-08-13 20:35","name":"法国国际广播电台","title":"《当智者与哲学家执政》专栏之五：毛泽东与马列主义“科学”","content":"“日食之魅“：今天法国《世界报》头版图片是一幅黑色剪影背景下日食的照片。报道8月12日傍晚欧洲多地人们争相观看日全食的盛况，人们在惊叹、感动中共同见证这一极为罕见的天文奇观，日食也成为人们暂时放下日常生活、共同体验奇妙时刻的公共盛会。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260813-%E5%BD%93%E5%9C%A3%E8%B4%A4%E4%B8%8E%E5%93%B2%E5%AD%A6%E5%AE%B6%E6%89%A7%E6%94%BF-%E4%B8%93%E6%A0%8F%E4%B9%8B%E4%BA%94-%E6%AF%9B%E6%B3%BD%E4%B8%9C%E4%B8%8E%E9%A9%AC%E5%88%97%E4%B8%BB%E4%B9%89-%E7%A7%91%E5%AD%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786653358000.webp","sourceId":"rfi"},{"id":1786652672000,"createdDate":"2026-08-13 20:24","name":"法国国际广播电台","title":"为逼迫普京谈判 乌克兰无人机继续袭击俄罗斯关键石油设施","content":"乌克兰军事官员周四（8月13日）表示，乌克兰无人机深入俄罗斯境内，袭击一座大型炼油厂。这是三天内发生的第四起袭击。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260813-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%AF%B9%E4%BF%84%E7%BD%97%E6%96%AF%E5%85%B3%E9%94%AE%E7%9F%B3%E6%B2%B9%E9%83%A8%E9%97%A8%E9%95%BF%E8%BE%BE%E6%95%B0%E6%9C%88%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786652672000.webp","sourceId":"rfi"},{"id":1786648473000,"createdDate":"2026-08-13 19:14","name":"法国国际广播电台","title":"俄“影子船队”油轮阿曼近海搁浅漏油：英国公司启动封堵打捞，野生动物受威胁","content":"卫星图像显示，在近期恶劣天气影响下，油轮“卡罗琳·别任吉号”（CarolineBezengi）泄漏的原油已迅速扩散至数百平方公里，对一处海洋保护区构成威胁。一家英国公司周四(8月13日)表示，已受聘负责打捞一艘在阿曼近海搁浅的俄罗斯“影子船队”油轮，并处理和遏制不断扩大的原油泄漏。随着泄漏的原油抵达阿曼海岸线，当地野生动物正受到威胁。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260813-%E4%BF%84-%E5%BD%B1%E5%AD%90%E8%88%B9%E9%98%9F-%E6%B2%B9%E8%BD%AE%E9%98%BF%E6%9B%BC%E8%BF%91%E6%B5%B7%E6%90%81%E6%B5%85%E6%BC%8F%E6%B2%B9-%E8%8B%B1%E5%9B%BD%E5%85%AC%E5%8F%B8%E5%90%AF%E5%8A%A8%E5%B0%81%E5%A0%B5%E6%89%93%E6%8D%9E%EF%BC%8C%E9%87%8E%E7%94%9F%E5%8A%A8%E7%89%A9%E5%8F%97%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786648473000.webp","sourceId":"rfi"},{"id":1786648384000,"createdDate":"2026-08-13 19:13","name":"法国国际广播电台","title":"英格兰一列火车脱轨，两人重伤","content":"周四（8月13日），一列从伦敦驶出、载有大量乘客的通勤列车在英格兰东南部刘易斯（Lewes）附近发生脱轨事故，造成2人重伤、另外9人受轻伤。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260813-%E8%8B%B1%E6%A0%BC%E5%85%B0%E4%B8%80%E5%88%97%E7%81%AB%E8%BD%A6%E8%84%B1%E8%BD%A8%EF%BC%8C%E4%B8%A4%E4%BA%BA%E9%87%8D%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786648384000.webp","sourceId":"rfi"},{"id":1786647716000,"createdDate":"2026-08-13 19:01","name":"法国国际广播电台","title":"日本强烈抗议普京首访争议群岛后，俄指责高市“竟然傲慢地试图向莫斯科发号施令”","content":"俄罗斯周四（8月13日）驳斥了日本在俄罗斯总统普京访问千岛群岛后提出的“毫无根据”的批评，并指责东京存在“历史修正主义”行为。据悉，千岛群岛是俄日两国数十年来领土争端的核心。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE%E6%99%AE%E4%BA%AC%E9%A6%96%E8%AE%BF%E4%BA%89%E8%AE%AE%E7%BE%A4%E5%B2%9B%E5%90%8E%EF%BC%8C%E4%BF%84%E6%8C%87%E8%B4%A3%E9%AB%98%E5%B8%82-%E7%AB%9F%E7%84%B6%E5%82%B2%E6%85%A2%E5%9C%B0%E8%AF%95%E5%9B%BE%E5%90%91%E8%8E%AB%E6%96%AF%E7%A7%91%E5%8F%91%E5%8F%B7%E6%96%BD%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786647716000.webp","sourceId":"rfi"},{"id":1786646126000,"createdDate":"2026-08-13 18:35","name":"法国国际广播电台","title":"“特朗普媒体与科技集团”（TMTG）的付费服务遭起诉","content":"众所周知，特朗普总统重返白宫后的第一年便获得了惊人的财富增长。而就在周三（8月12日），特朗普及其旗下的“特朗普媒体与科技集团”（TMTG）的付费服务又因涉嫌取财不当而遭到起诉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260813-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AA%92%E4%BD%93%E4%B8%8E%E7%A7%91%E6%8A%80%E9%9B%86%E5%9B%A2-tmtg-%E7%9A%84%E4%BB%98%E8%B4%B9%E6%9C%8D%E5%8A%A1%E9%81%AD%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786646126000.webp","sourceId":"rfi"},{"id":1786645060000,"createdDate":"2026-08-13 18:17","name":"法国国际广播电台","title":"特朗普政府起诉哈佛大学案遭法官驳回","content":"美国一名联邦法官周四（8月13日）驳回了特朗普政府对哈佛大学提起的诉讼。特朗普政府曾指控哈佛大学在2023年10月7日之后校园内举行的亲巴勒斯坦示威活动中，纵容了反犹太主义行为。波士顿联邦法官理查德·斯特恩斯（RichardStearns）认为，美国政府未能证明哈佛大学违反了《民权法》中的相关条款。该条款禁止基于种族、国籍等因素实施歧视。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260813-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E8%B5%B7%E8%AF%89%E5%93%88%E4%BD%9B%E5%A4%A7%E5%AD%A6%E6%A1%88%E9%81%AD%E6%B3%95%E5%AE%98%E9%A9%B3%E5%9B%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786645060000.webp","sourceId":"rfi"},{"id":1786642880000,"createdDate":"2026-08-13 17:41","name":"法国国际广播电台","title":"欧洲再迎热浪：周四多地气温预计超过35℃，超1.35亿人受波及","content":"作为全球升温速度最快的大陆，欧洲8月再次遭遇热浪。据法新社测算，周四（8月13日）欧洲部分地区的气温预计将在一天中的某个时段超过35℃，受影响人口超过1.35亿，主要集中在法国、意大利、西班牙和英国。总体来看，当天欧洲近五分之三的人口（不包括土耳其）所在地区，最高气温预计将超过30℃，约3.4亿人受波及。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260813-%E6%AC%A7%E6%B4%B2%E5%86%8D%E8%BF%8E%E7%83%AD%E6%B5%AA-%E5%91%A8%E5%9B%9B%E5%A4%9A%E5%9C%B0%E6%B0%94%E6%B8%A9%E9%A2%84%E8%AE%A1%E8%B6%85%E8%BF%8735%E2%84%83%EF%BC%8C%E8%B6%851-35%E4%BA%BF%E4%BA%BA%E5%8F%97%E6%B3%A2%E5%8F%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/13/1786642880000.webp","sourceId":"rfi"}]