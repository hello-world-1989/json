[{"id":1786590258000,"createdDate":"2026-08-13 03:04","name":"英国广播公司","title":"想提高做決定的能力？問問螞蟻吧","content":"從很會下決策的螞蟻到有自我意識的果蠅，我們可以從這些令人毛骨悚然的小蟲子身上學到很多關於如何做出更好決定的知識。","newsLink":"https://www.bbc.com/zhongwen/articles/c39e20rkmnyo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786590258000.webp","sourceId":"bbc"},{"id":1786589896000,"createdDate":"2026-08-13 02:58","name":"英国广播公司","title":"為了安全旅行，女性付出了什麼代價？","content":"女性專用房間需求旺盛，而且有時價格更高。這反映出人們為了獲得安全感需要付出怎樣的代價？","newsLink":"https://www.bbc.com/zhongwen/articles/ckgep55q2ldo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786589896000.webp","sourceId":"bbc"},{"id":1786584877000,"createdDate":"2026-08-13 01:34","name":"英国广播公司","title":"AI代理新案例：黑進健身中心系統替「主人」預約課堂","content":"此事件被視為人工智慧工具為完成任務而不擇手段的最新例證。","newsLink":"https://www.bbc.com/zhongwen/articles/cddjp613mvdo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786584877000.webp","sourceId":"bbc"},{"id":1786579427000,"createdDate":"2026-08-13 00:03","name":"英国广播公司","title":"「大學指控我用AI寫論文，但明明都是我自己寫的」","content":"英國大學這位醫學生必須向學術小組答辯他的研究成果。","newsLink":"https://www.bbc.com/zhongwen/articles/cg5lp79nd00o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786579427000.webp","sourceId":"bbc"},{"id":1786612775000,"createdDate":"2026-08-13 09:19","name":"英国广播公司","title":"台灣「城鎮韌性」演練 模擬戰時「斷網」","content":"台灣8月13日舉行一年一度的「城鎮韌性」演練，並在北部七個縣市同步進行「行動網路降速」演習。BBC中文直播台北市及新北市的演習實況。","newsLink":"https://www.bbc.com/zhongwen/articles/cp87prg297po/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786612775000.webp","sourceId":"bbc"},{"id":1786591142000,"createdDate":"2026-08-13 03:19","name":"英国广播公司","title":"近30年最壯觀日食登場 數百萬英歐民眾抬頭見證","content":"在英格蘭康沃爾郡，超過95%的太陽被月球遮蔽；而西班牙部分地區的民眾則有幸見證日全食帶來的震撼景象。","newsLink":"https://www.bbc.com/zhongwen/articles/cgq5pgl1ln3o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786591142000.webp","sourceId":"bbc"},{"id":1786590804000,"createdDate":"2026-08-13 03:13","name":"英国广播公司","title":"台灣首度模擬戰時「斷網」，30分鐘演練了什麼？","content":"台灣今年的「城鎮韌性」演習，首度模擬戰時的「斷網」情境，測試海底通訊電纜等關鍵通訊設施受損後的應變能力。對於距離台灣本島約200公里的馬祖居民來說，類似情境曾真實發生，當時「斷網」長達50天。","newsLink":"https://www.bbc.com/zhongwen/articles/cm2gpjnyl98o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786590804000.webp","sourceId":"bbc"},{"id":1786624338000,"createdDate":"2026-08-13 12:32","name":"英国广播公司","title":"「白海豚」中國暴雨持續：為何颱風災情愈來愈深入內陸地區？","content":"今年目前為止吹襲中國的最強颱風「白海豚」，於8月9日登陸後持續帶來災情，至本週仍為中國東部、中北部帶來廣泛暴雨和水災，影響範圍甚至波及內陸地區。","newsLink":"https://www.bbc.com/zhongwen/articles/cg4dp9g9v1ko/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786624338000.webp","sourceId":"bbc"},{"id":1786615082000,"createdDate":"2026-08-13 09:58","name":"英国广播公司","title":"朱鎔基逝世：台灣記住「搞台獨沒好下場」 香港感念金融風暴「挺港功臣」","content":"朱鎔基辭世，台灣聚焦2000年「搞台獨沒好下場」反助陳水扁勝選；港澳感念其金融風暴挺港與市場開放貢獻。","newsLink":"https://www.bbc.com/zhongwen/articles/cm2gpjxyxzgo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/13/1786615082000.webp","sourceId":"bbc"}]