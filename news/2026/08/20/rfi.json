[{"id":1787213607000,"createdDate":"2026-08-20 08:13","name":"法国国际广播电台","title":"恒大创始人许家印被判终身监禁","content":"中国深圳法院周四判处房地产巨头恒大集团创始人无期徒刑，并对这家象征着房地产危机的企业集团处以相当于超过20亿欧元的罚款，该危机仍在持续拖累中国经济。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260820-%E6%81%92%E5%A4%A7%E5%88%9B%E5%A7%8B%E4%BA%BA%E8%AE%B8%E5%AE%B6%E5%8D%B0%E8%A2%AB%E5%88%A4%E7%BB%88%E8%BA%AB%E7%9B%91%E7%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787213607000.webp","sourceId":"rfi"},{"id":1787212191000,"createdDate":"2026-08-20 07:49","name":"法国国际广播电台","title":"长和就港口争议展开国际仲裁 向巴拿马索偿逾15亿美元","content":"长和出售中港以外全球港口业务而触发地缘政治压力丶最终由巴拿马政府撤销长和子公司在当地两个港口的经营权及接管码硕告一段落後，长和已启动国际仲裁程序，要求巴拿马就其违反投资保护条约行为破坏长和投资，赔偿超过15亿美元。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260820-%E9%95%BF%E5%92%8C%E5%B0%B1%E6%B8%AF%E5%8F%A3%E4%BA%89%E8%AE%AE%E5%B1%95%E5%BC%80%E5%9B%BD%E9%99%85%E4%BB%B2%E8%A3%81-%E5%90%91%E5%B7%B4%E6%8B%BF%E9%A9%AC%E7%B4%A2%E5%81%BF%E9%80%BE15%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787212191000.webp","sourceId":"rfi"},{"id":1787243995000,"createdDate":"2026-08-20 16:39","name":"法国国际广播电台","title":"哈里王子和梅根将重返英国生活","content":"英媒报导，卸下“在职王室成员”身分6年后，哈利王子与他的妻子梅根将在数周内返回英国，他们的两个孩子已注册英国学校，将于9月初的新学年入学。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E5%93%88%E9%87%8C%E7%8E%8B%E5%AD%90%E5%92%8C%E6%A2%85%E6%A0%B9%E5%B0%86%E9%87%8D%E8%BF%94%E8%8B%B1%E5%9B%BD%E7%94%9F%E6%B4%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787243995000.webp","sourceId":"rfi"},{"id":1787242251000,"createdDate":"2026-08-20 16:10","name":"法国国际广播电台","title":"上海限制地下偶像演唱日语歌 被指或揣度中央意图","content":"共同社8月20日电：在日本御宅文化扎根的中国上海市，限制地下偶像现场演唱日语歌的动向正在扩大。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260820-%E4%B8%8A%E6%B5%B7%E9%99%90%E5%88%B6%E5%9C%B0%E4%B8%8B%E5%81%B6%E5%83%8F%E6%BC%94%E5%94%B1%E6%97%A5%E8%AF%AD%E6%AD%8C-%E8%A2%AB%E6%8C%87%E6%88%96%E6%8F%A3%E5%BA%A6%E4%B8%AD%E5%A4%AE%E6%84%8F%E5%9B%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787242251000.webp","sourceId":"rfi"},{"id":1787240268000,"createdDate":"2026-08-20 15:37","name":"法国国际广播电台","title":"韩国测试北极航线 首艘集装箱船即将起航","content":"韩国海洋部周四宣布，一艘韩国船将于周六启程前往欧洲，途经北极海域，旨在测试一条替代航线，以绕开受中东冲突影响的航线。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E9%9F%A9%E5%9B%BD%E6%B5%8B%E8%AF%95%E5%8C%97%E6%9E%81%E8%88%AA%E7%BA%BF-%E9%A6%96%E8%89%98%E9%9B%86%E8%A3%85%E7%AE%B1%E8%88%B9%E5%8D%B3%E5%B0%86%E8%B5%B7%E8%88%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787240268000.webp","sourceId":"rfi"},{"id":1787237666000,"createdDate":"2026-08-20 14:54","name":"法国国际广播电台","title":"《费加罗报》：人口断崖式减少？中国借力机器人来实现中国梦","content":"20日出版的法国全国性大报头版头条主题各异。左翼倾向的《解放报》凸出面对2027年的法国总统大选，左翼阵营内部不同政党日益凸出的合作困境。右翼倾向的《费加罗报》放在头版头条的主题是吸食毒品快克古柯碱现象在法国境内的扩散的迹象。天主教报刊《十字架报》则针对法国日益频繁的酷暑干旱天气，思考沼泽等湿地对农业生产延续的重要性。财经报刊《回声报》则将中国产汽车在法国境内不断扩展市场作为头版头条，并为此发表社评文章。除《回声报》外，其它日报也有很多关于中国的报道。中国举办的世界机器人大会19日在北京开幕之际，《费加罗报》在暑期副刊发表长篇文章，介绍中国以开发人形机器人来应对人口增长快速放缓趋势的策略。该报也注意到中国在高科技领域的发展态势对香港股市的提振效应。该报也特别刊登文章介绍欧美试图摆脱中国对稀土产业的垄断的努力。《十字架报》的暑期连载则聚焦科幻文学正成为中国软实力的一个新热点。《解放报》的一篇文章则介绍乌克兰军队如何在中国拒绝转让技术的背景下，得以复制一款中国无人机并以此用于战场。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260820-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E5%80%9F%E5%8A%A9%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E6%9D%A5%E5%AE%9E%E7%8E%B0%E6%B0%91%E6%97%8F%E5%A4%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787237666000.webp","sourceId":"rfi"},{"id":1787234890000,"createdDate":"2026-08-20 14:08","name":"法国国际广播电台","title":"俄军夜袭基辅16人遇难 泽连斯基谴责莫斯科升级冲突","content":"乌克兰当局周四表示，俄罗斯又一夜的轰炸导致基辅及其周边地区至少16人死亡，总统沃洛迪米尔·泽连斯基指责莫斯科“投资”弹道导弹以推动局势升级。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E4%BF%84%E5%86%9B%E5%A4%9C%E8%A2%AD%E5%9F%BA%E8%BE%8516%E4%BA%BA%E9%81%87%E9%9A%BE-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%B0%B4%E8%B4%A3%E8%8E%AB%E6%96%AF%E7%A7%91%E5%8D%87%E7%BA%A7%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787234890000.webp","sourceId":"rfi"},{"id":1787231846000,"createdDate":"2026-08-20 13:17","name":"法国国际广播电台","title":"从亚洲首富到终身监禁  恒大许家印“传奇”落幕","content":"周四，中国深圳中级人民法院宣布判处全球负债最多的房地产开发商中国恒大集团的创始人许家印无期徒刑。这标志着恒大破产历程中的一个里程碑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260820-%E4%BB%8E%E4%BA%9A%E6%B4%B2%E9%A6%96%E5%AF%8C%E5%88%B0%E7%BB%88%E8%BA%AB%E7%9B%91%E7%A6%81-%E6%81%92%E5%A4%A7%E8%AE%B8%E5%AE%B6%E5%8D%B0-%E4%BC%A0%E5%A5%87-%E8%90%BD%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787231846000.webp","sourceId":"rfi"},{"id":1787230224000,"createdDate":"2026-08-20 12:50","name":"法国国际广播电台","title":"一名中国公民承认将2万澳元藏茶叶里行贿澳洲公职人员获缓刑1年即将被驱逐","content":"当事人朱先生向澳洲法庭表示抱歉，并称，“在我的国家，人们经常赠送此类礼物”。他被羁押26天后，获缓刑12个月，即将被驱逐出境。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E4%B8%80%E5%90%8D%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E6%89%BF%E8%AE%A4%E5%B0%862%E4%B8%87%E6%BE%B3%E5%85%83%E8%97%8F%E8%8C%B6%E5%8F%B6%E9%87%8C%E8%A1%8C%E8%B4%BF%E6%BE%B3%E6%B4%B2%E5%85%AC%E8%81%8C%E4%BA%BA%E5%91%98%E8%8E%B7%E7%BC%93%E5%88%911%E5%B9%B4%E5%8D%B3%E5%B0%86%E8%A2%AB%E9%A9%B1%E9%80%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787230224000.webp","sourceId":"rfi"},{"id":1787229913000,"createdDate":"2026-08-20 12:45","name":"法国国际广播电台","title":"俄乌冲突升级  普京转向东望","content":"中东地缘战火引发史上最严重能源供应危机之际，俄罗斯与乌克兰的冲突非但没有平息，反而呈现出错综复杂的升级态势。随着缅甸领导人频繁出访俄罗斯，亚太学者认为莫斯科正以缅甸为支点，开始践行“转向东方”战略政策，进一步扩大其在东南亚地区的影响力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260820-%E4%BF%84%E4%B9%8C%E5%86%B2%E7%AA%81%E5%8D%87%E7%BA%A7-%E6%99%AE%E4%BA%AC%E8%BD%AC%E5%90%91%E4%B8%9C%E6%9C%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787229913000.webp","sourceId":"rfi"},{"id":1787227043000,"createdDate":"2026-08-20 11:57","name":"法国国际广播电台","title":"特朗普宣布今年将与金正恩会面后 朝鲜发射了10来枚短程导弹","content":"韩国军方周四宣布，朝鲜发射了约10枚弹道导弹。此前数小时，唐纳德·特朗普曾表示，他将于今年与朝鲜领导人金正恩会面。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E4%BB%8A%E5%B9%B4%E5%B0%86%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E4%BC%9A%E9%9D%A2%E5%90%8E-%E6%9C%9D%E9%B2%9C%E5%8F%91%E5%B0%84%E4%BA%8610%E6%9D%A5%E6%9E%9A%E7%9F%AD%E7%A8%8B%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787227043000.webp","sourceId":"rfi"},{"id":1787226686000,"createdDate":"2026-08-20 11:51","name":"法国国际广播电台","title":"中国汽车进军法国：快速扩大经销网络的商业策略","content":"回声报（LesÉchos）今天刊登了一篇文章，讨论中国汽车品牌于法国快速增设经销据点的策略。题为“顺势而为，方为上策：中国品牌以闪电般的速度拓展汽车经销店”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260820-%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E8%BF%9B%E5%86%9B%E6%B3%95%E5%9B%BD-%E5%BF%AB%E9%80%9F%E6%89%A9%E5%A4%A7%E7%BB%8F%E9%94%80%E7%BD%91%E7%BB%9C%E7%9A%84%E5%95%86%E4%B8%9A%E7%AD%96%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787226686000.webp","sourceId":"rfi"},{"id":1787225796000,"createdDate":"2026-08-20 11:36","name":"法国国际广播电台","title":"针对美国制裁日籍国际刑事法院院长等 日本方面表示遗憾和抗议","content":"8月18日，美国特朗普政府针对国际刑事法院（ICC）院长赤根智子采取制裁措施，日本本国出身的人士竟成为唯一盟友美国制裁的对象，对此，日本政府表示“非常遗憾”。日本议员团体表示谴责和抗议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E9%92%88%E5%AF%B9%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E6%97%A5%E7%B1%8D%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E9%99%A2%E9%95%BF%E7%AD%89-%E6%97%A5%E6%9C%AC%E6%96%B9%E9%9D%A2%E8%A1%A8%E7%A4%BA%E9%81%97%E6%86%BE%E5%92%8C%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787225796000.webp","sourceId":"rfi"},{"id":1787219700000,"createdDate":"2026-08-20 09:55","name":"法国国际广播电台","title":"特朗普警告 任何支持伊朗的国家都将面临经济后果","content":"美国总统特朗普警告称，任何向伊朗提供“任何形式的生命线”的国家都将面临经济后果。伊朗外长回应谴责“美国的经济恐怖主义威胁着全球经济和世界各国的国家主权。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260820-%E7%89%B9%E6%9C%97%E6%99%AE%E8%AD%A6%E5%91%8A-%E4%BB%BB%E4%BD%95%E6%94%AF%E6%8C%81%E4%BC%8A%E6%9C%97%E7%9A%84%E5%9B%BD%E5%AE%B6%E9%83%BD%E5%B0%86%E9%9D%A2%E4%B8%B4%E7%BB%8F%E6%B5%8E%E5%90%8E%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787219700000.webp","sourceId":"rfi"},{"id":1787217780000,"createdDate":"2026-08-20 09:23","name":"法国国际广播电台","title":"台湾2027年度国防预算首破1兆新台币　占GDP逾3%","content":"台湾行政院星期四（8月20日）通过2027年度中央政府总预算案，其中整体国防预算首度突破1兆新台币，达到1兆1225亿元，按行政院最新预估的2027年GDP计算，占比约3.01%，是历来首次超过GDP的3%。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260820-%E5%8F%B0%E6%B9%BE2027%E5%B9%B4%E5%BA%A6%E5%9B%BD%E9%98%B2%E9%A2%84%E7%AE%97%E9%A6%96%E7%A0%B41%E5%85%86%E6%96%B0%E5%8F%B0%E5%B8%81-%E5%8D%A0gdp%E9%80%BE3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/20/1787217780000.webp","sourceId":"rfi"}]