[{"id":1786437554000,"createdDate":"2026-08-11 08:39","name":"法国国际广播电台","title":"台湾人口再创新低  7月新生儿不到8000人 每一个婴儿出生就有两人离世","content":"台湾人口数连续31个月负成长，7月新生儿仅7906人。台湾人口出生数持续探底，同时高龄人口又不断增加，台湾的人口结构正迎来一场转变。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%8F%B0%E6%B9%BE%E4%BA%BA%E5%8F%A3%E5%86%8D%E5%88%9B%E6%96%B0%E4%BD%8E-7%E6%9C%88%E6%96%B0%E7%94%9F%E5%84%BF%E4%B8%8D%E5%88%B08000%E4%BA%BA-%E6%AF%8F%E4%B8%80%E4%B8%AA%E5%A9%B4%E5%84%BF%E5%87%BA%E7%94%9F%E5%B0%B1%E6%9C%89%E4%B8%A4%E4%BA%BA%E7%A6%BB%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786437554000.webp","sourceId":"rfi"},{"id":1786436402000,"createdDate":"2026-08-11 08:20","name":"法国国际广播电台","title":"美联邦通信委员会出人意料地成为特朗普对华鹰派行动的先锋","content":"路透社报道称，美联邦通信委员会（FederalCommunicationsCommission，FCC）过去以频谱拍卖和电视台牌照发放而闻名，如今却出人意料地成为特朗普政府对华采取部分最具攻击性行动的先锋。据悉，过去九个月里，在特朗普盟友布伦丹·卡尔（BrendanCarr）的领导下，FCC委员会采取了一系列行动，旨在打击美国眼中的美国供应链风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E7%BE%8E%E8%81%94%E9%82%A6%E9%80%9A%E4%BF%A1%E5%A7%94%E5%91%98%E4%BC%9A%E5%87%BA%E4%BA%BA%E6%84%8F%E6%96%99%E5%9C%B0%E6%88%90%E4%B8%BA%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E5%8D%8E%E9%B9%B0%E6%B4%BE%E8%A1%8C%E5%8A%A8%E7%9A%84%E5%85%88%E9%94%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786436402000.webp","sourceId":"rfi"},{"id":1786436244000,"createdDate":"2026-08-11 08:17","name":"法国国际广播电台","title":"台湾中配徐春莺涉受中方指示介选判刑7年 法院称危害台湾主权","content":"中央社8月11日电：中国籍配偶徐春莺涉受中方指示，在台北市长与总统选举时替黄珊珊、柯文哲站台造势，依反渗透法等罪判刑7年。法院表示，徐春莺依境外敌对势力指示介选，严重破坏台湾宪政危害主权。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260811-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%80%BB%E7%90%86%E5%88%86%E5%88%AB%E8%A7%81%E5%8D%B0%E5%BA%A6%E5%92%8C%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786436244000.webp","sourceId":"rfi"},{"id":1786435577000,"createdDate":"2026-08-11 08:06","name":"法国国际广播电台","title":"日本强烈谴责胡塞武装近期连续发动一系列袭击行动","content":"也门胡塞武装8月9日称，该组织使用无人机对位于沙特阿拉伯吉赞的沙特阿美公司炼油厂等发动了“精准打击”。对于胡塞武装的一系列袭击行动，日本外务省新闻发言人11日发表谈话，强烈谴责胡塞武装近期连续发动的一系列袭击行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%BF%91%E6%9C%9F%E8%BF%9E%E7%BB%AD%E5%8F%91%E5%8A%A8%E4%B8%80%E7%B3%BB%E5%88%97%E8%A2%AD%E5%87%BB%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786435577000.webp","sourceId":"rfi"},{"id":1786435079000,"createdDate":"2026-08-11 07:57","name":"法国国际广播电台","title":"吴霭仪事件：大律师指涉刑事案不代表专业失当　民阵前召集人批公会为表忠「追杀」","content":"大律师公会执委会不服大律师纪律审裁组裁定吴霭仪大律师的专业失当投诉不成立而罕有地提出司法覆核，引发关注。有大律师表示，公会的做法罕见，因大律师涉及刑事案件不等于构成专业失当；在相关集会举行时出任民阵召集人的岑子杰则批评，大律师公会此举是为政治表忠，「追杀」已经退休的吴霭仪。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%90%B4%E9%9C%AD%E4%BB%AA%E4%BA%8B%E4%BB%B6-%E5%A4%A7%E5%BE%8B%E5%B8%88%E6%8C%87%E6%B6%89%E5%88%91%E4%BA%8B%E6%A1%88%E4%B8%8D%E4%BB%A3%E8%A1%A8%E4%B8%93%E4%B8%9A%E5%A4%B1%E5%BD%93-%E6%B0%91%E9%98%B5%E5%89%8D%E5%8F%AC%E9%9B%86%E4%BA%BA%E6%89%B9%E5%85%AC%E4%BC%9A%E4%B8%BA%E8%A1%A8%E5%BF%A0-%E8%BF%BD%E6%9D%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786435079000.webp","sourceId":"rfi"},{"id":1786434681000,"createdDate":"2026-08-11 07:51","name":"法国国际广播电台","title":"前议员吴霭仪专业失当投诉裁定不成立 大律师公会不服罕有提覆核","content":"前立法会法律界议员吴霭仪在2019年8月18日反修例运动期间，被判组织和参与未经批准集结罪成，判监9个月丶缓刑两年。大律师纪律审裁组其后以多数票裁定她专业失当的投诉不成立。但提出投诉的大律师公会执委会不服裁决结果，指吴霭仪作为大律师，在政治动荡时期作出公然漠视法律的行为，是向公众发放错误讯息，罕有地就已裁定不成立的投诉提出司法覆核，并要求法庭宣布其专业失当投诉成立。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%89%8D%E8%AE%AE%E5%91%98%E5%90%B4%E9%9C%AD%E4%BB%AA%E4%B8%93%E4%B8%9A%E5%A4%B1%E5%BD%93%E6%8A%95%E8%AF%89%E8%A3%81%E5%AE%9A%E4%B8%8D%E6%88%90%E7%AB%8B-%E5%A4%A7%E5%BE%8B%E5%B8%88%E5%85%AC%E4%BC%9A%E4%B8%8D%E6%9C%8D%E7%BD%95%E6%9C%89%E6%8F%90%E8%A6%86%E6%A0%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786434681000.webp","sourceId":"rfi"},{"id":1786467603000,"createdDate":"2026-08-11 17:00","name":"法国国际广播电台","title":"从窃听战斗机到泄密……两名中国军方出身的中国人在韩国被捕","content":"韩联社8月11日报道：在群山通过接收器窃听通信，在平泽拉拢美军基地职员窃取训练资料，韩国警方正集中调查两名中国公民涉嫌向中国当局泄露信息及幕后主使。他们因在韩国军队和驻韩美军的军事设施周边从事利敌活动已被警方逮捕。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E4%BB%8E%E7%AA%83%E5%90%AC%E6%88%98%E6%96%97%E6%9C%BA%E5%88%B0%E6%B3%84%E5%AF%86-%E4%B8%A4%E5%90%8D%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E5%87%BA%E8%BA%AB%E7%9A%84%E4%B8%AD%E5%9B%BD%E4%BA%BA%E5%9C%A8%E9%9F%A9%E5%9B%BD%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786467603000.webp","sourceId":"rfi"},{"id":1786462198000,"createdDate":"2026-08-11 15:29","name":"法国国际广播电台","title":"澳大利亚与越南深化全面战略伙伴关系 加强关键矿产半导体清洁能源合作","content":"澳大利亚与越南周二同意深化两国的全面战略伙伴关系，签署了涵盖国防、农业和边境安全等领域的合作协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E4%B8%8E%E8%B6%8A%E5%8D%97%E6%B7%B1%E5%8C%96%E5%85%A8%E9%9D%A2%E6%88%98%E7%95%A5%E4%BC%99%E4%BC%B4%E5%85%B3%E7%B3%BB-%E5%8A%A0%E5%BC%BA%E5%85%B3%E9%94%AE%E7%9F%BF%E4%BA%A7%E5%8D%8A%E5%AF%BC%E4%BD%93%E6%B8%85%E6%B4%81%E8%83%BD%E6%BA%90%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786462198000.webp","sourceId":"rfi"},{"id":1786461275000,"createdDate":"2026-08-11 15:14","name":"法国国际广播电台","title":"北京对台湾参加太平洋岛国论坛表示抗议","content":"周二，中国呼吁太平洋岛国论坛秘书长“避免损害双方关系健康、稳定的发展”，此前该秘书长已确认台湾将参加该地区即将举行的领导人峰会。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E5%8C%97%E4%BA%AC%E5%AF%B9%E5%8F%B0%E6%B9%BE%E5%8F%82%E5%8A%A0%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E8%A1%A8%E7%A4%BA%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786461275000.webp","sourceId":"rfi"},{"id":1786460559000,"createdDate":"2026-08-11 15:02","name":"法国国际广播电台","title":"中国海上出口新利器——“极地丝绸之路”开通","content":"周二（8月11号）法国各大报头版关注焦点罕见趋同：除左翼《解放报》关注法国政治外，《费加罗报》、《十字架报》和《回声报》十字的头版都关注气候变化带来的各种后果。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260811-%E4%B8%AD%E5%9B%BD%E6%B5%B7%E4%B8%8A%E5%87%BA%E5%8F%A3%E6%96%B0%E5%88%A9%E5%99%A8-%E6%9E%81%E5%9C%B0%E4%B8%9D%E7%BB%B8%E4%B9%8B%E8%B7%AF-%E5%BC%80%E9%80%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786460559000.webp","sourceId":"rfi"},{"id":1786457604000,"createdDate":"2026-08-11 14:13","name":"法国国际广播电台","title":"日媒: 多名日本公民在中国被拘留 其中有人为配合中国当局问询被诓入境遭拘留","content":"据毎日新聞8月11日引述多名相关人士10日透露，数名在中国境内设有分支机构的日本企业社长等日本公民，因涉及含稀土元素的军民两用产品等对日出口管制问题，被中方扣留。针对日资企业的突击检查及对企业相关人员的问询也频频发生。在被扣留的日本公民中，有人竟是为配合中国当局的问询入境后遭到扣留的。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E6%97%A5%E5%AA%92-%E5%A4%9A%E5%90%8D%E6%97%A5%E6%9C%AC%E5%85%AC%E6%B0%91%E5%9C%A8%E4%B8%AD%E5%9B%BD%E8%A2%AB%E6%8B%98%E7%95%99-%E5%85%B6%E4%B8%AD%E6%9C%89%E4%BA%BA%E4%B8%BA%E9%85%8D%E5%90%88%E4%B8%AD%E5%9B%BD%E5%BD%93%E5%B1%80%E9%97%AE%E8%AF%A2%E8%A2%AB%E8%AF%93%E5%85%A5%E5%A2%83%E9%81%AD%E6%8B%98%E7%95%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786457604000.webp","sourceId":"rfi"},{"id":1786452351000,"createdDate":"2026-08-11 12:45","name":"法国国际广播电台","title":"泽连斯基：莫斯科昨夜致命轰炸用了朝鲜弹道导弹","content":"乌克兰总统泽连斯基周二指出：莫斯科在对乌克兰南部城市扎波罗热的夜间袭击中使用了朝鲜弹道导弹，袭击造成至少6人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E8%8E%AB%E6%96%AF%E7%A7%91%E6%98%A8%E5%A4%9C%E8%87%B4%E5%91%BD%E8%BD%B0%E7%82%B8%E7%94%A8%E4%BA%86%E6%9C%9D%E9%B2%9C%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786452351000.webp","sourceId":"rfi"},{"id":1786442433000,"createdDate":"2026-08-11 10:00","name":"法国国际广播电台","title":"“内鬼”小生意 今成习近平反腐清洗的大隐患","content":"自2012年习近平上台以来，中国开展了前所未有的反腐运动。据官方数据，超过700万人因受贿、泄露机密等罪行受到惩处，2025年更是创下了98.3万人的年度处分记录。这场运动的核心武器之一，便是高度保密的调查机制。然而，正是这种保密性，意外催生了一个灰色地带：一些官员和内部人士发现，出售即将被调查的官员名单，甚至在微信、抖音等社交平台上暗示相关信息，竟能带来可观的利益。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260811-%E5%86%85%E9%AC%BC-%E5%B0%8F%E7%94%9F%E6%84%8F-%E4%BB%8A%E6%88%90%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%8F%8D%E8%85%90%E6%B8%85%E6%B4%97%E7%9A%84%E5%A4%A7%E9%9A%90%E6%82%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786442433000.webp","sourceId":"rfi"},{"id":1786487533000,"createdDate":"2026-08-11 22:32","name":"法国国际广播电台","title":"习近平为何以顶级规格纪念江泽民百年诞辰","content":"北京超高规格纪念江泽民百年诞辰活动周二拉开序幕，中国中央电视台11日至16日陆续播出12集纪录片『江泽民』。根据香港明报报道，17日将举行“顶级规格”的“江泽民同志诞辰100周年纪念大会”。届时，中共总书记习近平将发表讲话。除此之外，中共宣传部等多部门将联合举办江泽民思想研讨会，预料还将发行纪念邮票。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%BA%E4%BD%95%E4%BB%A5%E9%A1%B6%E7%BA%A7%E8%A7%84%E6%A0%BC%E7%BA%AA%E5%BF%B5%E6%B1%9F%E6%B3%BD%E6%B0%91%E7%99%BE%E5%B9%B4%E8%AF%9E%E8%BE%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786487533000.webp","sourceId":"rfi"},{"id":1786483471000,"createdDate":"2026-08-11 21:24","name":"法国国际广播电台","title":"西方收紧签证、就业遇冷 中国留学生归国率升至九成","content":"由于西方国家加强签证审查，以及中国留学生毕业后的就业门槛提高，中国留学生归国人数占同年出国留学人数的94%，归国率创历史新高。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E8%A5%BF%E6%96%B9%E6%94%B6%E7%B4%A7%E7%AD%BE%E8%AF%81-%E5%B0%B1%E4%B8%9A%E9%81%87%E5%86%B7-%E4%B8%AD%E5%9B%BD%E7%95%99%E5%AD%A6%E7%94%9F%E5%BD%92%E5%9B%BD%E7%8E%87%E5%8D%87%E8%87%B3%E4%B9%9D%E6%88%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786483471000.webp","sourceId":"rfi"},{"id":1786483280000,"createdDate":"2026-08-11 21:21","name":"法国国际广播电台","title":"黎巴嫩废除死刑  中东地区唯一","content":"黎巴嫩国会周二历史性通过废止死刑的议案，由此成为中东地区首个废除极刑的国家。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260811-%E9%BB%8E%E5%B7%B4%E5%AB%A9%E5%BA%9F%E9%99%A4%E6%AD%BB%E5%88%91-%E4%B8%AD%E4%B8%9C%E5%9C%B0%E5%8C%BA%E5%94%AF%E4%B8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786483280000.webp","sourceId":"rfi"},{"id":1786483255000,"createdDate":"2026-08-11 21:20","name":"法国国际广播电台","title":"休达移民危机：Meta和TikTok同意加强打击虚假信息","content":"欧盟周二(8月11日）宣布，Meta和TikTok已同意加强打击与西班牙休达移民危机有关的虚假信息。欧盟同时表示，不排除今后对这些科技巨头施加更多约束。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E4%BC%91%E8%BE%BE%E7%A7%BB%E6%B0%91%E5%8D%B1%E6%9C%BA-meta%E5%92%8Ctiktok%E5%90%8C%E6%84%8F%E5%8A%A0%E5%BC%BA%E6%89%93%E5%87%BB%E8%99%9A%E5%81%87%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786483255000.webp","sourceId":"rfi"},{"id":1786483046000,"createdDate":"2026-08-11 21:17","name":"法国国际广播电台","title":"叙利亚前总统巴沙尔·阿萨德被缺席判处死刑","content":"叙利亚一家法院周二(8月11日）以战争期间所犯罪行为，缺席判处被推翻的前总统巴沙尔·阿萨德、其弟马希尔·阿萨德及多名前政权高官死刑。这是叙利亚前政权成员首次被定罪。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E5%8F%99%E5%88%A9%E4%BA%9A%E5%89%8D%E6%80%BB%E7%BB%9F%E5%B7%B4%E6%B2%99%E5%B0%94%C2%B7%E9%98%BF%E8%90%A8%E5%BE%B7%E8%A2%AB%E7%BC%BA%E5%B8%AD%E5%88%A4%E5%A4%84%E6%AD%BB%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786483046000.webp","sourceId":"rfi"},{"id":1786482741000,"createdDate":"2026-08-11 21:12","name":"法国国际广播电台","title":"特朗普称与普京交涉成功 俄释放被关押的美国前海军陆战队员","content":"美国总统特朗普周二(8月11日）表示，在他与俄罗斯总统普京进行交涉后，俄方出于“人道主义”考虑，释放了已被关押四年多、健康状况不断恶化的美国前海军陆战队员罗伯特·吉尔曼（RobertGilman）。美国官员强调，美方没有为此作出任何让步。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%8E%E6%99%AE%E4%BA%AC%E4%BA%A4%E6%B6%89%E6%88%90%E5%8A%9F-%E4%BF%84%E9%87%8A%E6%94%BE%E8%A2%AB%E5%85%B3%E6%8A%BC%E7%BE%8E%E5%9B%BD%E5%89%8D%E6%B5%B7%E5%86%9B%E9%99%86%E6%88%98%E9%98%9F%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786482741000.webp","sourceId":"rfi"},{"id":1786482681000,"createdDate":"2026-08-11 21:11","name":"法国国际广播电台","title":"德国多条河流降至历史低位 抑制德国经济","content":"据德国广播电台报道：持续高温和降雨不足使莱茵河、多瑙河等多条河流水位降至历史低位，内河航运在货物运输方面因此受到严重影响。一些联邦州暂时放宽了周日卡车禁行规定。但德国运输与物流联合会（DSLV）表示，水路运输能力的损失几乎无法通过卡车运输来弥补。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260811-%E5%BE%B7%E5%9B%BD%E5%A4%9A%E6%9D%A1%E6%B2%B3%E6%B5%81%E9%99%8D%E8%87%B3%E5%8E%86%E5%8F%B2%E4%BD%8E%E4%BD%8D-%E6%8A%91%E5%88%B6%E5%BE%B7%E5%9B%BD%E7%BB%8F%E6%B5%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786482681000.webp","sourceId":"rfi"},{"id":1786482514000,"createdDate":"2026-08-11 21:08","name":"法国国际广播电台","title":"日全食将至 欧洲各地掀起观测眼镜抢购潮","content":"欧洲多地周三（8月12日）将迎来一场罕见的日全食。西班牙北部部分地区可以观测到日全食；在法国，虽然太阳不会被完全遮住，但周三傍晚仍可看到日偏食。随着这场日月交会的天文奇观临近，法国等欧洲多国掀起日食观测眼镜抢购潮，不少药店和销售点已经断货。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E6%97%A5%E5%85%A8%E9%A3%9F%E5%B0%86%E8%87%B3-%E6%AC%A7%E6%B4%B2%E5%90%84%E5%9C%B0%E6%8E%80%E8%B5%B7%E8%A7%82%E6%B5%8B%E7%9C%BC%E9%95%9C%E6%8A%A2%E8%B4%AD%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786482514000.webp","sourceId":"rfi"},{"id":1786482201000,"createdDate":"2026-08-11 21:03","name":"法国国际广播电台","title":"中国公民认罪企图走私美军通讯设备 最高囚20年","content":"美国司法部表示，29岁中国公民陈定伟（DingweiChen，音译）10日在联邦法院认罪，承认违反美国“武器出口管制法”（ArmsExportControlAct），企图取得美国制造的军用卫星调制解调器及无线电等敏感通讯设备，再秘密运往中国。法院已排定10月19日量刑，陈定伟最高面临20年监禁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E8%AE%A4%E7%BD%AA%E4%BC%81%E5%9B%BE%E8%B5%B0%E7%A7%81%E7%BE%8E%E5%86%9B%E9%80%9A%E8%AE%AF%E8%AE%BE%E5%A4%87-%E6%9C%80%E9%AB%98%E5%9B%9A20%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786482201000.webp","sourceId":"rfi"},{"id":1786472668000,"createdDate":"2026-08-11 18:24","name":"法国国际广播电台","title":"法国青年误陷“泰国计划”毒品运送陷阱","content":"据法新社报道，法国警方星期二证实，自今年夏初以来，已有11名法国年轻人在泰国被拘留，他们在机场被查获行李中藏有数公斤大麻。警方证实了法国媒体RTL最早披露的这一消息。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260811-%E6%B3%95%E5%9B%BD%E9%9D%92%E5%B9%B4%E8%AF%AF%E9%99%B7-%E6%B3%B0%E5%9B%BD%E8%AE%A1%E5%88%92-%E6%AF%92%E5%93%81%E8%BF%90%E9%80%81%E9%99%B7%E9%98%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786472668000.webp","sourceId":"rfi"}]