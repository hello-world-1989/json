[{"id":1786437554000,"createdDate":"2026-08-11 08:39","name":"法国国际广播电台","title":"台湾人口再创新低  7月新生儿不到8000人 每一个婴儿出生就有两人离世","content":"台湾人口数连续31个月负成长，7月新生儿仅7906人。台湾人口出生数持续探底，同时高龄人口又不断增加，台湾的人口结构正迎来一场转变。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%8F%B0%E6%B9%BE%E4%BA%BA%E5%8F%A3%E5%86%8D%E5%88%9B%E6%96%B0%E4%BD%8E-7%E6%9C%88%E6%96%B0%E7%94%9F%E5%84%BF%E4%B8%8D%E5%88%B08000%E4%BA%BA-%E6%AF%8F%E4%B8%80%E4%B8%AA%E5%A9%B4%E5%84%BF%E5%87%BA%E7%94%9F%E5%B0%B1%E6%9C%89%E4%B8%A4%E4%BA%BA%E7%A6%BB%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786437554000.webp","sourceId":"rfi"},{"id":1786436402000,"createdDate":"2026-08-11 08:20","name":"法国国际广播电台","title":"美联邦通信委员会出人意料地成为特朗普对华鹰派行动的先锋","content":"路透社报道称，美联邦通信委员会（FederalCommunicationsCommission，FCC）过去以频谱拍卖和电视台牌照发放而闻名，如今却出人意料地成为特朗普政府对华采取部分最具攻击性行动的先锋。据悉，过去九个月里，在特朗普盟友布伦丹·卡尔（BrendanCarr）的领导下，FCC委员会采取了一系列行动，旨在打击美国眼中的美国供应链风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260811-%E7%BE%8E%E8%81%94%E9%82%A6%E9%80%9A%E4%BF%A1%E5%A7%94%E5%91%98%E4%BC%9A%E5%87%BA%E4%BA%BA%E6%84%8F%E6%96%99%E5%9C%B0%E6%88%90%E4%B8%BA%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E5%8D%8E%E9%B9%B0%E6%B4%BE%E8%A1%8C%E5%8A%A8%E7%9A%84%E5%85%88%E9%94%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786436402000.webp","sourceId":"rfi"},{"id":1786436244000,"createdDate":"2026-08-11 08:17","name":"法国国际广播电台","title":"台湾中配徐春莺涉受中方指示介选判刑7年 法院称危害台湾主权","content":"中央社8月11日电：中国籍配偶徐春莺涉受中方指示，在台北市长与总统选举时替黄珊珊、柯文哲站台造势，依反渗透法等罪判刑7年。法院表示，徐春莺依境外敌对势力指示介选，严重破坏台湾宪政危害主权。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260811-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%80%BB%E7%90%86%E5%88%86%E5%88%AB%E8%A7%81%E5%8D%B0%E5%BA%A6%E5%92%8C%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786436244000.webp","sourceId":"rfi"},{"id":1786435577000,"createdDate":"2026-08-11 08:06","name":"法国国际广播电台","title":"日本强烈谴责胡塞武装近期连续发动一系列袭击行动","content":"也门胡塞武装8月9日称，该组织使用无人机对位于沙特阿拉伯吉赞的沙特阿美公司炼油厂等发动了“精准打击”。对于胡塞武装的一系列袭击行动，日本外务省新闻发言人11日发表谈话，强烈谴责胡塞武装近期连续发动的一系列袭击行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260811-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%BF%91%E6%9C%9F%E8%BF%9E%E7%BB%AD%E5%8F%91%E5%8A%A8%E4%B8%80%E7%B3%BB%E5%88%97%E8%A2%AD%E5%87%BB%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786435577000.webp","sourceId":"rfi"},{"id":1786435079000,"createdDate":"2026-08-11 07:57","name":"法国国际广播电台","title":"吴霭仪事件：大律师指涉刑事案不代表专业失当　民阵前召集人批公会为表忠「追杀」","content":"大律师公会执委会不服大律师纪律审裁组裁定吴霭仪大律师的专业失当投诉不成立而罕有地提出司法覆核，引发关注。有大律师表示，公会的做法罕见，因大律师涉及刑事案件不等于构成专业失当；在相关集会举行时出任民阵召集人的岑子杰则批评，大律师公会此举是为政治表忠，「追杀」已经退休的吴霭仪。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%90%B4%E9%9C%AD%E4%BB%AA%E4%BA%8B%E4%BB%B6-%E5%A4%A7%E5%BE%8B%E5%B8%88%E6%8C%87%E6%B6%89%E5%88%91%E4%BA%8B%E6%A1%88%E4%B8%8D%E4%BB%A3%E8%A1%A8%E4%B8%93%E4%B8%9A%E5%A4%B1%E5%BD%93-%E6%B0%91%E9%98%B5%E5%89%8D%E5%8F%AC%E9%9B%86%E4%BA%BA%E6%89%B9%E5%85%AC%E4%BC%9A%E4%B8%BA%E8%A1%A8%E5%BF%A0-%E8%BF%BD%E6%9D%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786435079000.webp","sourceId":"rfi"},{"id":1786434681000,"createdDate":"2026-08-11 07:51","name":"法国国际广播电台","title":"前议员吴霭仪专业失当投诉裁定不成立 大律师公会不服罕有提覆核","content":"前立法会法律界议员吴霭仪在2019年8月18日反修例运动期间，被判组织和参与未经批准集结罪成，判监9个月丶缓刑两年。大律师纪律审裁组其后以多数票裁定她专业失当的投诉不成立。但提出投诉的大律师公会执委会不服裁决结果，指吴霭仪作为大律师，在政治动荡时期作出公然漠视法律的行为，是向公众发放错误讯息，罕有地就已裁定不成立的投诉提出司法覆核，并要求法庭宣布其专业失当投诉成立。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260811-%E5%89%8D%E8%AE%AE%E5%91%98%E5%90%B4%E9%9C%AD%E4%BB%AA%E4%B8%93%E4%B8%9A%E5%A4%B1%E5%BD%93%E6%8A%95%E8%AF%89%E8%A3%81%E5%AE%9A%E4%B8%8D%E6%88%90%E7%AB%8B-%E5%A4%A7%E5%BE%8B%E5%B8%88%E5%85%AC%E4%BC%9A%E4%B8%8D%E6%9C%8D%E7%BD%95%E6%9C%89%E6%8F%90%E8%A6%86%E6%A0%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/11/1786434681000.webp","sourceId":"rfi"}]