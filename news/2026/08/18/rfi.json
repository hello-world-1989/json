[{"id":1787043216000,"createdDate":"2026-08-18 08:53","name":"法国国际广播电台","title":"就任后首访莫斯科 缅甸总统敏昂莱会见其“保护人”普京","content":"缅甸总统敏昂莱周二（8月18日）将在莫斯科会见俄罗斯总统普京。这是他自今年4月就职总统以来首次访问俄罗斯，也是他的第五次出访，此前敏昂莱已先后访问了印度、中国、老挝和泰国。为寻求国际合法性，这位缅甸前军事强人正努力巩固与为数不多友好国家的盟友关系，其中俄罗斯和中国一样，是缅甸军政权最重要的支持者。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E5%B0%B1%E4%BB%BB%E5%90%8E%E9%A6%96%E8%AE%BF%E8%8E%AB%E6%96%AF%E7%A7%91-%E7%BC%85%E7%94%B8%E6%80%BB%E7%BB%9F%E6%95%8F%E6%98%82%E8%8E%B1%E4%BC%9A%E8%A7%81%E5%85%B6-%E4%BF%9D%E6%8A%A4%E4%BA%BA-%E6%99%AE%E4%BA%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787043216000.webp","sourceId":"rfi"},{"id":1787042192000,"createdDate":"2026-08-18 08:36","name":"法国国际广播电台","title":"韩国光州双年展台湾馆被移除国名 台湾文化部：采一切必要手段捍卫权益","content":"韩国光州双年展擅自将「台湾馆TaiwanPavilion」更名为「NTMOFA」。台湾艺术家联名抗议表示，以民主与人权为基础背景的光州双年展，应有责任说明为何参展者受到政治性的限制。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260818-%E9%9F%A9%E5%9B%BD%E5%85%89%E5%B7%9E%E5%8F%8C%E5%B9%B4%E5%B1%95%E5%8F%B0%E6%B9%BE%E9%A6%86%E8%A2%AB%E7%A7%BB%E9%99%A4%E5%9B%BD%E5%90%8D-%E5%8F%B0%E6%B9%BE%E6%96%87%E5%8C%96%E9%83%A8-%E9%87%87%E4%B8%80%E5%88%87%E5%BF%85%E8%A6%81%E6%89%8B%E6%AE%B5%E6%8D%8D%E5%8D%AB%E6%9D%83%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787042192000.webp","sourceId":"rfi"},{"id":1787037389000,"createdDate":"2026-08-18 07:16","name":"法国国际广播电台","title":"民调：港人对港府及其官员以致中央相关机构评价偏低","content":"一项综合海内外港人进行的网上民意调查显示，受访者对香港主要官员丶立法及行政机关丶特区政府，以及多个中央驻港机构的评价普遍偏低；以10分为满分，多名主要官员的评分均低於1分，特首李家超的评分更只有0.3分。对香港前途及一国两制的信心亦普遍不足，其中表示对一国两制「冇信心」的比例更高达98%。负责民调的学者锺剑华承认，民调由「有强烈意见者」作答，只具参考作用；敦促港府进行公正民调，探查民意，否则一个不着重民意的政府，只会在缺乏公信力的情况下，无法施政。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260818-%E6%B0%91%E8%B0%83-%E6%B8%AF%E4%BA%BA%E5%AF%B9%E6%B8%AF%E5%BA%9C%E5%8F%8A%E5%85%B6%E5%AE%98%E5%91%98%E4%BB%A5%E8%87%B4%E4%B8%AD%E5%A4%AE%E7%9B%B8%E5%85%B3%E6%9C%BA%E6%9E%84%E8%AF%84%E4%BB%B7%E5%81%8F%E4%BD%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787037389000.webp","sourceId":"rfi"},{"id":1787069844000,"createdDate":"2026-08-18 16:17","name":"法国国际广播电台","title":"沙特恢复从霍尔木兹海峡内装载和销售石油","content":"沙特阿拉伯的阿美石油公司上周恢复了从霍尔木兹海峡装载石油。随着沙特这家国有能源巨头提供重质原油现货，还有更多油轮等待装载。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E6%B2%99%E7%89%B9%E6%81%A2%E5%A4%8D%E4%BB%8E%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E5%86%85%E8%A3%85%E8%BD%BD%E5%92%8C%E9%94%80%E5%94%AE%E7%9F%B3%E6%B2%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787069844000.webp","sourceId":"rfi"},{"id":1787067754000,"createdDate":"2026-08-18 15:42","name":"法国国际广播电台","title":"诺基亚撤离中国：年底前裁减大部分员工 分阶段关闭各地工厂","content":"据南华早报8月18日消息，芬兰电信设备巨头诺基亚计划在年底前裁减其在中国的大部分员工，并分阶段关闭各地工厂。这标志着该公司在中国市场深耕四十多年后，因市场份额不断被本土竞争对手蚕食而进行的大规模撤退。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E8%AF%BA%E5%9F%BA%E4%BA%9A%E6%92%A4%E7%A6%BB%E4%B8%AD%E5%9B%BD-%E5%B9%B4%E5%BA%95%E5%89%8D%E8%A3%81%E5%87%8F%E5%A4%A7%E9%83%A8%E5%88%86%E5%91%98%E5%B7%A5-%E5%88%86%E9%98%B6%E6%AE%B5%E5%85%B3%E9%97%AD%E5%90%84%E5%9C%B0%E5%B7%A5%E5%8E%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787067754000.webp","sourceId":"rfi"},{"id":1787066252000,"createdDate":"2026-08-18 15:17","name":"法国国际广播电台","title":"欧洲尝过了美国靠不住的苦涩，现在轮到韩国了","content":"各位好，8月19日出刊的法国世界报头版关注点如下：法国税务局官网遭黑客大规模袭击，近70万名纳税人敏感信息泄露，法国政府在信息与公共服务的数字化方面的脆弱性引发关注、专家分析以色列即将迎来议会选举、为了迎合金正恩，特朗普削减美韩军演规模、利比亚军队最高指挥官、宣布参加下届利比亚总统选举的哈弗塔尔将军正在被家族紧张关系削弱、乌克兰无人机飞手正在越来越密集地将战争带回莫斯科、与乌克兰无人机飞手度过的一个夜晚、法国政府选举对火灾严重灾区吉伦特和兰德地区发放高额援助款、热浪和干旱让法国意识到自己同样脆弱、法国国家委员会以“性暴力”为由关闭了一家承认俱乐部、法国学生即将迎来开学季，校园和学习用品暂时没有受到通胀的冲击等。本期法国世界报的社论关注的是本次法国税务局信息被黑客攻击并贩卖，当中指出，这一事件被在野党称为法国历史上类似事件里“最为严重”的一次。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260818-%E6%AC%A7%E6%B4%B2%E5%B0%9D%E8%BF%87%E4%BA%86%E7%BE%8E%E5%9B%BD%E9%9D%A0%E4%B8%8D%E4%BD%8F%E7%9A%84%E8%8B%A6%E6%B6%A9%EF%BC%8C%E7%8E%B0%E5%9C%A8%E8%BD%AE%E5%88%B0%E9%9F%A9%E5%9B%BD%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787066252000.webp","sourceId":"rfi"},{"id":1787065989000,"createdDate":"2026-08-18 15:13","name":"法国国际广播电台","title":"日俄领土争端：莫斯科召见日本大使，抗议日方“反俄言论”，不排除对日反制","content":"俄罗斯外交部8月18日星期二召见了日本驻俄罗斯大使，就日方谴责俄罗斯总统普京访问择捉岛（俄称伊图鲁普岛）一事表达不满。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E6%97%A5%E4%BF%84%E9%A2%86%E5%9C%9F%E4%BA%89%E7%AB%AF-%E8%8E%AB%E6%96%AF%E7%A7%91%E5%8F%AC%E8%A7%81%E6%97%A5%E6%9C%AC%E5%A4%A7%E4%BD%BF%EF%BC%8C%E6%8A%97%E8%AE%AE%E6%97%A5%E6%96%B9-%E5%8F%8D%E4%BF%84%E8%A8%80%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787065989000.webp","sourceId":"rfi"},{"id":1787064916000,"createdDate":"2026-08-18 14:55","name":"法国国际广播电台","title":"美国东亚安全布局再现疑云之际，中国外长五年来首访首尔","content":"两天来，朝鲜半岛突然又成为国际舆论关注的中心。但这一次不是因为朝鲜试射导弹，而是美国总统特朗普在社交媒体平台上的一则推文令东亚地缘政治格局出现一种新的不确定性。而也正是在这种背景下，中国外长王毅将自19日起出访韩国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260818-%E7%BE%8E%E5%9B%BD%E4%B8%9C%E4%BA%9A%E5%AE%89%E5%85%A8%E5%B8%83%E5%B1%80%E5%86%8D%E7%8E%B0%E7%96%91%E4%BA%91%E4%B9%8B%E9%99%85%EF%BC%8C%E4%B8%AD%E5%9B%BD%E5%A4%96%E9%95%BF%E4%BA%94%E5%B9%B4%E6%9D%A5%E9%A6%96%E8%AE%BF%E9%A6%96%E5%B0%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787064916000.webp","sourceId":"rfi"},{"id":1787063589000,"createdDate":"2026-08-18 14:33","name":"法国国际广播电台","title":"俄军袭击乌克兰东北村镇至少10人遇难15人伤","content":"乌克兰地方当局表示，周二，俄罗斯一枚火箭弹袭击了乌克兰哈尔科夫州一个村镇，造成至少10人死亡、约15人受伤。泽连斯基承诺将“予以回击”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E4%BF%84%E5%86%9B%E8%A2%AD%E5%87%BB%E4%B9%8C%E5%85%8B%E5%85%B0%E4%B8%9C%E5%8C%97%E6%9D%91%E9%95%87%E8%87%B3%E5%B0%9110%E4%BA%BA%E9%81%87%E9%9A%BE15%E4%BA%BA%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787063589000.webp","sourceId":"rfi"},{"id":1787062089000,"createdDate":"2026-08-18 14:08","name":"法国国际广播电台","title":"朱镕基出殡：天安门降半旗 习近平三鞠躬 民众追忆逝去的时代","content":"中国前总理朱镕基今天周二在北京出殡，八宝山周边戒备森严，北京下令周二各政府大楼及天安降半旗，以悼念这位在上周去世、享年97岁的前总理。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260818-%E6%9C%B1%E9%95%95%E5%9F%BA%E5%87%BA%E6%AE%A1-%E5%A4%A9%E5%AE%89%E9%97%A8%E9%99%8D%E5%8D%8A%E6%97%97-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%89%E9%9E%A0%E8%BA%AC-%E6%B0%91%E4%BC%97%E8%BF%BD%E5%BF%86%E9%80%9D%E5%8E%BB%E7%9A%84%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787062089000.webp","sourceId":"rfi"},{"id":1787060335000,"createdDate":"2026-08-18 13:38","name":"法国国际广播电台","title":"“法兰西的骄傲”：索菲·阿德诺成为法国首位“漫步太空”的女宇航员","content":"8月18日，法国媒体聚焦宇航员索菲·阿德诺（SophieAdenot），这位自今年二月起就在国际空间站执行任务的法国女宇航员，将与美国宇航员阿尼尔·梅农一起，走出空间站，共同完成一项约6个半小时的舱外任务，而44岁的阿德诺也将成为法国首个完成太空出舱活动的女性宇航员，总统马克龙今天称她是“法兰西的骄傲”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%85%B0%E8%A5%BF%E7%9A%84%E9%AA%84%E5%82%B2-%E7%B4%A2%E8%8F%B2%C2%B7%E9%98%BF%E5%BE%B7%E8%AF%BA%E6%88%90%E4%B8%BA%E6%B3%95%E5%9B%BD%E9%A6%96%E4%BD%8D-%E6%BC%AB%E6%AD%A5%E5%A4%AA%E7%A9%BA-%E7%9A%84%E5%A5%B3%E5%AE%87%E8%88%AA%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787060335000.webp","sourceId":"rfi"},{"id":1787057610000,"createdDate":"2026-08-18 12:53","name":"法国国际广播电台","title":"法国2027年预算吃紧：政府暗示或少涨“高额”退休金","content":"大家好，欢迎收听法国报纸摘要，法国2027年预算吃紧是周二8月18日法国全国性报纸头版的焦点话题之一。就此《费加罗报》质疑，经历了夏季的热浪和野火秋季复工后，重大的政治动荡是否即将到来？因为，几天后法国总理勒科尔努将提交他的2027年预算草案，而摆在总理面前的任务艰巨无比。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260818-%E6%B3%95%E5%9B%BD2027%E5%B9%B4%E9%A2%84%E7%AE%97%E5%90%83%E7%B4%A7-%E6%94%BF%E5%BA%9C%E6%9A%97%E7%A4%BA%E6%88%96%E5%B0%91%E6%B6%A8-%E9%AB%98%E9%A2%9D-%E9%80%80%E4%BC%91%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787057610000.webp","sourceId":"rfi"},{"id":1787054161000,"createdDate":"2026-08-18 11:56","name":"法国国际广播电台","title":"特朗普威胁轰炸阿曼: 如果该国阻碍达成霍尔木兹海峡协议","content":"美国总统特朗普周一威胁称，如果阿曼“阻挡”关于霍尔木兹海峡的协议，将对该国发动空袭。过去数周，阿曼和伊朗一直在不包括美国的情况下，就这一战略海运通道进行磋商。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260818-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A8%81%E8%83%81%E8%BD%B0%E7%82%B8%E9%98%BF%E6%9B%BC-%E5%A6%82%E6%9E%9C%E8%AF%A5%E5%9B%BD%E9%98%BB%E7%A2%8D%E8%BE%BE%E6%88%90%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787054161000.webp","sourceId":"rfi"},{"id":1787048070000,"createdDate":"2026-08-18 10:14","name":"法国国际广播电台","title":"解放报专访：在东南亚，俄罗斯梦想成为大国，但仍旧是个二流角色","content":"缅甸政变领导人、现任总统敏昂莱周二（8月18日）再度与俄罗斯总统普京会面。新加坡尤索夫·伊萨东南亚研究所（ISEAS-YusofIshak）的高级研究员伊恩·斯托里（IanStorey）对《解放报》解读了这一合作：一个为生存而战的政权与一个寻求扩大影响力的俄罗斯之间的靠近。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260818-%E8%A7%A3%E6%94%BE%E6%8A%A5-%E5%9C%A8%E4%B8%9C%E5%8D%97%E4%BA%9A%EF%BC%8C%E4%BF%84%E7%BD%97%E6%96%AF%E6%A2%A6%E6%83%B3%E6%88%90%E4%B8%BA%E5%A4%A7%E5%9B%BD%EF%BC%8C%E4%BD%86%E4%BB%8D%E6%97%A7%E6%98%AF%E4%B8%AA%E4%BA%8C%E6%B5%81%E8%A7%92%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787048070000.webp","sourceId":"rfi"},{"id":1787046926000,"createdDate":"2026-08-18 09:55","name":"法国国际广播电台","title":"德国纪念柏林墙建墙65周年","content":"1961年8月13日，东德开始修建柏林墙，柏林被一分为二。1989年11月9日，柏林墙倒塌。1990年，两德统一。柏林墙留下了什么教训？统一后的德国是否还能看到柏林墙的阴影？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20260818-%E5%BE%B7%E5%9B%BD%E7%BA%AA%E5%BF%B5%E6%9F%8F%E6%9E%97%E5%A2%99%E5%BB%BA%E5%A2%9965%E5%91%A8%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787046926000.webp","sourceId":"rfi"},{"id":1787044977000,"createdDate":"2026-08-18 09:22","name":"法国国际广播电台","title":"针对特朗普命令美韩军演缩小规格 日本防卫相强调日美韩军事合作重要","content":"为出席日澳防长会谈等活动，正在访问澳大利亚的日本防卫大臣小泉进次郎18日在澳大利亚首都堪培拉，在特朗普总统缩小与韩国举行的联合军事演习、太平洋地区对此的忧虑正在扩大的背景下指出：日本与韩国及美国开展合作对地区安全保障而言“极其重要”。他对美韩安全保障合作表示了强烈支持。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260818-%E9%92%88%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E5%91%BD%E4%BB%A4%E7%BE%8E%E9%9F%A9%E5%86%9B%E6%BC%94%E7%BC%A9%E5%B0%8F%E8%A7%84%E6%A0%BC-%E6%97%A5%E6%9C%AC%E9%98%B2%E5%8D%AB%E7%9B%B8%E5%BC%BA%E8%B0%83%E6%97%A5%E7%BE%8E%E9%9F%A9%E5%86%9B%E4%BA%8B%E5%90%88%E4%BD%9C%E9%87%8D%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787044977000.webp","sourceId":"rfi"},{"id":1787044527000,"createdDate":"2026-08-18 09:15","name":"法国国际广播电台","title":"特朗普女婿兼特使库什纳结束中东行程，加沙和平方案进展有限","content":"美国总统特朗普女婿兼特使库什纳17日与以色列总理内塔尼亚胡会谈后结束为期两天的中东行程。从目前媒体披露的消息来看，他此行推动落实加沙和平方案的努力并未取得显著成效。法新社17日发自耶路撒冷的报道引述一名以色列官员称，美以双方考虑由一名美国军队将领监督哈马斯组织解除武装的行动。不过，特朗普任命的和平委员会一名负责人并未向法新社确认美军将领会参与对哈马斯武装的缴械行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260818-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A5%B3%E5%A9%BF%E5%85%BC%E7%89%B9%E4%BD%BF%E5%BA%93%E4%BB%80%E7%BA%B3%E7%BB%93%E6%9D%9F%E4%B8%AD%E4%B8%9C%E8%A1%8C%E7%A8%8B%EF%BC%8C%E5%8A%A0%E6%B2%99%E5%92%8C%E5%B9%B3%E6%96%B9%E6%A1%88%E8%BF%9B%E5%B1%95%E6%9C%89%E9%99%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/18/1787044527000.webp","sourceId":"rfi"}]