[{"id":1786525340000,"createdDate":"2026-08-12 09:02","name":"法国国际广播电台","title":"针对台湾方面抗议长崎非礼 长崎市长反驳","content":"长崎市于9日举行了长崎原子弹爆炸遇难者慰灵暨和平祈念仪式”。由于台湾方面称台湾代表的座位被安排在“外交使团区域以外”，台湾方面认为这损害了台湾作为一个国家的尊严和地位，因此台北驻日经济文化代表处代表李逸洋决定不出席。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260812-%E9%92%88%E5%AF%B9%E5%8F%B0%E6%B9%BE%E6%96%B9%E9%9D%A2%E6%8A%97%E8%AE%AE%E9%95%BF%E5%B4%8E%E9%9D%9E%E7%A4%BC-%E9%95%BF%E5%B4%8E%E5%B8%82%E9%95%BF%E5%8F%8D%E9%A9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786525340000.webp","sourceId":"rfi"},{"id":1786524853000,"createdDate":"2026-08-12 08:54","name":"法国国际广播电台","title":"中国印尼舰艇将在台岛以东海域通航演练 印尼海军称非旨在“作战”，仅是“过航演习”","content":"中国国防部周二通过新闻稿宣布，“8月中旬，中国海军红河舰将与印度尼西亚海军‘莱’号护卫舰位台岛以东海域举行通航演练，重点开展通信操演、海上补给等科目演练，旨在提升两国海军联合行动能力，深化双方务实合作，共同维护地区和平稳定”。台北方面，陆委会当晚表示，“强烈谴责中共军事挑衅举措，严重侵害我国主权及威胁区域安全，呼吁北京当局立即停止此一破坏现状的危险行径”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260812-%E4%B8%AD%E5%9B%BD%E5%8D%B0%E5%B0%BC%E8%88%B0%E8%89%87%E5%B0%86%E5%9C%A8%E5%8F%B0%E5%B2%9B%E4%BB%A5%E4%B8%9C%E6%B5%B7%E5%9F%9F%E9%80%9A%E8%88%AA%E6%BC%94%E7%BB%83-%E5%8D%B0%E5%B0%BC%E6%B5%B7%E5%86%9B%E7%A7%B0%E9%9D%9E%E6%97%A8%E5%9C%A8-%E4%BD%9C%E6%88%98-%EF%BC%8C%E4%BB%85%E6%98%AF-%E8%BF%87%E8%88%AA%E6%BC%94%E4%B9%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786524853000.webp","sourceId":"rfi"},{"id":1786524015000,"createdDate":"2026-08-12 08:40","name":"法国国际广播电台","title":"6天来第二次试射，朝鲜在美韩大型联合军演前再射弹道导弹","content":"韩国和日本官方周三（8月12日）表示，朝鲜当天上午向朝鲜半岛东部海域发射一枚弹道导弹。再过几天，美国与韩国“乙支自由之盾”大型年度联合军演即将登场，朝鲜此前已再次谴责此次军演。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260812-%E6%9C%9D%E9%B2%9C%E5%9C%A8%E7%BE%8E%E9%9F%A9%E5%A4%A7%E5%9E%8B%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94%E5%89%8D%E5%86%8D%E5%8F%91%E5%B0%84%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786524015000.webp","sourceId":"rfi"},{"id":1786518719000,"createdDate":"2026-08-12 07:11","name":"法国国际广播电台","title":"港府在大马设经贸办 续弃守第二大贸易伙伴台湾","content":"港府继新加坡丶印尼和泰国后，再于马来西亚(又称大马)首都吉隆坡增设全球第十五个驻外经济贸易办事处(经贸办)，积极开拓与东盟各国的经贸关系。不过，设有经贸办的三个东盟地区，其贸易额总和却只及台湾一地的56%，但港府暂停香港驻台湾经济贸易文化办事处运作逾五年，至今仍未有重启时间表，惹来港府设立经贸办的准则并非单以促进香港经贸利益，而是受国家发展策略和政治原则影响的质疑。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260812-%E6%B8%AF%E5%BA%9C%E5%9C%A8%E5%A4%A7%E9%A9%AC%E8%AE%BE%E7%BB%8F%E8%B4%B8%E5%8A%9E-%E7%BB%AD%E5%BC%83%E5%AE%88%E7%AC%AC%E4%BA%8C%E5%A4%A7%E8%B4%B8%E6%98%93%E4%BC%99%E4%BC%B4%E5%8F%B0%E6%B9%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786518719000.webp","sourceId":"rfi"},{"id":1786518380000,"createdDate":"2026-08-12 07:06","name":"法国国际广播电台","title":"港持续高温暑热警告未升级 前天文台长揭「某部门」阻公开暑热数据","content":"受极端天气影响，香港持续多日酷热，高温破百年纪录，周日(9日)更有行山人士中暑後死亡，但让户外工作工人停工的法定工作暑热警告，却未有跟随气温上升而升级至停工水平，引发各界质疑。前天文台长林超英直指，现行做法存在技术错误，更不点名批评「某部门」反对天文台公开暑热数据，矛头直指制定暑热警告制度的劳工处，在舆情关注下，劳工处急称将检讨制度。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260812-%E6%B8%AF%E6%8C%81%E7%BB%AD%E9%AB%98%E6%B8%A9%E6%9A%91%E7%83%AD%E8%AD%A6%E5%91%8A%E6%9C%AA%E5%8D%87%E7%BA%A7-%E5%89%8D%E5%A4%A9%E6%96%87%E5%8F%B0%E9%95%BF%E6%8F%AD-%E6%9F%90%E9%83%A8%E9%97%A8-%E9%98%BB%E5%85%AC%E5%BC%80%E6%9A%91%E7%83%AD%E6%95%B0%E6%8D%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786518380000.webp","sourceId":"rfi"},{"id":1786574382000,"createdDate":"2026-08-12 22:39","name":"法国国际广播电台","title":"美国拟投资5000万美元严控AI芯片溯源，防止对华出口管制遭规避，巴拿马成首个试点","content":"美国政府周三（8月12日）公布了一项最高达5000万美元的招标计划，旨在建立认证机制并加快人工智能（AI）产业所需关键零部件和矿产的贸易。据悉，这项全球性项目将首先与巴拿马开展试点，未来可能进一步推广至其他合作伙伴国家。按照设想，这一平台类似于电子元器件的“数字护照”，将对每批经巴拿马运河运输的货物进行原产地和运输路径认证，并为被认定为可靠的货物加快海关通关速度。在美国持续限制相关产品对华出口的背景下，该计划受到广泛关注。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E6%8A%95%E8%B5%845000%E4%B8%87%E7%BE%8E%E5%85%83%E4%B8%A5%E6%8E%A7ai%E8%8A%AF%E7%89%87%E6%BA%AF%E6%BA%90%EF%BC%8C%E9%98%B2%E6%AD%A2%E5%AF%B9%E5%8D%8E%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6%E9%81%AD%E8%A7%84%E9%81%BF%EF%BC%8C%E5%B7%B4%E6%8B%BF%E9%A9%AC%E6%88%90%E9%A6%96%E4%B8%AA%E8%AF%95%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786574382000.webp","sourceId":"rfi"},{"id":1786571117000,"createdDate":"2026-08-12 21:45","name":"法国国际广播电台","title":"韩国寻求半导体外的新机遇：李在明公布未来技术发展战略，计划2030年前登月","content":"目前，韩国政府正寻求在半导体和人工智能之外培育新的经济增长引擎。据悉，韩国周三(8月12日)公布了一项技术发展战略，围绕七大重点项目展开，涵盖核能、量子计算、航天和生物技术等领域。这项名为“七大SEED”的计划由韩国总统李在明主持的会议公布，设定了多个目标，包括到2035年实现韩国自主设计的小型模块化反应堆（SMR）商业化部署、2030年前实现登月、到2029年研发出本国100量子比特量子计算机，以及到2035年实现脑机接口产品商业化。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E9%9F%A9%E5%9B%BD%E5%AF%BB%E6%B1%82%E5%8D%8A%E5%AF%BC%E4%BD%93%E5%A4%96%E7%9A%84%E6%96%B0%E6%9C%BA%E9%81%87-%E6%9D%8E%E5%9C%A8%E6%98%8E%E5%85%AC%E5%B8%83%E6%9C%AA%E6%9D%A5%E6%8A%80%E6%9C%AF%E5%8F%91%E5%B1%95%E6%88%98%E7%95%A5%EF%BC%8C%E8%AE%A1%E5%88%922030%E5%B9%B4%E5%89%8D%E7%99%BB%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786571117000.webp","sourceId":"rfi"},{"id":1786569765000,"createdDate":"2026-08-12 21:22","name":"法国国际广播电台","title":"欧盟等32国联合声明谴责伊朗持续处决抗议者","content":"欧盟等32个国家周三（8月12日）发表联合声明，“以最强烈的措辞”谴责伊朗持续处决抗议者，并敦促伊朗立即停止这一行径。32国包括29个欧盟成员国和澳大利亚、英国、加拿大。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E6%AC%A7%E7%9B%9F%E7%AD%8932%E5%9B%BD%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E%E8%B0%B4%E8%B4%A3%E4%BC%8A%E6%9C%97%E6%8C%81%E7%BB%AD%E5%A4%84%E5%86%B3%E6%8A%97%E8%AE%AE%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786569765000.webp","sourceId":"rfi"},{"id":1786568215000,"createdDate":"2026-08-12 20:56","name":"法国国际广播电台","title":"日本首相强调霍尔木兹海峡航行正常化不被征费","content":"日本首相高市早苗8月12日与伊朗总统电话会谈时强调：应在不被征收通行费等额外费用的情况下实现霍尔木兹海峡航行正常化，她要求伊朗与国际社会进行对话。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260812-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E5%BC%BA%E8%B0%83%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E8%88%AA%E8%A1%8C%E6%AD%A3%E5%B8%B8%E5%8C%96%E4%B8%8D%E8%A2%AB%E5%BE%81%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786568215000.webp","sourceId":"rfi"},{"id":1786564371000,"createdDate":"2026-08-12 19:52","name":"法国国际广播电台","title":"美国捣毁假结婚团伙：11人被捕，其中10人在入籍美国前是中国公民","content":"美国周三（8月12日）宣布，11人因组织数百起假结婚而被捕，假结婚的目的是为了获取美国绿卡。被捕的11人中，有10人为出生于中国、后来入籍美国的美国公民，另1人持有美国绿卡。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E7%BE%8E%E5%9B%BD%E6%8D%A3%E6%AF%81%E5%81%87%E7%BB%93%E5%A9%9A%E5%9B%A2%E4%BC%99-11%E4%BA%BA%E8%A2%AB%E6%8D%95%EF%BC%8C%E5%85%B6%E4%B8%AD10%E4%BA%BA%E5%9C%A8%E5%85%A5%E7%B1%8D%E7%BE%8E%E5%9B%BD%E5%89%8D%E6%98%AF%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786564371000.webp","sourceId":"rfi"},{"id":1786562948000,"createdDate":"2026-08-12 19:29","name":"法国国际广播电台","title":"6月对乌军事援助升至美国停援以来最高，但长期趋势仍放缓","content":"德国基尔世界经济研究所（KielInstitute）周三（8月12日）表示，得益于欧盟发放的一笔新贷款，6月份对乌克兰的军事援助达到美国停止提供资金以来的最高水平，但从长期来看，援助规模仍呈放缓趋势。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-6%E6%9C%88%E5%AF%B9%E4%B9%8C%E5%86%9B%E4%BA%8B%E6%8F%B4%E5%8A%A9%E5%8D%87%E8%87%B3%E7%BE%8E%E5%9B%BD%E5%81%9C%E6%8F%B4%E4%BB%A5%E6%9D%A5%E6%9C%80%E9%AB%98%EF%BC%8C%E4%BD%86%E9%95%BF%E6%9C%9F%E8%B6%8B%E5%8A%BF%E4%BB%8D%E6%94%BE%E7%BC%93","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786562948000.webp","sourceId":"rfi"},{"id":1786562741000,"createdDate":"2026-08-12 19:25","name":"法国国际广播电台","title":"中企违规取得疫情纾困贷款 支付1177万美元和解","content":"美国司法部表示，航空发动机及零组件制造商大陆航空航太技术公司（ContinentalAerospaceTechnologiesInc.）已同意支付1177万2680.14美元，以和解涉嫌违反美国《虚假申报法》（FalseClaimsAct），透过提交不实资料取得原本没有资格申请的薪资保护计划（PaycheckProtectionProgram，PPP）贷款一案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260812-%E4%B8%AD%E4%BC%81%E8%BF%9D%E8%A7%84%E5%8F%96%E5%BE%97%E7%96%AB%E6%83%85%E7%BA%BE%E5%9B%B0%E8%B4%B7%E6%AC%BE-%E6%94%AF%E4%BB%981177%E4%B8%87%E7%BE%8E%E5%85%83%E5%92%8C%E8%A7%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786562741000.webp","sourceId":"rfi"},{"id":1786562457000,"createdDate":"2026-08-12 19:20","name":"法国国际广播电台","title":"俄罗斯经济第二季度同比增长1.3%，超经济学家预期","content":"俄罗斯国家统计局周三（8月12日）公布的数据显示，2026年第二季度俄罗斯经济同比增长1.3%，较第一季度同比萎缩0.2%的表现明显反弹。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E4%BF%84%E7%BD%97%E6%96%AF%E7%BB%8F%E6%B5%8E%E7%AC%AC%E4%BA%8C%E5%AD%A3%E5%BA%A6%E5%90%8C%E6%AF%94%E5%A2%9E%E9%95%BF1-3-%EF%BC%8C%E8%B6%85%E7%BB%8F%E6%B5%8E%E5%AD%A6%E5%AE%B6%E9%A2%84%E6%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786562457000.webp","sourceId":"rfi"},{"id":1786561427000,"createdDate":"2026-08-12 19:03","name":"法国国际广播电台","title":"特朗普确认：为躲避伊朗暗杀，北约峰会后曾秘密更换飞机离开土耳其","content":"美国总统特朗普周二（8月11日）晚间确认，上月在北约峰会结束后，他按照负责总统安保工作的美国特勤局的要求，秘密更换了飞机，离开土耳其。美国媒体此前报道称，在安卡拉举行的北约峰会结束后，特朗普从“空军一号”转移到一架军用飞机上。此次转移是通过一辆餐饮补给车完成的，属于一次罕见的行动，原因是当时出现了来自伊朗方面的暗杀威胁。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A1%AE%E8%AE%A4-%E4%B8%BA%E8%BA%B2%E9%81%BF%E4%BC%8A%E6%9C%97%E6%9A%97%E6%9D%80%EF%BC%8C%E5%8C%97%E7%BA%A6%E5%B3%B0%E4%BC%9A%E5%90%8E%E6%9B%BE%E7%A7%98%E5%AF%86%E6%9B%B4%E6%8D%A2%E9%A3%9E%E6%9C%BA%E7%A6%BB%E5%BC%80%E5%9C%9F%E8%80%B3%E5%85%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786561427000.webp","sourceId":"rfi"},{"id":1786559654000,"createdDate":"2026-08-12 18:34","name":"法国国际广播电台","title":"罕见日全食终于现身：冰岛西班牙部分地区陷入黑暗，法国可见日偏食","content":"备受期待的罕见日食于8日下午晚些时候开始出现，数百万欧洲人翘首以待，据悉，俄罗斯北部、西班牙北部以及冰岛西部部分地区率先陷入日食带来的黑暗之中。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260812-%E7%BD%95%E8%A7%81%E6%97%A5%E5%85%A8%E9%A3%9F%E7%BB%88%E4%BA%8E%E7%8E%B0%E8%BA%AB-%E5%86%B0%E5%B2%9B%E8%A5%BF%E7%8F%AD%E7%89%99%E9%83%A8%E5%88%86%E5%9C%B0%E5%8C%BA%E9%99%B7%E5%85%A5%E9%BB%91%E6%9A%97%EF%BC%8C%E6%B3%95%E5%9B%BD%E5%8F%AF%E8%A7%81%E6%97%A5%E5%81%8F%E9%A3%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786559654000.webp","sourceId":"rfi"},{"id":1786557881000,"createdDate":"2026-08-12 18:04","name":"法国国际广播电台","title":"从卖车到造车，越来越多的中国车企寻求在非洲建厂","content":"美联社12日发布的报道称，中国汽车制造商战略正在改变，越来越多的制造商选择直接在非洲生产汽车，而非简单的出口汽车。他们押注于非洲国家的城市化速度、不断壮大的中产阶级以及政府的支持性政策，希望把非洲打造为全球汽车行业最大市场之一。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E4%BB%8E%E5%8D%96%E8%BD%A6%E5%88%B0%E9%80%A0%E8%BD%A6%EF%BC%8C%E8%B6%8A%E6%9D%A5%E8%B6%8A%E5%A4%9A%E7%9A%84%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E5%AF%BB%E6%B1%82%E5%9C%A8%E9%9D%9E%E6%B4%B2%E5%BB%BA%E5%8E%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786557881000.webp","sourceId":"rfi"},{"id":1786552352000,"createdDate":"2026-08-12 16:32","name":"法国国际广播电台","title":"疑似中国黑客利用AI代理攻击台政府网站 AI工具能自主排序攻击路径","content":"疑似中国黑客利用公开的人工智能（AI）工具入侵了台湾的政府网站，实施了此类首例未经授权的突破，这凸显了人工智能正在如何改变网络战的形态。英国《金融时报》报导指，据率先发现此次入侵的以色列人工智能与国家网络防御公司Dream的研究人员称，这些黑客利用开源人工智能体构建了一种自主黑客工具，其运作方式宛如一个协同工作的网络攻击团队。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260812-%E7%96%91%E4%BC%BC%E4%B8%AD%E5%9B%BD%E9%BB%91%E5%AE%A2%E5%88%A9%E7%94%A8ai%E4%BB%A3%E7%90%86%E6%94%BB%E5%87%BB%E5%8F%B0%E6%94%BF%E5%BA%9C%E7%BD%91%E7%AB%99-ai%E5%B7%A5%E5%85%B7%E8%83%BD%E8%87%AA%E4%B8%BB%E6%8E%92%E5%BA%8F%E6%94%BB%E5%87%BB%E8%B7%AF%E5%BE%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786552352000.webp","sourceId":"rfi"},{"id":1786552123000,"createdDate":"2026-08-12 16:28","name":"法国国际广播电台","title":"乌克兰情报部门称在俄罗斯新型导弹中发现了英伟达人工智能芯片","content":"乌克兰军事情报部门表示，专家在俄罗斯新型S-71单色巡航导弹的组件中发现了英伟达（NvidiaJetsonOrin）计算机模块。该部门还发现俄罗斯武器中含有35个外国电子元件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260812-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%83%85%E6%8A%A5%E9%83%A8%E9%97%A8%E7%A7%B0%E5%9C%A8%E4%BF%84%E7%BD%97%E6%96%AF%E6%96%B0%E5%9E%8B%E5%AF%BC%E5%BC%B9%E4%B8%AD%E5%8F%91%E7%8E%B0%E4%BA%86%E8%8B%B1%E4%BC%9F%E8%BE%BE%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786552123000.webp","sourceId":"rfi"},{"id":1786549524000,"createdDate":"2026-08-12 15:45","name":"法国国际广播电台","title":"中国拟派遣科学家前往伊朗 就稀土元素勘探与加工等领域开展合作交流","content":"据《南华早报》报导，中国正将其与伊朗的科学合作扩展至具有战略敏感性的稀土领域，其中包括北京方面日益寻求防止向海外转移的加工技术。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260812-%E4%B8%AD%E5%9B%BD%E6%8B%9F%E6%B4%BE%E9%81%A3%E7%A7%91%E5%AD%A6%E5%AE%B6%E5%89%8D%E5%BE%80%E4%BC%8A%E6%9C%97-%E5%B0%B1%E7%A8%80%E5%9C%9F%E5%85%83%E7%B4%A0%E5%8B%98%E6%8E%A2%E4%B8%8E%E5%8A%A0%E5%B7%A5%E7%AD%89%E9%A2%86%E5%9F%9F%E5%BC%80%E5%B1%95%E5%90%88%E4%BD%9C%E4%BA%A4%E6%B5%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786549524000.webp","sourceId":"rfi"},{"id":1786546906000,"createdDate":"2026-08-12 15:01","name":"法国国际广播电台","title":"中国今年上半年结婚登记327.5万对 创历史新低","content":"中国民政部网站周三发布《2026年2季度民政统计数据》，其中有关婚姻登记的数据是：今年上半年，全国结婚登记为327.5万对，离婚登记138.3万对。按民政部公布的数据计算，与去年同期相比，结婚登记减少26.4万对，同比下降约7.46%。韩联社报导称，这是自1980年中国婚姻法修订后全国婚姻登记统计数据系统化以来的最低数字。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260812-%E4%B8%AD%E5%9B%BD%E4%BB%8A%E5%B9%B4%E4%B8%8A%E5%8D%8A%E5%B9%B4%E7%BB%93%E5%A9%9A%E7%99%BB%E8%AE%B0327-5%E4%B8%87%E5%AF%B9-%E5%88%9B%E5%8E%86%E5%8F%B2%E6%96%B0%E4%BD%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786546906000.webp","sourceId":"rfi"},{"id":1786545454000,"createdDate":"2026-08-12 14:37","name":"法国国际广播电台","title":"费加罗报：中国AI产业突飞猛进，从芯片到机器人无不颠覆硅谷的既有格局","content":"《费加罗报》科技版周三（8月12日）登出卢卡斯·梅迪亚维拉署名长篇报道称，北京在人工智能产业的各个环节上不断取得成功，已成为美国解决方案的强劲替代者。这标志着一场无法被世界忽视的技术突破。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260812-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BDai%E4%BA%A7%E4%B8%9A%E7%AA%81%E9%A3%9E%E7%8C%9B%E8%BF%9B%EF%BC%8C%E4%BB%8E%E8%8A%AF%E7%89%87%E5%88%B0%E6%9C%BA%E5%99%A8%E4%BA%BA%E6%97%A0%E4%B8%8D%E9%A2%A0%E8%A6%86%E7%A1%85%E8%B0%B7%E7%9A%84%E6%A0%BC%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786545454000.webp","sourceId":"rfi"},{"id":1786544472000,"createdDate":"2026-08-12 14:21","name":"法国国际广播电台","title":"赖清德高雄选前站台谈中共北戴河会议 国民党参选人呼吁停止抹红","content":"民进党“行动中常会”周三移师高雄，身兼党主席的台湾总统赖清德在发表致词时称，中共介选，高雄会承受很大压力，年底高雄市长选举，民进党非胜不可，这场胜利不只关乎高雄未来，也关乎台湾前途。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260812-%E8%B5%96%E6%B8%85%E5%BE%B7%E9%AB%98%E9%9B%84%E9%80%89%E5%89%8D%E7%AB%99%E5%8F%B0%E8%B0%88%E4%B8%AD%E5%85%B1%E5%8C%97%E6%88%B4%E6%B2%B3%E4%BC%9A%E8%AE%AE-%E5%9B%BD%E6%B0%91%E5%85%9A%E5%8F%82%E9%80%89%E4%BA%BA%E5%91%BC%E5%90%81%E5%81%9C%E6%AD%A2%E6%8A%B9%E7%BA%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786544472000.webp","sourceId":"rfi"},{"id":1786532140000,"createdDate":"2026-08-12 10:55","name":"法国国际广播电台","title":"兼具象征与战略意义的平陆运河建成：缩短北京出口东盟通道 也疑危害生态资源","content":"大家好，欢迎收听法国报纸摘要。周三8月12日傍晚，欧洲多地将迎来万众翘首以待的日全食。这一罕见天象在法国西南部会呈现近乎全食的壮观情景，比亚里茨的日面遮蔽度将达99.5%，距离欧洲上一次可观测到的全食已有27年，成为法国各大日报头版头条。与此同时《回声报》关注连接起中国广西地区和北部湾的平陆运河定于9月通航，届时将为北京向东盟国家的出口提供一条更短的路线。东盟国家已经成为中国最大的出口市场，超过了美国和欧盟。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260812-%E5%85%BC%E5%85%B7%E8%B1%A1%E5%BE%81%E4%B8%8E%E6%88%98%E7%95%A5%E6%84%8F%E4%B9%89%E7%9A%84%E5%B9%B3%E9%99%86%E8%BF%90%E6%B2%B3%E5%BB%BA%E6%88%90-%E7%BC%A9%E7%9F%AD%E5%8C%97%E4%BA%AC%E5%87%BA%E5%8F%A3%E4%B8%9C%E7%9B%9F%E9%80%9A%E9%81%93-%E4%B9%9F%E7%96%91%E5%8D%B1%E5%AE%B3%E7%94%9F%E6%80%81%E8%B5%84%E6%BA%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786532140000.webp","sourceId":"rfi"},{"id":1786531329000,"createdDate":"2026-08-12 10:42","name":"法国国际广播电台","title":"朱镕基因病医治无效在京逝世 享年98岁","content":"据官媒新华社周三报导，中国共产党第十四届、十五届中央政治局常委，国务院原总理朱镕基，因病医治无效，于2026年8月12日11时06分在北京逝世，享年98岁。官方讣告称，朱镕基是“中国共产党的优秀党员，久经考验的忠诚的共产主义战士，杰出的无产阶级革命家、政治家，党和国家的卓越领导人”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260812-%E6%9C%B1%E9%95%95%E5%9F%BA%E5%9B%A0%E7%97%85%E5%8C%BB%E6%B2%BB%E6%97%A0%E6%95%88%E5%9C%A8%E4%BA%AC%E9%80%9D%E4%B8%96-%E4%BA%AB%E5%B9%B498%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786531329000.webp","sourceId":"rfi"},{"id":1786530976000,"createdDate":"2026-08-12 10:36","name":"法国国际广播电台","title":"情报部门内部警告间谍活动风险 西班牙国防部仍将批准上汽设厂项目","content":"西班牙国防部发言人周二表示，该部门将批准中国国有汽车制造商上汽集团在位于西班牙西北部的加利西亚自治区建设一座汽车工厂的计划，尽管有报道称该项目靠近一座海军基地，存在潜在的安全风险。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260812-%E6%83%85%E6%8A%A5%E9%83%A8%E9%97%A8%E5%86%85%E9%83%A8%E8%AD%A6%E5%91%8A%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E9%A3%8E%E9%99%A9-%E8%A5%BF%E7%8F%AD%E7%89%99%E5%9B%BD%E9%98%B2%E9%83%A8%E4%BB%8D%E5%B0%86%E6%89%B9%E5%87%86%E4%B8%8A%E6%B1%BD%E8%AE%BE%E5%8E%82%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786530976000.webp","sourceId":"rfi"},{"id":1786530534000,"createdDate":"2026-08-12 10:28","name":"法国国际广播电台","title":"2026汉光演习重要新发展：公开纳入美式军事训练 展现台美关系并未松动？","content":"2026年台湾国防部年度「汉光演习」于8月5日展开，为期十天九夜。今年演习除了安排多项首次的科目，更纳入美式军事训练方式。这代表了台美防务合作正逐步走向公开化与制度化，但台美高调军事合作目的为何，又是否有其风险？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260812-2026%E6%B1%89%E5%85%89%E6%BC%94%E4%B9%A0%E9%87%8D%E8%A6%81%E6%96%B0%E5%8F%91%E5%B1%95-%E5%85%AC%E5%BC%80%E7%BA%B3%E5%85%A5%E7%BE%8E%E5%BC%8F%E5%86%9B%E4%BA%8B%E8%AE%AD%E7%BB%83-%E5%B1%95%E7%8E%B0%E5%8F%B0%E7%BE%8E%E5%85%B3%E7%B3%BB%E5%B9%B6%E6%9C%AA%E6%9D%BE%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786530534000.webp","sourceId":"rfi"},{"id":1786528794000,"createdDate":"2026-08-12 09:59","name":"法国国际广播电台","title":"中印人员再发生对峙？ 印外交部：边境局势将反映出双边关系状况","content":"针对有关中国巡逻队涉嫌进入阿鲁纳恰尔邦（中方称藏南地区）上苏班西里县的报道，印度外交部发出警告称，边境局势状况将影响两国更广泛的双边关系。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260812-%E5%8D%B0%E4%B8%AD%E4%BA%BA%E5%91%98%E5%86%8D%E5%8F%91%E7%94%9F%E5%AF%B9%E5%B3%99-%E5%8D%B0%E5%A4%96%E4%BA%A4%E9%83%A8-%E8%BE%B9%E5%A2%83%E5%B1%80%E5%8A%BF%E5%B0%86%E5%8F%8D%E6%98%A0%E5%87%BA%E5%8F%8C%E8%BE%B9%E5%85%B3%E7%B3%BB%E7%8A%B6%E5%86%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/12/1786528794000.webp","sourceId":"rfi"}]