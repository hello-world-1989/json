[{"id":1786493252000,"createdDate":"2026-08-12 00:07","name":"英国广播公司","title":"「我被朝鮮綁架，還被迫嫁給美國士兵」","content":"曾我瞳十多歲時遭綁架，並被扣押超過20年。她是東京指稱於1970年代和1980年代遭朝鮮綁架的至少17名日本公民之一。","newsLink":"https://www.bbc.com/zhongwen/articles/cj03vgl8dz3o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786493252000.webp","sourceId":"bbc"},{"id":1786493248000,"createdDate":"2026-08-12 00:07","name":"英国广播公司","title":"太陽前所未有的清晰：迄今最詳細的觀測影像曝光","content":"最新影像和影片顯示到了太陽活動形成的「漩渦」，呈現出過去無法觀測到的景象。","newsLink":"https://www.bbc.com/zhongwen/articles/crmr102zj9go/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786493248000.webp","sourceId":"bbc"},{"id":1786527200000,"createdDate":"2026-08-12 09:33","name":"英国广播公司","title":"海濱公寓原本空無一人，然後警察說，詐騙犯搬進來了","content":"馬來西亞的森林城市曾被宣傳為「天堂」，但最近警方因涉嫌詐騙活動對其進行突襲搜查。","newsLink":"https://www.bbc.com/zhongwen/articles/cn8npl73k79o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786527200000.webp","sourceId":"bbc"},{"id":1786523503000,"createdDate":"2026-08-12 08:31","name":"英国广播公司","title":"長崎原爆紀念式不給台灣「使節席」 台日關係「溫差」浮現 ？","content":"長崎與廣島對台灣出席原爆紀念活動的待遇明顯不同。長崎將台灣安排在使節區外，引發抗議與「中國壓力」爭議。","newsLink":"https://www.bbc.com/zhongwen/articles/c330ljemejzo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786523503000.webp","sourceId":"bbc"},{"id":1786510370000,"createdDate":"2026-08-12 04:52","name":"英国广播公司","title":"澤連斯基：俄羅斯使用朝鮮飛彈攻擊烏克蘭","content":"基輔稱，莫斯科使用了來自朝鮮（北韓）的導彈攻擊烏克蘭，造成多人死傷。","newsLink":"https://www.bbc.com/zhongwen/articles/c1w127wxz4xo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786510370000.webp","sourceId":"bbc"},{"id":1786550421000,"createdDate":"2026-08-12 16:00","name":"英国广播公司","title":"BBC核實特朗普撤回部分推薦疫苗的言論","content":"美國總統多次質疑兒童疫苗的安全性，並發表許多誤導性言論。","newsLink":"https://www.bbc.com/zhongwen/articles/cy5d23kzglro/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786550421000.webp","sourceId":"bbc"},{"id":1786548243000,"createdDate":"2026-08-12 15:24","name":"英国广播公司","title":"朱鎔基逝世：推動中國經濟改革的「鐵腕總理」是誰？","content":"中國前總理朱鎔基週三在北京逝世。在1990至2000年代擔任副總理和總理期間，他主導中國經濟改革逾十年，被外界稱為中國「經濟沙皇」。","newsLink":"https://www.bbc.com/zhongwen/articles/cdrvp51pm44o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786548243000.webp","sourceId":"bbc"},{"id":1786547525000,"createdDate":"2026-08-12 15:12","name":"英国广播公司","title":"美國特勤局如何玩弄「障眼法」，將特朗普在眾目睽睽之下隱藏","content":"精心策劃的欺騙行動和誘餌經常被用來欺騙對美國總統構成潛在威脅的人。","newsLink":"https://www.bbc.com/zhongwen/articles/c4g67r45l4vo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786547525000.webp","sourceId":"bbc"},{"id":1786536014000,"createdDate":"2026-08-12 12:00","name":"英国广播公司","title":"朱鎔基逝世，享年97歲——為中國留下改革遺產的「經濟沙皇」","content":"朱鎔基前後12年主導中國經濟發展，改革過程中因為造成大量國企工人下崗而受民間批評。但中國整體上往市場經濟的方向邁了一大步，也由此開啟了歷史上發展速度最高的20年。","newsLink":"https://www.bbc.com/zhongwen/articles/cp839rnw40po/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786536014000.webp","sourceId":"bbc"},{"id":1786530716000,"createdDate":"2026-08-12 10:31","name":"英国广播公司","title":"中國單身漢為何陷「閃婚」騙局？","content":"BBC駐中國記者碧嘉蘭（LauraBicker）走訪「閃婚」婚介市場，了解部分婚介機構如何在短短幾天內安排男女結婚，並採訪多名聲稱因騙婚而蒙受損失的男性，其中有人因此損失畢生積蓄。","newsLink":"https://www.bbc.com/zhongwen/articles/cz7d2e0j5veo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/12/1786530716000.webp","sourceId":"bbc"}]