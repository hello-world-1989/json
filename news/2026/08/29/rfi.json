[{"id":1788010501000,"createdDate":"2026-08-29 13:35","name":"法国国际广播电台","title":"中共前湖北省委书记蒋超良一审被判死缓不得减刑","content":"中共原湖北省委书记蒋超良8月28日被南京中院一审判处死缓。蒋超良被指控从政30多年来，敛财折合人民币超过7.46亿元。该判决规定在死缓转为无期徒刑后，不得减刑或假释。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260829-%E4%B8%AD%E5%85%B1%E5%89%8D%E6%B9%96%E5%8C%97%E7%9C%81%E5%A7%94%E4%B9%A6%E8%AE%B0%E8%92%8B%E8%B6%85%E8%89%AF%E4%B8%80%E5%AE%A1%E8%A2%AB%E5%88%A4%E6%AD%BB%E7%BC%93%E4%B8%8D%E5%BE%97%E5%87%8F%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788010501000.webp","sourceId":"rfi"},{"id":1788010299000,"createdDate":"2026-08-29 13:31","name":"法国国际广播电台","title":"美国如何失去加拿大稳定而平价的原油供应","content":"美国总统特朗普于周五（8月28日）高调宣布，与委内瑞拉达成一项号称历史上最大的石油协议，宣称将透过公私合营掌控委国关键油田高达650亿桶的探明储量。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260829-%E7%BE%8E%E5%9B%BD%E5%A6%82%E4%BD%95%E5%A4%B1%E5%8E%BB%E5%8A%A0%E6%8B%BF%E5%A4%A7%E7%A8%B3%E5%AE%9A%E8%80%8C%E5%B9%B3%E4%BB%B7%E7%9A%84%E5%8E%9F%E6%B2%B9%E4%BE%9B%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788010299000.webp","sourceId":"rfi"},{"id":1788009371000,"createdDate":"2026-08-29 13:16","name":"法国国际广播电台","title":"越烂却越火的低成本动画《牛来》让中国观众花钱买的不是电影是一个下午的欢乐","content":"中国低成本国产动画片《牛来》票房破五千万，不仅在网上衍生出层出不穷的再创，更成为国际媒体报导的奇特文化现象。究竟网友们怎么评价这部片？既然知道它烂为何还是愿意花钱去看？但随着《牛来》爆红，网上也出现这部极致烂片是为了要片中国政府的补助。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260829-%E8%B6%8A%E7%83%82%E5%8D%B4%E8%B6%8A%E7%81%AB%E7%9A%84%E4%BD%8E%E6%88%90%E6%9C%AC%E5%8A%A8%E7%94%BB-%E7%89%9B%E6%9D%A5-%E8%AE%A9%E4%B8%AD%E5%9B%BD%E8%A7%82%E4%BC%97%E8%8A%B1%E9%92%B1%E4%B9%B0%E7%9A%84%E4%B8%8D%E6%98%AF%E7%94%B5%E5%BD%B1%E6%98%AF%E4%B8%80%E4%B8%AA%E4%B8%8B%E5%8D%88%E7%9A%84%E6%AC%A2%E4%B9%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788009371000.webp","sourceId":"rfi"},{"id":1788004104000,"createdDate":"2026-08-29 11:48","name":"法国国际广播电台","title":"喜马拉雅山洪至少633人遇难，救援队加紧搜寻约3000名失踪人员","content":"周六，救援人员加紧努力，试图寻找约3000名失踪人员，并疏散被困在尼泊尔与中国边境的幸存者。此前三天，一场可怕的洪灾造成600多人死亡，并留下一片满目疮痍的景象。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260829-%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E5%B1%B1%E6%B4%AA%E8%87%B3%E5%B0%91633%E4%BA%BA%E9%81%87%E9%9A%BE%EF%BC%8C%E6%95%91%E6%8F%B4%E9%98%9F%E5%8A%A0%E7%B4%A7%E6%90%9C%E5%AF%BB%E7%BA%A63000%E5%90%8D%E5%A4%B1%E8%B8%AA%E4%BA%BA%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788004104000.webp","sourceId":"rfi"},{"id":1788003488000,"createdDate":"2026-08-29 11:38","name":"法国国际广播电台","title":"冰岛举行全民公投，确定是否与布鲁塞尔重启入盟谈判","content":"冰岛8月29日举行公民投票，确定是否重启与欧盟中断13年的入盟谈判。尽管欧盟乐见接纳这个富裕而且稳定的国家为新成员，但冰岛居民对作为该国经济支柱的渔业是否会在加入欧盟后受到限制的担心，使得这次公投结果胜负难料。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260829-%E5%86%B0%E5%B2%9B%E4%B8%BE%E8%A1%8C%E5%85%A8%E6%B0%91%E5%85%AC%E6%8A%95%EF%BC%8C%E7%A1%AE%E5%AE%9A%E6%98%AF%E5%90%A6%E4%B8%8E%E5%B8%83%E9%B2%81%E5%A1%9E%E5%B0%94%E9%87%8D%E5%90%AF%E5%85%A5%E7%9B%9F%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788003488000.webp","sourceId":"rfi"},{"id":1788000419000,"createdDate":"2026-08-29 10:46","name":"法国国际广播电台","title":"美中太空竞赛差距缩小：特朗普绝不当“老二”筹建太空学院，谁先“驻月”或揭胜负","content":"美中太空竞赛持续升温，美国总统特朗普周五（8月28日）正式签署行政命令，启动筹建「美国太空学院」。该学院将仿效西点军校的模式，专门培养军事、工程及航天领域的专业人才，以进一步强化国家的太空实力。特朗普在休斯敦林登·约翰逊太空中心强调，美国绝不能在太空领域落于人后。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260829-%E7%BE%8E%E4%B8%AD%E5%A4%AA%E7%A9%BA%E7%AB%9E%E8%B5%9B%E5%B7%AE%E8%B7%9D%E7%BC%A9%E5%B0%8F-%E7%89%B9%E6%9C%97%E6%99%AE%E7%BB%9D%E4%B8%8D%E5%BD%93-%E8%80%81%E4%BA%8C-%E7%AD%B9%E5%BB%BA%E5%A4%AA%E7%A9%BA%E5%AD%A6%E9%99%A2%EF%BC%8C%E8%B0%81%E5%85%88-%E9%A9%BB%E6%9C%88-%E6%88%96%E6%8F%AD%E8%83%9C%E8%B4%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1788000419000.webp","sourceId":"rfi"},{"id":1787991600000,"createdDate":"2026-08-29 08:20","name":"法国国际广播电台","title":"中资水坝贪腐案：厄瓜多尔前总统莫雷诺、中国前大使均判5年徒刑","content":"路透社基多消息，厄瓜多尔一家法院于周五裁定前总统莫雷诺（LeninMoreno）因收受建造该国最大水力发电大坝的中国公司贿赂，贪污罪名成立。現年73岁的莫雷诺被判处5年监禁，并被终身禁止担任任何公职。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260829-%E4%B8%AD%E8%B5%84%E6%B0%B4%E5%9D%9D%E8%B4%AA%E8%85%90%E6%A1%88-%E5%8E%84%E7%93%9C%E5%A4%9A%E5%B0%94%E5%89%8D%E6%80%BB%E7%BB%9F%E8%8E%AB%E9%9B%B7%E8%AF%BA-%E4%B8%AD%E5%9B%BD%E5%89%8D%E5%A4%A7%E4%BD%BF%E5%9D%87%E5%88%A45%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1787991600000.webp","sourceId":"rfi"},{"id":1787990581000,"createdDate":"2026-08-29 08:03","name":"法国国际广播电台","title":"日本大学生时隔七年赴俄罗斯交流","content":"日本外务省8月28日透露，日本重新启动了自2019年最后一次实施以来中断了的向俄罗斯短期派遣日本大学生等人员交流项目。这是时隔7年再次派遣，共有15名学习俄语等课程的大学生等，于本月12日至20日期间在俄罗斯第二大城市圣彼得堡停留，参加俄语培训、与当地学生交流，并参观了大学的教室、学生宿舍等设施，此次赴俄由“日俄青年交流中心”及参加者所属大学共同进行了人员募集。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260829-%E6%97%A5%E6%9C%AC%E5%A4%A7%E5%AD%A6%E7%94%9F%E6%97%B6%E9%9A%94%E4%B8%83%E5%B9%B4%E8%B5%B4%E4%BF%84%E7%BD%97%E6%96%AF%E4%BA%A4%E6%B5%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1787990581000.webp","sourceId":"rfi"},{"id":1787990041000,"createdDate":"2026-08-29 07:54","name":"法国国际广播电台","title":"台湾九合一大选将合并废除非核家园公投 民团质疑公投沦为政党操弄选举工具","content":"中选会28日审议在野党日前于立法院所提三项公投案，最终仅「废除非核家园」公投闯关成功，将于11月与九合一选举合并投票。「鞭刑公投」、「交通罚锾专用」均遭否决。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260829-%E5%8F%B0%E6%B9%BE%E4%B9%9D%E5%90%88%E4%B8%80%E5%A4%A7%E9%80%89%E5%B0%86%E5%90%88%E5%B9%B6%E5%BA%9F%E9%99%A4%E9%9D%9E%E6%A0%B8%E5%AE%B6%E5%9B%AD%E5%85%AC%E6%8A%95-%E6%B0%91%E5%9B%A2%E8%B4%A8%E7%96%91%E5%85%AC%E6%8A%95%E6%B2%A6%E4%B8%BA%E6%94%BF%E5%85%9A%E6%93%8D%E5%BC%84%E9%80%89%E4%B8%BE%E5%B7%A5%E5%85%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/29/1787990041000.webp","sourceId":"rfi"}]