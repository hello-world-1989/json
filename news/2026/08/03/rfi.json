[{"id":1785753931000,"createdDate":"2026-08-03 10:45","name":"法国国际广播电台","title":"美太平洋司令部司令：以实力而非对抗来吓阻中国，不允许任何国家主宰印太","content":"美国太平洋司令部司令帕帕罗（SamuelPaparo）周一在出席活动时表示，中国等行为者的胁迫性行为正挑战地区稳定，并警告称美国绝不允许任何国家主宰印度-太平洋。帕帕罗称，一些行为者正利用“虚假的合法性主张”来为其恐吓与胁迫行为作辩护。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E7%BE%8E%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%8F%B8%E4%BB%A4%E9%83%A8%E5%8F%B8%E4%BB%A4-%E4%BB%A5%E5%AE%9E%E5%8A%9B%E8%80%8C%E9%9D%9E%E5%AF%B9%E6%8A%97%E6%9D%A5%E5%90%93%E9%98%BB%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%B8%8D%E5%85%81%E8%AE%B8%E4%BB%BB%E4%BD%95%E5%9B%BD%E5%AE%B6%E4%B8%BB%E5%AE%B0%E5%8D%B0%E5%BA%A6-%E5%A4%AA%E5%B9%B3%E6%B4%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785753931000.webp","sourceId":"rfi"},{"id":1785753493000,"createdDate":"2026-08-03 10:38","name":"法国国际广播电台","title":"日美公布联合干预外汇市场阻止日元贬值  特朗普表示日本向美国求援","content":"日本财务大臣片山皋月3日表示，为了遏制日元过度贬值，日美两国政府已联合实施了买入日元的外汇市场干预。消息公布后，日元汇率一度升至1美元兑155日元区间。美国总统特朗普2日就美国政府买入日元进行市场干预的原因表示：“是日本向我们寻求帮助。”他并强调：“这是友谊的证明。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E6%97%A5%E7%BE%8E%E5%85%AC%E5%B8%83%E8%81%94%E5%90%88%E5%B9%B2%E9%A2%84%E5%A4%96%E6%B1%87%E5%B8%82%E5%9C%BA%E9%98%BB%E6%AD%A2%E6%97%A5%E5%85%83%E8%B4%AC%E5%80%BC-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A1%A8%E7%A4%BA%E6%97%A5%E6%9C%AC%E5%90%91%E7%BE%8E%E5%9B%BD%E6%B1%82%E6%8F%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785753493000.webp","sourceId":"rfi"},{"id":1785750792000,"createdDate":"2026-08-03 09:53","name":"法国国际广播电台","title":"DeepSeek新款V4-Flash经测为目前运行成本最低知名模型 阿里发布新AI模型","content":"据一家业内研究机构称，在针对全球知名人工智能（AI）模型的基准测试中，中国初创企业DeepSeek旗下旗舰人工智能模型的一个版本在运行成本上是最低的，其运行成本甚至比Anthropic公司ClaudeFable5模型便宜一百多倍。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260803-deepseek%E6%96%B0%E6%AC%BEv4-flash%E7%BB%8F%E6%B5%8B%E4%B8%BA%E7%9B%AE%E5%89%8D%E8%BF%90%E8%A1%8C%E6%88%90%E6%9C%AC%E6%9C%80%E4%BD%8E%E7%9F%A5%E5%90%8D%E6%A8%A1%E5%9E%8B-%E9%98%BF%E9%87%8C%E5%8F%91%E5%B8%83%E6%96%B0ai%E6%A8%A1%E5%9E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785750792000.webp","sourceId":"rfi"},{"id":1785750346000,"createdDate":"2026-08-03 09:45","name":"法国国际广播电台","title":"80岁的巴西左翼领导人卢拉宣布将于10月4日竞选第四个总统任期","content":"巴西现任国家元首，80岁的左翼领导人卢拉将于10月4日竞选第四个任期。由于进步派阵营中缺乏像他那样具有高人气的接班人，卢拉依然是击败极右翼势力、赢得总统大选的最佳人选。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260803-80%E5%B2%81%E7%9A%84%E5%B7%B4%E8%A5%BF%E5%B7%A6%E7%BF%BC%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%8D%A2%E6%8B%89%E5%AE%A3%E5%B8%83%E5%B0%86%E4%BA%8E10%E6%9C%884%E6%97%A5%E7%AB%9E%E9%80%89%E7%AC%AC%E5%9B%9B%E4%B8%AA%E6%80%BB%E7%BB%9F%E4%BB%BB%E6%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785750346000.webp","sourceId":"rfi"},{"id":1785748539000,"createdDate":"2026-08-03 09:15","name":"法国国际广播电台","title":"两岸学生交流单向不对等 陆委会称将强化大陆识读教育 提醒风险、注意事项","content":"台湾监察委员日前提出报告，指两岸青年学子交流形成单向不对等现象，且学校漏报学生赴陆资讯，引发舆论关注。据中央社报导，台湾陆委会对此表示，将辅导各级学校，强化中国大陆识读教育，提醒赴陆风险及两岸学术教育交流应注意事项。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260803-%E4%B8%A4%E5%B2%B8%E5%AD%A6%E7%94%9F%E4%BA%A4%E6%B5%81%E5%8D%95%E5%90%91%E4%B8%8D%E5%AF%B9%E7%AD%89-%E9%99%86%E5%A7%94%E4%BC%9A%E7%A7%B0%E5%B0%86%E5%BC%BA%E5%8C%96%E5%A4%A7%E9%99%86%E8%AF%86%E8%AF%BB%E6%95%99%E8%82%B2-%E6%8F%90%E9%86%92%E9%A3%8E%E9%99%A9-%E6%B3%A8%E6%84%8F%E4%BA%8B%E9%A1%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785748539000.webp","sourceId":"rfi"},{"id":1785747108000,"createdDate":"2026-08-03 08:51","name":"法国国际广播电台","title":"台湾防长：与美军太平洋司令部的密切联系提升防卫战备能力","content":"台湾防务部门负责人顾立雄上周表示，台湾与美国的合作可能比许多人想象的更为密切；台湾正致力于深化与美军印太司令部的军事交流，以提升防卫能力。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E5%8F%B0%E6%B9%BE%E9%98%B2%E9%95%BF-%E4%B8%8E%E7%BE%8E%E5%86%9B%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%8F%B8%E4%BB%A4%E9%83%A8%E7%9A%84%E5%AF%86%E5%88%87%E8%81%94%E7%B3%BB%E6%8F%90%E5%8D%87%E9%98%B2%E5%8D%AB%E6%88%98%E5%A4%87%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785747108000.webp","sourceId":"rfi"},{"id":1785742750000,"createdDate":"2026-08-03 07:39","name":"法国国际广播电台","title":"全球首只中国离岸国债期货在港上市 北京五方面推动中港深化合作","content":"香港交易所(港交所)推出五年期中国国债期货，是全球离岸市场首只中国国债期货合约产品。中国证监会主席吴清形容这是一个里程碑，认为这有助投资者更有效管理利率风险，让外资安心持有中国国债，进一步丰富人民币使用场景，以及强化香港全球离岸人民币业务枢纽功能。其说法与今日公布的下半年人民币工作会议结论相呼应。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E5%85%A8%E7%90%83%E9%A6%96%E5%8F%AA%E4%B8%AD%E5%9B%BD%E7%A6%BB%E5%B2%B8%E5%9B%BD%E5%80%BA%E6%9C%9F%E8%B4%A7%E5%9C%A8%E6%B8%AF%E4%B8%8A%E5%B8%82-%E5%8C%97%E4%BA%AC%E4%BA%94%E6%96%B9%E9%9D%A2%E6%8E%A8%E5%8A%A8%E4%B8%AD%E6%B8%AF%E6%B7%B1%E5%8C%96%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785742750000.webp","sourceId":"rfi"},{"id":1785742070000,"createdDate":"2026-08-03 07:27","name":"法国国际广播电台","title":"港人对「爱国者选举」不卖帐？ 选民连减五年 年轻选民更跌七成","content":"由北京在香港推动的「爱国者选举」似乎吸引不了选民，因为官方数据显示，今年的地方选区临时登记册的选民人数只有412万名，较去年减少逾1.8万人，是连续五年下跌，整体相关人数更创下自2018年以来的新低；当中尤以18至25岁的「首投族」跌幅最显着，较「爱国者选举」推出前夕的高峰期，大减达七成。有关情况，与有真选举的台湾刚好相反，後者的登记选民在总人口减少的情况下保持增长，而「首投族」人数只是轻微下跌，仍能维持在一百万人以上。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E6%B8%AF%E4%BA%BA%E5%AF%B9-%E7%88%B1%E5%9B%BD%E8%80%85%E9%80%89%E4%B8%BE-%E4%B8%8D%E5%8D%96%E5%B8%90-%E9%80%89%E6%B0%91%E8%BF%9E%E5%87%8F%E4%BA%94%E5%B9%B4-%E5%B9%B4%E8%BD%BB%E9%80%89%E6%B0%91%E6%9B%B4%E8%B7%8C%E4%B8%83%E6%88%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785742070000.webp","sourceId":"rfi"},{"id":1785779537000,"createdDate":"2026-08-03 17:52","name":"法国国际广播电台","title":"延期7年后     波音737 Max 7终获美批准投入飞行","content":"波音737MAX系列飞机于2011年8月30日在波音总部所在地西雅图正式亮相，旨在与欧洲主要竞争对手空客的A320neo展开竞争。该系列飞机取得了前所未有的商业成功，但其发展历程却饱受延误、事故和质量问题的困扰。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260803-%E5%BB%B6%E6%9C%9F7%E5%B9%B4%E5%90%8E-%E6%B3%A2%E9%9F%B3737-max-7%E7%BB%88%E8%8E%B7%E7%BE%8E%E6%89%B9%E5%87%86%E6%8A%95%E5%85%A5%E9%A3%9E%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785779537000.webp","sourceId":"rfi"},{"id":1785774750000,"createdDate":"2026-08-03 16:32","name":"法国国际广播电台","title":"美永久实施签证保证金制度 50国申请观光商务签证最高须缴2万美元","content":"美国国务院宣布，自8月3日起永久实施B-1商务及B-2观光签证保证金制度，来自50个指定国家的签证申请人，可能须缴交最高2万美元保证金才能取得美国签证，其中30国来自非洲，12国来自亚洲。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E7%BE%8E%E6%B0%B8%E4%B9%85%E5%AE%9E%E6%96%BD%E7%AD%BE%E8%AF%81%E4%BF%9D%E8%AF%81%E9%87%91%E5%88%B6%E5%BA%A6-50%E5%9B%BD%E7%94%B3%E8%AF%B7%E8%A7%82%E5%85%89%E5%95%86%E5%8A%A1%E7%AD%BE%E8%AF%81%E6%9C%80%E9%AB%98%E9%A1%BB%E7%BC%B42%E4%B8%87%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785774750000.webp","sourceId":"rfi"},{"id":1785772452000,"createdDate":"2026-08-03 15:54","name":"法国国际广播电台","title":"听取侨民反映后 印度大使称中方正采取措施应对社媒平台上反印内容激增","content":"据印度报业托拉斯（PTI）报导，在印度驻华大使馆近年来首次举办的“开放日”活动上，在华印度侨民表达了对中国社交媒体上反印内容、专业人士工作签证获批受阻以及配偶就业受限等问题的关切。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260803-%E5%90%AC%E5%8F%96%E4%BE%A8%E6%B0%91%E5%8F%8D%E6%98%A0%E5%90%8E-%E5%8D%B0%E5%BA%A6%E5%A4%A7%E4%BD%BF%E7%A7%B0%E4%B8%AD%E6%96%B9%E6%AD%A3%E9%87%87%E5%8F%96%E6%8E%AA%E6%96%BD%E5%BA%94%E5%AF%B9%E7%A4%BE%E5%AA%92%E5%B9%B3%E5%8F%B0%E4%B8%8A%E5%8F%8D%E5%8D%B0%E5%86%85%E5%AE%B9%E6%BF%80%E5%A2%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785772452000.webp","sourceId":"rfi"},{"id":1785770035000,"createdDate":"2026-08-03 15:13","name":"法国国际广播电台","title":"中方主导、中东战事等背景下 美国稀土相关初创企业正加紧提高产能","content":"位于美国东北部新罕布什尔州一座仓库的墙上悬挂着一面巨大的美国国旗，暗示着装在1吨重的袋子中的采矿废料中所含元素的国家重要性。该公司利用电解法从传统矿山留下的粉末中分离出特朗普政府迫切希望在美国国内生产的关键元素。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E4%B8%AD%E6%96%B9%E4%B8%BB%E5%AF%BC-%E4%B8%AD%E4%B8%9C%E6%88%98%E4%BA%8B%E7%AD%89%E8%83%8C%E6%99%AF%E4%B8%8B-%E7%BE%8E%E5%9B%BD%E7%A8%80%E5%9C%9F%E7%9B%B8%E5%85%B3%E5%88%9D%E5%88%9B%E4%BC%81%E4%B8%9A%E6%AD%A3%E5%8A%A0%E7%B4%A7%E6%8F%90%E9%AB%98%E4%BA%A7%E8%83%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785770035000.webp","sourceId":"rfi"},{"id":1785766854000,"createdDate":"2026-08-03 14:20","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第3：希腊民主政治的舞台：城邦","content":"迈锡尼文明的昌盛与衰亡为希腊文明的兴起提供了丰富的遗产。历经300多年的所谓黑暗时代，爱琴海沿岸的各部族，爱奥尼亚人、奥里亚人、亚该亚人、多利安人逐渐融合，都称自己是希腊人（Hellene)。奠定了欧洲文明基石的希腊文明诞生了。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260803-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC3-%E5%B8%8C%E8%85%8A%E6%B0%91%E4%B8%BB%E6%94%BF%E6%B2%BB%E7%9A%84%E8%88%9E%E5%8F%B0-%E5%9F%8E%E9%82%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785766854000.webp","sourceId":"rfi"},{"id":1785766221000,"createdDate":"2026-08-03 14:10","name":"法国国际广播电台","title":"被指克宫宣传员 律师称费多罗娃人不在法国 巴黎法院驳回她对驱逐令的上诉","content":"周一，巴黎行政法院驳回了亲克里姆林宫的俄罗斯评论员、“今日俄罗斯”（RT）电视台前法国分台负责人费多罗娃（XeniaFedorova）针对其被驱逐出境一事提出的紧急上诉，裁定她未能证明存在“极端紧迫”的情况；不过，费多罗娃的律师说，她当时已身处国外，并打算仅在驱逐令被中止的情况下才返回法国。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260803-%E8%A2%AB%E6%8C%87%E5%85%8B%E5%AE%AB%E5%AE%A3%E4%BC%A0%E5%91%98-%E5%BE%8B%E5%B8%88%E7%A7%B0%E8%B4%B9%E5%A4%9A%E7%BD%97%E5%A8%83%E4%BA%BA%E4%B8%8D%E5%9C%A8%E6%B3%95%E5%9B%BD-%E5%B7%B4%E9%BB%8E%E6%B3%95%E9%99%A2%E9%A9%B3%E5%9B%9E%E5%A5%B9%E5%AF%B9%E9%A9%B1%E9%80%90%E4%BB%A4%E7%9A%84%E4%B8%8A%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785766221000.webp","sourceId":"rfi"},{"id":1785766085000,"createdDate":"2026-08-03 14:08","name":"法国国际广播电台","title":"印度Z世代抗议迫政府罕见让步  专家：进入“后莫迪”时代","content":"印度青年近期就考试弊端与就业前景发起示威抗议，成功迫使印度总理莫迪政府做出让步。分析人士指出，这是75岁的莫迪自2014年执政以来，极少数因公众压力而被迫退让的例子之一。莫迪长年打造的”不败“形象，如今是否正面临他执政以来最严峻的挑战？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%9B%BD%E9%99%85%E7%BA%B5%E6%A8%AA/20260803-%E5%8D%B0%E5%BA%A6z%E4%B8%96%E4%BB%A3%E6%8A%97%E8%AE%AE%E8%BF%AB%E6%94%BF%E5%BA%9C%E7%BD%95%E8%A7%81%E8%AE%A9%E6%AD%A5-%E4%B8%93%E5%AE%B6-%E8%BF%9B%E5%85%A5-%E5%90%8E%E8%8E%AB%E8%BF%AA-%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785766085000.webp","sourceId":"rfi"},{"id":1785764756000,"createdDate":"2026-08-03 13:45","name":"法国国际广播电台","title":"日本熊本地震：为什么永旺梦乐城熊本发生大爆炸？","content":"2026年7月28日，在发生并观测到最大震度7级的熊本地震后不久，永旺梦乐城熊本（AeonMall熊本）发生了大规模爆炸。截至31日，已确认共有7名员工遇难，成为这次熊本大地震最为惨烈的现场。地震引发大规模的爆炸，在一些处理易燃易爆物质的工厂等时有发生，但是在大型商业设施发生实属罕见，为什么在地震后会发生大爆炸？目前日本经济产业省等部门派员奔赴现场，正在进行彻底调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260803-%E6%97%A5%E6%9C%AC%E7%86%8A%E6%9C%AC%E5%9C%B0%E9%9C%87-%E4%B8%BA%E4%BB%80%E4%B9%88%E6%B0%B8%E6%97%BA%E6%A2%A6%E4%B9%90%E5%9F%8E%E7%86%8A%E6%9C%AC%E5%8F%91%E7%94%9F%E5%A4%A7%E7%88%86%E7%82%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785764756000.webp","sourceId":"rfi"},{"id":1785760210000,"createdDate":"2026-08-03 12:30","name":"法国国际广播电台","title":"菲防长呼吁官员在南海问题上坚持菲方立场 总统府支持 杜特尔特长子异议","content":"菲律宾总统府周一表示支持菲国防部长特奥多罗（GilbertoTeodoroJr.）的呼吁，即公职人员应坚持菲方在西菲律宾海（菲方对其专属经济区内南中国海海域的称呼）问题上的立场；并强调，无论政治派别或在其他问题上存在何种分歧，每一位菲律宾人的忠诚都应只属于国家。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260803-%E8%8F%B2%E9%98%B2%E9%95%BF%E5%91%BC%E5%90%81%E5%AE%98%E5%91%98%E5%9C%A8%E5%8D%97%E6%B5%B7%E9%97%AE%E9%A2%98%E4%B8%8A%E5%9D%9A%E6%8C%81%E8%8F%B2%E6%96%B9%E7%AB%8B%E5%9C%BA-%E6%9D%9C%E7%89%B9%E5%B0%94%E7%89%B9%E9%95%BF%E5%AD%90%E5%BC%82%E8%AE%AE-%E6%80%BB%E7%BB%9F%E5%BA%9C%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785760210000.webp","sourceId":"rfi"},{"id":1785790240000,"createdDate":"2026-08-03 20:50","name":"法国国际广播电台","title":"美25个州在法庭挑战特朗普最新的关税政策","content":"包括加利福尼亚州、纽约州和夏威夷州在内的约25个美国州周一宣布，已向联邦国际贸易法院（CIT）提起诉讼，挑战特朗普总统实施的新一轮关税。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260803-%E7%BE%8E25%E4%B8%AA%E5%B7%9E%E5%9C%A8%E6%B3%95%E5%BA%AD%E6%8C%91%E6%88%98%E7%89%B9%E6%9C%97%E6%99%AE%E6%9C%80%E6%96%B0%E7%9A%84%E5%85%B3%E7%A8%8E%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785790240000.webp","sourceId":"rfi"},{"id":1785789327000,"createdDate":"2026-08-03 20:35","name":"法国国际广播电台","title":"飞地休达（Ceuta）仍有数千撒哈拉以南非洲人在海滩过夜","content":"西班牙位于北非海岸的飞地休达（Ceuta）移民危机得到缓解后仍有数千移民在海滩扎营过夜。欧盟已安排周二召开内政部长紧急视频会议。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260803-%E9%A3%9E%E5%9C%B0%E4%BC%91%E8%BE%BE-ceuta-%E4%BB%8D%E6%9C%89%E6%95%B0%E5%8D%83%E6%92%92%E5%93%88%E6%8B%89%E4%BB%A5%E5%8D%97%E9%9D%9E%E6%B4%B2%E4%BA%BA%E5%9C%A8%E6%B5%B7%E6%BB%A9%E8%BF%87%E5%A4%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785789327000.webp","sourceId":"rfi"},{"id":1785788699000,"createdDate":"2026-08-03 20:24","name":"法国国际广播电台","title":"法国客户担忧小米手机会提价","content":"自8月2日起，小米在中国国内市场上调了多款智能手机的价格。小米17系列、RedmiK90和RedmiTurbo5的售价均上涨了300至500元人民币，约合每台手机上涨38至64欧元。据Notebookcheck报道，部分机型的涨幅高达13%。例如，小米17ProMax的售价从5999元人民币涨至6499元人民币，约合830欧元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260803-%E6%B3%95%E5%9B%BD%E5%AE%A2%E6%88%B7%E6%8B%85%E5%BF%A7%E5%B0%8F%E7%B1%B3%E6%89%8B%E6%9C%BA%E4%BC%9A%E6%8F%90%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785788699000.webp","sourceId":"rfi"},{"id":1785788314000,"createdDate":"2026-08-03 20:18","name":"法国国际广播电台","title":"特朗普批石油公司大赚一笔","content":"美国总统特朗普周一再次呼吁石油公司降低美国消费者的汽油价格，并批评雪佛龙首席执行官迈克·沃思对政府作出的努力视而不见。特朗普批评沃斯在一次电视采访中未能承认其政府在支持石油公司方面所发挥的作用，尤其是在帮助委内瑞拉建立市场方面。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260803-%E7%89%B9%E6%9C%97%E6%99%AE%E6%89%B9%E7%9F%B3%E6%B2%B9%E5%85%AC%E5%8F%B8%E5%A4%A7%E8%B5%9A%E4%B8%80%E7%AC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785788314000.webp","sourceId":"rfi"},{"id":1785788213000,"createdDate":"2026-08-03 20:16","name":"法国国际广播电台","title":"华盛顿州东部大火难以控制  疏散6万居民","content":"周一，消防员继续顽强地试图扑灭美国西北部与肆虐的野火，大火吞噬了斯波坎市（Spokane），数万居民被迫撤离，数百栋建筑化为灰烬。当地警察局长凯文·霍尔（KevinHall）估计，周末期间约有6万人被紧急疏散。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260803-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%B7%9E%E4%B8%9C%E9%83%A8%E5%A4%A7%E7%81%AB%E9%9A%BE%E4%BB%A5%E6%8E%A7%E5%88%B6-%E7%96%8F%E6%95%A36%E4%B8%87%E5%B1%85%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785788213000.webp","sourceId":"rfi"},{"id":1785788083000,"createdDate":"2026-08-03 20:14","name":"法国国际广播电台","title":"非洲气候变化影响疟疾发病区域","content":"一项针对非洲的新研究显示，受全球变暖影响，疟疾（lepaludisme）的分布范围正在发生变化。根据发表在《自然》（Nature）杂志上的这项研究，到2100年，西非和中非地区的感染率可能会下降，而南部非洲的疫情则可能加剧，尤其是在南非。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260803-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E5%BD%B1%E5%93%8D%E7%96%9F%E7%96%BE%E5%8F%91%E7%97%85%E5%8C%BA%E5%9F%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785788083000.webp","sourceId":"rfi"},{"id":1785787818000,"createdDate":"2026-08-03 20:10","name":"法国国际广播电台","title":"专家呼吁保护受威胁的锡克教活动家莫宁德·辛格","content":"五位联合国专家呼吁加拿大加强对加拿大锡克教活动人士莫宁德·辛格（MoninderSingh）的保护。此前，加拿大当局曾警告辛格，他的生命面临切实的威胁。2023年锡克教领袖哈迪普·辛格·尼贾尔（HardeepSinghNijjar）于素里市遇害后，公开指责该事件为印度政府策划的政治暗杀。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260803-%E4%B8%93%E5%AE%B6%E5%91%BC%E5%90%81%E4%BF%9D%E6%8A%A4%E5%8F%97%E5%A8%81%E8%83%81%E7%9A%84%E9%94%A1%E5%85%8B%E6%95%99%E6%B4%BB%E5%8A%A8%E5%AE%B6%E8%8E%AB%E5%AE%81%E5%BE%B7%C2%B7%E8%BE%9B%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785787818000.webp","sourceId":"rfi"},{"id":1785787569000,"createdDate":"2026-08-03 20:06","name":"法国国际广播电台","title":"西班牙仍视休达为不可分割一部分","content":"休达几天来突然成了无节制非法移民危险性的象征。8月3日，西班牙外交大臣何塞·曼努埃尔·阿尔瓦雷斯周一在电视讲话中表示：“休达（Ceuta）和梅利利亚（Melilla）是西班牙领土不可分割的一部分，这一点在全世界看来都是毋庸置疑的。”据马德里方面称，周四和周五非法越境的约6万人——其中大部分是摩洛哥青年——“几乎全部”已被遣返回摩洛哥。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260803-%E8%A5%BF%E7%8F%AD%E7%89%99%E4%BB%8D%E8%A7%86%E4%BC%91%E8%BE%BE%E4%B8%BA%E4%B8%8D%E5%8F%AF%E5%88%86%E5%89%B2%E4%B8%80%E9%83%A8%E5%88%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785787569000.webp","sourceId":"rfi"},{"id":1785787453000,"createdDate":"2026-08-03 20:04","name":"法国国际广播电台","title":"英格兰和威尔士遭遇1836年以来前所未有的干旱","content":"英国气象局周一发布的临时数据显示，由于热浪和几乎没有降水，英格兰和威尔士今年经历了有记录以来最干燥的七月。英国气象局表示，2026年7月是自1836年有记录以来最干旱的一年，这也是英格兰和威尔士“历史上阳光最充足的月份”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260803-%E8%8B%B1%E6%A0%BC%E5%85%B0%E5%92%8C%E5%A8%81%E5%B0%94%E5%A3%AB%E9%81%AD%E9%81%871836%E5%B9%B4%E4%BB%A5%E6%9D%A5%E5%89%8D%E6%89%80%E6%9C%AA%E6%9C%89%E7%9A%84%E5%B9%B2%E6%97%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785787453000.webp","sourceId":"rfi"},{"id":1785787177000,"createdDate":"2026-08-03 19:59","name":"法国国际广播电台","title":"泽连斯基解除乌克兰驻美国大使职务","content":"乌克兰总统泽连斯基周一解除了驻美国大使奥尔加·斯特凡尼什娜（OlgaStefanichyna）的职务。这一决定自7月政府改组以来就已在意料之中，而此时基辅正向华盛顿请求提供新的“爱国者”导弹以应对俄罗斯的空袭。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260803-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%A7%A3%E9%99%A4%E4%B9%8C%E5%85%8B%E5%85%B0%E9%A9%BB%E7%BE%8E%E5%9B%BD%E5%A4%A7%E4%BD%BF%E8%81%8C%E5%8A%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785787177000.webp","sourceId":"rfi"},{"id":1785785653000,"createdDate":"2026-08-03 19:34","name":"法国国际广播电台","title":"二次软禁中的昂山素季首次得以会见红十字组织代表","content":"二次软禁中的81岁诺贝尔和平奖得主和缅甸前领导人昂山素季本周一（8月3日）在首都内比都的一个地点，得到红十字国际委员会一名代表的会见。此前，昂山素季健康状况及安危一直引发外界关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260803-%E4%BA%8C%E6%AC%A1%E8%BD%AF%E7%A6%81%E4%B8%AD%E7%9A%84%E6%98%82%E5%B1%B1%E7%B4%A0%E5%AD%A3%E9%A6%96%E6%AC%A1%E5%BE%97%E4%BB%A5%E4%BC%9A%E8%A7%81%E7%BA%A2%E5%8D%81%E5%AD%97%E7%BB%84%E7%BB%87%E4%BB%A3%E8%A1%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785785653000.webp","sourceId":"rfi"},{"id":1785783521000,"createdDate":"2026-08-03 18:58","name":"法国国际广播电台","title":"瑞士一公民中非共和国遇袭身亡","content":"在中非共和国（RCA），一位瑞士公民及一名中非共和国武装部队（FACA-Forcesarméescentrafricaines）的一名中士（unsergent）于上周在距离该国首都班吉以北大约50公里的一座村庄从事黄金勘探任务中遭遇武装袭击身亡。这是本台法广非洲组（RFIAfrique）今天（2026年08月03号星期一）上网的最新法文消息之一。中非共和国当局目前尚未公布有关这一袭击事件的具体细节。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260803-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E7%91%9E%E5%A3%AB%E4%B8%80%E5%85%AC%E6%B0%91%E4%B8%AD%E9%9D%9E%E5%85%B1%E5%92%8C%E5%9B%BD%E9%81%87%E8%A2%AD%E8%BA%AB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785783521000.webp","sourceId":"rfi"}]