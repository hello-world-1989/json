[{"id":1785753931000,"createdDate":"2026-08-03 10:45","name":"法国国际广播电台","title":"美太平洋司令部司令：以实力而非对抗来吓阻中国，不允许任何国家主宰印太","content":"美国太平洋司令部司令帕帕罗（SamuelPaparo）周一在出席活动时表示，中国等行为者的胁迫性行为正挑战地区稳定，并警告称美国绝不允许任何国家主宰印度-太平洋。帕帕罗称，一些行为者正利用“虚假的合法性主张”来为其恐吓与胁迫行为作辩护。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E7%BE%8E%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%8F%B8%E4%BB%A4%E9%83%A8%E5%8F%B8%E4%BB%A4-%E4%BB%A5%E5%AE%9E%E5%8A%9B%E8%80%8C%E9%9D%9E%E5%AF%B9%E6%8A%97%E6%9D%A5%E5%90%93%E9%98%BB%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%B8%8D%E5%85%81%E8%AE%B8%E4%BB%BB%E4%BD%95%E5%9B%BD%E5%AE%B6%E4%B8%BB%E5%AE%B0%E5%8D%B0%E5%BA%A6-%E5%A4%AA%E5%B9%B3%E6%B4%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785753931000.webp","sourceId":"rfi"},{"id":1785753493000,"createdDate":"2026-08-03 10:38","name":"法国国际广播电台","title":"日美公布联合干预外汇市场阻止日元贬值  特朗普表示日本向美国求援","content":"日本财务大臣片山皋月3日表示，为了遏制日元过度贬值，日美两国政府已联合实施了买入日元的外汇市场干预。消息公布后，日元汇率一度升至1美元兑155日元区间。美国总统特朗普2日就美国政府买入日元进行市场干预的原因表示：“是日本向我们寻求帮助。”他并强调：“这是友谊的证明。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260803-%E6%97%A5%E7%BE%8E%E5%85%AC%E5%B8%83%E8%81%94%E5%90%88%E5%B9%B2%E9%A2%84%E5%A4%96%E6%B1%87%E5%B8%82%E5%9C%BA%E9%98%BB%E6%AD%A2%E6%97%A5%E5%85%83%E8%B4%AC%E5%80%BC-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A1%A8%E7%A4%BA%E6%97%A5%E6%9C%AC%E5%90%91%E7%BE%8E%E5%9B%BD%E6%B1%82%E6%8F%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785753493000.webp","sourceId":"rfi"},{"id":1785750792000,"createdDate":"2026-08-03 09:53","name":"法国国际广播电台","title":"DeepSeek新款V4-Flash经测为目前运行成本最低知名模型 阿里发布新AI模型","content":"据一家业内研究机构称，在针对全球知名人工智能（AI）模型的基准测试中，中国初创企业DeepSeek旗下旗舰人工智能模型的一个版本在运行成本上是最低的，其运行成本甚至比Anthropic公司ClaudeFable5模型便宜一百多倍。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260803-deepseek%E6%96%B0%E6%AC%BEv4-flash%E7%BB%8F%E6%B5%8B%E4%B8%BA%E7%9B%AE%E5%89%8D%E8%BF%90%E8%A1%8C%E6%88%90%E6%9C%AC%E6%9C%80%E4%BD%8E%E7%9F%A5%E5%90%8D%E6%A8%A1%E5%9E%8B-%E9%98%BF%E9%87%8C%E5%8F%91%E5%B8%83%E6%96%B0ai%E6%A8%A1%E5%9E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785750792000.webp","sourceId":"rfi"},{"id":1785750346000,"createdDate":"2026-08-03 09:45","name":"法国国际广播电台","title":"80岁的巴西左翼领导人卢拉宣布将于10月4日竞选第四个总统任期","content":"巴西现任国家元首，80岁的左翼领导人卢拉将于10月4日竞选第四个任期。由于进步派阵营中缺乏像他那样具有高人气的接班人，卢拉依然是击败极右翼势力、赢得总统大选的最佳人选。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260803-80%E5%B2%81%E7%9A%84%E5%B7%B4%E8%A5%BF%E5%B7%A6%E7%BF%BC%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%8D%A2%E6%8B%89%E5%AE%A3%E5%B8%83%E5%B0%86%E4%BA%8E10%E6%9C%884%E6%97%A5%E7%AB%9E%E9%80%89%E7%AC%AC%E5%9B%9B%E4%B8%AA%E6%80%BB%E7%BB%9F%E4%BB%BB%E6%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785750346000.webp","sourceId":"rfi"},{"id":1785748539000,"createdDate":"2026-08-03 09:15","name":"法国国际广播电台","title":"两岸学生交流单向不对等 陆委会称将强化大陆识读教育 提醒风险、注意事项","content":"台湾监察委员日前提出报告，指两岸青年学子交流形成单向不对等现象，且学校漏报学生赴陆资讯，引发舆论关注。据中央社报导，台湾陆委会对此表示，将辅导各级学校，强化中国大陆识读教育，提醒赴陆风险及两岸学术教育交流应注意事项。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260803-%E4%B8%A4%E5%B2%B8%E5%AD%A6%E7%94%9F%E4%BA%A4%E6%B5%81%E5%8D%95%E5%90%91%E4%B8%8D%E5%AF%B9%E7%AD%89-%E9%99%86%E5%A7%94%E4%BC%9A%E7%A7%B0%E5%B0%86%E5%BC%BA%E5%8C%96%E5%A4%A7%E9%99%86%E8%AF%86%E8%AF%BB%E6%95%99%E8%82%B2-%E6%8F%90%E9%86%92%E9%A3%8E%E9%99%A9-%E6%B3%A8%E6%84%8F%E4%BA%8B%E9%A1%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785748539000.webp","sourceId":"rfi"},{"id":1785747108000,"createdDate":"2026-08-03 08:51","name":"法国国际广播电台","title":"台湾防长：与美军太平洋司令部的密切联系提升防卫战备能力","content":"台湾防务部门负责人顾立雄上周表示，台湾与美国的合作可能比许多人想象的更为密切；台湾正致力于深化与美军印太司令部的军事交流，以提升防卫能力。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E5%8F%B0%E6%B9%BE%E9%98%B2%E9%95%BF-%E4%B8%8E%E7%BE%8E%E5%86%9B%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%8F%B8%E4%BB%A4%E9%83%A8%E7%9A%84%E5%AF%86%E5%88%87%E8%81%94%E7%B3%BB%E6%8F%90%E5%8D%87%E9%98%B2%E5%8D%AB%E6%88%98%E5%A4%87%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785747108000.webp","sourceId":"rfi"},{"id":1785742750000,"createdDate":"2026-08-03 07:39","name":"法国国际广播电台","title":"全球首只中国离岸国债期货在港上市 北京五方面推动中港深化合作","content":"香港交易所(港交所)推出五年期中国国债期货，是全球离岸市场首只中国国债期货合约产品。中国证监会主席吴清形容这是一个里程碑，认为这有助投资者更有效管理利率风险，让外资安心持有中国国债，进一步丰富人民币使用场景，以及强化香港全球离岸人民币业务枢纽功能。其说法与今日公布的下半年人民币工作会议结论相呼应。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E5%85%A8%E7%90%83%E9%A6%96%E5%8F%AA%E4%B8%AD%E5%9B%BD%E7%A6%BB%E5%B2%B8%E5%9B%BD%E5%80%BA%E6%9C%9F%E8%B4%A7%E5%9C%A8%E6%B8%AF%E4%B8%8A%E5%B8%82-%E5%8C%97%E4%BA%AC%E4%BA%94%E6%96%B9%E9%9D%A2%E6%8E%A8%E5%8A%A8%E4%B8%AD%E6%B8%AF%E6%B7%B1%E5%8C%96%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785742750000.webp","sourceId":"rfi"},{"id":1785742070000,"createdDate":"2026-08-03 07:27","name":"法国国际广播电台","title":"港人对「爱国者选举」不卖帐？ 选民连减五年 年轻选民更跌七成","content":"由北京在香港推动的「爱国者选举」似乎吸引不了选民，因为官方数据显示，今年的地方选区临时登记册的选民人数只有412万名，较去年减少逾1.8万人，是连续五年下跌，整体相关人数更创下自2018年以来的新低；当中尤以18至25岁的「首投族」跌幅最显着，较「爱国者选举」推出前夕的高峰期，大减达七成。有关情况，与有真选举的台湾刚好相反，後者的登记选民在总人口减少的情况下保持增长，而「首投族」人数只是轻微下跌，仍能维持在一百万人以上。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260803-%E6%B8%AF%E4%BA%BA%E5%AF%B9-%E7%88%B1%E5%9B%BD%E8%80%85%E9%80%89%E4%B8%BE-%E4%B8%8D%E5%8D%96%E5%B8%90-%E9%80%89%E6%B0%91%E8%BF%9E%E5%87%8F%E4%BA%94%E5%B9%B4-%E5%B9%B4%E8%BD%BB%E9%80%89%E6%B0%91%E6%9B%B4%E8%B7%8C%E4%B8%83%E6%88%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/03/1785742070000.webp","sourceId":"rfi"}]