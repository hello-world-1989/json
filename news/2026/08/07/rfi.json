[{"id":1786118760000,"createdDate":"2026-08-07 16:06","name":"法国国际广播电台","title":"也门胡塞叛军空袭造成58名政府军死亡后发动新一轮致命袭击","content":"周五，在也门一个石油资源丰富的省份，胡塞叛军发动了新一轮袭击，造成至少三名也门政府军士兵和两名平民死亡。此前一天，该国刚遭遇了自2022年停火以来伤亡最惨重的空袭。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260807-%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E5%8F%9B%E5%86%9B%E7%A9%BA%E8%A2%AD%E9%80%A0%E6%88%9058%E5%90%8D%E6%94%BF%E5%BA%9C%E5%86%9B%E6%AD%BB%E4%BA%A1%E5%90%8E%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E8%87%B4%E5%91%BD%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786118760000.webp","sourceId":"rfi"},{"id":1786116180000,"createdDate":"2026-08-07 15:23","name":"法国国际广播电台","title":"太平洋岛国论坛未就共同谴责中国发射导弹达成一致 两国异议","content":"太平洋岛国论坛18个成员国周五8月7日在斐济首都苏瓦举行外交会议，但未能就一份谴责中国近期在该地区进行战略导弹试射的联合声明达成一致。新西兰外长暗示两个成员国作梗，澳洲外长呼吁该地区团结应对巨大挑战。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260807-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E6%9C%AA%E5%B0%B1%E5%85%B1%E5%90%8C%E8%B0%B4%E8%B4%A3%E4%B8%AD%E5%9B%BD%E5%8F%91%E5%B0%84%E5%AF%BC%E5%BC%B9%E8%BE%BE%E6%88%90%E4%B8%80%E8%87%B4-%E4%B8%A4%E5%9B%BD%E5%BC%82%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786116180000.webp","sourceId":"rfi"},{"id":1786113020000,"createdDate":"2026-08-07 14:30","name":"法国国际广播电台","title":"台大新研所洪贞玲、林丽云教授谈：AI时代的新闻教育、真实性与台湾媒体处境","content":"大家好，生成式的AI正在为各个产业带来前所未有的典范转移，也使得传统新闻产制流程面临前所未有的挑战。在上一期的中华世界，台大新闻研究所洪贞玲与林丽云两位教授作为节目特邀嘉宾，谈到她们对AI对媒体产业的冲击的看法。本在期节目中，洪贞玲与林丽云两位教授继续和听友们分享台大新闻研究所在这方面的应对之策，以及中国刚通过的《民族团结促进法》会不会对台湾媒体产生影响等话题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%AD%E5%8D%8E%E4%B8%96%E7%95%8C/20260807-%E5%8F%B0%E5%A4%A7%E6%B4%AA%E8%B4%9E%E7%8E%B2%E4%B8%8E%E6%9E%97%E4%B8%BD%E4%BA%91ai%E6%97%B6%E4%BB%A3%E7%9A%84%E6%96%B0%E9%97%BB%E6%95%99%E8%82%B2-%E5%AA%92%E4%BD%93%E7%9C%9F%E5%AE%9E%E4%B8%8E%E5%8F%B0%E6%B9%BE%E5%A4%84%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786113020000.webp","sourceId":"rfi"},{"id":1786112017000,"createdDate":"2026-08-07 14:13","name":"法国国际广播电台","title":"沙特阿拉伯与土耳其巴基斯坦签署防务协议：袭击一国等同袭击三国","content":"在沙特阿拉伯遭受袭击以及中东战火纷飞的背景下，沙特阿拉伯、巴基斯坦和土耳其于周五签署了一项将三国联结在一起的防务协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260807-%E6%B2%99%E7%89%B9%E9%98%BF%E6%8B%89%E4%BC%AF%E4%B8%8E%E5%9C%9F%E8%80%B3%E5%85%B6%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E7%AD%BE%E7%BD%B2%E9%98%B2%E5%8A%A1%E5%8D%8F%E8%AE%AE-%E8%A2%AD%E5%87%BB%E4%B8%80%E5%9B%BD%E7%AD%89%E5%90%8C%E8%A2%AD%E5%87%BB%E4%B8%89%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786112017000.webp","sourceId":"rfi"},{"id":1786109328000,"createdDate":"2026-08-07 13:28","name":"法国国际广播电台","title":"俄罗斯电商巨头再遭袭 叶卡捷琳堡一物流中心起火","content":"俄罗斯电商巨头野莓（Wildberries）物流中心周五再遭无人机袭击，发生火灾。周五的袭击目标是乌拉尔地区叶卡捷琳堡一处物流中心。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260807-%E4%BF%84%E7%BD%97%E6%96%AF%E7%94%B5%E5%95%86%E5%B7%A8%E5%A4%B4%E5%86%8D%E9%81%AD%E8%A2%AD-%E5%8F%B6%E5%8D%A1%E6%8D%B7%E7%90%B3%E5%A0%A1%E4%B8%80%E7%89%A9%E6%B5%81%E4%B8%AD%E5%BF%83%E8%B5%B7%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786109328000.webp","sourceId":"rfi"},{"id":1786108113000,"createdDate":"2026-08-07 13:08","name":"法国国际广播电台","title":"中国海警船遭自家军舰误撞一年后 北京低调宣布两人死亡","content":"法新社8月7日发自北京报道，中国官方在事发近一年后，于本周低调宣布两名中国海警人员在与菲律宾存在争议的一处礁石附近发生意外碰撞时不幸身亡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260807-%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E8%88%B9%E9%81%AD%E8%87%AA%E5%AE%B6%E5%86%9B%E8%88%B0%E8%AF%AF%E6%92%9E%E4%B8%80%E5%B9%B4%E5%90%8E-%E5%8C%97%E4%BA%AC%E4%BD%8E%E8%B0%83%E5%AE%A3%E5%B8%83%E4%B8%A4%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786108113000.webp","sourceId":"rfi"},{"id":1786100409000,"createdDate":"2026-08-07 11:00","name":"法国国际广播电台","title":"委内瑞拉朝野重启谈判　美国斡旋下寻求政治过渡","content":"委内瑞拉朝野对话星期四在首都加拉加斯正式展开。根据媒体报道，这是多年来委内瑞拉政府与反对派再次展开正式谈判，也是首次在美国积极推动和参与下举行的政治对话。外界普遍关注，这一轮谈判能否最终推动委内瑞拉政治过渡，并为重新举行选举铺路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260807-%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%9C%9D%E9%87%8E%E9%87%8D%E5%90%AF%E8%B0%88%E5%88%A4-%E7%BE%8E%E5%9B%BD%E6%96%A1%E6%97%8B%E4%B8%8B%E5%AF%BB%E6%B1%82%E6%94%BF%E6%B2%BB%E8%BF%87%E6%B8%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786100409000.webp","sourceId":"rfi"},{"id":1786100382000,"createdDate":"2026-08-07 10:59","name":"法国国际广播电台","title":"费加罗报：中国占法贸易逆差88%，巴黎如何减弱“北京压路机”的冲击？","content":"大家好，周五8月7日的法国主流日报头版不约而同地都提到了法国持续走高的失业率，今年第二季度已达8,3%，创下自2020年秋季以来的最高水平。法中两国之间的贸易逆差已从2019年的320亿欧元，扩大至截至今年5月的12个月内达到510亿欧元，此一境况成为《费加罗报》经济版文章的分析重点。该报另一篇刊登于国际版的报道则关注了台湾自8月5日至14日举行年度“汉光演习”，模拟应对中国可能发动的入侵。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260807-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E5%8D%A0%E6%B3%95%E8%B4%B8%E6%98%93%E9%80%86%E5%B7%AE88-%EF%BC%8C%E5%B7%B4%E9%BB%8E%E5%A6%82%E4%BD%95%E5%87%8F%E5%BC%B1-%E5%8C%97%E4%BA%AC%E5%8E%8B%E8%B7%AF%E6%9C%BA-%E7%9A%84%E5%86%B2%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786100382000.webp","sourceId":"rfi"},{"id":1786094151000,"createdDate":"2026-08-07 09:15","name":"法国国际广播电台","title":"美伊战争陷十字路口 美军弹药库存争议增添战事变数","content":"美国与伊朗持续五个多月的战争出现新的转折。美国总统特朗普说，他已取消原本计划对伊朗发动、被形容为“第二次世界大战以来最大规模”的军事攻击，原因是伊朗及其他中东国家要求美方暂缓行动，称双方已就协议框架取得进展。不过，伊朗随即否认美伊已安排任何谈判。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260807-%E7%BE%8E%E4%BC%8A%E6%88%98%E4%BA%89%E9%99%B7%E5%8D%81%E5%AD%97%E8%B7%AF%E5%8F%A3-%E7%BE%8E%E5%86%9B%E5%BC%B9%E8%8D%AF%E5%BA%93%E5%AD%98%E4%BA%89%E8%AE%AE%E5%A2%9E%E6%B7%BB%E6%88%98%E4%BA%8B%E5%8F%98%E6%95%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786094151000.webp","sourceId":"rfi"},{"id":1786093650000,"createdDate":"2026-08-07 09:07","name":"法国国际广播电台","title":"中俄缺席广岛原爆和平纪念仪式 俄罗斯对其进行批判","content":"广岛市于8月6日在和平纪念公园（中区）举行和平纪念仪式。除原子弹爆炸受害者、遗属以及高市首相外，还有来自创历史新高的100多个国家和地区以及欧盟驻日代表团的大使等出席。美国、英国等拥核国家，以及目前为战斗冲突当事国的乌克兰和伊朗也派员参加，俄罗斯和中国则未出席，俄罗斯外交部发言人扎哈罗娃还对广岛市市长松井一实在“原爆日”宣读的“和平宣言”进行了批判。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260807-%E4%B8%AD%E4%BF%84%E7%BC%BA%E5%B8%AD%E5%B9%BF%E5%B2%9B%E5%8E%9F%E7%88%86%E5%92%8C%E5%B9%B3%E7%BA%AA%E5%BF%B5%E4%BB%AA%E5%BC%8F-%E4%BF%84%E7%BD%97%E6%96%AF%E5%AF%B9%E5%85%B6%E8%BF%9B%E8%A1%8C%E6%89%B9%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786093650000.webp","sourceId":"rfi"},{"id":1786092920000,"createdDate":"2026-08-07 08:55","name":"法国国际广播电台","title":"泰国学校发生枪击案 共造成8人死亡","content":"据法新社报道，泰国曼谷北部暖武里府一所中学星期五发生严重枪击案。泰国警方表示，一名就读该校的未成年学生，涉嫌先使用祖父的手枪，在家中枪杀祖父母，之后前往学校，再开枪打死至少6人，包括3名教师和3名学生。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260807-%E6%B3%B0%E5%9B%BD%E5%AD%A6%E6%A0%A1%E5%8F%91%E7%94%9F%E6%9E%AA%E5%87%BB%E6%A1%88-%E5%85%B1%E9%80%A0%E6%88%908%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786092920000.webp","sourceId":"rfi"},{"id":1786087003000,"createdDate":"2026-08-07 07:16","name":"法国国际广播电台","title":"47人案未被起诉八人 护照被扣逾五年後获发还 是否「复常」有待观察","content":"在因为争取更多立法会议席而导致港府起诉历来最多民主派人士的「47人」案中，有包括前立法会议员和律师等八人在被捕後未被检控，但需要交出护照及定期向警方报到作为集释候查的条件，事隔五年半，他们终於可获发还护照。有评论质疑，警方国安处毋须交代扣留和发还护照的理由，让相关人士俨如身处「大监狱」，至今未知是否表示事件已经翻篇；另有评论则认为，事件有意义，但未知是否等於一直收紧的人权自由会变得较为宽松或少受西方批评，尚须观察。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260807-47%E4%BA%BA%E6%A1%88%E6%9C%AA%E8%A2%AB%E8%B5%B7%E8%AF%89%E5%85%AB%E4%BA%BA-%E6%8A%A4%E7%85%A7%E8%A2%AB%E6%89%A3%E9%80%BE%E4%BA%94%E5%B9%B4%E5%BE%8C%E8%8E%B7%E5%8F%91%E8%BF%98-%E6%98%AF%E5%90%A6-%E5%A4%8D%E5%B8%B8-%E6%9C%89%E5%BE%85%E8%A7%82%E5%AF%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786087003000.webp","sourceId":"rfi"},{"id":1786086760000,"createdDate":"2026-08-07 07:12","name":"法国国际广播电台","title":"2019馀波：香港岭大学生会解散 全港「八大」只馀一家有学生会正常运作","content":"香港各大学学生会在参与2019年社会运动後被迫解散的浪潮持续，有59年历史的岭南大学学生会昨(6日)晚深夜宣布解散，称是在平衡「近年校园内外形势都出现变化」後作出的「艰难决定」，令全港受政府资助的八所大学中，只馀科技大学一家的学生会仍可在校内正常运作。另外，城市大学学生会在不获校方支持後，自行在校园外设会址营运。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260807-2019%E9%A6%80%E6%B3%A2-%E9%A6%99%E6%B8%AF%E5%B2%AD%E5%A4%A7%E5%AD%A6%E7%94%9F%E4%BC%9A%E8%A7%A3%E6%95%A3-%E5%85%A8%E6%B8%AF-%E5%85%AB%E5%A4%A7-%E5%8F%AA%E9%A6%80%E4%B8%80%E5%AE%B6%E6%9C%89%E5%AD%A6%E7%94%9F%E4%BC%9A%E6%AD%A3%E5%B8%B8%E8%BF%90%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/07/1786086760000.webp","sourceId":"rfi"}]