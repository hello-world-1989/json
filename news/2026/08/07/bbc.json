[{"id":1786071000000,"createdDate":"2026-08-07 02:50","name":"英国广播公司","title":"特朗普簽署新行政命令 試圖重新限制美國出生公民權","content":"美國總統特朗普（川普）簽署行政命令，禁止生育旅遊，並擴大了對不符合美國出生公民權資格的兒童的定義。","newsLink":"https://www.bbc.com/zhongwen/articles/c1e1v7gxwzdo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/07/1786071000000.webp","sourceId":"bbc"},{"id":1786061206000,"createdDate":"2026-08-07 00:06","name":"英国广播公司","title":"一半疫苗被丟棄讓人不解，免冷藏版本有望減少浪費","content":"英國科學家首次成功人體試驗免冷藏疫苗，可在室溫保存，有望在全球範圍大幅減少因冷鏈失效而被浪費掉的防疫靈丹。","newsLink":"https://www.bbc.com/zhongwen/articles/cp9ekjrznngo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/07/1786061206000.webp","sourceId":"bbc"},{"id":1786061199000,"createdDate":"2026-08-07 00:06","name":"英国广播公司","title":"歐洲乾旱與河流乾涸：炸彈、戰艦殘骸、猛獁象骨骸重見天日","content":"歐洲各地的極端高溫和乾旱揭示了從納粹戰艦到古代猛獁象骨頭甚至被遺忘的修道院等歷史遺跡。流經19個國家的多瑙河流域的水位已降至30年來的最低水位。","newsLink":"https://www.bbc.com/zhongwen/articles/c86n5vgell5o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/07/1786061199000.webp","sourceId":"bbc"},{"id":1786098850000,"createdDate":"2026-08-07 10:34","name":"英国广播公司","title":"泰國校園槍擊案至少七人死亡 槍手同告斃命","content":"曼谷西北面市郊一家學校發生槍擊事件，一名14歲該校男生逞兇後自盡。當局發現他事前先殺害了自己的祖父母。","newsLink":"https://www.bbc.com/zhongwen/articles/cn8n2yxew0eo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/07/1786098850000.webp","sourceId":"bbc"},{"id":1786094688000,"createdDate":"2026-08-07 09:24","name":"英国广播公司","title":"人工智能被用於設計全新病毒","content":"科學家利用人工智慧設計了16種成功的病毒，這些病毒的基因序列都是由人工智慧設計的。","newsLink":"https://www.bbc.com/zhongwen/articles/crrvndrv1pyo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/08/07/1786094688000.webp","sourceId":"bbc"},{"id":1786074234000,"createdDate":"2026-08-07 03:43","name":"英国广播公司","title":"「免冷藏」疫苗首次人體實驗，可望減少浪費","content":"英國科學家首次成功人體試驗免冷藏疫苗，可在室溫保存，有望在全球範圍大幅減少因冷鏈失效而被浪費掉的防疫靈丹。","newsLink":"https://www.b