[{"id":1785897616000,"createdDate":"2026-08-05 02:40","name":"法国国际广播电台","title":"在中国：人工智能正在摧毁越来越多的工作岗位，而政府的反应却畏首畏尾","content":"在中国，人工智能的大规模应用扰乱了本已脆弱的劳动力市场。数千万工人被迫放弃稳定的工作，转而从事不稳定的就业，政府正在制定以人为本的新指导方针。外媒指出，在中国：人工智能正在摧毁越来越多的工作岗位，而政府的反应却畏首畏尾","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260805-%E5%9C%A8%E4%B8%AD%E5%9B%BD-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%AD%A3%E5%9C%A8%E6%91%A7%E6%AF%81%E8%B6%8A%E6%9D%A5%E8%B6%8A%E5%A4%9A%E7%9A%84%E5%B7%A5%E4%BD%9C%E5%B2%97%E4%BD%8D%EF%BC%8C%E8%80%8C%E6%94%BF%E5%BA%9C%E7%9A%84%E5%8F%8D%E5%BA%94%E5%8D%B4%E7%95%8F%E9%A6%96%E7%95%8F%E5%B0%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785897616000.webp","sourceId":"rfi"},{"id":1785926767000,"createdDate":"2026-08-05 10:46","name":"法国国际广播电台","title":"便携式空调：中国手中与欧盟贸易博弈的最新王牌 ;《奥德赛》今夏当之无愧的明星","content":"大家好，周三8月5日出刊的法国全国性日报的头版焦点不尽相同。《费加罗报》与《解放报》关注明年总统大选右翼与极右翼候选人在夏天的宣传活动。与此同时，克里斯托弗·诺兰执导的《奥德赛》燃起法国观众和舆论的热情，成为《回声报》和《十字架报》封面探讨重点之一。中国方面的报道则见于《解放报》国际版。据该报道称，趁着酷暑空调短缺之机，中国正大举进军欧洲市场。对中国而言，空调出口欧洲的成功来得正是时候。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260805-%E4%BE%BF%E6%90%BA%E5%BC%8F%E7%A9%BA%E8%B0%83-%E4%B8%AD%E5%9B%BD%E6%89%8B%E4%B8%AD%E4%B8%8E%E6%AC%A7%E7%9B%9F%E8%B4%B8%E6%98%93%E5%8D%9A%E5%BC%88%E7%9A%84%E6%9C%80%E6%96%B0%E7%8E%8B%E7%89%8C-%E5%A5%A5%E5%BE%B7%E8%B5%9B-%E4%BB%8A%E5%A4%8F%E5%BD%93%E4%B9%8B%E6%97%A0%E6%84%A7%E7%9A%84%E6%98%8E%E6%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785926767000.webp","sourceId":"rfi"},{"id":1785926442000,"createdDate":"2026-08-05 10:40","name":"法国国际广播电台","title":"五角大楼据报正起草新战略 强调在与中俄爆发地区冲突时或动用短程战术武器","content":"据美国全国广播公司（NBC）援引五位知情人士报导称，美国战争部负责政策事务的副部长科尔比（ElbridgeColby）正在主持起草一项新的核战略，该战略强调在与中国或俄罗斯爆发地区冲突时，可能动用短程战术武器。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260805-%E4%BA%94%E8%A7%92%E5%A4%A7%E6%A5%BC%E6%8D%AE%E6%8A%A5%E6%AD%A3%E8%B5%B7%E8%8D%89%E6%96%B0%E6%88%98%E7%95%A5-%E5%BC%BA%E8%B0%83%E5%9C%A8%E4%B8%8E%E4%B8%AD%E4%BF%84%E7%88%86%E5%8F%91%E5%9C%B0%E5%8C%BA%E5%86%B2%E7%AA%81%E6%97%B6%E6%88%96%E5%8A%A8%E7%94%A8%E7%9F%AD%E7%A8%8B%E6%88%98%E6%9C%AF%E6%AD%A6%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785926442000.webp","sourceId":"rfi"},{"id":1785925373000,"createdDate":"2026-08-05 10:22","name":"法国国际广播电台","title":"《唯红花绽放》禁书在港遭查再掀台湾「撑香港」声音，但为何这次却引发港台网友论战","content":"从独立书店拟印制衣服贩售、绿营政要作为政治标语，到乐团演唱会的大萤幕巨字，台湾人用「我是书店店员」六字撑香港。但有些港人感到被支持，有些却感到被消费，港台两地为「声援还是消费」吵得不可开交。在反修例运动过去七年，台港两地的命运轨迹已截然不同。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260805-%E5%94%AF%E7%BA%A2%E8%8A%B1%E7%BB%BD%E6%94%BE-%E7%A6%81%E4%B9%A6%E5%9C%A8%E6%B8%AF%E9%81%AD%E6%9F%A5%E5%86%8D%E6%8E%80%E5%8F%B0%E6%B9%BE-%E6%92%91%E9%A6%99%E6%B8%AF-%E5%A3%B0%E9%9F%B3%EF%BC%8C%E4%BD%86%E4%B8%BA%E4%BD%95%E8%BF%99%E6%AC%A1%E5%8D%B4%E5%BC%95%E5%8F%91%E6%B8%AF%E5%8F%B0%E7%BD%91%E5%8F%8B%E8%AE%BA%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785925373000.webp","sourceId":"rfi"},{"id":1785924989000,"createdDate":"2026-08-05 10:16","name":"法国国际广播电台","title":"三星电子和SK海力士已测试中微公司芯片制造设备近两年 考虑用于在华工厂","content":"据路透社援引三位知情人士报导称，韩企三星电子和SK海力士正在评估中国微观加工高端设备公司中微公司（AMEC）的芯片制造设备，考虑将其用于各自在华工厂；此举旨在应对美国出口管制可能收紧的风险。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260805-%E4%B8%89%E6%98%9F%E7%94%B5%E5%AD%90%E5%92%8Csk%E6%B5%B7%E5%8A%9B%E5%A3%AB%E5%B7%B2%E6%B5%8B%E8%AF%95%E4%B8%AD%E5%BE%AE%E5%85%AC%E5%8F%B8%E8%8A%AF%E7%89%87%E5%88%B6%E9%80%A0%E8%AE%BE%E5%A4%87%E8%BF%91%E4%B8%A4%E5%B9%B4-%E8%80%83%E8%99%91%E7%94%A8%E4%BA%8E%E5%9C%A8%E5%8D%8E%E5%B7%A5%E5%8E%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785924989000.webp","sourceId":"rfi"},{"id":1785922463000,"createdDate":"2026-08-05 09:34","name":"法国国际广播电台","title":"台湾调查17家中国企业　涉嫌非法招募高科技人才","content":"台湾调查人员近日针对十七家涉嫌非法招募台湾高科技人才的中国企业展开调查。台湾法务部调查局表示，七月十三日至八月四日期间，在六个地方检察署指挥下，对相关企业同步搜索。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260805-%E5%8F%B0%E6%B9%BE%E8%B0%83%E6%9F%A517%E5%AE%B6%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A-%E6%B6%89%E5%AB%8C%E9%9D%9E%E6%B3%95%E6%8B%9B%E5%8B%9F%E9%AB%98%E7%A7%91%E6%8A%80%E4%BA%BA%E6%89%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785922463000.webp","sourceId":"rfi"},{"id":1785922163000,"createdDate":"2026-08-05 09:29","name":"法国国际广播电台","title":"加州涉绑架、在美警察面前行刑式枪杀案中的被捕嫌疑人首次出庭拒不认罪","content":"涉嫌绑架并杀害一名美国加州奇诺岗男子的在世嫌疑人于当地时间周二上午首次出庭。66岁的薄建全（JianquanBo，音译）在兰乔库卡蒙加的法庭上，就其涉入上周发生的这起致命案件表示不认罪。尽管调查人员指出，是他的哥哥在圣贝纳迪诺县警员面前开枪打死了受害者——60岁的艾克拜尔（ShukurAikebaer）——但薄建全仍面临谋杀罪指控。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260805-%E5%8A%A0%E5%B7%9E%E6%B6%89%E7%BB%91%E6%9E%B6-%E5%9C%A8%E7%BE%8E%E8%AD%A6%E5%AF%9F%E9%9D%A2%E5%89%8D%E8%A1%8C%E5%88%91%E5%BC%8F%E8%B0%8B%E6%9D%80%E6%A1%88%E4%B8%AD%E7%9A%84%E8%A2%AB%E6%8D%95%E5%AB%8C%E7%96%91%E4%BA%BA%E9%A6%96%E6%AC%A1%E5%87%BA%E5%BA%AD%E6%8B%92%E4%B8%8D%E8%AE%A4%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785922163000.webp","sourceId":"rfi"},{"id":1785918896000,"createdDate":"2026-08-05 08:34","name":"法国国际广播电台","title":"凯达格兰论坛迈向第十届 台湾打造非红供应链并聚焦反制中共民促法","content":"凯达格兰论坛于4日在台北举行，此次论坛聚焦在如何对抗中共的民促法，台湾总统赖清德表示，台湾的立场很清楚，不会接受统战渗透和红色恐怖。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260805-%E5%87%AF%E8%BE%BE%E6%A0%BC%E5%85%B0%E8%AE%BA%E5%9D%9B%E8%BF%88%E5%90%91%E7%AC%AC%E5%8D%81%E5%B1%8A-%E5%8F%B0%E6%B9%BE%E6%89%93%E9%80%A0%E9%9D%9E%E7%BA%A2%E4%BE%9B%E5%BA%94%E9%93%BE%E5%B9%B6%E8%81%9A%E7%84%A6%E5%8F%8D%E5%88%B6%E4%B8%AD%E5%85%B1%E6%B0%91%E4%BF%83%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785918896000.webp","sourceId":"rfi"},{"id":1785917755000,"createdDate":"2026-08-05 08:15","name":"法国国际广播电台","title":"乌克兰情报官员称：朝鲜已开始向俄罗斯西部部署导弹部队","content":"路透社援引乌克兰军事情报部门消息称，朝鲜已开始向俄罗斯西部部署一支导弹部队，未来可能配备120枚弹道导弹和6套发射装置，用于支援俄军对乌打击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260805-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%83%85%E6%8A%A5%E5%AE%98%E5%91%98%E7%A7%B0-%E6%9C%9D%E9%B2%9C%E5%B7%B2%E5%BC%80%E5%A7%8B%E5%90%91%E4%BF%84%E7%BD%97%E6%96%AF%E8%A5%BF%E9%83%A8%E9%83%A8%E7%BD%B2%E5%AF%BC%E5%BC%B9%E9%83%A8%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785917755000.webp","sourceId":"rfi"},{"id":1785915687000,"createdDate":"2026-08-05 07:41","name":"法国国际广播电台","title":"专访台湾学者张昱谦：东盟内部如何在中美之间选边站？","content":"近期，东盟外长会议顺利举行，除了讨论东盟共同体建设、区域经济合作等传统议题外，南海局势、海洋合作以及印太地区安全等议题也成为各方关注的焦点。今天，我们特别邀请到淡江大学的学者张昱谦（KennyChang），他同时也是《用地图看懂中国经济》等多本畅销财经图书的作者，Kenny将深入分析当前东盟内部的发展态势，并探讨东盟如何在维护区域稳定、促进经济发展与坚持战略自主之间取得平衡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20260805-%E4%B8%93%E8%AE%BF%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85%E5%BC%A0%E6%98%B1%E8%B0%A6-%E4%B8%9C%E7%9B%9F%E5%86%85%E9%83%A8%E5%A6%82%E4%BD%95%E5%9C%A8%E4%B8%AD%E7%BE%8E%E4%B9%8B%E9%97%B4%E9%80%89%E8%BE%B9%E7%AB%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785915687000.webp","sourceId":"rfi"},{"id":1785913610000,"createdDate":"2026-08-05 07:06","name":"法国国际广播电台","title":"长崎32个原子弹受害组织抗议防卫大臣与高市政权欲否定“无核三原则”","content":"在长崎原子弹爆炸纪念日即将到来之际，鉴于日本防卫大臣小泉进次郎上个月就核武器相关事宜提出有必要进行“不设禁忌的讨论”，长崎的原子弹爆炸受害者团体等8月4日联合发表了抗议声明。抗议声明已于下午通过电子邮件和邮寄方式，送往防卫大臣小泉、首相高市以及各政党代表。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260805-%E9%95%BF%E5%B4%8E32%E4%B8%AA%E5%8E%9F%E5%AD%90%E5%BC%B9%E5%8F%97%E5%AE%B3%E7%BB%84%E7%BB%87%E6%8A%97%E8%AE%AE%E9%98%B2%E5%8D%AB%E5%A4%A7%E8%87%A3%E4%B8%8E%E9%AB%98%E5%B8%82%E6%94%BF%E6%9D%83%E6%AC%B2%E5%90%A6%E5%AE%9A-%E6%97%A0%E6%A0%B8%E4%B8%89%E5%8E%9F%E5%88%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785913610000.webp","sourceId":"rfi"},{"id":1785912958000,"createdDate":"2026-08-05 06:55","name":"法国国际广播电台","title":"不同人权组织齐批港府侵扰儿童权利：国安法系统性侵权丶拖延7年丶缺监察","content":"联合国儿童权利委员会(CRC)将於9月底起一连四天举行会前工作组会议，审议包括香港在内的《儿童权利公约》执行情况，三个国际非政府组织均批评港府有损害儿童权利之嫌，包括延迟向CRC提交报告，以致补救或纠正儿童及青少年被侵权的情况出现13年空窗期；未有按联合国建议成立具法定权力的委员会保障儿童权利，诚意存疑；执行国安法时对儿童及青少年做成系统性侵权，包括集会及结社自由。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260805-%E4%B8%8D%E5%90%8C%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E9%BD%90%E6%89%B9%E6%B8%AF%E5%BA%9C%E4%BE%B5%E6%89%B0%E5%84%BF%E7%AB%A5%E6%9D%83%E5%88%A9-%E5%9B%BD%E5%AE%89%E6%B3%95%E7%B3%BB%E7%BB%9F%E6%80%A7%E4%BE%B5%E6%9D%83%E4%B8%B6%E6%8B%96%E5%BB%B67%E5%B9%B4%E4%B8%B6%E7%BC%BA%E7%9B%91%E5%AF%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785912958000.webp","sourceId":"rfi"},{"id":1785951548000,"createdDate":"2026-08-05 17:39","name":"法国国际广播电台","title":"阿根廷与中国续签货币互换协议","content":"阿根廷中央银行周三宣布，阿根廷和中国已续签一项自2009年起生效的双边货币互换协议五年，金额相当于1300亿元人民币，约合190亿美元。本次协议将合作期限从原本的3年延长至5年。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260805-%E9%98%BF%E6%A0%B9%E5%BB%B7%E4%B8%8E%E4%B8%AD%E5%9B%BD%E7%BB%AD%E7%AD%BE%E8%B4%A7%E5%B8%81%E4%BA%92%E6%8D%A2%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785951548000.webp","sourceId":"rfi"},{"id":1785944394000,"createdDate":"2026-08-05 15:39","name":"法国国际广播电台","title":"涉太阳能电池板与半导体芯片领域 美国拟借“232条款”设多晶硅底价并征税","content":"据路透社周二援引四位知情人士报导称，美国特朗普政府正准备针对多晶硅及相关产品设定最低价格并征收关税；此举将这种对太阳能电池板和半导体至关重要的材料，置于美国在人工智能和能源领域与中国展开竞争的中心位置。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260805-%E6%B6%89%E5%A4%AA%E9%98%B3%E8%83%BD%E7%94%B5%E6%B1%A0%E6%9D%BF%E4%B8%8E%E5%8D%8A%E5%AF%BC%E4%BD%93%E8%8A%AF%E7%89%87%E9%A2%86%E5%9F%9F-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E5%80%9F-232%E6%9D%A1%E6%AC%BE-%E8%AE%BE%E5%A4%9A%E6%99%B6%E7%A1%85%E5%BA%95%E4%BB%B7%E5%B9%B6%E5%BE%81%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785944394000.webp","sourceId":"rfi"},{"id":1785942430000,"createdDate":"2026-08-05 15:07","name":"法国国际广播电台","title":"4吨重的SpaceX残片撞击月球后果如何？","content":"一块SpaceX火箭残骸自去年以来一直在太空中漂浮，预计它将于周三（8月5日）清晨高速撞击月球，但至少在几个小时后才可能确认这次撞击事件。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260805-4%E5%90%A8%E9%87%8D%E7%9A%84spacex%E7%81%AB%E7%AE%AD%E6%AE%8B%E9%AA%B8%E6%92%9E%E5%87%BB%E6%9C%88%E7%90%83%E5%90%8E%E6%9E%9C%E5%A6%82%E4%BD%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785942430000.webp","sourceId":"rfi"},{"id":1785941132000,"createdDate":"2026-08-05 14:45","name":"法国国际广播电台","title":"俄无人机制造商座驾发生汽车爆炸 保镖兼司机死亡 CEO重伤","content":"据塔斯社报导，俄罗斯无人机制造商Uraldronzavod首席执行官的一名保镖在叶卡捷琳堡的一起汽车爆炸中丧生。紧急救援部门证实了这一消息。该机构的消息人士称：“司机同时也是一名保镖，爆炸发生时他就在车里，不幸身亡”。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260805-%E4%BF%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%88%B6%E9%80%A0%E5%95%86%E5%BA%A7%E9%A9%BE%E5%8F%91%E7%94%9F%E6%B1%BD%E8%BD%A6%E7%88%86%E7%82%B8-%E4%BF%9D%E9%95%96%E5%85%BC%E5%8F%B8%E6%9C%BA%E6%AD%BB%E4%BA%A1-ceo%E9%87%8D%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785941132000.webp","sourceId":"rfi"},{"id":1785939722000,"createdDate":"2026-08-05 14:22","name":"法国国际广播电台","title":"境外收入征税 知情人士称一些案例中倒查跨度超过25年","content":"据英国《金融时报》报导，中国已发起一场全球范围的追缴行动，旨在追回数十年来积欠的数千亿美元税款，北京方面正通过瞄准超级富豪群体，以填补日益扩大的财政缺口。监管部门已加强了对海外资本利得及投资的审查——在一些案例中，追溯期甚至可回溯至2000年——而这一行动开展的同时，北京方面也在寻求大幅加强对资本外流的管控。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260805-%E5%A2%83%E5%A4%96%E6%94%B6%E5%85%A5%E5%BE%81%E7%A8%8E-%E7%9F%A5%E6%83%85%E4%BA%BA%E5%A3%AB%E7%A7%B0%E4%B8%80%E4%BA%9B%E6%A1%88%E4%BE%8B%E4%B8%AD%E5%80%92%E6%9F%A5%E8%B7%A8%E5%BA%A6%E8%B6%85%E8%BF%8725%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785939722000.webp","sourceId":"rfi"},{"id":1785935823000,"createdDate":"2026-08-05 13:17","name":"法国国际广播电台","title":"中国商务部连发4条涉美公告和部令 发言人指中方不排除将进一步反制","content":"中国商务部周三宣布，禁止国内机构和个人与七家美国实体进行业务往来，收紧对出口至美国的无人机及相关技术的管制，并限制美国机构参与中国工厂的强制性认证检查。中方表示，此举是对美方近期针对中国电信运营商、检测实验室、无人机、消费级路由器、海底光缆、先进机器人设备及逆变器实施限制措施的回应。此外，中方还提及了美方上周将40多家中国实体列入《防止强迫维吾尔人劳动法》实体清单一事。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260805-%E4%B8%AD%E5%9B%BD%E5%95%86%E5%8A%A1%E9%83%A8%E8%BF%9E%E5%8F%914%E6%9D%A1%E6%B6%89%E7%BE%8E%E5%85%AC%E5%91%8A%E5%92%8C%E9%83%A8%E4%BB%A4-%E5%8F%91%E8%A8%80%E4%BA%BA%E6%8C%87%E4%B8%AD%E6%96%B9%E4%B8%8D%E6%8E%92%E9%99%A4%E5%B0%86%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%8F%8D%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785935823000.webp","sourceId":"rfi"},{"id":1785932423000,"createdDate":"2026-08-05 12:20","name":"法国国际广播电台","title":"加拿大总理卡尼支持度大幅领先对手 民众普遍支持强硬应对特朗普要挟","content":"在过去两周，美国总统特朗普不断重提要对加拿大再加征关税，就在这段期间，加拿大民调机构NanosResearch做了一次全国性调查，结果显示，外部经济压力并未削弱联邦政府的威信，反而促使加国选民更支持总理马克·卡尼（MarkCarney）及执政自由党；同时，绝大多数加拿大人明确拒绝向美方妥协，主张采取强硬立场（ElbowUp）。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260805-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%80%BB%E7%90%86%E5%8D%A1%E5%B0%BC%E6%94%AF%E6%8C%81%E5%BA%A6%E5%A4%A7%E5%B9%85%E9%A2%86%E5%85%88%E5%AF%B9%E6%89%8B-%E6%B0%91%E4%BC%97%E6%99%AE%E9%81%8D%E6%94%AF%E6%8C%81%E5%BC%BA%E7%A1%AC%E5%BA%94%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E6%8C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785932423000.webp","sourceId":"rfi"},{"id":1785932180000,"createdDate":"2026-08-05 12:16","name":"法国国际广播电台","title":"曾自首的国家国防科工局原副局长张建华一审判囚10年","content":"官媒新华社报导指，8月5日，四川省达州市中级人民法院一审公开宣判国家国防科技工业局原党组成员、副局长张建华受贿、利用影响力受贿案，对被告人张建华以受贿罪判处有期徒刑八年，并处罚金人民币三百万元，以利用影响力受贿罪判处有期徒刑五年，并处罚金人民币八十万元，决定执行有期徒刑十年，并处罚金人民币三百八十万元。对张建华犯罪所得财物及孳息依法予以追缴，上缴国库。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260805-%E6%9B%BE%E8%87%AA%E9%A6%96%E7%9A%84%E5%9B%BD%E9%98%B2%E7%A7%91%E5%B7%A5%E5%B1%80%E5%8E%9F%E5%89%AF%E5%B1%80%E9%95%BF%E5%BC%A0%E5%BB%BA%E5%8D%8E%E4%B8%80%E5%AE%A1%E5%88%A4%E5%9B%9A10%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785932180000.webp","sourceId":"rfi"},{"id":1785930541000,"createdDate":"2026-08-05 11:49","name":"法国国际广播电台","title":"朝鲜罕见官方画面：酷暑中民众在水上乐园和海滩娱乐","content":"朝鲜国家电视台KRT于8月2日（星期日）播放了画面，显示热浪席卷朝鲜半岛大部分地区，民众涌向各地的海滩和水上乐园避暑。香港《南华早报》报道称，朝鲜官方媒体也推荐“狗肉汤”作为消暑良方。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260805-%E6%9C%9D%E9%B2%9C%E7%BD%95%E8%A7%81%E5%AE%98%E6%96%B9%E7%94%BB%E9%9D%A2-%E9%85%B7%E6%9A%91%E4%B8%AD%E6%B0%91%E4%BC%97%E5%9C%A8%E6%B0%B4%E4%B8%8A%E4%B9%90%E5%9B%AD%E5%92%8C%E6%B5%B7%E6%BB%A9%E5%A8%B1%E4%B9%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785930541000.webp","sourceId":"rfi"},{"id":1785930029000,"createdDate":"2026-08-05 11:40","name":"法国国际广播电台","title":"擅闯中使馆的日本自卫官陈述动机 称望中方转变对日强硬外交方针","content":"现年24岁的日本陆上自卫官村田晃大因闯入位于东京都港区的中国驻日大使馆等犯罪嫌疑而被起诉，8月5日，东京地方法院进行了向其说明羁押理由的程序。据日本放送协会（NHK）报导，村田在谈及事件动机时表示：“我内心一直认为，中国对日本采取的强硬外交方针应该得到改变”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260805-%E6%93%85%E9%97%AF%E4%B8%AD%E4%BD%BF%E9%A6%86%E7%9A%84%E6%97%A5%E6%9C%AC%E8%87%AA%E5%8D%AB%E5%AE%98%E9%99%88%E8%BF%B0%E5%8A%A8%E6%9C%BA-%E7%A7%B0%E5%B8%8C%E6%9C%9B%E4%B8%AD%E6%96%B9%E8%BD%AC%E5%8F%98%E5%AF%B9%E6%97%A5%E5%A4%96%E4%BA%A4%E6%96%B9%E9%92%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785930029000.webp","sourceId":"rfi"},{"id":1785927611000,"createdDate":"2026-08-05 11:00","name":"法国国际广播电台","title":"因凡蒂诺陷领导危机　FIFA高层摩洛哥召开紧急会议","content":"国际足球总会，也就是FIFA，主席因凡蒂诺周三在摩洛哥召开危机会议，试图平息一场可能动摇其连任前景的政治风暴。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E4%BD%93%E8%82%B2/20260805-%E5%9B%A0%E5%87%A1%E8%92%82%E8%AF%BA%E9%99%B7%E9%A2%86%E5%AF%BC%E5%8D%B1%E6%9C%BA-fifa%E9%AB%98%E5%B1%82%E6%91%A9%E6%B4%9B%E5%93%A5%E5%8F%AC%E5%BC%80%E7%B4%A7%E6%80%A5%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785927611000.webp","sourceId":"rfi"},{"id":1785963529000,"createdDate":"2026-08-05 20:58","name":"法国国际广播电台","title":"日本最新研究：看运动比赛能降低老年忧郁症风险","content":"日本最新研究证实，每周1次从电视上观看运动比赛，可降29%忧郁风险、每月1至3次亲临现场观赛，则可降低34%忧郁风险。这可能与刺激多巴胺分泌有关。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260805-%E6%97%A5%E6%9C%AC%E6%9C%80%E6%96%B0%E7%A0%94%E7%A9%B6-%E7%9C%8B%E8%BF%90%E5%8A%A8%E6%AF%94%E8%B5%9B%E8%83%BD%E9%99%8D%E4%BD%8E%E8%80%81%E5%B9%B4%E5%BF%A7%E9%83%81%E7%97%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785963529000.webp","sourceId":"rfi"},{"id":1785963104000,"createdDate":"2026-08-05 20:51","name":"法国国际广播电台","title":"伊朗与阿曼就霍尔木兹海峡新航线达成协议","content":"伊朗周三宣布，已与阿曼就一条途经霍尔木兹海峡的新航线达成协议。霍尔木兹海峡是伊朗和阿曼两国接壤的海峡，也是伊朗与美国紧张关系的核心所在。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260805-%E4%BC%8A%E6%9C%97%E4%B8%8E%E9%98%BF%E6%9B%BC%E5%B0%B1%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%96%B0%E8%88%AA%E7%BA%BF%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785963104000.webp","sourceId":"rfi"},{"id":1785962965000,"createdDate":"2026-08-05 20:49","name":"法国国际广播电台","title":"加拿大总理公开挑战国际足联主席信誉","content":"加拿大总理马克·卡尼周三表示，他对国际足联主席詹尼·因凡蒂诺“毫无信心”。因凡蒂诺此前试图向私人投资者开放国际足联，但最终失败，导致其领导地位削弱。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260805-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%80%BB%E7%90%86%E5%85%AC%E5%BC%80%E6%8C%91%E6%88%98%E5%9B%BD%E9%99%85%E8%B6%B3%E8%81%94%E4%B8%BB%E5%B8%AD%E4%BF%A1%E8%AA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785962965000.webp","sourceId":"rfi"},{"id":1785962826000,"createdDate":"2026-08-05 20:47","name":"法国国际广播电台","title":"内政部长：无人机事件表明德国面临新的威胁","content":"至少一架携带爆炸装置的无人机引发的事件导致德国莱比锡机场的空中交通暂时中断，德国已开始展开恐怖袭击调查。德国内政部长表示，在莱比锡机场发现一架无人机代表着“新的威胁维度”，这种威胁可能涉及“外国势力”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260805-%E5%86%85%E6%94%BF%E9%83%A8%E9%95%BF-%E6%97%A0%E4%BA%BA%E6%9C%BA%E4%BA%8B%E4%BB%B6%E8%A1%A8%E6%98%8E%E5%BE%B7%E5%9B%BD%E9%9D%A2%E4%B8%B4%E6%96%B0%E7%9A%84%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785962826000.webp","sourceId":"rfi"},{"id":1785962615000,"createdDate":"2026-08-05 20:43","name":"法国国际广播电台","title":"金与正指责日本已转变为“好战国家”","content":"朝鲜领导人金正恩的胞妹金与正（KimYoJong）周三指责日本正在转变为“好战国家”，而东京方面前一天则表示，加强日本军力已变得“迫在眉睫”。金与正通过朝中社发表声明称，朝鲜“领导人将采取更多军事选项，这显然是日本转变的后果”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260805-%E9%87%91%E4%B8%8E%E6%AD%A3%E6%8C%87%E8%B4%A3%E6%97%A5%E6%9C%AC%E5%B7%B2%E8%BD%AC%E5%8F%98%E4%B8%BA-%E5%A5%BD%E6%88%98%E5%9B%BD%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785962615000.webp","sourceId":"rfi"},{"id":1785962473000,"createdDate":"2026-08-05 20:41","name":"法国国际广播电台","title":"法国小说家迪迪埃·德库安（Didier Decoin）离世","content":"法国作家兼编剧迪迪埃·德库安（DidierDecoin）于周三去世，享年81岁。他一生致力于小说创作，《地狱约翰》小说荣获龚古尔文学奖，此外他还为电影和电视剧撰写剧本。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260805-%E6%B3%95%E5%9B%BD%E5%B0%8F%E8%AF%B4%E5%AE%B6%E8%BF%AA%E8%BF%AA%E5%9F%83%C2%B7%E5%BE%B7%E5%BA%93%E5%AE%89-didier-decoin-%E7%A6%BB%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785962473000.webp","sourceId":"rfi"},{"id":1785962217000,"createdDate":"2026-08-05 20:36","name":"法国国际广播电台","title":"韩国警察突查星巴克总部取证","content":"据法新社报道，星巴克韩国运营商透露，韩国警方周三突击搜查了星巴克韩国总部。此前，星巴克因一则广告被指诽谤在1980年韩国民主运动中遇难的活动人士而引发争议。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260805-%E9%9F%A9%E5%9B%BD%E8%AD%A6%E5%AF%9F%E7%AA%81%E6%9F%A5%E6%98%9F%E5%B7%B4%E5%85%8B%E6%80%BB%E9%83%A8%E5%8F%96%E8%AF%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785962217000.webp","sourceId":"rfi"},{"id":1785961866000,"createdDate":"2026-08-05 20:31","name":"法国国际广播电台","title":"电动汽车：若欧洲继续依赖中国电池   将损失105亿欧元利润","content":"欧洲制造商若继续依赖包括中国在内的亚洲市场供应电池，到2030年将损失105亿欧元利润。应对这一问题的唯一途径是自主生产电动汽车的关键部件——电池。如果没有本土工厂，预计到2030年，欧洲在电池生产方面将损失高达105亿欧元的利润。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260805-%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6-%E8%8B%A5%E6%AC%A7%E6%B4%B2%E7%BB%A7%E7%BB%AD%E4%BE%9D%E8%B5%96%E4%B8%AD%E5%9B%BD%E7%94%B5%E6%B1%A0-%E5%B0%86%E6%8D%9F%E5%A4%B1105%E4%BA%BF%E6%AC%A7%E5%85%83%E5%88%A9%E6%B6%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785961866000.webp","sourceId":"rfi"},{"id":1785961597000,"createdDate":"2026-08-05 20:26","name":"法国国际广播电台","title":"马赛毒枭拉里比（Mehdi Laribi）在阿尔及利亚落网","content":"据法国司法部长杰拉尔德·达尔马宁（GéraldDarmanin）称，涉嫌担任DZ黑手党犯罪组织头目的迈赫迪·拉里比（MehdiLaribi）于7月下旬在阿尔及利亚被捕。法国当局根据逮捕令将其列为“优先缉拿目标”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260805-%E9%A9%AC%E8%B5%9B%E6%AF%92%E6%9E%AD%E6%8B%89%E9%87%8C%E6%AF%94-mehdi-laribi-%E5%9C%A8%E9%98%BF%E5%B0%94%E5%8F%8A%E5%88%A9%E4%BA%9A%E8%90%BD%E7%BD%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785961597000.webp","sourceId":"rfi"},{"id":1785960427000,"createdDate":"2026-08-05 20:07","name":"法国国际广播电台","title":"能捕食动物肉的植物在中国被发现","content":"能捕食动物肉的植物在中国被发现。中国科学家领衔在青藏高原发现一种开花植物——灯架虎耳草，被研究确认为一个新的食虫植物谱系，实证存在食肉植物类型。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260805-%E8%83%BD%E6%8D%95%E9%A3%9F%E5%8A%A8%E7%89%A9%E8%82%89%E7%9A%84%E6%A4%8D%E7%89%A9%E5%9C%A8%E4%B8%AD%E5%9B%BD%E8%A2%AB%E5%8F%91%E7%8E%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785960427000.webp","sourceId":"rfi"},{"id":1785958072000,"createdDate":"2026-08-05 19:27","name":"法国国际广播电台","title":"俄近30枚导弹炸基辅 “爱国者”防空导弹议题变中有变","content":"俄罗斯于4日夜间至5日凌晨对乌克兰首都基辅及周边地区发射数十枚弹道导弹，造成至少17人死亡，并摧毁了多家大型零售商的仓库和物流中心。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260805-%E4%BF%84%E8%BF%9130%E6%9E%9A%E5%AF%BC%E5%BC%B9%E7%82%B8%E5%9F%BA%E8%BE%85-%E7%88%B1%E5%9B%BD%E8%80%85-%E9%98%B2%E7%A9%BA%E5%AF%BC%E5%BC%B9%E8%AE%AE%E9%A2%98%E5%8F%98%E4%B8%AD%E6%9C%89%E5%8F%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/05/1785958072000.webp","sourceId":"rfi"}]