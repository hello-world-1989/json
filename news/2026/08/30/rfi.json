[{"id":1788098067000,"createdDate":"2026-08-30 13:54","name":"法国国际广播电台","title":"俄罗斯“非洲军团”协助尼日尔军政府平息兵变","content":"尼日尔军政府周六在俄罗斯伙伴的协助下平息了一场兵变，此前，该国首都尼亚美的一处重要军事基地已被夺回，该地自周五深夜至周六凌晨一直战况激烈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E4%BF%84%E7%BD%97%E6%96%AF-%E9%9D%9E%E6%B4%B2%E5%86%9B%E5%9B%A2-%E5%8D%8F%E5%8A%A9%E5%B0%BC%E6%97%A5%E5%B0%94%E5%86%9B%E6%94%BF%E5%BA%9C%E5%B9%B3%E6%81%AF%E5%85%B5%E5%8F%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788098067000.webp","sourceId":"rfi"},{"id":1788094793000,"createdDate":"2026-08-30 12:59","name":"法国国际广播电台","title":"中国公布261名外国失踪人员国籍包括两名法国人","content":"中国央视（CCTV）周日报道，喜马拉雅山毁灭性洪灾在中国一侧死亡人数已升至16人，另有546人，包括两名法国人，仍下落不明。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%B8%83261%E5%90%8D%E5%A4%96%E5%9B%BD%E5%A4%B1%E8%B8%AA%E4%BA%BA%E5%91%98%E5%9B%BD%E7%B1%8D%E5%8C%85%E6%8B%AC%E4%B8%A4%E5%90%8D%E6%B3%95%E5%9B%BD%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788094793000.webp","sourceId":"rfi"},{"id":1788092797000,"createdDate":"2026-08-30 12:26","name":"法国国际广播电台","title":"喜马拉雅洪灾遇难者升至约750人 尼泊尔开始掩埋 急需冻柜及DNA试剂盒","content":"法新社8月30日综述喜马拉雅洪灾的最新进展说，根据中尼两国当局公布的最新信息，目前死亡人数至少为750人，其中尼泊尔境内734人，中国西藏地区16人。失踪人数为3044人，其中尼泊尔境内2498人，中国境内546人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E6%B4%AA%E7%81%BE%E9%81%87%E9%9A%BE%E8%80%85%E5%8D%87%E8%87%B3%E7%BA%A6750%E4%BA%BA-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%BC%80%E5%A7%8B%E6%8E%A9%E5%9F%8B-%E6%80%A5%E9%9C%80%E5%86%BB%E6%9F%9C%E5%8F%8Adna%E8%AF%95%E5%89%82%E7%9B%92","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788092797000.webp","sourceId":"rfi"},{"id":1788091380000,"createdDate":"2026-08-30 12:03","name":"法国国际广播电台","title":"世界报论坛：「极地丝绸之路」非商业突破 应被视为揭示中国雄心的对冲战略","content":"中国刚刚开通了一条通过北极通往欧洲的新海上丝绸之路。在《世界报》周末版（8月29-30日）的一篇评论文章中，西班牙经济学家阿丽西亚·加西亚·埃雷罗（AliciaGarciaHerrero）分析了北京的这项战略。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260830-%E4%B8%96%E7%95%8C%E6%8A%A5%E8%AE%BA%E5%9D%9B-%E6%9E%81%E5%9C%B0%E4%B8%9D%E7%BB%B8%E4%B9%8B%E8%B7%AF-%E9%9D%9E%E5%95%86%E4%B8%9A%E7%AA%81%E7%A0%B4-%E5%BA%94%E8%A2%AB%E8%A7%86%E4%B8%BA%E6%8F%AD%E7%A4%BA%E4%B8%AD%E5%9B%BD%E9%9B%84%E5%BF%83%E7%9A%84%E5%AF%B9%E5%86%B2%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788091380000.webp","sourceId":"rfi"},{"id":1788080963000,"createdDate":"2026-08-30 09:09","name":"法国国际广播电台","title":"朝鲜军方高层大改组，国防部长努光铁遭解职降级","content":"朝鲜官方通讯社朝中社30日发布消息，宣布军队高层大规模人事调整名单。国防部长努光铁(NoKwangChol)被撤职，并被开除出朝鲜劳动党中央，降级改任“军需工业部”第一副部长。接替他的是朝鲜人民军总政治局局长金成基（KimSong-gi）。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260830-%E6%9C%9D%E9%B2%9C%E5%86%9B%E6%96%B9%E9%AB%98%E5%B1%82%E5%A4%A7%E6%94%B9%E7%BB%84%EF%BC%8C%E5%9B%BD%E9%98%B2%E9%83%A8%E9%95%BF%E5%8A%AA%E5%85%89%E9%93%81%E9%81%AD%E8%A7%A3%E8%81%8C%E9%99%8D%E7%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788080963000.webp","sourceId":"rfi"},{"id":1788078781000,"createdDate":"2026-08-30 08:33","name":"法国国际广播电台","title":"习近平今赴比什凯克出席上合组织峰会：和谐表面下暗流涌动","content":"中国国家主席习近平星期天（8月30日）启程前往比什凯克出席2026年上海合作组织峰会，习近平将在那里会见普京、莫迪和伊朗总统。据法新社指出，上海合作组织是北京希望建立的欧亚集团，旨在制衡西方。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260830-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BB%8A%E8%B5%B4%E6%AF%94%E4%BB%80%E5%87%AF%E5%85%8B%E5%87%BA%E5%B8%AD%E4%B8%8A%E5%90%88%E7%BB%84%E7%BB%87%E5%B3%B0%E4%BC%9A-%E5%92%8C%E8%B0%90%E8%A1%A8%E9%9D%A2%E4%B8%8B%E6%9A%97%E6%B5%81%E6%B6%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788078781000.webp","sourceId":"rfi"},{"id":1788078387000,"createdDate":"2026-08-30 08:26","name":"法国国际广播电台","title":"日本福井普降史上最大暴雨 要求34万人避难","content":"30日早晨，日本福井县福井市、大野市、胜山市这3个市发布了“5级大雨特别警报”，当地观测到创纪录的大雨。在福井县，福井市、大野市、胜山市、芦原市全域，以及鲭江市、坂井市、永平寺町部分地区，共计14万3684户、34万4225人被要求避难。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260830-%E6%97%A5%E6%9C%AC%E7%A6%8F%E4%BA%95%E6%99%AE%E9%99%8D%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E6%9A%B4%E9%9B%A8-%E8%A6%81%E6%B1%8234%E4%B8%87%E4%BA%BA%E9%81%BF%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788078387000.webp","sourceId":"rfi"}]