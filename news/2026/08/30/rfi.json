[{"id":1788098067000,"createdDate":"2026-08-30 13:54","name":"法国国际广播电台","title":"俄罗斯“非洲军团”协助尼日尔军政府平息兵变","content":"尼日尔军政府周六在俄罗斯伙伴的协助下平息了一场兵变，此前，该国首都尼亚美的一处重要军事基地已被夺回，该地自周五深夜至周六凌晨一直战况激烈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E4%BF%84%E7%BD%97%E6%96%AF-%E9%9D%9E%E6%B4%B2%E5%86%9B%E5%9B%A2-%E5%8D%8F%E5%8A%A9%E5%B0%BC%E6%97%A5%E5%B0%94%E5%86%9B%E6%94%BF%E5%BA%9C%E5%B9%B3%E6%81%AF%E5%85%B5%E5%8F%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788098067000.webp","sourceId":"rfi"},{"id":1788094793000,"createdDate":"2026-08-30 12:59","name":"法国国际广播电台","title":"中国公布261名外国失踪人员国籍包括两名法国人","content":"中国央视（CCTV）周日报道，喜马拉雅山毁灭性洪灾在中国一侧死亡人数已升至16人，另有546人，包括两名法国人，仍下落不明。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%B8%83261%E5%90%8D%E5%A4%96%E5%9B%BD%E5%A4%B1%E8%B8%AA%E4%BA%BA%E5%91%98%E5%9B%BD%E7%B1%8D%E5%8C%85%E6%8B%AC%E4%B8%A4%E5%90%8D%E6%B3%95%E5%9B%BD%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788094793000.webp","sourceId":"rfi"},{"id":1788092797000,"createdDate":"2026-08-30 12:26","name":"法国国际广播电台","title":"喜马拉雅洪灾遇难者升至约750人 尼泊尔开始掩埋 急需冻柜及DNA试剂盒","content":"法新社8月30日综述喜马拉雅洪灾的最新进展说，根据中尼两国当局公布的最新信息，目前死亡人数至少为750人，其中尼泊尔境内734人，中国西藏地区16人。失踪人数为3044人，其中尼泊尔境内2498人，中国境内546人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E6%B4%AA%E7%81%BE%E9%81%87%E9%9A%BE%E8%80%85%E5%8D%87%E8%87%B3%E7%BA%A6750%E4%BA%BA-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%BC%80%E5%A7%8B%E6%8E%A9%E5%9F%8B-%E6%80%A5%E9%9C%80%E5%86%BB%E6%9F%9C%E5%8F%8Adna%E8%AF%95%E5%89%82%E7%9B%92","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788092797000.webp","sourceId":"rfi"},{"id":1788091380000,"createdDate":"2026-08-30 12:03","name":"法国国际广播电台","title":"世界报论坛：「极地丝绸之路」非商业突破 应被视为揭示中国雄心的对冲战略","content":"中国刚刚开通了一条通过北极通往欧洲的新海上丝绸之路。在《世界报》周末版（8月29-30日）的一篇评论文章中，西班牙经济学家阿丽西亚·加西亚·埃雷罗（AliciaGarciaHerrero）分析了北京的这项战略。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260830-%E4%B8%96%E7%95%8C%E6%8A%A5%E8%AE%BA%E5%9D%9B-%E6%9E%81%E5%9C%B0%E4%B8%9D%E7%BB%B8%E4%B9%8B%E8%B7%AF-%E9%9D%9E%E5%95%86%E4%B8%9A%E7%AA%81%E7%A0%B4-%E5%BA%94%E8%A2%AB%E8%A7%86%E4%B8%BA%E6%8F%AD%E7%A4%BA%E4%B8%AD%E5%9B%BD%E9%9B%84%E5%BF%83%E7%9A%84%E5%AF%B9%E5%86%B2%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788091380000.webp","sourceId":"rfi"},{"id":1788080963000,"createdDate":"2026-08-30 09:09","name":"法国国际广播电台","title":"朝鲜军方高层大改组，国防部长努光铁遭解职降级","content":"朝鲜官方通讯社朝中社30日发布消息，宣布军队高层大规模人事调整名单。国防部长努光铁(NoKwangChol)被撤职，并被开除出朝鲜劳动党中央，降级改任“军需工业部”第一副部长。接替他的是朝鲜人民军总政治局局长金成基（KimSong-gi）。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260830-%E6%9C%9D%E9%B2%9C%E5%86%9B%E6%96%B9%E9%AB%98%E5%B1%82%E5%A4%A7%E6%94%B9%E7%BB%84%EF%BC%8C%E5%9B%BD%E9%98%B2%E9%83%A8%E9%95%BF%E5%8A%AA%E5%85%89%E9%93%81%E9%81%AD%E8%A7%A3%E8%81%8C%E9%99%8D%E7%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788080963000.webp","sourceId":"rfi"},{"id":1788078781000,"createdDate":"2026-08-30 08:33","name":"法国国际广播电台","title":"习近平今赴比什凯克出席上合组织峰会：和谐表面下暗流涌动","content":"中国国家主席习近平星期天（8月30日）启程前往比什凯克出席2026年上海合作组织峰会，习近平将在那里会见普京、莫迪和伊朗总统。据法新社指出，上海合作组织是北京希望建立的欧亚集团，旨在制衡西方。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260830-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BB%8A%E8%B5%B4%E6%AF%94%E4%BB%80%E5%87%AF%E5%85%8B%E5%87%BA%E5%B8%AD%E4%B8%8A%E5%90%88%E7%BB%84%E7%BB%87%E5%B3%B0%E4%BC%9A-%E5%92%8C%E8%B0%90%E8%A1%A8%E9%9D%A2%E4%B8%8B%E6%9A%97%E6%B5%81%E6%B6%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788078781000.webp","sourceId":"rfi"},{"id":1788078387000,"createdDate":"2026-08-30 08:26","name":"法国国际广播电台","title":"日本福井普降史上最大暴雨 要求34万人避难","content":"30日早晨，日本福井县福井市、大野市、胜山市这3个市发布了“5级大雨特别警报”，当地观测到创纪录的大雨。在福井县，福井市、大野市、胜山市、芦原市全域，以及鲭江市、坂井市、永平寺町部分地区，共计14万3684户、34万4225人被要求避难。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260830-%E6%97%A5%E6%9C%AC%E7%A6%8F%E4%BA%95%E6%99%AE%E9%99%8D%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E6%9A%B4%E9%9B%A8-%E8%A6%81%E6%B1%8234%E4%B8%87%E4%BA%BA%E9%81%BF%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788078387000.webp","sourceId":"rfi"},{"id":1788111349000,"createdDate":"2026-08-30 17:35","name":"法国国际广播电台","title":"瑞士狂欢派对爆枪击1死5伤  警方全面出动追捕嫌凶","content":"周日，瑞士各地警方全面出动，试图缉拿一名嫌凶，此人在周六深夜至周日凌晨于苏黎世附近的阿劳一场狂欢派对上开枪射击、导致一名意大利年轻女子死亡、五人受伤。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E7%91%9E%E5%A3%AB%E7%8B%82%E6%AC%A2%E6%B4%BE%E5%AF%B9%E7%88%86%E6%9E%AA%E5%87%BB1%E6%AD%BB5%E4%BC%A4-%E8%AD%A6%E6%96%B9%E5%85%A8%E9%9D%A2%E5%87%BA%E5%8A%A8%E8%BF%BD%E6%8D%95%E5%AB%8C%E5%87%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788111349000.webp","sourceId":"rfi"},{"id":1788109281000,"createdDate":"2026-08-30 17:01","name":"法国国际广播电台","title":"俄罗斯称正准备对乌克兰“能源领域”发动“大规模打击”","content":"法新社8月30日莫斯科消息，在过去数月袭击明显加剧的背景下，俄罗斯周日宣布正准备对乌克兰的“能源设施”发动“大规模打击”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A7%B0%E6%AD%A3%E5%87%86%E5%A4%87%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0-%E8%83%BD%E6%BA%90%E9%A2%86%E5%9F%9F-%E5%8F%91%E5%8A%A8-%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%89%93%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788109281000.webp","sourceId":"rfi"},{"id":1788107599000,"createdDate":"2026-08-30 16:33","name":"法国国际广播电台","title":"冰岛公投结果出炉：拒绝重启加入欧盟谈判","content":"冰岛周六的公投否决了重启加入欧盟谈判的提议，这对欢迎冰岛入盟的布鲁塞尔来说，无疑是一记重击。对于自1995年以来就未曾吸纳过富裕国家加入的欧盟而言，冰岛的加入本可成为一个积极示范窗口，召唤富裕的挪威，同时也能帮助欧盟扩大在北极地区的表态权与存在感。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-%E5%86%B0%E5%B2%9B%E5%85%AC%E6%8A%95%E7%BB%93%E6%9E%9C%E5%87%BA%E7%82%89-%E6%8B%92%E7%BB%9D%E9%87%8D%E5%90%AF%E5%8A%A0%E5%85%A5%E6%AC%A7%E7%9B%9F%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788107599000.webp","sourceId":"rfi"},{"id":1788105006000,"createdDate":"2026-08-30 15:50","name":"法国国际广播电台","title":"NASA“罗曼”太空望远镜正式发射 将绘制新的“宇宙图鉴”","content":"美国宇航局（NASA）周日发射了“罗曼”太空望远镜，该望远镜旨在绘制宇宙地图。这项历时数年的任务旨在揭开一些最重大的物理谜团。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260830-nasa-%E7%BD%97%E6%9B%BC-%E5%A4%AA%E7%A9%BA%E6%9C%9B%E8%BF%9C%E9%95%9C%E6%AD%A3%E5%BC%8F%E5%8F%91%E5%B0%84-%E5%B0%86%E7%BB%98%E5%88%B6%E6%96%B0%E7%9A%84-%E5%AE%87%E5%AE%99%E5%9B%BE%E9%89%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788105006000.webp","sourceId":"rfi"},{"id":1788100626000,"createdDate":"2026-08-30 14:37","name":"法国国际广播电台","title":"太平洋岛国论坛开幕：大国竞争背景下的中台角力","content":"2026太平洋岛国论坛30日在帕劳开幕。如果说尽管有北京当局的一再阻挠，台湾中华民国仍得以应邀出席这次论坛活动无疑是台湾的一项外交胜利的话，随着中美两大国全面战略竞争日益激烈，台海两岸的外交角力也日渐成为太平洋地区牵扯多国利益的多国实力博弈中的一环。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260830-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E8%AE%BA%E5%9D%9B%E5%BC%80%E5%B9%95-%E5%A4%A7%E5%9B%BD%E7%AB%9E%E4%BA%89%E8%83%8C%E6%99%AF%E4%B8%8B%E7%9A%84%E4%B8%AD%E5%8F%B0%E8%A7%92%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/30/1788100626000.webp","sourceId":"rfi"}]