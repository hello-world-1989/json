[{"id":1787362219000,"createdDate":"2026-08-22 01:30","name":"法国国际广播电台","title":"你如何被人工智能利用 ，而不是你利用它","content":"各位听众，针对管理学上的研究，加拿大作家科里·多克托罗在一篇文章中指出，人工智能的真正问题可能不在于它能做什么，而在于它让工人做什么。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E4%BD%A0%E5%A6%82%E4%BD%95%E8%A2%AB%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%88%A9%E7%94%A8-%EF%BC%8C%E8%80%8C%E4%B8%8D%E6%98%AF%E4%BD%A0%E5%88%A9%E7%94%A8%E5%AE%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787362219000.webp","sourceId":"rfi"},{"id":1787357958000,"createdDate":"2026-08-22 00:19","name":"法国国际广播电台","title":"从海外信托到新加坡：中国富豪面临新的财富风险","content":"法国世界报刊出的一篇文章表示，中国政府正在加强对海外资产和超级富豪的税务监管。面对不断扩大的财政赤字，中国政府希望通过加强征税，增加财政收入。同时，这一政策也反映出，中国富豪所面临的政治风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260822-%E4%BB%8E%E6%B5%B7%E5%A4%96%E4%BF%A1%E6%89%98%E5%88%B0%E6%96%B0%E5%8A%A0%E5%9D%A1-%E4%B8%AD%E5%9B%BD%E5%AF%8C%E8%B1%AA%E9%9D%A2%E4%B8%B4%E6%96%B0%E7%9A%84%E8%B4%A2%E5%AF%8C%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357958000.webp","sourceId":"rfi"},{"id":1787357826000,"createdDate":"2026-08-22 00:17","name":"法国国际广播电台","title":"香港：两名民主派人士因纪念天安门事件被判有罪，德法批评","content":"在香港，两名民主派人——69岁的李卓人（LeeCheuk-yan）和41岁的邹幸彤（ChowHang-tung）被法院判定犯有“煽动颠覆国家政权罪”。他们最高可能被判处10年监禁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260822-%E9%A6%99%E6%B8%AF-%E4%B8%A4%E5%90%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E4%BA%BA%E5%A3%AB%E5%9B%A0%E7%BA%AA%E5%BF%B5%E5%A4%A9%E5%AE%89%E9%97%A8%E4%BA%8B%E4%BB%B6%E8%A2%AB%E5%88%A4%E6%9C%89%E7%BD%AA%EF%BC%8C%E5%BE%B7%E6%B3%95%E6%89%B9%E8%AF%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357826000.webp","sourceId":"rfi"},{"id":1787387738000,"createdDate":"2026-08-22 08:35","name":"法国国际广播电台","title":"TikTok就儿童隐私问题与美国司法部达成4亿美元和解","content":"美联社周五(8月22日)的报道显示，TikTok已与美国司法部达成一项4亿美元的和解协议，从而结束美国政府于2024年提起的一起诉讼。该诉讼指控TikTok违反美国联邦儿童隐私保护法律。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260822-tiktok%E5%B0%B1%E5%84%BF%E7%AB%A5%E9%9A%90%E7%A7%81%E9%97%AE%E9%A2%98%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E9%83%A8%E8%BE%BE%E6%88%904%E4%BA%BF%E7%BE%8E%E5%85%83%E5%92%8C%E8%A7%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787387738000.webp","sourceId":"rfi"},{"id":1787387426000,"createdDate":"2026-08-22 08:30","name":"法国国际广播电台","title":"应中联部邀请  日本跨党派议员代表团访华","content":"应中国共产党负责对外交流部门的中联部的邀请，由日本中道改革联盟宣传委员长伊佐进一等组成的跨党派日本国会议员团将于下周访问中国。据悉，在日中关系趋于紧张的背景下，此举被认为是中方推动改善两国关系的一个动向。中国外交部发言人林剑8月21日表示：我们敦促日本当政者倾听、重视这些声音，恪守中日四个政治文件的各项原则，以实际行动为中日正常交流创造必要条件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E5%BA%94%E4%B8%AD%E8%81%94%E9%83%A8%E9%82%80%E8%AF%B7-%E6%97%A5%E6%9C%AC%E8%B7%A8%E5%85%9A%E6%B4%BE%E8%AE%AE%E5%91%98%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787387426000.webp","sourceId":"rfi"},{"id":1787386949000,"createdDate":"2026-08-22 08:22","name":"法国国际广播电台","title":"美国军机飞越台湾海峡 《环球时报》援引军方消息人士称“局势处于可控状态”","content":"周五（8月21日），美国海军一架P-8A“海神”巡逻机在国际空域飞越台湾海峡。美国海军第七舰队表示，此举“展现了美国对维护自由开放的印太地区的承诺”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E7%BE%8E%E5%9B%BD%E5%86%9B%E6%9C%BA%E9%A3%9E%E8%B6%8A%E5%8F%B0%E6%B9%BE%E6%B5%B7%E5%B3%A1-%E7%8E%AF%E7%90%83%E6%97%B6%E6%8A%A5-%E6%8F%B4%E5%BC%95%E5%86%9B%E6%96%B9%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E7%A7%B0-%E5%B1%80%E5%8A%BF%E5%A4%84%E4%BA%8E%E5%8F%AF%E6%8E%A7%E7%8A%B6%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386949000.webp","sourceId":"rfi"},{"id":1787386943000,"createdDate":"2026-08-22 08:22","name":"法国国际广播电台","title":"继中国后 韩国首艘货轮试经北极航线驶往欧洲，一条亚欧海运新路线？","content":"法新社釜山消息，首艘韩国货轮于周六（8月22日）启程经北极航线驶往欧洲，这是在中东航运持续受阻的背景下，该海运路线重新引发关注的最新例证。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260822-%E7%BB%A7%E4%B8%AD%E5%9B%BD%E5%90%8E%EF%BC%8C%E9%9F%A9%E5%9B%BD%E9%A6%96%E8%89%98%E8%B4%A7%E8%BD%AE%E8%AF%95%E7%BB%8F%E5%8C%97%E6%9E%81%E8%88%AA%E7%BA%BF%E9%A9%B6%E5%BE%80%E6%AC%A7%E6%B4%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386943000.webp","sourceId":"rfi"},{"id":1787386752000,"createdDate":"2026-08-22 08:19","name":"法国国际广播电台","title":"加拿大拒签“不平等”条约 准备向美国实施报复性关税","content":"加拿大总理卡尼（MarkCarney）周五晚发表措辞强硬的官方声明，正式宣布中止与美国的双边贸易谈判，并下令身在华盛顿的加拿大谈判代表团马上打道回府。这项决策直接宣告两国在关税生效期限前的最后谈判全面破裂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%8B%92%E7%AD%BE-%E4%B8%8D%E5%B9%B3%E7%AD%89-%E6%9D%A1%E7%BA%A6-%E5%87%86%E5%A4%87%E5%90%91%E7%BE%8E%E5%9B%BD%E5%AE%9E%E6%96%BD%E6%8A%A5%E5%A4%8D%E6%80%A7%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386752000.webp","sourceId":"rfi"},{"id":1787386139000,"createdDate":"2026-08-22 08:08","name":"法国国际广播电台","title":"卢拉和特朗普进行“友好而融洽”的通话后，巴西与美国恢复关税谈判","content":"巴西总统卢拉周五（8月21日）表示，在与美国总统特朗普通电话后，巴西和美国已经恢复了有关美国加征关税问题的对话。作为拉丁美洲最大的经济体，美国7月曾分两轮对巴西加征关税，理由是巴西存在所谓的不公平贸易行为。关税问题也已经成为巴西10月总统大选竞选活动中的重要议题。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E5%8D%A2%E6%8B%89%E5%92%8C%E7%89%B9%E6%9C%97%E6%99%AE%E8%BF%9B%E8%A1%8C-%E5%8F%8B%E5%A5%BD%E8%80%8C%E8%9E%8D%E6%B4%BD-%E7%9A%84%E9%80%9A%E8%AF%9D%E5%90%8E%EF%BC%8C%E5%B7%B4%E8%A5%BF%E4%B8%8E%E7%BE%8E%E5%9B%BD%E6%81%A2%E5%A4%8D%E5%85%B3%E7%A8%8E%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386139000.webp","sourceId":"rfi"},{"id":1787385334000,"createdDate":"2026-08-22 07:55","name":"法国国际广播电台","title":"美国和加拿大贸易谈判破裂，双方互相指责","content":"由于美国与加拿大之间的贸易谈判未能达成协议，周六（8月22日）凌晨，美国宣布对价值200亿美元的加拿大商品征收50%的关税，而双方均指责是对方的原因才导致谈判破裂。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E7%BE%8E%E5%9B%BD%E5%92%8C%E5%8A%A0%E6%8B%BF%E5%A4%A7%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E7%A0%B4%E8%A3%82%EF%BC%8C%E5%8F%8C%E6%96%B9%E4%BA%92%E7%9B%B8%E6%8C%87%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787385334000.webp","sourceId":"rfi"}]