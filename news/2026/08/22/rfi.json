[{"id":1787362219000,"createdDate":"2026-08-22 01:30","name":"法国国际广播电台","title":"你如何被人工智能利用 ，而不是你利用它","content":"各位听众，针对管理学上的研究，加拿大作家科里·多克托罗在一篇文章中指出，人工智能的真正问题可能不在于它能做什么，而在于它让工人做什么。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E4%BD%A0%E5%A6%82%E4%BD%95%E8%A2%AB%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%88%A9%E7%94%A8-%EF%BC%8C%E8%80%8C%E4%B8%8D%E6%98%AF%E4%BD%A0%E5%88%A9%E7%94%A8%E5%AE%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787362219000.webp","sourceId":"rfi"},{"id":1787357958000,"createdDate":"2026-08-22 00:19","name":"法国国际广播电台","title":"从海外信托到新加坡：中国富豪面临新的财富风险","content":"法国世界报刊出的一篇文章表示，中国政府正在加强对海外资产和超级富豪的税务监管。面对不断扩大的财政赤字，中国政府希望通过加强征税，增加财政收入。同时，这一政策也反映出，中国富豪所面临的政治风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260822-%E4%BB%8E%E6%B5%B7%E5%A4%96%E4%BF%A1%E6%89%98%E5%88%B0%E6%96%B0%E5%8A%A0%E5%9D%A1-%E4%B8%AD%E5%9B%BD%E5%AF%8C%E8%B1%AA%E9%9D%A2%E4%B8%B4%E6%96%B0%E7%9A%84%E8%B4%A2%E5%AF%8C%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357958000.webp","sourceId":"rfi"},{"id":1787357826000,"createdDate":"2026-08-22 00:17","name":"法国国际广播电台","title":"香港：两名民主派人士因纪念天安门事件被判有罪，德法批评","content":"在香港，两名民主派人——69岁的李卓人（LeeCheuk-yan）和41岁的邹幸彤（ChowHang-tung）被法院判定犯有“煽动颠覆国家政权罪”。他们最高可能被判处10年监禁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260822-%E9%A6%99%E6%B8%AF-%E4%B8%A4%E5%90%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E4%BA%BA%E5%A3%AB%E5%9B%A0%E7%BA%AA%E5%BF%B5%E5%A4%A9%E5%AE%89%E9%97%A8%E4%BA%8B%E4%BB%B6%E8%A2%AB%E5%88%A4%E6%9C%89%E7%BD%AA%EF%BC%8C%E5%BE%B7%E6%B3%95%E6%89%B9%E8%AF%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357826000.webp","sourceId":"rfi"}]