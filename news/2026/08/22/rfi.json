[{"id":1787362219000,"createdDate":"2026-08-22 01:30","name":"法国国际广播电台","title":"你如何被人工智能利用 ，而不是你利用它","content":"各位听众，针对管理学上的研究，加拿大作家科里·多克托罗在一篇文章中指出，人工智能的真正问题可能不在于它能做什么，而在于它让工人做什么。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E4%BD%A0%E5%A6%82%E4%BD%95%E8%A2%AB%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%88%A9%E7%94%A8-%EF%BC%8C%E8%80%8C%E4%B8%8D%E6%98%AF%E4%BD%A0%E5%88%A9%E7%94%A8%E5%AE%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787362219000.webp","sourceId":"rfi"},{"id":1787357958000,"createdDate":"2026-08-22 00:19","name":"法国国际广播电台","title":"从海外信托到新加坡：中国富豪面临新的财富风险","content":"法国世界报刊出的一篇文章表示，中国政府正在加强对海外资产和超级富豪的税务监管。面对不断扩大的财政赤字，中国政府希望通过加强征税，增加财政收入。同时，这一政策也反映出，中国富豪所面临的政治风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260822-%E4%BB%8E%E6%B5%B7%E5%A4%96%E4%BF%A1%E6%89%98%E5%88%B0%E6%96%B0%E5%8A%A0%E5%9D%A1-%E4%B8%AD%E5%9B%BD%E5%AF%8C%E8%B1%AA%E9%9D%A2%E4%B8%B4%E6%96%B0%E7%9A%84%E8%B4%A2%E5%AF%8C%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357958000.webp","sourceId":"rfi"},{"id":1787357826000,"createdDate":"2026-08-22 00:17","name":"法国国际广播电台","title":"香港：两名民主派人士因纪念天安门事件被判有罪，德法批评","content":"在香港，两名民主派人——69岁的李卓人（LeeCheuk-yan）和41岁的邹幸彤（ChowHang-tung）被法院判定犯有“煽动颠覆国家政权罪”。他们最高可能被判处10年监禁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260822-%E9%A6%99%E6%B8%AF-%E4%B8%A4%E5%90%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E4%BA%BA%E5%A3%AB%E5%9B%A0%E7%BA%AA%E5%BF%B5%E5%A4%A9%E5%AE%89%E9%97%A8%E4%BA%8B%E4%BB%B6%E8%A2%AB%E5%88%A4%E6%9C%89%E7%BD%AA%EF%BC%8C%E5%BE%B7%E6%B3%95%E6%89%B9%E8%AF%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787357826000.webp","sourceId":"rfi"},{"id":1787387738000,"createdDate":"2026-08-22 08:35","name":"法国国际广播电台","title":"TikTok就儿童隐私问题与美国司法部达成4亿美元和解","content":"美联社周五(8月22日)的报道显示，TikTok已与美国司法部达成一项4亿美元的和解协议，从而结束美国政府于2024年提起的一起诉讼。该诉讼指控TikTok违反美国联邦儿童隐私保护法律。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260822-tiktok%E5%B0%B1%E5%84%BF%E7%AB%A5%E9%9A%90%E7%A7%81%E9%97%AE%E9%A2%98%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E9%83%A8%E8%BE%BE%E6%88%904%E4%BA%BF%E7%BE%8E%E5%85%83%E5%92%8C%E8%A7%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787387738000.webp","sourceId":"rfi"},{"id":1787387426000,"createdDate":"2026-08-22 08:30","name":"法国国际广播电台","title":"应中联部邀请  日本跨党派议员代表团访华","content":"应中国共产党负责对外交流部门的中联部的邀请，由日本中道改革联盟宣传委员长伊佐进一等组成的跨党派日本国会议员团将于下周访问中国。据悉，在日中关系趋于紧张的背景下，此举被认为是中方推动改善两国关系的一个动向。中国外交部发言人林剑8月21日表示：我们敦促日本当政者倾听、重视这些声音，恪守中日四个政治文件的各项原则，以实际行动为中日正常交流创造必要条件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E5%BA%94%E4%B8%AD%E8%81%94%E9%83%A8%E9%82%80%E8%AF%B7-%E6%97%A5%E6%9C%AC%E8%B7%A8%E5%85%9A%E6%B4%BE%E8%AE%AE%E5%91%98%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787387426000.webp","sourceId":"rfi"},{"id":1787386949000,"createdDate":"2026-08-22 08:22","name":"法国国际广播电台","title":"美国军机飞越台湾海峡 《环球时报》援引军方消息人士称“局势处于可控状态”","content":"周五（8月21日），美国海军一架P-8A“海神”巡逻机在国际空域飞越台湾海峡。美国海军第七舰队表示，此举“展现了美国对维护自由开放的印太地区的承诺”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E7%BE%8E%E5%9B%BD%E5%86%9B%E6%9C%BA%E9%A3%9E%E8%B6%8A%E5%8F%B0%E6%B9%BE%E6%B5%B7%E5%B3%A1-%E7%8E%AF%E7%90%83%E6%97%B6%E6%8A%A5-%E6%8F%B4%E5%BC%95%E5%86%9B%E6%96%B9%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E7%A7%B0-%E5%B1%80%E5%8A%BF%E5%A4%84%E4%BA%8E%E5%8F%AF%E6%8E%A7%E7%8A%B6%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386949000.webp","sourceId":"rfi"},{"id":1787386943000,"createdDate":"2026-08-22 08:22","name":"法国国际广播电台","title":"继中国后 韩国首艘货轮试经北极航线驶往欧洲，一条亚欧海运新路线？","content":"法新社釜山消息，首艘韩国货轮于周六（8月22日）启程经北极航线驶往欧洲，这是在中东航运持续受阻的背景下，该海运路线重新引发关注的最新例证。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260822-%E7%BB%A7%E4%B8%AD%E5%9B%BD%E5%90%8E%EF%BC%8C%E9%9F%A9%E5%9B%BD%E9%A6%96%E8%89%98%E8%B4%A7%E8%BD%AE%E8%AF%95%E7%BB%8F%E5%8C%97%E6%9E%81%E8%88%AA%E7%BA%BF%E9%A9%B6%E5%BE%80%E6%AC%A7%E6%B4%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386943000.webp","sourceId":"rfi"},{"id":1787386752000,"createdDate":"2026-08-22 08:19","name":"法国国际广播电台","title":"加拿大拒签“不平等”条约 准备向美国实施报复性关税","content":"加拿大总理卡尼（MarkCarney）周五晚发表措辞强硬的官方声明，正式宣布中止与美国的双边贸易谈判，并下令身在华盛顿的加拿大谈判代表团马上打道回府。这项决策直接宣告两国在关税生效期限前的最后谈判全面破裂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%8B%92%E7%AD%BE-%E4%B8%8D%E5%B9%B3%E7%AD%89-%E6%9D%A1%E7%BA%A6-%E5%87%86%E5%A4%87%E5%90%91%E7%BE%8E%E5%9B%BD%E5%AE%9E%E6%96%BD%E6%8A%A5%E5%A4%8D%E6%80%A7%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386752000.webp","sourceId":"rfi"},{"id":1787386139000,"createdDate":"2026-08-22 08:08","name":"法国国际广播电台","title":"卢拉和特朗普进行“友好而融洽”的通话后，巴西与美国恢复关税谈判","content":"巴西总统卢拉周五（8月21日）表示，在与美国总统特朗普通电话后，巴西和美国已经恢复了有关美国加征关税问题的对话。作为拉丁美洲最大的经济体，美国7月曾分两轮对巴西加征关税，理由是巴西存在所谓的不公平贸易行为。关税问题也已经成为巴西10月总统大选竞选活动中的重要议题。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E5%8D%A2%E6%8B%89%E5%92%8C%E7%89%B9%E6%9C%97%E6%99%AE%E8%BF%9B%E8%A1%8C-%E5%8F%8B%E5%A5%BD%E8%80%8C%E8%9E%8D%E6%B4%BD-%E7%9A%84%E9%80%9A%E8%AF%9D%E5%90%8E%EF%BC%8C%E5%B7%B4%E8%A5%BF%E4%B8%8E%E7%BE%8E%E5%9B%BD%E6%81%A2%E5%A4%8D%E5%85%B3%E7%A8%8E%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787386139000.webp","sourceId":"rfi"},{"id":1787385334000,"createdDate":"2026-08-22 07:55","name":"法国国际广播电台","title":"美国和加拿大贸易谈判破裂，双方互相指责","content":"由于美国与加拿大之间的贸易谈判未能达成协议，周六（8月22日）凌晨，美国宣布对价值200亿美元的加拿大商品征收50%的关税，而双方均指责是对方的原因才导致谈判破裂。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E7%BE%8E%E5%9B%BD%E5%92%8C%E5%8A%A0%E6%8B%BF%E5%A4%A7%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E7%A0%B4%E8%A3%82%EF%BC%8C%E5%8F%8C%E6%96%B9%E4%BA%92%E7%9B%B8%E6%8C%87%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787385334000.webp","sourceId":"rfi"},{"id":1787414292000,"createdDate":"2026-08-22 15:58","name":"法国国际广播电台","title":"习近平访美前夕 美国民间致信白宫声援旺旺","content":"中国母犬旺旺及3只幼犬遭虐待致死事件，持续引发海外动物保护人士关注。随着中国国家主席习近平预计9月访问美国，美国多地民间人士正发起连署、游行及其他声援行动，呼吁白宫及国际社会关注中国动物虐待、虐待影像在网路传播，以及动物保护法律和问责机制等问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260822-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E%E5%89%8D%E5%A4%95-%E7%BE%8E%E5%9B%BD%E6%B0%91%E9%97%B4%E8%87%B4%E4%BF%A1%E7%99%BD%E5%AE%AB%E5%A3%B0%E6%8F%B4%E6%97%BA%E6%97%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787414292000.webp","sourceId":"rfi"},{"id":1787407490000,"createdDate":"2026-08-22 14:04","name":"法国国际广播电台","title":"朝鲜指责日本准备发动“侵略战争”","content":"朝鲜周六（8月22日）猛烈抨击日本计划增加国防预算的举措，指责日本正在准备发动一场“侵略战争”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E6%9C%9D%E9%B2%9C%E6%8C%87%E8%B4%A3%E6%97%A5%E6%9C%AC%E5%87%86%E5%A4%87%E5%8F%91%E5%8A%A8-%E4%BE%B5%E7%95%A5%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787407490000.webp","sourceId":"rfi"},{"id":1787404211000,"createdDate":"2026-08-22 13:10","name":"法国国际广播电台","title":"美国封锁措施见效，消息人士称伊朗原油对中国买家报价减少、价格上涨","content":"路透社周五（8月21日）的一篇深度报道披露，消息人士表示，由于美国实施的封锁措施导致伊朗原油运输量下降，本周面向中国买家的伊朗原油报价明显减少，价格则大幅上涨。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E7%BE%8E%E5%9B%BD%E5%B0%81%E9%94%81%E6%8E%AA%E6%96%BD%E8%A7%81%E6%95%88%EF%BC%8C%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E7%A7%B0%E4%BC%8A%E6%9C%97%E5%8E%9F%E6%B2%B9%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%B9%B0%E5%AE%B6%E6%8A%A5%E4%BB%B7%E5%87%8F%E5%B0%91-%E4%BB%B7%E6%A0%BC%E4%B8%8A%E6%B6%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787404211000.webp","sourceId":"rfi"},{"id":1787400628000,"createdDate":"2026-08-22 12:10","name":"法国国际广播电台","title":"50%关税上路：加拿大要如何减少对美国的经济依赖，法新社怎么说... ...","content":"美加两国贸易谈判在最后一刻破裂，据特朗普政府一名高级官员表示，美国将根据《1930年关税法》第338条，对价值约200亿美元的加拿大商品征收关税，有关措施将在当地时间8月22日午夜过后生效。据悉，双方均将谈判破裂归咎于对方。美国贸易代表格里尔表示，加拿大谈判代表在最后关头提出新要求，打破了双方经过数日谈判达成的平衡。而加拿大总理卡尼则表示是美国改变了立场。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260822-50-%E5%85%B3%E7%A8%8E%E4%B8%8A%E8%B7%AF-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E8%A6%81%E5%A6%82%E4%BD%95%E5%87%8F%E5%B0%91%E5%AF%B9%E7%BE%8E%E5%9B%BD%E7%9A%84%E7%BB%8F%E6%B5%8E%E4%BE%9D%E8%B5%96%EF%BC%8C%E6%B3%95%E6%96%B0%E7%A4%BE%E6%80%8E%E4%B9%88%E8%AF%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787400628000.webp","sourceId":"rfi"},{"id":1787399361000,"createdDate":"2026-08-22 11:49","name":"法国国际广播电台","title":"特斯拉大规模汽车召回案：隐形电子门把手何以成为电动车安全隐患？","content":"特斯拉（Tesla）以及另外8家汽车制造商周五（8月21日）表示，由于担心车辆在紧急情况下可能难以打开车门，它们将在中国召回总计约430万辆汽车。这类门把手由特斯拉推广普及，设计的特点是与车门表面基本齐平，既能营造简洁、极简的外观，也可以降低空气阻力。车主靠近车辆时，门把手通常会通过电子控制自动向外弹出。目前尚不清楚特斯拉是否计划在美国或欧洲采取类似的召回措施。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260822-%E7%89%B9%E6%96%AF%E6%8B%89%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%B1%BD%E8%BD%A6%E5%8F%AC%E5%9B%9E%E6%A1%88-%E9%9A%90%E5%BD%A2%E7%94%B5%E5%AD%90%E9%97%A8%E6%8A%8A%E6%89%8B%E4%BD%95%E4%BB%A5%E6%88%90%E4%B8%BA%E7%94%B5%E5%8A%A8%E8%BD%A6%E5%AE%89%E5%85%A8%E9%9A%90%E6%82%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787399361000.webp","sourceId":"rfi"},{"id":1787399336000,"createdDate":"2026-08-22 11:48","name":"法国国际广播电台","title":"人工智能如何影响中国人对爱情和永生的追寻？","content":"2026年8月22日本台订阅的出刊的法国主流日刊对中国的关注不强，国际版面关注点也较为分散。在本期节目中，我们为您选取唯一和中国相关的一则与人工智能和文化、社会相关的报道做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260822-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%A6%82%E4%BD%95%E5%BD%B1%E5%93%8D%E4%B8%AD%E5%9B%BD%E4%BA%BA%E5%AF%B9%E7%88%B1%E6%83%85%E5%92%8C%E6%B0%B8%E7%94%9F%E7%9A%84%E8%BF%BD%E5%AF%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787399336000.webp","sourceId":"rfi"},{"id":1787391404000,"createdDate":"2026-08-22 09:36","name":"法国国际广播电台","title":"印俄战略伙伴关系再现高层互动：印度外长明日起应邀访俄","content":"综合路透社、国际文传电讯社消息，印度外交部长马尼亚姆·贾伊尚卡尔将于8月23日至24日正式访问俄罗斯。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260822-%E5%8D%B0%E4%BF%84%E6%88%98%E7%95%A5%E4%BC%99%E4%BC%B4%E5%85%B3%E7%B3%BB%E5%86%8D%E7%8E%B0%E9%AB%98%E5%B1%82%E4%BA%92%E5%8A%A8-%E5%8D%B0%E5%BA%A6%E5%A4%96%E9%95%BF%E6%98%8E%E6%97%A5%E8%B5%B7%E5%BA%94%E9%82%80%E8%AE%BF%E4%BF%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787391404000.webp","sourceId":"rfi"},{"id":1787391107000,"createdDate":"2026-08-22 09:31","name":"法国国际广播电台","title":"高市或于9月中下旬改组内阁及自民党领导层","content":"综合共同社等多家日媒体报道，日本首相高市早苗很可能计划于9月中下旬改组内阁，同时调整执政的自民党高层人事。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E9%AB%98%E5%B8%82%E6%88%96%E4%BA%8E9%E6%9C%88%E4%B8%AD%E4%B8%8B%E6%97%AC%E6%94%B9%E7%BB%84%E5%86%85%E9%98%81%E5%8F%8A%E8%87%AA%E6%B0%91%E5%85%9A%E9%A2%86%E5%AF%BC%E5%B1%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787391107000.webp","sourceId":"rfi"},{"id":1787390353000,"createdDate":"2026-08-22 09:19","name":"法国国际广播电台","title":"俄罗斯空袭泽连斯基家乡购物中心，超百人伤亡","content":"乌克兰救援人员周六（8月22日）继续在乌克兰中部一座大型购物中心的废墟中搜寻幸存者和遇难者。此前，俄罗斯无人机在白天发动袭击，造成至少16人死亡、130人受伤。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A9%BA%E8%A2%AD%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%AE%B6%E4%B9%A1%E8%B4%AD%E7%89%A9%E4%B8%AD%E5%BF%83%EF%BC%8C%E8%B6%85%E7%99%BE%E4%BA%BA%E4%BC%A4%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787390353000.webp","sourceId":"rfi"},{"id":1787435645000,"createdDate":"2026-08-22 21:54","name":"法国国际广播电台","title":"卡尼：美方最后关头加入破坏加方主权条款","content":"加拿大总理马克·卡尼（MarkCarney）在首都渥太华召开特别记者会，正式宣布加拿大将实施“一美元对一美元”的对等关税反制，并提拨250亿加元预算全面支援受冲击的本国企业与劳工。卡尼更透露，美国是要限制加拿大跟其他国家达成贸易协议。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260822-%E5%8D%A1%E5%B0%BC-%E7%BE%8E%E6%96%B9%E6%9C%80%E5%90%8E%E5%85%B3%E5%A4%B4%E5%8A%A0%E5%85%A5%E7%A0%B4%E5%9D%8F%E5%8A%A0%E6%96%B9%E4%B8%BB%E6%9D%83%E6%9D%A1%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787435645000.webp","sourceId":"rfi"},{"id":1787432209000,"createdDate":"2026-08-22 20:56","name":"法国国际广播电台","title":"特朗普再遭一击    法官推翻政府停发75国移民签证政策","content":"8月21日，一名美国联邦地区法官推翻了特朗普政府暂停向75个国家申请人发放移民签证的政策，称该政策超出了国务卿鲁比奥的法定权限。联邦地区法官珍妮特·瓦尔加斯（JeannetteVargas）表示，美国务院于1月宣布的政策“显然违法”，且违反了联邦移民法。据悉，特朗普政府或寻求上诉，相关政策目前仍在生效中。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260822-%E7%89%B9%E6%9C%97%E6%99%AE%E5%86%8D%E9%81%AD%E4%B8%80%E5%87%BB-%E6%B3%95%E5%AE%98%E6%8E%A8%E7%BF%BB%E6%94%BF%E5%BA%9C%E5%81%9C%E5%8F%9175%E5%9B%BD%E7%A7%BB%E6%B0%91%E7%AD%BE%E8%AF%81%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787432209000.webp","sourceId":"rfi"},{"id":1787431817000,"createdDate":"2026-08-22 20:50","name":"法国国际广播电台","title":"无人驾驶出租即将问世","content":"特斯拉正加紧为即将推出的Cyber​​cab造势，这款没有方向盘和无踏脚的车辆将用于其无人驾驶出租车服务。这家美国汽车制造商于周六发布了一张图片，宣布将于9月3日在德克萨斯州奥斯汀（Austin）举办一场活动。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260822-%E6%97%A0%E4%BA%BA%E9%A9%BE%E9%A9%B6%E5%87%BA%E7%A7%9F%E5%8D%B3%E5%B0%86%E9%97%AE%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787431817000.webp","sourceId":"rfi"},{"id":1787431438000,"createdDate":"2026-08-22 20:43","name":"法国国际广播电台","title":"美国对加拿大加征关税后    马克·卡尼重手回击","content":"加拿大总理马克·卡尼周六宣布，将对美国钢铁和乳制品采取报复性措施，此前加拿大拒绝了华盛顿提出的“糟糕协议”。目前，加美关系正处于历史低点。卡尼在新闻发布会上表示，这些措施将于9月8日生效，同时还将影响造纸业、农业机械和电子产品。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260822-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E5%8A%A0%E5%8A%A0%E5%BE%81%E5%85%B3%E7%A8%8E%E5%90%8E-%E9%A9%AC%E5%85%8B%C2%B7%E5%8D%A1%E5%B0%BC%E9%87%8D%E6%89%8B%E5%9B%9E%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787431438000.webp","sourceId":"rfi"},{"id":1787430944000,"createdDate":"2026-08-22 20:35","name":"法国国际广播电台","title":"中国在伊朗问题上为何占据了优势？","content":"美国威胁对伊朗及其支持者实施新的制裁，但这并未令北京感到不安。尽管特朗普呼吁中国加入其对德黑兰的经济胁迫政策，但中国拒绝了这一提议。尽管作为伊朗主要经济伙伴的北京表面上可能对美国“史无前例的制裁”威胁感到担忧，但中国当局似乎处于相当强势的地位。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260822-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E4%BC%8A%E6%9C%97%E9%97%AE%E9%A2%98%E4%B8%8A%E4%B8%BA%E4%BD%95%E5%8D%A0%E6%8D%AE%E4%BA%86%E4%BC%98%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787430944000.webp","sourceId":"rfi"},{"id":1787430425000,"createdDate":"2026-08-22 20:27","name":"法国国际广播电台","title":"法国承诺向乌克兰提供新型拦截导弹","content":"法新社22日消息报道，面对俄罗斯日益频繁的打击，法国周六承诺向乌克兰提供新型拦截导弹；这些打击已导致这场持续四年半的战争中的平民死亡人数升至自莫斯科入侵初期以来的最高水平。法国总统马克龙在宣布提供新型拦截导弹时在社交平台X上写道：“向乌克兰提供保卫领空和挫败此次侵略所需的一切手段至关重要。”","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260822-%E6%B3%95%E5%9B%BD%E6%89%BF%E8%AF%BA%E5%90%91%E4%B9%8C%E5%85%8B%E5%85%B0%E6%8F%90%E4%BE%9B%E6%96%B0%E5%9E%8B%E6%8B%A6%E6%88%AA%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787430425000.webp","sourceId":"rfi"},{"id":1787430157000,"createdDate":"2026-08-22 20:22","name":"法国国际广播电台","title":"多哥政府称掌握确凿证据    拘捕两名法国记者兼导演","content":"法国两名记者兼导演7月27日起被拘押至今。多哥政府22日首次表示，他们掌握严重且具有说服力的证据，证明法国记者和一名多哥籍的协调员因涉嫌“虚假申报”而遭到拘留。两名记者前往多哥为法国国营电视台（FranceTelevisions）拍摄《不可能之路》（LesRoutesdel'impossible）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260822-%E5%A4%9A%E5%93%A5%E6%94%BF%E5%BA%9C%E7%A7%B0%E6%8E%8C%E6%8F%A1%E7%A1%AE%E5%87%BF%E8%AF%81%E6%8D%AE-%E6%8B%98%E6%8D%95%E4%B8%A4%E5%90%8D%E6%B3%95%E5%9B%BD%E8%AE%B0%E8%80%85%E5%85%BC%E5%AF%BC%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787430157000.webp","sourceId":"rfi"},{"id":1787429844000,"createdDate":"2026-08-22 20:17","name":"法国国际广播电台","title":"校园持剑袭击案让瑞典沉浸在悲痛中","content":"瑞典中部市镇法格什塔（Fagersta）一所学校21日发生持剑袭击事件，造成一人死亡、至少3人受伤，其中两名未满18岁的男孩伤势严重。。死者于周六被确认为一名17岁的学生。警方表示：“此次事件中的死者是一名17岁的女孩。她的家人已被告知”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260822-%E6%A0%A1%E5%9B%AD%E6%8C%81%E5%89%91%E8%A2%AD%E5%87%BB%E6%A1%88%E8%AE%A9%E7%91%9E%E5%85%B8%E6%B2%89%E6%B5%B8%E5%9C%A8%E6%82%B2%E7%97%9B%E4%B8%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787429844000.webp","sourceId":"rfi"},{"id":1787429377000,"createdDate":"2026-08-22 20:09","name":"法国国际广播电台","title":"AI数据中心的争论成美国今年中期选举焦点之一","content":"曾象征科技发展和经济增长的AI数据中心投资建设项目，正逐渐成为今年11月美国中期选举中的政治博弈焦点。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260822-ai%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E7%9A%84%E4%BA%89%E8%AE%BA%E6%88%90%E7%BE%8E%E5%9B%BD%E4%BB%8A%E5%B9%B4%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E7%84%A6%E7%82%B9%E4%B9%8B%E4%B8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787429377000.webp","sourceId":"rfi"},{"id":1787428742000,"createdDate":"2026-08-22 19:59","name":"法国国际广播电台","title":"打击非法吸食笑气   嘎纳市政警察配用便携式探测器","content":"为更好地打击非法吸食“笑气”的一氧化二氮（N₂O），嘎纳市政警察允许配用一氧化二氮探测器。戛纳市政府表示：“戛纳已成为法国首个为其市政警察配备三台一氧化二氮探测器的城市。”这些设备可以检测呼出气体中是否存在这种气体，“类似于酒精测试仪”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260822-%E6%89%93%E5%87%BB%E9%9D%9E%E6%B3%95%E5%90%B8%E9%A3%9F%E7%AC%91%E6%B0%94-%E5%98%8E%E7%BA%B3%E5%B8%82%E6%94%BF%E8%AD%A6%E5%AF%9F%E9%85%8D%E7%94%A8%E4%BE%BF%E6%90%BA%E5%BC%8F%E6%8E%A2%E6%B5%8B%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787428742000.webp","sourceId":"rfi"},{"id":1787428420000,"createdDate":"2026-08-22 19:53","name":"法国国际广播电台","title":"弥撒圣衣的设计者 - 索奇内利（Filippo Sorcinelli）","content":"教宗御用裁缝菲利波·索奇内利（FilippoSorcinelli）深知自己肩上的担子。上周六，教宗良十四世在里米尼（Rimini）主持弥撒时，身着索尔奇内利设计的绿白相间弥撒圣衣。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260822-%E5%BC%A5%E6%92%92%E5%9C%A3%E8%A1%A3%E7%9A%84%E8%AE%BE%E8%AE%A1%E8%80%85-%E7%B4%A2%E5%A5%87%E5%86%85%E5%88%A9-filippo-sorcinelli","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787428420000.webp","sourceId":"rfi"},{"id":1787427648000,"createdDate":"2026-08-22 19:40","name":"法国国际广播电台","title":"恒大：中共高官们共享的一桌房地产盛宴","content":"恒大集团和许家印被控集资诈骗等8宗罪，包括非法吸收公众存款、集资诈骗、违法发放贷款、违法运用资金、欺诈发行证券、违规披露重要信息、职务侵占、单位行贿。单说8宗罪里的“单位行贿”罪，也是“眼见他起高楼，眼见他楼塌了”，恒大曾是中共高官们共享的房地产盛宴，涉及到了一众高官。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260822-%E6%81%92%E5%A4%A7%E6%9B%BE%E6%98%AF%E4%B8%AD%E5%85%B1%E9%AB%98%E5%AE%98%E4%BB%AC%E5%85%B1%E4%BA%AB%E7%9A%84%E6%88%BF%E5%9C%B0%E4%BA%A7%E7%9B%9B%E5%AE%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/22/1787427648000.webp","sourceId":"rfi"}]