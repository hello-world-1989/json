[{"id":1786869957000,"createdDate":"2026-08-16 08:45","name":"法国国际广播电台","title":"日本首相高市早苗遥拜靖国神社","content":"在8月15日日本终战纪念日，日本首相高市早苗没有去靖国神社参拜，她通过自民党干事长铃木俊一奉纳了祭品玉串费，在就任首相后，她首次选择在8月15日不去亲自参拜，同时她遥拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260816-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E9%81%A5%E6%8B%9C%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786869957000.webp","sourceId":"rfi"},{"id":1786868916000,"createdDate":"2026-08-16 08:28","name":"法国国际广播电台","title":"朱镕基遗体定于周二火化 天安门等地将下半旗志哀","content":"官媒新华社周日发布消息指，中国共产党第十四届、十五届中央政治局常委，国务院原总理朱镕基的遗体，将于18日在北京火化。官方评价称，朱镕基是“中国共产党的优秀党员，久经考验的忠诚的共产主义战士，杰出的无产阶级革命家、政治家，党和国家的卓越领导人”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260816-%E6%9C%B1%E9%95%95%E5%9F%BA%E9%81%97%E4%BD%93%E5%AE%9A%E4%BA%8E%E5%91%A8%E4%BA%8C%E7%81%AB%E5%8C%96-%E5%A4%A9%E5%AE%89%E9%97%A8%E7%AD%89%E5%9C%B0%E5%B0%86%E4%B8%8B%E5%8D%8A%E6%97%97%E5%BF%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786868916000.webp","sourceId":"rfi"}]