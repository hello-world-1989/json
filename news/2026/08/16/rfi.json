[{"id":1786869957000,"createdDate":"2026-08-16 08:45","name":"法国国际广播电台","title":"日本首相高市早苗遥拜靖国神社","content":"在8月15日日本终战纪念日，日本首相高市早苗没有去靖国神社参拜，她通过自民党干事长铃木俊一奉纳了祭品玉串费，在就任首相后，她首次选择在8月15日不去亲自参拜，同时她遥拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260816-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E9%81%A5%E6%8B%9C%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786869957000.webp","sourceId":"rfi"},{"id":1786868916000,"createdDate":"2026-08-16 08:28","name":"法国国际广播电台","title":"朱镕基遗体定于周二火化 天安门等地将下半旗志哀","content":"官媒新华社周日发布消息指，中国共产党第十四届、十五届中央政治局常委，国务院原总理朱镕基的遗体，将于18日在北京火化。官方评价称，朱镕基是“中国共产党的优秀党员，久经考验的忠诚的共产主义战士，杰出的无产阶级革命家、政治家，党和国家的卓越领导人”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260816-%E6%9C%B1%E9%95%95%E5%9F%BA%E9%81%97%E4%BD%93%E5%AE%9A%E4%BA%8E%E5%91%A8%E4%BA%8C%E7%81%AB%E5%8C%96-%E5%A4%A9%E5%AE%89%E9%97%A8%E7%AD%89%E5%9C%B0%E5%B0%86%E4%B8%8B%E5%8D%8A%E6%97%97%E5%BF%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786868916000.webp","sourceId":"rfi"},{"id":1786882160000,"createdDate":"2026-08-16 12:09","name":"法国国际广播电台","title":"封堵外国劳工在美就业 本土矿业院校毕业生不足 美稀土自主雄心面临人才挑战","content":"据美国行业高管和矿业院校负责人称，特朗普政府旨在通过培训更多矿工来提振美国关键矿产生产的相关计划，这将不足以打破中国对该行业的垄断控制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E5%B0%81%E5%A0%B5%E5%A4%96%E5%9B%BD%E5%8A%B3%E5%B7%A5%E5%9C%A8%E7%BE%8E%E5%B0%B1%E4%B8%9A-%E6%9C%AC%E5%9C%9F%E7%9F%BF%E4%B8%9A%E9%99%A2%E6%A0%A1%E6%AF%95%E4%B8%9A%E7%94%9F%E4%B8%8D%E8%B6%B3-%E7%BE%8E%E7%A8%80%E5%9C%9F%E8%87%AA%E4%B8%BB%E9%9B%84%E5%BF%83%E9%9D%A2%E4%B8%B4%E4%BA%BA%E6%89%8D%E6%8C%91%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786882160000.webp","sourceId":"rfi"},{"id":1786880636000,"createdDate":"2026-08-16 11:43","name":"法国国际广播电台","title":"贝森特誓言对伊朗施加“极限”经济压力 实际剩余选项并不易","content":"美国财政部长贝森特（ScottBessent）日前宣称，美方正准备对伊朗施加前所未有的经济压力；鉴于伊朗政权已面临海军封锁及数千项制裁，批评人士对这一说法的有效性持怀疑态度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260816-%E8%B4%9D%E6%A3%AE%E7%89%B9%E8%AA%93%E8%A8%80%E5%AF%B9%E4%BC%8A%E6%9C%97%E6%96%BD%E5%8A%A0-%E6%9E%81%E9%99%90-%E7%BB%8F%E6%B5%8E%E5%8E%8B%E5%8A%9B-%E5%AE%9E%E9%99%85%E5%89%A9%E4%BD%99%E9%80%89%E5%B9%B6%E4%B8%8D%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786880636000.webp","sourceId":"rfi"},{"id":1786877357000,"createdDate":"2026-08-16 10:49","name":"法国国际广播电台","title":"朝鲜士兵越过东部战线韩朝军事分界线，韩军鸣枪警告","content":"据韩国政府消息人士16日透露，几名朝鲜士兵最近几天越过东部战线韩朝军事分界线，韩军随后鸣枪警告。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E6%9C%9D%E9%B2%9C%E5%A3%AB%E5%85%B5%E8%B6%8A%E8%BF%87%E4%B8%9C%E9%83%A8%E6%88%98%E7%BA%BF%E9%9F%A9%E6%9C%9D%E5%86%9B%E4%BA%8B%E5%88%86%E7%95%8C%E7%BA%BF%EF%BC%8C%E9%9F%A9%E5%86%9B%E9%B8%A3%E6%9E%AA%E8%AD%A6%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786877357000.webp","sourceId":"rfi"},{"id":1786877107000,"createdDate":"2026-08-16 10:45","name":"法国国际广播电台","title":"金正恩携妻女参谒解放塔悼念阵亡苏军 普京发贺电提就国际议程中的紧迫议题合作","content":"朝鲜最高领导人金正恩携其女金主爱（音）周五在祖国解放（韩国称光复节）81周年前夕，参谒解放塔悼念阵亡苏军，强调朝俄关系强劲。俄罗斯总统普京也在解放日（15日）之际向金正恩发去贺电，强调了俄朝之间的友好关系，并提到了两国之间的“建设性合作”，这似乎是指朝鲜派兵援俄。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E9%87%91%E6%AD%A3%E6%81%A9%E6%90%BA%E5%A6%BB%E5%A5%B3%E5%8F%82%E8%B0%92%E8%A7%A3%E6%94%BE%E5%A1%94%E6%82%BC%E5%BF%B5%E9%98%B5%E4%BA%A1%E8%8B%8F%E5%86%9B-%E6%99%AE%E4%BA%AC%E5%8F%91%E8%B4%BA%E7%94%B5%E6%8F%90%E5%B0%B1%E5%9B%BD%E9%99%85%E8%AE%AE%E7%A8%8B%E4%B8%AD%E7%9A%84%E7%B4%A7%E8%BF%AB%E8%AE%AE%E9%A2%98%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786877107000.webp","sourceId":"rfi"},{"id":1786874241000,"createdDate":"2026-08-16 09:57","name":"法国国际广播电台","title":"伊朗军方要求派员入卡塔尔搜寻飞行员下落 指四革命卫队人员在科威特下落不明","content":"据伊朗媒体报导，一位伊朗军方官员周日表示，卡塔尔应允许伊朗方面派员入境，以调查那些德黑兰声称被卡塔尔军队俘获的飞行员的下落。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260816-%E4%BC%8A%E6%9C%97%E5%86%9B%E6%96%B9%E8%A6%81%E6%B1%82%E6%B4%BE%E5%91%98%E5%85%A5%E5%8D%A1%E5%A1%94%E5%B0%94%E6%90%9C%E5%AF%BB%E9%A3%9E%E8%A1%8C%E5%91%98%E4%B8%8B%E8%90%BD-%E6%8C%87%E5%9B%9B%E9%9D%A9%E5%91%BD%E5%8D%AB%E9%98%9F%E4%BA%BA%E5%91%98%E5%9C%A8%E7%A7%91%E5%A8%81%E7%89%B9%E4%B8%8B%E8%90%BD%E4%B8%8D%E6%98%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786874241000.webp","sourceId":"rfi"},{"id":1786872854000,"createdDate":"2026-08-16 09:34","name":"法国国际广播电台","title":"中方船只疑似在钓鱼岛周边进行海洋调查 日巡逻船电告停止","content":"据共同社报导，日本海上保安厅第十一管区海上保安本部16日发布消息称，15日下午4时50分左右，在冲绳县尖阁诸岛（中方称钓鱼岛）周边的专属经济区内，确认到一艘中国海洋调查船向海中延伸了类似金属线的物体。日本海上保安厅的巡逻船通过无线电要求其停止该行为，称未经日方同意不得进行海洋科学调查，中方调查船于15日晚间10时15分左右驶离该海域。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260816-%E4%B8%AD%E6%96%B9%E8%88%B9%E5%8F%AA%E7%96%91%E4%BC%BC%E5%9C%A8%E9%92%93%E9%B1%BC%E5%B2%9B%E5%91%A8%E8%BE%B9%E8%BF%9B%E8%A1%8C%E6%B5%B7%E6%B4%8B%E8%B0%83%E6%9F%A5-%E6%97%A5%E5%B7%A1%E9%80%BB%E8%88%B9%E7%94%B5%E5%91%8A%E5%81%9C%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786872854000.webp","sourceId":"rfi"},{"id":1786871337000,"createdDate":"2026-08-16 09:08","name":"法国国际广播电台","title":"菲防长与中国外交部、驻菲使馆论战持续 再批“勒索敲诈”","content":"菲律宾国防部周日对中国驻菲大使馆进行了回击，针对的是使馆近期就菲国防部长特奥多罗（GilbertTeodoro）言论所发表的声明；特奥多罗此前指控中方“掩盖”涉及在菲中国公民的非法活动。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E8%8F%B2%E9%98%B2%E9%95%BF%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8-%E9%A9%BB%E8%8F%B2%E4%BD%BF%E9%A6%86%E8%AE%BA%E6%88%98%E6%8C%81%E7%BB%AD-%E5%86%8D%E6%89%B9-%E5%8B%92%E7%B4%A2%E6%95%B2%E8%AF%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786871337000.webp","sourceId":"rfi"},{"id":1786871186000,"createdDate":"2026-08-16 09:06","name":"法国国际广播电台","title":"首艘中国集装箱船已启程经北极驶往欧洲","content":"一艘中国集装箱船于周六（8月16号）晚间启程，经由北极航线前往欧洲。这是这家亚洲航运巨头首次走这条航线，使其得以绕过中东地区。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E9%A6%96%E8%89%98%E4%B8%AD%E5%9B%BD%E9%9B%86%E8%A3%85%E7%AE%B1%E8%88%B9%E5%B7%B2%E5%90%AF%E7%A8%8B%E7%BB%8F%E5%8C%97%E6%9E%81%E9%A9%B6%E5%BE%80%E6%AC%A7%E6%B4%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786871186000.webp","sourceId":"rfi"}]