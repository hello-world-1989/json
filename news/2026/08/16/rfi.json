[{"id":1786869957000,"createdDate":"2026-08-16 08:45","name":"法国国际广播电台","title":"日本首相高市早苗遥拜靖国神社","content":"在8月15日日本终战纪念日，日本首相高市早苗没有去靖国神社参拜，她通过自民党干事长铃木俊一奉纳了祭品玉串费，在就任首相后，她首次选择在8月15日不去亲自参拜，同时她遥拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260816-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E9%81%A5%E6%8B%9C%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786869957000.webp","sourceId":"rfi"},{"id":1786868916000,"createdDate":"2026-08-16 08:28","name":"法国国际广播电台","title":"朱镕基遗体定于周二火化 天安门等地将下半旗志哀","content":"官媒新华社周日发布消息指，中国共产党第十四届、十五届中央政治局常委，国务院原总理朱镕基的遗体，将于18日在北京火化。官方评价称，朱镕基是“中国共产党的优秀党员，久经考验的忠诚的共产主义战士，杰出的无产阶级革命家、政治家，党和国家的卓越领导人”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260816-%E6%9C%B1%E9%95%95%E5%9F%BA%E9%81%97%E4%BD%93%E5%AE%9A%E4%BA%8E%E5%91%A8%E4%BA%8C%E7%81%AB%E5%8C%96-%E5%A4%A9%E5%AE%89%E9%97%A8%E7%AD%89%E5%9C%B0%E5%B0%86%E4%B8%8B%E5%8D%8A%E6%97%97%E5%BF%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786868916000.webp","sourceId":"rfi"},{"id":1786882160000,"createdDate":"2026-08-16 12:09","name":"法国国际广播电台","title":"封堵外国劳工在美就业 本土矿业院校毕业生不足 美稀土自主雄心面临人才挑战","content":"据美国行业高管和矿业院校负责人称，特朗普政府旨在通过培训更多矿工来提振美国关键矿产生产的相关计划，这将不足以打破中国对该行业的垄断控制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E5%B0%81%E5%A0%B5%E5%A4%96%E5%9B%BD%E5%8A%B3%E5%B7%A5%E5%9C%A8%E7%BE%8E%E5%B0%B1%E4%B8%9A-%E6%9C%AC%E5%9C%9F%E7%9F%BF%E4%B8%9A%E9%99%A2%E6%A0%A1%E6%AF%95%E4%B8%9A%E7%94%9F%E4%B8%8D%E8%B6%B3-%E7%BE%8E%E7%A8%80%E5%9C%9F%E8%87%AA%E4%B8%BB%E9%9B%84%E5%BF%83%E9%9D%A2%E4%B8%B4%E4%BA%BA%E6%89%8D%E6%8C%91%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786882160000.webp","sourceId":"rfi"},{"id":1786880636000,"createdDate":"2026-08-16 11:43","name":"法国国际广播电台","title":"贝森特誓言对伊朗施加“极限”经济压力 实际剩余选项并不易","content":"美国财政部长贝森特（ScottBessent）日前宣称，美方正准备对伊朗施加前所未有的经济压力；鉴于伊朗政权已面临海军封锁及数千项制裁，批评人士对这一说法的有效性持怀疑态度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260816-%E8%B4%9D%E6%A3%AE%E7%89%B9%E8%AA%93%E8%A8%80%E5%AF%B9%E4%BC%8A%E6%9C%97%E6%96%BD%E5%8A%A0-%E6%9E%81%E9%99%90-%E7%BB%8F%E6%B5%8E%E5%8E%8B%E5%8A%9B-%E5%AE%9E%E9%99%85%E5%89%A9%E4%BD%99%E9%80%89%E5%B9%B6%E4%B8%8D%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786880636000.webp","sourceId":"rfi"},{"id":1786877357000,"createdDate":"2026-08-16 10:49","name":"法国国际广播电台","title":"朝鲜士兵越过东部战线韩朝军事分界线，韩军鸣枪警告","content":"据韩国政府消息人士16日透露，几名朝鲜士兵最近几天越过东部战线韩朝军事分界线，韩军随后鸣枪警告。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E6%9C%9D%E9%B2%9C%E5%A3%AB%E5%85%B5%E8%B6%8A%E8%BF%87%E4%B8%9C%E9%83%A8%E6%88%98%E7%BA%BF%E9%9F%A9%E6%9C%9D%E5%86%9B%E4%BA%8B%E5%88%86%E7%95%8C%E7%BA%BF%EF%BC%8C%E9%9F%A9%E5%86%9B%E9%B8%A3%E6%9E%AA%E8%AD%A6%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786877357000.webp","sourceId":"rfi"},{"id":1786877107000,"createdDate":"2026-08-16 10:45","name":"法国国际广播电台","title":"金正恩携妻女参谒解放塔悼念阵亡苏军 普京发贺电提就国际议程中的紧迫议题合作","content":"朝鲜最高领导人金正恩携其女金主爱（音）周五在祖国解放（韩国称光复节）81周年前夕，参谒解放塔悼念阵亡苏军，强调朝俄关系强劲。俄罗斯总统普京也在解放日（15日）之际向金正恩发去贺电，强调了俄朝之间的友好关系，并提到了两国之间的“建设性合作”，这似乎是指朝鲜派兵援俄。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E9%87%91%E6%AD%A3%E6%81%A9%E6%90%BA%E5%A6%BB%E5%A5%B3%E5%8F%82%E8%B0%92%E8%A7%A3%E6%94%BE%E5%A1%94%E6%82%BC%E5%BF%B5%E9%98%B5%E4%BA%A1%E8%8B%8F%E5%86%9B-%E6%99%AE%E4%BA%AC%E5%8F%91%E8%B4%BA%E7%94%B5%E6%8F%90%E5%B0%B1%E5%9B%BD%E9%99%85%E8%AE%AE%E7%A8%8B%E4%B8%AD%E7%9A%84%E7%B4%A7%E8%BF%AB%E8%AE%AE%E9%A2%98%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786877107000.webp","sourceId":"rfi"},{"id":1786874241000,"createdDate":"2026-08-16 09:57","name":"法国国际广播电台","title":"伊朗军方要求派员入卡塔尔搜寻飞行员下落 指四革命卫队人员在科威特下落不明","content":"据伊朗媒体报导，一位伊朗军方官员周日表示，卡塔尔应允许伊朗方面派员入境，以调查那些德黑兰声称被卡塔尔军队俘获的飞行员的下落。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260816-%E4%BC%8A%E6%9C%97%E5%86%9B%E6%96%B9%E8%A6%81%E6%B1%82%E6%B4%BE%E5%91%98%E5%85%A5%E5%8D%A1%E5%A1%94%E5%B0%94%E6%90%9C%E5%AF%BB%E9%A3%9E%E8%A1%8C%E5%91%98%E4%B8%8B%E8%90%BD-%E6%8C%87%E5%9B%9B%E9%9D%A9%E5%91%BD%E5%8D%AB%E9%98%9F%E4%BA%BA%E5%91%98%E5%9C%A8%E7%A7%91%E5%A8%81%E7%89%B9%E4%B8%8B%E8%90%BD%E4%B8%8D%E6%98%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786874241000.webp","sourceId":"rfi"},{"id":1786872854000,"createdDate":"2026-08-16 09:34","name":"法国国际广播电台","title":"中方船只疑似在钓鱼岛周边进行海洋调查 日巡逻船电告停止","content":"据共同社报导，日本海上保安厅第十一管区海上保安本部16日发布消息称，15日下午4时50分左右，在冲绳县尖阁诸岛（中方称钓鱼岛）周边的专属经济区内，确认到一艘中国海洋调查船向海中延伸了类似金属线的物体。日本海上保安厅的巡逻船通过无线电要求其停止该行为，称未经日方同意不得进行海洋科学调查，中方调查船于15日晚间10时15分左右驶离该海域。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260816-%E4%B8%AD%E6%96%B9%E8%88%B9%E5%8F%AA%E7%96%91%E4%BC%BC%E5%9C%A8%E9%92%93%E9%B1%BC%E5%B2%9B%E5%91%A8%E8%BE%B9%E8%BF%9B%E8%A1%8C%E6%B5%B7%E6%B4%8B%E8%B0%83%E6%9F%A5-%E6%97%A5%E5%B7%A1%E9%80%BB%E8%88%B9%E7%94%B5%E5%91%8A%E5%81%9C%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786872854000.webp","sourceId":"rfi"},{"id":1786871337000,"createdDate":"2026-08-16 09:08","name":"法国国际广播电台","title":"菲防长与中国外交部、驻菲使馆论战持续 再批“勒索敲诈”","content":"菲律宾国防部周日对中国驻菲大使馆进行了回击，针对的是使馆近期就菲国防部长特奥多罗（GilbertTeodoro）言论所发表的声明；特奥多罗此前指控中方“掩盖”涉及在菲中国公民的非法活动。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E8%8F%B2%E9%98%B2%E9%95%BF%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8-%E9%A9%BB%E8%8F%B2%E4%BD%BF%E9%A6%86%E8%AE%BA%E6%88%98%E6%8C%81%E7%BB%AD-%E5%86%8D%E6%89%B9-%E5%8B%92%E7%B4%A2%E6%95%B2%E8%AF%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786871337000.webp","sourceId":"rfi"},{"id":1786871186000,"createdDate":"2026-08-16 09:06","name":"法国国际广播电台","title":"首艘中国集装箱船已启程经北极驶往欧洲","content":"一艘中国集装箱船于周六（8月16号）晚间启程，经由北极航线前往欧洲。这是这家亚洲航运巨头首次走这条航线，使其得以绕过中东地区。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260816-%E9%A6%96%E8%89%98%E4%B8%AD%E5%9B%BD%E9%9B%86%E8%A3%85%E7%AE%B1%E8%88%B9%E5%B7%B2%E5%90%AF%E7%A8%8B%E7%BB%8F%E5%8C%97%E6%9E%81%E9%A9%B6%E5%BE%80%E6%AC%A7%E6%B4%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786871186000.webp","sourceId":"rfi"},{"id":1786920446000,"createdDate":"2026-08-16 22:47","name":"法国国际广播电台","title":"特朗普宣布鉴于他和金正恩“关系非常好”，美国将大幅减少美韩联合军演","content":"美国总统特朗普周日(8月16日)宣布，鉴于他与朝鲜领导人金正恩“关系非常好”，美国将“大幅减少”参与与其长期盟友韩国举行的联合军事演习。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E9%89%B4%E4%BA%8E%E4%BB%96%E5%92%8C%E9%87%91%E6%AD%A3%E6%81%A9-%E5%85%B3%E7%B3%BB%E9%9D%9E%E5%B8%B8%E5%A5%BD-%EF%BC%8C%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%A4%A7%E5%B9%85%E5%87%8F%E5%B0%91%E7%BE%8E%E9%9F%A9%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786920446000.webp","sourceId":"rfi"},{"id":1786916556000,"createdDate":"2026-08-16 21:42","name":"法国国际广播电台","title":"巴西总统大选拉开竞选序幕：53%的选民为女性，争取女性选民支持成关键","content":"周日（8月16日），巴西左翼总统卢拉和右翼竞争对手弗拉维奥·博索纳罗正式启动竞选活动，他们分别在各自的政治大本营举行集会、争取支持者。外界预计，今年10月举行的总统大选将是一场势均力敌的较量。目前，双方都将目光投向一个可能决定大选结果的关键选民群体：女性选民。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89%E6%8B%89%E5%BC%80%E7%AB%9E%E9%80%89%E5%BA%8F%E5%B9%95-53-%E7%9A%84%E9%80%89%E6%B0%91%E4%B8%BA%E5%A5%B3%E6%80%A7%EF%BC%8C%E4%BA%89%E5%8F%96%E5%A5%B3%E6%80%A7%E9%80%89%E6%B0%91%E6%94%AF%E6%8C%81%E6%88%90%E5%85%B3%E9%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786916556000.webp","sourceId":"rfi"},{"id":1786912610000,"createdDate":"2026-08-16 20:36","name":"法国国际广播电台","title":"突尼斯:耕种者从北到南面临干旱","content":"在北非马格里布地区，突尼斯（laTunisie）的耕种者们越来越需要适应气候变化和局部干旱所带来的影响。在该国南部城市加贝斯(Gabès)，小农户们正以恢复传统耕作方式来应对缺水和水资源的枯竭。这是本台法广非洲组（RFIAfrique）于2026年8月16日星期天上网的最新法语特派记者（envoyéespéciale）采访报导之一。突尼斯加贝斯(Gabès)的沿海绿洲体系有世界上少有的之一，但正遭受缺水的威胁。突尼斯的中文国名也有译作突尼西亞（laTunisie)。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260816-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E7%AA%81%E5%B0%BC%E6%96%AF-%E5%86%9C%E6%B0%91%E4%BB%8E%E5%8C%97%E5%88%B0%E5%8D%97%E9%9D%A2%E4%B8%B4%E5%B9%B2%E6%97%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786912610000.webp","sourceId":"rfi"},{"id":1786912183000,"createdDate":"2026-08-16 20:29","name":"法国国际广播电台","title":"伊朗国会立法：接受美以等敌国媒体采访为犯罪","content":"据伊朗“东方报”（Shargh）报导，伊朗国会16日通过一项法案，本国民众只要接受敌视伊朗的美国或以色列媒体及这2国出资媒体的採访和其他形式交流，都将视为犯罪行为。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260816-%E4%BC%8A%E6%9C%97%E5%9B%BD%E4%BC%9A%E7%AB%8B%E6%B3%95-%E6%8E%A5%E5%8F%97%E7%BE%8E%E4%BB%A5%E7%AD%89%E6%95%8C%E5%9B%BD%E5%AA%92%E4%BD%93%E9%87%87%E8%AE%BF%E4%B8%BA%E7%8A%AF%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786912183000.webp","sourceId":"rfi"},{"id":1786909684000,"createdDate":"2026-08-16 19:48","name":"法国国际广播电台","title":"专访台湾学者方天赐：印度Z世代崛起，年轻人的愤怒会改变印度政治吗？","content":"近年来，国际社会的目光正越来越多地转向印度。随着印度的崛起，印度自身的政治与社会变化，以及中国与印度之间日益凸显的竞争，都受到越来越多的关注。因此，本台《印太纵览》围绕印度国内政治与中印关系，制作了两期专题节目，并邀请台湾国立清华大学亚洲政策中心学者方天赐先生坐客本台。方先生长期关注印度政治、中印关系以及南亚地区的发展，并曾多年驻地印度，对印度社会有着深入的观察和研究。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20260816-%E4%B8%93%E8%AE%BF%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85%E6%96%B9%E5%A4%A9%E8%B5%90-%E5%8D%B0%E5%BA%A6z%E4%B8%96%E4%BB%A3%E5%B4%9B%E8%B5%B7%EF%BC%8C%E5%B9%B4%E8%BD%BB%E4%BA%BA%E7%9A%84%E6%84%A4%E6%80%92%E4%BC%9A%E6%94%B9%E5%8F%98%E5%8D%B0%E5%BA%A6%E6%94%BF%E6%B2%BB%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786909684000.webp","sourceId":"rfi"},{"id":1786909070000,"createdDate":"2026-08-16 19:37","name":"法国国际广播电台","title":"中国不再需要“愚笨的汽车”——德国却还在生产它","content":"据德国《焦点》周刊报道，中国正在取消补贴，并重新整顿汽车市场。与此同时，新能源汽车和汽车出口正在蓬勃发展，而德国汽车品牌却在不断下滑。为什么？中国不再需要“愚笨的汽车”——德国却还在生产这种汽车。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260816-%E4%B8%AD%E5%9B%BD%E4%B8%8D%E5%86%8D%E9%9C%80%E8%A6%81-%E6%84%9A%E7%AC%A8%E7%9A%84%E6%B1%BD%E8%BD%A6-%E5%BE%B7%E5%9B%BD%E5%8D%B4%E8%BF%98%E5%9C%A8%E7%94%9F%E4%BA%A7%E5%AE%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786909070000.webp","sourceId":"rfi"},{"id":1786908145000,"createdDate":"2026-08-16 19:22","name":"法国国际广播电台","title":"中国著名维权律师高智晟“被失踪”已满九年！","content":"中国著名维权律师高智晟先生自2017年8月13日起“被失踪”，至今音讯全无，生死未卜。在他“被失踪”的9年间，中国当局一直拒绝提供任何讯息，甚至否认关押他的事实。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260816-%E4%B8%AD%E5%9B%BD%E8%91%97%E5%90%8D%E7%BB%B4%E6%9D%83%E5%BE%8B%E5%B8%88%E9%AB%98%E6%99%BA%E6%99%9F-%E8%A2%AB%E5%A4%B1%E8%B8%AA-%E5%B7%B2%E6%BB%A1%E4%B9%9D%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786908145000.webp","sourceId":"rfi"},{"id":1786907084000,"createdDate":"2026-08-16 19:04","name":"法国国际广播电台","title":"意大利博物馆4件文艺复兴时期艺术品失窃，总价值超7000万欧元","content":"意大利文化部门和当地媒体周日（8月16日）表示，在意大利传统节日“圣母升天节”庆祝活动期间，窃贼趁机从西西里岛墨西拿市一家博物馆盗走了4件被认为出自文艺复兴画家安东内洛·达·墨西拿（AntonellodaMessina）之手的艺术品，总价值超7000万欧元。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260816-%E6%84%8F%E5%A4%A7%E5%88%A9%E5%8D%9A%E7%89%A9%E9%A6%864%E4%BB%B6%E6%96%87%E8%89%BA%E5%A4%8D%E5%85%B4%E6%97%B6%E6%9C%9F%E8%89%BA%E6%9C%AF%E5%93%81%E5%A4%B1%E7%AA%83%EF%BC%8C%E6%80%BB%E4%BB%B7%E5%80%BC%E8%B6%857000%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786907084000.webp","sourceId":"rfi"},{"id":1786906351000,"createdDate":"2026-08-16 18:52","name":"法国国际广播电台","title":"立陶宛举办国际柯基犬大赛，来自9个国家的150只狗狗参赛","content":"周六（8月15日），第五届维尔纽斯柯基犬大赛在立陶宛首都维尔纽斯举行。主办方称，这是迄今规模最大的一届比赛。来自立陶宛、拉脱维亚、波兰、爱沙尼亚、德国、乌克兰、捷克、美国和英国的柯基犬及其主人参加了比赛。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260816-%E7%AB%8B%E9%99%B6%E5%AE%9B%E4%B8%BE%E5%8A%9E%E5%9B%BD%E9%99%85%E6%9F%AF%E5%9F%BA%E7%8A%AC%E5%A4%A7%E8%B5%9B%EF%BC%8C%E6%9D%A5%E8%87%AA9%E4%B8%AA%E5%9B%BD%E5%AE%B6%E7%9A%84150%E5%8F%AA%E7%8B%97%E7%8B%97%E5%8F%82%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786906351000.webp","sourceId":"rfi"},{"id":1786905400000,"createdDate":"2026-08-16 18:36","name":"法国国际广播电台","title":"匈牙利发生20多年来最严重大巴事故：一辆波兰大巴在高速路侧翻，造成12人死亡","content":"周六至周日（8月16日）夜间，一辆悬挂波兰牌照的大巴在匈牙利一条高速公路上发生严重事故，造成12人死亡、至少10人重伤。据悉，这是匈牙利20多年来发生的最严重大巴事故。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260816-%E5%8C%88%E7%89%99%E5%88%A9%E5%8F%91%E7%94%9F20%E5%A4%9A%E5%B9%B4%E6%9D%A5%E6%9C%80%E4%B8%A5%E9%87%8D%E5%A4%A7%E5%B7%B4%E4%BA%8B%E6%95%85-%E4%B8%80%E8%BE%86%E6%B3%A2%E5%85%B0%E5%A4%A7%E5%B7%B4%E5%9C%A8%E9%AB%98%E9%80%9F%E8%B7%AF%E4%BE%A7%E7%BF%BB%EF%BC%8C%E9%80%A0%E6%88%9012%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786905400000.webp","sourceId":"rfi"},{"id":1786904318000,"createdDate":"2026-08-16 18:18","name":"法国国际广播电台","title":"伊朗：悬赏3万美元奖励杀死或抓获美国士兵者，若是由“勇敢的伊朗女性完成”则奖金翻倍","content":"伊朗军方周日（8月16日）宣布，将悬赏3万美元，奖励任何杀死或抓获美国士兵的人，如果行动由女性实施，奖金将翻倍。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E4%BC%8A%E6%9C%97-%E6%82%AC%E8%B5%8F3%E4%B8%87%E7%BE%8E%E5%85%83%E5%A5%96%E5%8A%B1%E6%9D%80%E6%AD%BB%E6%88%96%E6%8A%93%E8%8E%B7%E7%BE%8E%E5%9B%BD%E5%A3%AB%E5%85%B5%E8%80%85%EF%BC%8C%E8%8B%A5%E6%98%AF%E7%94%B1-%E5%8B%87%E6%95%A2%E7%9A%84%E4%BC%8A%E6%9C%97%E5%A5%B3%E6%80%A7%E5%AE%8C%E6%88%90-%E5%88%99%E5%A5%96%E9%87%91%E7%BF%BB%E5%80%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786904318000.webp","sourceId":"rfi"},{"id":1786903555000,"createdDate":"2026-08-16 18:05","name":"法国国际广播电台","title":"加沙和平计划推进受阻：美国特使库什纳赴埃及会见哈马斯代表团，随后将访问以色列","content":"周日（8月16日），美国特使库什纳与哈马斯领导人在埃及举行了会谈。随后，他将访问以色列。当前，美国正试图弥合以色列与哈马斯关于如何落实由特朗普提出的和平计划方面存在的分歧。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E5%8A%A0%E6%B2%99%E5%92%8C%E5%B9%B3%E8%AE%A1%E5%88%92%E6%8E%A8%E8%BF%9B%E5%8F%97%E9%98%BB-%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF%E5%BA%93%E4%BB%80%E7%BA%B3%E8%B5%B4%E5%9F%83%E5%8F%8A%E4%BC%9A%E8%A7%81%E5%93%88%E9%A9%AC%E6%96%AF%EF%BC%8C%E9%9A%8F%E5%90%8E%E5%B0%86%E8%AE%BF%E9%97%AE%E4%BB%A5%E8%89%B2%E5%88%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786903555000.webp","sourceId":"rfi"},{"id":1786901933000,"createdDate":"2026-08-16 17:38","name":"法国国际广播电台","title":"俄乌猛烈互袭，造成至少16人死亡，或将有更多朝鲜士兵抵俄支援","content":"周日（8月16日），俄罗斯和乌克兰互相发动无人机和导弹袭击，造成至少16人死亡。法新社称，俄罗斯遭遇了自战争爆发以来规模最为庞大的袭击之一。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E4%BF%84%E4%B9%8C%E7%8C%9B%E7%83%88%E4%BA%92%E8%A2%AD%EF%BC%8C%E9%80%A0%E6%88%90%E8%87%B3%E5%B0%9116%E4%BA%BA%E6%AD%BB%E4%BA%A1%EF%BC%8C%E6%88%96%E5%B0%86%E6%9C%89%E6%9B%B4%E5%A4%9A%E6%9C%9D%E9%B2%9C%E5%A3%AB%E5%85%B5%E6%8A%B5%E4%BF%84%E6%94%AF%E6%8F%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786901933000.webp","sourceId":"rfi"},{"id":1786900891000,"createdDate":"2026-08-16 17:21","name":"法国国际广播电台","title":"特朗普民调跌至低点 经济与伊朗战事成共和党期中选举隐忧","content":"美国总统特朗普（DonaldTrump）支持度持续下滑，多项最新民调显示，他的整体支持率已跌至约33%至36%，接近或触及第二任期低点。选民对物价、通货膨胀和家庭财务状况的不满升高，民主党在经济议题上的评价也开始领先共和党。距离11月期中选举不到3个月，特朗普民调走弱可能拖累共和党争夺众议院及参议院席次。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260816-%E7%89%B9%E6%9C%97%E6%99%AE%E6%B0%91%E8%B0%83%E8%B7%8C%E8%87%B3%E4%BD%8E%E7%82%B9-%E7%BB%8F%E6%B5%8E%E4%B8%8E%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%8B%E6%88%90%E5%85%B1%E5%92%8C%E5%85%9A%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E9%9A%90%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786900891000.webp","sourceId":"rfi"},{"id":1786899229000,"createdDate":"2026-08-16 16:53","name":"法国国际广播电台","title":"非洲女足2026国家杯喀麦隆夺冠","content":"在北非马格里布地区，第14届非洲女子足球国家杯的决赛于2026年8月16日星期天晚在摩洛哥王国首都拉巴特（Rabat）举行。这场史无前例的冠军争夺赛最后是喀麦隆（leCameroun）以3比0战胜马拉维（leMalawi）问鼎。这是本台法广体育组（RFISport）有关非洲的最新法文消息之一。喀麦隆女足新任主教练是曾在中国执教的法国人迪米特里·利波夫（DimitriLipoff）。马拉维的中文国名也有译作馬拉威（leMalawi）。在此前夜，阿尔及利亚（l'Algérie）女足于8月15日星期六晚在拉巴特的奥林匹克体育场进行的季军争夺战中,以点球对决，战胜摩洛哥（leMaroc）女足，获得本届赛事的季军。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260816-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E5%A5%B3%E8%B6%B32026%E7%AC%AC14%E5%B1%8A%E5%9B%BD%E5%AE%B6%E6%9D%AF%E5%86%B3%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/16/1786899229000.webp","sourceId":"rfi"}]