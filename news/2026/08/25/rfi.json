[{"id":1787648240000,"createdDate":"2026-08-25 08:57","name":"法国国际广播电台","title":"特朗普在社媒连发三张与金正恩合影，分析指或急于和朝鲜恢复对话以抵消伊朗战争的压力","content":"周一（8月25日），特朗普在真相社交平台上连发三张与金正恩合影。据路透社此前发布长篇分析文章，称一名了解美韩官员讨论情况的人士透露，特朗普急于与朝鲜恢复谈判，希望在国际舞台上取得一项外交成果，以抵消伊朗战争给他带来的政治压力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%89%B9%E6%9C%97%E6%99%AE%E5%9C%A8%E7%A4%BE%E5%AA%92%E8%BF%9E%E5%8F%91%E4%B8%89%E5%BC%A0%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E5%90%88%E5%BD%B1%EF%BC%8C%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E6%80%A5%E4%BA%8E%E5%92%8C%E6%9C%9D%E9%B2%9C%E6%81%A2%E5%A4%8D%E5%AF%B9%E8%AF%9D%E4%BB%A5%E6%8A%B5%E6%B6%88%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E7%9A%84%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787648240000.webp","sourceId":"rfi"},{"id":1787646026000,"createdDate":"2026-08-25 08:20","name":"法国国际广播电台","title":"分析指或碍于9月特习会制裁名单暂不牵涉中国，外交部回应：中伊合作符合国际法，不应受到干涉或破坏","content":"中国外交部发言人周二（8月25日）在被问及美国针对伊朗实施的新一轮制裁时表示，中国与伊朗之间的合作是在国际法框架内开展的，不应受到任何干涉或破坏。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E7%A2%8D%E4%BA%8E9%E6%9C%88%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%88%B6%E8%A3%81%E5%90%8D%E5%8D%95%E6%9A%82%E4%B8%8D%E7%89%B5%E6%B6%89%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%B8%AD%E5%9B%BD%E7%A7%B0-%E4%B8%AD%E4%BC%8A%E5%90%88%E4%BD%9C%E7%AC%A6%E5%90%88%E5%9B%BD%E9%99%85%E6%B3%95%EF%BC%8C%E4%B8%8D%E5%BA%94%E5%8F%97%E5%88%B0%E5%B9%B2%E6%B6%89%E6%88%96%E7%A0%B4%E5%9D%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787646026000.webp","sourceId":"rfi"},{"id":1787645946000,"createdDate":"2026-08-25 08:19","name":"法国国际广播电台","title":"中国船只涉“割鳍”捕捞鲨鱼被基里巴斯海警拦截","content":"一艘中国船只涉嫌在太平洋“割鳍”捕捞鲨鱼被基里巴斯海事警察拦截，这是自八月初以来11个太平洋岛国联合打击非法捕捞行动中被拦截的第四艘船只。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260825-%E5%9F%BA%E9%87%8C%E5%B7%B4%E6%96%AF%E6%B5%B7%E8%AD%A6%E6%8B%A6%E6%88%AA%E4%B8%80%E8%89%98%E4%B8%AD%E5%9B%BD%E8%88%B9%E5%8F%AA-%E6%B6%89-%E5%89%B2%E9%B3%8D-%E6%8D%95%E6%8D%9E%E9%B2%A8%E9%B1%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645946000.webp","sourceId":"rfi"},{"id":1787645243000,"createdDate":"2026-08-25 08:07","name":"法国国际广播电台","title":"香港北都首个「片区开发」项目由「五中一港」财团中标 中资占重成日後主流？","content":"已被写入中国「十五五」规划的香港「北部都会区」发展计划（下称「北都」），纵使在京官多次发声推动下，港资财团对竞投项目仍然裹足不前，结果，作为北都首个「片区开发」的招标项目只收到两份标书，而中标者则是五家中资企业与一家港资发展商组成的财团以10.3亿港元（约1.13亿欧元）投得。评论认为，这可能开启以中资为主丶港资为次的香港发展新局面，反映中港资财团在香港大型发展的角色比重逆转。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260825-%E9%A6%99%E6%B8%AF%E5%8C%97%E9%83%BD%E9%A6%96%E4%B8%AA-%E7%89%87%E5%8C%BA%E5%BC%80%E5%8F%91-%E9%A1%B9%E7%9B%AE%E7%94%B1-%E4%BA%94%E4%B8%AD%E4%B8%80%E6%B8%AF-%E8%B4%A2%E5%9B%A2%E4%B8%AD%E6%A0%87-%E4%B8%AD%E8%B5%84%E5%8D%A0%E9%87%8D%E6%88%90%E6%97%A5%E5%BE%8C%E4%B8%BB%E6%B5%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645243000.webp","sourceId":"rfi"},{"id":1787644890000,"createdDate":"2026-08-25 08:01","name":"法国国际广播电台","title":"美国拟实施史上最大规模撤签行动：主要针对以商务和旅游签入境寻求庇护者，或波及多达20万人","content":"美联社周一（8月25日）发布的报道称，特朗普政府正准备撤销多达20万名外国人的商务和旅游签证。这些人曾申请美国庇护，或目前正在寻求庇护。如果这一措施最终实施，将成为美国历史上规模最大的一次单次大规模签证撤销行动，并很可能面临法律挑战。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E5%AE%9E%E6%96%BD%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%92%A4%E7%AD%BE%E8%A1%8C%E5%8A%A8-%E4%B8%BB%E8%A6%81%E9%92%88%E5%AF%B9%E4%BB%A5%E5%95%86%E5%8A%A1%E5%92%8C%E6%97%85%E6%B8%B8%E7%AD%BE%E5%85%A5%E5%A2%83%E5%AF%BB%E6%B1%82%E5%BA%87%E6%8A%A4%E8%80%85%EF%BC%8C%E6%88%96%E6%B3%A2%E5%8F%8A%E5%A4%9A%E8%BE%BE20%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787644890000.webp","sourceId":"rfi"},{"id":1787669521000,"createdDate":"2026-08-25 14:52","name":"法国国际广播电台","title":"联合国警告缅甸人权状况恶化，稀土非法开采助推冲突加剧","content":"周二（8月25日），联合国人权事务高级专员办事处在一份涵盖2025年6月至2026年5月期间的报告中指出，持续不断的冲突、军方暴力以及所谓“战争经济”的扩张，使平民面临严重困境。联合国称，缅甸人权状况已跌至新的低点。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E8%81%94%E5%90%88%E5%9B%BD%E8%AD%A6%E5%91%8A%E7%BC%85%E7%94%B8%E4%BA%BA%E6%9D%83%E7%8A%B6%E5%86%B5%E6%81%B6%E5%8C%96%EF%BC%8C%E7%A8%80%E5%9C%9F%E9%9D%9E%E6%B3%95%E5%BC%80%E9%87%87%E5%8A%A9%E6%8E%A8%E5%86%B2%E7%AA%81%E5%8A%A0%E5%89%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787669521000.webp","sourceId":"rfi"},{"id":1787668424000,"createdDate":"2026-08-25 14:33","name":"法国国际广播电台","title":"“甲醛白菜”事件持续发酵  日韩等国紧急清查中国进口白菜","content":"近日，“甲醛白菜”事件在中国互联网持续发酵，引发舆论关注。综合中央社等多家媒体25日的报道，韩国与日本等邻国紧急清查从中国进口的白菜，看是否含有甲醛等物质。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260825-%E7%94%B2%E9%86%9B%E7%99%BD%E8%8F%9C-%E4%BA%8B%E4%BB%B6%E6%8C%81%E7%BB%AD%E5%8F%91%E9%85%B5-%E6%97%A5%E9%9F%A9%E7%AD%89%E5%9B%BD%E7%B4%A7%E6%80%A5%E6%B8%85%E6%9F%A5%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%8F%A3%E7%99%BD%E8%8F%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787668424000.webp","sourceId":"rfi"},{"id":1787659008000,"createdDate":"2026-08-25 11:56","name":"法国国际广播电台","title":"当中国机器人加速进化：第二届世界人形机器人运动会落幕","content":"第二届世界人形机器人运动会8月26日在北京落幕。从短跑、障碍赛，再到举重、乒乓、甚至足球、体操和拳击，人形机器人的力量、速度、灵活性控制等正在从竞争中愈发精进。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E5%BD%93%E4%B8%AD%E5%9B%BD%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%8A%A0%E9%80%9F%E8%BF%9B%E5%8C%96-%E7%AC%AC%E4%BA%8C%E5%B1%8A%E4%B8%96%E7%95%8C%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E8%BF%90%E5%8A%A8%E4%BC%9A%E8%90%BD%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787659008000.webp","sourceId":"rfi"},{"id":1787657474000,"createdDate":"2026-08-25 11:31","name":"法国国际广播电台","title":"台风接踵而至：中国南方持续降雨　广西逾5万人紧急转移","content":"受台风“纳拉”的影响，中国南方多地持续遭遇强降雨，广西的洪灾进一步扩大，已有超过5.4万人被转移。与此同时，新一轮台风“沙德尔”正向日本南部和台湾北部移动，预计本周晚些时候会影响中国福建沿海，华南地区防汛形势面临新的压力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E5%8F%B0%E9%A3%8E%E6%8E%A5%E8%B8%B5%E8%80%8C%E8%87%B3-%E4%B8%AD%E5%9B%BD%E5%8D%97%E6%96%B9%E6%8C%81%E7%BB%AD%E9%99%8D%E9%9B%A8-%E5%B9%BF%E8%A5%BF%E9%80%BE5%E4%B8%87%E4%BA%BA%E7%B4%A7%E6%80%A5%E8%BD%AC%E7%A7%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787657474000.webp","sourceId":"rfi"},{"id":1787655071000,"createdDate":"2026-08-25 10:51","name":"法国国际广播电台","title":"比亚迪为何押注“轻型純电海獭”抢滩日本市场？中国导弹加入后，高超音速威慑即将到来？","content":"大家好，欢迎收听法国报纸摘要，周二8月25日本台所订阅的法国主流日报的头版头条虽不相同但均以法国国内事务为主。与中国相关的报道则见于《回声报》的论坛版何企业版。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260825-%E6%AF%94%E4%BA%9A%E8%BF%AA%E4%B8%BA%E4%BD%95%E6%8A%BC%E6%B3%A8-%E8%BD%BB%E5%9E%8B%E7%B4%94%E7%94%B5%E6%B5%B7%E7%8D%AD-%E6%8A%A2%E6%BB%A9%E6%97%A5%E6%9C%AC%E5%B8%82%E5%9C%BA-%E4%B8%AD%E5%9B%BD%E5%AF%BC%E5%BC%B9%E5%8A%A0%E5%85%A5%E5%90%8E-%E9%AB%98%E8%B6%85%E9%9F%B3%E9%80%9F%E5%A8%81%E6%85%91%E5%8D%B3%E5%B0%86%E5%88%B0%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787655071000.webp","sourceId":"rfi"},{"id":1787653829000,"createdDate":"2026-08-25 10:30","name":"法国国际广播电台","title":"路透卫星图像分析：南海岛礁出现新建筑，中国正加速扩建南海军事设施","content":"周二（8月25日），根据路透社对卫星图像的分析，在存在主权争议的南海西沙群岛，一座靠近羚羊礁（AntelopeReef）的小岛上出现了新的设施。分析人士认为，中国正在那里建设规模最大的军事基地。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E8%B7%AF%E9%80%8F%E5%8D%AB%E6%98%9F%E5%9B%BE%E5%83%8F%E5%88%86%E6%9E%90-%E5%8D%97%E6%B5%B7%E5%B2%9B%E7%A4%81%E5%87%BA%E7%8E%B0%E6%96%B0%E5%BB%BA%E7%AD%91%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%AD%A3%E5%8A%A0%E9%80%9F%E6%89%A9%E5%BB%BA%E5%8D%97%E6%B5%B7%E5%86%9B%E4%BA%8B%E8%AE%BE%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787653829000.webp","sourceId":"rfi"},{"id":1787652619000,"createdDate":"2026-08-25 10:10","name":"法国国际广播电台","title":"台湾女艺人因向日本国宝\"佛足石\"泼洒不明液体而被逮捕","content":"综合共同社与中央社消息，日本奈良警署22日以涉嫌在奈良市药师寺向被指定为国宝的“佛足石”泼洒液体、违反《文化财保护法》为由，逮捕了来自台湾自称从事主持人工作的蔡宜臻（38岁）。蔡宜臻的经纪人周二（8月24日）发表道歉声明，表示对于此事造成的社会关注及相关困扰深感抱歉。据称由于蔡宜臻正在日本接受调查，无法与其本人取得联系。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260825-%E5%8F%B0%E6%B9%BE%E5%A5%B3%E8%89%BA%E4%BA%BA%E5%9B%A0%E5%90%91%E6%97%A5%E6%9C%AC%E5%9B%BD%E5%AE%9D-%E4%BD%9B%E8%B6%B3%E7%9F%B3-%E6%B3%BC%E6%B4%92%E4%B8%8D%E6%98%8E%E6%B6%B2%E4%BD%93%E8%80%8C%E8%A2%AB%E9%80%AE%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787652619000.webp","sourceId":"rfi"},{"id":1787651066000,"createdDate":"2026-08-25 09:44","name":"法国国际广播电台","title":"高兟案判决结果周二公布：高兟因“损害英雄烈士荣誉”被判刑三年","content":"一家人权组织向法新社证实：中国艺术家高兟因创作针对中国前领导人毛泽东的讽刺性雕塑，被控“损害英雄烈士名誉和荣誉”，周二（8月25日）被判处三年有期徒刑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E9%AB%98%E5%85%9F%E6%A1%88%E5%88%A4%E5%86%B3%E7%BB%93%E6%9E%9C%E5%91%A8%E4%BA%8C%E5%85%AC%E5%B8%83-%E9%AB%98%E5%85%9F%E5%9B%A0-%E6%8D%9F%E5%AE%B3%E8%8B%B1%E9%9B%84%E7%83%88%E5%A3%AB%E8%8D%A3%E8%AA%89-%E8%A2%AB%E5%88%A4%E5%88%91%E4%B8%89%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787651066000.webp","sourceId":"rfi"},{"id":1787649212000,"createdDate":"2026-08-25 09:13","name":"法国国际广播电台","title":"消息人士透露：特朗普拟以工业产能过剩为由，对中国加征7.5%新关税，但美方称不会影响9月特习会","content":"据三名知情人士透露，美国总统特朗普正考虑对中国加征一项新的关税。其中两名要求匿名的知情人士表示，特朗普正在考虑将这项新关税设定为7.5%。相关内部讨论仍在最终敲定阶段。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%9F%E4%BB%A5%E5%B7%A5%E4%B8%9A%E4%BA%A7%E8%83%BD%E8%BF%87%E5%89%A9%E4%B8%BA%E7%94%B1%EF%BC%8C%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8A%A0%E5%BE%817-5-%E6%96%B0%E5%85%B3%E7%A8%8E%EF%BC%8C%E4%BD%86%E7%BE%8E%E6%96%B9%E7%A7%B0%E4%B8%8D%E4%BC%9A%E5%BD%B1%E5%93%8D9%E6%9C%88%E7%89%B9%E4%B9%A0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787649212000.webp","sourceId":"rfi"},{"id":1787645887000,"createdDate":"2026-08-25 08:18","name":"法国国际广播电台","title":"石破茂前首相参加的议员联盟发表声明 要求政府以最强硬的言辞谴责特朗普政权","content":"日本“跨党派人权外交议员联盟”24日就美国将国际刑事法院（ICC）院长赤根智子列入制裁对象一事，在国会内召开全体会议，会议通过了谴责特朗普政府相关措施的声明，表示要“以最强烈的措辞予以谴责，并要求日本政府采取行动”。而日本内阁官房长官木原稔24日在记者会上，就美国政府将国际刑事法院（ICC）院长赤根智子列入制裁对象一事表示：“我们此前一直与（赤根女士）保持密切沟通。如果有必要支持，我们将切实予以支持。”","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260825-%E7%9F%B3%E7%A0%B4%E8%8C%82%E5%89%8D%E9%A6%96%E7%9B%B8%E5%8F%82%E5%8A%A0%E7%9A%84%E8%AE%AE%E5%91%98%E8%81%94%E7%9B%9F%E5%8F%91%E8%A1%A8%E5%A3%B0%E6%98%8E-%E8%A6%81%E6%B1%82%E6%94%BF%E5%BA%9C%E4%BB%A5%E6%9C%80%E5%BC%BA%E7%A1%AC%E7%9A%84%E8%A8%80%E8%BE%9E%E8%B0%B4%E8%B4%A3%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645887000.webp","sourceId":"rfi"}]