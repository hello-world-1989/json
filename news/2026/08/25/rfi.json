[{"id":1787648240000,"createdDate":"2026-08-25 08:57","name":"法国国际广播电台","title":"特朗普在社媒连发三张与金正恩合影，分析指或急于和朝鲜恢复对话以抵消伊朗战争的压力","content":"周一（8月25日），特朗普在真相社交平台上连发三张与金正恩合影。据路透社此前发布长篇分析文章，称一名了解美韩官员讨论情况的人士透露，特朗普急于与朝鲜恢复谈判，希望在国际舞台上取得一项外交成果，以抵消伊朗战争给他带来的政治压力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%89%B9%E6%9C%97%E6%99%AE%E5%9C%A8%E7%A4%BE%E5%AA%92%E8%BF%9E%E5%8F%91%E4%B8%89%E5%BC%A0%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E5%90%88%E5%BD%B1%EF%BC%8C%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E6%80%A5%E4%BA%8E%E5%92%8C%E6%9C%9D%E9%B2%9C%E6%81%A2%E5%A4%8D%E5%AF%B9%E8%AF%9D%E4%BB%A5%E6%8A%B5%E6%B6%88%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E7%9A%84%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787648240000.webp","sourceId":"rfi"},{"id":1787646026000,"createdDate":"2026-08-25 08:20","name":"法国国际广播电台","title":"分析指或碍于9月特习会制裁名单暂不牵涉中国，外交部回应：中伊合作符合国际法，不应受到干涉或破坏","content":"中国外交部发言人周二（8月25日）在被问及美国针对伊朗实施的新一轮制裁时表示，中国与伊朗之间的合作是在国际法框架内开展的，不应受到任何干涉或破坏。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E7%A2%8D%E4%BA%8E9%E6%9C%88%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%88%B6%E8%A3%81%E5%90%8D%E5%8D%95%E6%9A%82%E4%B8%8D%E7%89%B5%E6%B6%89%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%B8%AD%E5%9B%BD%E7%A7%B0-%E4%B8%AD%E4%BC%8A%E5%90%88%E4%BD%9C%E7%AC%A6%E5%90%88%E5%9B%BD%E9%99%85%E6%B3%95%EF%BC%8C%E4%B8%8D%E5%BA%94%E5%8F%97%E5%88%B0%E5%B9%B2%E6%B6%89%E6%88%96%E7%A0%B4%E5%9D%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787646026000.webp","sourceId":"rfi"},{"id":1787645946000,"createdDate":"2026-08-25 08:19","name":"法国国际广播电台","title":"中国船只涉“割鳍”捕捞鲨鱼被基里巴斯海警拦截","content":"一艘中国船只涉嫌在太平洋“割鳍”捕捞鲨鱼被基里巴斯海事警察拦截，这是自八月初以来11个太平洋岛国联合打击非法捕捞行动中被拦截的第四艘船只。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260825-%E5%9F%BA%E9%87%8C%E5%B7%B4%E6%96%AF%E6%B5%B7%E8%AD%A6%E6%8B%A6%E6%88%AA%E4%B8%80%E8%89%98%E4%B8%AD%E5%9B%BD%E8%88%B9%E5%8F%AA-%E6%B6%89-%E5%89%B2%E9%B3%8D-%E6%8D%95%E6%8D%9E%E9%B2%A8%E9%B1%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645946000.webp","sourceId":"rfi"},{"id":1787645243000,"createdDate":"2026-08-25 08:07","name":"法国国际广播电台","title":"香港北都首个「片区开发」项目由「五中一港」财团中标 中资占重成日後主流？","content":"已被写入中国「十五五」规划的香港「北部都会区」发展计划（下称「北都」），纵使在京官多次发声推动下，港资财团对竞投项目仍然裹足不前，结果，作为北都首个「片区开发」的招标项目只收到两份标书，而中标者则是五家中资企业与一家港资发展商组成的财团以10.3亿港元（约1.13亿欧元）投得。评论认为，这可能开启以中资为主丶港资为次的香港发展新局面，反映中港资财团在香港大型发展的角色比重逆转。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260825-%E9%A6%99%E6%B8%AF%E5%8C%97%E9%83%BD%E9%A6%96%E4%B8%AA-%E7%89%87%E5%8C%BA%E5%BC%80%E5%8F%91-%E9%A1%B9%E7%9B%AE%E7%94%B1-%E4%BA%94%E4%B8%AD%E4%B8%80%E6%B8%AF-%E8%B4%A2%E5%9B%A2%E4%B8%AD%E6%A0%87-%E4%B8%AD%E8%B5%84%E5%8D%A0%E9%87%8D%E6%88%90%E6%97%A5%E5%BE%8C%E4%B8%BB%E6%B5%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645243000.webp","sourceId":"rfi"},{"id":1787644890000,"createdDate":"2026-08-25 08:01","name":"法国国际广播电台","title":"美国拟实施史上最大规模撤签行动：主要针对以商务和旅游签入境寻求庇护者，或波及多达20万人","content":"美联社周一（8月25日）发布的报道称，特朗普政府正准备撤销多达20万名外国人的商务和旅游签证。这些人曾申请美国庇护，或目前正在寻求庇护。如果这一措施最终实施，将成为美国历史上规模最大的一次单次大规模签证撤销行动，并很可能面临法律挑战。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E5%AE%9E%E6%96%BD%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%92%A4%E7%AD%BE%E8%A1%8C%E5%8A%A8-%E4%B8%BB%E8%A6%81%E9%92%88%E5%AF%B9%E4%BB%A5%E5%95%86%E5%8A%A1%E5%92%8C%E6%97%85%E6%B8%B8%E7%AD%BE%E5%85%A5%E5%A2%83%E5%AF%BB%E6%B1%82%E5%BA%87%E6%8A%A4%E8%80%85%EF%BC%8C%E6%88%96%E6%B3%A2%E5%8F%8A%E5%A4%9A%E8%BE%BE20%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787644890000.webp","sourceId":"rfi"}]