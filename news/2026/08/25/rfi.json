[{"id":1787648240000,"createdDate":"2026-08-25 08:57","name":"法国国际广播电台","title":"特朗普在社媒连发三张与金正恩合影，分析指或急于和朝鲜恢复对话以抵消伊朗战争的压力","content":"周一（8月25日），特朗普在真相社交平台上连发三张与金正恩合影。据路透社此前发布长篇分析文章，称一名了解美韩官员讨论情况的人士透露，特朗普急于与朝鲜恢复谈判，希望在国际舞台上取得一项外交成果，以抵消伊朗战争给他带来的政治压力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%89%B9%E6%9C%97%E6%99%AE%E5%9C%A8%E7%A4%BE%E5%AA%92%E8%BF%9E%E5%8F%91%E4%B8%89%E5%BC%A0%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E5%90%88%E5%BD%B1%EF%BC%8C%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E6%80%A5%E4%BA%8E%E5%92%8C%E6%9C%9D%E9%B2%9C%E6%81%A2%E5%A4%8D%E5%AF%B9%E8%AF%9D%E4%BB%A5%E6%8A%B5%E6%B6%88%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E7%9A%84%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787648240000.webp","sourceId":"rfi"},{"id":1787646026000,"createdDate":"2026-08-25 08:20","name":"法国国际广播电台","title":"分析指或碍于9月特习会制裁名单暂不牵涉中国，外交部回应：中伊合作符合国际法，不应受到干涉或破坏","content":"中国外交部发言人周二（8月25日）在被问及美国针对伊朗实施的新一轮制裁时表示，中国与伊朗之间的合作是在国际法框架内开展的，不应受到任何干涉或破坏。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E5%88%86%E6%9E%90%E6%8C%87%E6%88%96%E7%A2%8D%E4%BA%8E9%E6%9C%88%E7%89%B9%E4%B9%A0%E4%BC%9A%E5%88%B6%E8%A3%81%E5%90%8D%E5%8D%95%E6%9A%82%E4%B8%8D%E7%89%B5%E6%B6%89%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%B8%AD%E5%9B%BD%E7%A7%B0-%E4%B8%AD%E4%BC%8A%E5%90%88%E4%BD%9C%E7%AC%A6%E5%90%88%E5%9B%BD%E9%99%85%E6%B3%95%EF%BC%8C%E4%B8%8D%E5%BA%94%E5%8F%97%E5%88%B0%E5%B9%B2%E6%B6%89%E6%88%96%E7%A0%B4%E5%9D%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787646026000.webp","sourceId":"rfi"},{"id":1787645946000,"createdDate":"2026-08-25 08:19","name":"法国国际广播电台","title":"中国船只涉“割鳍”捕捞鲨鱼被基里巴斯海警拦截","content":"一艘中国船只涉嫌在太平洋“割鳍”捕捞鲨鱼被基里巴斯海事警察拦截，这是自八月初以来11个太平洋岛国联合打击非法捕捞行动中被拦截的第四艘船只。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260825-%E5%9F%BA%E9%87%8C%E5%B7%B4%E6%96%AF%E6%B5%B7%E8%AD%A6%E6%8B%A6%E6%88%AA%E4%B8%80%E8%89%98%E4%B8%AD%E5%9B%BD%E8%88%B9%E5%8F%AA-%E6%B6%89-%E5%89%B2%E9%B3%8D-%E6%8D%95%E6%8D%9E%E9%B2%A8%E9%B1%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645946000.webp","sourceId":"rfi"},{"id":1787645243000,"createdDate":"2026-08-25 08:07","name":"法国国际广播电台","title":"香港北都首个「片区开发」项目由「五中一港」财团中标 中资占重成日後主流？","content":"已被写入中国「十五五」规划的香港「北部都会区」发展计划（下称「北都」），纵使在京官多次发声推动下，港资财团对竞投项目仍然裹足不前，结果，作为北都首个「片区开发」的招标项目只收到两份标书，而中标者则是五家中资企业与一家港资发展商组成的财团以10.3亿港元（约1.13亿欧元）投得。评论认为，这可能开启以中资为主丶港资为次的香港发展新局面，反映中港资财团在香港大型发展的角色比重逆转。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260825-%E9%A6%99%E6%B8%AF%E5%8C%97%E9%83%BD%E9%A6%96%E4%B8%AA-%E7%89%87%E5%8C%BA%E5%BC%80%E5%8F%91-%E9%A1%B9%E7%9B%AE%E7%94%B1-%E4%BA%94%E4%B8%AD%E4%B8%80%E6%B8%AF-%E8%B4%A2%E5%9B%A2%E4%B8%AD%E6%A0%87-%E4%B8%AD%E8%B5%84%E5%8D%A0%E9%87%8D%E6%88%90%E6%97%A5%E5%BE%8C%E4%B8%BB%E6%B5%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645243000.webp","sourceId":"rfi"},{"id":1787644890000,"createdDate":"2026-08-25 08:01","name":"法国国际广播电台","title":"美国拟实施史上最大规模撤签行动：主要针对以商务和旅游签入境寻求庇护者，或波及多达20万人","content":"美联社周一（8月25日）发布的报道称，特朗普政府正准备撤销多达20万名外国人的商务和旅游签证。这些人曾申请美国庇护，或目前正在寻求庇护。如果这一措施最终实施，将成为美国历史上规模最大的一次单次大规模签证撤销行动，并很可能面临法律挑战。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E5%AE%9E%E6%96%BD%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%92%A4%E7%AD%BE%E8%A1%8C%E5%8A%A8-%E4%B8%BB%E8%A6%81%E9%92%88%E5%AF%B9%E4%BB%A5%E5%95%86%E5%8A%A1%E5%92%8C%E6%97%85%E6%B8%B8%E7%AD%BE%E5%85%A5%E5%A2%83%E5%AF%BB%E6%B1%82%E5%BA%87%E6%8A%A4%E8%80%85%EF%BC%8C%E6%88%96%E6%B3%A2%E5%8F%8A%E5%A4%9A%E8%BE%BE20%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787644890000.webp","sourceId":"rfi"},{"id":1787669521000,"createdDate":"2026-08-25 14:52","name":"法国国际广播电台","title":"联合国警告缅甸人权状况恶化，稀土非法开采助推冲突加剧","content":"周二（8月25日），联合国人权事务高级专员办事处在一份涵盖2025年6月至2026年5月期间的报告中指出，持续不断的冲突、军方暴力以及所谓“战争经济”的扩张，使平民面临严重困境。联合国称，缅甸人权状况已跌至新的低点。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E8%81%94%E5%90%88%E5%9B%BD%E8%AD%A6%E5%91%8A%E7%BC%85%E7%94%B8%E4%BA%BA%E6%9D%83%E7%8A%B6%E5%86%B5%E6%81%B6%E5%8C%96%EF%BC%8C%E7%A8%80%E5%9C%9F%E9%9D%9E%E6%B3%95%E5%BC%80%E9%87%87%E5%8A%A9%E6%8E%A8%E5%86%B2%E7%AA%81%E5%8A%A0%E5%89%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787669521000.webp","sourceId":"rfi"},{"id":1787668424000,"createdDate":"2026-08-25 14:33","name":"法国国际广播电台","title":"“甲醛白菜”事件持续发酵  日韩等国紧急清查中国进口白菜","content":"近日，“甲醛白菜”事件在中国互联网持续发酵，引发舆论关注。综合中央社等多家媒体25日的报道，韩国与日本等邻国紧急清查从中国进口的白菜，看是否含有甲醛等物质。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260825-%E7%94%B2%E9%86%9B%E7%99%BD%E8%8F%9C-%E4%BA%8B%E4%BB%B6%E6%8C%81%E7%BB%AD%E5%8F%91%E9%85%B5-%E6%97%A5%E9%9F%A9%E7%AD%89%E5%9B%BD%E7%B4%A7%E6%80%A5%E6%B8%85%E6%9F%A5%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%8F%A3%E7%99%BD%E8%8F%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787668424000.webp","sourceId":"rfi"},{"id":1787659008000,"createdDate":"2026-08-25 11:56","name":"法国国际广播电台","title":"当中国机器人加速进化：第二届世界人形机器人运动会落幕","content":"第二届世界人形机器人运动会8月26日在北京落幕。从短跑、障碍赛，再到举重、乒乓、甚至足球、体操和拳击，人形机器人的力量、速度、灵活性控制等正在从竞争中愈发精进。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E5%BD%93%E4%B8%AD%E5%9B%BD%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%8A%A0%E9%80%9F%E8%BF%9B%E5%8C%96-%E7%AC%AC%E4%BA%8C%E5%B1%8A%E4%B8%96%E7%95%8C%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E8%BF%90%E5%8A%A8%E4%BC%9A%E8%90%BD%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787659008000.webp","sourceId":"rfi"},{"id":1787657474000,"createdDate":"2026-08-25 11:31","name":"法国国际广播电台","title":"台风接踵而至：中国南方持续降雨　广西逾5万人紧急转移","content":"受台风“纳拉”的影响，中国南方多地持续遭遇强降雨，广西的洪灾进一步扩大，已有超过5.4万人被转移。与此同时，新一轮台风“沙德尔”正向日本南部和台湾北部移动，预计本周晚些时候会影响中国福建沿海，华南地区防汛形势面临新的压力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E5%8F%B0%E9%A3%8E%E6%8E%A5%E8%B8%B5%E8%80%8C%E8%87%B3-%E4%B8%AD%E5%9B%BD%E5%8D%97%E6%96%B9%E6%8C%81%E7%BB%AD%E9%99%8D%E9%9B%A8-%E5%B9%BF%E8%A5%BF%E9%80%BE5%E4%B8%87%E4%BA%BA%E7%B4%A7%E6%80%A5%E8%BD%AC%E7%A7%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787657474000.webp","sourceId":"rfi"},{"id":1787655071000,"createdDate":"2026-08-25 10:51","name":"法国国际广播电台","title":"比亚迪为何押注“轻型純电海獭”抢滩日本市场？中国导弹加入后，高超音速威慑即将到来？","content":"大家好，欢迎收听法国报纸摘要，周二8月25日本台所订阅的法国主流日报的头版头条虽不相同但均以法国国内事务为主。与中国相关的报道则见于《回声报》的论坛版何企业版。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260825-%E6%AF%94%E4%BA%9A%E8%BF%AA%E4%B8%BA%E4%BD%95%E6%8A%BC%E6%B3%A8-%E8%BD%BB%E5%9E%8B%E7%B4%94%E7%94%B5%E6%B5%B7%E7%8D%AD-%E6%8A%A2%E6%BB%A9%E6%97%A5%E6%9C%AC%E5%B8%82%E5%9C%BA-%E4%B8%AD%E5%9B%BD%E5%AF%BC%E5%BC%B9%E5%8A%A0%E5%85%A5%E5%90%8E-%E9%AB%98%E8%B6%85%E9%9F%B3%E9%80%9F%E5%A8%81%E6%85%91%E5%8D%B3%E5%B0%86%E5%88%B0%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787655071000.webp","sourceId":"rfi"},{"id":1787653829000,"createdDate":"2026-08-25 10:30","name":"法国国际广播电台","title":"路透卫星图像分析：南海岛礁出现新建筑，中国正加速扩建南海军事设施","content":"周二（8月25日），根据路透社对卫星图像的分析，在存在主权争议的南海西沙群岛，一座靠近羚羊礁（AntelopeReef）的小岛上出现了新的设施。分析人士认为，中国正在那里建设规模最大的军事基地。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E8%B7%AF%E9%80%8F%E5%8D%AB%E6%98%9F%E5%9B%BE%E5%83%8F%E5%88%86%E6%9E%90-%E5%8D%97%E6%B5%B7%E5%B2%9B%E7%A4%81%E5%87%BA%E7%8E%B0%E6%96%B0%E5%BB%BA%E7%AD%91%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%AD%A3%E5%8A%A0%E9%80%9F%E6%89%A9%E5%BB%BA%E5%8D%97%E6%B5%B7%E5%86%9B%E4%BA%8B%E8%AE%BE%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787653829000.webp","sourceId":"rfi"},{"id":1787652619000,"createdDate":"2026-08-25 10:10","name":"法国国际广播电台","title":"台湾女艺人因向日本国宝\"佛足石\"泼洒不明液体而被逮捕","content":"综合共同社与中央社消息，日本奈良警署22日以涉嫌在奈良市药师寺向被指定为国宝的“佛足石”泼洒液体、违反《文化财保护法》为由，逮捕了来自台湾自称从事主持人工作的蔡宜臻（38岁）。蔡宜臻的经纪人周二（8月24日）发表道歉声明，表示对于此事造成的社会关注及相关困扰深感抱歉。据称由于蔡宜臻正在日本接受调查，无法与其本人取得联系。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260825-%E5%8F%B0%E6%B9%BE%E5%A5%B3%E8%89%BA%E4%BA%BA%E5%9B%A0%E5%90%91%E6%97%A5%E6%9C%AC%E5%9B%BD%E5%AE%9D-%E4%BD%9B%E8%B6%B3%E7%9F%B3-%E6%B3%BC%E6%B4%92%E4%B8%8D%E6%98%8E%E6%B6%B2%E4%BD%93%E8%80%8C%E8%A2%AB%E9%80%AE%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787652619000.webp","sourceId":"rfi"},{"id":1787651066000,"createdDate":"2026-08-25 09:44","name":"法国国际广播电台","title":"高兟案判决结果周二公布：高兟因“损害英雄烈士荣誉”被判刑三年","content":"一家人权组织向法新社证实：中国艺术家高兟因创作针对中国前领导人毛泽东的讽刺性雕塑，被控“损害英雄烈士名誉和荣誉”，周二（8月25日）被判处三年有期徒刑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E9%AB%98%E5%85%9F%E6%A1%88%E5%88%A4%E5%86%B3%E7%BB%93%E6%9E%9C%E5%91%A8%E4%BA%8C%E5%85%AC%E5%B8%83-%E9%AB%98%E5%85%9F%E5%9B%A0-%E6%8D%9F%E5%AE%B3%E8%8B%B1%E9%9B%84%E7%83%88%E5%A3%AB%E8%8D%A3%E8%AA%89-%E8%A2%AB%E5%88%A4%E5%88%91%E4%B8%89%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787651066000.webp","sourceId":"rfi"},{"id":1787649212000,"createdDate":"2026-08-25 09:13","name":"法国国际广播电台","title":"消息人士透露：特朗普拟以工业产能过剩为由，对中国加征7.5%新关税，但美方称不会影响9月特习会","content":"据三名知情人士透露，美国总统特朗普正考虑对中国加征一项新的关税。其中两名要求匿名的知情人士表示，特朗普正在考虑将这项新关税设定为7.5%。相关内部讨论仍在最终敲定阶段。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260825-%E6%B6%88%E6%81%AF%E4%BA%BA%E5%A3%AB%E9%80%8F%E9%9C%B2-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%9F%E4%BB%A5%E5%B7%A5%E4%B8%9A%E4%BA%A7%E8%83%BD%E8%BF%87%E5%89%A9%E4%B8%BA%E7%94%B1%EF%BC%8C%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8A%A0%E5%BE%817-5-%E6%96%B0%E5%85%B3%E7%A8%8E%EF%BC%8C%E4%BD%86%E7%BE%8E%E6%96%B9%E7%A7%B0%E4%B8%8D%E4%BC%9A%E5%BD%B1%E5%93%8D9%E6%9C%88%E7%89%B9%E4%B9%A0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787649212000.webp","sourceId":"rfi"},{"id":1787645887000,"createdDate":"2026-08-25 08:18","name":"法国国际广播电台","title":"石破茂前首相参加的议员联盟发表声明 要求政府以最强硬的言辞谴责特朗普政权","content":"日本“跨党派人权外交议员联盟”24日就美国将国际刑事法院（ICC）院长赤根智子列入制裁对象一事，在国会内召开全体会议，会议通过了谴责特朗普政府相关措施的声明，表示要“以最强烈的措辞予以谴责，并要求日本政府采取行动”。而日本内阁官房长官木原稔24日在记者会上，就美国政府将国际刑事法院（ICC）院长赤根智子列入制裁对象一事表示：“我们此前一直与（赤根女士）保持密切沟通。如果有必要支持，我们将切实予以支持。”","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260825-%E7%9F%B3%E7%A0%B4%E8%8C%82%E5%89%8D%E9%A6%96%E7%9B%B8%E5%8F%82%E5%8A%A0%E7%9A%84%E8%AE%AE%E5%91%98%E8%81%94%E7%9B%9F%E5%8F%91%E8%A1%A8%E5%A3%B0%E6%98%8E-%E8%A6%81%E6%B1%82%E6%94%BF%E5%BA%9C%E4%BB%A5%E6%9C%80%E5%BC%BA%E7%A1%AC%E7%9A%84%E8%A8%80%E8%BE%9E%E8%B0%B4%E8%B4%A3%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787645887000.webp","sourceId":"rfi"},{"id":1787701236000,"createdDate":"2026-08-25 23:40","name":"法国国际广播电台","title":"尼泊尔：国际藏学学术会议突然被取消，是否有来自中国的压力？","content":"原定于8月23日至29日在尼泊尔首都加德满都举行的一次国际藏学学术会议在临近开幕前突然被取消了线下形式、改为线上举行。这一改变是否来自中国的压力呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260825-%E5%B0%BC%E6%B3%8A%E5%B0%94-%E5%9B%BD%E9%99%85%E8%97%8F%E5%AD%A6%E5%AD%A6%E6%9C%AF%E4%BC%9A%E8%AE%AE%E7%AA%81%E7%84%B6%E8%A2%AB%E5%8F%96%E6%B6%88%EF%BC%8C%E6%98%AF%E5%90%A6%E6%9D%A5%E8%87%AA%E4%B8%AD%E5%9B%BD%E7%9A%84%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787701236000.webp","sourceId":"rfi"},{"id":1787697335000,"createdDate":"2026-08-25 22:35","name":"法国国际广播电台","title":"中印关系开始出现一定程度的缓和","content":"中印边界问题特别代表第25次会晤于8月25日在北京举行。中印双方同意持续对话处理边界问题，迹象显示中印两国外交有所缓和。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260825-%E4%B8%AD%E5%8D%B0%E5%85%B3%E7%B3%BB%E5%BC%80%E5%A7%8B%E5%87%BA%E7%8E%B0%E4%B8%80%E5%AE%9A%E7%A8%8B%E5%BA%A6%E7%9A%84%E7%BC%93%E5%92%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787697335000.webp","sourceId":"rfi"},{"id":1787693121000,"createdDate":"2026-08-25 21:25","name":"法国国际广播电台","title":"泽连斯基曝光俄乌终战三构想","content":"乌克兰总统泽连斯基表示，乌方认为美国斡旋结束俄乌战争的机会窗口可持续至明年夏季结束，已与美国及欧洲官员拟定一页构想，准备提交俄方。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260825-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%9B%9D%E5%85%89%E4%BF%84%E4%B9%8C%E7%BB%88%E6%88%98%E4%B8%89%E6%9E%84%E6%83%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787693121000.webp","sourceId":"rfi"},{"id":1787693059000,"createdDate":"2026-08-25 21:24","name":"法国国际广播电台","title":"特朗普要更名安大略湖（Lake Ontario）","content":"8月25日，美国总统特朗普表示，他正在“认真考虑将安大略湖更名为美国湖”。特朗普认为加拿大多年来一直在享受华盛顿的慷慨。他强调说，“我们不再打算与安大略省开展太多业务”，他指的是位于底特律附近的加拿大安大略省，该省的汽车产业实力雄厚。这一想法让人想起他重返政坛后的首批决定之一：将墨西哥湾更名为美洲湾。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260825-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E6%9B%B4%E5%90%8D%E5%AE%89%E5%A4%A7%E7%95%A5%E6%B9%96-lake-ontario","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787693059000.webp","sourceId":"rfi"},{"id":1787692864000,"createdDate":"2026-08-25 21:21","name":"法国国际广播电台","title":"叙利亚库尔德武装宣布解散","content":"叙利亚库尔德武装主导的“叙利亚民主力量”领导人马兹卢姆·阿卜迪（MazloumAbdi）25日宣布解散这支曾与“伊斯兰国”极端组织作战的武装力量。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260825-%E5%8F%99%E5%88%A9%E4%BA%9A%E5%BA%93%E5%B0%94%E5%BE%B7%E6%AD%A6%E8%A3%85%E5%AE%A3%E5%B8%83%E8%A7%A3%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787692864000.webp","sourceId":"rfi"},{"id":1787692771000,"createdDate":"2026-08-25 21:19","name":"法国国际广播电台","title":"霍尔木兹：阿曼和伊朗讨论“临时航道”、扫雷事宜","content":"伊朗和阿曼外长8月25日讨论了一项框架协议，旨在霍尔木兹海峡建立一条“临时航道”，并为这条对全球贸易至关重要的战略水道开展扫雷行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260825-%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9-%E9%98%BF%E6%9B%BC%E5%92%8C%E4%BC%8A%E6%9C%97%E8%AE%A8%E8%AE%BA-%E4%B8%B4%E6%97%B6%E8%88%AA%E9%81%93-%E6%89%AB%E9%9B%B7%E4%BA%8B%E5%AE%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787692771000.webp","sourceId":"rfi"},{"id":1787692631000,"createdDate":"2026-08-25 21:17","name":"法国国际广播电台","title":"薄瓜瓜给加拿大支招    “可将中国视为长期合作伙伴”","content":"近期，薄瓜瓜在社群平台X（原Twitter）上频繁就中加贸易、国际政经以及悼念前中国国务院总理朱镕基等事件发表长文评论有关。其言论与动向常引发外界及海外舆论的各种解读与议论。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260825-%E8%96%84%E7%93%9C%E7%93%9C%E7%BB%99%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%94%AF%E6%8B%9B-%E5%8F%AF%E5%B0%86%E4%B8%AD%E5%9B%BD%E8%A7%86%E4%B8%BA%E9%95%BF%E6%9C%9F%E5%90%88%E4%BD%9C%E4%BC%99%E4%BC%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787692631000.webp","sourceId":"rfi"},{"id":1787692303000,"createdDate":"2026-08-25 21:11","name":"法国国际广播电台","title":"伊朗首都加油站排起长龙","content":"8月25日，伊朗首都德黑兰多地出现加油站排长队现象，大量司机在油箱尚未耗尽前提前加油，担心战争持续导致燃油供应中断或未来价格上涨。德黑兰加油站出现明显拥堵，不少司机甚至在油量还剩一半时便开始排队加油。部分加油站实行限额供应，每辆车一次只能购买20升汽油，导致司机需要多次返回。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260825-%E4%BC%8A%E6%9C%97%E9%A6%96%E9%83%BD%E5%8A%A0%E6%B2%B9%E7%AB%99%E6%8E%92%E8%B5%B7%E9%95%BF%E9%BE%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787692303000.webp","sourceId":"rfi"},{"id":1787691129000,"createdDate":"2026-08-25 20:52","name":"法国国际广播电台","title":"从特朗普要把安大略湖改名为美国湖说起","content":"美国总统特朗普与加拿大的贸易谈判破裂后，恼羞成怒继续威胁，他说正考虑将加拿大和美国之间的安大略湖（LakeOntario）改为“美国湖”（LakeAmerica），再次挑战加拿大人的尊严底线。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260825-%E4%BB%8E%E7%89%B9%E6%9C%97%E6%99%AE%E8%A6%81%E6%8A%8A%E5%AE%89%E5%A4%A7%E7%95%A5%E6%B9%96%E6%94%B9%E5%90%8D%E4%B8%BA%E7%BE%8E%E5%9B%BD%E6%B9%96%E8%AF%B4%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787691129000.webp","sourceId":"rfi"},{"id":1787691079000,"createdDate":"2026-08-25 20:51","name":"法国国际广播电台","title":"美媒：CIA局长前往莫斯科","content":"据美国媒体CBS和Axios报道，中央情报局局长约翰·拉特克利夫（JohnRatcliffe）于周二前往莫斯科。华盛顿和莫斯科方面均尚未证实此次行程。此次访问的目的尚不清楚，这将是拉特克利夫自2025年上任以来首次访问俄罗斯。Axios和CBS新闻没有具体说明约翰·拉特克利夫将与哪些俄罗斯官员会面，也没有说明会谈议程。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260825-%E7%BE%8E%E5%AA%92-cia%E5%B1%80%E9%95%BF%E5%89%8D%E5%BE%80%E8%8E%AB%E6%96%AF%E7%A7%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787691079000.webp","sourceId":"rfi"},{"id":1787690670000,"createdDate":"2026-08-25 20:44","name":"法国国际广播电台","title":"约旦准备开通与北京的直飞航线","content":"约旦皇家航空公司与中国国际航空公司在北京签署谅解备忘录，旨在深化双方的商业和运营合作。此次合作的主要目标是筹备未来开通约旦和中国首都之间的直飞航线，目前这两个城市之间尚无定期直航服务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260825-%E7%BA%A6%E6%97%A6%E5%87%86%E5%A4%87%E5%BC%80%E9%80%9A%E4%B8%8E%E5%8C%97%E4%BA%AC%E7%9A%84%E7%9B%B4%E9%A3%9E%E8%88%AA%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787690670000.webp","sourceId":"rfi"},{"id":1787690443000,"createdDate":"2026-08-25 20:40","name":"法国国际广播电台","title":"法宇航员索菲·阿德诺二次太空行走","content":"法国宇航员索菲·阿德诺（SophieAdenot）8月25日二次从国际空间站出舱，开始舱外活动，此次舱外活动持续了4个半小时，更换了天线。大约在20分钟后，阿德诺走出漆黑的空间站，与她的美国宇航员同伴阿尼尔·梅农（AnilMenon）会合。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260825-%E6%B3%95%E5%AE%87%E8%88%AA%E5%91%98%E7%B4%A2%E8%8F%B2%C2%B7%E9%98%BF%E5%BE%B7%E8%AF%BA%E4%BA%8C%E6%AC%A1%E5%A4%AA%E7%A9%BA%E8%A1%8C%E8%B5%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787690443000.webp","sourceId":"rfi"},{"id":1787690010000,"createdDate":"2026-08-25 20:33","name":"法国国际广播电台","title":"美国歌星多莉·帕顿（Dolly Parton）离世","content":"美国创作型歌手、演员、女商人和慈善家多莉·帕顿(DollyParton)周二去世，享年80岁。美国总统特朗普25日表示，她是“数百万人的真正损失”，全国降半旗致哀。特朗普写道：“从来没有像她这样的人；以后也不会再有了”，这就是中国人说的前无古人、后无来者。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260825-%E7%BE%8E%E5%9B%BD%E6%AD%8C%E6%98%9F%E5%A4%9A%E8%8E%89%C2%B7%E5%B8%95%E9%A1%BF-dolly-parton-%E7%A6%BB%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787690010000.webp","sourceId":"rfi"},{"id":1787681061000,"createdDate":"2026-08-25 18:04","name":"法国国际广播电台","title":"加宣布对美实施15%至50%报复性关税","content":"加拿大将从9月8日起对一系列美国产品加征15%至50%的关税，并表示如果其汽车行业受到美国新关税的影响，加拿大将采取报复措施。加拿大财政部长商鹏飞（François-PhilippeChampagne）补充说：渥太华“并非有意”发动这场贸易战，这场贸易战对加拿大而言是一个“前所未有的挑战”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260825-%E5%8A%A0%E5%AE%A3%E5%B8%83%E5%AF%B9%E7%BE%8E%E5%AE%9E%E6%96%BD15-%E8%87%B350-%E6%8A%A5%E5%A4%8D%E6%80%A7%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787681061000.webp","sourceId":"rfi"},{"id":1787679390000,"createdDate":"2026-08-25 17:36","name":"法国国际广播电台","title":"美国务院：准备撤销20万人签证    锁定申请政庇者","content":"美国国务院证实了媒体此前的报道。国务院25日表示，特朗普政府准备吊销已申请或正寻求美国庇护身分的外国人士商务和旅游签证，影响多达20万人；若此措施得以实施，将成为美国史上规模最大的单次签证吊销行动，且可能面临法律诉讼。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260825-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2-%E5%87%86%E5%A4%87%E6%92%A4%E9%94%8020%E4%B8%87%E4%BA%BA%E7%AD%BE%E8%AF%81-%E9%94%81%E5%AE%9A%E7%94%B3%E8%AF%B7%E6%94%BF%E5%BA%87%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787679390000.webp","sourceId":"rfi"},{"id":1787678349000,"createdDate":"2026-08-25 17:19","name":"法国国际广播电台","title":"加拿大研究组织：美俄假资讯介入阿省独立运动 华人圈成为假资讯温床","content":"加拿大数码媒体研究网络（CDMRN）、DisinfoWatch以及利载拿大学（UniversityofRegina）近期发布的调查报告相继提出警告，来自俄罗斯的隐蔽资讯战网络与美国极右翼舆论生态，正深度介入艾伯塔省（Alberta，又译阿省）的分离主义运动。有加拿大华人担心，封闭的华文圈内更容易受到影响，甚至在客观效果上与北京的大外宣叙事不谋而合。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8C%97%E7%BE%8E%E6%9D%A5%E9%B8%BF/20260825-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E7%A0%94%E7%A9%B6%E7%BB%84%E7%BB%87-%E7%BE%8E%E4%BF%84%E5%81%87%E8%B5%84%E8%AE%AF%E4%BB%8B%E5%85%A5%E9%98%BF%E7%9C%81%E7%8B%AC%E7%AB%8B%E8%BF%90%E5%8A%A8-%E5%8D%8E%E4%BA%BA%E5%9C%88%E6%88%90%E4%B8%BA%E5%81%87%E8%B5%84%E8%AE%AF%E6%B8%A9%E5%BA%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/25/1787678349000.webp","sourceId":"rfi"}]