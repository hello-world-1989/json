[{"id":1786013343000,"createdDate":"2026-08-06 10:49","name":"法国国际广播电台","title":"脱下军装的敏昂莱抗议声中首访泰国：推动双边关系正常化以绕过东盟层面的掣肘","content":"缅甸前军政府首脑敏昂莱（MinAungHlaing）周四在曼谷与泰国总理阿努廷会面，这是他作为平民领导人首次访问邻国泰国，旨在为其被国际社会孤立的国家重返外交舞台寻求支持。与此同时，16个泰国公民社会团体发表联合声明，反对敏昂莱正式访问泰国，呼吁曼谷政府不要赋予缅甸军政府“虚假的正当性”，并应与缅甸人民站在一起。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260806-%E6%8A%97%E8%AE%AE%E5%A3%B0%E4%B8%AD%E8%84%B1%E4%B8%8B%E5%86%9B%E8%A3%85%E7%9A%84%E6%95%8F%E6%98%82%E8%8E%B1%E9%A6%96%E8%AE%BF%E6%B3%B0%E5%9B%BD-%E6%8E%A8%E5%8A%A8%E5%8F%8C%E8%BE%B9%E5%85%B3%E7%B3%BB%E6%AD%A3%E5%B8%B8%E5%8C%96%E4%BB%A5%E7%BB%95%E8%BF%87%E4%B8%9C%E7%9B%9F%E5%B1%82%E9%9D%A2%E7%9A%84%E6%8E%A3%E8%82%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786013343000.webp","sourceId":"rfi"},{"id":1786012399000,"createdDate":"2026-08-06 10:33","name":"法国国际广播电台","title":"中国海警船与军舰南海相撞发生近1年后 官方证实2名烈士被追授武警忠诚卫士","content":"中国官方已确认两名海警人员于去年8月在南中国海执行“一线”任务时殉职；这是中方首次明显承认在涉及两艘中国船只的一起备受关注的碰撞事故中有人员丧生。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260806-%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E8%88%B9%E4%B8%8E%E5%86%9B%E8%88%B0%E5%8D%97%E6%B5%B7%E7%9B%B8%E6%92%9E%E5%8F%91%E7%94%9F%E8%BF%911%E5%B9%B4%E5%90%8E-%E5%AE%98%E6%96%B9%E8%AF%81%E5%AE%9E2%E5%90%8D%E7%83%88%E5%A3%AB%E8%A2%AB%E8%BF%BD%E6%8E%88%E6%AD%A6%E8%AD%A6%E5%BF%A0%E8%AF%9A%E5%8D%AB%E5%A3%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786012399000.webp","sourceId":"rfi"},{"id":1786012388000,"createdDate":"2026-08-06 10:33","name":"法国国际广播电台","title":"中东动荡未止  亚洲敲响警钟","content":"全球关注中东动荡能否在外交斡旋中显现和解曙光之际，亚洲地区的军事安全动向同样令人关切，日本防卫政策突破性转变；中国持续展示强大军事实力；时值南海紧张局势持续升温，台湾军演较以往更受国际关注，美太平洋司令强调海空航行自由且不允许任何国家主导印太地区。马来西亚国防部长呼吁坚持东盟中心地位，维护地区独立与平衡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260806-%E4%B8%AD%E4%B8%9C%E5%8A%A8%E8%8D%A1%E6%9C%AA%E6%AD%A2-%E4%BA%9A%E6%B4%B2%E6%95%B2%E5%93%8D%E8%AD%A6%E9%92%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786012388000.webp","sourceId":"rfi"},{"id":1786010479000,"createdDate":"2026-08-06 10:01","name":"法国国际广播电台","title":"韩产业通商部长谈中国“996+”令其震惊 指52小时工作周需修订","content":"有关部长们对“每周52小时工作制特别豁免”条款的立场明显存在分歧，这是韩国政府正在推进的《超级特区特别法》中的关键争议点之一。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260806-%E9%9F%A9%E4%BA%A7%E4%B8%9A%E9%80%9A%E5%95%86%E9%83%A8%E9%95%BF%E8%B0%88%E4%B8%AD%E5%9B%BD-996-%E4%BB%A4%E5%85%B6%E9%9C%87%E6%83%8A-%E6%8C%8752%E5%B0%8F%E6%97%B6%E5%B7%A5%E4%BD%9C%E5%91%A8%E9%9C%80%E4%BF%AE%E8%AE%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786010479000.webp","sourceId":"rfi"},{"id":1786006810000,"createdDate":"2026-08-06 09:00","name":"法国国际广播电台","title":"自2030年起，电动或混动飞机或将执飞欧洲商业航线","content":"据多家法媒6日报道，非政府组织交通与环境协会和三家正在研发电动或混合动力飞机的欧洲初创工业公司表示，欧洲将在未来几年生产电池动力飞机，用于短途飞行，预计能够运送10至90人。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260806-%E8%87%AA2030%E5%B9%B4%E8%B5%B7%EF%BC%8C%E7%94%B5%E5%8A%A8%E6%88%96%E6%B7%B7%E5%8A%A8%E9%A3%9E%E6%9C%BA%E6%88%96%E5%B0%86%E6%89%A7%E9%A3%9E%E6%AC%A7%E6%B4%B2%E5%95%86%E4%B8%9A%E8%88%AA%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786006810000.webp","sourceId":"rfi"},{"id":1786006139000,"createdDate":"2026-08-06 08:48","name":"法国国际广播电台","title":"美最早周四宣布对多晶硅衍生品征15%关税 对硅片、电池和模块等设底价","content":"据路透社援引四位知情人士报导，特朗普政府最早将于周四宣布对太阳能电池板和半导体生产的关键原材料——多晶硅的衍生产品征收15%的关税，并实施一系列最低限价措施。此举旨在保护美国多晶硅工厂，以应对中方在芯片供应链领域日益增强的雄心。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260806-%E7%BE%8E%E6%9C%80%E6%97%A9%E5%91%A8%E5%9B%9B%E5%AE%A3%E5%B8%83%E5%AF%B9%E5%A4%9A%E6%99%B6%E7%A1%85%E8%A1%8D%E7%94%9F%E5%93%81%E5%BE%8115-%E5%85%B3%E7%A8%8E-%E5%AF%B9%E7%A1%85%E7%89%87-%E7%94%B5%E6%B1%A0%E5%92%8C%E6%A8%A1%E5%9D%97%E7%AD%89%E8%AE%BE%E5%BA%95%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786006139000.webp","sourceId":"rfi"},{"id":1786004859000,"createdDate":"2026-08-06 08:27","name":"法国国际广播电台","title":"全球逾13国使用能全面监控受害者的中国LightSpy软件，美国网安公司警示：监控渐成一种商品","content":"彭博社报道称，据美国网络安全公司最新研究指出，一款由中国开发的名为LightSpy数字间谍软件已演变成更全面的监控技术，目前已在超过13个国家使用。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260806-%E5%85%A8%E7%90%83%E9%80%BE13%E5%9B%BD%E4%BD%BF%E7%94%A8%E8%83%BD%E5%85%A8%E9%9D%A2%E7%9B%91%E6%8E%A7%E7%9A%84%E4%B8%AD%E5%9B%BDlightspy%E8%BD%AF%E4%BB%B6%EF%BC%8C%E7%BE%8E%E5%9B%BD%E7%BD%91%E5%AE%89%E5%85%AC%E5%8F%B8%E8%AD%A6%E7%A4%BA-%E7%9B%91%E6%8E%A7%E6%B8%90%E6%88%90%E4%B8%80%E7%A7%8D%E5%95%86%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786004859000.webp","sourceId":"rfi"},{"id":1786004190000,"createdDate":"2026-08-06 08:16","name":"法国国际广播电台","title":"中国再收紧资金外流：向境外保单收益徵税20% 香港受影响","content":"中国内地继整顿非法跨境经营证券业务券商後，似有进一步收紧居民在境外资产及资金流动的监管，据传媒报道，中国税务当局的徵税行动正进一步扩展至包括香港在内的境外保险保单收益，北京和杭州更已对香港保单的分红及利息收益徵收20%税款。虽然有关措施未普遍推行，具体适用范围有待官方说明，但已引发保险相关金融股价下跌。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260806-%E4%B8%AD%E5%9B%BD%E5%86%8D%E6%94%B6%E7%B4%A7%E8%B5%84%E9%87%91%E5%A4%96%E6%B5%81-%E5%90%91%E5%A2%83%E5%A4%96%E4%BF%9D%E5%8D%95%E6%94%B6%E7%9B%8A%E5%BE%B5%E7%A8%8E20-%E9%A6%99%E6%B8%AF%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786004190000.webp","sourceId":"rfi"},{"id":1786004017000,"createdDate":"2026-08-06 08:13","name":"法国国际广播电台","title":"《苹果》受查逾五年无果　港府终停调查 惟充公黎智英财产继续 11月底聆讯","content":"香港政府藉国安法律拘捕壹传媒创办人黎智英及旗下的前《苹果日报》高层后，再罕有地引用《公司条例》委任会计师调查壹传媒事务，但审查超过五年後，在没有公布任何报告的情况下，以「没有需要」为由，终止调查。不过，针对黎智英约1.27亿港元(下同，折算约欧元)的个人财产充公程序亦继续进行，早前突然取消的聆讯，已改为排期在11月30日进行。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260806-%E8%8B%B9%E6%9E%9C-%E5%8F%97%E6%9F%A5%E9%80%BE%E4%BA%94%E5%B9%B4%E6%97%A0%E6%9E%9C-%E6%B8%AF%E5%BA%9C%E7%BB%88%E5%81%9C%E8%B0%83%E6%9F%A5-%E6%83%9F%E5%85%85%E5%85%AC%E9%BB%8E%E6%99%BA%E8%8B%B1%E8%B4%A2%E4%BA%A7%E7%BB%A7%E7%BB%AD-11%E6%9C%88%E5%BA%95%E8%81%86%E8%AE%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786004017000.webp","sourceId":"rfi"},{"id":1786003812000,"createdDate":"2026-08-06 08:10","name":"法国国际广播电台","title":"高市早苗在纪念广岛原子弹爆炸81周年仪式上为修改“无核三原则”留下伏笔","content":"8月6日，广岛迎来美国投下原子弹81周年。日本时间6日上午8时起，在广岛市中区的和平纪念公园举行和平纪念仪式。广岛市市长松井一实在《和平宣言》中呼吁每一位市民采取行动，不要让实现废除核武器仅仅停留在理想层面。以美国对伊朗发动攻击为代表，世界各地的战争与冲突仍接连不断，使用核武器的风险愈发具有现实性。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260806-%E5%B9%BF%E5%B2%9B%E4%B8%BE%E8%A1%8C%E5%8E%9F%E5%AD%90%E5%BC%B9%E7%88%86%E7%82%B881%E5%91%A8%E5%B9%B4%E5%92%8C%E5%B9%B3%E7%BA%AA%E5%BF%B5%E4%BB%AA%E5%BC%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/06/1786003812000.webp","sourceId":"rfi"}]