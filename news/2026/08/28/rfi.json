[{"id":1787942490000,"createdDate":"2026-08-28 18:41","name":"法国国际广播电台","title":"中尼边界山地海啸的根本原因 ：山体滑坡还是冰山崩塌？","content":"8月26日发生在喜马拉雅山区中国西藏与尼泊尔边境的泥石流是山洪灾难规模空前，造成巨大的生命与财产损失，目前各国的专家们正在就此一灾难所造成的原因举行分析调查，随着时间的推移，事故原因也日渐明朗，虽然到目前为止依然存在许多未知数。如果说在第一时间专家们一致认为冰川崩塌是导致此次山地海啸的原因，将气候变化等几乎不可抗拒的因素列为是主要原因，经过两天的观察，多名专家倾向于认为在冰川崩塌之前就已经发生了山体滑坡，指出导致此一巨大灾难的正真原因是山体滑坡才是而并非是冰川崩塌，因此，需要调查的是造成山体滑坡的原因究竟是什么。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260828-%E4%B8%AD%E5%B0%BC%E8%BE%B9%E7%95%8C%E5%B1%B1%E5%9C%B0%E6%B5%B7%E5%95%B8%E7%9A%84%E6%A0%B9%E6%9C%AC%E5%8E%9F%E5%9B%A0-%E5%B1%B1%E4%BD%93%E6%BB%91%E5%9D%A1%E8%BF%98%E6%98%AF%E5%86%B0%E5%B1%B1%E5%B4%A9%E5%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787942490000.webp","sourceId":"rfi"},{"id":1787940121000,"createdDate":"2026-08-28 18:02","name":"法国国际广播电台","title":"北约对中国涉嫌间谍活动产生警觉的更多细节曝光","content":"据调查记者马蒂厄·福鲁8月28日报道：自涉嫌间谍活动的加拿大籍女实习生克莱尔·张（ClaireZhang）今年4月被发现徘徊在北约最高指挥官美国空军上将亚历克苏斯·格林克维奇（AlexusGrynkewich）的办公室附近，并于7月被捕以来，随后发生的一系列事件促使比利时安全部门怀疑，北约内部及外部均有同伙涉案。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260828-%E5%8C%97%E7%BA%A6%E5%AF%B9%E4%B8%AD%E5%9B%BD%E6%B6%89%E5%AB%8C%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E4%BA%A7%E7%94%9F%E8%AD%A6%E8%A7%89%E7%9A%84%E6%9B%B4%E5%A4%9A%E7%BB%86%E8%8A%82%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787940121000.webp","sourceId":"rfi"},{"id":1787938036000,"createdDate":"2026-08-28 17:27","name":"法国国际广播电台","title":"中国房地产预售模式迎来重大调整：房子交付后才能获得按揭贷款，最长贷款期限延至40年","content":"路透社发布报道称，中国周五（8月28日）出台一系列新规，目标是降低房地产开发商对期房预售款的依赖。几十年来，中国房地产开发商一直采用商品房预售模式，即在住房尚未建成、尚未达到交付条件之前就开始销售，以此来筹集资金，但这是一种高负债、高周转的经营模式。自2021年房地产危机以来，这一模式逐渐难以为继。资金短缺，项目停工引发购房者抗议，也进一步打击了市场信心。因此，当局希望能够通过周五颁布的新规控制相关风险，重新提振市场信心。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E4%B8%AD%E5%9B%BD%E6%88%BF%E5%9C%B0%E4%BA%A7%E9%A2%84%E5%94%AE%E6%A8%A1%E5%BC%8F%E8%BF%8E%E6%9D%A5%E9%87%8D%E5%A4%A7%E8%B0%83%E6%95%B4-%E6%88%BF%E5%AD%90%E4%BA%A4%E4%BB%98%E5%90%8E%E6%89%8D%E8%83%BD%E8%8E%B7%E5%BE%97%E6%8C%89%E6%8F%AD%E8%B4%B7%E6%AC%BE%EF%BC%8C%E6%9C%80%E9%95%BF%E8%B4%B7%E6%AC%BE%E6%9C%9F%E9%99%90%E5%BB%B6%E8%87%B340%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787938036000.webp","sourceId":"rfi"},{"id":1787935175000,"createdDate":"2026-08-28 16:39","name":"法国国际广播电台","title":"伊朗战事满半年  美国陷入新泥淖","content":"美国与以色列对伊朗发动战争满6个月，原本预期数周内结束的军事行动，如今演变成一场持久冲突。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260828-%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%8B%E6%BB%A1%E5%8D%8A%E5%B9%B4-%E7%BE%8E%E5%9B%BD%E9%99%B7%E5%85%A5%E6%96%B0%E6%B3%A5%E6%B7%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787935175000.webp","sourceId":"rfi"},{"id":1787934715000,"createdDate":"2026-08-28 16:31","name":"法国国际广播电台","title":"泰国新规生效：当局警告“惹事生非”的游客将被驱逐出境","content":"泰国针对从事非法活动被定罪的外国人的新规定于今天周五生效。政府警告那些“惹事生非”的问题游客会被驱逐出境。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260828-%E6%B3%B0%E5%9B%BD%E6%96%B0%E8%A7%84%E7%94%9F%E6%95%88-%E5%BD%93%E5%B1%80%E8%AD%A6%E5%91%8A-%E6%83%B9%E4%BA%8B%E7%94%9F%E9%9D%9E-%E7%9A%84%E6%B8%B8%E5%AE%A2%E5%B0%86%E8%A2%AB%E9%A9%B1%E9%80%90%E5%87%BA%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787934715000.webp","sourceId":"rfi"},{"id":1787931312000,"createdDate":"2026-08-28 15:35","name":"法国国际广播电台","title":"德国工业界加大对总理默茨施压 要求他对北京采取更强硬立场","content":"路透社28日柏林电：德国工业界正加大对总理默茨施压，要求他对北京采取更强硬的立场；各企业呼吁采取更强有力的措施，以应对他们所称的中国竞争对手带来的不公平竞争。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260828-%E5%BE%B7%E5%9B%BD%E5%B7%A5%E4%B8%9A%E7%95%8C%E5%8A%A0%E5%A4%A7%E5%AF%B9%E6%80%BB%E7%90%86%E9%BB%98%E8%8C%A8%E6%96%BD%E5%8E%8B-%E8%A6%81%E6%B1%82%E4%BB%96%E5%AF%B9%E5%8C%97%E4%BA%AC%E9%87%87%E5%8F%96%E6%9B%B4%E5%BC%BA%E7%A1%AC%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787931312000.webp","sourceId":"rfi"},{"id":1787930450000,"createdDate":"2026-08-28 15:20","name":"法国国际广播电台","title":"台湾中选会否决“鞭刑入法”公投提案","content":"台湾中选会周五（8月28日）审议三项公投提案，其中由国民党立委提出的“鞭刑入法”被否决。中选会表示，鞭刑做法违背台湾在国际人权方面的承诺。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260828-%E5%8F%B0%E6%B9%BE%E4%B8%AD%E9%80%89%E4%BC%9A%E5%90%A6%E5%86%B3-%E9%9E%AD%E5%88%91%E5%85%A5%E6%B3%95-%E5%85%AC%E6%8A%95%E6%8F%90%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787930450000.webp","sourceId":"rfi"},{"id":1787928920000,"createdDate":"2026-08-28 14:55","name":"法国国际广播电台","title":"法国和德国联合发布声明呼吁释放法德人权与法治奖获得者邹幸彤","content":"因纪念天安门事件而被判有罪的律师邹幸彤周五表示她将在狱中继续抗争。法国和德国外交部上周联合发布声明对邹幸彤被判有罪深表遗憾，呼吁释放这位荣获2023年法德人权与法治奖的香港民主活动家。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260828-%E6%B3%95%E5%9B%BD%E5%92%8C%E5%BE%B7%E5%9B%BD%E8%81%94%E5%90%88%E5%8F%91%E5%B8%83%E5%A3%B0%E6%98%8E%E5%91%BC%E5%90%81%E9%87%8A%E6%94%BE%E6%B3%95%E5%BE%B7%E4%BA%BA%E6%9D%83%E4%B8%8E%E6%B3%95%E6%B2%BB%E5%A5%96%E8%8E%B7%E5%BE%97%E8%80%85%E9%82%B9%E5%B9%B8%E5%BD%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787928920000.webp","sourceId":"rfi"},{"id":1787928468000,"createdDate":"2026-08-28 14:47","name":"法国国际广播电台","title":"中尼边境灾难：已知近590人遇难  堰塞湖风险  冰川崩塌是主因？","content":"尼泊尔和中国西藏之间的喜马拉雅地区周三遭受毁灭性洪水袭击，死亡人数还在不断上升。周五，救援人员仍在与时间赛跑，继续搜寻幸存者，而洪水再次来袭的威胁依然存在。洪水过后堆积的碎片形成了的堰塞湖的湖水周五已开始溢出，迫使中尼两边一度暂停救援行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260828-%E4%B8%AD%E5%B0%BC%E8%BE%B9%E5%A2%83%E7%81%BE%E9%9A%BE-%E5%B7%B2%E7%9F%A5%E8%BF%91590%E4%BA%BA%E9%81%87%E9%9A%BE-%E5%A0%B0%E5%A1%9E%E6%B9%96%E9%A3%8E%E9%99%A9-%E5%86%B0%E5%B7%9D%E5%B4%A9%E5%A1%8C%E6%98%AF%E4%B8%BB%E5%9B%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787928468000.webp","sourceId":"rfi"},{"id":1787927255000,"createdDate":"2026-08-28 14:27","name":"法国国际广播电台","title":"特朗普收紧签证政策　中国人的“美国梦”还在吗？","content":"美国特朗普（DonaldTrump）政府正把移民政策收紧的范围，从非法入境者扩大到合法移民、留学生和外国专业人才。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E5%8A%A8%E5%90%91/20260828-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%B6%E7%B4%A7%E7%AD%BE%E8%AF%81%E6%94%BF%E7%AD%96-%E4%B8%AD%E5%9B%BD%E4%BA%BA%E7%9A%84-%E7%BE%8E%E5%9B%BD%E6%A2%A6-%E8%BF%98%E5%9C%A8%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787927255000.webp","sourceId":"rfi"},{"id":1787927060000,"createdDate":"2026-08-28 14:24","name":"法国国际广播电台","title":"中尼边境洪灾的背后：高原山区正承受气候变化的残酷代价","content":"尼泊尔冰川洪灾和中尼两国受灾、救灾情况，是8月28日本台订阅的主流日刊与中国相关报道的重点。解放报对此做了大篇幅的分析介绍，我们为您选取其中专家对气候变化在高原山区导致的灾害频发的分析来做重点综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260828-%E4%B8%AD%E5%B0%BC%E8%BE%B9%E5%A2%83%E6%B4%AA%E7%81%BE%E7%9A%84%E8%83%8C%E5%90%8E-%E9%AB%98%E5%8E%9F%E5%B1%B1%E5%8C%BA%E6%AD%A3%E6%89%BF%E5%8F%97%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E7%9A%84%E6%AE%8B%E9%85%B7%E4%BB%A3%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787927060000.webp","sourceId":"rfi"},{"id":1787925331000,"createdDate":"2026-08-28 13:55","name":"法国国际广播电台","title":"习近平主持召开政治局会议 讨论西藏泥石流救援事宜","content":"据路透报道，中共中央政治局周五召开会议，指导中国西藏与尼泊尔接壤地区发生灾难性泥石流和洪灾后的救援工作。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%BB%E6%8C%81%E5%8F%AC%E5%BC%80%E6%94%BF%E6%B2%BB%E5%B1%80%E4%BC%9A%E8%AE%AE-%E8%AE%A8%E8%AE%BA%E8%A5%BF%E8%97%8F%E6%B3%A5%E7%9F%B3%E6%B5%81%E6%95%91%E6%8F%B4%E4%BA%8B%E5%AE%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787925331000.webp","sourceId":"rfi"},{"id":1787923663000,"createdDate":"2026-08-28 13:27","name":"法国国际广播电台","title":"尼泊尔西藏：堰塞湖外溢引发新的洪灾威胁阻碍救援工作","content":"中尼边境的巨大泥石流造成至少472人死亡、1400人失踪后，救援行动正面临上方巨大蓄水湖可能决堤的威胁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260828-%E5%B0%BC%E6%B3%8A%E5%B0%94%E8%A5%BF%E8%97%8F-%E5%A0%B0%E5%A1%9E%E6%B9%96%E5%A4%96%E6%BA%A2%E5%BC%95%E5%8F%91%E6%96%B0%E7%9A%84%E6%B4%AA%E7%81%BE%E5%A8%81%E8%83%81%E9%98%BB%E7%A2%8D%E6%95%91%E6%8F%B4%E5%B7%A5%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787923663000.webp","sourceId":"rfi"},{"id":1787922415000,"createdDate":"2026-08-28 13:06","name":"法国国际广播电台","title":"张又侠今完全被拔官","content":"据官方媒体报道，中国当局28日周五宣布将张又侠将军免职，此前数月，当局曾宣布对其涉嫌腐败行为展开调查。张又侠此前担任权力巨大的中央军事委员会副主席。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E5%BC%A0%E5%8F%88%E4%BE%A0%E4%BB%8A%E5%AE%8C%E5%85%A8%E8%A2%AB%E6%8B%94%E5%AE%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787922415000.webp","sourceId":"rfi"},{"id":1787918716000,"createdDate":"2026-08-28 12:05","name":"法国国际广播电台","title":"“一位象征性人物”：挪威国王哈拉尔五世逝世、享年89岁","content":"挪威王室宣布，曾是欧洲在位时间最长的君主——挪威国王哈拉尔五世周五逝世，享年89岁。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260828-%E4%B8%80%E4%BD%8D%E8%B1%A1%E5%BE%81%E6%80%A7%E4%BA%BA%E7%89%A9-%E6%8C%AA%E5%A8%81%E5%9B%BD%E7%8E%8B%E5%93%88%E6%8B%89%E5%B0%94%E4%BA%94%E4%B8%96%E9%80%9D%E4%B8%96%EF%BC%8C%E4%BA%AB%E5%B9%B489%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787918716000.webp","sourceId":"rfi"},{"id":1787911725000,"createdDate":"2026-08-28 10:08","name":"法国国际广播电台","title":"韩美日将于9月举行联合军事演习","content":"在被特朗普夏明缩减了与韩国的年度联合军演规模几天后。韩国军方周五（8月28号）宣布，韩国、美国和日本将于9月初如期举行联合军事演习。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260828-%E9%9F%A9%E7%BE%8E%E6%97%A5%E5%B0%86%E4%BA%8E9%E6%9C%88%E4%B8%BE%E8%A1%8C%E8%81%94%E5%90%88%E5%86%9B%E4%BA%8B%E6%BC%94%E4%B9%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787911725000.webp","sourceId":"rfi"},{"id":1787908437000,"createdDate":"2026-08-28 09:13","name":"法国国际广播电台","title":"高市就中尼边境洪水向习近平、李强发出慰问函 日方访华团黯然回国","content":"8月27日，日本首相高市早苗就26日在尼泊尔与中国边境附近发生的大规模洪水及泥石流灾害，分别向中国国家主席习近平和国务院总理李强发出慰问函，向遇难者及遇难者家属表示哀悼，并向灾区受灾人员表示慰问，同时表达了希望尽可能多救出受灾人员，并祈愿受灾人员早日康复的心愿。另一方面，访问中国的日本执政党和在野党议员团27日在北京与中国共产党中央对外联络部副部长陆慷举行会谈，但双方只是再次确认了围绕台湾问题存在的紧张立场分歧，可谓无果而归。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260828-%E9%AB%98%E5%B8%82%E5%B0%B1%E4%B8%AD%E5%B0%BC%E8%BE%B9%E5%A2%83%E6%B4%AA%E6%B0%B4%E5%90%91%E4%B9%A0%E8%BF%91%E5%B9%B3-%E6%9D%8E%E5%BC%BA%E5%8F%91%E5%87%BA%E6%85%B0%E9%97%AE%E5%87%BD-%E6%97%A5%E6%96%B9%E8%AE%BF%E5%8D%8E%E5%9B%A2%E9%BB%AF%E7%84%B6%E5%9B%9E%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787908437000.webp","sourceId":"rfi"},{"id":1787898648000,"createdDate":"2026-08-28 06:30","name":"法国国际广播电台","title":"求情变狠批一党专政 邹幸彤：追求民主 一天牢也不应坐","content":"前支联会副主席邹幸彤拒绝为被指煽动颠覆国家政权罪（煽颠罪）的量刑陈词，强调追求民主「根本一日监都唔应该坐」。她更反批法庭上周206页的罪成裁决书，通篇是在説「追求民主有罪」；誓言将来会继续追求包括「结束一党专政」在内的支联会五大纲领，直至民主来临，尽管这会令她成为罪人。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E6%B1%82%E6%83%85%E5%8F%98%E7%8B%A0%E6%89%B9%E4%B8%80%E5%85%9A%E4%B8%93%E6%94%BF-%E9%82%B9%E5%B9%B8%E5%BD%A4-%E8%BF%BD%E6%B1%82%E6%B0%91%E4%B8%BB-%E4%B8%80%E5%A4%A9%E7%89%A2%E4%B9%9F%E4%B8%8D%E5%BA%94%E5%9D%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787898648000.webp","sourceId":"rfi"},{"id":1787898094000,"createdDate":"2026-08-28 06:21","name":"法国国际广播电台","title":"支联会煽颠罪成 辩方称属「情节较轻」 望李卓人和何俊仁判刑後即可获释","content":"在香港举办六四烛光悼念晚会逾三十年後被迫解散的香港市民支援爱国民主运动联合会(支联会)及其领导人，因纲领中有「结束一党专政」的口号而被裁定「煽动颠覆国家政权」(简称煽颠)罪名成立，代表前主席李卓人和认罪的前副主席何俊仁的律师指出，涉案的，只是空洞的口号，无计划落实；而上周的定罪裁决更只是基於口号违宪，不涉「推翻『中央政权机关』」，故应归类为「情节较轻」级别，即使法官要将案件列为「严重」，亦应判处五至十年刑期中最轻的。法庭最终押後在两星期内判刑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E6%94%AF%E8%81%94%E4%BC%9A%E7%85%BD%E9%A2%A0%E7%BD%AA%E6%88%90-%E8%BE%A9%E6%96%B9%E7%A7%B0%E5%B1%9E-%E6%83%85%E8%8A%82%E8%BE%83%E8%BD%BB-%E6%9C%9B%E6%9D%8E%E5%8D%93%E4%BA%BA%E5%92%8C%E4%BD%95%E4%BF%8A%E4%BB%81%E5%88%A4%E5%88%91%E5%BE%8C%E5%8D%B3%E5%8F%AF%E8%8E%B7%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787898094000.webp","sourceId":"rfi"},{"id":1787960653000,"createdDate":"2026-08-28 23:44","name":"法国国际广播电台","title":"伊朗：美国加大制裁压力，中国对美表现强硬，但是……","content":"法国世界报本周三表示，面对美国就伊朗及其贸易伙伴不断加大制裁压力，中国对美国表现强硬，但同时也避免与美国发生新的严重冲突。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260828-%E4%BC%8A%E6%9C%97-%E7%BE%8E%E5%9B%BD%E5%8A%A0%E5%A4%A7%E5%88%B6%E8%A3%81%E5%8E%8B%E5%8A%9B%EF%BC%8C%E4%B8%AD%E5%9B%BD%E5%AF%B9%E7%BE%8E%E8%A1%A8%E7%8E%B0%E5%BC%BA%E7%A1%AC%EF%BC%8C%E4%BD%86%E6%98%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787960653000.webp","sourceId":"rfi"},{"id":1787957204000,"createdDate":"2026-08-28 22:46","name":"法国国际广播电台","title":"马克龙将访问伦敦，出席《贝叶挂毯》展览的开幕式，会见英国新首相伯纳姆","content":"法国总统马克龙将于下周三和周四访问伦敦，出席《贝叶挂毯》展览的开幕式并会见英国新首相伯纳姆。总体而言，马克龙此次访问伦敦不仅是为了参加《贝叶挂毯》展览开幕式，也具有重要的外交意义。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260828-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%B0%86%E8%AE%BF%E9%97%AE%E4%BC%A6%E6%95%A6%EF%BC%8C%E5%87%BA%E5%B8%AD-%E8%B4%9D%E5%8F%B6%E6%8C%82%E6%AF%AF-%E5%B1%95%E8%A7%88%E7%9A%84%E5%BC%80%E5%B9%95%E5%BC%8F%EF%BC%8C%E4%BC%9A%E8%A7%81%E8%8B%B1%E5%9B%BD%E6%96%B0%E9%A6%96%E7%9B%B8%E4%BC%AF%E7%BA%B3%E5%A7%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787957204000.webp","sourceId":"rfi"},{"id":1787955613000,"createdDate":"2026-08-28 22:20","name":"法国国际广播电台","title":"伊朗战争打了半年仍看不到尽头，中国或成关键变量?","content":"今天是2026年8月29日，距离2月28日伊朗战争爆发已经过去整整六个月了。还记得冲突最开始，特朗普曾信誓旦旦多次保证，这只会是一场持续数周的“小规模行动”。然而，六个月过去了，至今也完全看不到有丝毫结束的迹象。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260828-%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%89%E6%89%93%E4%BA%86%E5%8D%8A%E5%B9%B4%E4%BB%8D%E7%9C%8B%E4%B8%8D%E5%88%B0%E5%B0%BD%E5%A4%B4%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%88%96%E6%88%90%E5%85%B3%E9%94%AE%E5%8F%98%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787955613000.webp","sourceId":"rfi"},{"id":1787953309000,"createdDate":"2026-08-28 21:41","name":"法国国际广播电台","title":"据报中国在西沙群岛修建新设施 越南要求立即停止","content":"越南周五（8月28日）表示，坚决反对任何国家未经越方许可在西沙群岛开展活动。此前有报道称，中国正在西沙群岛一座岛礁上修建新设施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E6%8D%AE%E6%8A%A5%E4%B8%AD%E5%9B%BD%E5%9C%A8%E8%A5%BF%E6%B2%99%E7%BE%A4%E5%B2%9B%E4%BF%AE%E5%BB%BA%E6%96%B0%E8%AE%BE%E6%96%BD-%E8%B6%8A%E5%8D%97%E8%A6%81%E6%B1%82%E7%AB%8B%E5%8D%B3%E5%81%9C%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787953309000.webp","sourceId":"rfi"},{"id":1787952971000,"createdDate":"2026-08-28 21:36","name":"法国国际广播电台","title":"美联储主席沃什强调遏制通胀 市场对美联储加息预期升温","content":"美联储主席凯文·沃什周五（8月28日）首次以美联储主席身份在怀俄明州杰克逊霍尔全球央行年会上发表讲话。沃什明显转变政策语调，将遏制通胀列为当前的首要任务。金融市场认为，这番表态意味着美联储下一步可能不是降息，而是加息。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E7%BE%8E%E8%81%94%E5%82%A8%E4%B8%BB%E5%B8%AD%E6%B2%83%E4%BB%80%E5%BC%BA%E8%B0%83%E9%81%8F%E5%88%B6%E9%80%9A%E8%83%80-%E5%B8%82%E5%9C%BA%E5%AF%B9%E7%BE%8E%E8%81%94%E5%82%A8%E5%8A%A0%E6%81%AF%E9%A2%84%E6%9C%9F%E5%8D%87%E6%B8%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787952971000.webp","sourceId":"rfi"},{"id":1787952713000,"createdDate":"2026-08-28 21:31","name":"法国国际广播电台","title":"美中太空竞争加剧 特朗普宣布创建美国太空学院","content":"美国总统特朗普周五（8月28日）宣布，将创建一所国家级太空学院，为美国国家航空航天局、太空军和私营航天产业培养人才。随着太空日益成为军事和科技较量的战略要地，美中两国在这一领域的竞争也不断加剧。特朗普重申：“美国宇航员将在他的任期结束前重返月球。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E7%BE%8E%E4%B8%AD%E5%A4%AA%E7%A9%BA%E7%AB%9E%E4%BA%89%E5%8A%A0%E5%89%A7-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%88%9B%E5%BB%BA%E7%BE%8E%E5%9B%BD%E5%A4%AA%E7%A9%BA%E5%AD%A6%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787952713000.webp","sourceId":"rfi"},{"id":1787952451000,"createdDate":"2026-08-28 21:27","name":"法国国际广播电台","title":"各国继续斡旋重开霍尔木兹海峡 伊朗称开战半年后仍愿外交解决争端","content":"在美国与伊朗开战六个月之际，卡塔尔等斡旋方加紧外交斡旋，推动恢复霍尔木兹海峡通航。伊朗表示，正在拟定重开这一全球能源运输要道的条件，同时重申仍愿通过外交途径解决冲突，但要求美国停止军事和经济施压。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E5%90%84%E5%9B%BD%E7%BB%A7%E7%BB%AD%E6%96%A1%E6%97%8B%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E4%BC%8A%E6%9C%97%E7%A7%B0%E5%BC%80%E6%88%98%E5%8D%8A%E5%B9%B4%E5%90%8E%E4%BB%8D%E6%84%BF%E5%A4%96%E4%BA%A4%E8%A7%A3%E5%86%B3%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787952451000.webp","sourceId":"rfi"},{"id":1787952281000,"createdDate":"2026-08-28 21:24","name":"法国国际广播电台","title":"喜马拉雅山区洪灾升至近600人死亡 约2500人失踪","content":"尼泊尔与中国边境喜马拉雅山区26日发生毁灭性洪灾，造成的死亡人数升至近600人，约2500人失踪。救援人员周五（8月28日）继续与时间赛跑，全力搜寻可能的幸存者。法国外交部周五证实，有4名法国公民在这场洪灾中失联。红十字会与红新月会国际联合会驻尼泊尔代表称：“根据目前估算，可能约有9.3万人受到影响。这场灾难造成的创伤将极其严重。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260828-%E5%96%9C%E9%A9%AC%E6%8B%89%E9%9B%85%E5%B1%B1%E5%8C%BA%E6%B4%AA%E7%81%BE%E5%8D%87%E8%87%B3%E8%BF%91600%E4%BA%BA%E6%AD%BB%E4%BA%A1-%E7%BA%A62500%E4%BA%BA%E5%A4%B1%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/28/1787952281000.webp","sourceId":"rfi"}]