[{"id":1787475274000,"createdDate":"2026-08-23 08:54","name":"法国国际广播电台","title":"东京附近发生5.9级地震：数十人受伤，不会引发海啸，但未来几天内仍可能发生较强余震","content":"周日(8月23日)凌晨，日本东京附近地区发生5.9级地震，造成37人受伤。日本消防厅和灾害管理部门表示，伤者人数仍可能进一步确认。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%B8%9C%E4%BA%AC%E9%99%84%E8%BF%91%E5%8F%91%E7%94%9F5-9%E7%BA%A7%E5%9C%B0%E9%9C%87-%E6%95%B0%E5%8D%81%E4%BA%BA%E5%8F%97%E4%BC%A4%EF%BC%8C%E4%B8%8D%E4%BC%9A%E5%BC%95%E5%8F%91%E6%B5%B7%E5%95%B8%EF%BC%8C%E4%BD%86%E6%9C%AA%E6%9D%A5%E5%87%A0%E5%A4%A9%E5%86%85%E4%BB%8D%E5%8F%AF%E8%83%BD%E5%8F%91%E7%94%9F%E8%BE%83%E5%BC%BA%E4%BD%99%E9%9C%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787475274000.webp","sourceId":"rfi"},{"id":1787474424000,"createdDate":"2026-08-23 08:40","name":"法国国际广播电台","title":"忘战必危！赖清德：823战役的胜利，就是以实力确保和平的最佳证明","content":"路透社金门消息，台湾总统赖清德周日（8月23日）前往金门，主持近70年前在这座前线岛屿成功抵御中共解放军入侵的纪念典礼。赖清德表示，和平只能通过实力来保障，一寸领土都不能牺牲.","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260823-%E5%BF%98%E6%88%98%E5%BF%85%E5%8D%B1-%E8%B5%96%E6%B8%85%E5%BE%B7-823%E6%88%98%E5%BD%B9%E7%9A%84%E8%83%9C%E5%88%A9%EF%BC%8C%E5%B0%B1%E6%98%AF%E4%BB%A5%E5%AE%9E%E5%8A%9B%E7%A1%AE%E4%BF%9D%E5%92%8C%E5%B9%B3%E7%9A%84%E6%9C%80%E4%BD%B3%E8%AF%81%E6%98%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787474424000.webp","sourceId":"rfi"},{"id":1787474260000,"createdDate":"2026-08-23 08:37","name":"法国国际广播电台","title":"伊朗处决一名涉嫌参与反政府示威的男子，中东冲突以来伊朗处决人数有所增加","content":"伊朗司法部门周日（8月23日）宣布，一名男子因在今年1月的反政府示威期间实施支持以色列和美国的“行动”而被处决。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%BC%8A%E6%9C%97%E5%A4%84%E5%86%B3%E4%B8%80%E5%90%8D%E6%B6%89%E5%AB%8C%E5%8F%82%E4%B8%8E%E5%8F%8D%E6%94%BF%E5%BA%9C%E7%A4%BA%E5%A8%81%E7%9A%84%E7%94%B7%E5%AD%90%EF%BC%8C%E4%B8%AD%E4%B8%9C%E5%86%B2%E7%AA%81%E4%BB%A5%E6%9D%A5%E4%BC%8A%E6%9C%97%E5%A4%84%E5%86%B3%E4%BA%BA%E6%95%B0%E6%9C%89%E6%89%80%E5%A2%9E%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787474260000.webp","sourceId":"rfi"},{"id":1787473525000,"createdDate":"2026-08-23 08:25","name":"法国国际广播电台","title":"美加关税战：特朗普抨击加拿大享受好处\"却又不愿成为美国的一部分\"","content":"加拿大总理马克·卡尼周六宣布，将对美国钢铁、乳制品等产品采取报复性措施，此前他拒绝了华盛顿提出的“糟糕协议”。美国方面随即威胁采取更强硬的反制措施。卡尼在新闻发布会上表示，这些反制措施还将涉及造纸业、农业机械和电子产品，并将于9月8日正式生效。随后，特朗普作出回应。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E7%BE%8E%E5%8A%A0%E5%85%B3%E7%A8%8E%E6%88%98-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8A%A8%E5%87%BB%E5%8A%A0%E6%8B%BF%E5%A4%A7%E4%BA%AB%E5%8F%97%E5%A5%BD%E5%A4%84-%E5%8D%B4%E5%8F%88%E4%B8%8D%E6%84%BF%E6%88%90%E4%B8%BA%E7%BE%8E%E5%9B%BD%E7%9A%84%E4%B8%80%E9%83%A8%E5%88%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787473525000.webp","sourceId":"rfi"},{"id":1787470976000,"createdDate":"2026-08-23 07:42","name":"法国国际广播电台","title":"美国海军陆战队员在日本冲绳手握手枪死亡","content":"8月21日下午，在冲绳县名护市城地区一家医院院内的停车场，一名驻冲绳美国海军陆战队男性队员被发现死在车内，手握手枪，身上有血迹。警方正从包括自杀在内的各种可能性展开调查，同时详细调查该男子为何持有类似手枪的物品等情况。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260823-%E7%BE%8E%E5%9B%BD%E6%B5%B7%E5%86%9B%E9%99%86%E6%88%98%E9%98%9F%E5%91%98%E5%9C%A8%E6%97%A5%E6%9C%AC%E5%86%B2%E7%BB%B3%E6%89%8B%E6%8F%A1%E6%89%8B%E6%9E%AA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787470976000.webp","sourceId":"rfi"},{"id":1787469186000,"createdDate":"2026-08-23 07:13","name":"法国国际广播电台","title":"阿里计划配售102亿美元全部押AI，投入力度创纪录","content":"8月23日，阿里巴巴宣布，计划筹集800亿港元，约合102亿美元，全部用于投资人工智能领域。该资金筹集将通过股份配售实现。交易完成后，预计将创造香港上市公司史上规模最大的主要后续发行，在2026年全球第三大主要后续股票发行排行榜上位列第三，仅次于Alphabet和英特尔。这也将是到目前为止，针对在美国境外进行的规模最大的证券发行与销售。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260823-%E9%98%BF%E9%87%8C%E8%AE%A1%E5%88%92%E9%85%8D%E5%94%AE102%E4%BA%BF%E7%BE%8E%E5%85%83%E5%85%A8%E9%83%A8%E6%8A%BCai%EF%BC%8C%E6%8A%95%E5%85%A5%E5%8A%9B%E5%BA%A6%E5%88%9B%E7%BA%AA%E5%BD%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787469186000.webp","sourceId":"rfi"},{"id":1787500451000,"createdDate":"2026-08-23 15:54","name":"法国国际广播电台","title":"揭阳旺旺虐狗案引目光 为何中国政府强力压制？","content":"中国近来频频发生虐待猫狗案件，6月又发生广东揭阳市未成年男童们虐狗事件。这起旺旺虐狗事件迅速引起中国网民们的震撼，也演变成中国罕见的全国性社会运动。然而，中国当局不久后便开始镇压行动，担心其转化为对体制的不满与反抗。同时，这起旺旺风暴同时也再度掀起中国建立反虐待动物法的声浪。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260823-%E6%8F%AD%E9%98%B3%E6%97%BA%E6%97%BA%E8%99%90%E7%8B%97%E6%A1%88%E5%BC%95%E7%9B%AE%E5%85%89-%E4%B8%BA%E4%BD%95%E4%B8%AD%E5%9B%BD%E6%94%BF%E5%BA%9C%E5%BC%BA%E5%8A%9B%E5%8E%8B%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787500451000.webp","sourceId":"rfi"},{"id":1787494239000,"createdDate":"2026-08-23 14:10","name":"法国国际广播电台","title":"泽连斯基拒绝举行选举并称这会“摧毁乌克兰”","content":"周日（8月23日），乌克兰总统泽连斯基表示，在战争期间举行选举将给乌克兰带来危险。此前他曾遭解职的前国防部长呼吁为举行选举铺平道路，引发争议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8B%92%E7%BB%9D%E4%B8%BE%E8%A1%8C%E9%80%89%E4%B8%BE%E5%B9%B6%E7%A7%B0%E8%BF%99%E4%BC%9A-%E6%91%A7%E6%AF%81%E4%B9%8C%E5%85%8B%E5%85%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787494239000.webp","sourceId":"rfi"},{"id":1787492976000,"createdDate":"2026-08-23 13:49","name":"法国国际广播电台","title":"泽连斯基透露：俄罗斯和中国正在合作建设“星链”替代系统","content":"周日（8月23日），泽连斯基在接受包括法新社在内的记者采访时说：“俄罗斯人正在与中国合作，建设一个‘星链’的替代系统。他们认为，到2026年12月之前就能完成这一项目。”","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E9%80%8F%E9%9C%B2-%E4%BF%84%E7%BD%97%E6%96%AF%E5%92%8C%E4%B8%AD%E5%9B%BD%E6%AD%A3%E5%9C%A8%E5%90%88%E4%BD%9C%E5%BB%BA%E8%AE%BE-%E6%98%9F%E9%93%BE-%E6%9B%BF%E4%BB%A3%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787492976000.webp","sourceId":"rfi"},{"id":1787491341000,"createdDate":"2026-08-23 13:22","name":"法国国际广播电台","title":"日占时期“韩奸”后代争议再起：韩国女演员因曾祖父往事道歉","content":"由于8月23日星期日本台订阅的法国主流日刊大多不出刊，我们为您选取出刊的法国世界报当中与亚洲相关的几则做综述。其中一篇关注了日占时期与日本合作的韩国人问题，再度成为韩国当今社会的一个敏感话题，引发讨论。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260823-%E6%97%A5%E5%8D%A0%E6%97%B6%E6%9C%9F-%E9%9F%A9%E5%A5%B8-%E5%90%8E%E4%BB%A3%E4%BA%89%E8%AE%AE%E5%86%8D%E8%B5%B7-%E9%9F%A9%E5%9B%BD%E5%A5%B3%E6%BC%94%E5%91%98%E5%9B%A0%E6%9B%BE%E7%A5%96%E7%88%B6%E5%BE%80%E4%BA%8B%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787491341000.webp","sourceId":"rfi"},{"id":1787490996000,"createdDate":"2026-08-23 13:16","name":"法国国际广播电台","title":"特朗普外交不得分 中期选举时钟不等人 中俄伊与美“慢慢耗”","content":"随着伊朗战争陷入代价高昂的僵局，以及从乌克兰到加沙的危机仍未解决，美国总统特朗普雄心勃勃的外交愿景却鲜有建树，而他又将面临11月的中期选举压力。路透社引述专家分析指出，美国的对手如普京、习近平、伊朗都明白，特朗普的政治时间比自己更短，尽管特朗普能施加巨大经济或军事压力，但对手等得起，待期中选举后这些对手“慢慢耗”的意图将更加明显。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260823-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A4%96%E4%BA%A4%E4%B8%8D%E5%BE%97%E5%88%86-%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E6%97%B6%E9%92%9F%E4%B8%8D%E7%AD%89%E4%BA%BA-%E4%B8%AD%E4%BF%84%E4%BC%8A%E4%B8%8E%E7%BE%8E-%E6%85%A2%E6%85%A2%E8%80%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787490996000.webp","sourceId":"rfi"},{"id":1787484233000,"createdDate":"2026-08-23 11:23","name":"法国国际广播电台","title":"未经授权改编红歌遭调查后，郭德纲8月多场演出均已被取消","content":"中国有关地方部门周日（8月23日）向法新社证实，中国知名喜剧演员郭德纲因在演出期间未经授权，以讽刺方式改编一首爱国歌曲的歌词，目前正受到调查。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E6%9C%AA%E7%BB%8F%E6%8E%88%E6%9D%83%E6%94%B9%E7%BC%96%E7%BA%A2%E6%AD%8C%E9%81%AD%E8%B0%83%E6%9F%A5%E5%90%8E%EF%BC%8C%E9%83%AD%E5%BE%B7%E7%BA%B28%E6%9C%88%E5%A4%9A%E5%9C%BA%E6%BC%94%E5%87%BA%E5%9D%87%E5%B7%B2%E8%A2%AB%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787484233000.webp","sourceId":"rfi"},{"id":1787477287000,"createdDate":"2026-08-23 09:28","name":"法国国际广播电台","title":"中国机器人百米跑仅用时9秒39，超越博尔特世界纪录","content":"路透社消息称，一款中国人形机器人周六（8月23日）在北京举行的世界人形机器人运动会100米预赛中跑出9秒39，比牙买加短跑名将尤塞恩·博尔特保持的男子100米世界纪录还快。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%B8%AD%E5%9B%BD%E6%9C%BA%E5%99%A8%E4%BA%BA%E7%99%BE%E7%B1%B3%E8%B7%91%E4%BB%85%E7%94%A8%E6%97%B69%E7%A7%9239%EF%BC%8C%E8%B6%85%E8%B6%8A%E5%8D%9A%E5%B0%94%E7%89%B9%E4%B8%96%E7%95%8C%E7%BA%AA%E5%BD%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787477287000.webp","sourceId":"rfi"},{"id":1787476356000,"createdDate":"2026-08-23 09:12","name":"法国国际广播电台","title":"哈萨克斯坦举行议会选举：将进一步巩固总统权力，选举前夕新闻自由遭打压","content":"哈萨克斯坦议会选举周日（8月23日）开始投票。外界普遍预计，执政的亲总统派阿德列特党（Adilet）将以压倒性优势赢得多数席位，另外几个支持托卡耶夫的小型政党也预计将进入议会。此次选举将进一步巩固总统卡瑟姆若马尔特·托卡耶夫在这个中亚最大国家的权力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E5%93%88%E8%90%A8%E5%85%8B%E6%96%AF%E5%9D%A6%E4%B8%BE%E8%A1%8C%E8%AE%AE%E4%BC%9A%E9%80%89%E4%B8%BE-%E5%B0%86%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%B7%A9%E5%9B%BA%E6%80%BB%E7%BB%9F%E6%9D%83%E5%8A%9B%EF%BC%8C%E9%80%89%E4%B8%BE%E5%89%8D%E5%A4%95%E6%96%B0%E9%97%BB%E8%87%AA%E7%94%B1%E9%81%AD%E6%89%93%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787476356000.webp","sourceId":"rfi"},{"id":1787475622000,"createdDate":"2026-08-23 09:00","name":"法国国际广播电台","title":"伊朗总统承认伊朗社会正面临“许多困难”","content":"伊朗总统马苏德·佩泽希齐扬周日（8月23日）承认，伊朗社会正面临“诸多困难”。与此同时，美国正寻求通过新一轮制裁进一步加大对伊朗经济的压力","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E6%89%BF%E8%AE%A4%E4%BC%8A%E6%9C%97%E7%A4%BE%E4%BC%9A%E6%AD%A3%E9%9D%A2%E4%B8%B4-%E8%AE%B8%E5%A4%9A%E5%9B%B0%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787475622000.webp","sourceId":"rfi"}]