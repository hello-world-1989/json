[{"id":1787475274000,"createdDate":"2026-08-23 08:54","name":"法国国际广播电台","title":"东京附近发生5.9级地震：数十人受伤，不会引发海啸，但未来几天内仍可能发生较强余震","content":"周日(8月23日)凌晨，日本东京附近地区发生5.9级地震，造成37人受伤。日本消防厅和灾害管理部门表示，伤者人数仍可能进一步确认。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%B8%9C%E4%BA%AC%E9%99%84%E8%BF%91%E5%8F%91%E7%94%9F5-9%E7%BA%A7%E5%9C%B0%E9%9C%87-%E6%95%B0%E5%8D%81%E4%BA%BA%E5%8F%97%E4%BC%A4%EF%BC%8C%E4%B8%8D%E4%BC%9A%E5%BC%95%E5%8F%91%E6%B5%B7%E5%95%B8%EF%BC%8C%E4%BD%86%E6%9C%AA%E6%9D%A5%E5%87%A0%E5%A4%A9%E5%86%85%E4%BB%8D%E5%8F%AF%E8%83%BD%E5%8F%91%E7%94%9F%E8%BE%83%E5%BC%BA%E4%BD%99%E9%9C%87","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787475274000.webp","sourceId":"rfi"},{"id":1787474424000,"createdDate":"2026-08-23 08:40","name":"法国国际广播电台","title":"忘战必危！赖清德：823战役的胜利，就是以实力确保和平的最佳证明","content":"路透社金门消息，台湾总统赖清德周日（8月23日）前往金门，主持近70年前在这座前线岛屿成功抵御中共解放军入侵的纪念典礼。赖清德表示，和平只能通过实力来保障，一寸领土都不能牺牲.","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260823-%E5%BF%98%E6%88%98%E5%BF%85%E5%8D%B1-%E8%B5%96%E6%B8%85%E5%BE%B7-823%E6%88%98%E5%BD%B9%E7%9A%84%E8%83%9C%E5%88%A9%EF%BC%8C%E5%B0%B1%E6%98%AF%E4%BB%A5%E5%AE%9E%E5%8A%9B%E7%A1%AE%E4%BF%9D%E5%92%8C%E5%B9%B3%E7%9A%84%E6%9C%80%E4%BD%B3%E8%AF%81%E6%98%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787474424000.webp","sourceId":"rfi"},{"id":1787474260000,"createdDate":"2026-08-23 08:37","name":"法国国际广播电台","title":"伊朗处决一名涉嫌参与反政府示威的男子，中东冲突以来伊朗处决人数有所增加","content":"伊朗司法部门周日（8月23日）宣布，一名男子因在今年1月的反政府示威期间实施支持以色列和美国的“行动”而被处决。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E4%BC%8A%E6%9C%97%E5%A4%84%E5%86%B3%E4%B8%80%E5%90%8D%E6%B6%89%E5%AB%8C%E5%8F%82%E4%B8%8E%E5%8F%8D%E6%94%BF%E5%BA%9C%E7%A4%BA%E5%A8%81%E7%9A%84%E7%94%B7%E5%AD%90%EF%BC%8C%E4%B8%AD%E4%B8%9C%E5%86%B2%E7%AA%81%E4%BB%A5%E6%9D%A5%E4%BC%8A%E6%9C%97%E5%A4%84%E5%86%B3%E4%BA%BA%E6%95%B0%E6%9C%89%E6%89%80%E5%A2%9E%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787474260000.webp","sourceId":"rfi"},{"id":1787473525000,"createdDate":"2026-08-23 08:25","name":"法国国际广播电台","title":"美加关税战：特朗普抨击加拿大享受好处\"却又不愿成为美国的一部分\"","content":"加拿大总理马克·卡尼周六宣布，将对美国钢铁、乳制品等产品采取报复性措施，此前他拒绝了华盛顿提出的“糟糕协议”。美国方面随即威胁采取更强硬的反制措施。卡尼在新闻发布会上表示，这些反制措施还将涉及造纸业、农业机械和电子产品，并将于9月8日正式生效。随后，特朗普作出回应。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260823-%E7%BE%8E%E5%8A%A0%E5%85%B3%E7%A8%8E%E6%88%98-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8A%A8%E5%87%BB%E5%8A%A0%E6%8B%BF%E5%A4%A7%E4%BA%AB%E5%8F%97%E5%A5%BD%E5%A4%84-%E5%8D%B4%E5%8F%88%E4%B8%8D%E6%84%BF%E6%88%90%E4%B8%BA%E7%BE%8E%E5%9B%BD%E7%9A%84%E4%B8%80%E9%83%A8%E5%88%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787473525000.webp","sourceId":"rfi"},{"id":1787470976000,"createdDate":"2026-08-23 07:42","name":"法国国际广播电台","title":"美国海军陆战队员在日本冲绳手握手枪死亡","content":"8月21日下午，在冲绳县名护市城地区一家医院院内的停车场，一名驻冲绳美国海军陆战队男性队员被发现死在车内，手握手枪，身上有血迹。警方正从包括自杀在内的各种可能性展开调查，同时详细调查该男子为何持有类似手枪的物品等情况。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260823-%E7%BE%8E%E5%9B%BD%E6%B5%B7%E5%86%9B%E9%99%86%E6%88%98%E9%98%9F%E5%91%98%E5%9C%A8%E6%97%A5%E6%9C%AC%E5%86%B2%E7%BB%B3%E6%89%8B%E6%8F%A1%E6%89%8B%E6%9E%AA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787470976000.webp","sourceId":"rfi"},{"id":1787469186000,"createdDate":"2026-08-23 07:13","name":"法国国际广播电台","title":"阿里计划配售102亿美元全部押AI，投入力度创纪录","content":"8月23日，阿里巴巴宣布，计划筹集800亿港元，约合102亿美元，全部用于投资人工智能领域。该资金筹集将通过股份配售实现。交易完成后，预计将创造香港上市公司史上规模最大的主要后续发行，在2026年全球第三大主要后续股票发行排行榜上位列第三，仅次于Alphabet和英特尔。这也将是到目前为止，针对在美国境外进行的规模最大的证券发行与销售。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260823-%E9%98%BF%E9%87%8C%E8%AE%A1%E5%88%92%E9%85%8D%E5%94%AE102%E4%BA%BF%E7%BE%8E%E5%85%83%E5%85%A8%E9%83%A8%E6%8A%BCai%EF%BC%8C%E6%8A%95%E5%85%A5%E5%8A%9B%E5%BA%A6%E5%88%9B%E7%BA%AA%E5%BD%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/23/1787469186000.webp","sourceId":"rfi"}]