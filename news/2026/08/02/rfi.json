[{"id":1785663988000,"createdDate":"2026-08-02 09:46","name":"法国国际广播电台","title":"世界报：右和极右翼政客无耻炒作休达危机《狂飙》热播造就北京反腐宣传新利器","content":"周末版（8月1日-2日）的《世界报》社论，严厉批评了欧洲政客们对休达（Ceuta）移民危机的不实炒作与政治利用。这篇社论指出，右翼和极右翼政治人物争相炒作来自西班牙这座位于摩洛哥北部地中海飞地的画面，以此渲染移民潮迫在眉睫，并指责佩德罗·桑切斯政府的政策对欧洲构成了危险。然而，他们自始至终对事实置若罔闻。与此同时，世界报“环球剧集之旅”系列推出最后一篇报道，聚焦以反腐为题材的中国刑侦剧《狂飙》TheKnockout如何成为北京主旋律影视的成功范例。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260802-%E4%B8%96%E7%95%8C%E6%8A%A5-%E5%8F%B3%E5%92%8C%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%94%BF%E5%AE%A2%E6%97%A0%E8%80%BB%E7%82%92%E4%BD%9C%E4%BC%91%E8%BE%BE%E5%8D%B1%E6%9C%BA-%E7%8B%82%E9%A3%99-%E7%83%AD%E6%92%AD%E9%80%A0%E5%B0%B1%E5%8C%97%E4%BA%AC%E5%8F%8D%E8%85%90%E5%AE%A3%E4%BC%A0%E6%96%B0%E5%88%A9%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785663988000.webp","sourceId":"rfi"},{"id":1785661180000,"createdDate":"2026-08-02 08:59","name":"法国国际广播电台","title":"委内瑞拉朝野下周启动政治对话，诺贝尔和平奖得主马查多未获邀请","content":"委内瑞拉过渡政府与反对派代表8月1日分别发表公报，宣布朝野政治对话将于下周在线下启动。不过，获得2025年诺贝尔和平奖的政治反对派人物马查多并未被邀请参与对话。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260802-%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%9C%9D%E9%87%8E%E4%B8%8B%E5%91%A8%E5%90%AF%E5%8A%A8%E6%94%BF%E6%B2%BB%E5%AF%B9%E8%AF%9D%EF%BC%8C%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96%E5%BE%97%E4%B8%BB%E9%A9%AC%E6%9F%A5%E5%A4%9A%E6%9C%AA%E8%8E%B7%E9%82%80%E8%AF%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785661180000.webp","sourceId":"rfi"},{"id":1785656066000,"createdDate":"2026-08-02 07:34","name":"法国国际广播电台","title":"甘肃双石门景区山体滑坡死亡人数上升，强降雨持续","content":"综合《世界报》与法新社报道，中国今年夏天遭受了极端天气的严重打击。在7月份，甘肃省和重庆市分别发生的两次独立的山体滑坡灾害，已分别造成21人和51人死亡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E7%94%98%E8%82%83%E7%9C%81%E5%B1%B1%E4%BD%93%E6%BB%91%E5%9D%A1%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E4%B8%8A%E5%8D%87%EF%BC%8C%E5%BC%BA%E9%99%8D%E9%9B%A8%E6%8C%81%E7%BB%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785656066000.webp","sourceId":"rfi"},{"id":1785654876000,"createdDate":"2026-08-02 07:14","name":"法国国际广播电台","title":"日美联合介入外汇市场 阻止日元急速贬值","content":"据路透社2日报道，援引多名政府相关人士的消息，日本财务省正在协调，计划于3日就日美双方纠正日元贬值的相关措施进行说明。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260802-%E6%97%A5%E7%BE%8E%E8%81%94%E5%90%88%E4%BB%8B%E5%85%A5%E5%A4%96%E6%B1%87%E5%B8%82%E5%9C%BA-%E9%98%BB%E6%AD%A2%E6%97%A5%E5%85%83%E6%80%A5%E9%80%9F%E8%B4%AC%E5%80%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785654876000.webp","sourceId":"rfi"},{"id":1785688483000,"createdDate":"2026-08-02 16:34","name":"法国国际广播电台","title":"普查：近三成来自朝鲜核设施地区的离朝人员染色体异常","content":"韩联社31日报道，一项普查显示，在来自朝鲜丰溪里核试验场附近地区的离朝人员（又称脱北者）当中，近三成出现可能由核辐射诱发的染色体异常，但与核辐射之间的因果关系尚未得到证实。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E6%99%AE%E6%9F%A5-%E8%BF%91%E4%B8%89%E6%88%90%E6%9D%A5%E8%87%AA%E6%9C%9D%E9%B2%9C%E6%A0%B8%E8%AE%BE%E6%96%BD%E5%9C%B0%E5%8C%BA%E7%9A%84%E7%A6%BB%E6%9C%9D%E4%BA%BA%E5%91%98%E6%9F%93%E8%89%B2%E4%BD%93%E5%BC%82%E5%B8%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785688483000.webp","sourceId":"rfi"},{"id":1785686775000,"createdDate":"2026-08-02 16:06","name":"法国国际广播电台","title":"欧盟人工智能法案生效 禁止欺骗操纵 规定深度伪造必须标注","content":"欧盟人工智能法案多项条款于今天周日正式生效，欧盟经此获得对人工智能行业监管的更多权力。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260802-%E6%AC%A7%E7%9B%9F%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%B3%95%E6%A1%88%E7%94%9F%E6%95%88-%E7%A6%81%E6%AD%A2%E6%AC%BA%E9%AA%97%E6%93%8D%E7%BA%B5-%E8%A7%84%E5%AE%9A%E6%B7%B1%E5%BA%A6%E4%BC%AA%E9%80%A0%E5%BF%85%E9%A1%BB%E6%A0%87%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785686775000.webp","sourceId":"rfi"},{"id":1785685096000,"createdDate":"2026-08-02 15:38","name":"法国国际广播电台","title":"希腊消防员面对猛烈大火“精疲力尽”","content":"一周以来，希腊多处爆发的野火在强风助长下熊熊燃烧。据希腊民防部长图尔纳斯（EvangelosTournas）周日表示，数百名消防员正在“竭尽全力”与猛烈的火灾作斗争。三名消防员殉职。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260802-%E5%B8%8C%E8%85%8A%E6%B6%88%E9%98%B2%E5%91%98%E9%9D%A2%E5%AF%B9%E7%8C%9B%E7%83%88%E5%A4%A7%E7%81%AB-%E7%B2%BE%E7%96%B2%E5%8A%9B%E5%B0%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785685096000.webp","sourceId":"rfi"},{"id":1785684193000,"createdDate":"2026-08-02 15:23","name":"法国国际广播电台","title":"以色列对加沙发动新一轮致命空袭","content":"特朗普宣布加沙停火协议取得重大突，与哈马斯达成解除武装的协议两天后，以色列周日对加沙发起了新一轮致命空袭。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E4%BB%A5%E8%89%B2%E5%88%97%E5%AF%B9%E5%8A%A0%E6%B2%99%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E8%87%B4%E5%91%BD%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785684193000.webp","sourceId":"rfi"},{"id":1785681034000,"createdDate":"2026-08-02 14:30","name":"法国国际广播电台","title":"人工智能模型自主能力升级引起研发失控担心","content":"人工智能技术快速发展，给人类生产与生活开阔无数新的可能的同时，这项技术是否可能摆脱人类的控制、在自主完善的同时也自主运作也开始引发越来越多的担心。率先推出聊天机器人ChatGtp的人工智能企业OpenAI两个最新模型近日在测试过程中出现失控行为两天之后，另一家美国人工智能开发企业Anthropic7月31日也自爆出现相似情形。这些消息使得人们对人工智能开发失控的担心更加具体，思考是否和如何制定框架管控人工智能技术发展也变得更加迫切。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260802-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%A8%A1%E5%9E%8B%E8%87%AA%E4%B8%BB%E8%83%BD%E5%8A%9B%E5%8D%87%E7%BA%A7%E5%BC%95%E8%B5%B7%E7%A0%94%E5%8F%91%E5%A4%B1%E6%8E%A7%E6%8B%85%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785681034000.webp","sourceId":"rfi"},{"id":1785677181000,"createdDate":"2026-08-02 13:26","name":"法国国际广播电台","title":"中国特大国企国家电网公司前董事长卸任后被反腐机构带走调查","content":"澎湃新闻说，辛保安最后一次公开露面，是7月26日在杭州举行的一场电力行业会议上，他以中电联理事长、全球能源互联网发展合作组织主席的身份作主旨报告。当晚辛保安被有关部门带走。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E4%B8%AD%E5%9B%BD%E7%89%B9%E5%A4%A7%E5%9B%BD%E4%BC%81%E5%9B%BD%E5%AE%B6%E7%94%B5%E7%BD%91%E5%85%AC%E5%8F%B8%E5%89%8D%E8%91%A3%E4%BA%8B%E9%95%BF%E5%8D%B8%E4%BB%BB%E5%90%8E%E8%A2%AB%E5%8F%8D%E8%85%90%E6%9C%BA%E6%9E%84%E5%B8%A6%E8%B5%B0%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785677181000.webp","sourceId":"rfi"},{"id":1785674854000,"createdDate":"2026-08-02 12:47","name":"法国国际广播电台","title":"22位欧盟领导人联合反对西班牙总理桑切斯的移民政策","content":"周六，包括德国总理默茨和意大利总理梅洛尼在内的22位欧盟领导人，批评西班牙总理桑切斯的移民政策损害了欧盟边境安全。但法国和葡萄牙未在联署信上签字。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-22%E4%BD%8D%E6%AC%A7%E7%9B%9F%E9%A2%86%E5%AF%BC%E4%BA%BA%E8%81%94%E5%90%88%E5%8F%8D%E5%AF%B9%E8%A5%BF%E7%8F%AD%E7%89%99%E6%80%BB%E7%90%86%E6%A1%91%E5%88%87%E6%96%AF%E7%9A%84%E7%A7%BB%E6%B0%91%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785674854000.webp","sourceId":"rfi"},{"id":1785670912000,"createdDate":"2026-08-02 11:41","name":"法国国际广播电台","title":"特朗普暂缓对伊朗发动新一轮重大袭击希望尽快达成协议","content":"美国总统特朗普（DonaldTrump）周六表示，应德黑兰及该地区其他国家的请求，美国和以色列已同意暂停对伊朗计划中的新一轮打击，条件是能迅速达成协议。据报之前他接到了沙特王储的电话。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E7%89%B9%E6%9C%97%E6%99%AE%E6%9A%82%E7%BC%93%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E9%87%8D%E5%A4%A7%E8%A2%AD%E5%87%BB%E5%B8%8C%E6%9C%9B%E5%B0%BD%E5%BF%AB%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785670912000.webp","sourceId":"rfi"},{"id":1785712262000,"createdDate":"2026-08-02 23:11","name":"法国国际广播电台","title":"中国出入境新规为何让人惶恐？","content":"一个并未隆重推出的『国务院关于出境入境管理的规定』，引起了不小范围的恐慌。看网上评论，有人自我宽慰，觉得跟普通人没有多大关系；有些人则以为，这规定表面含糊，实则主观性很强，随意性很大，是一张隐性的网，管你普通不普通，都有可能往里装。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E4%B8%AD%E5%9B%BD%E5%87%BA%E5%85%A5%E5%A2%83%E6%96%B0%E8%A7%84%E4%B8%BA%E4%BD%95%E8%AE%A9%E4%BA%BA%E6%83%B6%E6%81%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785712262000.webp","sourceId":"rfi"},{"id":1785707735000,"createdDate":"2026-08-02 21:55","name":"法国国际广播电台","title":"非洲两人竞联合国第十任秘书长","content":"安理会（leConseildesécurité）于本周四就在2027年元旦之后接掌联合国（l’ONU）的第十任秘书长人选秘密举行了首次[指示性投票]（unvoteindicatif）。本台法广（RFI）法语通讯员发自美国的报导说，分别获得各自国家支持的两名非洲候选人：塞内加尔前总统马基·萨勒或麦基•萨勒(MackySall)和曾出任过联合国前副秘书长职务的乌干达前外长奥拉拉·奥通努或奥拉拉•奥图诺(OlaraOtunnu)目前都处于困境。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260802-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E4%B8%A4%E4%BA%BA%E7%AB%9E%E8%81%94%E5%90%88%E5%9B%BD%E7%AC%AC%E5%8D%81%E4%BB%BB%E7%A7%98%E4%B9%A6%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785707735000.webp","sourceId":"rfi"},{"id":1785707338000,"createdDate":"2026-08-02 21:48","name":"法国国际广播电台","title":"费加罗报：韩国汉弗莱斯营——美军“插在亚洲心脏的匕首”，昔射朝鲜今慑中国","content":"据《费加罗报》特派韩国平泽（Pyeongtaek）记者塞巴斯蒂安·法莱蒂周末报道称，按照美国国防部的新战略，位于京畿道的汉弗莱斯营（CampHumphreys）这处原本旨在威慑朝鲜领导人金正恩的美国“飞地”，如今正逐渐成为美国应对中国的新战略支点。这篇特别报道主要围绕三个层次展开：战略重心转移、地区安全格局变化，以及韩国纵横东北亚的位置与盟友的重返。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E9%9F%A9%E5%9B%BD%E6%B1%89%E5%BC%97%E8%8E%B1%E6%96%AF%E8%90%A5-%E7%BE%8E%E5%86%9B-%E6%8F%92%E5%9C%A8%E4%BA%9A%E6%B4%B2%E5%BF%83%E8%84%8F%E7%9A%84%E5%8C%95%E9%A6%96-%EF%BC%8C%E6%98%94%E5%B0%84%E6%9C%9D%E9%B2%9C%E4%BB%8A%E6%85%91%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785707338000.webp","sourceId":"rfi"},{"id":1785706818000,"createdDate":"2026-08-02 21:40","name":"法国国际广播电台","title":"德国工业联合会：“中国冲击2.0”正重创德国工业","content":"据《法兰克福汇报》报道：德国工业联合会（BDI）警告称，与中国相关的问题正在不断加剧，它们对德国工业造成广泛而深远的影响。联合会总经理塔尼娅·戈纳（TanjaGönner）在接受德新社（dpa）采访时表示：“我们正在经历‘中国冲击2.0’。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E5%BE%B7%E5%9B%BD%E5%B7%A5%E4%B8%9A%E8%81%94%E5%90%88%E4%BC%9A-%E4%B8%AD%E5%9B%BD%E5%86%B2%E5%87%BB2-0-%E6%AD%A3%E9%87%8D%E5%88%9B%E5%BE%B7%E5%9B%BD%E5%B7%A5%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785706818000.webp","sourceId":"rfi"},{"id":1785706567000,"createdDate":"2026-08-02 21:36","name":"法国国际广播电台","title":"法国多地山火复燃风险犹存 奥德省火势受控 吉伦特大批居民返回家园","content":"法国消防人员周日（8月2日）晚继续在瓦尔省和吉伦特省全力扑救复燃火点。两地火势整体保持稳定，过火面积几乎没有扩大。南部奥德省卡尔卡松附近周日下午燃起的山火，目前也已得到控制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E6%B3%95%E5%9B%BD%E5%A4%9A%E5%9C%B0%E5%B1%B1%E7%81%AB%E5%A4%8D%E7%87%83%E9%A3%8E%E9%99%A9%E7%8A%B9%E5%AD%98-%E5%A5%A5%E5%BE%B7%E7%9C%81%E7%81%AB%E5%8A%BF%E5%8F%97%E6%8E%A7-%E5%90%89%E4%BC%A6%E7%89%B9%E5%A4%A7%E6%89%B9%E5%B1%85%E6%B0%91%E8%BF%94%E5%9B%9E%E5%AE%B6%E5%9B%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785706567000.webp","sourceId":"rfi"},{"id":1785706393000,"createdDate":"2026-08-02 21:33","name":"法国国际广播电台","title":"巴西总统卢拉获劳工党提名 角逐第四个总统任期","content":"巴西左翼总统卢拉周日（8月2日）正式启动竞选活动，力争在10月大选中赢得第四个、也是最后一个总统任期。现年80岁的卢拉表示自己“状态极佳”，而与其政治对手博索纳罗家族关系密切的美国总统特朗普，成为影响这场选举的重要外部因素。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%8D%A2%E6%8B%89%E8%8E%B7%E5%8A%B3%E5%B7%A5%E5%85%9A%E6%8F%90%E5%90%8D-%E8%A7%92%E9%80%90%E7%AC%AC%E5%9B%9B%E4%B8%AA%E6%80%BB%E7%BB%9F%E4%BB%BB%E6%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785706393000.webp","sourceId":"rfi"},{"id":1785706317000,"createdDate":"2026-08-02 21:31","name":"法国国际广播电台","title":"至少72名移民登陆西班牙飞地前丧生 教皇忧心","content":"一场大规模移民潮以悲剧告终，至少72名年轻人在试图越境进入西班牙飞地休达前不幸丧生。其中大部分是摩洛哥人。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E8%87%B3%E5%B0%9172%E5%90%8D%E7%A7%BB%E6%B0%91%E7%99%BB%E9%99%86%E8%A5%BF%E7%8F%AD%E7%89%99%E9%A3%9E%E5%9C%B0%E5%89%8D%E4%B8%A7%E7%94%9F-%E6%95%99%E7%9A%87%E5%BF%A7%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785706317000.webp","sourceId":"rfi"},{"id":1785706114000,"createdDate":"2026-08-02 21:28","name":"法国国际广播电台","title":"法国强化敏感企业外资入股审查","content":"法国总理府8月2日宣布，法国当天颁布一项经最高行政法院审议的法令和一项部级行政令，进一步强化外国投资审查制度，以“继续保护事关国家安全的关键企业和技术”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E6%B3%95%E5%9B%BD%E5%BC%BA%E5%8C%96%E6%95%8F%E6%84%9F%E4%BC%81%E4%B8%9A%E5%A4%96%E8%B5%84%E5%85%A5%E8%82%A1%E5%AE%A1%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785706114000.webp","sourceId":"rfi"},{"id":1785705794000,"createdDate":"2026-08-02 21:23","name":"法国国际广播电台","title":"伊朗称接近与阿曼就霍尔木兹海峡新航线达成协议","content":"伊朗外交部周日（8月2日）表示，伊朗与阿曼接近就船只通过霍尔木兹海峡的一条新航线达成协议。霍尔木兹海峡是当前中东战争中的一个重大焦点。美国总统特朗普周六再次要求“全面、彻底”开放霍尔木兹海峡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E4%BC%8A%E6%9C%97%E7%A7%B0%E6%8E%A5%E8%BF%91%E4%B8%8E%E9%98%BF%E6%9B%BC%E5%B0%B1%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E6%96%B0%E8%88%AA%E7%BA%BF%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785705794000.webp","sourceId":"rfi"},{"id":1785705541000,"createdDate":"2026-08-02 21:19","name":"法国国际广播电台","title":"特朗普暂缓对伊朗动武 以色列警告仍可能发动打击","content":"美国总统特朗普周末暂时收回对伊朗发动新一轮袭击的威胁，为外交斡旋留下时间，特朗普同时要求各方迅速达成协议，遏制伊朗核计划并恢复霍尔木兹海峡通航。以色列则警告，即使达成协议，一旦伊朗重启核计划或推进弹道导弹项目，仍将采取军事行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E7%89%B9%E6%9C%97%E6%99%AE%E6%9A%82%E7%BC%93%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%8A%A8%E6%AD%A6-%E4%BB%A5%E8%89%B2%E5%88%97%E8%AD%A6%E5%91%8A%E4%BB%8D%E5%8F%AF%E8%83%BD%E5%8F%91%E5%8A%A8%E6%89%93%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785705541000.webp","sourceId":"rfi"},{"id":1785702833000,"createdDate":"2026-08-02 20:33","name":"法国国际广播电台","title":"非洲:西班牙休达移民潮危机渐缓","content":"在非洲北部马格里布地中海沿海，震动申根国家的西班牙飞地休达（Ceuta）移民危机的高峰已过。数以万计擅自闯入当地的民众正在成批地陆续离开一座位于摩洛哥边境的西班牙自治市。在距离边境线最近的摩洛哥城镇Fnideq，许多男女民众接受了本台法广（RFI）法语特派记者（envoyéspécial）的现场采访。这是本台法广非洲组（RFIAfrique）今天（2026年08月02号星期日）上网的最新法文消息之一。摩洛哥境内的Fnideq，西班牙文名称为Castillejos。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260802-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E8%A5%BF%E7%8F%AD%E7%89%99%E4%BC%91%E8%BE%BE%E7%A7%BB%E6%B0%91%E6%BD%AE%E5%8D%B1%E6%9C%BA%E6%B8%90%E7%BC%93","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785702833000.webp","sourceId":"rfi"}]