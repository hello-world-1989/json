[{"id":1785663988000,"createdDate":"2026-08-02 09:46","name":"法国国际广播电台","title":"世界报：右和极右翼政客无耻炒作休达危机《狂飙》热播造就北京反腐宣传新利器","content":"周末版（8月1日-2日）的《世界报》社论，严厉批评了欧洲政客们对休达（Ceuta）移民危机的不实炒作与政治利用。这篇社论指出，右翼和极右翼政治人物争相炒作来自西班牙这座位于摩洛哥北部地中海飞地的画面，以此渲染移民潮迫在眉睫，并指责佩德罗·桑切斯政府的政策对欧洲构成了危险。然而，他们自始至终对事实置若罔闻。与此同时，世界报“环球剧集之旅”系列推出最后一篇报道，聚焦以反腐为题材的中国刑侦剧《狂飙》TheKnockout如何成为北京主旋律影视的成功范例。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260802-%E4%B8%96%E7%95%8C%E6%8A%A5-%E5%8F%B3%E5%92%8C%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%94%BF%E5%AE%A2%E6%97%A0%E8%80%BB%E7%82%92%E4%BD%9C%E4%BC%91%E8%BE%BE%E5%8D%B1%E6%9C%BA-%E7%8B%82%E9%A3%99-%E7%83%AD%E6%92%AD%E9%80%A0%E5%B0%B1%E5%8C%97%E4%BA%AC%E5%8F%8D%E8%85%90%E5%AE%A3%E4%BC%A0%E6%96%B0%E5%88%A9%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785663988000.webp","sourceId":"rfi"},{"id":1785661180000,"createdDate":"2026-08-02 08:59","name":"法国国际广播电台","title":"委内瑞拉朝野下周启动政治对话，诺贝尔和平奖得主马查多未获邀请","content":"委内瑞拉过渡政府与反对派代表8月1日分别发表公报，宣布朝野政治对话将于下周在线下启动。不过，获得2025年诺贝尔和平奖的政治反对派人物马查多并未被邀请参与对话。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260802-%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%9C%9D%E9%87%8E%E4%B8%8B%E5%91%A8%E5%90%AF%E5%8A%A8%E6%94%BF%E6%B2%BB%E5%AF%B9%E8%AF%9D%EF%BC%8C%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96%E5%BE%97%E4%B8%BB%E9%A9%AC%E6%9F%A5%E5%A4%9A%E6%9C%AA%E8%8E%B7%E9%82%80%E8%AF%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785661180000.webp","sourceId":"rfi"},{"id":1785656066000,"createdDate":"2026-08-02 07:34","name":"法国国际广播电台","title":"甘肃双石门景区山体滑坡死亡人数上升，强降雨持续","content":"综合《世界报》与法新社报道，中国今年夏天遭受了极端天气的严重打击。在7月份，甘肃省和重庆市分别发生的两次独立的山体滑坡灾害，已分别造成21人和51人死亡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E7%94%98%E8%82%83%E7%9C%81%E5%B1%B1%E4%BD%93%E6%BB%91%E5%9D%A1%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E4%B8%8A%E5%8D%87%EF%BC%8C%E5%BC%BA%E9%99%8D%E9%9B%A8%E6%8C%81%E7%BB%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785656066000.webp","sourceId":"rfi"},{"id":1785654876000,"createdDate":"2026-08-02 07:14","name":"法国国际广播电台","title":"日美联合介入外汇市场 阻止日元急速贬值","content":"据路透社2日报道，援引多名政府相关人士的消息，日本财务省正在协调，计划于3日就日美双方纠正日元贬值的相关措施进行说明。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260802-%E6%97%A5%E7%BE%8E%E8%81%94%E5%90%88%E4%BB%8B%E5%85%A5%E5%A4%96%E6%B1%87%E5%B8%82%E5%9C%BA-%E9%98%BB%E6%AD%A2%E6%97%A5%E5%85%83%E6%80%A5%E9%80%9F%E8%B4%AC%E5%80%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785654876000.webp","sourceId":"rfi"},{"id":1785688483000,"createdDate":"2026-08-02 16:34","name":"法国国际广播电台","title":"普查：近三成来自朝鲜核设施地区的离朝人员染色体异常","content":"韩联社31日报道，一项普查显示，在来自朝鲜丰溪里核试验场附近地区的离朝人员（又称脱北者）当中，近三成出现可能由核辐射诱发的染色体异常，但与核辐射之间的因果关系尚未得到证实。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E6%99%AE%E6%9F%A5-%E8%BF%91%E4%B8%89%E6%88%90%E6%9D%A5%E8%87%AA%E6%9C%9D%E9%B2%9C%E6%A0%B8%E8%AE%BE%E6%96%BD%E5%9C%B0%E5%8C%BA%E7%9A%84%E7%A6%BB%E6%9C%9D%E4%BA%BA%E5%91%98%E6%9F%93%E8%89%B2%E4%BD%93%E5%BC%82%E5%B8%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785688483000.webp","sourceId":"rfi"},{"id":1785686775000,"createdDate":"2026-08-02 16:06","name":"法国国际广播电台","title":"欧盟人工智能法案生效 禁止欺骗操纵 规定深度伪造必须标注","content":"欧盟人工智能法案多项条款于今天周日正式生效，欧盟经此获得对人工智能行业监管的更多权力。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260802-%E6%AC%A7%E7%9B%9F%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%B3%95%E6%A1%88%E7%94%9F%E6%95%88-%E7%A6%81%E6%AD%A2%E6%AC%BA%E9%AA%97%E6%93%8D%E7%BA%B5-%E8%A7%84%E5%AE%9A%E6%B7%B1%E5%BA%A6%E4%BC%AA%E9%80%A0%E5%BF%85%E9%A1%BB%E6%A0%87%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785686775000.webp","sourceId":"rfi"},{"id":1785685096000,"createdDate":"2026-08-02 15:38","name":"法国国际广播电台","title":"希腊消防员面对猛烈大火“精疲力尽”","content":"一周以来，希腊多处爆发的野火在强风助长下熊熊燃烧。据希腊民防部长图尔纳斯（EvangelosTournas）周日表示，数百名消防员正在“竭尽全力”与猛烈的火灾作斗争。三名消防员殉职。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260802-%E5%B8%8C%E8%85%8A%E6%B6%88%E9%98%B2%E5%91%98%E9%9D%A2%E5%AF%B9%E7%8C%9B%E7%83%88%E5%A4%A7%E7%81%AB-%E7%B2%BE%E7%96%B2%E5%8A%9B%E5%B0%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785685096000.webp","sourceId":"rfi"},{"id":1785684193000,"createdDate":"2026-08-02 15:23","name":"法国国际广播电台","title":"以色列对加沙发动新一轮致命空袭","content":"特朗普宣布加沙停火协议取得重大突，与哈马斯达成解除武装的协议两天后，以色列周日对加沙发起了新一轮致命空袭。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E4%BB%A5%E8%89%B2%E5%88%97%E5%AF%B9%E5%8A%A0%E6%B2%99%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E8%87%B4%E5%91%BD%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785684193000.webp","sourceId":"rfi"},{"id":1785681034000,"createdDate":"2026-08-02 14:30","name":"法国国际广播电台","title":"人工智能模型自主能力升级引起研发失控担心","content":"人工智能技术快速发展，给人类生产与生活开阔无数新的可能的同时，这项技术是否可能摆脱人类的控制、在自主完善的同时也自主运作也开始引发越来越多的担心。率先推出聊天机器人ChatGtp的人工智能企业OpenAI两个最新模型近日在测试过程中出现失控行为两天之后，另一家美国人工智能开发企业Anthropic7月31日也自爆出现相似情形。这些消息使得人们对人工智能开发失控的担心更加具体，思考是否和如何制定框架管控人工智能技术发展也变得更加迫切。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260802-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%A8%A1%E5%9E%8B%E8%87%AA%E4%B8%BB%E8%83%BD%E5%8A%9B%E5%8D%87%E7%BA%A7%E5%BC%95%E8%B5%B7%E7%A0%94%E5%8F%91%E5%A4%B1%E6%8E%A7%E6%8B%85%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785681034000.webp","sourceId":"rfi"},{"id":1785677181000,"createdDate":"2026-08-02 13:26","name":"法国国际广播电台","title":"中国特大国企国家电网公司前董事长卸任后被反腐机构带走调查","content":"澎湃新闻说，辛保安最后一次公开露面，是7月26日在杭州举行的一场电力行业会议上，他以中电联理事长、全球能源互联网发展合作组织主席的身份作主旨报告。当晚辛保安被有关部门带走。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E4%B8%AD%E5%9B%BD%E7%89%B9%E5%A4%A7%E5%9B%BD%E4%BC%81%E5%9B%BD%E5%AE%B6%E7%94%B5%E7%BD%91%E5%85%AC%E5%8F%B8%E5%89%8D%E8%91%A3%E4%BA%8B%E9%95%BF%E5%8D%B8%E4%BB%BB%E5%90%8E%E8%A2%AB%E5%8F%8D%E8%85%90%E6%9C%BA%E6%9E%84%E5%B8%A6%E8%B5%B0%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785677181000.webp","sourceId":"rfi"},{"id":1785674854000,"createdDate":"2026-08-02 12:47","name":"法国国际广播电台","title":"22位欧盟领导人联合反对西班牙总理桑切斯的移民政策","content":"周六，包括德国总理默茨和意大利总理梅洛尼在内的22位欧盟领导人，批评西班牙总理桑切斯的移民政策损害了欧盟边境安全。但法国和葡萄牙未在联署信上签字。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-22%E4%BD%8D%E6%AC%A7%E7%9B%9F%E9%A2%86%E5%AF%BC%E4%BA%BA%E8%81%94%E5%90%88%E5%8F%8D%E5%AF%B9%E8%A5%BF%E7%8F%AD%E7%89%99%E6%80%BB%E7%90%86%E6%A1%91%E5%88%87%E6%96%AF%E7%9A%84%E7%A7%BB%E6%B0%91%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785674854000.webp","sourceId":"rfi"},{"id":1785670912000,"createdDate":"2026-08-02 11:41","name":"法国国际广播电台","title":"特朗普暂缓对伊朗发动新一轮重大袭击希望尽快达成协议","content":"美国总统特朗普（DonaldTrump）周六表示，应德黑兰及该地区其他国家的请求，美国和以色列已同意暂停对伊朗计划中的新一轮打击，条件是能迅速达成协议。据报之前他接到了沙特王储的电话。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260802-%E7%89%B9%E6%9C%97%E6%99%AE%E6%9A%82%E7%BC%93%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E9%87%8D%E5%A4%A7%E8%A2%AD%E5%87%BB%E5%B8%8C%E6%9C%9B%E5%B0%BD%E5%BF%AB%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785670912000.webp","sourceId":"rfi"}]