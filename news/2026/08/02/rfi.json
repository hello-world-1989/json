[{"id":1785663988000,"createdDate":"2026-08-02 09:46","name":"法国国际广播电台","title":"世界报：右和极右翼政客无耻炒作休达危机《狂飙》热播造就北京反腐宣传新利器","content":"周末版（8月1日-2日）的《世界报》社论，严厉批评了欧洲政客们对休达（Ceuta）移民危机的不实炒作与政治利用。这篇社论指出，右翼和极右翼政治人物争相炒作来自西班牙这座位于摩洛哥北部地中海飞地的画面，以此渲染移民潮迫在眉睫，并指责佩德罗·桑切斯政府的政策对欧洲构成了危险。然而，他们自始至终对事实置若罔闻。与此同时，世界报“环球剧集之旅”系列推出最后一篇报道，聚焦以反腐为题材的中国刑侦剧《狂飙》TheKnockout如何成为北京主旋律影视的成功范例。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260802-%E4%B8%96%E7%95%8C%E6%8A%A5-%E5%8F%B3%E5%92%8C%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%94%BF%E5%AE%A2%E6%97%A0%E8%80%BB%E7%82%92%E4%BD%9C%E4%BC%91%E8%BE%BE%E5%8D%B1%E6%9C%BA-%E7%8B%82%E9%A3%99-%E7%83%AD%E6%92%AD%E9%80%A0%E5%B0%B1%E5%8C%97%E4%BA%AC%E5%8F%8D%E8%85%90%E5%AE%A3%E4%BC%A0%E6%96%B0%E5%88%A9%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785663988000.webp","sourceId":"rfi"},{"id":1785661180000,"createdDate":"2026-08-02 08:59","name":"法国国际广播电台","title":"委内瑞拉朝野下周启动政治对话，诺贝尔和平奖得主马查多未获邀请","content":"委内瑞拉过渡政府与反对派代表8月1日分别发表公报，宣布朝野政治对话将于下周在线下启动。不过，获得2025年诺贝尔和平奖的政治反对派人物马查多并未被邀请参与对话。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260802-%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E6%9C%9D%E9%87%8E%E4%B8%8B%E5%91%A8%E5%90%AF%E5%8A%A8%E6%94%BF%E6%B2%BB%E5%AF%B9%E8%AF%9D%EF%BC%8C%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96%E5%BE%97%E4%B8%BB%E9%A9%AC%E6%9F%A5%E5%A4%9A%E6%9C%AA%E8%8E%B7%E9%82%80%E8%AF%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785661180000.webp","sourceId":"rfi"},{"id":1785656066000,"createdDate":"2026-08-02 07:34","name":"法国国际广播电台","title":"甘肃双石门景区山体滑坡死亡人数上升，强降雨持续","content":"综合《世界报》与法新社报道，中国今年夏天遭受了极端天气的严重打击。在7月份，甘肃省和重庆市分别发生的两次独立的山体滑坡灾害，已分别造成21人和51人死亡。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260802-%E7%94%98%E8%82%83%E7%9C%81%E5%B1%B1%E4%BD%93%E6%BB%91%E5%9D%A1%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E4%B8%8A%E5%8D%87%EF%BC%8C%E5%BC%BA%E9%99%8D%E9%9B%A8%E6%8C%81%E7%BB%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785656066000.webp","sourceId":"rfi"},{"id":1785654876000,"createdDate":"2026-08-02 07:14","name":"法国国际广播电台","title":"日美联合介入外汇市场 阻止日元急速贬值","content":"据路透社2日报道，援引多名政府相关人士的消息，日本财务省正在协调，计划于3日就日美双方纠正日元贬值的相关措施进行说明。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260802-%E6%97%A5%E7%BE%8E%E8%81%94%E5%90%88%E4%BB%8B%E5%85%A5%E5%A4%96%E6%B1%87%E5%B8%82%E5%9C%BA-%E9%98%BB%E6%AD%A2%E6%97%A5%E5%85%83%E6%80%A5%E9%80%9F%E8%B4%AC%E5%80%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/02/1785654876000.webp","sourceId":"rfi"}]