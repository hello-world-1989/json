[{"id":1787734971000,"createdDate":"2026-08-26 09:02","name":"法国国际广播电台","title":"尽管北京反对 台湾仍确认参加太平洋岛国论坛峰会","content":"中国反对台湾出现在外交舞台上，但台湾周三（8月26号）仍确认将参加即将在帕劳举行的“太平洋岛过论坛”峰会相关活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E5%B0%BD%E7%AE%A1%E5%8C%97%E4%BA%AC%E5%8F%8D%E5%AF%B9-%E5%8F%B0%E6%B9%BE%E4%BB%8D%E7%A1%AE%E8%AE%A4%E5%8F%82%E5%8A%A0%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%B1%BF%E8%AE%BA%E5%9D%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787734971000.webp","sourceId":"rfi"},{"id":1787731647000,"createdDate":"2026-08-26 08:07","name":"法国国际广播电台","title":"日本战斗机飞行5600公里赴印度参加日印联合军演","content":"日本自卫队航空幕僚监部8月25日宣布，为实施日印联合军演“维拉·卫士26”（VīraGuardian26），航空自卫队3架F-2A战斗机将于9月飞往印度，这将是航空自卫队战斗机首次访问印度。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260826-%E6%97%A5%E6%9C%AC%E6%88%98%E6%96%97%E6%9C%BA%E9%A3%9E%E8%A1%8C5600%E5%85%AC%E9%87%8C%E8%B5%B4%E5%8D%B0%E5%BA%A6%E5%8F%82%E5%8A%A0%E6%97%A5%E5%8D%B0%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787731647000.webp","sourceId":"rfi"},{"id":1787731205000,"createdDate":"2026-08-26 08:00","name":"法国国际广播电台","title":"副总统萧美琴称台湾无人机能力刻不容缓 尤其不能让北京误判台湾自我防卫决心","content":"立法院再度针对台湾无人载具2100亿元特别预算朝野协商，力拼在28日前三读通过。副总统萧美琴表示，台湾无人机产业起步虽慢，但以非红供应链优势与AI融入技术，有信心可追上其他国家。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260826-%E5%89%AF%E6%80%BB%E7%BB%9F%E8%90%A7%E7%BE%8E%E7%90%B4%E7%A7%B0%E5%8F%B0%E6%B9%BE%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%83%BD%E5%8A%9B%E5%88%BB%E4%B8%8D%E5%AE%B9%E7%BC%93-%E5%B0%A4%E5%85%B6%E4%B8%8D%E8%83%BD%E8%AE%A9%E5%8C%97%E4%BA%AC%E8%AF%AF%E5%88%A4%E5%8F%B0%E6%B9%BE%E8%87%AA%E6%88%91%E9%98%B2%E5%8D%AB%E5%86%B3%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787731205000.webp","sourceId":"rfi"},{"id":1787730746000,"createdDate":"2026-08-26 07:52","name":"法国国际广播电台","title":"支联会案后京港齐强调「统筹发展和安全」分析：暗示下届特首续武官治港","content":"中港政府对外强调香港民生回复正轨，已进入「由治及兴」阶段，却在支联会案宣判后，以京港接力转发评论和撰文来强调「统筹发展与安全」，引发外界关注。有分析指，支联会案是《港区国安法》三宗大案中最後判决的，象征香港的「乱局」已告一段落，京港官方此刻重提「发展与安全」，意味北京将继续用武官治港。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260826-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E5%90%8E%E4%BA%AC%E6%B8%AF%E9%BD%90%E5%BC%BA%E8%B0%83-%E7%BB%9F%E7%AD%B9%E5%8F%91%E5%B1%95%E5%92%8C%E5%AE%89%E5%85%A8-%E5%88%86%E6%9E%90-%E6%9A%97%E7%A4%BA%E4%B8%8B%E5%B1%8A%E7%89%B9%E9%A6%96%E7%BB%AD%E6%AD%A6%E5%AE%98%E6%B2%BB%E6%B8%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787730746000.webp","sourceId":"rfi"},{"id":1787730447000,"createdDate":"2026-08-26 07:47","name":"法国国际广播电台","title":"高兟判刑三年：弟忧兄死於狱中 国际特赦批处最高刑罚是要阻吓独立艺术","content":"以创作批判已故中国领导人毛泽东作品闻名的艺术家高兟，遭中国一个市级法院判以「侵害英雄烈士名誉」罪最高刑罚的三年，其弟弟向本台表示，哥哥健康状况堪忧，狱方却拒绝他保外就医，忧虑他会在狱中死亡，并质疑作家王实味葬身的枯井何时可以填平。另外，国际特赦组织亦批评判刑，指是以出於政治动机的新法去追溯旧作，并作出最高刑罚，是要阻吓独立艺术；呼吁立即释放高兟。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E9%AB%98%E5%85%9F%E5%88%A4%E5%88%91%E4%B8%89%E5%B9%B4-%E5%BC%9F%E5%BF%A7%E5%85%84%E6%AD%BB%E6%96%BC%E7%8B%B1%E4%B8%AD-%E5%9B%BD%E9%99%85%E7%89%B9%E8%B5%A6%E6%89%B9%E5%A4%84%E6%9C%80%E9%AB%98%E5%88%91%E7%BD%9A%E6%98%AF%E8%A6%81%E9%98%BB%E5%90%93%E7%8B%AC%E7%AB%8B%E8%89%BA%E6%9C%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787730447000.webp","sourceId":"rfi"}]