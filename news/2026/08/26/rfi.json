[{"id":1787734971000,"createdDate":"2026-08-26 09:02","name":"法国国际广播电台","title":"尽管北京反对 台湾仍确认参加太平洋岛国论坛峰会","content":"中国反对台湾出现在外交舞台上，但台湾周三（8月26号）仍确认将参加即将在帕劳举行的“太平洋岛过论坛”峰会相关活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E5%B0%BD%E7%AE%A1%E5%8C%97%E4%BA%AC%E5%8F%8D%E5%AF%B9-%E5%8F%B0%E6%B9%BE%E4%BB%8D%E7%A1%AE%E8%AE%A4%E5%8F%82%E5%8A%A0%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%B1%BF%E8%AE%BA%E5%9D%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787734971000.webp","sourceId":"rfi"},{"id":1787731647000,"createdDate":"2026-08-26 08:07","name":"法国国际广播电台","title":"日本战斗机飞行5600公里赴印度参加日印联合军演","content":"日本自卫队航空幕僚监部8月25日宣布，为实施日印联合军演“维拉·卫士26”（VīraGuardian26），航空自卫队3架F-2A战斗机将于9月飞往印度，这将是航空自卫队战斗机首次访问印度。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260826-%E6%97%A5%E6%9C%AC%E6%88%98%E6%96%97%E6%9C%BA%E9%A3%9E%E8%A1%8C5600%E5%85%AC%E9%87%8C%E8%B5%B4%E5%8D%B0%E5%BA%A6%E5%8F%82%E5%8A%A0%E6%97%A5%E5%8D%B0%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787731647000.webp","sourceId":"rfi"},{"id":1787731205000,"createdDate":"2026-08-26 08:00","name":"法国国际广播电台","title":"副总统萧美琴称台湾无人机能力刻不容缓 尤其不能让北京误判台湾自我防卫决心","content":"立法院再度针对台湾无人载具2100亿元特别预算朝野协商，力拼在28日前三读通过。副总统萧美琴表示，台湾无人机产业起步虽慢，但以非红供应链优势与AI融入技术，有信心可追上其他国家。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260826-%E5%89%AF%E6%80%BB%E7%BB%9F%E8%90%A7%E7%BE%8E%E7%90%B4%E7%A7%B0%E5%8F%B0%E6%B9%BE%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%83%BD%E5%8A%9B%E5%88%BB%E4%B8%8D%E5%AE%B9%E7%BC%93-%E5%B0%A4%E5%85%B6%E4%B8%8D%E8%83%BD%E8%AE%A9%E5%8C%97%E4%BA%AC%E8%AF%AF%E5%88%A4%E5%8F%B0%E6%B9%BE%E8%87%AA%E6%88%91%E9%98%B2%E5%8D%AB%E5%86%B3%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787731205000.webp","sourceId":"rfi"},{"id":1787730746000,"createdDate":"2026-08-26 07:52","name":"法国国际广播电台","title":"支联会案后京港齐强调「统筹发展和安全」分析：暗示下届特首续武官治港","content":"中港政府对外强调香港民生回复正轨，已进入「由治及兴」阶段，却在支联会案宣判后，以京港接力转发评论和撰文来强调「统筹发展与安全」，引发外界关注。有分析指，支联会案是《港区国安法》三宗大案中最後判决的，象征香港的「乱局」已告一段落，京港官方此刻重提「发展与安全」，意味北京将继续用武官治港。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260826-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88%E5%90%8E%E4%BA%AC%E6%B8%AF%E9%BD%90%E5%BC%BA%E8%B0%83-%E7%BB%9F%E7%AD%B9%E5%8F%91%E5%B1%95%E5%92%8C%E5%AE%89%E5%85%A8-%E5%88%86%E6%9E%90-%E6%9A%97%E7%A4%BA%E4%B8%8B%E5%B1%8A%E7%89%B9%E9%A6%96%E7%BB%AD%E6%AD%A6%E5%AE%98%E6%B2%BB%E6%B8%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787730746000.webp","sourceId":"rfi"},{"id":1787730447000,"createdDate":"2026-08-26 07:47","name":"法国国际广播电台","title":"高兟判刑三年：弟忧兄死於狱中 国际特赦批处最高刑罚是要阻吓独立艺术","content":"以创作批判已故中国领导人毛泽东作品闻名的艺术家高兟，遭中国一个市级法院判以「侵害英雄烈士名誉」罪最高刑罚的三年，其弟弟向本台表示，哥哥健康状况堪忧，狱方却拒绝他保外就医，忧虑他会在狱中死亡，并质疑作家王实味葬身的枯井何时可以填平。另外，国际特赦组织亦批评判刑，指是以出於政治动机的新法去追溯旧作，并作出最高刑罚，是要阻吓独立艺术；呼吁立即释放高兟。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E9%AB%98%E5%85%9F%E5%88%A4%E5%88%91%E4%B8%89%E5%B9%B4-%E5%BC%9F%E5%BF%A7%E5%85%84%E6%AD%BB%E6%96%BC%E7%8B%B1%E4%B8%AD-%E5%9B%BD%E9%99%85%E7%89%B9%E8%B5%A6%E6%89%B9%E5%A4%84%E6%9C%80%E9%AB%98%E5%88%91%E7%BD%9A%E6%98%AF%E8%A6%81%E9%98%BB%E5%90%93%E7%8B%AC%E7%AB%8B%E8%89%BA%E6%9C%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787730447000.webp","sourceId":"rfi"},{"id":1787766207000,"createdDate":"2026-08-26 17:43","name":"法国国际广播电台","title":"泽连斯基授予马斯克“自由勋章”，表彰其强化乌美关系、“保护生命与自由的杰出贡献”","content":"乌克兰总统泽连斯基8月26日签署总统令，将乌克兰最高级别的国家级荣誉之一“自由勋章“授予SpaceX创始人埃隆·马斯克，表彰马斯克在“保护人的生命与自由、加强乌克兰与美国关系上做出的杰出的个人贡献”。马斯克本人截至目前尚没有对乌方授勋置评。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8E%88%E4%BA%88%E9%A9%AC%E6%96%AF%E5%85%8B-%E8%87%AA%E7%94%B1%E5%8B%8B%E7%AB%A0-%EF%BC%8C%E8%A1%A8%E5%BD%B0%E5%85%B6%E5%BC%BA%E5%8C%96%E4%B9%8C%E7%BE%8E%E5%85%B3%E7%B3%BB-%E4%BF%9D%E6%8A%A4%E7%94%9F%E5%91%BD%E4%B8%8E%E8%87%AA%E7%94%B1%E7%9A%84%E6%9D%B0%E5%87%BA%E8%B4%A1%E7%8C%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787766207000.webp","sourceId":"rfi"},{"id":1787765118000,"createdDate":"2026-08-26 17:25","name":"法国国际广播电台","title":"美国全国降半旗哀悼多莉·帕顿，乡村音乐女王80岁逝世将分裂的国家凝聚起来","content":"全国降半旗，她的家乡田纳西州的歌迷们沉痛悼念：周三，美国全国为乡村音乐传奇多莉·帕顿哀悼，她的离世引发了强烈的情感共鸣，也促成了一次难得的团结时刻。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E7%BE%8E%E5%9B%BD%E5%85%A8%E5%9B%BD%E9%99%8D%E5%8D%8A%E6%97%97%E5%93%80%E6%82%BC%E5%A4%9A%E8%8E%89%C2%B7%E5%B8%95%E9%A1%BF%EF%BC%8C%E4%B9%A1%E6%9D%91%E9%9F%B3%E4%B9%90%E5%A5%B3%E7%8E%8B80%E5%B2%81%E9%80%9D%E4%B8%96%E5%B0%86%E5%88%86%E8%A3%82%E7%9A%84%E5%9B%BD%E5%AE%B6%E5%87%9D%E8%81%9A%E8%B5%B7%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787765118000.webp","sourceId":"rfi"},{"id":1787762450000,"createdDate":"2026-08-26 16:40","name":"法国国际广播电台","title":"中国正考虑一项跨境起诉嫌疑人追其资产的新法律 令人担忧扩大到流亡异见人士","content":"路透社北京8月26日讯：中国最高立法机构本周开始对一项跨境反腐败法草案进行首次审议，该草案旨在加强中国的法律工具箱，以便追查、引渡和审判目前身在海外的涉嫌腐败官员。鉴于北京跨境镇压异见人士，此举令外国政府和人权组织担忧中国当局的某些追捕行动涉及未经授权的监视、骚扰和胁迫，绕过正式法律和引渡程序。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E4%B8%AD%E5%9B%BD%E6%AD%A3%E8%80%83%E8%99%91%E4%B8%80%E9%A1%B9%E8%B7%A8%E5%A2%83%E8%B5%B7%E8%AF%89%E5%AB%8C%E7%96%91%E4%BA%BA%E8%BF%BD%E5%85%B6%E8%B5%84%E4%BA%A7%E7%9A%84%E6%96%B0%E6%B3%95%E5%BE%8B-%E4%BB%A4%E4%BA%BA%E6%8B%85%E5%BF%A7%E6%89%A9%E5%A4%A7%E5%88%B0%E6%B5%81%E4%BA%A1%E5%BC%82%E8%A7%81%E4%BA%BA%E5%A3%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787762450000.webp","sourceId":"rfi"},{"id":1787760009000,"createdDate":"2026-08-26 16:00","name":"法国国际广播电台","title":"中国加入印度搜寻海难失踪的“海洋赢家号”22名船员","content":"印度海岸警卫队宣布：中国参与新德里发起的搜救行动，以寻找8月22日在印度东海岸外海沉没的一艘商船上的22名船员。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E4%B8%AD%E5%9B%BD%E5%8A%A0%E5%85%A5%E5%8D%B0%E5%BA%A6%E6%90%9C%E5%AF%BB%E6%B5%B7%E9%9A%BE%E5%A4%B1%E8%B8%AA%E7%9A%84-%E6%B5%B7%E6%B4%8B%E8%B5%A2%E5%AE%B6%E5%8F%B7-22%E5%90%8D%E8%88%B9%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787760009000.webp","sourceId":"rfi"},{"id":1787758845000,"createdDate":"2026-08-26 15:40","name":"法国国际广播电台","title":"恐怖！中国籍解剖学教师在韩国凶杀肢解同乡学生","content":"韩国日前发生肢解，抛弃尸体凶案。被证实受害人是中国女留学生A某（25岁）遇害案的中国籍嫌疑人郑某（30多岁）据警方报告涉嫌毁损、遗弃A某部分遗体。韩国警方正在焚烧场等地展开搜寻。遇害者就读高校证实，郑某是该校中国籍讲师，与遇害者相识。受害者或因文姓，稍早还曾与韩国前总统文在寅一同登上韩国媒体。此案震惊整个韩国。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260826-%E6%81%90%E6%80%96-%E4%B8%AD%E5%9B%BD%E7%B1%8D%E8%A7%A3%E5%89%96%E5%AD%A6%E6%95%99%E5%B8%88%E5%9C%A8%E9%9F%A9%E5%9B%BD%E8%82%A2%E8%A7%A3%E5%90%8C%E4%B9%A1%E5%AD%A6%E7%94%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787758845000.webp","sourceId":"rfi"},{"id":1787756707000,"createdDate":"2026-08-26 15:05","name":"法国国际广播电台","title":"法国媒体多聚焦德国汽车压力","content":"尽管德国大众集团仍以逾4分之1的市占率稳居欧洲汽车市场龙头，市场萎缩、生产成本上升及全球地缘政治紧张等各项因素正逐步削减其获利。面对商业模式转型压力及大规模裁员风险，这家汽车巨头正站在关键的转折点上。法国报纸今关注大众集团市占率领先下的转型挑战。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260826-%E6%B3%95%E5%9B%BD%E5%AA%92%E4%BD%93%E5%A4%9A%E8%81%9A%E7%84%A6%E5%BE%B7%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787756707000.webp","sourceId":"rfi"},{"id":1787755991000,"createdDate":"2026-08-26 14:53","name":"法国国际广播电台","title":"尼泊尔与西藏边境遭毁灭性洪灾 数百人失踪 遇难人数急剧上升 已发现95具遗体","content":"周三上午尼泊尔山洪暴发，导致边境另一侧的中国西藏口岸大量人员伤亡和失踪。已发现95具遗体，死亡人数将急剧上升。受灾地区有341名外国游客失踪。尼泊尔总理下令将民众疏散至安全地带。部长称该地区地震可能引发雪崩和洪水。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E5%B0%BC%E6%B3%8A%E5%B0%94%E4%B8%8E%E8%A5%BF%E8%97%8F%E8%BE%B9%E5%A2%83%E9%81%AD%E6%AF%81%E7%81%AD%E6%80%A7%E6%B4%AA%E7%81%BE-%E6%95%B0%E7%99%BE%E4%BA%BA%E5%A4%B1%E8%B8%AA-%E9%81%87%E9%9A%BE%E4%BA%BA%E6%95%B0%E6%80%A5%E5%89%A7%E4%B8%8A%E5%8D%87-%E5%B7%B2%E5%8F%91%E7%8E%B095%E5%85%B7%E9%81%97%E4%BD%93","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787755991000.webp","sourceId":"rfi"},{"id":1787755122000,"createdDate":"2026-08-26 14:38","name":"法国国际广播电台","title":"「In China, for China」战略三年后不如预期，大众集团“压力山大”","content":"据《回声报》上海通讯员拉斐尔·巴勒尼耶报道，三年前推出的「在中国，为中国」战略尚未取得预期效果。这家德国汽车巨头在全球最大的汽车市场——中国，仍面临巨大压力，上半年销量下降了20%。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-in-china-for-china-%E6%88%98%E7%95%A5%E4%B8%89%E5%B9%B4%E5%90%8E%E4%B8%8D%E5%A6%82%E9%A2%84%E6%9C%9F%EF%BC%8C%E5%A4%A7%E4%BC%97%E9%9B%86%E5%9B%A2-%E5%8E%8B%E5%8A%9B%E5%B1%B1%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787755122000.webp","sourceId":"rfi"},{"id":1787754781000,"createdDate":"2026-08-26 14:33","name":"法国国际广播电台","title":"美国升级对伊朗经济制裁，伊朗普通商家怎样感受？","content":"美国宣布进一步升级对伊朗的经济制裁施压，伊朗普通商家对此有怎样的感受？路透社报道，在伊朗南部港口城市巴姆沙赫尔，当地市商户明显感受到经济压力。一名小家电销售商人卡塞姆·肖贾表示，制裁的确造成打击，尤其是汇率上涨直接影响人们的生活和生计。不过，他认为伊朗人已经习惯了制裁，也知道如何寻找办法绕过制裁。“制裁不是百分之百奏效。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260826-%E7%BE%8E%E5%9B%BD%E5%8D%87%E7%BA%A7%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%EF%BC%8C%E4%BC%8A%E6%9C%97%E6%99%AE%E9%80%9A%E5%95%86%E5%AE%B6%E6%80%8E%E4%B9%88%E7%9C%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787754781000.webp","sourceId":"rfi"},{"id":1787753595000,"createdDate":"2026-08-26 14:13","name":"法国国际广播电台","title":"俄罗斯电商巨头仓库再遭袭 无人机坠毁致两人死","content":"俄罗斯当局周三宣布，俄罗斯西南部一处民宅遭无人机坠落袭击，造成两人死亡；与此同时，乌克兰无人机再对俄罗斯电商巨头一处仓库发动袭击，引发火灾。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E4%BF%84%E6%96%AF%E7%94%B5%E5%95%86%E5%B7%A8%E5%A4%B4%E4%BB%93%E5%BA%93%E5%86%8D%E9%81%AD%E8%A2%AD-%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%9D%A0%E6%AF%81%E8%87%B4%E4%B8%A4%E4%BA%BA%E6%AD%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787753595000.webp","sourceId":"rfi"},{"id":1787752538000,"createdDate":"2026-08-26 13:55","name":"法国国际广播电台","title":"中国：世界的“危险工厂”，高奢市场也难幸免地缘政治问题","content":"债务、养老金……经济将成为法国总统大选的核心议题，这是周三8月26日全国性日报的头版焦点！《费加罗报》指出，“蠢货，关键在于经济！”比尔·克林顿的一位顾问曾用这句名言敦促他将注意力集中在经济问题上，这句话在2027大选中依然意义深远。《回声报》的大标题也突出，商界领袖们担心勒庞与梅朗雄将进入第二轮对决……《十字架报》社论则说，谁也没想到，总统候选人之间的首次交锋竟会发生在网球场上，但受法国雇主联合会（Medef）邀请，他们今天和明天确实将在罗兰·加洛斯，在13 00名观众面前展开对决。周四下午，包括梅朗雄和勒庞在内的七位主要候选人甚至将并肩而坐，就税收、社会模式、竞争力以及投资能力等问题，回答五位企业家的提问。该雇主组织主席帕特里克·马丁希望借此为辩论注入“理性”。因此，问题并不在于是否应该在企业领袖面前启动竞选活动：未来入主爱丽舍宫的人能够倾听那些投资、创新并有望创造就业机会的人们的关切，这本身是件好事。关键在于要认真倾听将要提出的承诺以及将要作出的保证。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260826-%E4%B8%AD%E5%9B%BD-%E4%B8%96%E7%95%8C%E7%9A%84-%E5%8D%B1%E9%99%A9%E5%B7%A5%E5%8E%82-%EF%BC%8C%E9%AB%98%E5%A5%A2%E5%B8%82%E5%9C%BA%E4%B9%9F%E9%9A%BE%E5%B9%B8%E5%85%8D%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787752538000.webp","sourceId":"rfi"},{"id":1787751412000,"createdDate":"2026-08-26 13:36","name":"法国国际广播电台","title":"从中国首次夺冠电竞世俱杯看激励与控制并行的中国模式","content":"因中东战事而仓促移师法国巴黎的2026电竞俱乐部世界杯8月23日圆满落幕。100多个国家的两百多个俱乐部和两千多名职业玩手参加比赛。这次持续7周的比赛包含24款电子游戏。25轮角逐之后，来自中国的AG电子竞技俱乐部成功在最后时刻反超电竞世俱杯的创始国沙特阿拉伯，夺得本次比赛的总冠军，在亲到现场观摩决赛的沙特王储本萨勒曼见证下，从法国总统马克龙手中接过奖杯。如果说中国在电子游戏领域的强势地位有目共睹的话，激励政策与控制措施双重逻辑下独特的中国模式能走多远值得关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E4%BD%93%E8%82%B2/20260826-%E4%BB%8E%E4%B8%AD%E5%9B%BD%E9%A6%96%E6%AC%A1%E5%A4%BA%E5%86%A0%E7%94%B5%E7%AB%9E%E4%B8%96%E4%BF%B1%E6%9D%AF%E7%9C%8B%E6%BF%80%E5%8A%B1%E4%B8%8E%E6%8E%A7%E5%88%B6%E5%B9%B6%E8%A1%8C%E7%9A%84%E4%B8%AD%E5%9B%BD%E6%A8%A1%E5%BC%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787751412000.webp","sourceId":"rfi"},{"id":1787751198000,"createdDate":"2026-08-26 13:33","name":"法国国际广播电台","title":"伊朗: 已修复战争中受损武器系统并从国外进口了新武器","content":"据法新社德黑兰消息，伊朗军方周三表示，战争期间受损的所有武器系统均已“重建”，且已从国外进口了新的武器系统。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E4%BC%8A%E6%9C%97-%E5%B7%B2%E4%BF%AE%E5%A4%8D%E6%88%98%E4%BA%89%E4%B8%AD%E5%8F%97%E6%8D%9F%E6%AD%A6%E5%99%A8%E7%B3%BB%E7%BB%9F%E5%B9%B6%E4%BB%8E%E5%9B%BD%E5%A4%96%E8%BF%9B%E5%8F%A3%E4%BA%86%E6%96%B0%E6%AD%A6%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787751198000.webp","sourceId":"rfi"},{"id":1787750269000,"createdDate":"2026-08-26 13:17","name":"法国国际广播电台","title":"中国军方令人惊讶号召全民检举火箭军贪腐","content":"中国「军队采购网」站上公布一则通知显示，随着当局加强对军事采购活动的审查，中国军方已发起一项公开行动，征集有关火箭军涉嫌采购违规行为的信息。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E4%B8%AD%E5%9B%BD%E5%86%9B%E6%96%B9%E4%BB%A4%E4%BA%BA%E6%83%8A%E8%AE%B6%E5%8F%B7%E5%8F%AC%E5%85%A8%E6%B0%91%E6%A3%80%E4%B8%BE%E7%81%AB%E7%AE%AD%E5%86%9B%E8%B4%AA%E8%85%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787750269000.webp","sourceId":"rfi"},{"id":1787747240000,"createdDate":"2026-08-26 12:27","name":"法国国际广播电台","title":"俄中合资石化企业远东工地火灾 至少7人遇难 包括中国公民6人 9人失踪","content":"俄中合资石化综合体在远东的工地周二发生火灾，遇难人数升至7人，包括6名中国公民，另有9名中国工人失踪。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E4%BF%84%E4%B8%AD%E5%90%88%E8%B5%84%E7%9F%B3%E5%8C%96%E4%BC%81%E4%B8%9A%E8%BF%9C%E4%B8%9C%E5%B7%A5%E5%9C%B0%E7%81%AB%E7%81%BE-%E8%87%B3%E5%B0%917%E4%BA%BA%E9%81%87%E9%9A%BE-%E5%8C%85%E6%8B%AC%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%916%E4%BA%BA-9%E4%BA%BA%E5%A4%B1%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787747240000.webp","sourceId":"rfi"},{"id":1787745755000,"createdDate":"2026-08-26 12:02","name":"法国国际广播电台","title":"Tiktok 因违法收集未成年人个人数据被巴西重罚2500万欧元","content":"巴西国家数据保护局25日宣布对抖音海外版Tiktok重罚2500万欧元，认为抖音母公司字节跳动巴西分部没有遵守巴西关于保护未成年人个人数据的法律规定。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260826-tiktok-%E5%9B%A0%E8%BF%9D%E5%8F%8D%E4%BF%9D%E6%8A%A4%E6%9C%AA%E6%88%90%E5%B9%B4%E4%BA%BA%E4%B8%AA%E4%BA%BA%E6%95%B0%E6%8D%AE%E6%B3%95%E8%A2%AB%E5%B7%B4%E8%A5%BF%E9%87%8D%E7%BD%9A2500%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787745755000.webp","sourceId":"rfi"},{"id":1787745658000,"createdDate":"2026-08-26 12:00","name":"法国国际广播电台","title":"《台湾21世纪恐怖片》｜法国学者柯汉东：鬼岛怎么可以没有一本书来探讨台湾近代电影中的鬼怪叙事","content":"法国学者柯汉东（CorradoNeri）为台北法国现代中国研究中心（CEFC）主任，也是法国里昂三大教授。他长期以来对台湾电影、文学中的鬼怪叙事感兴趣，在六月出版新书《TaiwaneseHorrorCinemainthe21stCentury》（台湾21世纪恐怖片），讲述台湾近代电影如何运用鬼怪叙事来探讨身分认同、创伤与文化变迁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260826-%E5%8F%B0%E6%B9%BE21%E4%B8%96%E7%BA%AA%E6%81%90%E6%80%96%E7%89%87-%EF%BD%9C%E6%B3%95%E5%9B%BD%E5%AD%A6%E8%80%85%E6%9F%AF%E6%B1%89%E4%B8%9C-%E9%AC%BC%E5%B2%9B%E6%80%8E%E4%B9%88%E5%8F%AF%E4%BB%A5%E6%B2%A1%E6%9C%89%E4%B8%80%E6%9C%AC%E4%B9%A6%E6%9D%A5%E6%8E%A2%E8%AE%A8%E5%8F%B0%E6%B9%BE%E8%BF%91%E4%BB%A3%E7%94%B5%E5%BD%B1%E4%B8%AD%E7%9A%84%E9%AC%BC%E6%80%AA%E5%8F%99%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787745658000.webp","sourceId":"rfi"},{"id":1787745626000,"createdDate":"2026-08-26 12:00","name":"法国国际广播电台","title":"阿曼和伊朗继续协商“临时航道” 特朗普称已清除国际水域所有水雷","content":"阿曼和伊朗正在就霍尔木兹海峡的“临时航道”及其扫雷工作进行磋商，但伊朗当局周三警告称，在美方结束战争之前，这一战略要道不会开放。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E9%98%BF%E6%9B%BC%E5%92%8C%E4%BC%8A%E6%9C%97%E7%BB%A7%E7%BB%AD%E5%8D%8F%E5%95%86-%E4%B8%B4%E6%97%B6%E8%88%AA%E9%81%93-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%B7%B2%E6%B8%85%E9%99%A4%E5%9B%BD%E9%99%85%E6%B0%B4%E5%9F%9F%E6%89%80%E6%9C%89%E6%B0%B4%E9%9B%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787745626000.webp","sourceId":"rfi"},{"id":1787744953000,"createdDate":"2026-08-26 11:49","name":"法国国际广播电台","title":"美中都无法靠家庭需求支撑增长：欧洲将同时面临美国的“服务浪潮”和中国的“货物浪潮”","content":"为了弥补内需的疲软，华盛顿依赖于服务业出口，而北京则押注于货物出口。欧洲将面临这两股浪潮的冲击，经济学家圈（Cercledeséconomistes）成员及Ossiam经济顾问帕特里克·阿尔蒂斯（PatrickArtus）投书《回声报》如是分析道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260826-%E7%BE%8E%E4%B8%AD%E9%83%BD%E6%97%A0%E6%B3%95%E9%9D%A0%E5%AE%B6%E5%BA%AD%E9%9C%80%E6%B1%82%E6%94%AF%E6%92%91%E5%A2%9E%E9%95%BF-%E6%AC%A7%E6%B4%B2%E5%B0%86%E5%90%8C%E6%97%B6%E9%9D%A2%E4%B8%B4%E7%BE%8E%E5%9B%BD%E7%9A%84-%E6%9C%8D%E5%8A%A1%E6%B5%AA%E6%BD%AE-%E5%92%8C%E4%B8%AD%E5%9B%BD%E7%9A%84-%E8%B4%A7%E7%89%A9%E6%B5%AA%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787744953000.webp","sourceId":"rfi"},{"id":1787741194000,"createdDate":"2026-08-26 10:46","name":"法国国际广播电台","title":"《奥德赛》电影上映，伊萨卡岛期待迎来旅游热潮","content":"随着著名导演克里斯托弗·诺兰执导的电影《奥德赛》7月16日开始在全球上映，希腊伊萨卡岛再次受到人们的关注。这座传说中英雄奥德修斯的故乡小岛，希望借助电影的热映吸引更多游客。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260826-%E5%A5%A5%E5%BE%B7%E8%B5%9B-%E7%94%B5%E5%BD%B1%E4%B8%8A%E6%98%A0%EF%BC%8C%E4%BC%8A%E8%90%A8%E5%8D%A1%E5%B2%9B%E6%9C%9F%E5%BE%85%E8%BF%8E%E6%9D%A5%E6%97%85%E6%B8%B8%E7%83%AD%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/26/1787741194000.webp","sourceId":"rfi"}]