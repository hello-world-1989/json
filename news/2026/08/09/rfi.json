[{"id":1786264777000,"createdDate":"2026-08-09 08:39","name":"法国国际广播电台","title":"缅甸再次拒绝无条件释放昂山素季，并称现任政府已实现民选，不再需要东盟特使","content":"美联社8月9日报道，据缅甸外交部消息，由缅甸军方支持的缅甸政府拒绝了东盟再次提出的、要求无条件释放被拘押的前领导人昂山素季的呼吁，同时表示没有必要继续由东盟别特使负责缅甸事务。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260809-%E7%BC%85%E7%94%B8%E5%86%8D%E6%AC%A1%E6%8B%92%E7%BB%9D%E6%97%A0%E6%9D%A1%E4%BB%B6%E9%87%8A%E6%94%BE%E6%98%82%E5%B1%B1%E7%B4%A0%E5%AD%A3%EF%BC%8C%E5%B9%B6%E7%A7%B0%E7%8E%B0%E4%BB%BB%E6%94%BF%E5%BA%9C%E5%B7%B2%E5%AE%9E%E7%8E%B0%E6%B0%91%E9%80%89%EF%BC%8C%E4%B8%8D%E5%86%8D%E9%9C%80%E8%A6%81%E4%B8%9C%E7%9B%9F%E7%89%B9%E4%BD%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786264777000.webp","sourceId":"rfi"},{"id":1786264524000,"createdDate":"2026-08-09 08:35","name":"法国国际广播电台","title":"土耳其：土巴沙防务协议技术上等同北约“第五条” 埃及或将加入","content":"土耳其外长哈坎·菲丹8月8日表示，土耳其、沙特阿拉伯和巴基斯坦前日在麦加签署的共同防务协议，在技术上与北约第五条的集体防御原则相同。他同时强调，该协议并非针对伊朗，并透露“埃及很可能在下一阶段加入”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E5%9C%9F%E8%80%B3%E5%85%B6-%E5%9C%9F%E5%B7%B4%E6%B2%99%E9%98%B2%E5%8A%A1%E5%8D%8F%E8%AE%AE%E6%8A%80%E6%9C%AF%E4%B8%8A%E7%AD%89%E5%90%8C%E5%8C%97%E7%BA%A6-%E7%AC%AC%E4%BA%94%E6%9D%A1-%E5%9F%83%E5%8F%8A%E6%88%96%E5%B0%86%E5%8A%A0%E5%85%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786264524000.webp","sourceId":"rfi"},{"id":1786293125000,"createdDate":"2026-08-09 16:32","name":"法国国际广播电台","title":"一架无人机坠毁在保加利亚输气管道附近农田 索非亚指责基辅","content":"周六，一架无人机在保加利亚比邻罗马尼亚边境向日葵田坠毁，附近有一条连接土耳其与乌克兰的天然气管道。保加利亚当局召见乌克兰大使了，而基辅方面一方面表示为无意之举，另一方面承诺调查以确定是乌克兰的无人机。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E4%B8%80%E6%9E%B6%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%9D%A0%E6%AF%81%E5%9C%A8%E4%BF%9D%E5%8A%A0%E5%88%A9%E4%BA%9A%E8%BE%93%E6%B0%94%E7%AE%A1%E9%81%93%E9%99%84%E8%BF%91%E5%86%9C%E7%94%B0-%E7%B4%A2%E9%9D%9E%E4%BA%9A%E6%8C%87%E8%B4%A3%E5%9F%BA%E8%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786293125000.webp","sourceId":"rfi"},{"id":1786290963000,"createdDate":"2026-08-09 15:56","name":"法国国际广播电台","title":"扼海峡以令天下？伊朗要求美国接受其“所有”条件","content":"伊朗革命卫队周日强调，只要华盛顿不接受德黑兰提出的“所有”条件，就不会重开霍尔木兹海峡。如此这般，迅速解决冲突的希望愈发渺茫。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E6%89%BC%E6%B5%B7%E5%B3%A1%E4%BB%A5%E4%BB%A4%E5%A4%A9%E4%B8%8B-%E4%BC%8A%E6%9C%97%E8%A6%81%E6%B1%82%E7%BE%8E%E5%9B%BD%E6%8E%A5%E5%8F%97%E5%85%B6-%E6%89%80%E6%9C%89-%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786290963000.webp","sourceId":"rfi"},{"id":1786284482000,"createdDate":"2026-08-09 14:08","name":"法国国际广播电台","title":"台风“白海豚”即将登陆中国 气象局发布“最高级”警报","content":"中国东部沿海地区周日为台风“白海豚”来袭做准备。据法新社报道，该台风已导致超过1500个航班取消、居民撤离，并促使当局发布最高级别警报。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E5%8D%B3%E5%B0%86%E7%99%BB%E9%99%86%E4%B8%AD%E5%9B%BD-%E6%B0%94%E8%B1%A1%E5%B1%80%E5%8F%91%E5%B8%83-%E6%9C%80%E9%AB%98%E7%BA%A7-%E8%AD%A6%E6%8A%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786284482000.webp","sourceId":"rfi"},{"id":1786282865000,"createdDate":"2026-08-09 13:41","name":"法国国际广播电台","title":"媒体报道台湾2027年国防开支将增16%","content":"路透社8月9日引述中央社报道，台湾内阁将提议2027年国防预算较上年增长16%，届时国防预算将首次突破1万亿新台币（约合310亿美元）。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260809-%E5%AA%92%E4%BD%93%E6%8A%A5%E9%81%93%E5%8F%B0%E6%B9%BE2027%E5%B9%B4%E5%9B%BD%E9%98%B2%E5%BC%80%E6%94%AF%E5%B0%86%E5%A2%9E16","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786282865000.webp","sourceId":"rfi"},{"id":1786281346000,"createdDate":"2026-08-09 13:15","name":"法国国际广播电台","title":"也门胡塞武装称袭击了沙特在红海沿岸的一处石油设施","content":"伊朗支持的也门胡塞武装周日宣称，他们袭击了沙特红海沿岸的一处石油设施，这是针对支持也门政府的利雅得当局发起的又一次袭击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E7%A7%B0%E8%A2%AD%E5%87%BB%E4%BA%86%E6%B2%99%E7%89%B9%E5%9C%A8%E7%BA%A2%E6%B5%B7%E6%B2%BF%E5%B2%B8%E7%9A%84%E4%B8%80%E5%A4%84%E7%9F%B3%E6%B2%B9%E8%AE%BE%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786281346000.webp","sourceId":"rfi"},{"id":1786271819000,"createdDate":"2026-08-09 10:36","name":"法国国际广播电台","title":"日本长崎举行原爆81周年纪念仪式 高市首相回避言及坚持“无核三原则”","content":"8月9日，是美国在日本长崎市投下原子弹81周年的日子，长崎市在松山町的和平公园举行“长崎原子弹爆炸遇难者慰灵暨和平祈念仪式”，仪式于日本时间上午10时45分开始。当前，涉及核武器国家的战火仍未停息，核威慑论日益抬头；与此同时，在作为“唯一遭受战争核爆国家”的日本，作为国策的“无核三原则”也正在动摇。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E6%97%A5%E6%9C%AC%E9%95%BF%E5%B4%8E%E4%B8%BE%E8%A1%8C%E5%8E%9F%E7%88%8681%E5%91%A8%E5%B9%B4%E7%BA%AA%E5%BF%B5%E4%BB%AA%E5%BC%8F-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%9B%9E%E9%81%BF%E8%A8%80%E5%8F%8A%E5%9D%9A%E6%8C%81-%E6%97%A0%E6%A0%B8%E4%B8%89%E5%8E%9F%E5%88%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786271819000.webp","sourceId":"rfi"},{"id":1786271473000,"createdDate":"2026-08-09 10:31","name":"法国国际广播电台","title":"台湾“汉光”军演：备战的同时守护战略产业","content":"周末法国《世界报》特约记者文章，介绍台湾正在举行的年度“汉光”军事演习，同时将视角从军事领域延伸到台湾的另一场没有硝烟的的战斗：保护其战略产业免受北京的觊觎。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260809-%E5%8F%B0%E6%B9%BE-%E6%B1%89%E5%85%89-%E5%86%9B%E6%BC%94-%E5%A4%87%E6%88%98%E7%9A%84%E5%90%8C%E6%97%B6%E5%AE%88%E6%8A%A4%E6%88%98%E7%95%A5%E4%BA%A7%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786271473000.webp","sourceId":"rfi"},{"id":1786315975000,"createdDate":"2026-08-09 22:52","name":"法国国际广播电台","title":"三国共同防务协议为什么引起以色列强烈震动","content":"根据本台记者8月9日从耶路撒冷发来的报道，土耳其、巴基斯坦和沙特阿拉伯两天前签署的一项类似于北约的共同防务条约后，在以色列引起“强烈震动”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E4%B8%89%E5%9B%BD%E5%85%B1%E5%90%8C%E9%98%B2%E5%8A%A1%E5%8D%8F%E8%AE%AE%E4%B8%BA%E4%BB%80%E4%B9%88%E5%BC%95%E8%B5%B7%E4%BB%A5%E8%89%B2%E5%88%97%E5%BC%BA%E7%83%88%E9%9C%87%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786315975000.webp","sourceId":"rfi"},{"id":1786314629000,"createdDate":"2026-08-09 22:30","name":"法国国际广播电台","title":"周日体育：横滨WTT冠军赛 日本张本兄妹双双登顶","content":"世界乒乓球职业大联盟(WTT)本年度横滨冠军赛出现罕见一幕，日本兄妹张本智和、张本美和分别夺得男女单冠军，同样罕见的是，中国男队早早全军覆没。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%91%A8%E6%97%A5%E4%BD%93%E8%82%B2-%E6%A8%AA%E6%BB%A8wtt%E5%86%A0%E5%86%9B%E8%B5%9B-%E6%97%A5%E6%9C%AC%E5%BC%A0%E6%9C%AC%E5%85%84%E5%A6%B9%E5%8F%8C%E5%8F%8C%E7%99%BB%E9%A1%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786314629000.webp","sourceId":"rfi"},{"id":1786311851000,"createdDate":"2026-08-09 21:44","name":"法国国际广播电台","title":"德国企业担心中国限制出口导致生产停摆","content":"据德国《焦点》周刊报道：中国已限制了一些重要原材料的出口。如果北京继续扩大相关限制，德国企业担心将面临生产停摆。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%BE%B7%E5%9B%BD%E4%BC%81%E4%B8%9A%E6%8B%85%E5%BF%83%E4%B8%AD%E5%9B%BD%E9%99%90%E5%88%B6%E5%87%BA%E5%8F%A3%E5%AF%BC%E8%87%B4%E7%94%9F%E4%BA%A7%E5%81%9C%E6%91%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311851000.webp","sourceId":"rfi"},{"id":1786311640000,"createdDate":"2026-08-09 21:40","name":"法国国际广播电台","title":"泽连斯基称俄朝决定在俄罗斯部署最多5万名朝鲜军人","content":"乌克兰总统泽连斯基表示，俄罗斯和朝鲜已经决定在俄罗斯境内部署3万至5万名朝鲜军人，协助平壤的盟友俄罗斯作战。他同时呼吁韩国加强与基辅合作，为乌克兰提供防空系统。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%A7%B0%E4%BF%84%E6%9C%9D%E5%86%B3%E5%AE%9A%E5%9C%A8%E4%BF%84%E7%BD%97%E6%96%AF%E9%83%A8%E7%BD%B2%E6%9C%80%E5%A4%9A5%E4%B8%87%E5%90%8D%E6%9C%9D%E9%B2%9C%E5%86%9B%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311640000.webp","sourceId":"rfi"},{"id":1786311611000,"createdDate":"2026-08-09 21:40","name":"法国国际广播电台","title":"内塔尼亚胡拒特朗普加沙15点方案　美方和平布局再遇阻力","content":"以色列总理本雅明·内塔尼亚胡（BenjaminNetanyahu）9日公开拒绝美国总统唐纳德·特朗普（DonaldTrump）提出的加沙15点和平方案，表示在哈马斯“真正解除武装”前，以色列国防军不会撤出加沙。此举使特朗普政府近来宣称取得突破的加沙和平进程再度面临阻力，也考验华盛顿能否说服以色列接受美方提出的停火及战后安排。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260809-%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E6%8B%92%E7%89%B9%E6%9C%97%E6%99%AE%E5%8A%A0%E6%B2%9915%E7%82%B9%E6%96%B9%E6%A1%88-%E7%BE%8E%E6%96%B9%E5%92%8C%E5%B9%B3%E5%B8%83%E5%B1%80%E5%86%8D%E9%81%87%E9%98%BB%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311611000.webp","sourceId":"rfi"},{"id":1786311462000,"createdDate":"2026-08-09 21:37","name":"法国国际广播电台","title":"应对芯片供应短缺 苹果测试长鑫存储产品","content":"《华尔街日报》周日（8月9日）报道，苹果公司正在iPhone和MacBook等多条产品线上测试中国长鑫存储生产的存储芯片，以缓解人工智能热潮引发的零部件供应短缺。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%BA%94%E5%AF%B9%E8%8A%AF%E7%89%87%E4%BE%9B%E5%BA%94%E7%9F%AD%E7%BC%BA-%E8%8B%B9%E6%9E%9C%E6%B5%8B%E8%AF%95%E9%95%BF%E9%91%AB%E5%AD%98%E5%82%A8%E4%BA%A7%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311462000.webp","sourceId":"rfi"},{"id":1786311308000,"createdDate":"2026-08-09 21:35","name":"法国国际广播电台","title":"中国7月物价涨势弱于预期 内需不振加剧通缩压力","content":"中国官方周日（8月9日）公布的数据显示，7月工业生产者出厂价格指数（PPI）同比涨幅降至三个月最低，放缓幅度超过市场预期；居民消费价格涨势也有所降温。在美以对伊朗战争持续之际，全球能源价格回落，成为物价涨幅放缓的重要原因。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E4%B8%AD%E5%9B%BD7%E6%9C%88%E7%89%A9%E4%BB%B7%E6%B6%A8%E5%8A%BF%E5%BC%B1%E4%BA%8E%E9%A2%84%E6%9C%9F-%E5%86%85%E9%9C%80%E4%B8%8D%E6%8C%AF%E5%8A%A0%E5%89%A7%E9%80%9A%E7%BC%A9%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311308000.webp","sourceId":"rfi"},{"id":1786311157000,"createdDate":"2026-08-09 21:32","name":"法国国际广播电台","title":"伊朗称美国接受“全部条件”才会重开霍尔木兹海峡 特朗普强调经济施压","content":"伊朗伊斯兰革命卫队周日（8月9日）表示，除非美国接受德黑兰提出的“全部”条件，否则霍尔木兹海峡将继续关闭。美国总统特朗普则淡化伊朗的强硬要求，暗示将继续保持经济压力，似乎暂时放弃对伊朗发动新一轮军事打击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E4%BC%8A%E6%9C%97%E7%A7%B0%E7%BE%8E%E5%9B%BD%E6%8E%A5%E5%8F%97-%E5%85%A8%E9%83%A8%E6%9D%A1%E4%BB%B6-%E6%89%8D%E4%BC%9A%E9%87%8D%E5%BC%80%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1-%E7%89%B9%E6%9C%97%E6%99%AE%E5%BC%BA%E8%B0%83%E7%BB%8F%E6%B5%8E%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786311157000.webp","sourceId":"rfi"},{"id":1786310987000,"createdDate":"2026-08-09 21:29","name":"法国国际广播电台","title":"台风“白海豚”两度登陆浙江 超过百万人疏散","content":"今年以来登陆中国的最强台风“白海豚”周日（8月9日）傍晚两度登陆浙江沿海，带来狂风暴雨。中国中央气象台继续发布最高级别的台风红色预警。路透社报道，超过100万人已被疏散，华东多个地区面临洪水和山体滑坡风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E4%B8%A4%E5%BA%A6%E7%99%BB%E9%99%86%E6%B5%99%E6%B1%9F-%E8%B6%85%E8%BF%87%E7%99%BE%E4%B8%87%E4%BA%BA%E7%96%8F%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786310987000.webp","sourceId":"rfi"},{"id":1786301693000,"createdDate":"2026-08-09 18:54","name":"法国国际广播电台","title":"非洲女子国家杯2026四分之一赛","content":"在北非马格里布地区的摩洛哥王国，于两个星期前2026年07月26号周日开幕的第14届非洲女子国家杯足球赛（laCANféminine2026）目前正在如火如荼的举行之中。这一计划为期三个星期的赛程，预计是在一周后的08月16日星期天落幕。进入本届赛事四分之一决赛的八支女足队，于本周末两天（08月08日星期六和08月09日星期天）分别在卡萨布兰卡（Casablanca）和拉巴特（Rabat）对阵，展开淘汰赛。打入半决赛的4支球队将获得2027年巴西女足世界杯（laCoupeduMondeFIFABrésil-2027）的参赛资格。经过08月08日周六的赛事，目前已有阿尔及利亚和摩洛哥先后分别各自摘取一张直接进军南美洲的入场券。08月09日星期天晚，喀麦隆(leCameroun)在卡萨布兰卡（Casablanca）迎战尼日利亚(leNigéria)，以1：0险胜。另一场比赛是马拉维(leMalawi)在拉巴特（Rabat）对阵加纳(leGhana)，以2：1赢得直接于明年前往巴西参赛的资格。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260809-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E5%A5%B3%E5%AD%90%E5%9B%BD%E5%AE%B6%E6%9D%AF2026%E5%9B%9B%E5%88%86%E4%B9%8B%E4%B8%80%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786301693000.webp","sourceId":"rfi"},{"id":1786299855000,"createdDate":"2026-08-09 18:24","name":"法国国际广播电台","title":"哥伦比亚新总统刚上台遇下马威：两起致命袭击","content":"周六，哥伦比亚新任总统阿贝拉尔多·德拉·埃斯普里埃拉（AbelardodelaEspriella）上任首日便发生两起袭击事件，造成一名警察死亡、多人受伤。此前，他承诺将采取激进措施打击有组织犯罪。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E6%96%B0%E6%80%BB%E7%BB%9F%E5%88%9A%E4%B8%8A%E5%8F%B0%E9%81%87%E4%B8%8B%E9%A9%AC%E5%A8%81-%E4%B8%A4%E8%B5%B7%E8%87%B4%E5%91%BD%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786299855000.webp","sourceId":"rfi"},{"id":1786298508000,"createdDate":"2026-08-09 18:01","name":"法国国际广播电台","title":"非洲:尼日利亚查假外资促进机构","content":"在西非国家尼日利亚（leNigéria），应博拉·蒂努布总统或博拉·蒂努布总统（présidentnigérianBolaTinubu）的要求，总部位于阿布贾（Abuja）的该国独立反腐败部门（ICPC）对外通报了针对虚假政府机构-尼日利亚[总统促进外国投资理事会]（PFIPC）及其负责人马修王子（PrinceAdeniyiAdeyemiMatthew）真实性的初步调查结果。尼日利亚的中文国名也有译作奈及利亞（leNigéria）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260809-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%B0%BC%E6%97%A5%E5%88%A9%E4%BA%9A%E6%9F%A5%E5%81%87%E5%A4%96%E8%B5%84%E4%BF%83%E8%BF%9B%E6%9C%BA%E6%9E%84","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786298508000.webp","sourceId":"rfi"},{"id":1786295849000,"createdDate":"2026-08-09 17:17","name":"法国国际广播电台","title":"印尼爪哇岛国家公园森林火灾蔓延被关闭","content":"周六晚间，印尼当局关闭了爪哇岛上一处国家公园的入口，目前消防员正在该地扑救已肆虐近一周的森林大火。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E5%8D%B0%E5%B0%BC%E7%88%AA%E5%93%87%E5%B2%9B%E5%9B%BD%E5%AE%B6%E5%85%AC%E5%9B%AD%E6%A3%AE%E6%9E%97%E7%81%AB%E7%81%BE%E8%94%93%E5%BB%B6%E8%A2%AB%E5%85%B3%E9%97%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786295849000.webp","sourceId":"rfi"}]