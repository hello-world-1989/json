[{"id":1786264777000,"createdDate":"2026-08-09 08:39","name":"法国国际广播电台","title":"缅甸再次拒绝无条件释放昂山素季，并称现任政府已实现民选，不再需要东盟特使","content":"美联社8月9日报道，据缅甸外交部消息，由缅甸军方支持的缅甸政府拒绝了东盟再次提出的、要求无条件释放被拘押的前领导人昂山素季的呼吁，同时表示没有必要继续由东盟别特使负责缅甸事务。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260809-%E7%BC%85%E7%94%B8%E5%86%8D%E6%AC%A1%E6%8B%92%E7%BB%9D%E6%97%A0%E6%9D%A1%E4%BB%B6%E9%87%8A%E6%94%BE%E6%98%82%E5%B1%B1%E7%B4%A0%E5%AD%A3%EF%BC%8C%E5%B9%B6%E7%A7%B0%E7%8E%B0%E4%BB%BB%E6%94%BF%E5%BA%9C%E5%B7%B2%E5%AE%9E%E7%8E%B0%E6%B0%91%E9%80%89%EF%BC%8C%E4%B8%8D%E5%86%8D%E9%9C%80%E8%A6%81%E4%B8%9C%E7%9B%9F%E7%89%B9%E4%BD%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786264777000.webp","sourceId":"rfi"},{"id":1786264524000,"createdDate":"2026-08-09 08:35","name":"法国国际广播电台","title":"土耳其：土巴沙防务协议技术上等同北约“第五条” 埃及或将加入","content":"土耳其外长哈坎·菲丹8月8日表示，土耳其、沙特阿拉伯和巴基斯坦前日在麦加签署的共同防务协议，在技术上与北约第五条的集体防御原则相同。他同时强调，该协议并非针对伊朗，并透露“埃及很可能在下一阶段加入”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E5%9C%9F%E8%80%B3%E5%85%B6-%E5%9C%9F%E5%B7%B4%E6%B2%99%E9%98%B2%E5%8A%A1%E5%8D%8F%E8%AE%AE%E6%8A%80%E6%9C%AF%E4%B8%8A%E7%AD%89%E5%90%8C%E5%8C%97%E7%BA%A6-%E7%AC%AC%E4%BA%94%E6%9D%A1-%E5%9F%83%E5%8F%8A%E6%88%96%E5%B0%86%E5%8A%A0%E5%85%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786264524000.webp","sourceId":"rfi"},{"id":1786293125000,"createdDate":"2026-08-09 16:32","name":"法国国际广播电台","title":"一架无人机坠毁在保加利亚输气管道附近农田 索非亚指责基辅","content":"周六，一架无人机在保加利亚比邻罗马尼亚边境向日葵田坠毁，附近有一条连接土耳其与乌克兰的天然气管道。保加利亚当局召见乌克兰大使了，而基辅方面一方面表示为无意之举，另一方面承诺调查以确定是乌克兰的无人机。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E4%B8%80%E6%9E%B6%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%9D%A0%E6%AF%81%E5%9C%A8%E4%BF%9D%E5%8A%A0%E5%88%A9%E4%BA%9A%E8%BE%93%E6%B0%94%E7%AE%A1%E9%81%93%E9%99%84%E8%BF%91%E5%86%9C%E7%94%B0-%E7%B4%A2%E9%9D%9E%E4%BA%9A%E6%8C%87%E8%B4%A3%E5%9F%BA%E8%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786293125000.webp","sourceId":"rfi"},{"id":1786290963000,"createdDate":"2026-08-09 15:56","name":"法国国际广播电台","title":"扼海峡以令天下？伊朗要求美国接受其“所有”条件","content":"伊朗革命卫队周日强调，只要华盛顿不接受德黑兰提出的“所有”条件，就不会重开霍尔木兹海峡。如此这般，迅速解决冲突的希望愈发渺茫。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E6%89%BC%E6%B5%B7%E5%B3%A1%E4%BB%A5%E4%BB%A4%E5%A4%A9%E4%B8%8B-%E4%BC%8A%E6%9C%97%E8%A6%81%E6%B1%82%E7%BE%8E%E5%9B%BD%E6%8E%A5%E5%8F%97%E5%85%B6-%E6%89%80%E6%9C%89-%E6%9D%A1%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786290963000.webp","sourceId":"rfi"},{"id":1786284482000,"createdDate":"2026-08-09 14:08","name":"法国国际广播电台","title":"台风“白海豚”即将登陆中国 气象局发布“最高级”警报","content":"中国东部沿海地区周日为台风“白海豚”来袭做准备。据法新社报道，该台风已导致超过1500个航班取消、居民撤离，并促使当局发布最高级别警报。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260809-%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E5%8D%B3%E5%B0%86%E7%99%BB%E9%99%86%E4%B8%AD%E5%9B%BD-%E6%B0%94%E8%B1%A1%E5%B1%80%E5%8F%91%E5%B8%83-%E6%9C%80%E9%AB%98%E7%BA%A7-%E8%AD%A6%E6%8A%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786284482000.webp","sourceId":"rfi"},{"id":1786282865000,"createdDate":"2026-08-09 13:41","name":"法国国际广播电台","title":"媒体报道台湾2027年国防开支将增16%","content":"路透社8月9日引述中央社报道，台湾内阁将提议2027年国防预算较上年增长16%，届时国防预算将首次突破1万亿新台币（约合310亿美元）。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260809-%E5%AA%92%E4%BD%93%E6%8A%A5%E9%81%93%E5%8F%B0%E6%B9%BE2027%E5%B9%B4%E5%9B%BD%E9%98%B2%E5%BC%80%E6%94%AF%E5%B0%86%E5%A2%9E16","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786282865000.webp","sourceId":"rfi"},{"id":1786281346000,"createdDate":"2026-08-09 13:15","name":"法国国际广播电台","title":"也门胡塞武装称袭击了沙特在红海沿岸的一处石油设施","content":"伊朗支持的也门胡塞武装周日宣称，他们袭击了沙特红海沿岸的一处石油设施，这是针对支持也门政府的利雅得当局发起的又一次袭击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E4%B9%9F%E9%97%A8%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E7%A7%B0%E8%A2%AD%E5%87%BB%E4%BA%86%E6%B2%99%E7%89%B9%E5%9C%A8%E7%BA%A2%E6%B5%B7%E6%B2%BF%E5%B2%B8%E7%9A%84%E4%B8%80%E5%A4%84%E7%9F%B3%E6%B2%B9%E8%AE%BE%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786281346000.webp","sourceId":"rfi"},{"id":1786271819000,"createdDate":"2026-08-09 10:36","name":"法国国际广播电台","title":"日本长崎举行原爆81周年纪念仪式 高市首相回避言及坚持“无核三原则”","content":"8月9日，是美国在日本长崎市投下原子弹81周年的日子，长崎市在松山町的和平公园举行“长崎原子弹爆炸遇难者慰灵暨和平祈念仪式”，仪式于日本时间上午10时45分开始。当前，涉及核武器国家的战火仍未停息，核威慑论日益抬头；与此同时，在作为“唯一遭受战争核爆国家”的日本，作为国策的“无核三原则”也正在动摇。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260809-%E6%97%A5%E6%9C%AC%E9%95%BF%E5%B4%8E%E4%B8%BE%E8%A1%8C%E5%8E%9F%E7%88%8681%E5%91%A8%E5%B9%B4%E7%BA%AA%E5%BF%B5%E4%BB%AA%E5%BC%8F-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%9B%9E%E9%81%BF%E8%A8%80%E5%8F%8A%E5%9D%9A%E6%8C%81-%E6%97%A0%E6%A0%B8%E4%B8%89%E5%8E%9F%E5%88%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786271819000.webp","sourceId":"rfi"},{"id":1786271473000,"createdDate":"2026-08-09 10:31","name":"法国国际广播电台","title":"台湾“汉光”军演：备战的同时守护战略产业","content":"周末法国《世界报》特约记者文章，介绍台湾正在举行的年度“汉光”军事演习，同时将视角从军事领域延伸到台湾的另一场没有硝烟的的战斗：保护其战略产业免受北京的觊觎。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260809-%E5%8F%B0%E6%B9%BE-%E6%B1%89%E5%85%89-%E5%86%9B%E6%BC%94-%E5%A4%87%E6%88%98%E7%9A%84%E5%90%8C%E6%97%B6%E5%AE%88%E6%8A%A4%E6%88%98%E7%95%A5%E4%BA%A7%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/09/1786271473000.webp","sourceId":"rfi"}]