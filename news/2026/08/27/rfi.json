[{"id":1787818568000,"createdDate":"2026-08-27 08:16","name":"法国国际广播电台","title":"朝鲜谴责美国向韩国军售导弹及相关装备 誓言将强力回应","content":"朝鲜周四（8月27日）谴责美国批准向韩国出售导弹及相关装备，并誓言将对这一“敌对行为”作出“立即且强有力的”回应。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E6%9C%9D%E9%B2%9C%E8%B0%B4%E8%B4%A3%E7%BE%8E%E5%9B%BD%E5%90%91%E9%9F%A9%E5%9B%BD%E5%86%9B%E5%94%AE%E5%AF%BC%E5%BC%B9%E5%8F%8A%E7%9B%B8%E5%85%B3%E8%A3%85%E5%A4%87-%E8%AA%93%E8%A8%80%E5%B0%86%E5%BC%BA%E5%8A%9B%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787818568000.webp","sourceId":"rfi"},{"id":1787818063000,"createdDate":"2026-08-27 08:07","name":"法国国际广播电台","title":"中尼边境洪水中五名日本人失联 高市首相对中国受灾惨重表示心痛","content":"中国与尼泊尔边境附近26日发生大规模洪水和泥石流，造成多人死亡和失踪。对此，日本首相高市早苗日本时间27日上午更新了自己的X（原推特）账号，对遇难者表示哀悼，同时呼吁提供有关失踪日本人的信息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E4%B8%AD%E5%B0%BC%E8%BE%B9%E5%A2%83%E6%B4%AA%E6%B0%B4%E4%B8%AD%E4%BA%94%E5%90%8D%E6%97%A5%E6%9C%AC%E4%BA%BA%E5%A4%B1%E8%81%94-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8F%97%E7%81%BE%E6%83%A8%E9%87%8D%E8%A1%A8%E7%A4%BA%E5%BF%83%E7%97%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787818063000.webp","sourceId":"rfi"},{"id":1787817575000,"createdDate":"2026-08-27 07:59","name":"法国国际广播电台","title":"香港首份五年规划与施政报告下月同日公布　分析：为李家超连任制造优势","content":"今年是国家「十五五」规划开局之年，港府要完成主动对接规划框架的任务，需首次按照中国的模式制定五年规划报告，其重要性会否取代特首的《施政报告》，一直受到关注。行政长官李家超昨(26日)午预告，将于9月16日同日公布两份报告，并以画龙点睛作比喻，指《施政报告》是画龙，五年规划是点睛。评论认为，李家超虽然未公开表态有意角逐连任，但将两份报告捆绑，无疑为其连任制造客观上的有利条件。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E9%A6%99%E6%B8%AF%E9%A6%96%E4%BB%BD%E4%BA%94%E5%B9%B4%E8%A7%84%E5%88%92%E4%B8%8E%E6%96%BD%E6%94%BF%E6%8A%A5%E5%91%8A%E4%B8%8B%E6%9C%88%E5%90%8C%E6%97%A5%E5%85%AC%E5%B8%83-%E5%88%86%E6%9E%90-%E4%B8%BA%E6%9D%8E%E5%AE%B6%E8%B6%85%E8%BF%9E%E4%BB%BB%E5%88%B6%E9%80%A0%E4%BC%98%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787817575000.webp","sourceId":"rfi"},{"id":1787817252000,"createdDate":"2026-08-27 07:54","name":"法国国际广播电台","title":"路透社：洪灾中尼泊尔失踪游客国籍（暂时）","content":"尼泊尔旅游官员周四表示，一场毁灭性洪灾席卷了喜马拉雅山脉国家尼泊尔及中国西藏地区，在尼泊尔失踪的570名游客中，476名来自29个国家的外国人。中国央视报道称，西藏吉隆县失踪的外国人共有260人，但其国籍详情尚未立即公布。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E8%B7%AF%E9%80%8F%E7%A4%BE-%E6%B4%AA%E7%81%BE%E4%B8%AD%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%A4%B1%E8%B8%AA%E6%B8%B8%E5%AE%A2%E5%9B%BD%E7%B1%8D-%E6%9A%82%E6%97%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787817252000.webp","sourceId":"rfi"},{"id":1787873438000,"createdDate":"2026-08-27 23:30","name":"法国国际广播电台","title":"从北京两场机器人大会，看中国人形机器人已经发展到了什么程度？","content":"8月份，北京连续举行两场与人形机器人有关的大会：一场是8月19日至23日举行的世界机器人大会，主要展示机器人产业、技术和应用；另一场是8月22日至26日举行的世界人形机器人运动会，让机器人直接“上场比赛”。法国世界报表示，把这两场大会放在一起，可以清楚地看到，中国人形机器人进步非常快，产业链已经初具规模，但距离真正“像人一样工作”，还有很长的路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260827-%E4%BB%8E%E5%8C%97%E4%BA%AC%E4%B8%A4%E5%9C%BA%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%A4%A7%E4%BC%9A%EF%BC%8C%E7%9C%8B%E4%B8%AD%E5%9B%BD%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%B7%B2%E7%BB%8F%E5%8F%91%E5%B1%95%E5%88%B0%E4%BB%80%E4%B9%88%E7%A8%8B%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787873438000.webp","sourceId":"rfi"},{"id":1787867788000,"createdDate":"2026-08-27 21:56","name":"法国国际广播电台","title":"尼泊尔和西藏发生致命泥石流灾害后，人道援助仍然有限","content":"在尼泊尔和西藏发生严重的泥石流和山体滑坡灾害后一天，国际援助仍然十分有限。目前，至少有392人死亡，超过1400人失踪。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260827-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%92%8C%E8%A5%BF%E8%97%8F%E5%8F%91%E7%94%9F%E8%87%B4%E5%91%BD%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%81%BE%E5%AE%B3%E5%90%8E%EF%BC%8C%E4%BA%BA%E9%81%93%E6%8F%B4%E5%8A%A9%E4%BB%8D%E7%84%B6%E6%9C%89%E9%99%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787867788000.webp","sourceId":"rfi"},{"id":1787867147000,"createdDate":"2026-08-27 21:45","name":"法国国际广播电台","title":"欧盟小包裹税初见成效 中国小包裹进口量骤降三至四成","content":"欧盟针对希音、特穆、全球速卖通等亚洲电商平台展开的监管行动初见成效。为遏制中国小包裹大量涌入而开征新税后，欧盟进口的此类包裹数量显著下降。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E6%AC%A7%E7%9B%9F%E5%B0%8F%E5%8C%85%E8%A3%B9%E7%A8%8E%E5%88%9D%E8%A7%81%E6%88%90%E6%95%88-%E4%B8%AD%E5%9B%BD%E5%B0%8F%E5%8C%85%E8%A3%B9%E8%BF%9B%E5%8F%A3%E9%87%8F%E9%AA%A4%E9%99%8D%E4%B8%89%E8%87%B3%E5%9B%9B%E6%88%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787867147000.webp","sourceId":"rfi"},{"id":1787866931000,"createdDate":"2026-08-27 21:42","name":"法国国际广播电台","title":"美加贸易战升温 特朗普签行政令将安大略湖更名为“美国湖”","content":"美国与加拿大陷入激烈贸易对抗之际，美国总统特朗普周四(8月27日）签署一项行政命令，宣布“立即”将位于美加边境的安大略湖更名为“美国湖”。加拿大总理卡尼立即回应称，安大略湖“将永远叫安大略湖”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E7%BE%8E%E5%8A%A0%E8%B4%B8%E6%98%93%E6%88%98%E5%8D%87%E6%B8%A9-%E7%89%B9%E6%9C%97%E6%99%AE%E7%AD%BE%E7%BD%B2%E8%A1%8C%E6%94%BF%E4%BB%A4%E5%B0%86%E5%AE%89%E5%A4%A7%E7%95%A5%E6%B9%96%E6%9B%B4%E5%90%8D%E4%B8%BA-%E7%BE%8E%E5%9B%BD%E6%B9%96","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787866931000.webp","sourceId":"rfi"},{"id":1787866759000,"createdDate":"2026-08-27 21:39","name":"法国国际广播电台","title":"特朗普称普京不会攻击北约领土 欧洲情报部门称未发现俄方备战迹象","content":"美国总统特朗普周四(8月27日）表示，俄罗斯总统普京“不会攻击北约领土”。与此同时，一名欧洲高级官员称，欧洲情报部门目前没有发现俄罗斯准备对北约欧洲成员国发动军事进攻的迹象。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%99%AE%E4%BA%AC%E4%B8%8D%E4%BC%9A%E6%94%BB%E5%87%BB%E5%8C%97%E7%BA%A6%E9%A2%86%E5%9C%9F-%E6%AC%A7%E6%B4%B2%E6%83%85%E6%8A%A5%E9%83%A8%E9%97%A8%E7%A7%B0%E6%9C%AA%E5%8F%91%E7%8E%B0%E4%BF%84%E6%96%B9%E5%A4%87%E6%88%98%E8%BF%B9%E8%B1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787866759000.webp","sourceId":"rfi"},{"id":1787866510000,"createdDate":"2026-08-27 21:35","name":"法国国际广播电台","title":"特朗普拒绝说明是否制裁中国银行 美对华金融施压引发猜测","content":"美国总统特朗普周四（8月27日）拒绝明确说明美国是否准备对中国银行实施经济制裁，使外界对华盛顿下一步行动继续猜测。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8B%92%E7%BB%9D%E8%AF%B4%E6%98%8E%E6%98%AF%E5%90%A6%E5%88%B6%E8%A3%81%E4%B8%AD%E5%9B%BD%E9%93%B6%E8%A1%8C-%E7%BE%8E%E5%AF%B9%E5%8D%8E%E9%87%91%E8%9E%8D%E6%96%BD%E5%8E%8B%E5%BC%95%E5%8F%91%E7%8C%9C%E6%B5%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787866510000.webp","sourceId":"rfi"},{"id":1787865475000,"createdDate":"2026-08-27 21:17","name":"法国国际广播电台","title":"尼泊尔与西藏边境洪灾死亡人数升至近400人 逾1400人失踪 尼泊尔警告二次洪水风险","content":"尼泊尔与中国边境地区26日遭到巨大的泥石流袭击。截至周四（8月27日），救援人员已找到至少392名遇难者的遗体，目前仍在全力搜寻超过1400名失踪人员，其中包括517名外国公民。尼泊尔政府周四连续发出警告称，冰川崩塌形成的堰塞湖可能引发第二轮洪水。美国地质调查局称，灾害由一处冰川局部崩塌引发。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E5%B0%BC%E6%B3%8A%E5%B0%94%E4%B8%8E%E8%A5%BF%E8%97%8F%E8%BE%B9%E5%A2%83%E6%B4%AA%E7%81%BE%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%8D%87%E8%87%B3%E8%BF%91400%E4%BA%BA-%E9%80%BE1400%E4%BA%BA%E5%A4%B1%E8%B8%AA-%E5%B0%BC%E6%B3%8A%E5%B0%94%E8%AD%A6%E5%91%8A%E4%BA%8C%E6%AC%A1%E6%B4%AA%E6%B0%B4%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787865475000.webp","sourceId":"rfi"},{"id":1787863846000,"createdDate":"2026-08-27 20:50","name":"法国国际广播电台","title":"俄罗斯周四白天袭击了乌克兰多座城市， 泽连斯基盟要盟友提供更多弹道导弹防御系统","content":"俄罗斯周四使用无人机袭击了乌克兰多座城市，造成一人死亡，多人受伤。俄罗斯入侵乌克兰已超过四年，近期加大了对各城市的攻击力度，其中包括白天的袭击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E4%BF%84%E7%BD%97%E6%96%AF%E5%91%A8%E5%9B%9B%E7%99%BD%E5%A4%A9%E8%A2%AD%E5%87%BB%E4%BA%86%E4%B9%8C%E5%85%8B%E5%85%B0%E5%A4%9A%E5%BA%A7%E5%9F%8E%E5%B8%82%EF%BC%8C-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%9B%9F%E8%A6%81%E7%9B%9F%E5%8F%8B%E6%8F%90%E4%BE%9B%E6%9B%B4%E5%A4%9A%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9%E9%98%B2%E5%BE%A1%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787863846000.webp","sourceId":"rfi"},{"id":1787854875000,"createdDate":"2026-08-27 18:21","name":"法国国际广播电台","title":"中国江西省长叶建春任上落马","content":"61岁的中共江西省委副书记、省长叶建春因涉嫌严重违纪违法，收到中纪委国家监委的纪律审查和监察调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E4%B8%AD%E5%9B%BD%E6%B1%9F%E8%A5%BF%E7%9C%81%E9%95%BF%E5%8F%B6%E5%BB%BA%E6%98%A5%E4%BB%BB%E4%B8%8A%E8%90%BD%E9%A9%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787854875000.webp","sourceId":"rfi"},{"id":1787852891000,"createdDate":"2026-08-27 17:48","name":"法国国际广播电台","title":"尼泊尔和西藏毁灭性洪灾近400人遇难 达赖喇嘛为所有遇难者“祈祷”","content":"周四，救援人员已从前一天席卷尼泊尔与中国西藏边境地区的巨大泥石流中打捞出至少392具遇难者遗体，并继续努力搜寻仍下落不明的1400余人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%92%8C%E8%A5%BF%E8%97%8F%E6%AF%81%E7%81%AD%E6%80%A7%E6%B4%AA%E7%81%BE%E8%BF%91400%E4%BA%BA%E9%81%87%E9%9A%BE-%E8%BE%BE%E8%B5%96%E5%96%87%E5%98%9B%E4%B8%BA%E6%89%80%E6%9C%89%E9%81%87%E9%9A%BE%E8%80%85-%E7%A5%88%E7%A5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787852891000.webp","sourceId":"rfi"},{"id":1787850266000,"createdDate":"2026-08-27 17:04","name":"法国国际广播电台","title":"休达移民危机:摩洛哥遭骇客袭击","content":"位于马格里布地区的北非国家摩洛哥王国（leMaroc）遭遇网络袭击，这是本台法广非洲组（RFIAfrique）2026年08月27日星期四上网的法文消息之一。骇客（或黑客）组织于本周早些时候宣称，已对外公开摩洛哥数万名干员的数据，作为休达（Ceuta）移民危机后，献给欧洲的一份礼物。有摩洛哥前干员认为，部分泄密数据是真实的。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260827-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E4%BC%91%E8%BE%BE%E7%A7%BB%E6%B0%91%E5%8D%B1%E6%9C%BA-%E6%91%A9%E6%B4%9B%E5%93%A5%E9%81%AD%E9%AA%87%E5%AE%A2%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787850266000.webp","sourceId":"rfi"},{"id":1787850080000,"createdDate":"2026-08-27 17:01","name":"法国国际广播电台","title":"美国中央情报局局长访莫斯科后 克里姆林宫斥美媒报道“危言耸听”","content":"法新社莫斯科消息，克里姆林宫周四将美媒关于“中情局长本周非同寻常地访问莫斯科旨在警告俄罗斯不要对北约发动任何袭击”的报道斥为“危言耸听”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E7%BE%8E%E5%9B%BD%E4%B8%AD%E5%A4%AE%E6%83%85%E6%8A%A5%E5%B1%80%E5%B1%80%E9%95%BF%E8%AE%BF%E8%8E%AB%E6%96%AF%E7%A7%91%E5%90%8E-%E5%85%8B%E9%87%8C%E5%A7%86%E6%9E%97%E5%AE%AB%E6%96%A5%E7%BE%8E%E5%AA%92%E6%8A%A5%E9%81%93-%E5%8D%B1%E8%A8%80%E8%80%B8%E5%90%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787850080000.webp","sourceId":"rfi"},{"id":1787848903000,"createdDate":"2026-08-27 16:41","name":"法国国际广播电台","title":"挪威国王病危 全国摒息 首相取消访德行程","content":"挪威王室周四宣布，现年89岁的挪威国王哈拉尔五世因血液疾病引发并发症而住院治疗，其健康状况已恶化，目前已处于“极度危重”状态。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E6%8C%AA%E5%A8%81%E5%9B%BD%E7%8E%8B%E7%97%85%E5%8D%B1-%E5%85%A8%E5%9B%BD%E6%91%92%E6%81%AF-%E9%A6%96%E7%9B%B8%E5%8F%96%E6%B6%88%E8%AE%BF%E5%BE%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787848903000.webp","sourceId":"rfi"},{"id":1787842395000,"createdDate":"2026-08-27 14:53","name":"法国国际广播电台","title":"习近平派李强赴西藏洪水泥石流灾区视察","content":"据官方媒体报道，中国国家主席习近平派遣总理李强周四抵达西藏灾区。此前一天，周三，在尼泊尔与中国西藏边境爆发规模空前且破坏性极强的洪灾泥石流，已造成至少362人死亡，1300余人失踪。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260827-%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%B4%BE%E6%9D%8E%E5%BC%BA%E8%B5%B4%E8%A5%BF%E8%97%8F%E6%B4%AA%E6%B0%B4%E6%B3%A5%E7%9F%B3%E6%B5%81%E7%81%BE%E5%8C%BA%E8%A7%86%E5%AF%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787842395000.webp","sourceId":"rfi"},{"id":1787839672000,"createdDate":"2026-08-27 14:07","name":"法国国际广播电台","title":"尼泊尔与西藏边境洪灾死亡人数升至362人 “毁灭性”灾难何以发生？","content":"尼泊尔北部与中国西藏接壤的边境地区周三突发特大泥石流洪灾，死亡人数不断攀升，灾后次日，官方公布至少已有362人死亡，约1400人仍然失联，其中约一半是外国人。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260827-%E5%B0%BC%E6%B3%8A%E5%B0%94%E8%A5%BF%E8%97%8F%E8%BE%B9%E5%A2%83-%E6%AF%81%E7%81%AD%E6%80%A7-%E6%B4%AA%E7%81%BE-%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%8D%87%E8%87%B3362%E4%BA%BA-%E7%BA%A61400%E4%BA%BA%E5%A4%B1%E8%81%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787839672000.webp","sourceId":"rfi"},{"id":1787837420000,"createdDate":"2026-08-27 13:30","name":"法国国际广播电台","title":"泰媒：泰南动荡与马六甲海峡危机","content":"常年动荡的泰国南部地区，近期分裂活动再度猖獗，泰政府与当地分离武装组织的和平谈判陷入困局。泰国地缘观察人士分析，泰南叛乱与“伊斯兰国”（ISIS）恐怖活动有相似之处，武装组织的背后是同一批人！","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260827-%E6%B3%B0%E5%AA%92-%E6%B3%B0%E5%8D%97%E5%8A%A8%E8%8D%A1%E4%B8%8E%E9%A9%AC%E5%85%AD%E7%94%B2%E6%B5%B7%E5%B3%A1%E5%8D%B1%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787837420000.webp","sourceId":"rfi"},{"id":1787836873000,"createdDate":"2026-08-27 13:21","name":"法国国际广播电台","title":"霍尔木兹海峡的封锁，正加速中国电动汽车开拓南美市场","content":"本台订阅的法国主流日刊在8月27日有多则和中国相关的报道。首先来看中国和尼泊尔边境发生的严重泥石流。8月27日出刊的解放报大篇幅聚焦了前一日尼泊尔泥石流和在该国与中国引发的灾难。当中指出，这是一场前所未有的灾难。截至目前死亡人数至少270人，上千人失踪，失踪人数之多也让死亡人数的攀升出现极大的空间。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260827-%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E7%9A%84%E5%B0%81%E9%94%81%EF%BC%8C%E6%AD%A3%E5%8A%A0%E9%80%9F%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E5%BC%80%E6%8B%93%E5%8D%97%E7%BE%8E%E5%B8%82%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787836873000.webp","sourceId":"rfi"},{"id":1787836247000,"createdDate":"2026-08-27 13:10","name":"法国国际广播电台","title":"台湾立法院批准“在野版”76亿美元军用无人机预算案","content":"台湾立法院周四批准了一项76亿美元的预算，用于本地制造无人机，台北方面正寻求加强防务，以应对中国可能发动的袭击。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260827-%E5%8F%B0%E6%B9%BE%E7%AB%8B%E6%B3%95%E9%99%A2%E6%89%B9%E5%87%86-%E5%9C%A8%E9%87%8E%E7%89%88-76%E4%BA%BF%E7%BE%8E%E5%85%83%E5%86%9B%E7%94%A8%E6%97%A0%E4%BA%BA%E6%9C%BA%E9%A2%84%E7%AE%97%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787836247000.webp","sourceId":"rfi"},{"id":1787832109000,"createdDate":"2026-08-27 12:01","name":"法国国际广播电台","title":"尼泊尔与西藏边境洪灾死亡人数升至 273人，1300人失踪 涵30多国游客","content":"法新社8月27日加德满都报道，周三泥石流席卷尼泊尔和中国西藏多个山谷，已知至少273人死亡，和包括数百名游客在内的1300多人失踪。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E5%B0%BC%E6%B3%8A%E5%B0%94%E4%B8%8E%E8%A5%BF%E8%97%8F%E8%BE%B9%E5%A2%83%E6%B4%AA%E7%81%BE%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%8D%87%E8%87%B3-273%E4%BA%BA%EF%BC%8C1300%E4%BA%BA%E5%A4%B1%E8%B8%AA-%E6%B6%B530%E5%A4%9A%E5%9B%BD%E6%B8%B8%E5%AE%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787832109000.webp","sourceId":"rfi"},{"id":1787828758000,"createdDate":"2026-08-27 11:05","name":"法国国际广播电台","title":"非洲[洛比托走廊]可能梦想成真","content":"非洲具有战略意义的[洛比托走廊]项目（lecorridordeLobito）有望实现。这是本台法广非洲组（RFIAfrique）2026年08月27日星期四上网的最新法文消息之一。安哥拉总统若昂·洛伦索（JoãoLourenço）于昨天（08月26日周三）在金沙萨（Kinshasa）会晤了刚果（金）总统费利克斯·齐塞克迪（Félix Tshisekedi）。两国现已签署一项为期三十年的铁路合作协议。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260827-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E6%B4%9B%E6%AF%94%E6%89%98%E8%B5%B0%E5%BB%8A-%E5%8F%AF%E8%83%BD%E6%A2%A6%E6%83%B3%E6%88%90%E7%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787828758000.webp","sourceId":"rfi"},{"id":1787828732000,"createdDate":"2026-08-27 11:05","name":"法国国际广播电台","title":"伊朗称美军的海上封锁阻碍了德黑兰的汽油进口","content":"周三晚间，一位伊朗高级官员表示，美国对伊朗港口实施的海军封锁阻碍了该国进口汽油，且国内产量已无法满足民众的需求。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260827-%E4%BC%8A%E6%9C%97%E7%A7%B0%E7%BE%8E%E5%86%9B%E7%9A%84%E6%B5%B7%E4%B8%8A%E5%B0%81%E9%94%81%E9%98%BB%E7%A2%8D%E4%BA%86%E5%BE%B7%E9%BB%91%E5%85%B0%E7%9A%84%E6%B1%BD%E6%B2%B9%E8%BF%9B%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/27/1787828732000.webp","sourceId":"rfi"}]