[{"id":1787303009000,"createdDate":"2026-08-21 09:03","name":"法国国际广播电台","title":"俄罗斯计划在争议岛屿附近进行导弹试射，日本提出抗议并称“不可接受”","content":"周五(8月21日)，日本在获悉俄罗斯计划在存在领土争议的岛屿附近进行导弹试射后，向俄方提出抗议。此前，就在上周，俄罗斯总统普京曾访问这些岛屿，引发了日方强烈谴责。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%BF%84%E7%BD%97%E6%96%AF%E8%AE%A1%E5%88%92%E5%9C%A8%E4%BA%89%E8%AE%AE%E5%B2%9B%E5%B1%BF%E9%99%84%E8%BF%91%E8%BF%9B%E8%A1%8C%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84%EF%BC%8C%E6%97%A5%E6%9C%AC%E6%8F%90%E5%87%BA%E6%8A%97%E8%AE%AE%E5%B9%B6%E7%A7%B0-%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787303009000.webp","sourceId":"rfi"},{"id":1787302534000,"createdDate":"2026-08-21 08:55","name":"法国国际广播电台","title":"太平洋岛国本月查扣多艘中国及印尼渔船，持续打击非法捕捞","content":"周五（8月21日），太平洋岛国论坛渔业局（FFA）在向法新社提供的一份声明中表示，基里巴斯、帕劳和巴布亚新几内亚当局共扣留或押送4艘船只进港，原因包括非法捕捞以及违反捕捞许可证规定。声明指出，被查扣的船只包括中国和印度尼西亚籍船只。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E6%9C%AC%E6%9C%88%E6%9F%A5%E6%89%A3%E5%A4%9A%E8%89%98%E4%B8%AD%E5%9B%BD%E5%8F%8A%E5%8D%B0%E5%B0%BC%E6%B8%94%E8%88%B9%EF%BC%8C%E6%8C%81%E7%BB%AD%E6%89%93%E5%87%BB%E9%9D%9E%E6%B3%95%E6%8D%95%E6%8D%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787302534000.webp","sourceId":"rfi"},{"id":1787300676000,"createdDate":"2026-08-21 08:24","name":"法国国际广播电台","title":"王毅在韩国猛批日本 呼吁中韩共同对日施压","content":"中国外交部长王毅20日在首尔与韩国总统府国家安保室长魏圣洛举行会谈，并表示：“应警惕日本右翼势力开历史倒车的言行，绝不允许日本军国主义死灰复燃。”中国以日本首相高市早苗围绕台海有事所作的国会答辩为契机，持续对日施压，此次批判被认为是在中韩都在8月15日抗议日本高市内阁多名阁僚参拜靖国神社等的背景下，意在呼吁韩国与中国共同对日施压。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260821-%E7%8E%8B%E6%AF%85%E5%9C%A8%E9%9F%A9%E5%9B%BD%E7%8C%9B%E6%89%B9%E6%97%A5%E6%9C%AC-%E5%91%BC%E5%90%81%E4%B8%AD%E9%9F%A9%E5%85%B1%E5%90%8C%E5%AF%B9%E6%97%A5%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300676000.webp","sourceId":"rfi"},{"id":1787300436000,"createdDate":"2026-08-21 08:20","name":"法国国际广播电台","title":"美国点名中国：要求加入针对伊朗的大规模经济制裁行动，中方作出回应","content":"美国周四（8月20日）敦促其盟友以及中国加入一场针对伊朗的大规模经济施压行动，意在迫使德黑兰政权“垮台”，同时避免恢复大规模军事行动。伊朗外交部则回应称，美国的做法属于“经济恐怖主义”。目前，美国已经对伊朗实施海上封锁以及大量制裁。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E7%BE%8E%E5%9B%BD%E7%82%B9%E5%90%8D%E4%B8%AD%E5%9B%BD-%E8%A6%81%E6%B1%82%E5%8A%A0%E5%85%A5%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%9A%84%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%E8%A1%8C%E5%8A%A8%EF%BC%8C%E4%B8%AD%E6%96%B9%E4%BD%9C%E5%87%BA%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300436000.webp","sourceId":"rfi"},{"id":1787299834000,"createdDate":"2026-08-21 08:10","name":"法国国际广播电台","title":"台湾县市长选举倒数百日 台北市长候选人沈伯洋：100天足以改变一座城市","content":"2026年台湾九合一大选如今距离选举日不到100天，六都选战蓝绿战况分析为何？首都台北市长民进党参选人沈伯洋持续勤跑基层提高知名度。力拼连任的市长蒋万安表示，年底选战要让蓝白席次最大化。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%8F%B0%E6%B9%BE%E5%8E%BF%E5%B8%82%E9%95%BF%E9%80%89%E4%B8%BE%E5%80%92%E6%95%B0%E7%99%BE%E6%97%A5-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E5%80%99%E9%80%89%E4%BA%BA%E6%B2%88%E4%BC%AF%E6%B4%8B-100%E5%A4%A9%E8%B6%B3%E4%BB%A5%E6%94%B9%E5%8F%98%E4%B8%80%E5%BA%A7%E5%9F%8E%E5%B8%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299834000.webp","sourceId":"rfi"},{"id":1787299057000,"createdDate":"2026-08-21 07:57","name":"法国国际广播电台","title":"国安称要严惩支联会被告 家属对裁决感愤怒 讨论上诉 人权组织斥是要禁悼六四","content":"被迫解散的支联会及其前正副主席李卓人及邹幸彤被裁定「煽动他人颠覆国家政权」罪名成立，香港政府表示欢迎，特首李家超更表明，支联会意图激起市民对中共和中央政府的憎恨必须予以惩治；但被告家属则对裁决表示愤怒和失望，会讨论上诉事宜。两个国际人权组织则发表声明指，裁决再次证明《港区国安法》被用作惩罚以和平方式悼念六四的人士，亦是港府蓄意抹杀六四历史的一个黑暗里程碑。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%9B%BD%E5%AE%89%E7%A7%B0%E8%A6%81%E4%B8%A5%E6%83%A9%E6%94%AF%E8%81%94%E4%BC%9A%E8%A2%AB%E5%91%8A-%E5%AE%B6%E5%B1%9E%E5%AF%B9%E8%A3%81%E5%86%B3%E6%84%9F%E6%84%A4%E6%80%92-%E8%AE%A8%E8%AE%BA%E4%B8%8A%E8%AF%89-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%96%A5%E6%98%AF%E8%A6%81%E7%A6%81%E6%82%BC%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299057000.webp","sourceId":"rfi"},{"id":1787298911000,"createdDate":"2026-08-21 07:55","name":"法国国际广播电台","title":"联合国安理会再次就秘书长换届举行意向性投票，多国力推女性出任","content":"周五（8月21日），联合国安理会举行第二轮“意向性投票”，以推进下一任联合国秘书长的遴选。预计安理会15个成员将于当地时间10时（格林尼治标准时间14时）开始闭门会议，以匿名方式对每位候选人作出评价，分别标记为“鼓励”“不鼓励”或“无意见”。在联合国机构内部存在严重分歧的背景下，这一进程仍充满不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E8%81%94%E5%90%88%E5%9B%BD%E5%AE%89%E7%90%86%E4%BC%9A%E5%86%8D%E6%AC%A1%E5%B0%B1%E7%A7%98%E4%B9%A6%E9%95%BF%E6%8D%A2%E5%B1%8A%E4%B8%BE%E8%A1%8C%E6%84%8F%E5%90%91%E6%80%A7%E6%8A%95%E7%A5%A8%EF%BC%8C%E5%A4%9A%E5%9B%BD%E5%8A%9B%E6%8E%A8%E5%A5%B3%E6%80%A7%E5%87%BA%E4%BB%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298911000.webp","sourceId":"rfi"},{"id":1787298708000,"createdDate":"2026-08-21 07:51","name":"法国国际广播电台","title":"支联会及正副主席裁定煽颠罪成 法庭指结束一党专政违宪 鼓吹即非法","content":"被迫解散的香港市民支援爱国民主运动联合会(支联会)及其前主席李卓人、前副主席邹幸彤被裁定「煽动颠覆国家政权」简称「煽颠」)罪名成立，法官认为，该会五大纲领中的「结束一党专政」违反中国宪法中订明的中国由中共领导的本质，各被告在《港区国安法》生效后继续推动此纲领属非法手段，触犯该法例中的「煽颠」罪。法官将案押后至下周五(28日)听取被告求情。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E6%94%AF%E8%81%94%E4%BC%9A%E5%8F%8A%E6%AD%A3%E5%89%AF%E4%B8%BB%E5%B8%AD%E8%A3%81%E5%AE%9A%E7%85%BD%E9%A2%A0%E7%BD%AA%E6%88%90-%E6%B3%95%E5%BA%AD%E6%8C%87%E7%BB%93%E6%9D%9F%E4%B8%80%E5%85%9A%E4%B8%93%E6%94%BF%E8%BF%9D%E5%AE%AA-%E9%BC%93%E5%90%B9%E5%8D%B3%E9%9D%9E%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298708000.webp","sourceId":"rfi"},{"id":1787323342000,"createdDate":"2026-08-21 14:42","name":"法国国际广播电台","title":"中国即将发射嫦娥七号，奔赴月球南极搜寻冰冻水资源","content":"法新社周五(8月21日)的报道称，中国即将发射嫦娥七号（Chang’e-7），这是中国迄今技术最复杂的月球探测任务。该任务的目标是寻找月球南极附近永久处于阴影中的陨石坑内可能存在的冰冻水资源。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%B8%AD%E5%9B%BD%E5%8D%B3%E5%B0%86%E5%8F%91%E5%B0%84%E5%AB%A6%E5%A8%A5%E4%B8%83%E5%8F%B7%EF%BC%8C%E5%A5%94%E8%B5%B4%E6%9C%88%E7%90%83%E5%8D%97%E6%9E%81%E6%90%9C%E5%AF%BB%E5%86%B0%E5%86%BB%E6%B0%B4%E8%B5%84%E6%BA%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787323342000.webp","sourceId":"rfi"},{"id":1787322375000,"createdDate":"2026-08-21 14:26","name":"法国国际广播电台","title":"伊朗总统表示应结束战争，并认为伊朗现在“处于有利地位”","content":"伊朗总统马苏德·佩泽希齐扬周五（8月21日）表示，现在是结束与美国战争的时候了。他认为，伊朗目前“处于有利地位”，而美国则希望通过一场新的“经济战争”向伊朗施压。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E8%A1%A8%E7%A4%BA%E5%BA%94%E7%BB%93%E6%9D%9F%E6%88%98%E4%BA%89%EF%BC%8C%E5%B9%B6%E8%AE%A4%E4%B8%BA%E4%BC%8A%E6%9C%97%E7%8E%B0%E5%9C%A8-%E5%A4%84%E4%BA%8E%E6%9C%89%E5%88%A9%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787322375000.webp","sourceId":"rfi"},{"id":1787321555000,"createdDate":"2026-08-21 14:12","name":"法国国际广播电台","title":"专家担心特朗普与金正恩再次会晤恐成又一次外交挫败","content":"21日出版的法国全国性大报头版头条均以法国国内话题开篇。国际版最凸出的主题是东亚安全。美国总统特朗普在美韩年度联合军演启动前夜提出要大幅缩减联合军演的规模，并导致原定11天的演习提前六天结束引发对美国在东亚地区安全战略部署有变的担忧。21日出版的法国《解放报》和《费加罗报》都以很大篇幅予以关注。关于中国，《回声报》特别报道了德国为应对中国进口商品浪潮开始调整立场的努力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260821-%E4%B8%93%E5%AE%B6%E6%8B%85%E5%BF%83%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E5%86%8D%E6%AC%A1%E4%BC%9A%E6%99%A4%E4%BC%9A%E6%98%AF%E5%8F%88%E4%B8%80%E6%AC%A1%E5%A4%96%E4%BA%A4%E6%8C%AB%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787321555000.webp","sourceId":"rfi"},{"id":1787318862000,"createdDate":"2026-08-21 13:27","name":"法国国际广播电台","title":"香港支联会成员被定罪：台湾呼吁中国“停止政治迫害”，法德发表联合声明呼吁“立即释放”","content":"周五(8月21日)，被迫解散的香港市民支援爱国民主运动联合会(简称支联会)及其前主席李卓人、前副主席邹幸彤被裁定“煽动颠覆国家政权”罪名成立。随后，台湾及法国和德国相继发声表达关切，并呼吁“立即释放”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E9%A6%99%E6%B8%AF%E6%94%AF%E8%81%94%E4%BC%9A%E6%88%90%E5%91%98%E8%A2%AB%E5%AE%9A%E7%BD%AA-%E5%8F%B0%E6%B9%BE%E5%91%BC%E5%90%81%E4%B8%AD%E5%9B%BD-%E5%81%9C%E6%AD%A2%E6%94%BF%E6%B2%BB%E8%BF%AB%E5%AE%B3-%EF%BC%8C%E6%B3%95%E5%BE%B7%E5%8F%91%E8%A1%A8%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E%E5%91%BC%E5%90%81-%E7%AB%8B%E5%8D%B3%E9%87%8A%E6%94%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787318862000.webp","sourceId":"rfi"},{"id":1787318279000,"createdDate":"2026-08-21 13:17","name":"法国国际广播电台","title":"特朗普祭“经济D日”　能否逼伊朗结束战争","content":"美国总统特朗普（DonaldTrump）威胁对伊朗发动“有史以来最具摧毁性的经济行动”，并把制裁范围扩大至任何向德黑兰提供金融、能源、航运或贸易“生命线”的国家。特朗普政府认为，军事打击、海上封锁和金融制裁可以形成“双重打击”，迫使伊朗接受新的核协议和安全安排。但伊朗表示，美国加码制裁只会带来“进一步失败”，并拒绝承认经济已接近崩溃。市场则率先反映另一种风险，特朗普威胁升级经济战后，国际油价一度升至每桶94美元附近，显示投资者担心制裁可能反而推高霍尔木兹海峡和全球能源市场的风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260821-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A5%AD-%E7%BB%8F%E6%B5%8Ed%E6%97%A5-%E8%83%BD%E5%90%A6%E9%80%BC%E4%BC%8A%E6%9C%97%E7%BB%93%E6%9D%9F%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787318279000.webp","sourceId":"rfi"},{"id":1787316959000,"createdDate":"2026-08-21 12:55","name":"法国国际广播电台","title":"中国与印尼举行防务与安全会谈","content":"中国外长和防长周五双双抵达雅加达，与印尼的同行举行旨在加强合作的会谈。但此前几天，中国在台湾附近海域举行了海军演习，台北方面称此举为“挑衅”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260821-%E4%B8%AD%E5%9B%BD%E4%B8%8E%E5%8D%B0%E5%B0%BC%E4%B8%BE%E8%A1%8C%E9%98%B2%E5%8A%A1%E4%B8%8E%E5%AE%89%E5%85%A8%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787316959000.webp","sourceId":"rfi"},{"id":1787313477000,"createdDate":"2026-08-21 11:57","name":"法国国际广播电台","title":"“烂到极致，反而成了神作”：被誉为“纯手搓”的中国动画《牛来》意外走红","content":"近日，一部被网友吐槽“粗糙”“制作潦草”却又被认为“充满人情味”的低成本动画电影《牛来》在中国影院意外走红。这部被称为“纯手搓”的影片最初因画面质量饱受网络嘲讽，但不久后却凭借这些嘲讽掀起观影热潮。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260821-%E7%83%82%E5%88%B0%E6%9E%81%E8%87%B4%EF%BC%8C%E5%8F%8D%E8%80%8C%E6%88%90%E4%BA%86%E7%A5%9E%E4%BD%9C-%E8%A2%AB%E8%AA%89%E4%B8%BA-%E7%BA%AF%E6%89%8B%E6%90%93-%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%8A%A8%E7%94%BB-%E7%89%9B%E6%9D%A5-%E6%84%8F%E5%A4%96%E8%B5%B0%E7%BA%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787313477000.webp","sourceId":"rfi"},{"id":1787312735000,"createdDate":"2026-08-21 11:45","name":"法国国际广播电台","title":"北京否认“任意拘押”缅甸问题学者敏辛，指称“这位美国公民涉嫌危害国家安全”","content":"中国周五（8月21日）表示，今年6月在中国被捕的一名美国公民目前是依据中国法律受到拘押，并否认美国国务院所称的“任意拘押”说法。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E5%8C%97%E4%BA%AC%E5%90%A6%E8%AE%A4-%E4%BB%BB%E6%84%8F%E6%8B%98%E6%8A%BC-%E7%BC%85%E7%94%B8%E9%97%AE%E9%A2%98%E5%AD%A6%E8%80%85%E6%95%8F%E8%BE%9B%EF%BC%8C%E6%8C%87%E7%A7%B0-%E8%BF%99%E4%BD%8D%E7%BE%8E%E5%9B%BD%E5%85%AC%E6%B0%91%E6%B6%89%E5%AB%8C%E5%8D%B1%E5%AE%B3%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787312735000.webp","sourceId":"rfi"},{"id":1787304092000,"createdDate":"2026-08-21 09:21","name":"法国国际广播电台","title":"中国科研船第三次现身台湾西部敏感海域，台湾发出“强烈警告”并进行跟踪","content":"台湾海巡部门周五5（8月21日）表示，一艘中国科研船在台湾西部敏感海域航行，台方已对其发出警告并进行跟踪。据悉，这是该船自今年5月以来第三次出现在相关海域，台湾方面认为此举属于持续性的海上挑衅。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%B8%AD%E5%9B%BD%E7%A7%91%E7%A0%94%E8%88%B9%E7%AC%AC%E4%B8%89%E6%AC%A1%E7%8E%B0%E8%BA%AB%E5%8F%B0%E6%B9%BE%E8%A5%BF%E9%83%A8%E6%95%8F%E6%84%9F%E6%B5%B7%E5%9F%9F%EF%BC%8C%E5%8F%B0%E6%B9%BE%E5%8F%91%E5%87%BA-%E5%BC%BA%E7%83%88%E8%AD%A6%E5%91%8A-%E5%B9%B6%E8%BF%9B%E8%A1%8C%E8%B7%9F%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787304092000.webp","sourceId":"rfi"}]