[{"id":1787303009000,"createdDate":"2026-08-21 09:03","name":"法国国际广播电台","title":"俄罗斯计划在争议岛屿附近进行导弹试射，日本提出抗议并称“不可接受”","content":"周五(8月21日)，日本在获悉俄罗斯计划在存在领土争议的岛屿附近进行导弹试射后，向俄方提出抗议。此前，就在上周，俄罗斯总统普京曾访问这些岛屿，引发了日方强烈谴责。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%BF%84%E7%BD%97%E6%96%AF%E8%AE%A1%E5%88%92%E5%9C%A8%E4%BA%89%E8%AE%AE%E5%B2%9B%E5%B1%BF%E9%99%84%E8%BF%91%E8%BF%9B%E8%A1%8C%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84%EF%BC%8C%E6%97%A5%E6%9C%AC%E6%8F%90%E5%87%BA%E6%8A%97%E8%AE%AE%E5%B9%B6%E7%A7%B0-%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787303009000.webp","sourceId":"rfi"},{"id":1787302534000,"createdDate":"2026-08-21 08:55","name":"法国国际广播电台","title":"太平洋岛国本月查扣多艘中国及印尼渔船，持续打击非法捕捞","content":"周五（8月21日），太平洋岛国论坛渔业局（FFA）在向法新社提供的一份声明中表示，基里巴斯、帕劳和巴布亚新几内亚当局共扣留或押送4艘船只进港，原因包括非法捕捞以及违反捕捞许可证规定。声明指出，被查扣的船只包括中国和印度尼西亚籍船只。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E6%9C%AC%E6%9C%88%E6%9F%A5%E6%89%A3%E5%A4%9A%E8%89%98%E4%B8%AD%E5%9B%BD%E5%8F%8A%E5%8D%B0%E5%B0%BC%E6%B8%94%E8%88%B9%EF%BC%8C%E6%8C%81%E7%BB%AD%E6%89%93%E5%87%BB%E9%9D%9E%E6%B3%95%E6%8D%95%E6%8D%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787302534000.webp","sourceId":"rfi"},{"id":1787300676000,"createdDate":"2026-08-21 08:24","name":"法国国际广播电台","title":"王毅在韩国猛批日本 呼吁中韩共同对日施压","content":"中国外交部长王毅20日在首尔与韩国总统府国家安保室长魏圣洛举行会谈，并表示：“应警惕日本右翼势力开历史倒车的言行，绝不允许日本军国主义死灰复燃。”中国以日本首相高市早苗围绕台海有事所作的国会答辩为契机，持续对日施压，此次批判被认为是在中韩都在8月15日抗议日本高市内阁多名阁僚参拜靖国神社等的背景下，意在呼吁韩国与中国共同对日施压。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260821-%E7%8E%8B%E6%AF%85%E5%9C%A8%E9%9F%A9%E5%9B%BD%E7%8C%9B%E6%89%B9%E6%97%A5%E6%9C%AC-%E5%91%BC%E5%90%81%E4%B8%AD%E9%9F%A9%E5%85%B1%E5%90%8C%E5%AF%B9%E6%97%A5%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300676000.webp","sourceId":"rfi"},{"id":1787300436000,"createdDate":"2026-08-21 08:20","name":"法国国际广播电台","title":"美国点名中国：要求加入针对伊朗的大规模经济制裁行动，中方作出回应","content":"美国周四（8月20日）敦促其盟友以及中国加入一场针对伊朗的大规模经济施压行动，意在迫使德黑兰政权“垮台”，同时避免恢复大规模军事行动。伊朗外交部则回应称，美国的做法属于“经济恐怖主义”。目前，美国已经对伊朗实施海上封锁以及大量制裁。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E7%BE%8E%E5%9B%BD%E7%82%B9%E5%90%8D%E4%B8%AD%E5%9B%BD-%E8%A6%81%E6%B1%82%E5%8A%A0%E5%85%A5%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%9A%84%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%E8%A1%8C%E5%8A%A8%EF%BC%8C%E4%B8%AD%E6%96%B9%E4%BD%9C%E5%87%BA%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300436000.webp","sourceId":"rfi"},{"id":1787299834000,"createdDate":"2026-08-21 08:10","name":"法国国际广播电台","title":"台湾县市长选举倒数百日 台北市长候选人沈伯洋：100天足以改变一座城市","content":"2026年台湾九合一大选如今距离选举日不到100天，六都选战蓝绿战况分析为何？首都台北市长民进党参选人沈伯洋持续勤跑基层提高知名度。力拼连任的市长蒋万安表示，年底选战要让蓝白席次最大化。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%8F%B0%E6%B9%BE%E5%8E%BF%E5%B8%82%E9%95%BF%E9%80%89%E4%B8%BE%E5%80%92%E6%95%B0%E7%99%BE%E6%97%A5-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E5%80%99%E9%80%89%E4%BA%BA%E6%B2%88%E4%BC%AF%E6%B4%8B-100%E5%A4%A9%E8%B6%B3%E4%BB%A5%E6%94%B9%E5%8F%98%E4%B8%80%E5%BA%A7%E5%9F%8E%E5%B8%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299834000.webp","sourceId":"rfi"},{"id":1787299057000,"createdDate":"2026-08-21 07:57","name":"法国国际广播电台","title":"国安称要严惩支联会被告 家属对裁决感愤怒 讨论上诉 人权组织斥是要禁悼六四","content":"被迫解散的支联会及其前正副主席李卓人及邹幸彤被裁定「煽动他人颠覆国家政权」罪名成立，香港政府表示欢迎，特首李家超更表明，支联会意图激起市民对中共和中央政府的憎恨必须予以惩治；但被告家属则对裁决表示愤怒和失望，会讨论上诉事宜。两个国际人权组织则发表声明指，裁决再次证明《港区国安法》被用作惩罚以和平方式悼念六四的人士，亦是港府蓄意抹杀六四历史的一个黑暗里程碑。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%9B%BD%E5%AE%89%E7%A7%B0%E8%A6%81%E4%B8%A5%E6%83%A9%E6%94%AF%E8%81%94%E4%BC%9A%E8%A2%AB%E5%91%8A-%E5%AE%B6%E5%B1%9E%E5%AF%B9%E8%A3%81%E5%86%B3%E6%84%9F%E6%84%A4%E6%80%92-%E8%AE%A8%E8%AE%BA%E4%B8%8A%E8%AF%89-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%96%A5%E6%98%AF%E8%A6%81%E7%A6%81%E6%82%BC%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299057000.webp","sourceId":"rfi"},{"id":1787298911000,"createdDate":"2026-08-21 07:55","name":"法国国际广播电台","title":"联合国安理会再次就秘书长换届举行意向性投票，多国力推女性出任","content":"周五（8月21日），联合国安理会举行第二轮“意向性投票”，以推进下一任联合国秘书长的遴选。预计安理会15个成员将于当地时间10时（格林尼治标准时间14时）开始闭门会议，以匿名方式对每位候选人作出评价，分别标记为“鼓励”“不鼓励”或“无意见”。在联合国机构内部存在严重分歧的背景下，这一进程仍充满不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E8%81%94%E5%90%88%E5%9B%BD%E5%AE%89%E7%90%86%E4%BC%9A%E5%86%8D%E6%AC%A1%E5%B0%B1%E7%A7%98%E4%B9%A6%E9%95%BF%E6%8D%A2%E5%B1%8A%E4%B8%BE%E8%A1%8C%E6%84%8F%E5%90%91%E6%80%A7%E6%8A%95%E7%A5%A8%EF%BC%8C%E5%A4%9A%E5%9B%BD%E5%8A%9B%E6%8E%A8%E5%A5%B3%E6%80%A7%E5%87%BA%E4%BB%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298911000.webp","sourceId":"rfi"},{"id":1787298708000,"createdDate":"2026-08-21 07:51","name":"法国国际广播电台","title":"支联会及正副主席裁定煽颠罪成 法庭指结束一党专政违宪 鼓吹即非法","content":"被迫解散的香港市民支援爱国民主运动联合会(支联会)及其前主席李卓人、前副主席邹幸彤被裁定「煽动颠覆国家政权」简称「煽颠」)罪名成立，法官认为，该会五大纲领中的「结束一党专政」违反中国宪法中订明的中国由中共领导的本质，各被告在《港区国安法》生效后继续推动此纲领属非法手段，触犯该法例中的「煽颠」罪。法官将案押后至下周五(28日)听取被告求情。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E6%94%AF%E8%81%94%E4%BC%9A%E5%8F%8A%E6%AD%A3%E5%89%AF%E4%B8%BB%E5%B8%AD%E8%A3%81%E5%AE%9A%E7%85%BD%E9%A2%A0%E7%BD%AA%E6%88%90-%E6%B3%95%E5%BA%AD%E6%8C%87%E7%BB%93%E6%9D%9F%E4%B8%80%E5%85%9A%E4%B8%93%E6%94%BF%E8%BF%9D%E5%AE%AA-%E9%BC%93%E5%90%B9%E5%8D%B3%E9%9D%9E%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298708000.webp","sourceId":"rfi"}]