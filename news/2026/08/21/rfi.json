[{"id":1787303009000,"createdDate":"2026-08-21 09:03","name":"法国国际广播电台","title":"俄罗斯计划在争议岛屿附近进行导弹试射，日本提出抗议并称“不可接受”","content":"周五(8月21日)，日本在获悉俄罗斯计划在存在领土争议的岛屿附近进行导弹试射后，向俄方提出抗议。此前，就在上周，俄罗斯总统普京曾访问这些岛屿，引发了日方强烈谴责。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%BF%84%E7%BD%97%E6%96%AF%E8%AE%A1%E5%88%92%E5%9C%A8%E4%BA%89%E8%AE%AE%E5%B2%9B%E5%B1%BF%E9%99%84%E8%BF%91%E8%BF%9B%E8%A1%8C%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84%EF%BC%8C%E6%97%A5%E6%9C%AC%E6%8F%90%E5%87%BA%E6%8A%97%E8%AE%AE%E5%B9%B6%E7%A7%B0-%E4%B8%8D%E5%8F%AF%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787303009000.webp","sourceId":"rfi"},{"id":1787302534000,"createdDate":"2026-08-21 08:55","name":"法国国际广播电台","title":"太平洋岛国本月查扣多艘中国及印尼渔船，持续打击非法捕捞","content":"周五（8月21日），太平洋岛国论坛渔业局（FFA）在向法新社提供的一份声明中表示，基里巴斯、帕劳和巴布亚新几内亚当局共扣留或押送4艘船只进港，原因包括非法捕捞以及违反捕捞许可证规定。声明指出，被查扣的船只包括中国和印度尼西亚籍船只。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%E6%9C%AC%E6%9C%88%E6%9F%A5%E6%89%A3%E5%A4%9A%E8%89%98%E4%B8%AD%E5%9B%BD%E5%8F%8A%E5%8D%B0%E5%B0%BC%E6%B8%94%E8%88%B9%EF%BC%8C%E6%8C%81%E7%BB%AD%E6%89%93%E5%87%BB%E9%9D%9E%E6%B3%95%E6%8D%95%E6%8D%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787302534000.webp","sourceId":"rfi"},{"id":1787300676000,"createdDate":"2026-08-21 08:24","name":"法国国际广播电台","title":"王毅在韩国猛批日本 呼吁中韩共同对日施压","content":"中国外交部长王毅20日在首尔与韩国总统府国家安保室长魏圣洛举行会谈，并表示：“应警惕日本右翼势力开历史倒车的言行，绝不允许日本军国主义死灰复燃。”中国以日本首相高市早苗围绕台海有事所作的国会答辩为契机，持续对日施压，此次批判被认为是在中韩都在8月15日抗议日本高市内阁多名阁僚参拜靖国神社等的背景下，意在呼吁韩国与中国共同对日施压。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260821-%E7%8E%8B%E6%AF%85%E5%9C%A8%E9%9F%A9%E5%9B%BD%E7%8C%9B%E6%89%B9%E6%97%A5%E6%9C%AC-%E5%91%BC%E5%90%81%E4%B8%AD%E9%9F%A9%E5%85%B1%E5%90%8C%E5%AF%B9%E6%97%A5%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300676000.webp","sourceId":"rfi"},{"id":1787300436000,"createdDate":"2026-08-21 08:20","name":"法国国际广播电台","title":"美国点名中国：要求加入针对伊朗的大规模经济制裁行动，中方作出回应","content":"美国周四（8月20日）敦促其盟友以及中国加入一场针对伊朗的大规模经济施压行动，意在迫使德黑兰政权“垮台”，同时避免恢复大规模军事行动。伊朗外交部则回应称，美国的做法属于“经济恐怖主义”。目前，美国已经对伊朗实施海上封锁以及大量制裁。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E7%BE%8E%E5%9B%BD%E7%82%B9%E5%90%8D%E4%B8%AD%E5%9B%BD-%E8%A6%81%E6%B1%82%E5%8A%A0%E5%85%A5%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%9A%84%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%BB%8F%E6%B5%8E%E5%88%B6%E8%A3%81%E8%A1%8C%E5%8A%A8%EF%BC%8C%E4%B8%AD%E6%96%B9%E4%BD%9C%E5%87%BA%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787300436000.webp","sourceId":"rfi"},{"id":1787299834000,"createdDate":"2026-08-21 08:10","name":"法国国际广播电台","title":"台湾县市长选举倒数百日 台北市长候选人沈伯洋：100天足以改变一座城市","content":"2026年台湾九合一大选如今距离选举日不到100天，六都选战蓝绿战况分析为何？首都台北市长民进党参选人沈伯洋持续勤跑基层提高知名度。力拼连任的市长蒋万安表示，年底选战要让蓝白席次最大化。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%8F%B0%E6%B9%BE%E5%8E%BF%E5%B8%82%E9%95%BF%E9%80%89%E4%B8%BE%E5%80%92%E6%95%B0%E7%99%BE%E6%97%A5-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E5%80%99%E9%80%89%E4%BA%BA%E6%B2%88%E4%BC%AF%E6%B4%8B-100%E5%A4%A9%E8%B6%B3%E4%BB%A5%E6%94%B9%E5%8F%98%E4%B8%80%E5%BA%A7%E5%9F%8E%E5%B8%82","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299834000.webp","sourceId":"rfi"},{"id":1787299057000,"createdDate":"2026-08-21 07:57","name":"法国国际广播电台","title":"国安称要严惩支联会被告 家属对裁决感愤怒 讨论上诉 人权组织斥是要禁悼六四","content":"被迫解散的支联会及其前正副主席李卓人及邹幸彤被裁定「煽动他人颠覆国家政权」罪名成立，香港政府表示欢迎，特首李家超更表明，支联会意图激起市民对中共和中央政府的憎恨必须予以惩治；但被告家属则对裁决表示愤怒和失望，会讨论上诉事宜。两个国际人权组织则发表声明指，裁决再次证明《港区国安法》被用作惩罚以和平方式悼念六四的人士，亦是港府蓄意抹杀六四历史的一个黑暗里程碑。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E5%9B%BD%E5%AE%89%E7%A7%B0%E8%A6%81%E4%B8%A5%E6%83%A9%E6%94%AF%E8%81%94%E4%BC%9A%E8%A2%AB%E5%91%8A-%E5%AE%B6%E5%B1%9E%E5%AF%B9%E8%A3%81%E5%86%B3%E6%84%9F%E6%84%A4%E6%80%92-%E8%AE%A8%E8%AE%BA%E4%B8%8A%E8%AF%89-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%96%A5%E6%98%AF%E8%A6%81%E7%A6%81%E6%82%BC%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787299057000.webp","sourceId":"rfi"},{"id":1787298911000,"createdDate":"2026-08-21 07:55","name":"法国国际广播电台","title":"联合国安理会再次就秘书长换届举行意向性投票，多国力推女性出任","content":"周五（8月21日），联合国安理会举行第二轮“意向性投票”，以推进下一任联合国秘书长的遴选。预计安理会15个成员将于当地时间10时（格林尼治标准时间14时）开始闭门会议，以匿名方式对每位候选人作出评价，分别标记为“鼓励”“不鼓励”或“无意见”。在联合国机构内部存在严重分歧的背景下，这一进程仍充满不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E8%81%94%E5%90%88%E5%9B%BD%E5%AE%89%E7%90%86%E4%BC%9A%E5%86%8D%E6%AC%A1%E5%B0%B1%E7%A7%98%E4%B9%A6%E9%95%BF%E6%8D%A2%E5%B1%8A%E4%B8%BE%E8%A1%8C%E6%84%8F%E5%90%91%E6%80%A7%E6%8A%95%E7%A5%A8%EF%BC%8C%E5%A4%9A%E5%9B%BD%E5%8A%9B%E6%8E%A8%E5%A5%B3%E6%80%A7%E5%87%BA%E4%BB%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298911000.webp","sourceId":"rfi"},{"id":1787298708000,"createdDate":"2026-08-21 07:51","name":"法国国际广播电台","title":"支联会及正副主席裁定煽颠罪成 法庭指结束一党专政违宪 鼓吹即非法","content":"被迫解散的香港市民支援爱国民主运动联合会(支联会)及其前主席李卓人、前副主席邹幸彤被裁定「煽动颠覆国家政权」简称「煽颠」)罪名成立，法官认为，该会五大纲领中的「结束一党专政」违反中国宪法中订明的中国由中共领导的本质，各被告在《港区国安法》生效后继续推动此纲领属非法手段，触犯该法例中的「煽颠」罪。法官将案押后至下周五(28日)听取被告求情。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E6%94%AF%E8%81%94%E4%BC%9A%E5%8F%8A%E6%AD%A3%E5%89%AF%E4%B8%BB%E5%B8%AD%E8%A3%81%E5%AE%9A%E7%85%BD%E9%A2%A0%E7%BD%AA%E6%88%90-%E6%B3%95%E5%BA%AD%E6%8C%87%E7%BB%93%E6%9D%9F%E4%B8%80%E5%85%9A%E4%B8%93%E6%94%BF%E8%BF%9D%E5%AE%AA-%E9%BC%93%E5%90%B9%E5%8D%B3%E9%9D%9E%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787298708000.webp","sourceId":"rfi"},{"id":1787323342000,"createdDate":"2026-08-21 14:42","name":"法国国际广播电台","title":"中国即将发射嫦娥七号，奔赴月球南极搜寻冰冻水资源","content":"法新社周五(8月21日)的报道称，中国即将发射嫦娥七号（Chang’e-7），这是中国迄今技术最复杂的月球探测任务。该任务的目标是寻找月球南极附近永久处于阴影中的陨石坑内可能存在的冰冻水资源。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%B8%AD%E5%9B%BD%E5%8D%B3%E5%B0%86%E5%8F%91%E5%B0%84%E5%AB%A6%E5%A8%A5%E4%B8%83%E5%8F%B7%EF%BC%8C%E5%A5%94%E8%B5%B4%E6%9C%88%E7%90%83%E5%8D%97%E6%9E%81%E6%90%9C%E5%AF%BB%E5%86%B0%E5%86%BB%E6%B0%B4%E8%B5%84%E6%BA%90","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787323342000.webp","sourceId":"rfi"},{"id":1787322375000,"createdDate":"2026-08-21 14:26","name":"法国国际广播电台","title":"伊朗总统表示应结束战争，并认为伊朗现在“处于有利地位”","content":"伊朗总统马苏德·佩泽希齐扬周五（8月21日）表示，现在是结束与美国战争的时候了。他认为，伊朗目前“处于有利地位”，而美国则希望通过一场新的“经济战争”向伊朗施压。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E8%A1%A8%E7%A4%BA%E5%BA%94%E7%BB%93%E6%9D%9F%E6%88%98%E4%BA%89%EF%BC%8C%E5%B9%B6%E8%AE%A4%E4%B8%BA%E4%BC%8A%E6%9C%97%E7%8E%B0%E5%9C%A8-%E5%A4%84%E4%BA%8E%E6%9C%89%E5%88%A9%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787322375000.webp","sourceId":"rfi"},{"id":1787321555000,"createdDate":"2026-08-21 14:12","name":"法国国际广播电台","title":"专家担心特朗普与金正恩再次会晤恐成又一次外交挫败","content":"21日出版的法国全国性大报头版头条均以法国国内话题开篇。国际版最凸出的主题是东亚安全。美国总统特朗普在美韩年度联合军演启动前夜提出要大幅缩减联合军演的规模，并导致原定11天的演习提前六天结束引发对美国在东亚地区安全战略部署有变的担忧。21日出版的法国《解放报》和《费加罗报》都以很大篇幅予以关注。关于中国，《回声报》特别报道了德国为应对中国进口商品浪潮开始调整立场的努力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260821-%E4%B8%93%E5%AE%B6%E6%8B%85%E5%BF%83%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E9%87%91%E6%AD%A3%E6%81%A9%E5%86%8D%E6%AC%A1%E4%BC%9A%E6%99%A4%E4%BC%9A%E6%98%AF%E5%8F%88%E4%B8%80%E6%AC%A1%E5%A4%96%E4%BA%A4%E6%8C%AB%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787321555000.webp","sourceId":"rfi"},{"id":1787318862000,"createdDate":"2026-08-21 13:27","name":"法国国际广播电台","title":"香港支联会成员被定罪：台湾呼吁中国“停止政治迫害”，法德发表联合声明呼吁“立即释放”","content":"周五(8月21日)，被迫解散的香港市民支援爱国民主运动联合会(简称支联会)及其前主席李卓人、前副主席邹幸彤被裁定“煽动颠覆国家政权”罪名成立。随后，台湾及法国和德国相继发声表达关切，并呼吁“立即释放”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E9%A6%99%E6%B8%AF%E6%94%AF%E8%81%94%E4%BC%9A%E6%88%90%E5%91%98%E8%A2%AB%E5%AE%9A%E7%BD%AA-%E5%8F%B0%E6%B9%BE%E5%91%BC%E5%90%81%E4%B8%AD%E5%9B%BD-%E5%81%9C%E6%AD%A2%E6%94%BF%E6%B2%BB%E8%BF%AB%E5%AE%B3-%EF%BC%8C%E6%B3%95%E5%BE%B7%E5%8F%91%E8%A1%A8%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E%E5%91%BC%E5%90%81-%E7%AB%8B%E5%8D%B3%E9%87%8A%E6%94%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787318862000.webp","sourceId":"rfi"},{"id":1787318279000,"createdDate":"2026-08-21 13:17","name":"法国国际广播电台","title":"特朗普祭“经济D日”　能否逼伊朗结束战争","content":"美国总统特朗普（DonaldTrump）威胁对伊朗发动“有史以来最具摧毁性的经济行动”，并把制裁范围扩大至任何向德黑兰提供金融、能源、航运或贸易“生命线”的国家。特朗普政府认为，军事打击、海上封锁和金融制裁可以形成“双重打击”，迫使伊朗接受新的核协议和安全安排。但伊朗表示，美国加码制裁只会带来“进一步失败”，并拒绝承认经济已接近崩溃。市场则率先反映另一种风险，特朗普威胁升级经济战后，国际油价一度升至每桶94美元附近，显示投资者担心制裁可能反而推高霍尔木兹海峡和全球能源市场的风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20260821-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A5%AD-%E7%BB%8F%E6%B5%8Ed%E6%97%A5-%E8%83%BD%E5%90%A6%E9%80%BC%E4%BC%8A%E6%9C%97%E7%BB%93%E6%9D%9F%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787318279000.webp","sourceId":"rfi"},{"id":1787316959000,"createdDate":"2026-08-21 12:55","name":"法国国际广播电台","title":"中国与印尼举行防务与安全会谈","content":"中国外长和防长周五双双抵达雅加达，与印尼的同行举行旨在加强合作的会谈。但此前几天，中国在台湾附近海域举行了海军演习，台北方面称此举为“挑衅”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260821-%E4%B8%AD%E5%9B%BD%E4%B8%8E%E5%8D%B0%E5%B0%BC%E4%B8%BE%E8%A1%8C%E9%98%B2%E5%8A%A1%E4%B8%8E%E5%AE%89%E5%85%A8%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787316959000.webp","sourceId":"rfi"},{"id":1787313477000,"createdDate":"2026-08-21 11:57","name":"法国国际广播电台","title":"“烂到极致，反而成了神作”：被誉为“纯手搓”的中国动画《牛来》意外走红","content":"近日，一部被网友吐槽“粗糙”“制作潦草”却又被认为“充满人情味”的低成本动画电影《牛来》在中国影院意外走红。这部被称为“纯手搓”的影片最初因画面质量饱受网络嘲讽，但不久后却凭借这些嘲讽掀起观影热潮。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260821-%E7%83%82%E5%88%B0%E6%9E%81%E8%87%B4%EF%BC%8C%E5%8F%8D%E8%80%8C%E6%88%90%E4%BA%86%E7%A5%9E%E4%BD%9C-%E8%A2%AB%E8%AA%89%E4%B8%BA-%E7%BA%AF%E6%89%8B%E6%90%93-%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%8A%A8%E7%94%BB-%E7%89%9B%E6%9D%A5-%E6%84%8F%E5%A4%96%E8%B5%B0%E7%BA%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787313477000.webp","sourceId":"rfi"},{"id":1787312735000,"createdDate":"2026-08-21 11:45","name":"法国国际广播电台","title":"北京否认“任意拘押”缅甸问题学者敏辛，指称“这位美国公民涉嫌危害国家安全”","content":"中国周五（8月21日）表示，今年6月在中国被捕的一名美国公民目前是依据中国法律受到拘押，并否认美国国务院所称的“任意拘押”说法。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E5%8C%97%E4%BA%AC%E5%90%A6%E8%AE%A4-%E4%BB%BB%E6%84%8F%E6%8B%98%E6%8A%BC-%E7%BC%85%E7%94%B8%E9%97%AE%E9%A2%98%E5%AD%A6%E8%80%85%E6%95%8F%E8%BE%9B%EF%BC%8C%E6%8C%87%E7%A7%B0-%E8%BF%99%E4%BD%8D%E7%BE%8E%E5%9B%BD%E5%85%AC%E6%B0%91%E6%B6%89%E5%AB%8C%E5%8D%B1%E5%AE%B3%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787312735000.webp","sourceId":"rfi"},{"id":1787304092000,"createdDate":"2026-08-21 09:21","name":"法国国际广播电台","title":"中国科研船第三次现身台湾西部敏感海域，台湾发出“强烈警告”并进行跟踪","content":"台湾海巡部门周五5（8月21日）表示，一艘中国科研船在台湾西部敏感海域航行，台方已对其发出警告并进行跟踪。据悉，这是该船自今年5月以来第三次出现在相关海域，台湾方面认为此举属于持续性的海上挑衅。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260821-%E4%B8%AD%E5%9B%BD%E7%A7%91%E7%A0%94%E8%88%B9%E7%AC%AC%E4%B8%89%E6%AC%A1%E7%8E%B0%E8%BA%AB%E5%8F%B0%E6%B9%BE%E8%A5%BF%E9%83%A8%E6%95%8F%E6%84%9F%E6%B5%B7%E5%9F%9F%EF%BC%8C%E5%8F%B0%E6%B9%BE%E5%8F%91%E5%87%BA-%E5%BC%BA%E7%83%88%E8%AD%A6%E5%91%8A-%E5%B9%B6%E8%BF%9B%E8%A1%8C%E8%B7%9F%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787304092000.webp","sourceId":"rfi"},{"id":1787345637000,"createdDate":"2026-08-21 20:53","name":"法国国际广播电台","title":"俄副外长：“愿倾听解决与乌冲突新提议，但是”","content":"俄罗斯一名高级外交官表示，俄方愿意倾听关于解决与乌克兰冲突的新提议，但任何方案都应反映“实际现状”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260821-%E4%BF%84%E5%89%AF%E5%A4%96%E9%95%BF-%E6%84%BF%E5%80%BE%E5%90%AC%E8%A7%A3%E5%86%B3%E4%B8%8E%E4%B9%8C%E5%86%B2%E7%AA%81%E6%96%B0%E6%8F%90%E8%AE%AE%EF%BC%8C%E4%BD%86%E6%98%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787345637000.webp","sourceId":"rfi"},{"id":1787344125000,"createdDate":"2026-08-21 20:28","name":"法国国际广播电台","title":"欧元区工资增长放缓，通胀预期下调，经济明显增长","content":"欧洲央行周五发布的数据显示，欧元区第二季度的协议工资增长有所放缓，增幅为2.44%，而今年前三个月的增幅为2.56%。对于正试图遏制由战争引发的通胀的欧洲央行而言，这是一个令人欣慰的迹象。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260821-%E6%AC%A7%E5%85%83%E5%8C%BA%E5%B7%A5%E8%B5%84%E5%A2%9E%E9%95%BF%E6%94%BE%E7%BC%93%EF%BC%8C%E9%80%9A%E8%83%80%E9%A2%84%E6%9C%9F%E4%B8%8B%E8%B0%83%EF%BC%8C%E7%BB%8F%E6%B5%8E%E6%98%8E%E6%98%BE%E5%A2%9E%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787344125000.webp","sourceId":"rfi"},{"id":1787344099000,"createdDate":"2026-08-21 20:28","name":"法国国际广播电台","title":"受中期选举压力   特朗普暂免除碎牛肉配额外关税","content":"8月21日，特朗普宣布在未来90天内暂停对30万吨进口牛肉征收关税，此举旨在降低产品价格，以应对11月的中期选举。根据经合组织（OECD）的数据，美国是全球最大的牛肉消费国之一，预计2025年人均牛肉消费量将略超23公斤。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260821-%E5%8F%97%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%8E%8B%E5%8A%9B-%E7%89%B9%E6%9C%97%E6%99%AE%E6%9A%82%E5%85%8D%E9%99%A4%E7%A2%8E%E7%89%9B%E8%82%89%E9%85%8D%E9%A2%9D%E5%A4%96%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787344099000.webp","sourceId":"rfi"},{"id":1787344002000,"createdDate":"2026-08-21 20:26","name":"法国国际广播电台","title":"从柏林近郊疑现俄秘密武器库 到德国军事基地和机场上空的无人机威胁","content":"据中央社8月21日发自柏林的报道：德国安全机构去年在柏林近郊森林中发现一处秘密武器库，研判有可能是由俄罗斯情报机构设置的，以供俄国特务在德国执行暗杀任务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260821-%E4%BB%8E%E6%9F%8F%E6%9E%97%E8%BF%91%E9%83%8A%E7%96%91%E7%8E%B0%E4%BF%84%E7%A7%98%E5%AF%86%E6%AD%A6%E5%99%A8%E5%BA%93-%E5%88%B0%E5%BE%B7%E5%9B%BD%E5%86%9B%E4%BA%8B%E5%9F%BA%E5%9C%B0%E5%92%8C%E6%9C%BA%E5%9C%BA%E4%B8%8A%E7%A9%BA%E7%9A%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787344002000.webp","sourceId":"rfi"},{"id":1787343865000,"createdDate":"2026-08-21 20:24","name":"法国国际广播电台","title":"卢拉与特朗普就关税通电话","content":"巴西总统卢拉周五致电美国总统特朗普，呼吁通过谈判解决美国加征关税引发的问题。今年7月，华盛顿以所谓“不公平贸易行为”为由，对这个拉美最大经济体实施了两轮关税制裁。这一问题已成为巴西10月总统大选竞选活动中的热门话题。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260821-%E5%8D%A2%E6%8B%89%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%B1%E5%85%B3%E7%A8%8E%E9%80%9A%E7%94%B5%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787343865000.webp","sourceId":"rfi"},{"id":1787343681000,"createdDate":"2026-08-21 20:21","name":"法国国际广播电台","title":"英、加、澳抗议以色列停止调查车队袭击案","content":"英国、加拿大和澳大利亚周五谴责以色列的决定是“可耻的”——以色列决定结束对2024年在加沙地带丧生的几名来自上述国家的援助人员死亡事件的调查。伦敦、渥太华和堪培拉在一份联合声明中写道：“两年多来，我们一直敦促以色列迅速、彻查此案，并追究相关责任人的责任。以色列国防军于2026年8月19日宣布不对此次袭击展开刑事调查——且未作任何解释——这种做法是可耻的。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260821-%E8%8B%B1-%E5%8A%A0-%E6%BE%B3%E6%8A%97%E8%AE%AE%E4%BB%A5%E8%89%B2%E5%88%97%E5%81%9C%E6%AD%A2%E8%B0%83%E6%9F%A5%E8%BD%A6%E9%98%9F%E8%A2%AD%E5%87%BB%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787343681000.webp","sourceId":"rfi"},{"id":1787343352000,"createdDate":"2026-08-21 20:15","name":"法国国际广播电台","title":"土耳其对内塔尼亚胡发出国际逮捕令","content":"8月21日，土耳其宣布对以色列总理内塔尼亚胡发出国际逮捕令，这是针对拦截加沙救援船队及拘押船上活动人士事件调查的一部分。内塔尼亚胡回应，埃尔多安是“反犹太的独裁者”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260821-%E5%9C%9F%E8%80%B3%E5%85%B6%E5%AF%B9%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E5%8F%91%E5%87%BA%E5%9B%BD%E9%99%85%E9%80%AE%E6%8D%95%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787343352000.webp","sourceId":"rfi"},{"id":1787343113000,"createdDate":"2026-08-21 20:11","name":"法国国际广播电台","title":"特斯拉中国召回超过400万辆","content":"因嵌入式车门把手存在安全隐患，特斯拉中国召回近300万辆汽车。包括小米在内的至少另外八家制造商也发起了召回，使召回车辆总数超过400万辆，这成为中国汽车史上规模最大的召回行动之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260821-%E7%89%B9%E6%96%AF%E6%8B%89%E4%B8%AD%E5%9B%BD%E5%8F%AC%E5%9B%9E%E8%B6%85%E8%BF%87400%E4%B8%87%E8%BE%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787343113000.webp","sourceId":"rfi"},{"id":1787342951000,"createdDate":"2026-08-21 20:09","name":"法国国际广播电台","title":"希腊利姆诺斯岛发生火灾    游客被疏散","content":"消防官员表示，周五下午，位于爱琴海北部的希腊利姆诺斯岛（Lemnos）发生森林火灾，导致当地居民和旅游者被疏散。据希腊公共广播公司Ertnews报道，目前有6架灭火飞机、3架直升机以及数十名消防员正在扑救大火，火势主要在灌木丛地带蔓延。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260821-%E5%B8%8C%E8%85%8A%E5%88%A9%E5%A7%86%E8%AF%BA%E6%96%AF%E5%B2%9B%E5%8F%91%E7%94%9F%E7%81%AB%E7%81%BE-%E6%B8%B8%E5%AE%A2%E8%A2%AB%E7%96%8F%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787342951000.webp","sourceId":"rfi"},{"id":1787342726000,"createdDate":"2026-08-21 20:05","name":"法国国际广播电台","title":"沙特王储将到访法国    龙珠主题公园项目引人注目","content":"沙特王储穆罕默德·本·萨勒曼（MohammedbenSalmane）将于周日和周一访问巴黎，届时将签署“多项协议”；法方视此举为“在地区局势紧张背景下，法沙关系充满活力”的体现。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260821-%E6%B2%99%E7%89%B9%E7%8E%8B%E5%82%A8%E5%B0%86%E5%88%B0%E8%AE%BF%E6%B3%95%E5%9B%BD-%E9%BE%99%E7%8F%A0%E4%B8%BB%E9%A2%98%E5%85%AC%E5%9B%AD%E9%A1%B9%E7%9B%AE%E5%BC%95%E4%BA%BA%E6%B3%A8%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787342726000.webp","sourceId":"rfi"},{"id":1787342422000,"createdDate":"2026-08-21 20:00","name":"法国国际广播电台","title":"Uber 在荷兰被罚 8.25 亿欧元","content":"荷兰数据监管机构对Uber处以8.25亿欧元罚款，原因是其使用自动化系统停用司机账户，这是GDPR下的第二大罚款。该案涉及2020年至2022年间发生在欧洲的事件，起因是法国收到的一项投诉。这是《通用数据保护条例》（GDPR）实施以来开出的第二大罚单。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20260821-uber-%E5%9C%A8%E8%8D%B7%E5%85%B0%E8%A2%AB%E7%BD%9A-8-25-%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787342422000.webp","sourceId":"rfi"},{"id":1787342139000,"createdDate":"2026-08-21 19:55","name":"法国国际广播电台","title":"法媒赞云南山里娃可乘空中校车就读","content":"在中国云南的悬崖峭壁上，一座高达288米的巨型电梯改变了许多孩子的生活。一座新建的288米高观光电梯让一个偏远村庄的孩子们只需约30分钟就能往返学校，而过去他们不得不沿着悬崖进行长达3小时的艰险跋涉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260821-%E6%B3%95%E5%AA%92%E8%B5%9E%E4%BA%91%E5%8D%97%E5%B1%B1%E9%87%8C%E5%A8%83%E5%8F%AF%E4%B9%98%E7%A9%BA%E4%B8%AD%E6%A0%A1%E8%BD%A6%E5%B0%B1%E8%AF%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787342139000.webp","sourceId":"rfi"},{"id":1787341067000,"createdDate":"2026-08-21 19:37","name":"法国国际广播电台","title":"法新社：中国考虑申办2028年联合国气候变化大会","content":"据两名知情人士周五向法新社透露，中国正考虑申办2028年联合国气候变化大会（COP33）。不过，这些消息人士在证实彭博社相关报道的同时也澄清，北京方面尚未就申办做出最终决定，也未设定具体时间表，因为主办国并不一定非要在今年选定。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260821-%E6%B3%95%E6%96%B0%E7%A4%BE-%E4%B8%AD%E5%9B%BD%E8%80%83%E8%99%91%E7%94%B3%E5%8A%9E2028%E5%B9%B4%E8%81%94%E5%90%88%E5%9B%BD%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E5%A4%A7%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787341067000.webp","sourceId":"rfi"},{"id":1787337283000,"createdDate":"2026-08-21 18:34","name":"法国国际广播电台","title":"支联会案：法律学者批法庭以言入罪 轻易令宪法适用於香港 将改变国际对港看法","content":"三十多年来以和平方式推动平反和悼念六四的香港市民支援爱国民主运动联合会(支联会)及其最後一任领导人李卓人和邹幸彤，被三位国安法指定法官裁定「煽动颠覆国家政权」罪名成立，但人权中心指法官阐释中国宪法是越俎代庖；而法律学者黎恩灏更指出，裁决显示法官是先有政治假设而作出推论定罪，更危险的是，裁决绕过香港基本法，确认中国宪法适用於香港，将为警方日後执行国安法大开方便之门，和平倡议者极易由合法推动变非法，预料将大大改变国际社会对香港的看法。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260821-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88-%E6%B3%95%E5%BE%8B%E5%AD%A6%E8%80%85%E6%89%B9%E6%B3%95%E5%BA%AD%E4%BB%A5%E8%A8%80%E5%85%A5%E7%BD%AA-%E8%BD%BB%E6%98%93%E4%BB%A4%E5%AE%AA%E6%B3%95%E9%80%82%E7%94%A8%E6%96%BC%E9%A6%99%E6%B8%AF-%E5%B0%86%E6%94%B9%E5%8F%98%E5%9B%BD%E9%99%85%E5%AF%B9%E6%B8%AF%E7%9C%8B%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787337283000.webp","sourceId":"rfi"},{"id":1787334611000,"createdDate":"2026-08-21 17:50","name":"法国国际广播电台","title":"美议员促FDA收紧中国临床数据规范　3宗死亡案例引发安全疑虑","content":"美国国会两名共和党众议员本周五致函美国食品暨药物管理局（FDA）代理局长凯尔・迪亚曼塔斯（KyleDiamantas），要求收紧中国临床试验数据，在美国药物开发及审批中的使用规定。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260821-%E7%BE%8E%E8%AE%AE%E5%91%98%E4%BF%83fda%E6%94%B6%E7%B4%A7%E4%B8%AD%E5%9B%BD%E4%B8%B4%E5%BA%8A%E6%95%B0%E6%8D%AE%E8%A7%84%E8%8C%83-3%E5%AE%97%E6%AD%BB%E4%BA%A1%E6%A1%88%E4%BE%8B%E5%BC%95%E5%8F%91%E5%AE%89%E5%85%A8%E7%96%91%E8%99%91","thumbnail":"","detailImage":"news/detail/rfi/2026/08/21/1787334611000.webp","sourceId":"rfi"}]