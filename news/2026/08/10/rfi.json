[{"id":1786353727000,"createdDate":"2026-08-10 09:22","name":"法国国际广播电台","title":"因未被安排在外交使团区域 台湾方面向长崎市表示抗议","content":"台北驻日经济文化代表处代表李逸洋9日因在长崎举行的“长崎原子弹爆炸遇难者慰灵暨和平祈念仪式”上被安排在“外交使团区域以外”的座位，决定不出席该仪式，仪式由福冈分处处长陈铭俊代表出席。台北驻日经济文化代表处对此发表声明表示抗议。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260810-%E5%9B%A0%E6%9C%AA%E8%A2%AB%E5%AE%89%E6%8E%92%E5%9C%A8%E5%A4%96%E4%BA%A4%E4%BD%BF%E5%9B%A2%E5%8C%BA%E5%9F%9F-%E5%8F%B0%E6%B9%BE%E6%96%B9%E9%9D%A2%E5%90%91%E9%95%BF%E5%B4%8E%E5%B8%82%E8%A1%A8%E7%A4%BA%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786353727000.webp","sourceId":"rfi"},{"id":1786349789000,"createdDate":"2026-08-10 08:16","name":"法国国际广播电台","title":"台风“白海豚”持续影响中国东部 上海多地被淹 943个航班取消","content":"台风“白海豚”登陆后持续影响中国东部地区。尽管风力逐渐减弱，但所带来的强降雨仍将席卷浙江、安徽、江苏、山东等地，造成上海多地积水，数百个航班被取消。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260810-%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E5%BD%B1%E5%93%8D%E4%B8%AD%E5%9B%BD%E4%B8%9C%E9%83%A8-%E4%B8%8A%E6%B5%B7%E5%A4%9A%E5%9C%B0%E8%A2%AB%E6%B7%B9-943%E4%B8%AA%E8%88%AA%E7%8F%AD%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786349789000.webp","sourceId":"rfi"},{"id":1786349073000,"createdDate":"2026-08-10 08:04","name":"法国国际广播电台","title":"国民党主席郑丽文称「台湾从不是国家」引风波 绿营批掩饰选战无能搏版面","content":"国民党主席郑丽文日前表示，台湾从来没有独立过，台湾也从来不是一个国家。此说法立刻引起绿营立委批评，身为台湾培育出的政治人物，却否定自己的国家认同。另外，法律学者也反驳其说法无依据。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-%E5%9B%BD%E6%B0%91%E5%85%9A%E4%B8%BB%E5%B8%AD%E9%83%91%E4%B8%BD%E6%96%87%E7%A7%B0-%E5%8F%B0%E6%B9%BE%E4%BB%8E%E4%B8%8D%E6%98%AF%E5%9B%BD%E5%AE%B6-%E5%BC%95%E9%A3%8E%E6%B3%A2-%E7%BB%BF%E8%90%A5%E6%89%B9%E6%8E%A9%E9%A5%B0%E9%80%89%E6%88%98%E6%97%A0%E8%83%BD%E6%90%8F%E7%89%88%E9%9D%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786349073000.webp","sourceId":"rfi"},{"id":1786345388000,"createdDate":"2026-08-10 07:03","name":"法国国际广播电台","title":"香港记协举行换届选举 期间疑有便衣警在场外守候","content":"香港记者协会（记协）执委会换届选举上周六（8日）举行，继选举前夕遭港府高层威吓後，投票当日更有疑似便衣男警在会场外拍摄与会者相片。资深传媒人吴志森批评官员指记协选举欠缺认受性的说法，反指这是官方施压，使主流媒体记者不敢参选。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-%E9%A6%99%E6%B8%AF%E8%AE%B0%E5%8D%8F%E4%B8%BE%E8%A1%8C%E6%8D%A2%E5%B1%8A%E9%80%89%E4%B8%BE-%E6%9C%9F%E9%97%B4%E7%96%91%E6%9C%89%E4%BE%BF%E8%A1%A3%E8%AD%A6%E5%9C%A8%E5%9C%BA%E5%A4%96%E5%AE%88%E5%80%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786345388000.webp","sourceId":"rfi"},{"id":1786345071000,"createdDate":"2026-08-10 06:57","name":"法国国际广播电台","title":"「47人案」11名在囚者获批终极上诉 指事涉议员职能与国安犯罪元素的分野","content":"导致最多香港民主派人士入狱的初选案(又称「47人案」)，当中11名因串谋颠覆国家政权罪成被判囚的被告提出终极上诉，获上诉庭批出上诉至终审法院的证明书，司法机构稍後或将排期研讯。上诉庭认为，案件涉及《港区国安法》的犯罪构成元素，以及立法会议员履行宪制职能时的责任等问题，属重要的法律问题，值得交由最高级的终审法院作出首次裁决。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-47%E4%BA%BA%E6%A1%88-11%E5%90%8D%E5%9C%A8%E5%9B%9A%E8%80%85%E8%8E%B7%E6%89%B9%E7%BB%88%E6%9E%81%E4%B8%8A%E8%AF%89-%E6%8C%87%E4%BA%8B%E6%B6%89%E8%AE%AE%E5%91%98%E8%81%8C%E8%83%BD%E4%B8%8E%E5%9B%BD%E5%AE%89%E7%8A%AF%E7%BD%AA%E5%85%83%E7%B4%A0%E7%9A%84%E5%88%86%E9%87%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786345071000.webp","sourceId":"rfi"},{"id":1786382070000,"createdDate":"2026-08-10 17:14","name":"法国国际广播电台","title":"伊朗军事和安全机构最高层出现人事异动","content":"伊朗高层展开“换头”行动：一起是以继续神隐的最高领袖小哈梅内伊的名义更换军队领导层；另一起是总统佩泽什基安办公室宣布最高安全机构更换负责人。此刻德黑兰正竭尽所能与华盛顿拖延拉锯...","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260810-%E4%BC%8A%E6%9C%97%E5%86%9B%E4%BA%8B%E5%92%8C%E5%AE%89%E5%85%A8%E6%9C%BA%E6%9E%84%E6%9C%80%E9%AB%98%E5%B1%82%E5%87%BA%E7%8E%B0%E4%BA%BA%E4%BA%8B%E5%BC%82%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786382070000.webp","sourceId":"rfi"},{"id":1786380771000,"createdDate":"2026-08-10 16:52","name":"法国国际广播电台","title":"非洲:喀麦隆北部爆跨国霍乱疫情","content":"非洲国家喀麦隆（leCameroun）极北区霍乱(lecholéra)疫情反复出现。当地现已通报了近千宗病例。这是本台法广非洲组（RFIAfrique）今天（2026年08月10日星期一）上网的最新法文消息之一。本轮疫情早已跨越国境。邻国尼日利亚(leNigéria)自5月以来就已受到波及，乍得(leTchad)近期也记录到13宗与霍乱相关的死亡病例。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260810-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%96%80%E9%BA%A6%E9%9A%86%E5%8C%97%E9%83%A8%E7%88%86%E8%B7%A8%E5%9B%BD%E9%9C%8D%E4%B9%B1%E7%96%AB%E6%83%85","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786380771000.webp","sourceId":"rfi"},{"id":1786374134000,"createdDate":"2026-08-10 15:02","name":"法国国际广播电台","title":"英皇家海军无人侦查载具秘密向中国传送数据...","content":"据《每日电讯报》独家披露，英国特种部队使用的皇家海军无人侦察机（艇）上的间谍摄像机，曾秘密向中国传输数据……，并透露，计划用于波斯湾任务的英国特种部队舰艇装备了中国制造的零部件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260810-%E8%8B%B1%E7%9A%87%E5%AE%B6%E6%B5%B7%E5%86%9B%E6%97%A0%E4%BA%BA%E4%BE%A6%E6%9F%A5%E8%BD%BD%E5%85%B7%E8%A2%AB%E5%8F%91%E7%8E%B0%E7%A7%98%E5%AF%86%E5%90%91%E4%B8%AD%E5%9B%BD%E4%BC%A0%E9%80%81%E6%95%B0%E6%8D%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786374134000.webp","sourceId":"rfi"},{"id":1786371998000,"createdDate":"2026-08-10 14:26","name":"法国国际广播电台","title":"法媒解析台海冲突：美国不会对中国退让，押注一支“隐匿深海伺机突击”的舰队","content":"法国《观点》周刊网站8月8日晚间报道说，华盛顿正在为潜在的对华战争改造其潜艇力量。19艘“弗吉尼亚”级潜艇将被改造成真正的导弹发射平台，能够从深海发动打击。换句话说，美国正在把过去集中在4艘“俄亥俄”级潜艇上的巨大火力，重新分散到19艘“弗吉尼亚”级潜艇上。据该报道认为，这一决定向北京释放了一个明确的信息，那就是美国不会在台湾问题上退让。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260810-%E5%8F%B0%E6%B5%B7%E5%86%B2%E7%AA%81-%E7%BE%8E%E5%9B%BD%E4%B8%8D%E4%BC%9A%E5%AF%B9%E4%B8%AD%E5%9B%BD%E9%80%80%E8%AE%A9%EF%BC%8C%E6%8A%BC%E6%B3%A8%E4%B8%80%E6%94%AF-%E9%9A%90%E5%8C%BF%E6%B7%B1%E6%B5%B7%E4%BC%BA%E6%9C%BA%E7%AA%81%E5%87%BB-%E7%9A%84%E8%88%B0%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786371998000.webp","sourceId":"rfi"},{"id":1786370097000,"createdDate":"2026-08-10 13:54","name":"法国国际广播电台","title":"俄军空袭乌克兰哈尔科夫地区造成5人死亡","content":"俄罗斯对乌克兰东北部哈尔科夫地区发动袭击，据当地当局周一宣布，这次袭击造成5人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260810-%E4%BF%84%E5%86%9B%E7%A9%BA%E8%A2%AD%E4%B9%8C%E5%85%8B%E5%85%B0%E5%93%88%E5%B0%94%E7%A7%91%E5%A4%AB%E5%9C%B0%E5%8C%BA%E9%80%A0%E6%88%905%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786370097000.webp","sourceId":"rfi"},{"id":1786368564000,"createdDate":"2026-08-10 13:29","name":"法国国际广播电台","title":"回应特朗普“一盘棋”比喻 伊朗自诩为“专业棋手”","content":"在伊朗最新表态、将霍尔木兹海峡重新开放与美国必须全面让步挂钩之后，国际油价周一止跌徘徊后小幅上涨，此前，因传出伊朗与阿曼就霍尔木兹海峡新航道接近达成协议，国际原油两大基准油价在上周均下跌超过7%。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260810-%E5%9B%9E%E5%BA%94%E7%89%B9%E6%9C%97%E6%99%AE-%E4%B8%80%E7%9B%98%E6%A3%8B-%E6%AF%94%E5%96%BB-%E4%BC%8A%E6%9C%97%E8%87%AA%E8%AF%A9%E4%B8%BA-%E4%B8%93%E4%B8%9A%E6%A3%8B%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786368564000.webp","sourceId":"rfi"},{"id":1786367807000,"createdDate":"2026-08-10 13:16","name":"法国国际广播电台","title":"阿尔及利亚营救尼日尔德国人质","content":"在非洲国家尼日尔(leNiger)遭绑架的一名德国人质，现已被阿尔及利亚当局救出，并于周一在阿尔及尔（Alger）移交驻当地的柏林官方代表。这是本台法广非洲组（RFIAfrique）今天（2026年08月10日星期一）上网的最新法文消息之一。阿尔及利亚（l'Algerie）国防部在宣布这一消息时告知，这位此前曾遭绑匪扣押了超过两个星期之久的德国公民UlumaskanSinan在获救之后，随即被送往距离阿尔及尔（Alger）约三十公里的北部城市布法里克（Boufarik）。他在被移交时，健康状况良好。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260810-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E9%98%BF%E5%B0%94%E5%8F%8A%E5%88%A9%E4%BA%9A%E8%90%A5%E6%95%91%E5%B0%BC%E6%97%A5%E5%B0%94%E5%BE%B7%E5%9B%BD%E4%BA%BA%E8%B4%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786367807000.webp","sourceId":"rfi"},{"id":1786367141000,"createdDate":"2026-08-10 13:05","name":"法国国际广播电台","title":"美斥北京借“自然保护区”伸张南海主权、法国似成“足球界‘加入世贸’前的中国”","content":"大家好，欢迎收听法国报纸摘要，周一8月10日的法国全国性报纸头版焦点各有侧重。《费加罗报》关注受困于外部战争于内部压迫的伊朗人民，指出德黑兰当局正利用战争加强对民众的铁腕统治，而民众中只有极少数人仍然支持它。《解放报》聚焦在随着酷暑而来的干旱正对法国农作物造成灾害。与此同时，各大日报的国际版也报道了，台风“海豚”刚刚在中国东部沿海登陆，面对洪水、内涝和山体滑坡的风险，当局组织了大规模疏散行动。中国东部多个地区超过一百万人流离失所。仅在温州地区，就有约90万居民被疏散，并开设了1500个应急避难所。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260810-%E7%BE%8E%E6%96%A5%E5%8C%97%E4%BA%AC%E4%BB%A5-%E8%87%AA%E7%84%B6%E4%BF%9D%E6%8A%A4%E5%8C%BA-%E5%80%9F%E5%8F%A3%E4%BC%B8%E5%BC%A0%E5%8D%97%E6%B5%B7%E4%B8%BB%E6%9D%83-%E6%B3%95%E5%9B%BD%E4%BC%BC%E6%88%90-%E8%B6%B3%E7%90%83%E7%95%8C-%E5%8A%A0%E5%85%A5%E4%B8%96%E8%B4%B8-%E5%89%8D%E7%9A%84%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786367141000.webp","sourceId":"rfi"},{"id":1786366693000,"createdDate":"2026-08-10 12:58","name":"法国国际广播电台","title":"乌克兰无人机袭击俄罗斯鞑靼斯坦“石化之都” 致13人死亡","content":"周一，俄罗斯中部鞑靼斯坦的一座工业城市发生袭击事件，造成13人死亡。这是自2022年莫斯科对乌克兰发动进攻以来，俄罗斯本土遭遇的最致命袭击之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260810-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%97%A0%E4%BA%BA%E6%9C%BA%E8%A2%AD%E5%87%BB%E4%BF%84%E7%BD%97%E6%96%AF%E9%9E%91%E9%9D%BC%E6%96%AF%E5%9D%A6-%E7%9F%B3%E5%8C%96%E4%B9%8B%E9%83%BD-%E8%87%B413%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786366693000.webp","sourceId":"rfi"},{"id":1786366101000,"createdDate":"2026-08-10 12:48","name":"法国国际广播电台","title":"高市政权欲修改“无核三原则” 加大改善日中关系难度","content":"日本首相高市早苗在8月6日，就任后首次出席广岛原爆和平纪念仪式。她在致辞中表示：“我国正在坚持‘无核三原则’，肩负着为实现没有核武器的世界而不断努力的使命。”在长崎也做出类似表述，日本多家媒体指出，与历任首相使用“在坚持的同时”等词语，表现推进和主导未来无核化意志等表述相比，高市首相所使用的“正在坚持”这一说法，仅仅停留在对现状的说明层面，这与去年石破茂首相着眼未来，表示“在坚持三原则的同时，主导为实现‘没有核武器的世界’所作的努力”的表态有所不同。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20260810-%E9%AB%98%E5%B8%82%E6%94%BF%E6%9D%83%E6%AC%B2%E4%BF%AE%E6%94%B9-%E6%97%A0%E6%A0%B8%E4%B8%89%E5%8E%9F%E5%88%99-%E5%8A%A0%E5%A4%A7%E6%94%B9%E5%96%84%E6%97%A5%E4%B8%AD%E5%85%B3%E7%B3%BB%E9%9A%BE%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786366101000.webp","sourceId":"rfi"},{"id":1786362634000,"createdDate":"2026-08-10 11:50","name":"法国国际广播电台","title":"“哥白尼”数据：全球覆盖9亿人口地域2026年夏遭遇破纪录高温","content":"据法新社8月10日发布根据欧洲“哥白尼”计划数据的统计，包括非洲萨赫勒地区、拉美、法国和西班牙等多个地区，有9亿人在2026年经历了有记录以来最炎热的夏季。33个国家打破了7月份的最高气温纪录。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20260810-%E5%93%A5%E7%99%BD%E5%B0%BC-%E6%95%B0%E6%8D%AE-%E5%85%A8%E7%90%83%E8%A6%86%E7%9B%969%E4%BA%BF%E4%BA%BA%E5%8F%A3%E5%9C%B0%E5%9F%9F2026%E5%B9%B4%E5%A4%8F%E9%81%AD%E9%81%87%E7%A0%B4%E7%BA%AA%E5%BD%95%E9%AB%98%E6%B8%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786362634000.webp","sourceId":"rfi"}]