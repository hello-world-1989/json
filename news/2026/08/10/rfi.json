[{"id":1786353727000,"createdDate":"2026-08-10 09:22","name":"法国国际广播电台","title":"因未被安排在外交使团区域 台湾方面向长崎市表示抗议","content":"台北驻日经济文化代表处代表李逸洋9日因在长崎举行的“长崎原子弹爆炸遇难者慰灵暨和平祈念仪式”上被安排在“外交使团区域以外”的座位，决定不出席该仪式，仪式由福冈分处处长陈铭俊代表出席。台北驻日经济文化代表处对此发表声明表示抗议。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260810-%E5%9B%A0%E6%9C%AA%E8%A2%AB%E5%AE%89%E6%8E%92%E5%9C%A8%E5%A4%96%E4%BA%A4%E4%BD%BF%E5%9B%A2%E5%8C%BA%E5%9F%9F-%E5%8F%B0%E6%B9%BE%E6%96%B9%E9%9D%A2%E5%90%91%E9%95%BF%E5%B4%8E%E5%B8%82%E8%A1%A8%E7%A4%BA%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786353727000.webp","sourceId":"rfi"},{"id":1786349789000,"createdDate":"2026-08-10 08:16","name":"法国国际广播电台","title":"台风“白海豚”持续影响中国东部 上海多地被淹 943个航班取消","content":"台风“白海豚”登陆后持续影响中国东部地区。尽管风力逐渐减弱，但所带来的强降雨仍将席卷浙江、安徽、江苏、山东等地，造成上海多地积水，数百个航班被取消。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260810-%E5%8F%B0%E9%A3%8E-%E7%99%BD%E6%B5%B7%E8%B1%9A-%E5%BD%B1%E5%93%8D%E4%B8%AD%E5%9B%BD%E4%B8%9C%E9%83%A8-%E4%B8%8A%E6%B5%B7%E5%A4%9A%E5%9C%B0%E8%A2%AB%E6%B7%B9-943%E4%B8%AA%E8%88%AA%E7%8F%AD%E5%8F%96%E6%B6%88","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786349789000.webp","sourceId":"rfi"},{"id":1786349073000,"createdDate":"2026-08-10 08:04","name":"法国国际广播电台","title":"国民党主席郑丽文称「台湾从不是国家」引风波 绿营批掩饰选战无能搏版面","content":"国民党主席郑丽文日前表示，台湾从来没有独立过，台湾也从来不是一个国家。此说法立刻引起绿营立委批评，身为台湾培育出的政治人物，却否定自己的国家认同。另外，法律学者也反驳其说法无依据。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-%E5%9B%BD%E6%B0%91%E5%85%9A%E4%B8%BB%E5%B8%AD%E9%83%91%E4%B8%BD%E6%96%87%E7%A7%B0-%E5%8F%B0%E6%B9%BE%E4%BB%8E%E4%B8%8D%E6%98%AF%E5%9B%BD%E5%AE%B6-%E5%BC%95%E9%A3%8E%E6%B3%A2-%E7%BB%BF%E8%90%A5%E6%89%B9%E6%8E%A9%E9%A5%B0%E9%80%89%E6%88%98%E6%97%A0%E8%83%BD%E6%90%8F%E7%89%88%E9%9D%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786349073000.webp","sourceId":"rfi"},{"id":1786345388000,"createdDate":"2026-08-10 07:03","name":"法国国际广播电台","title":"香港记协举行换届选举 期间疑有便衣警在场外守候","content":"香港记者协会（记协）执委会换届选举上周六（8日）举行，继选举前夕遭港府高层威吓後，投票当日更有疑似便衣男警在会场外拍摄与会者相片。资深传媒人吴志森批评官员指记协选举欠缺认受性的说法，反指这是官方施压，使主流媒体记者不敢参选。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-%E9%A6%99%E6%B8%AF%E8%AE%B0%E5%8D%8F%E4%B8%BE%E8%A1%8C%E6%8D%A2%E5%B1%8A%E9%80%89%E4%B8%BE-%E6%9C%9F%E9%97%B4%E7%96%91%E6%9C%89%E4%BE%BF%E8%A1%A3%E8%AD%A6%E5%9C%A8%E5%9C%BA%E5%A4%96%E5%AE%88%E5%80%99","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786345388000.webp","sourceId":"rfi"},{"id":1786345071000,"createdDate":"2026-08-10 06:57","name":"法国国际广播电台","title":"「47人案」11名在囚者获批终极上诉 指事涉议员职能与国安犯罪元素的分野","content":"导致最多香港民主派人士入狱的初选案(又称「47人案」)，当中11名因串谋颠覆国家政权罪成被判囚的被告提出终极上诉，获上诉庭批出上诉至终审法院的证明书，司法机构稍後或将排期研讯。上诉庭认为，案件涉及《港区国安法》的犯罪构成元素，以及立法会议员履行宪制职能时的责任等问题，属重要的法律问题，值得交由最高级的终审法院作出首次裁决。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260810-47%E4%BA%BA%E6%A1%88-11%E5%90%8D%E5%9C%A8%E5%9B%9A%E8%80%85%E8%8E%B7%E6%89%B9%E7%BB%88%E6%9E%81%E4%B8%8A%E8%AF%89-%E6%8C%87%E4%BA%8B%E6%B6%89%E8%AE%AE%E5%91%98%E8%81%8C%E8%83%BD%E4%B8%8E%E5%9B%BD%E5%AE%89%E7%8A%AF%E7%BD%AA%E5%85%83%E7%B4%A0%E7%9A%84%E5%88%86%E9%87%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/10/1786345071000.webp","sourceId":"rfi"}]