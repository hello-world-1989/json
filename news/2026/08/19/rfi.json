[{"id":1787148055000,"createdDate":"2026-08-19 14:00","name":"法国国际广播电台","title":"当英伟达成为AI“央行”：从芯片到金融，AI繁荣背后的风险","content":"8月19日出刊的费加罗报在企业和经济版刊登了一则有关英伟达的报道。题为“担保方、贷款方和投资者，英伟达正在成为人工智能的中央银行”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260819-%E5%BD%93%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%88%90%E4%B8%BAai-%E5%A4%AE%E8%A1%8C-%E4%BB%8E%E8%8A%AF%E7%89%87%E5%88%B0%E9%87%91%E8%9E%8D%EF%BC%8Cai%E7%B9%81%E8%8D%A3%E8%83%8C%E5%90%8E%E7%9A%84%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787148055000.webp","sourceId":"rfi"},{"id":1787147567000,"createdDate":"2026-08-19 13:52","name":"法国国际广播电台","title":"伊朗警告海湾国家不得向美军提供任何帮助 阿联酋暂停与伊朗往来","content":"伊朗周三警告海湾国家不得向美军提供任何帮助。阿联酋决定暂停与德黑兰的贸易往来。特朗普表示目前与德黑兰没有任何对话。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260819-%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E6%B5%B7%E6%B9%BE%E5%9B%BD%E5%AE%B6%E4%B8%8D%E5%BE%97%E5%90%91%E7%BE%8E%E5%86%9B%E6%8F%90%E4%BE%9B%E4%BB%BB%E4%BD%95%E5%B8%AE%E5%8A%A9-%E9%98%BF%E8%81%94%E9%85%8B%E6%9A%82%E5%81%9C%E4%B8%8E%E4%BC%8A%E6%9C%97%E5%BE%80%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787147567000.webp","sourceId":"rfi"},{"id":1787143701000,"createdDate":"2026-08-19 12:48","name":"法国国际广播电台","title":"厄瓜多尔总统访华签署多项协议 习近平支持拉美展现独立性","content":"法新社说，中国国家主席习近平周二在北京人大会堂与厄瓜多尔总统丹尼尔·诺沃亚举行会谈时，强调拉美国家有权维护自己的“独立”，特别是在选择合作伙伴方面。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260819-%E5%8E%84%E7%93%9C%E5%A4%9A%E5%B0%94%E6%80%BB%E7%BB%9F%E8%AE%BF%E5%8D%8E%E7%AD%BE%E7%BD%B2%E5%A4%9A%E9%A1%B9%E5%8D%8F%E8%AE%AE-%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%94%AF%E6%8C%81%E6%8B%89%E7%BE%8E%E5%B1%95%E7%8E%B0%E7%8B%AC%E7%AB%8B%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787143701000.webp","sourceId":"rfi"},{"id":1787141278000,"createdDate":"2026-08-19 12:07","name":"法国国际广播电台","title":"中非共和国一座金矿坍塌 或上百人遇难","content":"法新社周三从当地消息人士获悉，周二，在中非共和国西部与喀麦隆接壤的一处“手工开采”的金矿发生山体滑坡，造成数十人甚至上百人死亡。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260819-%E4%B8%AD%E9%9D%9E%E5%85%B1%E5%92%8C%E5%9B%BD%E4%B8%80%E5%BA%A7%E9%87%91%E7%9F%BF%E5%9D%8D%E5%A1%8C-%E6%88%96%E4%B8%8A%E7%99%BE%E4%BA%BA%E9%81%87%E9%9A%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787141278000.webp","sourceId":"rfi"},{"id":1787133517000,"createdDate":"2026-08-19 09:58","name":"法国国际广播电台","title":"人工智能竞赛升级 中国放宽对英伟达 H200 芯片的限制","content":"据《金融时报》周二（8月18号）援引两位知情人士的消息报道，英伟达旗下最强大的AI芯片之一——H200芯片，已获准以小批量形式进入中国大陆市场。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260819-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%AB%9E%E8%B5%9B%E5%8D%87%E7%BA%A7-%E4%B8%AD%E5%9B%BD%E6%94%BE%E5%AE%BD%E5%AF%B9%E8%8B%B1%E4%BC%9F%E8%BE%BE-h200-%E8%8A%AF%E7%89%87%E7%9A%84%E9%99%90%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787133517000.webp","sourceId":"rfi"},{"id":1787133359000,"createdDate":"2026-08-19 09:55","name":"法国国际广播电台","title":"特朗普延长对加拿大加关税期限  重提美加输油管项目","content":"美国原定于8月19日凌晨生效的对加拿大高额惩罚性关税，在最后关头迎来转机。美国总统特朗普在社群平台上宣布，美加两国在原则上已达成贸易协议，因此决定将原定对加拿大输美商品征收的50%关税实施时间暂缓3天，以便双方团队敲定最终法律文本。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260819-%E7%89%B9%E6%9C%97%E6%99%AE%E5%BB%B6%E9%95%BF%E5%AF%B9%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8A%A0%E5%85%B3%E7%A8%8E%E6%9C%9F%E9%99%90-%E9%87%8D%E6%8F%90%E7%BE%8E%E5%8A%A0%E8%BE%93%E6%B2%B9%E7%AE%A1%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787133359000.webp","sourceId":"rfi"},{"id":1787131200000,"createdDate":"2026-08-19 09:20","name":"法国国际广播电台","title":"刚果民主共和国埃博拉病例数超过5,000例","content":"刚果民主共和国埃博拉疫情持续恶化，据路透社报道，累计确诊病例突破5,000宗，达到5,021宗。死亡人数增至2,378人，成为当地历来最严重、全球第二严重的埃博拉疫情，仅次于2014年至2016年的西非疫情。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20260819-%E5%88%9A%E6%9E%9C%E6%B0%91%E4%B8%BB%E5%85%B1%E5%92%8C%E5%9B%BD%E5%9F%83%E5%8D%9A%E6%8B%89%E7%97%85%E4%BE%8B%E6%95%B0%E8%B6%85%E8%BF%875-000%E4%BE%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787131200000.webp","sourceId":"rfi"},{"id":1787130286000,"createdDate":"2026-08-19 09:04","name":"法国国际广播电台","title":"世间已无朱鎔基 论者称中国需要制约「权力」持续改革的制度","content":"中国前总理朱鎔基的遗体昨(18日)早按「正国级」领导人规格在北京八宝山革命公墓火化後，官媒随即发表其生平，赞扬他建立起社会主义市场经济体制基本框架，成功令中国加入世界贸易组织，对推进现代化建设产生深刻影响。不过，中国独立政治学者陈道银指朱鎔基只是强化了国家能力，却没有建立与之匹配的人民权利和权力约束机制，以致中国未能迈向政治现代化；而一名资深传媒人亦指出，朱只是把中国体制带来的问题推迟了二丶三十年，中国是否还有未来，端视她能否走出对「能臣政治」的依赖，建立制度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260819-%E4%B8%96%E9%97%B4%E5%B7%B2%E6%97%A0%E6%9C%B1%E9%8E%94%E5%9F%BA-%E8%AE%BA%E8%80%85%E7%A7%B0%E4%B8%AD%E5%9B%BD%E9%9C%80%E8%A6%81%E5%88%B6%E7%BA%A6-%E6%9D%83%E5%8A%9B-%E6%8C%81%E7%BB%AD%E6%94%B9%E9%9D%A9%E7%9A%84%E5%88%B6%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787130286000.webp","sourceId":"rfi"},{"id":1787128954000,"createdDate":"2026-08-19 08:42","name":"法国国际广播电台","title":"美韩军演在特朗普压力下宣布提前结束 特朗普称金正恩回应了","content":"首尔和华盛顿于周一启动的联合军事演习，在唐纳德·特朗普对此提出强烈批评后，于周三宣布将提前六天结束；不过，五角大楼保证仍将确保实现美军的军事“目标”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260819-%E7%BE%8E%E9%9F%A9%E5%86%9B%E6%BC%94%E5%9C%A8%E7%89%B9%E6%9C%97%E6%99%AE%E5%8E%8B%E5%8A%9B%E4%B8%8B%E5%AE%A3%E5%B8%83%E6%8F%90%E5%89%8D%E7%BB%93%E6%9D%9F-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E9%87%91%E6%AD%A3%E6%81%A9%E5%9B%9E%E5%BA%94%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787128954000.webp","sourceId":"rfi"},{"id":1787127737000,"createdDate":"2026-08-19 08:22","name":"法国国际广播电台","title":"高市政权支持率达政权开始以来最低","content":"最近日本一些媒体的舆论调查显示，高市早苗内阁的支持率达政权开始以来最低水平。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260819-%E9%AB%98%E5%B8%82%E6%94%BF%E6%9D%83%E6%94%AF%E6%8C%81%E7%8E%87%E8%BE%BE%E6%94%BF%E6%9D%83%E5%BC%80%E5%A7%8B%E4%BB%A5%E6%9D%A5%E6%9C%80%E4%BD%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787127737000.webp","sourceId":"rfi"},{"id":1787127534000,"createdDate":"2026-08-19 08:18","name":"法国国际广播电台","title":"澳门五年规划 减博彩业增加值比重 加强与香港合作","content":"有东方蒙地卡罗之称的澳门，今後五年将在经济上要适度多元发展，手段之一是削减博彩业在经济增长中的比重逾三个百分点，力争2030年实现非博彩业增加值占本地生产总值比重达到60%左右。另外就是加强与香港合作，包括与中国内地及香港协作防范重点领域风险，推动粤港澳反洗钱与打击金融犯罪，以及加强情报交流。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260819-%E6%BE%B3%E9%97%A8%E4%BA%94%E5%B9%B4%E8%A7%84%E5%88%92-%E5%87%8F%E5%8D%9A%E5%BD%A9%E4%B8%9A%E5%A2%9E%E5%8A%A0%E5%80%BC%E6%AF%94%E9%87%8D-%E5%8A%A0%E5%BC%BA%E4%B8%8E%E9%A6%99%E6%B8%AF%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/08/19/1787127534000.webp","sourceId":"rfi"}]