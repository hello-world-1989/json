[{"id":1792069273000,"createdDate":"2026-10-15 13:01","name":"法国国际广播电台","title":"马斯克将“星盾”延迟基辅军事行动归因特朗普 泽连斯基吁美国勿站侵略者一边","content":"法新社华盛顿消息：周四，埃隆·马斯克再次呼吁换掉乌克兰总统泽连斯基之前不久，坚称其在乌克兰的卫星服务出现任何延迟都是由于拥有星盾控制权的美军，也就是由于总统特朗普。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261015-%E9%A9%AC%E6%96%AF%E5%85%8B%E5%B0%86-%E6%98%9F%E7%9B%BE-%E5%BB%B6%E8%BF%9F%E5%9F%BA%E8%BE%85%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8%E5%BD%92%E5%9B%A0%E7%89%B9%E6%9C%97%E6%99%AE-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%90%81%E7%BE%8E%E5%9B%BD%E5%8B%BF%E7%AB%99%E4%BE%B5%E7%95%A5%E8%80%85%E4%B8%80%E8%BE%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792069273000.webp","sourceId":"rfi"},{"id":1792067368000,"createdDate":"2026-10-15 12:29","name":"法国国际广播电台","title":"刚果(金)总统亲属欧洲住宅被搜","content":"非洲国家刚果民主共和国（RDCONGO）现任总统的众多直系亲属在欧洲布鲁塞尔（Bruxelles）及其周边地区的住宅于昨天2026年10月14日星期三遭搜查。这是本台法广非洲组（RFIAfrique）的最新法文消息之一。比利时联邦检察院（Leparquetfédéralbelge）就此在一份新闻公报（communiqué）中提到一桩涉嫌洗钱的指控。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261015-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E9%87%91-%E6%80%BB%E7%BB%9F%E4%BA%B2%E5%B1%9E%E6%AC%A7%E6%B4%B2%E4%BD%8F%E5%AE%85%E8%A2%AB%E6%90%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792067368000.webp","sourceId":"rfi"},{"id":1792066170000,"createdDate":"2026-10-15 12:09","name":"法国国际广播电台","title":"出口激增、贸易顺差将再破纪录：中国式碾压令欧美不快","content":"10月15号法国各大报头版关注焦点各异。有多篇与中国相关的议题从多个角度报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261015-%E5%87%BA%E5%8F%A3%E6%BF%80%E5%A2%9E-%E8%B4%B8%E6%98%93%E9%A1%BA%E5%B7%AE%E5%B0%86%E5%86%8D%E7%A0%B4%E7%BA%AA%E5%BD%95-%E4%B8%AD%E5%9B%BD%E5%BC%8F%E7%A2%BE%E5%8E%8B%E4%BB%A4%E6%AC%A7%E7%BE%8E%E4%B8%8D%E5%BF%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792066170000.webp","sourceId":"rfi"},{"id":1792062842000,"createdDate":"2026-10-15 11:14","name":"法国国际广播电台","title":"特朗普言论再次刺激加拿大 两国贸易谈判短期重启无望","content":"美国总统特朗普在亚利桑那州竞选集会上再次公开表示，加拿大“最终会成为美国第51个州，因为这是唯一可行的出路”。他重申美国“不需要他们，但他们需要我们”。这些言论，进一步激起加拿大人强烈反应，对本已陷于停顿的美加贸易谈判可谓雪上加霜。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261015-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A8%80%E8%AE%BA%E5%86%8D%E6%AC%A1%E5%88%BA%E6%BF%80%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E4%B8%A4%E5%9B%BD%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E7%9F%AD%E6%9C%9F%E9%87%8D%E5%90%AF%E6%97%A0%E6%9C%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792062842000.webp","sourceId":"rfi"},{"id":1792055503000,"createdDate":"2026-10-15 09:11","name":"法国国际广播电台","title":"受人工智能技术需求驱动，台积电今年第三季度净利润再创历史新高","content":"全球先进芯片制造龙头企业台积电15日宣布，受全球人工智能技术对高阶芯片的强劲需求带动，今年第三季度，该集团归属母公司的净利润增长再创历史新高，达到7630.6亿元新台币，大约相当于210亿欧元，同比上涨达69%，高于伦敦证券交易所集团此前收集到的专家预估。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E5%8F%97%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%8A%80%E6%9C%AF%E9%9C%80%E6%B1%82%E9%A9%B1%E5%8A%A8%EF%BC%8C%E5%8F%B0%E7%A7%AF%E7%94%B5%E4%BB%8A%E5%B9%B4%E7%AC%AC%E4%B8%89%E5%AD%A3%E5%BA%A6%E5%87%80%E5%88%A9%E6%B6%A6%E5%86%8D%E5%88%9B%E5%8E%86%E5%8F%B2%E6%96%B0%E9%AB%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792055503000.webp","sourceId":"rfi"},{"id":1792054361000,"createdDate":"2026-10-15 08:52","name":"法国国际广播电台","title":"未来经济2026: 中美科技博弈重塑全球","content":"在当今地缘政治冲突加剧与技术革命交织的背景下，人工智能（AI）和大数据正在成为大国博弈的核心战场。世界银行未来经济论坛专家警告称，中美两国在人工智能和数据领域的激烈竞争正在影响全球经济的发展命运。有人担忧，人工智能和大数据可能沦为地缘政治博弈的工具。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261015-%E6%9C%AA%E6%9D%A5%E7%BB%8F%E6%B5%8E2026-%E4%B8%AD%E7%BE%8E%E7%A7%91%E6%8A%80%E5%8D%9A%E5%BC%88%E9%87%8D%E5%A1%91%E5%85%A8%E7%90%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792054361000.webp","sourceId":"rfi"},{"id":1792053570000,"createdDate":"2026-10-15 08:39","name":"法国国际广播电台","title":"专利巴士申请加票价近两成 官员议员竟帮口 评论指是没抗衡力量的新香港宿命","content":"香港四家专利巴士公司申请大幅加价，加幅由17.7%至8.1%不等，加幅之大，引起市民叫苦已是必然，但相关政策局在向立法会提交的文件则更多是为巴士公司解释，由爱国者垄断的立法会，其议员亦没有代市民叫屈，被报章社评形容官员和议员都是在「为加价保驾护航」；更有评论形容议员是，巴士公司的「另类发言人」，预料小市民继续默默承受这种在没有民间社会抗衡力量下的「宿命」。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E4%B8%93%E5%88%A9%E5%B7%B4%E5%A3%AB%E7%94%B3%E8%AF%B7%E5%8A%A0%E7%A5%A8%E4%BB%B7%E8%BF%91%E4%B8%A4%E6%88%90-%E5%AE%98%E5%91%98%E8%AE%AE%E5%91%98%E7%AB%9F%E5%B8%AE%E5%8F%A3-%E8%AF%84%E8%AE%BA%E6%8C%87%E6%98%AF%E6%B2%A1%E6%8A%97%E8%A1%A1%E5%8A%9B%E9%87%8F%E7%9A%84%E6%96%B0%E9%A6%99%E6%B8%AF%E5%AE%BF%E5%91%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792053570000.webp","sourceId":"rfi"},{"id":1792053360000,"createdDate":"2026-10-15 08:36","name":"法国国际广播电台","title":"利用港媒爆料中国企图干扰台湾选举 恐加深台湾社会对立与两极化","content":"台湾学者叶耀元分析，中国透过香港媒体操作相关讯息，试图介入台湾选举，这类认知作战未必能改变选民立场，却可能加深台湾社会对立与两极化，对民主发展造成不良影响。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E5%88%A9%E7%94%A8%E6%B8%AF%E5%AA%92%E7%88%86%E6%96%99%E4%B8%AD%E5%9B%BD%E4%BC%81%E5%9B%BE%E5%B9%B2%E6%89%B0%E5%8F%B0%E6%B9%BE%E9%80%89%E4%B8%BE-%E6%81%90%E5%8A%A0%E6%B7%B1%E5%8F%B0%E6%B9%BE%E7%A4%BE%E4%BC%9A%E5%AF%B9%E7%AB%8B%E4%B8%8E%E4%B8%A4%E6%9E%81%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792053360000.webp","sourceId":"rfi"},{"id":1792052301000,"createdDate":"2026-10-15 08:18","name":"法国国际广播电台","title":"围绕黑龙江代表团访俄及拘捕日本记者  日向俄提出交涉和强烈抗议","content":"10月14日，日本外务省欧洲局局长中村仁威召见俄罗斯驻日大使尼古拉·诺兹德廖夫，就俄罗斯联邦安全局（FSB）宣布在萨哈林州拘留一名日本公民，并单方面对外发布相关消息表示强烈抗议，同时对中国黑龙江省有关人员等访问择捉岛一事，向俄方提出交涉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261015-%E5%9B%B4%E7%BB%95%E9%BB%91%E9%BE%99%E6%B1%9F%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E4%BF%84%E5%8F%8A%E6%8B%98%E6%8D%95%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85-%E6%97%A5%E5%90%91%E4%BF%84%E6%8F%90%E5%87%BA%E4%BA%A4%E6%B6%89%E5%92%8C%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792052301000.webp","sourceId":"rfi"},{"id":1792052193000,"createdDate":"2026-10-15 08:16","name":"法国国际广播电台","title":"朝鲜进行两种潜射巡航弹道导弹试射","content":"朝鲜官媒周四（10月15日）报道，朝鲜进行了两种从潜艇发射的战略巡航导弹试射，以检验其水下作战系统的战备状态。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261015-%E6%9C%9D%E9%B2%9C%E8%BF%9B%E8%A1%8C%E4%B8%A4%E7%A7%8D%E6%BD%9C%E5%B0%84%E5%B7%A1%E8%88%AA%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792052193000.webp","sourceId":"rfi"},{"id":1792093050000,"createdDate":"2026-10-15 19:37","name":"法国国际广播电台","title":"刚果(金)第17轮埃博拉疫区移动","content":"在非洲国家刚果民主共和国（RDCongo）东北部的伊图里省（Ituri），由本迪布焦病毒（EbolaBundibugyo）引发的第17轮埃博拉疫情，在五个月内造成超过4,000人病亡，成为刚果（金）历史上死亡人数最多的一次埃博拉疫情。法国国际广播电台（RFI）法语节目于2026年10月15日（星期四）全天推出相关专题报道。在布尼亚（Bunia）的本台法广非洲组（RFIAfrique）特派记者Paulina进行了一系列的实地采访，发回了来自疫区一线的最新情况。此外，刚果（金）卫生部长康巴SamuelRogerKamba在接受法国国际广播电台《非洲大咖嘉宾》（RFI–LEGRANDINVITÉAFRIQUE）栏目记者ChristopheBoisbouvier专访时表示，本轮埃博拉疫情的核心疫区正向北基伍省（Nord-Kivu）转移。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261015-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E9%87%91-%E7%AC%AC17%E8%BD%AE%E5%9F%83%E5%8D%9A%E6%8B%89%E7%96%AB%E5%8C%BA%E7%A7%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792093050000.webp","sourceId":"rfi"},{"id":1792086462000,"createdDate":"2026-10-15 17:47","name":"法国国际广播电台","title":"巴基斯坦学校屋顶坍塌32学童和一名女教师遇难 社区居民要求彻查劣质建材","content":"周四，巴基斯坦北部白沙瓦一所学校的屋顶坍塌，造成32名儿童和一名女教师遇难。事发后，救援人员和遇难者家属赶往现场，试图营救遇难者。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261015-%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E5%AD%A6%E6%A0%A1%E5%B1%8B%E9%A1%B6%E5%9D%8D%E5%A1%8C32%E5%AD%A6%E7%AB%A5%E5%92%8C%E4%B8%80%E5%90%8D%E5%A5%B3%E6%95%99%E5%B8%88%E9%81%87%E9%9A%BE-%E7%A4%BE%E5%8C%BA%E5%B1%85%E6%B0%91%E8%A6%81%E6%B1%82%E5%BD%BB%E6%9F%A5%E5%8A%A3%E8%B4%A8%E5%BB%BA%E6%9D%90","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792086462000.webp","sourceId":"rfi"},{"id":1792084615000,"createdDate":"2026-10-15 17:16","name":"法国国际广播电台","title":"美国警告斐济有中国黑客入侵 新西兰协助该群岛改革情报部门","content":"斐济政府周三宣布，将与新西兰情报部门建立合作关系，对其本国相关机构进行重新评估；此前，美国曾披露斐济境内发生了一起与中国有关联的黑客事件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261015-%E7%BE%8E%E5%9B%BD%E8%AD%A6%E5%91%8A%E6%96%90%E6%B5%8E%E6%9C%89%E4%B8%AD%E5%9B%BD%E9%BB%91%E5%AE%A2%E5%85%A5%E4%BE%B5-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%8D%8F%E5%8A%A9%E8%AF%A5%E7%BE%A4%E5%B2%9B%E6%94%B9%E9%9D%A9%E6%83%85%E6%8A%A5%E9%83%A8%E9%97%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792084615000.webp","sourceId":"rfi"},{"id":1792081121000,"createdDate":"2026-10-15 16:18","name":"法国国际广播电台","title":"受混合动力汽车协议鼓舞，欧洲各国就对华采取更强硬立场达成共识","content":"南华早报消息，在成功说服中国接受一项将其对欧州混动汽车出口限制在每年35万辆的协议后，布鲁塞尔深受鼓舞，如今正发动引擎，准备在一系列单边行动上提速。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261015-%E5%8F%97%E6%B7%B7%E5%90%88%E5%8A%A8%E5%8A%9B%E6%B1%BD%E8%BD%A6%E5%8D%8F%E8%AE%AE%E9%BC%93%E8%88%9E%EF%BC%8C%E6%AC%A7%E6%B4%B2%E5%90%84%E5%9B%BD%E5%B0%B1%E5%AF%B9%E5%8D%8E%E9%87%87%E5%8F%96%E6%9B%B4%E5%BC%BA%E7%A1%AC%E7%AB%8B%E5%9C%BA%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792081121000.webp","sourceId":"rfi"},{"id":1792078602000,"createdDate":"2026-10-15 15:36","name":"法国国际广播电台","title":"韩国专家 : 新鸭绿江大桥的开通让朝鲜更依靠中国","content":"中朝新鸭绿江大桥在2014年竣工，十多年后的本周四10月15日正式开通，韩国统一研究院（KINU）朝鲜研究室主任郑恩利（JoungEun-lee）认为这座新大桥的开通会让朝鲜更加依靠中国，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261015-%E9%9F%A9%E5%9B%BD%E4%B8%93%E5%AE%B6-%E6%96%B0%E9%B8%AD%E7%BB%BF%E6%B1%9F%E5%A4%A7%E6%A1%A5%E7%9A%84%E5%BC%80%E9%80%9A%E8%AE%A9%E6%9C%9D%E9%B2%9C%E6%9B%B4%E4%BE%9D%E9%9D%A0%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792078602000.webp","sourceId":"rfi"},{"id":1792077534000,"createdDate":"2026-10-15 15:18","name":"法国国际广播电台","title":"朝鲜与中国新桥通车李强致辞  丹东市民想去对岸逛逛","content":"法新社记者观察到，周四，卡车开始在连接中国与朝鲜的一座新桥上通行，这座新桥的投入使用，进一步加强了这个世界上最封闭的国家之一与其强大邻国之间的联系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261015-%E6%B3%95%E6%96%B0%E7%A4%BE-%E5%9C%A8%E4%B8%8E%E4%B8%96%E9%9A%94%E7%BB%9D%E7%9A%84%E6%9C%9D%E9%B2%9C%E4%B8%8E%E5%BC%BA%E5%A4%A7%E9%82%BB%E5%9B%BD%E4%B8%AD%E5%9B%BD%E4%B9%8B%E9%97%B4%E4%B8%80%E5%BA%A7%E6%96%B0%E6%A1%A5%E9%80%9A%E8%BD%A6%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792077534000.webp","sourceId":"rfi"},{"id":1792072447000,"createdDate":"2026-10-15 13:54","name":"法国国际广播电台","title":"欧理会峰会登场 聚集预算、能源、援乌及对中贸易","content":"为期两天的欧洲理事会峰会周四（10月15日）在布鲁塞尔开幕，27个成员国领导人将围绕欧盟下一轮长期预算、能源价格、移民以及对乌克兰支持等主要议题展开讨论。此外，检视欧中贸易谈判初步结果，以及如何在此基础上推动后续对话与落实，也是外界关注焦点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261015-%E6%AC%A7%E7%90%86%E4%BC%9A%E5%B3%B0%E4%BC%9A%E7%99%BB%E5%9C%BA-%E8%81%9A%E9%9B%86%E9%A2%84%E7%AE%97-%E8%83%BD%E6%BA%90-%E6%8F%B4%E4%B9%8C%E5%8F%8A%E5%AF%B9%E4%B8%AD%E8%B4%B8%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792072447000.webp","sourceId":"rfi"},{"id":1792072302000,"createdDate":"2026-10-15 13:51","name":"法国国际广播电台","title":"视频 : IMF呼吁中国增加支出 美国增加储蓄 欧洲增加投资","content":"国际货币基金组织(FMI/IMF)与世界银行从10月12日至18日在曼谷举行2026年秋季年会，国际货币基金组织总裁克里斯塔利娜·格奥尔基耶娃表示：“中国需要增加支出，美国需要增加储蓄，欧洲增加投资 “，请看视频报道 。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261015-%E8%A7%86%E9%A2%91-imf%E5%91%BC%E5%90%81%E4%B8%AD%E5%9B%BD%E5%A2%9E%E5%8A%A0%E6%94%AF%E5%87%BA-%E7%BE%8E%E5%9B%BD%E5%A2%9E%E5%8A%A0%E5%82%A8%E8%93%84-%E6%AC%A7%E6%B4%B2%E5%A2%9E%E5%8A%A0%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792072302000.webp","sourceId":"rfi"},{"id":1792071732000,"createdDate":"2026-10-15 13:42","name":"法国国际广播电台","title":"刚果金 : 受中资公司污染民众谴责当局不作为","content":"法新社发自刚果金著名的矿业城市科卢韦齐的快讯介绍了一家名叫穆索诺伊公司（简称COMMUSSAS）的中资矿业公司如何迅速扩大，威胁当地居民的家园，正在抹去城市与矿场之间的分界线，而与此同时，当地的手工采矿者的作业空间越来越狭窄，当他们进入私人矿区采矿时，经常会遭到保安人员的开枪射击，有手工采矿者向记者表示，他的多名朋友因此而失去了生命。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261015-%E5%88%9A%E6%9E%9C%E9%87%91-%E5%8F%97%E4%B8%AD%E8%B5%84%E5%85%AC%E5%8F%B8%E6%B1%A1%E6%9F%93%E6%B0%91%E4%BC%97%E8%B0%B4%E8%B4%A3%E5%BD%93%E5%B1%80%E6%9C%89%E7%BD%AA%E4%B8%8D%E7%BD%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792071732000.webp","sourceId":"rfi"},{"id":1792071594000,"createdDate":"2026-10-15 13:39","name":"法国国际广播电台","title":"捷克一名中国公民涉嫌间谍案首次开庭 当事人否认指控","content":"据捷克媒体塞茲納姆（seznamzpravy）网14日消息：周三，中国公民杨艺明（音译）在布拉格市法院通过其辩护律师，对指控其为中国情报机构从事间谍活动的起诉书予以否认。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261015-%E6%8D%B7%E5%85%8B%E4%B8%80%E5%90%8D%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E6%B6%89%E5%AB%8C%E9%97%B4%E8%B0%8D%E6%A1%88%E9%A6%96%E6%AC%A1%E5%BC%80%E5%BA%AD-%E5%BD%93%E4%BA%8B%E4%BA%BA%E5%90%A6%E8%AE%A4%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792071594000.webp","sourceId":"rfi"}]