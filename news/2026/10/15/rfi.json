[{"id":1792069273000,"createdDate":"2026-10-15 13:01","name":"法国国际广播电台","title":"马斯克将“星盾”延迟基辅军事行动归因特朗普 泽连斯基吁美国勿站侵略者一边","content":"法新社华盛顿消息：周四，埃隆·马斯克再次呼吁换掉乌克兰总统泽连斯基之前不久，坚称其在乌克兰的卫星服务出现任何延迟都是由于拥有星盾控制权的美军，也就是由于总统特朗普。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261015-%E9%A9%AC%E6%96%AF%E5%85%8B%E5%B0%86-%E6%98%9F%E7%9B%BE-%E5%BB%B6%E8%BF%9F%E5%9F%BA%E8%BE%85%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8%E5%BD%92%E5%9B%A0%E7%89%B9%E6%9C%97%E6%99%AE-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%90%81%E7%BE%8E%E5%9B%BD%E5%8B%BF%E7%AB%99%E4%BE%B5%E7%95%A5%E8%80%85%E4%B8%80%E8%BE%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792069273000.webp","sourceId":"rfi"},{"id":1792067368000,"createdDate":"2026-10-15 12:29","name":"法国国际广播电台","title":"刚果(金)总统亲属欧洲住宅被搜","content":"非洲国家刚果民主共和国（RDCONGO）现任总统的众多直系亲属在欧洲布鲁塞尔（Bruxelles）及其周边地区的住宅于昨天2026年10月14日星期三遭搜查。这是本台法广非洲组（RFIAfrique）的最新法文消息之一。比利时联邦检察院（Leparquetfédéralbelge）就此在一份新闻公报（communiqué）中提到一桩涉嫌洗钱的指控。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261015-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E9%87%91-%E6%80%BB%E7%BB%9F%E4%BA%B2%E5%B1%9E%E6%AC%A7%E6%B4%B2%E4%BD%8F%E5%AE%85%E8%A2%AB%E6%90%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792067368000.webp","sourceId":"rfi"},{"id":1792066170000,"createdDate":"2026-10-15 12:09","name":"法国国际广播电台","title":"出口激增、贸易顺差将再破纪录：中国式碾压令欧美不快","content":"10月15号法国各大报头版关注焦点各异。有多篇与中国相关的议题从多个角度报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261015-%E5%87%BA%E5%8F%A3%E6%BF%80%E5%A2%9E-%E8%B4%B8%E6%98%93%E9%A1%BA%E5%B7%AE%E5%B0%86%E5%86%8D%E7%A0%B4%E7%BA%AA%E5%BD%95-%E4%B8%AD%E5%9B%BD%E5%BC%8F%E7%A2%BE%E5%8E%8B%E4%BB%A4%E6%AC%A7%E7%BE%8E%E4%B8%8D%E5%BF%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792066170000.webp","sourceId":"rfi"},{"id":1792062842000,"createdDate":"2026-10-15 11:14","name":"法国国际广播电台","title":"特朗普言论再次刺激加拿大 两国贸易谈判短期重启无望","content":"美国总统特朗普在亚利桑那州竞选集会上再次公开表示，加拿大“最终会成为美国第51个州，因为这是唯一可行的出路”。他重申美国“不需要他们，但他们需要我们”。这些言论，进一步激起加拿大人强烈反应，对本已陷于停顿的美加贸易谈判可谓雪上加霜。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261015-%E7%89%B9%E6%9C%97%E6%99%AE%E8%A8%80%E8%AE%BA%E5%86%8D%E6%AC%A1%E5%88%BA%E6%BF%80%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E4%B8%A4%E5%9B%BD%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E7%9F%AD%E6%9C%9F%E9%87%8D%E5%90%AF%E6%97%A0%E6%9C%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792062842000.webp","sourceId":"rfi"},{"id":1792055503000,"createdDate":"2026-10-15 09:11","name":"法国国际广播电台","title":"受人工智能技术需求驱动，台积电今年第三季度净利润再创历史新高","content":"全球先进芯片制造龙头企业台积电15日宣布，受全球人工智能技术对高阶芯片的强劲需求带动，今年第三季度，该集团归属母公司的净利润增长再创历史新高，达到7630.6亿元新台币，大约相当于210亿欧元，同比上涨达69%，高于伦敦证券交易所集团此前收集到的专家预估。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E5%8F%97%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%8A%80%E6%9C%AF%E9%9C%80%E6%B1%82%E9%A9%B1%E5%8A%A8%EF%BC%8C%E5%8F%B0%E7%A7%AF%E7%94%B5%E4%BB%8A%E5%B9%B4%E7%AC%AC%E4%B8%89%E5%AD%A3%E5%BA%A6%E5%87%80%E5%88%A9%E6%B6%A6%E5%86%8D%E5%88%9B%E5%8E%86%E5%8F%B2%E6%96%B0%E9%AB%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792055503000.webp","sourceId":"rfi"},{"id":1792054361000,"createdDate":"2026-10-15 08:52","name":"法国国际广播电台","title":"未来经济2026: 中美科技博弈重塑全球","content":"在当今地缘政治冲突加剧与技术革命交织的背景下，人工智能（AI）和大数据正在成为大国博弈的核心战场。世界银行未来经济论坛专家警告称，中美两国在人工智能和数据领域的激烈竞争正在影响全球经济的发展命运。有人担忧，人工智能和大数据可能沦为地缘政治博弈的工具。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261015-%E6%9C%AA%E6%9D%A5%E7%BB%8F%E6%B5%8E2026-%E4%B8%AD%E7%BE%8E%E7%A7%91%E6%8A%80%E5%8D%9A%E5%BC%88%E9%87%8D%E5%A1%91%E5%85%A8%E7%90%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792054361000.webp","sourceId":"rfi"},{"id":1792053570000,"createdDate":"2026-10-15 08:39","name":"法国国际广播电台","title":"专利巴士申请加票价近两成 官员议员竟帮口 评论指是没抗衡力量的新香港宿命","content":"香港四家专利巴士公司申请大幅加价，加幅由17.7%至8.1%不等，加幅之大，引起市民叫苦已是必然，但相关政策局在向立法会提交的文件则更多是为巴士公司解释，由爱国者垄断的立法会，其议员亦没有代市民叫屈，被报章社评形容官员和议员都是在「为加价保驾护航」；更有评论形容议员是，巴士公司的「另类发言人」，预料小市民继续默默承受这种在没有民间社会抗衡力量下的「宿命」。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E4%B8%93%E5%88%A9%E5%B7%B4%E5%A3%AB%E7%94%B3%E8%AF%B7%E5%8A%A0%E7%A5%A8%E4%BB%B7%E8%BF%91%E4%B8%A4%E6%88%90-%E5%AE%98%E5%91%98%E8%AE%AE%E5%91%98%E7%AB%9F%E5%B8%AE%E5%8F%A3-%E8%AF%84%E8%AE%BA%E6%8C%87%E6%98%AF%E6%B2%A1%E6%8A%97%E8%A1%A1%E5%8A%9B%E9%87%8F%E7%9A%84%E6%96%B0%E9%A6%99%E6%B8%AF%E5%AE%BF%E5%91%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792053570000.webp","sourceId":"rfi"},{"id":1792053360000,"createdDate":"2026-10-15 08:36","name":"法国国际广播电台","title":"利用港媒爆料中国企图干扰台湾选举 恐加深台湾社会对立与两极化","content":"台湾学者叶耀元分析，中国透过香港媒体操作相关讯息，试图介入台湾选举，这类认知作战未必能改变选民立场，却可能加深台湾社会对立与两极化，对民主发展造成不良影响。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261015-%E5%88%A9%E7%94%A8%E6%B8%AF%E5%AA%92%E7%88%86%E6%96%99%E4%B8%AD%E5%9B%BD%E4%BC%81%E5%9B%BE%E5%B9%B2%E6%89%B0%E5%8F%B0%E6%B9%BE%E9%80%89%E4%B8%BE-%E6%81%90%E5%8A%A0%E6%B7%B1%E5%8F%B0%E6%B9%BE%E7%A4%BE%E4%BC%9A%E5%AF%B9%E7%AB%8B%E4%B8%8E%E4%B8%A4%E6%9E%81%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792053360000.webp","sourceId":"rfi"},{"id":1792052301000,"createdDate":"2026-10-15 08:18","name":"法国国际广播电台","title":"围绕黑龙江代表团访俄及拘捕日本记者  日向俄提出交涉和强烈抗议","content":"10月14日，日本外务省欧洲局局长中村仁威召见俄罗斯驻日大使尼古拉·诺兹德廖夫，就俄罗斯联邦安全局（FSB）宣布在萨哈林州拘留一名日本公民，并单方面对外发布相关消息表示强烈抗议，同时对中国黑龙江省有关人员等访问择捉岛一事，向俄方提出交涉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261015-%E5%9B%B4%E7%BB%95%E9%BB%91%E9%BE%99%E6%B1%9F%E4%BB%A3%E8%A1%A8%E5%9B%A2%E8%AE%BF%E4%BF%84%E5%8F%8A%E6%8B%98%E6%8D%95%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85-%E6%97%A5%E5%90%91%E4%BF%84%E6%8F%90%E5%87%BA%E4%BA%A4%E6%B6%89%E5%92%8C%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792052301000.webp","sourceId":"rfi"},{"id":1792052193000,"createdDate":"2026-10-15 08:16","name":"法国国际广播电台","title":"朝鲜进行两种潜射巡航弹道导弹试射","content":"朝鲜官媒周四（10月15日）报道，朝鲜进行了两种从潜艇发射的战略巡航导弹试射，以检验其水下作战系统的战备状态。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261015-%E6%9C%9D%E9%B2%9C%E8%BF%9B%E8%A1%8C%E4%B8%A4%E7%A7%8D%E6%BD%9C%E5%B0%84%E5%B7%A1%E8%88%AA%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/15/1792052193000.webp","sourceId":"rfi"}]