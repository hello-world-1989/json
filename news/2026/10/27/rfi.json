[{"id":1793078904000,"createdDate":"2026-10-27 05:28","name":"法国国际广播电台","title":"乌克兰战争：基辅为何想断开与星链的连接？星链对乌克兰军队已不可或缺","content":"乌克兰与俄罗斯的战争继续猛烈之际，基辅为何想要断开与美国星链系统的连接呢？因为星链对乌克兰军队来说已不可或缺。乌克兰军队对星链网络的这种依赖，战争效果却适得其反，因为在与特朗普政府发生分歧后，星链的速度限制和连接中断突然扰乱了其军事行动。当地制造商正在寻找解决方案。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261027-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E4%BA%89-%E5%9F%BA%E8%BE%85%E4%B8%BA%E4%BD%95%E6%83%B3%E6%96%AD%E5%BC%80%E4%B8%8E%E6%98%9F%E9%93%BE%E7%9A%84%E8%BF%9E%E6%8E%A5-%E6%98%9F%E9%93%BE%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0%E5%86%9B%E9%98%9F%E5%B7%B2%E4%B8%8D%E5%8F%AF%E6%88%96%E7%BC%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793078904000.webp","sourceId":"rfi"}]