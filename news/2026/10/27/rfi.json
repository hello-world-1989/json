[{"id":1793078904000,"createdDate":"2026-10-27 05:28","name":"法国国际广播电台","title":"乌克兰战争：基辅为何想断开与星链的连接？星链对乌克兰军队已不可或缺","content":"乌克兰与俄罗斯的战争继续猛烈之际，基辅为何想要断开与美国星链系统的连接呢？因为星链对乌克兰军队来说已不可或缺。乌克兰军队对星链网络的这种依赖，战争效果却适得其反，因为在与特朗普政府发生分歧后，星链的速度限制和连接中断突然扰乱了其军事行动。当地制造商正在寻找解决方案。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261027-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E4%BA%89-%E5%9F%BA%E8%BE%85%E4%B8%BA%E4%BD%95%E6%83%B3%E6%96%AD%E5%BC%80%E4%B8%8E%E6%98%9F%E9%93%BE%E7%9A%84%E8%BF%9E%E6%8E%A5-%E6%98%9F%E9%93%BE%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0%E5%86%9B%E9%98%9F%E5%B7%B2%E4%B8%8D%E5%8F%AF%E6%88%96%E7%BC%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793078904000.webp","sourceId":"rfi"},{"id":1793133088000,"createdDate":"2026-10-27 20:31","name":"法国国际广播电台","title":"美国欧盟等30国联合声明警告苏丹冲突恶化引发饥荒","content":"美国国务院发布与另外30个国家共同签署的联合声明，警告苏丹粮食安全因冲突持续不休而恶化，情况令人担忧，必须采取紧急行动应对。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261027-%E7%BE%8E%E5%9B%BD%E6%AC%A7%E7%9B%9F%E7%AD%8930%E5%9B%BD%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E%E8%AD%A6%E5%91%8A%E8%8B%8F%E4%B8%B9%E5%86%B2%E7%AA%81%E6%81%B6%E5%8C%96%E5%BC%95%E5%8F%91%E9%A5%A5%E8%8D%92","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793133088000.webp","sourceId":"rfi"},{"id":1793130955000,"createdDate":"2026-10-27 19:55","name":"法国国际广播电台","title":"美国期中选举倒数一周 民主党有望夺回国会两院","content":"美国期中选举11月3日登场，距投票日仅剩一周。最新民调及预测市场显示，民主党有望夺回众议院，并有机会翻转参议院，重新掌握国会两院。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261027-%E7%BE%8E%E5%9B%BD%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E5%80%92%E6%95%B0%E4%B8%80%E5%91%A8-%E6%B0%91%E4%B8%BB%E5%85%9A%E6%9C%89%E6%9C%9B%E5%A4%BA%E5%9B%9E%E5%9B%BD%E4%BC%9A%E4%B8%A4%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793130955000.webp","sourceId":"rfi"},{"id":1793130233000,"createdDate":"2026-10-27 19:43","name":"法国国际广播电台","title":"为俄乌停战芬兰总统与挪威首相首次与普京通话","content":"芬兰总统与挪威首相周二（10月27日）致电俄罗斯总统普京，敦促其结束乌克兰战争。这是自2022年2月俄乌全面开战以来，欧洲领导人与克里姆林宫首次进行直接接触。也是在本月20日奥斯陆磋商后的一次具体行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261027-%E4%B8%BA%E4%BF%84%E4%B9%8C%E5%81%9C%E6%88%98%E8%8A%AC%E5%85%B0%E6%80%BB%E7%BB%9F%E4%B8%8E%E6%8C%AA%E5%A8%81%E9%A6%96%E7%9B%B8%E9%A6%96%E6%AC%A1%E4%B8%8E%E6%99%AE%E4%BA%AC%E9%80%9A%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793130233000.webp","sourceId":"rfi"},{"id":1793121430000,"createdDate":"2026-10-27 17:17","name":"法国国际广播电台","title":"塞尔维亚学生要求国家媒体负责人辞职 地方媒体就长期以来的失职道歉","content":"周二，塞尔维亚的学生运动要求国家广播机构的负责人辞职，指控他们在前总统武契奇（AleksandarVucic）领导的右翼民族主义政党执政的14年间存在偏袒行为；该政党已在上周末的选举中落败。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261027-%E5%A1%9E%E5%B0%94%E7%BB%B4%E4%BA%9A%E5%AD%A6%E7%94%9F%E8%A6%81%E6%B1%82%E5%9B%BD%E5%AE%B6%E5%AA%92%E4%BD%93%E8%B4%9F%E8%B4%A3%E4%BA%BA%E8%BE%9E%E8%81%8C-%E5%9C%B0%E6%96%B9%E5%AA%92%E4%BD%93%E5%B0%B1%E9%95%BF%E6%9C%9F%E4%BB%A5%E6%9D%A5%E7%9A%84%E5%A4%B1%E8%81%8C%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793121430000.webp","sourceId":"rfi"},{"id":1793118512000,"createdDate":"2026-10-27 16:28","name":"法国国际广播电台","title":"TP-Link再遇监管阻力 美联邦通信委员会指其部分路由器功率超限","content":"据彭博社报导，美国联邦通信委员会（FCC）已告知TP-Link系统有限公司（TP-LinkSystemsInc.），其部分Wi-Fi路由器违反了功率限值规定。此举可能为针对这家总部位于加州的科技公司旗下设备实施进一步禁令埋下伏笔。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261027-tp-link%E5%86%8D%E9%81%87%E7%9B%91%E7%AE%A1%E9%98%BB%E5%8A%9B-%E7%BE%8E%E8%81%94%E9%82%A6%E9%80%9A%E4%BF%A1%E5%A7%94%E5%91%98%E4%BC%9A%E6%8C%87%E5%85%B6%E9%83%A8%E5%88%86%E8%B7%AF%E7%94%B1%E5%99%A8%E5%8A%9F%E7%8E%87%E8%B6%85%E9%99%90","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793118512000.webp","sourceId":"rfi"},{"id":1793113934000,"createdDate":"2026-10-27 15:12","name":"法国国际广播电台","title":"美国中期选举将给特朗普当头一棒？","content":"美国11月初将举行中期选举。德国媒体如何看待选举前美国总统特朗普的处境以及特朗普的乌克兰政策？德国媒体普遍认为：特朗普的反复无常和荒诞不经、不受欢迎的伊朗战争、经济和外交政策不成功等多项因素使他削弱了自己的权势。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20261027-%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%B0%86%E7%BB%99%E7%89%B9%E6%9C%97%E6%99%AE%E5%BD%93%E5%A4%B4%E4%B8%80%E6%A3%92","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793113934000.webp","sourceId":"rfi"},{"id":1793113436000,"createdDate":"2026-10-27 15:03","name":"法国国际广播电台","title":"姆巴佩、西甲道歉 中国官媒：望切实从中吸取教训、痛改前非","content":"据中国官媒央视体育周二晚消息，针对西甲皇马球员姆巴佩就涉华不当言论的公开道歉，中央广播电视总台相关人士表示，已经注意到相关信息，我们听其言更观其行，希望西甲、皇马和姆巴佩本人切实从中吸取教训，真诚道歉、痛改前非。消息指，中央广播电视总台于10月26日第一时间进行反制，叫停了西甲赛事以及涉及姆巴佩的所有比赛和其代言广告的播出。总台负责人同时致函西甲联盟主席特巴斯，要求皇马和姆巴佩本人立即公开诚恳道歉，消除不良影响，并向总台递交书面道歉信。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E5%A7%86%E5%B7%B4%E4%BD%A9-%E8%A5%BF%E7%94%B2%E9%81%93%E6%AD%89-%E4%B8%AD%E5%9B%BD%E5%AE%98%E5%AA%92-%E6%9C%9B%E5%88%87%E5%AE%9E%E4%BB%8E%E4%B8%AD%E5%90%B8%E5%8F%96%E6%95%99%E8%AE%AD-%E7%97%9B%E6%94%B9%E5%89%8D%E9%9D%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793113436000.webp","sourceId":"rfi"},{"id":1793111357000,"createdDate":"2026-10-27 14:29","name":"法国国际广播电台","title":"以色列：10·7恐袭后首次大选 关乎内塔尼亚胡政治前途之战 ？","content":"以色列将于10月27日（周二）举行议会选举，这是自2023年10月7日哈马斯恐怖袭击事件以来，也是在随后在加沙、黎巴嫩、伊朗等地爆发的地区冲突以来的首次选举。选举将在执政四年的内塔尼亚胡总理领导的阵营与声称代表变革的各政党之间展开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261027-%E4%BB%A5%E8%89%B2%E5%88%97-10%C2%B77%E6%81%90%E8%A2%AD%E5%90%8E%E9%A6%96%E6%AC%A1%E5%A4%A7%E9%80%89-%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E8%BF%9E%E4%BB%BB%E5%8F%97%E8%80%83%E9%AA%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793111357000.webp","sourceId":"rfi"},{"id":1793110382000,"createdDate":"2026-10-27 14:13","name":"法国国际广播电台","title":"国大党发言人发涉华视频印军指深度伪造 印部长要求道歉","content":"在印度陆军驳斥了反对党——国大党一位领导人所散布的虚假视频，该视频声称中国已控制了阿鲁纳恰尔邦（中方称藏南地区）的部分地区之后，印度议会事务部和少数民族事务部部长芮吉朱（KirenRijiju）对国大党进行了猛烈抨击。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261027-%E5%9B%BD%E5%A4%A7%E5%85%9A%E5%8F%91%E8%A8%80%E4%BA%BA%E5%8F%91%E6%B6%89%E5%8D%8E%E8%A7%86%E9%A2%91%E5%8D%B0%E5%86%9B%E6%8C%87%E4%B8%BA%E6%B7%B1%E5%BA%A6%E4%BC%AA%E9%80%A0-%E5%8D%B0%E9%83%A8%E9%95%BF%E6%95%A6%E4%BF%83%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793110382000.webp","sourceId":"rfi"},{"id":1793110008000,"createdDate":"2026-10-27 14:06","name":"法国国际广播电台","title":"视频 为什么美国人总是选择在星期二投票？","content":"美国人于11月3日星期二参加中期选举，与美国总统选举一样，中期选举总是在11月的星期二举行，这条规则可以追溯到19世纪，当时社会以农业为主，投票可能需要一整天的路程才可以赶到投票站。那么为什么不是星期六、星期日、星期一或星期三呢？如今在选民弃权情况高的背景下，这条规则是否受到挑战？请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261027-%E8%A7%86%E9%A2%91-%E4%B8%BA%E4%BB%80%E4%B9%88%E7%BE%8E%E5%9B%BD%E4%BA%BA%E6%80%BB%E6%98%AF%E9%80%89%E6%8B%A9%E5%9C%A8%E6%98%9F%E6%9C%9F%E4%BA%8C%E6%8A%95%E7%A5%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793110008000.webp","sourceId":"rfi"},{"id":1793103901000,"createdDate":"2026-10-27 12:25","name":"法国国际广播电台","title":"日外相指就高市出席11月APEC深圳峰会进行协调 习近平向福田康夫遗属致唁电","content":"日本外务大臣茂木敏充在周二举行的参议院外交防卫委员会会议上透露，正就首相高市早苗出席11月在中国深圳举行的亚太经合组织（APEC）领导人会议进行协调。关于高市是否会借此机会与中国国家主席习近平进行对话，茂木仅表示：“双边会谈目前正在探讨中，现阶段不便透露具体将与哪些国家举行会谈”。中方将于11月18日至19日在深圳举行APEC第三十三次领导人非正式会议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261027-%E6%97%A5%E5%A4%96%E7%9B%B8%E6%8C%87%E5%B0%B1%E9%AB%98%E5%B8%82%E5%87%BA%E5%B8%AD11%E6%9C%88apec%E6%B7%B1%E5%9C%B3%E5%B3%B0%E4%BC%9A%E8%BF%9B%E8%A1%8C%E5%8D%8F%E8%B0%83-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%91%E7%A6%8F%E7%94%B0%E5%BA%B7%E5%A4%AB%E9%81%97%E5%B1%9E%E8%87%B4%E5%94%81%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793103901000.webp","sourceId":"rfi"},{"id":1793102287000,"createdDate":"2026-10-27 11:58","name":"法国国际广播电台","title":"前中联部部长刘建超据报被断崖式贬官","content":"中国共产党第二十届中央委员会第五次全体会议26日上午起一连4天在北京召开，中共中央总书记习近平代表中央政治局向全会作工作报告，并就《中共中央关于持之以恒推进全面从严治党若干重大问题的决定（讨论稿）》向全会作了说明。据《明报》报导称，本次全会料约45人将被“逐出”中央委员会，包括前中共中央对外联络部部长刘建超。据消息透露，刘建超遭认定严重违法违纪，断崖式贬官，由正部降为处级。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E5%89%8D%E4%B8%AD%E8%81%94%E9%83%A8%E9%83%A8%E9%95%BF%E5%88%98%E5%BB%BA%E8%B6%85%E6%8D%AE%E6%8A%A5%E8%A2%AB%E6%96%AD%E5%B4%96%E5%BC%8F%E8%B4%AC%E5%AE%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793102287000.webp","sourceId":"rfi"},{"id":1793097789000,"createdDate":"2026-10-27 10:43","name":"法国国际广播电台","title":"加拿大卑诗省保守党掌权后配合卡尼能源政策　中国将成海路出口最大买家","content":"加拿大卑诗省于10月24日举行的省级选举尘埃落定，右翼卑诗保守党大获全胜，取得93席中的64席，形成稳固多数政府。当部分美国共和党人预期，加拿大右翼执政可能对特朗普政府更有利之际，卑诗省保守党公开宣称，首要工作就是加快加拿大输油管建设，把内陆更多能源出口至亚洲，要大幅减少对美国出口的依赖。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261027-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%91%E8%AF%97%E7%9C%81%E4%BF%9D%E5%AE%88%E5%85%9A%E6%8E%8C%E6%9D%83%E5%90%8E%E9%85%8D%E5%90%88%E5%8D%A1%E5%B0%BC%E8%83%BD%E6%BA%90%E6%94%BF%E7%AD%96-%E4%B8%AD%E5%9B%BD%E5%B0%86%E6%88%90%E6%B5%B7%E8%B7%AF%E5%87%BA%E5%8F%A3%E6%9C%80%E5%A4%A7%E4%B9%B0%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793097789000.webp","sourceId":"rfi"},{"id":1793097353000,"createdDate":"2026-10-27 10:35","name":"法国国际广播电台","title":"董军罕见缺席东盟防长扩大会议 日防卫相此前称愿与其在会议期间“坦诚交流”","content":"中国防长董军罕见缺席本周即将在菲律宾宿务举行的东盟防长扩大会议。中国国防部周二（10月27日）表示，中国驻菲律宾使馆的国防武官将代表中方与会。此前外界曾关注，在日中关系持续紧张背景下，日中防长能否在会议期间举行会晤。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261027-%E8%91%A3%E5%86%9B%E7%BD%95%E8%A7%81%E7%BC%BA%E5%B8%AD%E4%B8%9C%E7%9B%9F%E9%98%B2%E9%95%BF%E6%89%A9%E5%A4%A7%E4%BC%9A-%E5%A4%96%E7%95%8C%E6%9B%BE%E5%85%B3%E6%B3%A8%E6%97%A5%E4%B8%AD%E9%98%B2%E9%95%BF%E8%83%BD%E5%90%A6%E5%9C%A8%E4%BC%9A%E8%AE%AE%E6%9C%9F%E9%97%B4%E5%86%8D%E4%BC%9A%E6%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793097353000.webp","sourceId":"rfi"},{"id":1793097080000,"createdDate":"2026-10-27 10:31","name":"法国国际广播电台","title":"中国官媒光复节发布台湾高清卫星影像 顾立雄指认知作战","content":"中国官媒上周日在光复节发布20张台湾高清卫星影像及影片，台湾国防部长顾立雄周二对此表示，中国挑光复节进行相关认知作战，国防部会采取适切的预警跟应处，并做好应有的隐蔽跟机动分散作为，以确保作战安全。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261027-%E4%B8%AD%E5%9B%BD%E5%AE%98%E5%AA%92%E5%85%89%E5%A4%8D%E8%8A%82%E5%8F%91%E5%B8%83%E5%8F%B0%E6%B9%BE%E9%AB%98%E6%B8%85%E5%8D%AB%E6%98%9F%E5%BD%B1%E5%83%8F-%E9%A1%BE%E7%AB%8B%E9%9B%84%E6%8C%87%E8%AE%A4%E7%9F%A5%E4%BD%9C%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793097080000.webp","sourceId":"rfi"},{"id":1793094718000,"createdDate":"2026-10-27 09:51","name":"法国国际广播电台","title":"被指“冒犯民族情感”  在中国遭抵制商业合作被终止   姆巴佩声明道歉","content":"法国足球明星姆巴佩因一段视频在中国引发争议，视频中他提到暗示中国前领导人为“独裁者”的梗图，引发中国舆论反弹，多家公司因此取消了与他的广告代言合同，中国外交部也做出回应。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E5%A7%86%E5%B7%B4%E4%BD%A9%E8%A2%AB%E6%8C%87-%E5%86%92%E7%8A%AF%E6%B0%91%E6%97%8F%E6%83%85%E6%84%9F-%E5%9C%A8%E4%B8%AD%E5%9B%BD%E9%81%AD%E6%8A%B5%E5%88%B6-%E5%95%86%E4%B8%9A%E5%90%88%E4%BD%9C%E8%A2%AB%E7%BB%88%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793094718000.webp","sourceId":"rfi"},{"id":1793094576000,"createdDate":"2026-10-27 09:49","name":"法国国际广播电台","title":"提对生育旅游及安全顾虑 美叫停华客赴北马里亚纳群岛免签计划","content":"特朗普政府决定暂停一项针对中国公民前往美国岛屿领地的免签旅行计划；此前，国会共和党议员曾发出警告，称该计划可能助长生育旅游，并构成国家安全风险。据福克斯新闻频道报导，美国国土安全部长马林（MarkwayneMullin）所作出的决定，针对的是拜登执政时期的一项计划；该计划允许经过预先筛查的中国公民免签证前往北马里亚纳群岛，停留时间最长可达14天。北马里亚纳群岛是美国的一个自治邦，位于西太平洋。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261027-%E6%8F%90%E5%AF%B9%E7%94%9F%E8%82%B2%E6%97%85%E6%B8%B8%E5%8F%8A%E5%AE%89%E5%85%A8%E9%A1%BE%E8%99%91-%E7%BE%8E%E5%8F%AB%E5%81%9C%E5%8D%8E%E5%AE%A2%E8%B5%B4%E5%8C%97%E9%A9%AC%E9%87%8C%E4%BA%9A%E7%BA%B3%E7%BE%A4%E5%B2%9B%E5%85%8D%E7%AD%BE%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793094576000.webp","sourceId":"rfi"},{"id":1793091284000,"createdDate":"2026-10-27 08:54","name":"法国国际广播电台","title":"德国总理访日 或与日本讨论德国参加日英意下一代战机开发","content":"德国总理默茨10月26日从首都柏林出发，开启访问日本等亚洲三国之行。将于28日至29日在日本停留，外界预测他有可能与日本首相高市早苗探讨德国参加日英意下一代战机开发。但是舆论认为：日本未必欢迎德国参入这项开发。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261027-%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%90%86%E8%AE%BF%E6%97%A5-%E6%88%96%E4%B8%8E%E6%97%A5%E6%9C%AC%E8%AE%A8%E8%AE%BA%E5%BE%B7%E5%9B%BD%E5%8F%82%E5%8A%A0%E6%97%A5%E8%8B%B1%E6%84%8F%E4%B8%8B%E4%B8%80%E4%BB%A3%E6%88%98%E6%9C%BA%E5%BC%80%E5%8F%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793091284000.webp","sourceId":"rfi"},{"id":1793090901000,"createdDate":"2026-10-27 08:48","name":"法国国际广播电台","title":"中国拟立新规管外资窃密害国安或利益 违者可被禁在华投资及入境","content":"在美国制裁五家涉及商业秘密宋的中国实体一周後，声言会采取後制措施的中国，拟推出特别规定，把侵害中国商业秘密且会危及国家安全和发展利益或构成实际威胁的外国实体实施制裁，可限制该等实体的在华贸易丶投资及入境限制。分析认为，新规例不光是反制美国，亦将大大提高使用窃密资料的外国实体的成本。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E4%B8%AD%E5%9B%BD%E6%8B%9F%E7%AB%8B%E6%96%B0%E8%A7%84%E7%AE%A1%E5%A4%96%E8%B5%84%E7%AA%83%E5%AF%86%E5%AE%B3%E5%9B%BD%E5%AE%89%E6%88%96%E5%88%A9%E7%9B%8A-%E8%BF%9D%E8%80%85%E5%8F%AF%E8%A2%AB%E7%A6%81%E5%9C%A8%E5%8D%8E%E6%8A%95%E8%B5%84%E5%8F%8A%E5%85%A5%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793090901000.webp","sourceId":"rfi"},{"id":1793081311000,"createdDate":"2026-10-27 06:08","name":"法国国际广播电台","title":"在中国 新款大众电动汽车价格低于 11,000 欧元吸引众多顾客，短短几小时获得10,000 个订单","content":"大众汽车在中国推出了新款电动汽车捷达M6，起售价为79800元人民币，约合10700欧元。该车型取得了成功，上市仅19小时，确认订单就超过了1万辆。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E5%9C%A8%E4%B8%AD%E5%9B%BD-%E6%96%B0%E6%AC%BE%E5%A4%A7%E4%BC%97%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E4%BB%B7%E6%A0%BC%E4%BD%8E%E4%BA%8E-11-000-%E6%AC%A7%E5%85%83%E5%90%B8%E5%BC%95%E4%BC%97%E5%A4%9A%E9%A1%BE%E5%AE%A2%EF%BC%8C%E7%9F%AD%E7%9F%AD%E5%87%A0%E5%B0%8F%E6%97%B6%E8%8E%B7%E5%BE%9710-000-%E4%B8%AA%E8%AE%A2%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793081311000.webp","sourceId":"rfi"},{"id":1793079740000,"createdDate":"2026-10-27 05:42","name":"法国国际广播电台","title":"中国1模特起诉电视公司完全由人工智能生成制作的电视剧：“他们盗用了我的脸”","content":"在中国社交媒体上拥有超过30万粉丝的模特李欣芝（音译），几个月来一直面临着面部被盗用的问题，她的照片被用于中国平台上播出的一部人工智能生成的电视剧中。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261027-%E4%B8%AD%E5%9B%BD1%E6%A8%A1%E7%89%B9%E8%B5%B7%E8%AF%89%E7%94%B5%E8%A7%86%E5%85%AC%E5%8F%B8%E5%AE%8C%E5%85%A8%E7%94%B1%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%94%9F%E6%88%90%E5%88%B6%E4%BD%9C%E7%9A%84%E7%94%B5%E8%A7%86%E5%89%A7-%E4%BB%96%E4%BB%AC%E7%9B%97%E7%94%A8%E4%BA%86%E6%88%91%E7%9A%84%E8%84%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/27/1793079740000.webp","sourceId":"rfi"}]