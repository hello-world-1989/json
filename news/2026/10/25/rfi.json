[{"id":1792933345000,"createdDate":"2026-10-25 13:02","name":"法国国际广播电台","title":"中共五中全会前夕任命一批新省级领导人","content":"中国执政的共产党周六宣布了六个省份的关键人事变动，包括两名新任省委书记和六名即将出任省长的官员，此举是在该党将于10月26日至29日在北京举行闭门会议之前做出的。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261025-%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%89%8D%E5%A4%95%E4%BB%BB%E5%91%BD%E4%B8%80%E6%89%B9%E6%96%B0%E7%9C%81%E7%BA%A7%E9%A2%86%E5%AF%BC%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792933345000.webp","sourceId":"rfi"},{"id":1792931482000,"createdDate":"2026-10-25 12:31","name":"法国国际广播电台","title":"法国大选热门极右翼候选人勒庞将发表首次竞选演讲 左翼集会抗议","content":"法国极右翼候选人玛丽娜·勒庞周日下午将在奥尔良发表其首场大型竞选演讲，目前距离总统大选还有六个月。在当前社会和经济紧张局势加剧的背景下，她被视为此次大选的最大热门。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261025-%E6%B3%95%E5%9B%BD%E5%A4%A7%E9%80%89%E7%83%AD%E9%97%A8%E6%9E%81%E5%8F%B3%E7%BF%BC%E5%80%99%E9%80%89%E4%BA%BA%E5%8B%92%E5%BA%9E%E5%B0%86%E5%8F%91%E8%A1%A8%E9%A6%96%E6%AC%A1%E7%AB%9E%E9%80%89%E6%BC%94%E8%AE%B2-%E5%B7%A6%E7%BF%BC%E9%9B%86%E4%BC%9A%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792931482000.webp","sourceId":"rfi"},{"id":1792928591000,"createdDate":"2026-10-25 11:43","name":"法国国际广播电台","title":"巴西总统决选投票前夕最新民调博索纳罗51%卢拉49%","content":"巴西第二轮总统决选，周日选民前往投票站，面临一个关键抉择：是让左翼老将卢拉再执政四年，还是让右翼参议员，前总统之子，弗拉维奥·博索纳罗执掌大权。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261025-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%86%B3%E9%80%89%E6%8A%95%E7%A5%A8%E5%89%8D%E5%A4%95%E6%9C%80%E6%96%B0%E6%B0%91%E8%B0%83%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%9751-%E5%8D%A2%E6%8B%8949","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792928591000.webp","sourceId":"rfi"},{"id":1792916465000,"createdDate":"2026-10-25 08:21","name":"法国国际广播电台","title":"日本30%以上大企业遭受网络攻击  自民党呼吁建立首相主导的对应体制","content":"近一个时期，在日本由于外部非法访问网页等造成严重损失事件接连发生之际，帝国数据银行本月向全国1328家企业询问了信息泄露或疑似发生信息泄露事件的情况。调查显示，大型企业中约有三成、中小企业中有超过一成回答称，曾发生过此类事件。据称，事件既包括误发电子邮件等人为失误，也包括遭受网络攻击造成的损失。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261025-%E6%97%A5%E6%9C%AC30-%E4%BB%A5%E4%B8%8A%E5%A4%A7%E4%BC%81%E4%B8%9A%E9%81%AD%E5%8F%97%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB-%E8%87%AA%E6%B0%91%E5%85%9A%E5%91%BC%E5%90%81%E5%BB%BA%E7%AB%8B%E9%A6%96%E7%9B%B8%E4%B8%BB%E5%AF%BC%E7%9A%84%E5%AF%B9%E5%BA%94%E4%BD%93%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792916465000.webp","sourceId":"rfi"},{"id":1792952394000,"createdDate":"2026-10-25 18:19","name":"法国国际广播电台","title":"《快报》周刊：2026年诺贝尔和平奖评选进一步损害该奖的声誉","content":"23日在法国近郊Yvelines发生的反移民色彩枪击案和24日法国高度紧张的新一波社会运动是周末版法国《世界报》在头版头条重点凸出的内容。在国际版，该报以大版篇幅聚焦在中东动荡局势下即将启动的以色列大选以及以色列总理内塔尼亚胡对约旦河西岸发出的军事打击威胁。此外，也门反政府势力胡塞武装在也门境内的发展、意大利总理梅洛妮与各国保守派政党的关系等也是该报国际版关注的话题。美国中期选举临近，该报以特别报道德克萨斯州围绕大数据中心建设的争议。周末地缘政治专栏则聚焦如今寄居乌克兰首都的当年切尔诺贝利核电站事故幸存者对当前俄乌战争的感受。一名幸存者表示，当年的切尔诺贝利核电站事故是一个看不见的敌人，眼前的战争则发生在光天化日之下。本期《世界报》没有关于中国的特别报道。我们借本次节目时间，向大家介绍最新一期法国《快报》周刊关于2026年诺贝尔和平奖评选结果的争议的文章。文章认为围绕本届和平奖得主的争议进一步损害了该奖的声誉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261025-%E5%BF%AB%E6%8A%A5-%E5%91%A8%E5%88%8A-2026%E5%B9%B4%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%92%8C%E5%B9%B3%E5%A5%96%E8%AF%84%E9%80%89%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%8D%9F%E5%AE%B3%E8%AF%A5%E5%A5%96%E7%9A%84%E5%A3%B0%E8%AA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792952394000.webp","sourceId":"rfi"},{"id":1792951591000,"createdDate":"2026-10-25 18:06","name":"法国国际广播电台","title":"中国限制出口 德国在华机械制造巨头受影响","content":"据德国《焦点》周刊报道：中国已对无人机及其他军民两用产品实施出口管制。如今，中国进一步扩大了这些限制措施，德国一家重量级企业也因此受到影响。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261025-%E4%B8%AD%E5%9B%BD%E9%99%90%E5%88%B6%E5%87%BA%E5%8F%A3-%E5%BE%B7%E5%9B%BD%E5%9C%A8%E5%8D%8E%E6%9C%BA%E6%A2%B0%E5%88%B6%E9%80%A0%E5%B7%A8%E5%A4%B4%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792951591000.webp","sourceId":"rfi"},{"id":1792950680000,"createdDate":"2026-10-25 17:51","name":"法国国际广播电台","title":"印度阿鲁纳恰尔邦超大型水电项目引爆警民冲突","content":"位于印度东北部、靠近中印边境的阿鲁纳恰尔邦23日晚爆发警民冲突。一些民众因反对政府在当地兴建大型多用途水电站的计划而集会抗议，毁坏许多物资。法新社引述阿鲁纳恰尔邦政府负责人24日向媒体通报的消息称，近40名警察在冲突中受伤。警方曾释放催泪弹，驱散人群。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261025-%E5%8D%B0%E5%BA%A6%E9%98%BF%E9%B2%81%E7%BA%B3%E6%81%B0%E5%B0%94%E9%82%A6%E8%B6%85%E5%A4%A7%E5%9E%8B%E6%B0%B4%E7%94%B5%E9%A1%B9%E7%9B%AE%E5%BC%95%E7%88%86%E8%AD%A6%E6%B0%91%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792950680000.webp","sourceId":"rfi"},{"id":1792949887000,"createdDate":"2026-10-25 17:38","name":"法国国际广播电台","title":"弗拉维奥·博索纳罗：追随父亲脚步的继承人","content":"弗拉维奥·博索纳罗将自己与父亲相比说：“我或许更沉着，更爱笑，更从容，更温和，但在我的血管里流着博索纳罗的血”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261025-%E5%BC%97%E6%8B%89%E7%BB%B4%E5%A5%A5%C2%B7%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97-%E8%BF%BD%E9%9A%8F%E7%88%B6%E4%BA%B2%E8%84%9A%E6%AD%A5%E7%9A%84%E7%BB%A7%E6%89%BF%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792949887000.webp","sourceId":"rfi"},{"id":1792948759000,"createdDate":"2026-10-25 17:19","name":"法国国际广播电台","title":"卢拉：面对自己、逝去的时光和历史","content":"即将年满81岁的巴西总统卢拉长期以来对手机不屑一顾，如今他却自诩为“自拍之王”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261025-%E5%8D%A2%E6%8B%89-%E9%9D%A2%E5%AF%B9%E8%87%AA%E5%B7%B1-%E9%80%9D%E5%8E%BB%E7%9A%84%E6%97%B6%E5%85%89%E5%92%8C%E5%8E%86%E5%8F%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792948759000.webp","sourceId":"rfi"},{"id":1792940313000,"createdDate":"2026-10-25 14:58","name":"法国国际广播电台","title":"法国10.24示威活动41万人参加 1314人被捕 53名执法人员受伤","content":"据法国内政部周日发布的全国初步统计，周六在法国爆发的抗议活动导致1314人被拘留，消防部门出动75次扑救火灾；此外，53名执法人员受伤，24家商铺遭抢劫。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261025-%E6%B3%95%E5%9B%BD10-24%E7%A4%BA%E5%A8%81%E6%B4%BB%E5%8A%A841%E4%B8%87%E4%BA%BA%E5%8F%82%E5%8A%A0-1314%E4%BA%BA%E8%A2%AB%E6%8D%95-53%E5%90%8D%E6%89%A7%E6%B3%95%E4%BA%BA%E5%91%98%E5%8F%97%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792940313000.webp","sourceId":"rfi"}]