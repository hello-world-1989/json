[{"id":1792933345000,"createdDate":"2026-10-25 13:02","name":"法国国际广播电台","title":"中共五中全会前夕任命一批新省级领导人","content":"中国执政的共产党周六宣布了六个省份的关键人事变动，包括两名新任省委书记和六名即将出任省长的官员，此举是在该党将于10月26日至29日在北京举行闭门会议之前做出的。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261025-%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%89%8D%E5%A4%95%E4%BB%BB%E5%91%BD%E4%B8%80%E6%89%B9%E6%96%B0%E7%9C%81%E7%BA%A7%E9%A2%86%E5%AF%BC%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792933345000.webp","sourceId":"rfi"},{"id":1792931482000,"createdDate":"2026-10-25 12:31","name":"法国国际广播电台","title":"法国大选热门极右翼候选人勒庞将发表首次竞选演讲 左翼集会抗议","content":"法国极右翼候选人玛丽娜·勒庞周日下午将在奥尔良发表其首场大型竞选演讲，目前距离总统大选还有六个月。在当前社会和经济紧张局势加剧的背景下，她被视为此次大选的最大热门。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261025-%E6%B3%95%E5%9B%BD%E5%A4%A7%E9%80%89%E7%83%AD%E9%97%A8%E6%9E%81%E5%8F%B3%E7%BF%BC%E5%80%99%E9%80%89%E4%BA%BA%E5%8B%92%E5%BA%9E%E5%B0%86%E5%8F%91%E8%A1%A8%E9%A6%96%E6%AC%A1%E7%AB%9E%E9%80%89%E6%BC%94%E8%AE%B2-%E5%B7%A6%E7%BF%BC%E9%9B%86%E4%BC%9A%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792931482000.webp","sourceId":"rfi"},{"id":1792928591000,"createdDate":"2026-10-25 11:43","name":"法国国际广播电台","title":"巴西总统决选投票前夕最新民调博索纳罗51%卢拉49%","content":"巴西第二轮总统决选，周日选民前往投票站，面临一个关键抉择：是让左翼老将卢拉再执政四年，还是让右翼参议员，前总统之子，弗拉维奥·博索纳罗执掌大权。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261025-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%86%B3%E9%80%89%E6%8A%95%E7%A5%A8%E5%89%8D%E5%A4%95%E6%9C%80%E6%96%B0%E6%B0%91%E8%B0%83%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%9751-%E5%8D%A2%E6%8B%8949","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792928591000.webp","sourceId":"rfi"},{"id":1792916465000,"createdDate":"2026-10-25 08:21","name":"法国国际广播电台","title":"日本30%以上大企业遭受网络攻击  自民党呼吁建立首相主导的对应体制","content":"近一个时期，在日本由于外部非法访问网页等造成严重损失事件接连发生之际，帝国数据银行本月向全国1328家企业询问了信息泄露或疑似发生信息泄露事件的情况。调查显示，大型企业中约有三成、中小企业中有超过一成回答称，曾发生过此类事件。据称，事件既包括误发电子邮件等人为失误，也包括遭受网络攻击造成的损失。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261025-%E6%97%A5%E6%9C%AC30-%E4%BB%A5%E4%B8%8A%E5%A4%A7%E4%BC%81%E4%B8%9A%E9%81%AD%E5%8F%97%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB-%E8%87%AA%E6%B0%91%E5%85%9A%E5%91%BC%E5%90%81%E5%BB%BA%E7%AB%8B%E9%A6%96%E7%9B%B8%E4%B8%BB%E5%AF%BC%E7%9A%84%E5%AF%B9%E5%BA%94%E4%BD%93%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/25/1792916465000.webp","sourceId":"rfi"}]