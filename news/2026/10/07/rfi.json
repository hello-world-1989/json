[{"id":1791331722000,"createdDate":"2026-10-07 00:08","name":"法国国际广播电台","title":"英国后悔脱欧？惟现考虑英重返欧盟“规模太大，时机太早”","content":"“英国后悔脱欧”？英国与欧盟峰会预计将于11月底举行。英国脱欧公投十年后，伦敦与布鲁塞尔加强联系的可能性再次出现在英国政治辩论中。首相安迪·伯纳姆(AndyBurnham)甚至提出了英国重新加入欧盟的可能性。尽管“回归”的前景似乎仍然遥远，但雅克·德洛尔研究所(l'InstitutJacquesDelors)特别顾问塞巴斯蒂安·马亚尔(SébastienMaillard)认为，“肯定有比维持现状更好的选择。”","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261007-%E8%8B%B1%E5%9B%BD%E5%90%8E%E6%82%94%E8%84%B1%E6%AC%A7-%E6%83%9F%E7%8E%B0%E8%80%83%E8%99%91%E8%8B%B1%E9%87%8D%E8%BF%94%E6%AC%A7%E7%9B%9F-%E8%A7%84%E6%A8%A1%E5%A4%AA%E5%A4%A7%EF%BC%8C%E6%97%B6%E6%9C%BA%E5%A4%AA%E6%97%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791331722000.webp","sourceId":"rfi"},{"id":1791386588000,"createdDate":"2026-10-07 15:23","name":"法国国际广播电台","title":"涉及至少21名儿童 加州代孕虐童案宣国军夫妇否认所有指控","content":"据美国广播公司（ABC）报导，当局表示，洛杉矶县治安官部门的警员于周二上午突击搜查了位于加州洛杉矶县阿卡迪亚（Arcadia）的一处住宅，并逮捕了一对涉嫌卷入涉及21名儿童受害者的代孕丑闻的夫妇。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261007-%E6%B6%89%E5%8F%8A%E8%87%B3%E5%B0%9121%E5%90%8D%E5%84%BF%E7%AB%A5-%E5%8A%A0%E5%B7%9E%E4%BB%A3%E5%AD%95%E8%99%90%E7%AB%A5%E6%A1%88%E5%AE%A3%E5%9B%BD%E5%86%9B%E5%A4%AB%E5%A6%87%E5%90%A6%E8%AE%A4%E6%89%80%E6%9C%89%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791386588000.webp","sourceId":"rfi"},{"id":1791380361000,"createdDate":"2026-10-07 13:39","name":"法国国际广播电台","title":"指加深依赖关系、危及供应链韧性 德政府阻止向中远海运出售物流公司Zippel","content":"德国经济和能源部周三表示，出于安全考虑，德国政府已阻止该国物流公司Zippel出售给中国国有企业中国远洋海运集团（Cosco、以下简称中远海运）的交易。该部门在一份声明中表示：“此次收购将加深依赖关系，并危及德国及欧盟供应链的韧性”。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261007-%E6%8C%87%E5%8A%A0%E6%B7%B1%E4%BE%9D%E8%B5%96%E5%85%B3%E7%B3%BB-%E5%8D%B1%E5%8F%8A%E4%BE%9B%E5%BA%94%E9%93%BE%E9%9F%A7%E6%80%A7-%E5%BE%B7%E6%94%BF%E5%BA%9C%E9%98%BB%E6%AD%A2%E5%90%91%E4%B8%AD%E8%BF%9C%E6%B5%B7%E8%BF%90%E5%87%BA%E5%94%AE%E7%89%A9%E6%B5%81%E5%85%AC%E5%8F%B8zippel","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791380361000.webp","sourceId":"rfi"},{"id":1791378338000,"createdDate":"2026-10-07 13:05","name":"法国国际广播电台","title":"COP31准备会议与澳大利亚的矛盾立场","content":"在土耳其第31届气候峰会召开之前的一个月，澳大利亚以及太平洋岛国的数十名政府领导人从10月5日周一开始汇聚在斐济的首都纳迪，举行为期四天的峰会准备会议，其目的是将站在气候变化最前沿的太平洋岛国的严峻事实推向前台。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261007-cop31%E5%87%86%E5%A4%87%E4%BC%9A%E8%AE%AE%E4%B8%8E%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E7%9A%84%E7%9F%9B%E7%9B%BE%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791378338000.webp","sourceId":"rfi"},{"id":1791377690000,"createdDate":"2026-10-07 12:54","name":"法国国际广播电台","title":"恐成入欧“后门” 英贸易救济署指应对进口自中国的金红石型二氧化钛征反倾销税","content":"英国贸易监管机构在认定国内相关产业面临受损风险后，建议政府对从中国进口的、用于油漆和造纸行业的金红石型二氧化钛征收新的反倾销税。在全球贸易环境日益碎片化的背景下，英国已采取行动保护国内产业；鉴于对中国等国廉价钢铁过剩的担忧，英方早前以一项更严厉的新措施取代了原有的钢铁保障措施。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261007-%E8%A2%AB%E6%8C%87%E6%81%90%E6%88%90%E5%85%A5%E6%AC%A7%E5%90%8E%E9%97%A8-%E8%8B%B1%E8%B4%B8%E6%98%93%E6%95%91%E6%B5%8E%E7%BD%B2%E6%8C%87%E5%BA%94%E5%AF%B9%E8%BF%9B%E5%8F%A3%E8%87%AA%E4%B8%AD%E5%9B%BD%E7%9A%84%E9%87%91%E7%BA%A2%E7%9F%B3%E5%9E%8B%E4%BA%8C%E6%B0%A7%E5%8C%96%E9%92%9B%E5%BE%81%E5%8F%8D%E5%80%BE%E9%94%80%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791377690000.webp","sourceId":"rfi"},{"id":1791374630000,"createdDate":"2026-10-07 12:03","name":"法国国际广播电台","title":"从害怕连民进党支持者都不认识到成功“破圈”，沈伯洋的“洋流奇迹”将让台北市变天？","content":"寻求连任的国民党籍现任台北市长蒋万安，面临民进党籍挑战者沈伯洋强势带起的「洋流」旋风，双方在政策攻防，甚至网路社群声量上都展开了激烈的正面对决。在5 月的民调中蒋万安支持度仍超过沈伯洋28％，但在9月的民心调查中，差距却缩小到不到2％。究竟「洋流」这波声势是怎么形成的？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20261007-%E4%BB%8E%E5%AE%B3%E6%80%95%E8%BF%9E%E6%B0%91%E8%BF%9B%E5%85%9A%E6%94%AF%E6%8C%81%E8%80%85%E9%83%BD%E4%B8%8D%E8%AE%A4%E8%AF%86%E5%88%B0%E6%88%90%E5%8A%9F-%E7%A0%B4%E5%9C%88-%EF%BC%8C%E6%B2%88%E4%BC%AF%E6%B4%8B%E7%9A%84-%E6%B4%8B%E6%B5%81%E5%A5%87%E8%BF%B9-%E5%B0%86%E8%AE%A9%E5%8F%B0%E5%8C%97%E5%B8%82%E5%8F%98%E5%A4%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791374630000.webp","sourceId":"rfi"},{"id":1791372551000,"createdDate":"2026-10-07 11:29","name":"法国国际广播电台","title":"2026年诺贝尔化学奖揭晓 法国和日本科学家获奖","content":"瑞典皇家科学院周三宣布，将2026年诺贝尔化学奖授予2名科学家。奖项授予亨利·B·卡甘（HenriB.Kagan）和硖合宪三，以表彰他们发现不对称有机合成中的非线性效应和自催化现象。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261007-2026%E5%B9%B4%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%8C%96%E5%AD%A6%E5%A5%96%E6%8F%AD%E6%99%93-%E6%B3%95%E5%9B%BD%E5%92%8C%E6%97%A5%E6%9C%AC%E7%A7%91%E5%AD%A6%E5%AE%B6%E8%8E%B7%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791372551000.webp","sourceId":"rfi"},{"id":1791371458000,"createdDate":"2026-10-07 11:10","name":"法国国际广播电台","title":"冒充Anthropic员工，却是真正的间谍：疑与中国有关的奇特行动，试探华盛顿的AI秘密","content":"大家好，欢迎收听法国报纸摘要。今天周三10月7日出刊的法国全国性日报的两大焦点：首先是法国各地昨天6日约25万至45万民众走上街头，对于期间引发的暴力事件《解放报》评论道：“这一天的动员，一方面是武力展示，另一方面是充耳不闻。即使按照警方保守的估计，游行队伍、示威者和动员起来的高中生数量也表明，不满情绪并未消退，而是在持续蔓延 。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261007-%E5%86%92%E5%85%85anthropic%E5%91%98%E5%B7%A5%EF%BC%8C%E5%8D%B4%E6%98%AF%E7%9C%9F%E6%AD%A3%E7%9A%84%E9%97%B4%E8%B0%8D-%E7%96%91%E4%B8%8E%E4%B8%AD%E5%9B%BD%E6%9C%89%E5%85%B3%E7%9A%84%E5%A5%87%E7%89%B9%E8%A1%8C%E5%8A%A8%EF%BC%8C%E8%AF%95%E5%9B%BE%E5%88%BA%E6%8E%A2%E5%8D%8E%E7%9B%9B%E9%A1%BF%E7%9A%84ai%E7%A7%98%E5%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791371458000.webp","sourceId":"rfi"},{"id":1791370314000,"createdDate":"2026-10-07 10:51","name":"法国国际广播电台","title":"涉嫌冒名台湾中科院购买并转卖给大陆受管制美国芯片 10人被起诉","content":"台湾检方今天周三宣布，十名台湾公民被控使用伪造文件获取受限的美国军工芯片，经过洗产地再将其出口到大陆和香港，被用于军事武器制造。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261007-%E6%B6%89%E5%AB%8C%E5%86%92%E5%90%8D%E5%8F%B0%E6%B9%BE%E4%B8%AD%E7%A7%91%E9%99%A2%E8%B4%AD%E4%B9%B0%E5%B9%B6%E8%BD%AC%E5%8D%96%E7%BB%99%E5%A4%A7%E9%99%86%E5%8F%97%E7%AE%A1%E5%88%B6%E7%BE%8E%E5%9B%BD%E8%8A%AF%E7%89%87-10%E4%BA%BA%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791370314000.webp","sourceId":"rfi"},{"id":1791369686000,"createdDate":"2026-10-07 10:41","name":"法国国际广播电台","title":"欧盟贸易委员访华 欧方据报望周五前中方同意适度控制一特定领域出口","content":"欧盟委员会贸易和经济安全委员谢夫乔维奇（MarošŠefčovič）定于周三启程前往北京，进行为期两天的密集谈判，但布鲁塞尔方面对预计谈判成果持审慎态度。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261007-%E6%AC%A7%E7%9B%9F%E8%B4%B8%E6%98%93%E5%A7%94%E5%91%98%E8%AE%BF%E5%8D%8E-%E6%AC%A7%E6%96%B9%E6%8D%AE%E6%8A%A5%E6%9C%9B%E5%91%A8%E4%BA%94%E5%89%8D%E4%B8%AD%E6%96%B9%E5%90%8C%E6%84%8F%E9%80%82%E5%BA%A6%E6%8E%A7%E5%88%B6%E4%B8%80%E7%89%B9%E5%AE%9A%E9%A2%86%E5%9F%9F%E5%87%BA%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791369686000.webp","sourceId":"rfi"},{"id":1791365216000,"createdDate":"2026-10-07 09:26","name":"法国国际广播电台","title":"尼泊尔洪灾遗体辨识困难 数千失踪者家属苦候DNA结果","content":"据法新社报道，尼泊尔8月底严重洪灾发生至今一个多月，灾后遗体辨识工作进展缓慢。由于遗体严重残缺、失踪人数众多，加上DNA样本数量庞大，当局表示，确认遇难者身份仍需数周时间，而数千个家庭仍继续等待结果。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261007-%E5%B0%BC%E6%B3%8A%E5%B0%94%E6%B4%AA%E7%81%BE%E9%81%97%E4%BD%93%E8%BE%A8%E8%AF%86%E5%9B%B0%E9%9A%BE-%E6%95%B0%E5%8D%83%E5%A4%B1%E8%B8%AA%E8%80%85%E5%AE%B6%E5%B1%9E%E8%8B%A6%E5%80%99dna%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791365216000.webp","sourceId":"rfi"},{"id":1791364829000,"createdDate":"2026-10-07 09:20","name":"法国国际广播电台","title":"俄总统助理帕特鲁舍夫周四访华 北京：中俄在传染病防控领域保持密切交流合作","content":"中国外交部发言人郭嘉昆在周二（6日）的例行记者会上应询时表示，“中俄双方在包括鼠疫在内的传染病防控领域保持密切交流合作”。当被美国全国广播公司（NBC）记者问道“据报道，俄罗斯伊尔库茨克地区研究所的一名工作人员疑似感染肺鼠疫后身亡。美国国务院称，正在密切监测这一情况。俄罗斯政府是否同中国政府和专家建立联系，探讨可能的合作以应对这一问题？”，郭嘉昆作出了如上答复。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261007-%E4%BF%84%E6%80%BB%E7%BB%9F%E5%8A%A9%E7%90%86%E5%B8%95%E7%89%B9%E9%B2%81%E8%88%8D%E5%A4%AB%E5%91%A8%E5%9B%9B%E8%AE%BF%E5%8D%8E-%E5%8C%97%E4%BA%AC-%E4%B8%AD%E4%BF%84%E5%9C%A8%E4%BC%A0%E6%9F%93%E7%97%85%E9%98%B2%E6%8E%A7%E9%A2%86%E5%9F%9F%E4%BF%9D%E6%8C%81%E5%AF%86%E5%88%87%E4%BA%A4%E6%B5%81%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791364829000.webp","sourceId":"rfi"},{"id":1791362644000,"createdDate":"2026-10-07 08:44","name":"法国国际广播电台","title":"支联会案 邹幸彤就定罪及判刑提出上诉","content":"据《明报》报导，已解散的香港市民支援爱国民主运动联合会（简称支联会）、前主席李卓人、前副主席何俊仁及邹幸彤被控煽动他人颠覆国家政权罪，何俊仁开审前认罪，支联会、李卓人及邹幸彤经审讯后裁定罪成。法庭早前判处判处邹幸彤监禁7年3个月、李卓人监禁7年、何俊仁监禁5年2个月，支联会则罚款150万元。邹幸彤日前已就定罪及判刑提出上诉。根据司法机构网页显示，案件聆讯尚未排期。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261007-%E6%94%AF%E8%81%94%E4%BC%9A%E6%A1%88-%E9%82%B9%E5%B9%B8%E5%BD%A4%E5%B0%B1%E5%AE%9A%E7%BD%AA%E5%8F%8A%E5%88%A4%E5%88%91%E6%8F%90%E5%87%BA%E4%B8%8A%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791362644000.webp","sourceId":"rfi"},{"id":1791359793000,"createdDate":"2026-10-07 07:56","name":"法国国际广播电台","title":"鉴于美军士兵涉嫌抢劫杀人  美军向驻冲绳全军发出禁止外出令","content":"鉴于发生美国海军陆战队员涉嫌强盗杀人事件，冲绳美军最高负责人、四军协调官沃森宣布，对驻冲绳的所有美军人员采取措施：从10月7日中午起暂停部队活动48小时，禁止外出和饮酒；从9日起，连续30天禁止夜间外出。对此日本内阁官房长官木原稔7日表示：“我理解这是美军高度重视这一事件，并为严肃军纪、防止类似事件发生而迅速采取行动的体现。”","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261007-%E9%89%B4%E4%BA%8E%E7%BE%8E%E5%86%9B%E5%A3%AB%E5%85%B5%E6%B6%89%E5%AB%8C%E6%8A%A2%E5%8A%AB%E6%9D%80%E4%BA%BA-%E7%BE%8E%E5%86%9B%E5%90%91%E9%A9%BB%E5%86%B2%E7%BB%B3%E5%85%A8%E5%86%9B%E5%8F%91%E5%87%BA%E7%A6%81%E6%AD%A2%E5%A4%96%E5%87%BA%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791359793000.webp","sourceId":"rfi"},{"id":1791358297000,"createdDate":"2026-10-07 07:31","name":"法国国际广播电台","title":"台湾前总统蔡英文卸任首度访美 前众议院议长佩洛西称她为「勇敢的民主捍卫者」","content":"前总统蔡英文自卸任后首度访美，在5日抵达美西旧金山，展开为期一周的交流访问。除了与美国民主党籍前众议院议长佩洛西会面，也将在7日于史丹佛大学「2026科技与国家安全研讨会」发表演讲。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261007-%E5%8F%B0%E6%B9%BE%E5%89%8D%E6%80%BB%E7%BB%9F%E8%94%A1%E8%8B%B1%E6%96%87%E5%8D%B8%E4%BB%BB%E9%A6%96%E5%BA%A6%E8%AE%BF%E7%BE%8E-%E5%89%8D%E4%BC%97%E8%AE%AE%E9%99%A2%E8%AE%AE%E9%95%BF%E4%BD%A9%E6%B4%9B%E8%A5%BF%E7%A7%B0%E5%A5%B9%E4%B8%BA-%E5%8B%87%E6%95%A2%E7%9A%84%E6%B0%91%E4%B8%BB%E6%8D%8D%E5%8D%AB%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791358297000.webp","sourceId":"rfi"},{"id":1791357659000,"createdDate":"2026-10-07 07:20","name":"法国国际广播电台","title":"涉煽动罪被捕网媒人邓浩荣 在未有冻结资产令下多个账户同遭银行冻结","content":"疑因在「831」事件七周年悼念活动现场而被香港警队国安处以涉嫌散播假消息及煽动为由而拘捕的网媒「爆炸头」创办人邓浩荣，已于中国国庆日翌日获准保释，但他其后发现，在未有资产冻结令下，名下多个账户突然同时被冻结，无法使用，影响生计。评论认为，邓浩荣是杀鸡儆猴的例子，显示现时在香港，只要被视为不服从，便难以生存，亦反映香港新闻工作者遭针对和施压的情况越见严重。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261007-%E6%B6%89%E7%85%BD%E5%8A%A8%E7%BD%AA%E8%A2%AB%E6%8D%95%E7%BD%91%E5%AA%92%E4%BA%BA%E9%82%93%E6%B5%A9%E8%8D%A3-%E5%9C%A8%E6%9C%AA%E6%9C%89%E5%86%BB%E7%BB%93%E8%B5%84%E4%BA%A7%E4%BB%A4%E4%B8%8B%E5%A4%9A%E4%B8%AA%E8%B4%A6%E6%88%B7%E5%90%8C%E9%81%AD%E9%93%B6%E8%A1%8C%E5%86%BB%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791357659000.webp","sourceId":"rfi"},{"id":1791357379000,"createdDate":"2026-10-07 07:16","name":"法国国际广播电台","title":"港男涉「跨境镇压」袭击在台日媒矢板明夫 遭台方正式起诉及求刑5年","content":"33岁有黑帮背景的港男廖港发，今年7月在台中袭击日籍媒体人兼印太战略智库执行长矢板明夫，案件被台湾检方定性为涉及「跨境镇压」，并正式起诉廖港发，建议判处法定刑罚最重的5年有期徒刑，同时通缉另外4名已出境的涉案香港帮派成员。矢板明夫表示，检方明确指出，施袭者的目的是要「杀一儆百」，反映事件并非中国国台办所称的「单纯治安事件」，而是一场「有组织丶有计划丶有报酬」的跨境暴力行动。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261007-%E6%B8%AF%E7%94%B7%E6%B6%89-%E8%B7%A8%E5%A2%83%E9%95%87%E5%8E%8B-%E8%A2%AD%E5%87%BB%E5%9C%A8%E5%8F%B0%E6%97%A5%E5%AA%92%E7%9F%A2%E6%9D%BF%E6%98%8E%E5%A4%AB-%E9%81%AD%E5%8F%B0%E6%96%B9%E6%AD%A3%E5%BC%8F%E8%B5%B7%E8%AF%89%E5%8F%8A%E6%B1%82%E5%88%915%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/07/1791357379000.webp","sourceId":"rfi"}]