[{"id":1791034589000,"createdDate":"2026-10-03 13:36","name":"法国国际广播电台","title":"加拿大极右组织公开活动引全国关注  媒体揭与美国同类组织有联系","content":"加拿大极右组织SecondSonsCanada近日再次成为全国焦点。一名前加拿大武装部队（CAF）成员向加拿大广播公司CBCNews披露，该组织对外以“男性民族主义俱乐部”包装，实际上在招募过程中灌输对希特勒的崇拜、新纳粹思想及对犹太人的仇恨。与此同时，组织于9月27日在卑诗省甘露市Kamloops原住民保留地举行示威，引发总理卡尼MarkCarney、皇家骑警RCMP及多个民间组织强烈谴责。CBC调查进一步揭示，该组织与美国极端“activeclub”网络有跨境联系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261003-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%9E%81%E5%8F%B3%E7%BB%84%E7%BB%87%E5%85%AC%E5%BC%80%E6%B4%BB%E5%8A%A8%E5%BC%95%E5%85%A8%E5%9B%BD%E5%85%B3%E6%B3%A8-%E5%AA%92%E4%BD%93%E6%8F%AD%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%90%8C%E7%B1%BB%E7%BB%84%E7%BB%87%E6%9C%89%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791034589000.webp","sourceId":"rfi"},{"id":1791033493000,"createdDate":"2026-10-03 13:18","name":"法国国际广播电台","title":"债务：法国缘何面临陷入金融危机威胁","content":"周末出刊的法国左右两份大报《解放报》和《费加罗报》头版主题均集中于国内议题。“债务：法国面临陷入金融危机威胁”，《费加罗报》头版聚焦法国公共财政和债务压力问题，正日益引发金融市场严重担忧可能引发金融风险，法国10年期国债收益率近期逼近5%关口，创下25年来从未有过的高位。《解放报》关注2027年法国总统大选左翼阵营的初选，本周日，五位候选人将举行初选前的第三场、也是最后一场电视辩论,议题涉及乌克兰、加沙、购买力、医疗、退休、债务、生态以及正在持续的高中抗议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261003-%E5%80%BA%E5%8A%A1-%E6%B3%95%E5%9B%BD%E7%BC%98%E4%BD%95%E9%9D%A2%E4%B8%B4%E9%99%B7%E5%85%A5%E9%87%91%E8%9E%8D%E5%8D%B1%E6%9C%BA%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791033493000.webp","sourceId":"rfi"},{"id":1791032688000,"createdDate":"2026-10-03 13:04","name":"法国国际广播电台","title":"迪拜航班事件调查认定“恐怖袭击” 副驾驶用驾驶舱内应急斧袭击印度机长","content":"阿联酋一家官媒周六援引该国总检察长报道称，针对迪拜（flydubai）航班袭击事件的调查证实，副驾驶使用了驾驶舱内的应急斧袭击了机长，并企图“接管飞机控制权”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261003-%E8%BF%AA%E6%8B%9C%E8%88%AA%E7%8F%AD%E4%BA%8B%E4%BB%B6%E8%B0%83%E6%9F%A5%E8%AE%A4%E5%AE%9A-%E6%81%90%E6%80%96%E8%A2%AD%E5%87%BB-%E5%89%AF%E9%A9%BE%E9%A9%B6%E7%94%A8%E9%A9%BE%E9%A9%B6%E8%88%B1%E5%86%85%E5%BA%94%E6%80%A5%E6%96%A7%E8%A2%AD%E5%87%BB%E5%8D%B0%E5%BA%A6%E6%9C%BA%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791032688000.webp","sourceId":"rfi"},{"id":1791030929000,"createdDate":"2026-10-03 12:35","name":"法国国际广播电台","title":"习近平访美特殊休息时间让他与特朗普的峰会缩短数小时","content":"华尔街日报：据熟悉此次访问筹备工作的人士透露，中国官员提出了一项不同寻常的要求，即美国方面应在习近平与特朗普总统举行峰会期间，满足习近平的休息需求，这罕见地揭示了这位73岁领导人日益显现的身体限制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261003-%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%AE%BF%E7%BE%8E%E7%89%B9%E6%AE%8A%E4%BC%91%E6%81%AF%E6%97%B6%E9%97%B4%E8%AE%A9%E4%BB%96%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E5%B3%B0%E4%BC%9A%E7%BC%A9%E7%9F%AD%E6%95%B0%E5%B0%8F%E6%97%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791030929000.webp","sourceId":"rfi"},{"id":1791028591000,"createdDate":"2026-10-03 11:56","name":"法国国际广播电台","title":"文件披露中国国企与英伟达Blackwell芯片的相关交易","content":"根据向北京监管机构提交的文件显示，一家由多个地方政府实体持股的中国融资公司为购买受华盛顿限制的英伟达（NvidiaCorp）芯片提供了资金，这表明中国政府支持了华盛顿方面担忧的、正在推动中国人工智能（AI）发展的非法贸易。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261003-%E6%96%87%E4%BB%B6%E6%8A%AB%E9%9C%B2%E4%B8%AD%E5%9B%BD%E5%9B%BD%E4%BC%81%E4%B8%8E%E8%8B%B1%E4%BC%9F%E8%BE%BEblackwell%E8%8A%AF%E7%89%87%E7%9A%84%E7%9B%B8%E5%85%B3%E4%BA%A4%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791028591000.webp","sourceId":"rfi"},{"id":1791028043000,"createdDate":"2026-10-03 11:47","name":"法国国际广播电台","title":"中国对从欧洲进口的一种化学品展开反倾销调查","content":"在欧盟贸易专员谢夫乔维奇下周抵达北京之际,中国商务部于今天周六对从欧盟进口的一种化学品发起反倾销调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261003-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E4%BB%8E%E6%AC%A7%E6%B4%B2%E8%BF%9B%E5%8F%A3%E7%9A%84%E4%B8%80%E7%A7%8D%E5%8C%96%E5%AD%A6%E5%93%81%E5%B1%95%E5%BC%80%E5%8F%8D%E5%80%BE%E9%94%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791028043000.webp","sourceId":"rfi"},{"id":1791024466000,"createdDate":"2026-10-03 10:47","name":"法国国际广播电台","title":"普京呼吁日俄友好  日本表示留意普京发言","content":"俄罗斯总统普京10月1日在莫斯科举行的国际知名人士会议“瓦尔代国际辩论俱乐部”上就日俄关系发表讲话。他表示，如果能够克服当前的“困难”，日俄关系有可能发展成为“友好互利”的关系，并要求日方采取合作态度。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261003-%E6%99%AE%E4%BA%AC%E5%91%BC%E5%90%81%E6%97%A5%E4%BF%84%E5%8F%8B%E5%A5%BD-%E6%97%A5%E6%9C%AC%E8%A1%A8%E7%A4%BA%E7%95%99%E6%84%8F%E6%99%AE%E4%BA%AC%E5%8F%91%E8%A8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791024466000.webp","sourceId":"rfi"},{"id":1791016130000,"createdDate":"2026-10-03 08:28","name":"法国国际广播电台","title":"朝韩非军事区地雷事件关系紧张之际 朝鲜再射弹道导弹","content":"韩国和日本表示，朝鲜周六（10月3日）再度向其东海发射了一枚弹道导弹，这是朝鲜今年以来最15次导弹发射。朝韩关系近期正因非军事区地雷爆炸事件紧张升级，金正恩的妹妹金与正前一日驳斥了韩方有关平壤道歉的要求。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261003-%E6%9C%9D%E9%9F%A9%E9%9D%9E%E5%86%9B%E4%BA%8B%E5%8C%BA%E5%9C%B0%E9%9B%B7%E4%BA%8B%E4%BB%B6%E5%85%B3%E7%B3%BB%E7%B4%A7%E5%BC%A0%E4%B9%8B%E9%99%85-%E6%9C%9D%E9%B2%9C%E5%86%8D%E5%B0%84%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791016130000.webp","sourceId":"rfi"},{"id":1791045496000,"createdDate":"2026-10-03 16:38","name":"法国国际广播电台","title":"俄罗斯再次袭击基辅一座大桥 再次呼吁外国人离开","content":"周六，基辅再有一座大型桥梁遭袭。莫斯科再呼吁基辅的外交官和外国人撤离，并警告称，俄军将继续对基辅发动“大规模报复性打击”——该市过去数周已反复成为俄军袭击目标。泽连斯基说，这个冬天对我们来说可能会非常艰难。但我们别无选择，只能让俄罗斯也过得难受”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261003-%E4%BF%84%E7%BD%97%E6%96%AF%E5%86%8D%E6%AC%A1%E8%A2%AD%E5%87%BB%E5%9F%BA%E8%BE%85%E4%B8%80%E5%BA%A7%E5%A4%A7%E6%A1%A5-%E5%86%8D%E6%AC%A1%E5%91%BC%E5%90%81%E5%A4%96%E5%9B%BD%E4%BA%BA%E7%A6%BB%E5%BC%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791045496000.webp","sourceId":"rfi"},{"id":1791042524000,"createdDate":"2026-10-03 15:48","name":"法国国际广播电台","title":"泽连斯基请求特朗普阻断俄中卫星企业与马斯克“星链”的竞争","content":"金融时报10月3日报道，乌克兰总统泽连斯基表示，他已请求美国总统特朗普对俄罗斯和中国一些企业实施制裁，因为这些企业参与开发与马斯克的“星链”（Starlink）竞争的卫星网。他警告称，这一能力将使克里姆林宫能够提高空袭的精准度。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261003-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%AF%B7%E6%B1%82%E7%89%B9%E6%9C%97%E6%99%AE%E9%98%BB%E6%96%AD%E4%BF%84%E4%B8%AD%E5%8D%AB%E6%98%9F%E4%BC%81%E4%B8%9A%E4%B8%8E%E9%A9%AC%E6%96%AF%E5%85%8B-%E6%98%9F%E9%93%BE-%E7%9A%84%E7%AB%9E%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791042524000.webp","sourceId":"rfi"},{"id":1791036287000,"createdDate":"2026-10-03 14:04","name":"法国国际广播电台","title":"七国集团释放1亿桶柴油和原油应对能源危机 特朗普称是他提出的请求","content":"七国集团（G7）领导人周五达成协议，同意在四个月内释放多达1亿桶柴油和原油，并且不禁止成员国之间的出口，以此缓解燃料价格上涨的压力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261003-%E4%B8%83%E5%9B%BD%E9%9B%86%E5%9B%A2%E9%87%8A%E6%94%BE1%E4%BA%BF%E6%A1%B6%E6%9F%B4%E6%B2%B9%E5%92%8C%E5%8E%9F%E6%B2%B9%E5%BA%94%E5%AF%B9%E8%83%BD%E6%BA%90%E5%8D%B1%E6%9C%BA-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%98%AF%E4%BB%96%E6%8F%90%E5%87%BA%E7%9A%84%E8%AF%B7%E6%B1%82","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791036287000.webp","sourceId":"rfi"},{"id":1791031107000,"createdDate":"2026-10-03 12:38","name":"法国国际广播电台","title":"许成钢：欧中之争关键在制度根本不同","content":"许成钢教授担任美国斯坦福大学中国经济和制度研究中心的资深研究员，也是美国科思研究所的理事和欧洲经济政治研究中心的研究员。欧盟委员会主席冯德莱恩在9月16日于斯特拉斯堡的欧洲议会发表年度咨文，谈及欧洲与中国关系也属于欧盟的重要议题。冯德莱恩表示对华贸易的逆差每天高达10亿欧元，对于欧洲来说已经达到了临界点，那么欧洲将采取什么措施来应对中国与欧洲之间的贸易逆差呢？请听法广就欧中关系问题专访许成钢教授。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E6%AC%A7%E6%B4%B2/20261003-%E8%AE%B8%E6%88%90%E9%92%A2-%E6%AC%A7%E4%B8%AD%E4%B9%8B%E4%BA%89%E5%85%B3%E9%94%AE%E5%9C%A8%E5%88%B6%E5%BA%A6%E6%A0%B9%E6%9C%AC%E4%B8%8D%E5%90%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791031107000.webp","sourceId":"rfi"},{"id":1791029038000,"createdDate":"2026-10-03 12:03","name":"法国国际广播电台","title":"俄乌战争持续 俄罗斯将削减社会支出并提升国防预算26%","content":"随着俄乌战争即将进入第五年，并持续消耗俄乌两国庞大资源，俄罗斯政府近期向国会提交最新版本预算草案，俄罗斯计划明年国防开支增加26%，达到1810亿欧元，同时削减社会支出。另外今天俄罗斯的无人机再次空袭乌克兰基辅的一座新建大桥，造成乌克兰首都交通瘫痪。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261003-%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%89%E6%8C%81%E7%BB%AD-%E4%BF%84%E7%BD%97%E6%96%AF%E5%B0%86%E5%89%8A%E5%87%8F%E7%A4%BE%E4%BC%9A%E6%94%AF%E5%87%BA%E5%B9%B6%E6%8F%90%E5%8D%87%E5%9B%BD%E9%98%B2%E9%A2%84%E7%AE%9726","thumbnail":"","detailImage":"news/detail/rfi/2026/10/03/1791029038000.webp","sourceId":"rfi"}]