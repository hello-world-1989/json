[{"id":1792237936000,"createdDate":"2026-10-17 11:52","name":"法国国际广播电台","title":"乌外长：我们与中国之间有许多议题需要探讨，从和平努力到双边贸易","content":"乌克兰外交部长瑟比加（AndriiSybiha）近日在出席2026年华沙安全论坛（10月12日至13日）期间接受乌通社采访时表示，他已收到访华的邀请，但访华日期尚未确定。瑟比加还指出，期待中方发挥更积极的作用，并表示“我们相信北京能够发挥非常有效的作用”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E4%B9%8C%E5%A4%96%E9%95%BF-%E6%88%91%E4%BB%AC%E4%B8%8E%E4%B8%AD%E5%9B%BD%E4%B9%8B%E9%97%B4%E6%9C%89%E8%AE%B8%E5%A4%9A%E8%AE%AE%E9%A2%98%E9%9C%80%E8%A6%81%E6%8E%A2%E8%AE%A8%EF%BC%8C%E4%BB%8E%E5%92%8C%E5%B9%B3%E5%8A%AA%E5%8A%9B%E5%88%B0%E5%8F%8C%E8%BE%B9%E8%B4%B8%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792237936000.webp","sourceId":"rfi"},{"id":1792234043000,"createdDate":"2026-10-17 10:47","name":"法国国际广播电台","title":"美国务院更新对前往中国大陆的旅行警告 凸出“非法拘押”风险","content":"据旗语新闻社所见的一份新计划，美国国务院正着手更新针对中国大陆的旅行警告，将“非法拘押”（wrongfuldetention）的风险等级调高。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2%E6%9B%B4%E6%96%B0%E5%AF%B9%E5%89%8D%E5%BE%80%E4%B8%AD%E5%9B%BD%E5%A4%A7%E9%99%86%E7%9A%84%E6%97%85%E8%A1%8C%E8%AD%A6%E5%91%8A-%E5%87%B8%E5%87%BA-%E9%9D%9E%E6%B3%95%E6%8B%98%E6%8A%BC-%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792234043000.webp","sourceId":"rfi"},{"id":1792232245000,"createdDate":"2026-10-17 10:17","name":"法国国际广播电台","title":"挪威军演士兵发现中国产汽车拍摄军事设施密码等敏感信息引安全担忧","content":"在挪威上月的一次军事演习中，中国制造的汽车被发现拍摄了敏感信息，其中包括军事设施的入口密码以及人员动向，这引发了人们对联网汽车所带来的风险的担忧。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261017-%E6%8C%AA%E5%A8%81%E5%86%9B%E6%BC%94%E5%A3%AB%E5%85%B5%E5%8F%91%E7%8E%B0%E4%B8%AD%E5%9B%BD%E4%BA%A7%E6%B1%BD%E8%BD%A6%E6%8B%8D%E6%91%84%E5%86%9B%E4%BA%8B%E8%AE%BE%E6%96%BD%E5%AF%86%E7%A0%81%E7%AD%89%E6%95%8F%E6%84%9F%E4%BF%A1%E6%81%AF%E5%BC%95%E5%AE%89%E5%85%A8%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792232245000.webp","sourceId":"rfi"},{"id":1792231273000,"createdDate":"2026-10-17 10:01","name":"法国国际广播电台","title":"德国部长寻求债务刹车机制豁免，以维持对乌援助","content":"路透社10月17日消息，德国发展部宣布，正寻求维持援助乌克兰的资金，为此将设法获得德国债务刹车机制的豁免。德国的债务刹车机制是对政府借款而设立的宪法限制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E5%BE%B7%E5%9B%BD%E9%83%A8%E9%95%BF%E5%AF%BB%E6%B1%82%E5%80%BA%E5%8A%A1%E5%88%B9%E8%BD%A6%E6%9C%BA%E5%88%B6%E8%B1%81%E5%85%8D%EF%BC%8C%E4%BB%A5%E7%BB%B4%E6%8C%81%E5%AF%B9%E4%B9%8C%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792231273000.webp","sourceId":"rfi"},{"id":1792230704000,"createdDate":"2026-10-17 09:51","name":"法国国际广播电台","title":"法国多地爆发抗议示威 青年与黄背心再聚焦民生问题","content":"法国多地周六举行抗议示威和封锁行动。前黄背心运动的参与者、高中生、大学生、气候活动人士以及农民走上街头，抗议生活成本持续高企，并要求改善教育条件、保障公共服务和提高工资。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261017-%E6%B3%95%E5%9B%BD%E5%A4%9A%E5%9C%B0%E7%88%86%E5%8F%91%E6%8A%97%E8%AE%AE%E7%A4%BA%E5%A8%81-%E9%9D%92%E5%B9%B4%E4%B8%8E%E9%BB%84%E8%83%8C%E5%BF%83%E5%86%8D%E8%81%9A%E7%84%A6%E6%B0%91%E7%94%9F%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792230704000.webp","sourceId":"rfi"},{"id":1792229996000,"createdDate":"2026-10-17 09:39","name":"法国国际广播电台","title":"冯德莱恩：在电动车和混动车取得的进展，并不能解决欧中贸易决结构性失衡","content":"欧盟委员会主席冯德莱恩（UrsulavonderLeyen）周五表示，成员国领导人一致认为，欧盟对华巨额贸易逆差和失衡的情况不能再继续下去了；因此，欧盟需要围绕“三个不同的支柱”采取行动。这些措施的范围将超过此前与北京方面达成的就混合动力汽车的保障措施——即旨在将中国混合动力汽车的进口量削减一半的安排。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261017-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E5%9C%A8%E7%94%B5%E5%8A%A8%E8%BD%A6%E5%92%8C%E6%B7%B7%E5%8A%A8%E8%BD%A6%E5%8F%96%E5%BE%97%E7%9A%84%E8%BF%9B%E5%B1%95%EF%BC%8C%E5%B9%B6%E4%B8%8D%E8%83%BD%E8%A7%A3%E6%AC%A7%E4%B8%AD%E8%B4%B8%E6%98%93%E5%86%B3%E7%BB%93%E6%9E%84%E6%80%A7%E5%A4%B1%E8%A1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792229996000.webp","sourceId":"rfi"},{"id":1792227609000,"createdDate":"2026-10-17 09:00","name":"法国国际广播电台","title":"高市早苗向靖国神社奉献供品  是否已遥拜不肯透露","content":"高市早苗首相于17日，在东京九段北的靖国神社开始举行秋季例行大祭的第一天，以“内阁总理大臣高市早苗”的名义，向神社供奉了祭祀用品真榊（一种用于神道祭祀的供品）。据报道，考虑到韩国、中国等周边国家可能对此表示强烈反对，高市首相决定在截至19日的例行大祭期间不前往靖国神社参拜。17日，在高市内阁的阁僚中，负责增长战略的内阁大臣城内实参拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%90%91%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE%E5%A5%89%E7%8C%AE%E4%BE%9B%E5%93%81-%E6%98%AF%E5%90%A6%E5%B7%B2%E9%81%A5%E6%8B%9C%E4%B8%8D%E8%82%AF%E9%80%8F%E9%9C%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792227609000.webp","sourceId":"rfi"},{"id":1792255360000,"createdDate":"2026-10-17 16:42","name":"法国国际广播电台","title":"欧洲准备加强针对中国的贸易防御机制，先是汽车，现在是化工行业","content":"欢迎收听本期的法国报纸摘要。本期节目中，我们一如既往地为您首选与中国相关的话题做综述。费加罗报对中国的关注主要集中在两个话题：首先是中国邀请特朗普的（前）发言人再次访问中国，其次是中国考虑对人工智能技术实施出口管制。经济类回声报则大篇幅关注了欧洲准备加强针对中国的贸易防御，先是汽车，现在是化工行业。除此之外，10月17日本台订阅的法国主流日刊集中大篇幅关注与黄背心运动出现合流趋势的法国高中生运动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261017-%E6%AC%A7%E6%B4%B2%E5%87%86%E5%A4%87%E5%8A%A0%E5%BC%BA%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E7%9A%84%E8%B4%B8%E6%98%93%E9%98%B2%E5%BE%A1%E6%9C%BA%E5%88%B6%EF%BC%8C%E5%85%88%E6%98%AF%E6%B1%BD%E8%BD%A6%EF%BC%8C%E7%8E%B0%E5%9C%A8%E6%98%AF%E5%8C%96%E5%B7%A5%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792255360000.webp","sourceId":"rfi"},{"id":1792253039000,"createdDate":"2026-10-17 16:03","name":"法国国际广播电台","title":"白宫和马斯克互踢皮球 泽连斯基指对SpaceX卫星系统的使用仍部分受限","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）在受访时表示，尽管本周早些时候曾出现全面恢复的迹象，但乌方对马斯克旗下SpaceX卫星系统的使用仍受到部分限制。泽连斯基介绍称，目前的限制措施阻碍了乌军利用无人机拦截俄罗斯的攻击型无人机，也妨碍了乌军利用无人机向前线士兵运送补给。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E7%99%BD%E5%AE%AB%E5%92%8C%E9%A9%AC%E6%96%AF%E5%85%8B%E4%BA%92%E8%B8%A2%E7%9A%AE%E7%90%83-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8C%87%E5%AF%B9spacex%E5%8D%AB%E6%98%9F%E7%B3%BB%E7%BB%9F%E7%9A%84%E4%BD%BF%E7%94%A8%E4%BB%8D%E9%83%A8%E5%88%86%E5%8F%97%E9%99%90","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792253039000.webp","sourceId":"rfi"},{"id":1792251293000,"createdDate":"2026-10-17 15:34","name":"法国国际广播电台","title":"泽连斯基：制裁豁免还将继续令人遗憾，俄方想在白俄境内部署弹道导弹","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周六表示，认为美方会进一步豁免对俄罗斯的制裁，并称美国总统特朗普（DonaldTrump）此举无异于是在“奖赏”俄总统普京。周五，特朗普签署了一项行政令，豁免了美国针对俄罗斯能源收入实施的广泛制裁，此举加剧了他与泽连斯基之间的矛盾。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261017-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E5%88%B6%E8%A3%81%E8%B1%81%E5%85%8D%E8%BF%98%E5%B0%86%E7%BB%A7%E7%BB%AD%E4%BB%A4%E4%BA%BA%E9%81%97%E6%86%BE%EF%BC%8C%E4%BF%84%E6%96%B9%E6%83%B3%E5%9C%A8%E7%99%BD%E4%BF%84%E5%A2%83%E5%86%85%E9%83%A8%E7%BD%B2%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792251293000.webp","sourceId":"rfi"},{"id":1792250729000,"createdDate":"2026-10-17 15:25","name":"法国国际广播电台","title":"中国年轻世代卷起一股由下而上的毛泽东崇拜：「伟人有很多，教员只有一个」","content":"近来中国网路社群吹起一股「毛泽东热」，这位在1976年去世的共产党前最高领导人，如今被中国Ｚ世代称为「教员」。甚至重新捧起手中的《毛泽东选集》，但这背后的原因其实反应了他们对现实的压抑与反资本的情绪。而这股毛泽东崇拜更凑且碰上其逝世50周年之际，值得让人一探究竟。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261017-%E4%B8%AD%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%B8%96%E4%BB%A3%E5%8D%B7%E8%B5%B7%E4%B8%80%E8%82%A1%E7%94%B1%E4%B8%8B%E8%80%8C%E4%B8%8A%E7%9A%84%E6%AF%9B%E6%B3%BD%E4%B8%9C%E5%B4%87%E6%8B%9C-%E4%BC%9F%E4%BA%BA%E6%9C%89%E5%BE%88%E5%A4%9A%EF%BC%8C%E6%95%99%E5%91%98%E5%8F%AA%E6%9C%89%E4%B8%80%E4%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792250729000.webp","sourceId":"rfi"},{"id":1792247306000,"createdDate":"2026-10-17 14:28","name":"法国国际广播电台","title":"美官员本周在曼谷就万事达卡和花旗集团的市场准入向中方施压","content":"据一位美国财政部官员透露，本周在曼谷举行的至少两次双边会晤中，美国官员曾就万事达卡公司和花旗集团的市场准入问题向中方官员施压。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261017-%E7%BE%8E%E5%AE%98%E5%91%98%E6%9C%AC%E5%91%A8%E5%9C%A8%E6%9B%BC%E8%B0%B7%E5%B0%B1%E4%B8%87%E4%BA%8B%E8%BE%BE%E5%8D%A1%E5%92%8C%E8%8A%B1%E6%97%97%E9%9B%86%E5%9B%A2%E7%9A%84%E5%B8%82%E5%9C%BA%E5%87%86%E5%85%A5%E5%90%91%E4%B8%AD%E6%96%B9%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792247306000.webp","sourceId":"rfi"},{"id":1792245296000,"createdDate":"2026-10-17 13:54","name":"法国国际广播电台","title":"日政府考虑提高法人税筹措防卫费财源 防卫费或攀至每年逾10万亿日元","content":"据悉，围绕旨在加强防卫力的“安保三文件”修订工作，日本执政阵营内部出现了针对企业的法人税进一步增税的方案，旨在为预计将大幅增加的防卫费筹措财源。多位相关人士于周六透露了这一消息。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261017-%E6%97%A5%E6%94%BF%E5%BA%9C%E8%80%83%E8%99%91%E8%BF%BD%E5%8A%A0%E6%B3%95%E4%BA%BA%E7%A8%8E%E7%AD%B9%E6%8E%AA%E9%98%B2%E5%8D%AB%E8%B4%B9%E8%B4%A2%E6%BA%90-%E9%98%B2%E5%8D%AB%E8%B4%B9%E8%A7%84%E6%A8%A1%E6%88%96%E6%94%80%E8%87%B3%E6%AF%8F%E5%B9%B4%E9%80%BE10%E4%B8%87%E4%BA%BF%E6%97%A5%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792245296000.webp","sourceId":"rfi"},{"id":1792242696000,"createdDate":"2026-10-17 13:11","name":"法国国际广播电台","title":"比利时首相谈欧盟对华贸易态度转变：大家都陷入赤字，反而促成共识","content":"比利时首相德韦弗（BartDeWever）周四晚间表示，比利时制药行业必须得到保护——这并非因为该行业存在竞争力问题，而是出于美国和中国所采取的态度。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261017-%E6%AF%94%E5%88%A9%E6%97%B6%E9%A6%96%E7%9B%B8%E8%B0%88%E6%AC%A7%E7%9B%9F%E5%AF%B9%E5%8D%8E%E8%B4%B8%E6%98%93%E6%80%81%E5%BA%A6%E8%BD%AC%E5%8F%98-%E6%88%96%E8%AE%B8%E5%A4%A7%E5%AE%B6%E9%83%BD%E9%99%B7%E5%85%A5%E8%B5%A4%E5%AD%97%EF%BC%8C%E5%8F%8D%E4%BF%83%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792242696000.webp","sourceId":"rfi"},{"id":1792239186000,"createdDate":"2026-10-17 12:13","name":"法国国际广播电台","title":"特朗普暂停部分对俄新制裁 莫斯科基辅一家欢乐一家愁","content":"美国对俄罗斯的制裁政策，再次出现重大转折。美国总统特朗普周五签署行政令，根据俗称《格雷厄姆制裁俄罗斯和伊朗法案》中的豁免条款，暂停实施其中多项对俄制裁措施。消息传出后，普京的经济顾问称，这是一个“重要且真正具有历史意义的时刻”。而乌克兰总统泽连斯基则对此予以谴责，称这是对普京的“奖赏”，也是对他继续实施“侵略”行为的“鼓励”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261017-%E7%89%B9%E6%9C%97%E6%99%AE%E6%9A%82%E5%81%9C%E9%83%A8%E5%88%86%E5%AF%B9%E4%BF%84%E6%96%B0%E5%88%B6%E8%A3%81-%E8%8E%AB%E6%96%AF%E7%A7%91%E5%9F%BA%E8%BE%85%E4%B8%80%E5%AE%B6%E6%AC%A2%E4%B9%90%E4%B8%80%E5%AE%B6%E6%84%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792239186000.webp","sourceId":"rfi"}]