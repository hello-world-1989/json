[{"id":1792237936000,"createdDate":"2026-10-17 11:52","name":"法国国际广播电台","title":"乌外长：我们与中国之间有许多议题需要探讨，从和平努力到双边贸易","content":"乌克兰外交部长瑟比加（AndriiSybiha）近日在出席2026年华沙安全论坛（10月12日至13日）期间接受乌通社采访时表示，他已收到访华的邀请，但访华日期尚未确定。瑟比加还指出，期待中方发挥更积极的作用，并表示“我们相信北京能够发挥非常有效的作用”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E4%B9%8C%E5%A4%96%E9%95%BF-%E6%88%91%E4%BB%AC%E4%B8%8E%E4%B8%AD%E5%9B%BD%E4%B9%8B%E9%97%B4%E6%9C%89%E8%AE%B8%E5%A4%9A%E8%AE%AE%E9%A2%98%E9%9C%80%E8%A6%81%E6%8E%A2%E8%AE%A8%EF%BC%8C%E4%BB%8E%E5%92%8C%E5%B9%B3%E5%8A%AA%E5%8A%9B%E5%88%B0%E5%8F%8C%E8%BE%B9%E8%B4%B8%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792237936000.webp","sourceId":"rfi"},{"id":1792234043000,"createdDate":"2026-10-17 10:47","name":"法国国际广播电台","title":"美国务院更新对前往中国大陆的旅行警告 凸出“非法拘押”风险","content":"据旗语新闻社所见的一份新计划，美国国务院正着手更新针对中国大陆的旅行警告，将“非法拘押”（wrongfuldetention）的风险等级调高。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2%E6%9B%B4%E6%96%B0%E5%AF%B9%E5%89%8D%E5%BE%80%E4%B8%AD%E5%9B%BD%E5%A4%A7%E9%99%86%E7%9A%84%E6%97%85%E8%A1%8C%E8%AD%A6%E5%91%8A-%E5%87%B8%E5%87%BA-%E9%9D%9E%E6%B3%95%E6%8B%98%E6%8A%BC-%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792234043000.webp","sourceId":"rfi"},{"id":1792232245000,"createdDate":"2026-10-17 10:17","name":"法国国际广播电台","title":"挪威军演士兵发现中国产汽车拍摄军事设施密码等敏感信息引安全担忧","content":"在挪威上月的一次军事演习中，中国制造的汽车被发现拍摄了敏感信息，其中包括军事设施的入口密码以及人员动向，这引发了人们对联网汽车所带来的风险的担忧。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261017-%E6%8C%AA%E5%A8%81%E5%86%9B%E6%BC%94%E5%A3%AB%E5%85%B5%E5%8F%91%E7%8E%B0%E4%B8%AD%E5%9B%BD%E4%BA%A7%E6%B1%BD%E8%BD%A6%E6%8B%8D%E6%91%84%E5%86%9B%E4%BA%8B%E8%AE%BE%E6%96%BD%E5%AF%86%E7%A0%81%E7%AD%89%E6%95%8F%E6%84%9F%E4%BF%A1%E6%81%AF%E5%BC%95%E5%AE%89%E5%85%A8%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792232245000.webp","sourceId":"rfi"},{"id":1792231273000,"createdDate":"2026-10-17 10:01","name":"法国国际广播电台","title":"德国部长寻求债务刹车机制豁免，以维持对乌援助","content":"路透社10月17日消息，德国发展部宣布，正寻求维持援助乌克兰的资金，为此将设法获得德国债务刹车机制的豁免。德国的债务刹车机制是对政府借款而设立的宪法限制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E5%BE%B7%E5%9B%BD%E9%83%A8%E9%95%BF%E5%AF%BB%E6%B1%82%E5%80%BA%E5%8A%A1%E5%88%B9%E8%BD%A6%E6%9C%BA%E5%88%B6%E8%B1%81%E5%85%8D%EF%BC%8C%E4%BB%A5%E7%BB%B4%E6%8C%81%E5%AF%B9%E4%B9%8C%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792231273000.webp","sourceId":"rfi"},{"id":1792230704000,"createdDate":"2026-10-17 09:51","name":"法国国际广播电台","title":"法国多地爆发抗议示威 青年与黄背心再聚焦民生问题","content":"法国多地周六举行抗议示威和封锁行动。前黄背心运动的参与者、高中生、大学生、气候活动人士以及农民走上街头，抗议生活成本持续高企，并要求改善教育条件、保障公共服务和提高工资。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261017-%E6%B3%95%E5%9B%BD%E5%A4%9A%E5%9C%B0%E7%88%86%E5%8F%91%E6%8A%97%E8%AE%AE%E7%A4%BA%E5%A8%81-%E9%9D%92%E5%B9%B4%E4%B8%8E%E9%BB%84%E8%83%8C%E5%BF%83%E5%86%8D%E8%81%9A%E7%84%A6%E6%B0%91%E7%94%9F%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792230704000.webp","sourceId":"rfi"},{"id":1792229996000,"createdDate":"2026-10-17 09:39","name":"法国国际广播电台","title":"冯德莱恩：在电动车和混动车取得的进展，并不能解决欧中贸易决结构性失衡","content":"欧盟委员会主席冯德莱恩（UrsulavonderLeyen）周五表示，成员国领导人一致认为，欧盟对华巨额贸易逆差和失衡的情况不能再继续下去了；因此，欧盟需要围绕“三个不同的支柱”采取行动。这些措施的范围将超过此前与北京方面达成的就混合动力汽车的保障措施——即旨在将中国混合动力汽车的进口量削减一半的安排。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261017-%E5%86%AF%E5%BE%B7%E8%8E%B1%E6%81%A9-%E5%9C%A8%E7%94%B5%E5%8A%A8%E8%BD%A6%E5%92%8C%E6%B7%B7%E5%8A%A8%E8%BD%A6%E5%8F%96%E5%BE%97%E7%9A%84%E8%BF%9B%E5%B1%95%EF%BC%8C%E5%B9%B6%E4%B8%8D%E8%83%BD%E8%A7%A3%E6%AC%A7%E4%B8%AD%E8%B4%B8%E6%98%93%E5%86%B3%E7%BB%93%E6%9E%84%E6%80%A7%E5%A4%B1%E8%A1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792229996000.webp","sourceId":"rfi"},{"id":1792227609000,"createdDate":"2026-10-17 09:00","name":"法国国际广播电台","title":"高市早苗向靖国神社奉献供品  是否已遥拜不肯透露","content":"高市早苗首相于17日，在东京九段北的靖国神社开始举行秋季例行大祭的第一天，以“内阁总理大臣高市早苗”的名义，向神社供奉了祭祀用品真榊（一种用于神道祭祀的供品）。据报道，考虑到韩国、中国等周边国家可能对此表示强烈反对，高市首相决定在截至19日的例行大祭期间不前往靖国神社参拜。17日，在高市内阁的阁僚中，负责增长战略的内阁大臣城内实参拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261017-%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%90%91%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE%E5%A5%89%E7%8C%AE%E4%BE%9B%E5%93%81-%E6%98%AF%E5%90%A6%E5%B7%B2%E9%81%A5%E6%8B%9C%E4%B8%8D%E8%82%AF%E9%80%8F%E9%9C%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/17/1792227609000.webp","sourceId":"rfi"}]