[{"id":1791729442000,"createdDate":"2026-10-11 14:37","name":"法国国际广播电台","title":"泽连斯基喊话特朗普：请转告普京给我们60天全面停火，我们就会组织选举","content":"针对美国总统特朗普周六声称“乌克兰是时候换新总统了”的言论，乌克兰总统泽连斯基周日在受访时表示，如果俄罗斯总统普京同意停火60天，乌克兰便可以举行选举。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%96%8A%E8%AF%9D%E7%89%B9%E6%9C%97%E6%99%AE-%E8%AF%B7%E8%BD%AC%E5%91%8A%E6%99%AE%E4%BA%AC%E7%BB%99%E6%88%91%E4%BB%AC60%E5%A4%A9%E5%85%A8%E9%9D%A2%E5%81%9C%E7%81%AB%EF%BC%8C%E6%88%91%E4%BB%AC%E5%B0%B1%E4%BC%9A%E7%BB%84%E7%BB%87%E9%80%89%E4%B8%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791729442000.webp","sourceId":"rfi"},{"id":1791728027000,"createdDate":"2026-10-11 14:13","name":"法国国际广播电台","title":"SK集团会长崔泰源：中美企业以更快速度扩大产能，我们需要迅速扩张","content":"韩国SK集团会长崔泰源周日就湖南（位于韩国西南部）半导体集群项目表示：“我们也需要尽快采取行动”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261011-sk%E9%9B%86%E5%9B%A2%E4%BC%9A%E9%95%BF%E5%B4%94%E6%B3%B0%E6%BA%90-%E4%B8%AD%E7%BE%8E%E4%BC%81%E4%B8%9A%E4%BB%A5%E6%9B%B4%E5%BF%AB%E9%80%9F%E5%BA%A6%E6%89%A9%E5%A4%A7%E4%BA%A7%E8%83%BD%EF%BC%8C%E6%88%91%E4%BB%AC%E9%9C%80%E8%A6%81%E8%BF%85%E9%80%9F%E6%89%A9%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791728027000.webp","sourceId":"rfi"},{"id":1791726455000,"createdDate":"2026-10-11 13:47","name":"法国国际广播电台","title":"美F-35战机零件运抵香港 因一封未读邮件引起的严重失误？","content":"标注日期为10月11至12号的周法国《世界报》头版头条聚焦：美俄签署的柴油供应协议引发的震荡。其他头版新闻关注的国际新闻还包括，美国国防部长皮特·赫格塞斯令人震惊地宣布，将在互联网上现场直播2009年德克萨斯州胡德堡恐怖袭击事件的罪魁祸首将于12月3日下午1点被士兵处决的画面；加沙停火一年后，既没有和平也没有重建，这块巴勒斯坦飞地的居民依然生活在废墟中；经济主题关注的，各国如何利用其主权财富基金和16万亿美元资产扩大影响力：报道称，二十年来，这些基金的资产增以及长了五倍多，已成为全球化国家资本主义回归的象征；头版对法国国内新闻关注依然聚焦总统选战前几个重要候选人动向，也继续关注法国高中生抗议活动等。这些主题在报纸内文均有非常详细的报道和分析。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261011-%E7%BE%8Ef35%E6%88%98%E6%9C%BA%E9%9B%B6%E4%BB%B6%E8%BF%90%E6%8A%B5%E9%A6%99%E6%B8%AF-%E5%9B%A0%E4%B8%80%E5%B0%81%E6%9C%AA%E8%AF%BB%E9%82%AE%E4%BB%B6%E5%BC%95%E8%B5%B7%E7%9A%84%E4%B8%A5%E9%87%8D%E5%A4%B1%E8%AF%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791726455000.webp","sourceId":"rfi"},{"id":1791724627000,"createdDate":"2026-10-11 13:17","name":"法国国际广播电台","title":"面对特朗普压力 泽连斯基指任何缓和局势步骤都须对等 德外长重申支持","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周日提出，如果俄方停止对乌克兰能源基础设施的袭击，乌方也准备停止对俄罗斯炼油厂的攻击；此前，美国总统特朗普（DonaldTrump）曾要求乌方单方面停止袭击俄罗斯炼油厂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E9%9D%A2%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E5%8E%8B%E5%8A%9B-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8C%87%E4%BB%BB%E4%BD%95%E7%BC%93%E5%92%8C%E5%B1%80%E5%8A%BF%E6%AD%A5%E9%AA%A4%E9%83%BD%E9%A1%BB%E5%AF%B9%E7%AD%89-%E5%BE%B7%E5%A4%96%E9%95%BF%E9%87%8D%E7%94%B3%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791724627000.webp","sourceId":"rfi"},{"id":1791724008000,"createdDate":"2026-10-11 13:06","name":"法国国际广播电台","title":"沙特利雅得机场遭袭 胡塞武装威胁再出手：中东战火会否进一步扩大？","content":"国际标准时间周六(10月10日星期六)中午左右，沙特利雅得机场遭到导弹袭击。这是沙特十多年来遭受的最严重的袭击事件，利雅得当局指责此举是也门的胡塞武装所为。据航空业消息人士透露，截至周日，利雅得国际机场的运营仍然暂停。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261011-%E6%B2%99%E7%89%B9%E5%88%A9%E9%9B%85%E5%BE%97%E6%9C%BA%E5%9C%BA%E9%81%AD%E8%A2%AD-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E5%A8%81%E8%83%81%E5%86%8D%E5%87%BA%E6%89%8B-%E4%B8%AD%E4%B8%9C%E6%88%98%E7%81%AB%E4%BC%9A%E5%90%A6%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791724008000.webp","sourceId":"rfi"},{"id":1791715251000,"createdDate":"2026-10-11 10:40","name":"法国国际广播电台","title":"总理及国防部长被指面临人身威胁 波兰安全部门召开特别会议","content":"波兰内政部发言人在社媒平台X上表示，在收到关于可能针对该国总理图斯克（DonaldTusk）和副总理兼国防部长科西尼亚克-卡梅什（WladyslawKosiniak-Kamysz）发动袭击的信息后，波兰安全部门于周日召开了一次特别会议。目前尚不清楚该威胁的具体性质及其来源。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%80%BB%E7%90%86%E5%8F%8A%E5%9B%BD%E9%98%B2%E9%83%A8%E9%95%BF%E8%A2%AB%E6%8C%87%E9%9D%A2%E4%B8%B4%E4%BA%BA%E8%BA%AB%E5%A8%81%E8%83%81-%E6%B3%A2%E5%85%B0%E5%AE%89%E5%85%A8%E9%83%A8%E9%97%A8%E5%8F%AC%E5%BC%80%E7%89%B9%E5%88%AB%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791715251000.webp","sourceId":"rfi"},{"id":1791714225000,"createdDate":"2026-10-11 10:23","name":"法国国际广播电台","title":"欧洲情报机构警告国防相关企业高管 指俄罗斯正加紧暗杀努力","content":"据悉，西方情报机构已向欧洲国防企业高管发出警告，称俄罗斯正加紧策划针对他们的暗杀努力，促使相关企业加强了对高层管理人员的安保措施。随着俄乌战场局势陷入僵局且国内经济步履维艰，克里姆林宫下令在欧洲扩大破坏活动及“混合战”行动，意图在未来数月内重创欧洲对乌克兰的支持。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%AC%A7%E6%B4%B2%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E8%AD%A6%E5%91%8A%E5%9B%BD%E9%98%B2%E7%9B%B8%E5%85%B3%E4%BC%81%E4%B8%9A%E9%AB%98%E7%AE%A1-%E7%A7%B0%E4%BF%84%E7%BD%97%E6%96%AF%E6%AD%A3%E5%8A%A0%E7%B4%A7%E6%9A%97%E6%9D%80%E5%8A%AA%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791714225000.webp","sourceId":"rfi"},{"id":1791713505000,"createdDate":"2026-10-11 10:11","name":"法国国际广播电台","title":"印度“蟑螂人民党”领导人获释 呼吁举行新一轮抗议","content":"印度当局周日释放了“蟑螂人民党”的创始人和另外两位领导人。这三人因计划抗议选民名册修订而遭逮捕，当局严厉镇压了这一抗议活动，但组织者目前正呼吁继续进行街头示威。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261011-%E5%8D%B0%E5%BA%A6-%E8%9F%91%E8%9E%82%E4%BA%BA%E6%B0%91%E5%85%9A-%E9%A2%86%E5%AF%BC%E4%BA%BA%E8%8E%B7%E9%87%8A-%E5%91%BC%E5%90%81%E4%B8%BE%E8%A1%8C%E6%96%B0%E4%B8%80%E8%BD%AE%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791713505000.webp","sourceId":"rfi"},{"id":1791711682000,"createdDate":"2026-10-11 09:41","name":"法国国际广播电台","title":"多名共和党议员反对特朗普的美俄柴油协议 民主党舒默批“与魔鬼做交易”","content":"美国共和党籍联邦众议员菲茨帕特里克（BrianFitzpatrick）周六宣布计划提出一项新的两党法案，旨在禁止购买所有俄罗斯石油；与此同时，共和党籍联邦众议员培根（DonBacon）等人表示，特朗普（DonaldTrump）总统决定购买俄罗斯柴油之举显得软弱。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261011-%E5%A4%9A%E5%90%8D%E5%85%B1%E5%92%8C%E5%85%9A%E8%AE%AE%E5%91%98%E5%8F%8D%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E7%BE%8E%E4%BF%84%E6%9F%B4%E6%B2%B9%E5%8D%8F%E8%AE%AE-%E6%B0%91%E4%B8%BB%E5%85%9A%E8%88%92%E9%BB%98%E6%89%B9-%E4%B8%8E%E9%AD%94%E9%AC%BC%E9%AD%94%E9%AC%BC%E5%81%9A%E4%BA%A4%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791711682000.webp","sourceId":"rfi"},{"id":1791710212000,"createdDate":"2026-10-11 09:16","name":"法国国际广播电台","title":"《纽约时报》：美国司法部就五个电视网络或涉反垄断法进行调查","content":"据《纽约时报》周六报道，美国司法部正在调查五家电视网，ABC、CBS、CNN、NBC和福克斯新闻（Foxnews），此前这几家新闻网曾短暂停止对特朗普总统的报道。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261011-%E7%BA%BD%E7%BA%A6%E6%97%B6%E6%8A%A5-%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E9%83%A8%E5%B0%B1%E4%BA%94%E4%B8%AA%E7%94%B5%E8%A7%86%E7%BD%91%E7%BB%9C%E6%88%96%E6%B6%89%E5%8F%8D%E5%9E%84%E6%96%AD%E6%B3%95%E8%BF%9B%E8%A1%8C%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791710212000.webp","sourceId":"rfi"},{"id":1791708424000,"createdDate":"2026-10-11 08:47","name":"法国国际广播电台","title":"日本外务大臣与美国国务卿及国际刑事法院院长通话","content":"据日本外务省消息，外务大臣茂木敏充于日本时间10日晚9时起，分别与国际刑事法院（ICC）院长赤根智子及美国国务卿卢比奥举行了电话会谈，卢比奥表针对美国制裁国际刑事法院一事表示：这是“那些威胁美国主权的流氓分子所采取的行动所导致的结果”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E5%A4%A7%E8%87%A3%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%8A%A1%E5%8D%BF%E5%8F%8A%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E9%99%A2%E9%95%BF%E9%80%9A%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791708424000.webp","sourceId":"rfi"}]