[{"id":1791729442000,"createdDate":"2026-10-11 14:37","name":"法国国际广播电台","title":"泽连斯基喊话特朗普：请转告普京给我们60天全面停火，我们就会组织选举","content":"针对美国总统特朗普周六声称“乌克兰是时候换新总统了”的言论，乌克兰总统泽连斯基周日在受访时表示，如果俄罗斯总统普京同意停火60天，乌克兰便可以举行选举。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%96%8A%E8%AF%9D%E7%89%B9%E6%9C%97%E6%99%AE-%E8%AF%B7%E8%BD%AC%E5%91%8A%E6%99%AE%E4%BA%AC%E7%BB%99%E6%88%91%E4%BB%AC60%E5%A4%A9%E5%85%A8%E9%9D%A2%E5%81%9C%E7%81%AB%EF%BC%8C%E6%88%91%E4%BB%AC%E5%B0%B1%E4%BC%9A%E7%BB%84%E7%BB%87%E9%80%89%E4%B8%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791729442000.webp","sourceId":"rfi"},{"id":1791728027000,"createdDate":"2026-10-11 14:13","name":"法国国际广播电台","title":"SK集团会长崔泰源：中美企业以更快速度扩大产能，我们需要迅速扩张","content":"韩国SK集团会长崔泰源周日就湖南（位于韩国西南部）半导体集群项目表示：“我们也需要尽快采取行动”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261011-sk%E9%9B%86%E5%9B%A2%E4%BC%9A%E9%95%BF%E5%B4%94%E6%B3%B0%E6%BA%90-%E4%B8%AD%E7%BE%8E%E4%BC%81%E4%B8%9A%E4%BB%A5%E6%9B%B4%E5%BF%AB%E9%80%9F%E5%BA%A6%E6%89%A9%E5%A4%A7%E4%BA%A7%E8%83%BD%EF%BC%8C%E6%88%91%E4%BB%AC%E9%9C%80%E8%A6%81%E8%BF%85%E9%80%9F%E6%89%A9%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791728027000.webp","sourceId":"rfi"},{"id":1791726455000,"createdDate":"2026-10-11 13:47","name":"法国国际广播电台","title":"美F-35战机零件运抵香港 因一封未读邮件引起的严重失误？","content":"标注日期为10月11至12号的周法国《世界报》头版头条聚焦：美俄签署的柴油供应协议引发的震荡。其他头版新闻关注的国际新闻还包括，美国国防部长皮特·赫格塞斯令人震惊地宣布，将在互联网上现场直播2009年德克萨斯州胡德堡恐怖袭击事件的罪魁祸首将于12月3日下午1点被士兵处决的画面；加沙停火一年后，既没有和平也没有重建，这块巴勒斯坦飞地的居民依然生活在废墟中；经济主题关注的，各国如何利用其主权财富基金和16万亿美元资产扩大影响力：报道称，二十年来，这些基金的资产增以及长了五倍多，已成为全球化国家资本主义回归的象征；头版对法国国内新闻关注依然聚焦总统选战前几个重要候选人动向，也继续关注法国高中生抗议活动等。这些主题在报纸内文均有非常详细的报道和分析。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261011-%E7%BE%8Ef35%E6%88%98%E6%9C%BA%E9%9B%B6%E4%BB%B6%E8%BF%90%E6%8A%B5%E9%A6%99%E6%B8%AF-%E5%9B%A0%E4%B8%80%E5%B0%81%E6%9C%AA%E8%AF%BB%E9%82%AE%E4%BB%B6%E5%BC%95%E8%B5%B7%E7%9A%84%E4%B8%A5%E9%87%8D%E5%A4%B1%E8%AF%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791726455000.webp","sourceId":"rfi"},{"id":1791724627000,"createdDate":"2026-10-11 13:17","name":"法国国际广播电台","title":"面对特朗普压力 泽连斯基指任何缓和局势步骤都须对等 德外长重申支持","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周日提出，如果俄方停止对乌克兰能源基础设施的袭击，乌方也准备停止对俄罗斯炼油厂的攻击；此前，美国总统特朗普（DonaldTrump）曾要求乌方单方面停止袭击俄罗斯炼油厂。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E9%9D%A2%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E5%8E%8B%E5%8A%9B-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8C%87%E4%BB%BB%E4%BD%95%E7%BC%93%E5%92%8C%E5%B1%80%E5%8A%BF%E6%AD%A5%E9%AA%A4%E9%83%BD%E9%A1%BB%E5%AF%B9%E7%AD%89-%E5%BE%B7%E5%A4%96%E9%95%BF%E9%87%8D%E7%94%B3%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791724627000.webp","sourceId":"rfi"},{"id":1791724008000,"createdDate":"2026-10-11 13:06","name":"法国国际广播电台","title":"沙特利雅得机场遭袭 胡塞武装威胁再出手：中东战火会否进一步扩大？","content":"国际标准时间周六(10月10日星期六)中午左右，沙特利雅得机场遭到导弹袭击。这是沙特十多年来遭受的最严重的袭击事件，利雅得当局指责此举是也门的胡塞武装所为。据航空业消息人士透露，截至周日，利雅得国际机场的运营仍然暂停。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261011-%E6%B2%99%E7%89%B9%E5%88%A9%E9%9B%85%E5%BE%97%E6%9C%BA%E5%9C%BA%E9%81%AD%E8%A2%AD-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E5%A8%81%E8%83%81%E5%86%8D%E5%87%BA%E6%89%8B-%E4%B8%AD%E4%B8%9C%E6%88%98%E7%81%AB%E4%BC%9A%E5%90%A6%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791724008000.webp","sourceId":"rfi"},{"id":1791715251000,"createdDate":"2026-10-11 10:40","name":"法国国际广播电台","title":"总理及国防部长被指面临人身威胁 波兰安全部门召开特别会议","content":"波兰内政部发言人在社媒平台X上表示，在收到关于可能针对该国总理图斯克（DonaldTusk）和副总理兼国防部长科西尼亚克-卡梅什（WladyslawKosiniak-Kamysz）发动袭击的信息后，波兰安全部门于周日召开了一次特别会议。目前尚不清楚该威胁的具体性质及其来源。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%80%BB%E7%90%86%E5%8F%8A%E5%9B%BD%E9%98%B2%E9%83%A8%E9%95%BF%E8%A2%AB%E6%8C%87%E9%9D%A2%E4%B8%B4%E4%BA%BA%E8%BA%AB%E5%A8%81%E8%83%81-%E6%B3%A2%E5%85%B0%E5%AE%89%E5%85%A8%E9%83%A8%E9%97%A8%E5%8F%AC%E5%BC%80%E7%89%B9%E5%88%AB%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791715251000.webp","sourceId":"rfi"},{"id":1791714225000,"createdDate":"2026-10-11 10:23","name":"法国国际广播电台","title":"欧洲情报机构警告国防相关企业高管 指俄罗斯正加紧暗杀努力","content":"据悉，西方情报机构已向欧洲国防企业高管发出警告，称俄罗斯正加紧策划针对他们的暗杀努力，促使相关企业加强了对高层管理人员的安保措施。随着俄乌战场局势陷入僵局且国内经济步履维艰，克里姆林宫下令在欧洲扩大破坏活动及“混合战”行动，意图在未来数月内重创欧洲对乌克兰的支持。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%AC%A7%E6%B4%B2%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E8%AD%A6%E5%91%8A%E5%9B%BD%E9%98%B2%E7%9B%B8%E5%85%B3%E4%BC%81%E4%B8%9A%E9%AB%98%E7%AE%A1-%E7%A7%B0%E4%BF%84%E7%BD%97%E6%96%AF%E6%AD%A3%E5%8A%A0%E7%B4%A7%E6%9A%97%E6%9D%80%E5%8A%AA%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791714225000.webp","sourceId":"rfi"},{"id":1791713505000,"createdDate":"2026-10-11 10:11","name":"法国国际广播电台","title":"印度“蟑螂人民党”领导人获释 呼吁举行新一轮抗议","content":"印度当局周日释放了“蟑螂人民党”的创始人和另外两位领导人。这三人因计划抗议选民名册修订而遭逮捕，当局严厉镇压了这一抗议活动，但组织者目前正呼吁继续进行街头示威。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261011-%E5%8D%B0%E5%BA%A6-%E8%9F%91%E8%9E%82%E4%BA%BA%E6%B0%91%E5%85%9A-%E9%A2%86%E5%AF%BC%E4%BA%BA%E8%8E%B7%E9%87%8A-%E5%91%BC%E5%90%81%E4%B8%BE%E8%A1%8C%E6%96%B0%E4%B8%80%E8%BD%AE%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791713505000.webp","sourceId":"rfi"},{"id":1791711682000,"createdDate":"2026-10-11 09:41","name":"法国国际广播电台","title":"多名共和党议员反对特朗普的美俄柴油协议 民主党舒默批“与魔鬼做交易”","content":"美国共和党籍联邦众议员菲茨帕特里克（BrianFitzpatrick）周六宣布计划提出一项新的两党法案，旨在禁止购买所有俄罗斯石油；与此同时，共和党籍联邦众议员培根（DonBacon）等人表示，特朗普（DonaldTrump）总统决定购买俄罗斯柴油之举显得软弱。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261011-%E5%A4%9A%E5%90%8D%E5%85%B1%E5%92%8C%E5%85%9A%E8%AE%AE%E5%91%98%E5%8F%8D%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E7%BE%8E%E4%BF%84%E6%9F%B4%E6%B2%B9%E5%8D%8F%E8%AE%AE-%E6%B0%91%E4%B8%BB%E5%85%9A%E8%88%92%E9%BB%98%E6%89%B9-%E4%B8%8E%E9%AD%94%E9%AC%BC%E9%AD%94%E9%AC%BC%E5%81%9A%E4%BA%A4%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791711682000.webp","sourceId":"rfi"},{"id":1791710212000,"createdDate":"2026-10-11 09:16","name":"法国国际广播电台","title":"《纽约时报》：美国司法部就五个电视网络或涉反垄断法进行调查","content":"据《纽约时报》周六报道，美国司法部正在调查五家电视网，ABC、CBS、CNN、NBC和福克斯新闻（Foxnews），此前这几家新闻网曾短暂停止对特朗普总统的报道。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261011-%E7%BA%BD%E7%BA%A6%E6%97%B6%E6%8A%A5-%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E9%83%A8%E5%B0%B1%E4%BA%94%E4%B8%AA%E7%94%B5%E8%A7%86%E7%BD%91%E7%BB%9C%E6%88%96%E6%B6%89%E5%8F%8D%E5%9E%84%E6%96%AD%E6%B3%95%E8%BF%9B%E8%A1%8C%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791710212000.webp","sourceId":"rfi"},{"id":1791708424000,"createdDate":"2026-10-11 08:47","name":"法国国际广播电台","title":"日本外务大臣与美国国务卿及国际刑事法院院长通话","content":"据日本外务省消息，外务大臣茂木敏充于日本时间10日晚9时起，分别与国际刑事法院（ICC）院长赤根智子及美国国务卿卢比奥举行了电话会谈，卢比奥表针对美国制裁国际刑事法院一事表示：这是“那些威胁美国主权的流氓分子所采取的行动所导致的结果”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E5%A4%A7%E8%87%A3%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%8A%A1%E5%8D%BF%E5%8F%8A%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E9%99%A2%E9%95%BF%E9%80%9A%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791708424000.webp","sourceId":"rfi"},{"id":1791750485000,"createdDate":"2026-10-11 20:28","name":"法国国际广播电台","title":"一移民船在吉布提外海倾覆 109人死亡 116人失踪","content":"联合国移民机构“国际移民组织”（IOM）周日（10月11日）表示，一艘载有305名移民的船只在吉布提109人死亡海岸附近倾覆，造成至少109人死亡，其中包括15名儿童。另有116人失踪。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261011-%E4%B8%80%E7%A7%BB%E6%B0%91%E8%88%B9%E5%9C%A8%E5%90%89%E5%B8%83%E6%8F%90%E5%A4%96%E6%B5%B7%E5%80%BE%E8%A6%86-109%E4%BA%BA%E6%AD%BB%E4%BA%A1-116%E4%BA%BA%E5%A4%B1%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791750485000.webp","sourceId":"rfi"},{"id":1791747928000,"createdDate":"2026-10-11 19:45","name":"法国国际广播电台","title":"爱丽舍宫设晚宴    中国车企或展商未受邀","content":"2026年10月13日至18日，全球车展将在巴黎凡尔赛门展览中心举行，12日总统将为此次车展揭幕。马克龙（EmmanuelMacron）11日晚在爱丽舍宫主持了一场高规格的晚宴。这场晚宴的核心在于保护和提振欧洲本土汽车产业，而中国汽车制造商被排除在晚宴受邀名单之外。爱丽舍宫指出：“现在的挑战是在欧洲层面巩固这些成果。面对日益激烈的国际竞争，欧洲最终必须支持自身的产业。”","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261011-%E7%88%B1%E4%B8%BD%E8%88%8D%E5%AE%AB%E8%AE%BE%E6%99%9A%E5%AE%B4-%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E6%88%96%E5%B1%95%E5%95%86%E6%9C%AA%E5%8F%97%E9%82%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791747928000.webp","sourceId":"rfi"},{"id":1791741821000,"createdDate":"2026-10-11 18:03","name":"法国国际广播电台","title":"《南德意志报》施罗德突破了最后一道羞耻底线","content":"德国前总理施罗德被任命为俄罗斯一家超市连锁店的监事会成员，前往俄罗斯，并拜访了俄罗斯总统普京，参加了普京的生日庆祝活动，为此受到德国媒体多方批评。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E5%8D%97%E5%BE%B7%E6%84%8F%E5%BF%97%E6%8A%A5-%E6%96%BD%E7%BD%97%E5%BE%B7%E7%AA%81%E7%A0%B4%E4%BA%86%E6%9C%80%E5%90%8E%E4%B8%80%E9%81%93%E7%BE%9E%E8%80%BB%E5%BA%95%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791741821000.webp","sourceId":"rfi"},{"id":1791735983000,"createdDate":"2026-10-11 16:26","name":"法国国际广播电台","title":"特朗普新任白宫发言人与北京渊源颇深","content":"美国总统特朗普（DonaldTrump）新任白宫发言人扎卡里亚（KatieZacharia）即将走上白宫记者会讲台，但她过去在中国工作的经历，以及多则遭删除的社群媒体贴文，已引起外界关注。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261011-%E7%89%B9%E6%9C%97%E6%99%AE%E6%96%B0%E4%BB%BB%E7%99%BD%E5%AE%AB%E5%8F%91%E8%A8%80%E4%BA%BA%E4%B8%8E%E5%8C%97%E4%BA%AC%E6%B8%8A%E6%BA%90%E9%A2%87%E6%B7%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791735983000.webp","sourceId":"rfi"},{"id":1791731610000,"createdDate":"2026-10-11 15:13","name":"法国国际广播电台","title":"特朗普称俄乌能源停火即刻生效，双方均已同意 泽连斯基：对我来说是条新闻","content":"美国总统特朗普周日在其社媒平台“真相社交”上发文称，“即刻起，俄乌战争中的能源停火生效。双方均已同意。切勿破坏！”对此，乌克兰总统泽连斯基则向Axios新闻网表示，这一宣布“对我来说是条新闻。但如果俄方同意能源停火，乌克兰也会同意”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%BF%84%E4%B9%8C%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB%E5%8D%B3%E5%88%BB%E7%94%9F%E6%95%88%EF%BC%8C%E5%8F%8C%E6%96%B9%E5%9D%87%E5%B7%B2%E5%90%8C%E6%84%8F-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E5%AF%B9%E6%88%91%E6%9D%A5%E8%AF%B4%E6%98%AF%E6%9D%A1%E6%96%B0%E9%97%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791731610000.webp","sourceId":"rfi"},{"id":1791753353000,"createdDate":"2026-10-11 21:15","name":"法国国际广播电台","title":"美议员：美俄柴油协议违法","content":"周日，民主党和共和党议员质疑华盛顿和莫斯科就俄罗斯柴油供应达成的协议的合法性，声称该协议违反了美国国会通过的一项法律。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261011-%E7%BE%8E%E8%AE%AE%E5%91%98-%E7%BE%8E%E4%BF%84%E6%9F%B4%E6%B2%B9%E5%8D%8F%E8%AE%AE%E8%BF%9D%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791753353000.webp","sourceId":"rfi"},{"id":1791752347000,"createdDate":"2026-10-11 20:59","name":"法国国际广播电台","title":"曾遭中制裁的格鲁克斯曼一轮赢得中左翼党内初选","content":"针对2027年法国总统大选，法国社会党（PS）与盟友（如“公共广场”党等）于2026年10月11日进行了党内初选第一轮投票。出人意外的是公民广场党创始人、欧洲议会议员格鲁克斯曼（RaphaëlGlucksmann）一轮“当选“，得票率为66.13%。他的竞选口号是：我是一名民主左翼候选人；能击败法国极右翼。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261011-%E6%9B%BE%E9%81%AD%E4%B8%AD%E5%88%B6%E8%A3%81%E7%9A%84%E6%A0%BC%E9%B2%81%E5%85%8B%E6%96%AF%E6%9B%BC%E4%B8%80%E8%BD%AE%E8%B5%A2%E5%BE%97%E4%B8%AD%E5%B7%A6%E7%BF%BC%E5%85%9A%E5%86%85%E5%88%9D%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791752347000.webp","sourceId":"rfi"},{"id":1791751969000,"createdDate":"2026-10-11 20:52","name":"法国国际广播电台","title":"马克龙：法支持“真正的能源停火”但俄“并未接受”","content":"美国总统特朗普11日称，即刻起，俄乌冲突进入“能源停火”状态。乌克兰总统泽连斯基当天回应说，“能源停火”对他来说也是个新闻。特朗普当天在社交媒体发文称，俄乌双方对此均已同意。他警告“切勿破坏”这一停火承诺。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E9%A9%AC%E5%85%8B%E9%BE%99-%E6%B3%95%E6%94%AF%E6%8C%81-%E7%9C%9F%E6%AD%A3%E7%9A%84%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB-%E4%BD%86%E4%BF%84-%E5%B9%B6%E6%9C%AA%E6%8E%A5%E5%8F%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791751969000.webp","sourceId":"rfi"},{"id":1791751404000,"createdDate":"2026-10-11 20:43","name":"法国国际广播电台","title":"英首相：俄干预了2016年的英国脱欧公投","content":"英国首相安迪·伯纳姆（AndyBurnham）在周日播出的一次采访中表示，俄罗斯干预了2016年的英国脱欧公投，并警告法国和德国警惕莫斯科试图影响其政治生活的企图。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E8%8B%B1%E9%A6%96%E7%9B%B8-%E4%BF%84%E5%B9%B2%E9%A2%84%E4%BA%862016%E5%B9%B4%E7%9A%84%E8%8B%B1%E5%9B%BD%E8%84%B1%E6%AC%A7%E5%85%AC%E6%8A%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791751404000.webp","sourceId":"rfi"},{"id":1791750612000,"createdDate":"2026-10-11 20:30","name":"法国国际广播电台","title":"外媒：中国第六代战斗机很可能抢占先机、领先于美国","content":"中国正力图在首款第六代战斗机的设计和部署方面超越美国：其庞大而令人印象深刻的歼-36原型机再次被发现飞行，似乎正在取得重大进展。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261011-%E5%A4%96%E5%AA%92-%E4%B8%AD%E5%9B%BD%E7%AC%AC%E5%85%AD%E4%BB%A3%E6%88%98%E6%96%97%E6%9C%BA%E5%BE%88%E5%8F%AF%E8%83%BD%E6%8A%A2%E5%8D%A0%E5%85%88%E6%9C%BA-%E9%A2%86%E5%85%88%E4%BA%8E%E7%BE%8E%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791750612000.webp","sourceId":"rfi"},{"id":1791749741000,"createdDate":"2026-10-11 20:15","name":"法国国际广播电台","title":"两名印度水手在阿曼附近海域遇袭后失踪","content":"新德里周日晚间宣布，一艘印度商船在阿曼海岸附近遭到袭击，两名印度船员失踪。印度海事部长萨尔巴南达·索诺瓦（SarbanandaSonowal）尔表示，载有11名印度船员的油轮“MTPetroDolphin”号遭到无人机袭击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261011-%E4%B8%A4%E5%90%8D%E5%8D%B0%E5%BA%A6%E6%B0%B4%E6%89%8B%E5%9C%A8%E9%98%BF%E6%9B%BC%E9%99%84%E8%BF%91%E6%B5%B7%E5%9F%9F%E9%81%87%E8%A2%AD%E5%90%8E%E5%A4%B1%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791749741000.webp","sourceId":"rfi"},{"id":1791749507000,"createdDate":"2026-10-11 20:11","name":"法国国际广播电台","title":"教宗良十四世肺部发现小结节    近日将动手术切除","content":"教宗良十四世周日宣布，他将在“未来几天”接受手术，切除肺部一个“局限于肺部”的结节。该结节是在“早期”发现的，这是他17个月繁忙的教宗任期内首次出现健康问题。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E8%82%BA%E9%83%A8%E5%8F%91%E7%8E%B0%E5%B0%8F%E7%BB%93%E8%8A%82-%E8%BF%91%E6%97%A5%E5%B0%86%E5%8A%A8%E6%89%8B%E6%9C%AF%E5%88%87%E9%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791749507000.webp","sourceId":"rfi"},{"id":1791749122000,"createdDate":"2026-10-11 20:05","name":"法国国际广播电台","title":"德经济部长“被困”利雅得机场     无法按时返回","content":"德国经济部长凯瑟琳娜·赖歇（KatherinaReiche）因利雅得机场发生致命袭击而滞留当地。此次袭击被指由也门胡塞武装发动。经济部长发言人周日告诉法新社，她将比原计划多停留一天，直至周二（10月13日）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261011-%E5%BE%B7%E7%BB%8F%E6%B5%8E%E9%83%A8%E9%95%BF-%E8%A2%AB%E5%9B%B0-%E5%88%A9%E9%9B%85%E5%BE%97%E6%9C%BA%E5%9C%BA-%E6%97%A0%E6%B3%95%E6%8C%89%E6%97%B6%E8%BF%94%E5%9B%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791749122000.webp","sourceId":"rfi"},{"id":1791748711000,"createdDate":"2026-10-11 19:58","name":"法国国际广播电台","title":"卡尼谴责与俄罗斯柴油交易","content":"加拿大总理马克·卡尼周日在与乌克兰总统弗拉基米尔·泽伦斯基通话时谴责了华盛顿和莫斯科之间关于交付俄罗斯柴油的协议，称该协议“直接违背了在乌克兰建立和平的努力”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261011-%E5%8D%A1%E5%B0%BC%E8%B0%B4%E8%B4%A3%E4%B8%8E%E4%BF%84%E7%BD%97%E6%96%AF%E6%9F%B4%E6%B2%B9%E4%BA%A4%E6%98%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791748711000.webp","sourceId":"rfi"},{"id":1791748447000,"createdDate":"2026-10-11 19:54","name":"法国国际广播电台","title":"波兰逮捕一名涉嫌企图刺杀总理的嫌疑人","content":"波兰内政部发言人卡罗琳娜·加莱茨卡（KarolinaGalecka）周日晚间告诉法新社，一名涉嫌策划刺杀总理唐纳德·图斯克（DonaldTus）和国防部长弗拉迪斯瓦夫·科西尼亚克-卡梅什（WladyslawKosiniak-Kamysz）的男子已被逮捕，警方正在继续调查此案。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261011-%E6%B3%A2%E5%85%B0%E9%80%AE%E6%8D%95%E4%B8%80%E5%90%8D%E6%B6%89%E5%AB%8C%E4%BC%81%E5%9B%BE%E5%88%BA%E6%9D%80%E6%80%BB%E7%90%86%E7%9A%84%E5%AB%8C%E7%96%91%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791748447000.webp","sourceId":"rfi"},{"id":1791748124000,"createdDate":"2026-10-11 19:48","name":"法国国际广播电台","title":"机场不断遭袭 令沙特失误的几个“坑”","content":"沙特首都一机场本周六遭到也门胡塞武装（Houthis）最严重的一次袭击，至少12人死亡、300多人受伤，死者包括一名美国人。但周日沙特首都的国际机场也遭同一军事组织的袭击，引发火灾，和为数不详人员受伤。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261011-%E9%A6%96%E9%83%BD%E6%9C%BA%E5%9C%BA%E4%B8%8D%E6%96%AD%E9%81%AD%E8%A2%AD-%E4%BB%A4%E6%B2%99%E7%89%B9%E5%A4%B1%E8%AF%AF%E7%9A%84%E5%87%A0%E4%B8%AA-%E5%9D%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/11/1791748124000.webp","sourceId":"rfi"}]