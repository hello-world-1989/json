[{"id":1792543490000,"createdDate":"2026-10-21 00:44","name":"法国国际广播电台","title":"马斯克承诺捐赠SpaceX股份给每个美国儿童 潜在捐赠额达107亿美元","content":"埃隆·马斯克承诺明年将向每位美国儿童赠送SpaceX公司的股份，价值约107亿美元（95亿欧元）。但他并未具体说明哪些儿童有资格获得股份，也未说明股份将如何分配。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261021-%E9%A9%AC%E6%96%AF%E5%85%8B%E6%89%BF%E8%AF%BA%E6%8D%90%E8%B5%A0spacex%E8%82%A1%E4%BB%BD%E7%BB%99%E6%AF%8F%E4%B8%AA%E7%BE%8E%E5%9B%BD%E5%84%BF%E7%AB%A5-%E6%BD%9C%E5%9C%A8%E6%8D%90%E8%B5%A0%E9%A2%9D%E8%BE%BE107%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792543490000.webp","sourceId":"rfi"},{"id":1792587826000,"createdDate":"2026-10-21 13:03","name":"法国国际广播电台","title":"中国总理与俄总理会谈透露中俄“相处”之道 塔斯社称李强承诺“解决现有问题”","content":"中国总理李强周三（21日）在圣彼得堡与俄总理·米舒斯京会晤。双方还签署和交换了协议但内容尚不得而知。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E4%B8%AD%E5%9B%BD%E6%80%BB%E7%90%86%E4%B8%8E%E4%BF%84%E6%80%BB%E7%90%86%E4%BC%9A%E8%B0%88%E9%80%8F%E9%9C%B2%E4%B8%AD%E4%BF%84-%E7%9B%B8%E5%A4%84-%E4%B9%8B%E9%81%93-%E5%A1%94%E6%96%AF%E7%A4%BE%E7%A7%B0%E6%9D%8E%E5%BC%BA%E6%89%BF%E8%AF%BA-%E8%A7%A3%E5%86%B3%E7%8E%B0%E6%9C%89%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792587826000.webp","sourceId":"rfi"},{"id":1792585106000,"createdDate":"2026-10-21 12:18","name":"法国国际广播电台","title":"俄再袭乌能源设施4人遇难 卢比奥重申美对星链和星盾问题“事先并不知情”","content":"乌克兰总理谢尔盖·科雷茨基周三表示，俄罗斯昨晚再次对乌克兰能源设施、铁路网络及居民楼发动袭击，造成至少4人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E4%BF%84%E5%86%8D%E8%A2%AD%E4%B9%8C%E8%83%BD%E6%BA%90%E8%AE%BE%E6%96%BD4%E4%BA%BA%E9%81%87%E9%9A%BE-%E5%8D%A2%E6%AF%94%E5%A5%A5%E9%87%8D%E7%94%B3%E7%BE%8E%E5%AF%B9%E6%98%9F%E9%93%BE%E5%92%8C%E6%98%9F%E7%9B%BE%E9%97%AE%E9%A2%98-%E4%BA%8B%E5%85%88%E5%B9%B6%E4%B8%8D%E7%9F%A5%E6%83%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792585106000.webp","sourceId":"rfi"},{"id":1792583728000,"createdDate":"2026-10-21 11:55","name":"法国国际广播电台","title":"巴西总统选举角逐白热化，两竞选人提请取消对方参选资格","content":"巴西总统选举将于本周日25日举行第二轮投票。两位进入第二轮角逐的候选人，现任总统卢拉和挑战者，前总统雅伊尔·博索纳罗之子、自由党候选人弗拉维奥·博索纳罗先后宣布，要向高等选举法院提请撤销对方参选资格。双方引据的理由都与美国科技巨头Meta旗下的脸书等社交媒体平台是否干预选举有关。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261021-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E8%A7%92%E9%80%90%E7%99%BD%E7%83%AD%E5%8C%96%EF%BC%8C%E4%B8%A4%E7%AB%9E%E9%80%89%E4%BA%BA%E6%8F%90%E8%AF%B7%E5%8F%96%E6%B6%88%E5%AF%B9%E6%96%B9%E5%8F%82%E9%80%89%E8%B5%84%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792583728000.webp","sourceId":"rfi"},{"id":1792583174000,"createdDate":"2026-10-21 11:46","name":"法国国际广播电台","title":"特朗普特使在圣彼得堡与普京谈乌克兰问题 欧盟等待获知结果","content":"特朗普特使维特科夫周三上午抵达圣彼得堡，与普京举行会谈，旨在结束乌克兰战争。此前一天，美国特使维特科夫与乌克兰总统泽连斯基进行了会谈，双方都表示取得了共同进展。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E7%89%B9%E6%9C%97%E6%99%AE%E7%89%B9%E4%BD%BF%E5%9C%A8%E5%9C%A3%E5%BD%BC%E5%BE%97%E5%A0%A1%E4%B8%8E%E6%99%AE%E4%BA%AC%E8%B0%88%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98-%E6%AC%A7%E7%9B%9F%E7%AD%89%E5%BE%85%E8%8E%B7%E7%9F%A5%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792583174000.webp","sourceId":"rfi"},{"id":1792582671000,"createdDate":"2026-10-21 11:37","name":"法国国际广播电台","title":"法德罕见联手 批人民币低估加剧中欧贸易失衡","content":"周三（10月21日）法国各大主要报纸继续大篇幅围绕10月17日法国大规模示威及暴力事件的社会危机展开，Àlarue陷入困境，《解放报》以带有讽刺意味的标题，凸显政府在危机中的被动与失措，事件过去四天，尽管执政阵营内部不断有升级强硬安全措施的主张，但政府寻求政治解决方案仍显无解。《费加罗报》头版聚焦事件对总统选举格局的影响，民调显示，极右翼国民联盟成最大受益者。《十字架报》头版标题“算法下的暴力”，关注社交媒体对示威动员和暴力扩散的影响，反应法国社会对平台责任、信息传播与公共安全关系的争论。经济性《回声报》头版在报道勒科尔尼政府承认对骚乱预判和警力部署存在不足，并承诺采取大规模应对措施的同时，也聚焦总体马克龙对海湾国家的访问，访问旨在争取增加柴油供应，以保障法国冬季能源需求。巴林和阿联酋将分别增加每月10万吨柴油供应，但能否抑制油价仍极不确定。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261021-%E6%B3%95%E5%BE%B7%E7%BD%95%E8%A7%81%E8%81%94%E6%89%8B-%E6%89%B9%E8%AF%84%E4%BA%BA%E6%B0%91%E5%B8%81%E4%BD%8E%E4%BC%B0%E5%8A%A0%E5%89%A7%E4%B8%AD%E6%AC%A7%E8%B4%B8%E6%98%93%E5%A4%B1%E8%A1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792582671000.webp","sourceId":"rfi"},{"id":1792581724000,"createdDate":"2026-10-21 11:22","name":"法国国际广播电台","title":"幻影2000D战斗机在法国南锡附近坠毁 至少一人死亡","content":"一架法国幻影2000D战斗机周二晚间在南锡附近执行训练飞行任务时坠毁。法国空军和航天部队报告称，事故造成至少一名机组人员死亡，目前正在搜寻另一名遇难者。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261021-%E5%B9%BB%E5%BD%B12000d%E6%88%98%E6%96%97%E6%9C%BA%E5%9C%A8%E6%B3%95%E5%9B%BD%E5%8D%97%E9%94%A1%E9%99%84%E8%BF%91%E5%9D%A0%E6%AF%81-%E8%87%B3%E5%B0%91%E4%B8%80%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792581724000.webp","sourceId":"rfi"},{"id":1792580834000,"createdDate":"2026-10-21 11:07","name":"法国国际广播电台","title":"台湾政治风向指标关键新北市，苏巧慧能否打破过去21年蓝营执政","content":"距离九合一选举剩下约6个星期，各区选战都已进入白热化的「选战模式」。受到台北市「洋流崛起」影响选情，过往让蓝营引以为豪的双北票仓，都传出失守危机。而新北市因身为全台最大票仓，被国民党视为「绝对不能输的重中之重」与2028年总统大选重返执政的关键基地。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8F%B0%E5%8C%97%E4%B8%80%E5%91%A8/20261021-%E5%8F%B0%E6%B9%BE%E6%94%BF%E6%B2%BB%E9%A3%8E%E5%90%91%E6%8C%87%E6%A0%87%E5%85%B3%E9%94%AE%E6%96%B0%E5%8C%97%E5%B8%82%EF%BC%8C%E8%8B%8F%E5%B7%A7%E6%85%A7%E8%83%BD%E5%90%A6%E6%89%93%E7%A0%B4%E8%BF%87%E5%8E%BB21%E5%B9%B4%E8%93%9D%E8%90%A5%E6%89%A7%E6%94%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792580834000.webp","sourceId":"rfi"},{"id":1792572652000,"createdDate":"2026-10-21 08:50","name":"法国国际广播电台","title":"日本外务省欧洲局长赴俄罗斯  要求释放日本记者","content":"日本外务省21日宣布，欧洲局局长中村仁威已赴俄罗斯，并于当地时间20日访问莫斯科的俄罗斯外交部，与负责对日关系等事务的俄罗斯外交部亚洲第三局局长柳德米拉·博罗维约娃举行会谈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E7%9C%81%E6%AC%A7%E6%B4%B2%E5%B1%80%E9%95%BF%E8%B5%B4%E4%BF%84%E7%BD%97%E6%96%AF-%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792572652000.webp","sourceId":"rfi"},{"id":1792572028000,"createdDate":"2026-10-21 08:40","name":"法国国际广播电台","title":"中国纪念台湾光复81周年与孙文160周年诞辰 被指企图操作两岸叙事","content":"北京当局近年扩大对台统战，不仅将「台湾光复」立法化，中共领导人习近平更将亲自出席11月12日的孙文诞辰160周年大会，定调「孙文一生为促统」。国安官员分析，中国一系列活动主要在建构三大意图目标。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E4%B8%AD%E5%9B%BD%E7%BA%AA%E5%BF%B5%E5%8F%B0%E6%B9%BE%E5%85%89%E5%A4%8D81%E5%91%A8%E5%B9%B4%E4%B8%8E%E5%AD%99%E6%96%87160%E5%91%A8%E5%B9%B4%E8%AF%9E%E8%BE%B0-%E4%BC%81%E5%9B%BE%E6%93%8D%E4%BD%9C%E4%B8%A4%E5%B2%B8%E5%8F%99%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792572028000.webp","sourceId":"rfi"},{"id":1792571695000,"createdDate":"2026-10-21 08:34","name":"法国国际广播电台","title":"亚太经合财长会议在港闭幕 共识是增协调以加强财金系统韧性 保区域稳定","content":"一连两日的亚太经济合作组织（APEC）财长会议今(21日)午在港闭幕，主持会议的中国财长蓝佛安表示，各成员经济体在坦诚丶深入丶富有建设性的交流下，核准及发布今年APEC财长联合声明等文件，为亚太经济体深化财经合作明确方向和提供指引。他在一天半的会议期间，多次强调地缘冲突影响外溢扩散，各成员经济体应通过开放合作，共同应对挑战。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261021-%E4%BA%9A%E5%A4%AA%E7%BB%8F%E5%90%88%E8%B4%A2%E9%95%BF%E4%BC%9A%E8%AE%AE%E5%9C%A8%E6%B8%AF%E9%97%AD%E5%B9%95-%E5%85%B1%E8%AF%86%E6%98%AF%E5%A2%9E%E5%8D%8F%E8%B0%83%E4%BB%A5%E5%8A%A0%E5%BC%BA%E8%B4%A2%E9%87%91%E7%B3%BB%E7%BB%9F%E9%9F%A7%E6%80%A7-%E4%BF%9D%E5%8C%BA%E5%9F%9F%E7%A8%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792571695000.webp","sourceId":"rfi"},{"id":1792562553000,"createdDate":"2026-10-21 06:02","name":"法国国际广播电台","title":"港府对法发出黄色外遊警示 成第17个示警地区 港师生下月国际赛程或受影响","content":"法国近期持续出现大型示威及冲突，港府周二（20日）对法国发出黄色外遊警示，呼吁身处当地或计划前往法国的港人提高警惕，避开示威地区，是第17个向法国发出旅遊警示的国家或地区。港府发出警示除了影响旅客行程安排外，亦可能使原定下月赴法参加国际大赛的近六百名香港师生退赛及取消行程。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261021-%E6%B8%AF%E5%BA%9C%E5%AF%B9%E6%B3%95%E5%8F%91%E5%87%BA%E9%BB%84%E8%89%B2%E5%A4%96%E9%81%8A%E8%AD%A6%E7%A4%BA-%E6%88%90%E7%AC%AC17%E4%B8%AA%E7%A4%BA%E8%AD%A6%E5%9C%B0%E5%8C%BA-%E6%B8%AF%E5%B8%88%E7%94%9F%E4%B8%8B%E6%9C%88%E5%9B%BD%E9%99%85%E8%B5%9B%E7%A8%8B%E6%88%96%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792562553000.webp","sourceId":"rfi"},{"id":1792606193000,"createdDate":"2026-10-21 18:09","name":"法国国际广播电台","title":"英国政府批准北海一处备受争议的天然气田开采项目","content":"英国政府周三批准了在北海开采备受争议的“杰克多”（Jackdaw）天然气项目的计划，旨在展现“务实”态度，以加强该国的能源安全——目前英国正因中东战争导致能源价格飙升而面临压力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E8%8B%B1%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%89%B9%E5%87%86%E5%8C%97%E6%B5%B7%E4%B8%80%E5%A4%84%E5%A4%87%E5%8F%97%E4%BA%89%E8%AE%AE%E7%9A%84%E5%A4%A9%E7%84%B6%E6%B0%94%E7%94%B0%E5%BC%80%E9%87%87%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792606193000.webp","sourceId":"rfi"},{"id":1792603399000,"createdDate":"2026-10-21 17:23","name":"法国国际广播电台","title":"法国总理与工会代表会面 马克龙在卡塔尔呼吁采取强硬立场","content":"在又一个实施局部宵禁的夜晚过后，法国总理塞巴斯蒂安·勒科尔尼于周三与工会组织代表会面，法国总统埃马纽埃尔·马克龙再次呼吁对暴力行为实施者采取“强硬态度”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261021-%E6%B3%95%E5%9B%BD%E6%80%BB%E7%90%86%E4%B8%8E%E5%B7%A5%E4%BC%9A%E4%BB%A3%E8%A1%A8%E4%BC%9A%E9%9D%A2-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%9C%A8%E5%8D%A1%E5%A1%94%E5%B0%94%E5%91%BC%E5%90%81%E9%87%87%E5%8F%96%E5%BC%BA%E7%A1%AC%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792603399000.webp","sourceId":"rfi"},{"id":1792602273000,"createdDate":"2026-10-21 17:04","name":"法国国际广播电台","title":"台湾相声演员因讽中共遭中国公民雇凶袭击，检方起诉5名男子","content":"检方指控这五名男子受雇于一名中国公民，自7月起就开始跟踪黄逸豪，并计划制造一起车祸，使其受重伤，从而阻止他登台演出。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261021-%E5%8F%B0%E6%B9%BE%E7%9B%B8%E5%A3%B0%E6%BC%94%E5%91%98%E5%9B%A0%E8%AE%BD%E4%B8%AD%E5%85%B1%E9%81%AD%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E9%9B%87%E5%87%B6%E8%A2%AD%E5%87%BB5%E7%94%B7%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792602273000.webp","sourceId":"rfi"},{"id":1792601926000,"createdDate":"2026-10-21 16:58","name":"法国国际广播电台","title":"克里姆林宫：愿意11月中恢复与乌克兰和美国三方谈判","content":"克里姆林宫周三（10月21号）表示，莫斯科愿意在11月中旬恢复与华盛顿和基辅的三方谈判。此前，俄罗斯总统普京与美国驻俄特使举行了会晤。基辅方面则重申了其关于停火以促进谈判的呼吁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E5%85%8B%E9%87%8C%E5%A7%86%E6%9E%97%E5%AE%AB-%E6%84%BF%E6%84%8F11%E6%9C%88%E4%B8%AD%E6%81%A2%E5%A4%8D%E4%B8%8E%E4%B9%8C%E5%85%8B%E5%85%B0%E5%92%8C%E7%BE%8E%E5%9B%BD%E4%B8%89%E6%96%B9%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792601926000.webp","sourceId":"rfi"},{"id":1792599222000,"createdDate":"2026-10-21 16:13","name":"法国国际广播电台","title":"台湾在选举前谴责中国网络攻击和散布虚假信息","content":"法新社21日台北消息，台湾情报部门周二表示，中国已加剧针对台湾的网络攻击和散布虚假信息行动，而台湾正准备于11月底举行地方选举。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261021-%E5%8F%B0%E6%B9%BE%E5%9C%A8%E9%80%89%E4%B8%BE%E5%89%8D%E8%B0%B4%E8%B4%A3%E4%B8%AD%E5%9B%BD%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB%E5%92%8C%E6%95%A3%E5%B8%83%E8%99%9A%E5%81%87%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792599222000.webp","sourceId":"rfi"},{"id":1792593102000,"createdDate":"2026-10-21 14:31","name":"法国国际广播电台","title":"特朗普再度施压泽连斯基推动新一波外交努力能有多少胜算","content":"美国总统同时维特科夫20日在挪威首都与乌克兰总统泽连斯基会谈之后，21日已经抵达俄罗斯圣彼得堡，与俄罗斯总统普京会谈。特朗普显然正试图重新启动一波谈判，谋求尽快结束乌克兰战争。但特朗普2025年1月25日重返白宫后的多次尝试目前都无果而终，这一次新尝试能有多大胜算难以预料。但无可置疑的是，俄乌双方目前在战场上仍然处于相持不下的胶着状态，频繁的相互打击行动不断造成伤亡，而美国的支持力度大减令乌克兰更显被动之际，此时的欧洲似乎也都因内政问题，有些自顾不暇。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261021-%E7%89%B9%E6%9C%97%E6%99%AE%E5%86%8D%E5%BA%A6%E6%96%BD%E5%8E%8B%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8E%A8%E5%8A%A8%E6%96%B0%E4%B8%80%E6%B3%A2%E5%A4%96%E4%BA%A4%E5%8A%AA%E5%8A%9B%E8%83%BD%E6%9C%89%E5%A4%9A%E5%B0%91%E8%83%9C%E7%AE%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792593102000.webp","sourceId":"rfi"},{"id":1792592138000,"createdDate":"2026-10-21 14:15","name":"法国国际广播电台","title":"气候变化：联合国报告确认增幅1.5度势在必然 但强调仍有回春之术","content":"就在联合国气候峰会即将召开的前夕，联合国环境规划署今天周三发布了全球碳排放的年度报告，这份名为《碳排放差距报告》明确指出，由于数十年来行动不足，人类将无法把全球变暖幅度控制在比工业化前水平高1.5摄氏度以内。虽然这一信息早已为人所知，但这是联合国首次正式确认上述评估。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261021-%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96-%E8%81%94%E5%90%88%E5%9B%BD%E6%8A%A5%E5%91%8A%E7%A1%AE%E8%AE%A4%E5%A2%9E%E5%B9%851-5%E5%BA%A6%E5%8A%BF%E5%9C%A8%E5%BF%85%E7%84%B6-%E4%BD%86%E5%BC%BA%E8%B0%83%E4%BB%8D%E6%9C%89%E5%9B%9E%E6%98%A5%E4%B9%8B%E6%9C%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792592138000.webp","sourceId":"rfi"},{"id":1792622507000,"createdDate":"2026-10-21 22:41","name":"法国国际广播电台","title":"特朗普纵容  普京梦想与中美举行新雅尔塔会议","content":"普京梦想着背着乌克兰人与美中举行峰会商讨瓜分该国，如同1945年在雅尔塔决定瓜分势力范围的方式。据华尔街日报报道，这是普京最新的构想，据称已在10月9日与美国总统特朗普电话交谈时提出。该计划设想三位领导人将在11月18日至19日在中国深圳举行的亚太峰会期间“商讨结束俄乌战争”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E7%89%B9%E6%9C%97%E6%99%AE%E7%BA%B5%E5%AE%B9-%E6%99%AE%E4%BA%AC%E6%A2%A6%E6%83%B3%E4%B8%8E%E4%B8%AD%E7%BE%8E%E4%B8%BE%E8%A1%8C%E6%96%B0%E9%9B%85%E5%B0%94%E5%A1%94%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792622507000.webp","sourceId":"rfi"},{"id":1792619897000,"createdDate":"2026-10-21 21:58","name":"法国国际广播电台","title":"美智库为何预估中共五中全会出席率低于80%：开除 失踪 被查","content":"中共20届五中全会将于10月26日开幕，美国智库亚洲协会报告分析，中共20大产生的376名中央委员和候补中央委员中，预计291人出席，出席率低于80%，再创新低。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E7%BE%8E%E6%99%BA%E5%BA%93%E4%B8%BA%E4%BD%95%E9%A2%84%E4%BC%B0%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%87%BA%E5%B8%AD%E7%8E%87%E4%BD%8E%E4%BA%8E80-%E5%BC%80%E9%99%A4-%E5%A4%B1%E8%B8%AA-%E8%A2%AB%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792619897000.webp","sourceId":"rfi"},{"id":1792619419000,"createdDate":"2026-10-21 21:50","name":"法国国际广播电台","title":"默茨：德中不存在贸易战 但德国须加强自身实力","content":"据德国《星星》周刊报道：尽管存在各种问题，德国联邦总理、基民盟（CDU）主席弗里德里希·默茨仍强调，与中国保持密切的贸易关系具有重要意义。默茨周三在柏林举行的“全球对话”（GlobalDialogue）论坛上表示：“我们希望与中国开展公平贸易，而不是发生冲突。”不过，他同时指出，鉴于存在不公平的贸易行为，德国和欧盟也必须“做好准备，保护自身及本国产业”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E9%BB%98%E8%8C%A8-%E5%BE%B7%E4%B8%AD%E4%B8%8D%E5%AD%98%E5%9C%A8%E8%B4%B8%E6%98%93%E6%88%98-%E4%BD%86%E5%BE%B7%E5%9B%BD%E9%A1%BB%E5%8A%A0%E5%BC%BA%E8%87%AA%E8%BA%AB%E5%AE%9E%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792619419000.webp","sourceId":"rfi"},{"id":1792618609000,"createdDate":"2026-10-21 21:36","name":"法国国际广播电台","title":"联合国警告：圣婴强度恐破纪录 全球气候与经济面临冲击","content":"联合国周三（10月21日）在日内瓦警告，当前圣婴现象强度可能打破历史纪录，引发极端高温、干旱和洪水，冲击全球经济，并使约5000万人面临更加严重的粮食短缺。联合国呼吁各国立即采取协调行动，提前部署救援物资，保护最脆弱群体。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E8%81%94%E5%90%88%E5%9B%BD%E8%AD%A6%E5%91%8A-%E5%9C%A3%E5%A9%B4%E5%BC%BA%E5%BA%A6%E6%81%90%E7%A0%B4%E7%BA%AA%E5%BD%95-%E5%85%A8%E7%90%83%E6%B0%94%E5%80%99%E4%B8%8E%E7%BB%8F%E6%B5%8E%E9%9D%A2%E4%B8%B4%E5%86%B2%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792618609000.webp","sourceId":"rfi"},{"id":1792618255000,"createdDate":"2026-10-21 21:30","name":"法国国际广播电台","title":"法国幻影战机夜间训练返航坠毁 两名飞行员生还希望渺茫","content":"法国一架幻影2000D战机周二（10月20日）晚间在训练返航途中，在法国东部南锡附近坠毁。负责调查的检察官周三表示，机上飞行员均未能及时弹射逃生，生还希望渺茫。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E6%B3%95%E5%9B%BD%E5%B9%BB%E5%BD%B1%E6%88%98%E6%9C%BA%E5%A4%9C%E9%97%B4%E8%AE%AD%E7%BB%83%E8%BF%94%E8%88%AA%E5%9D%A0%E6%AF%81-%E4%B8%A4%E5%90%8D%E9%A3%9E%E8%A1%8C%E5%91%98%E7%94%9F%E8%BF%98%E5%B8%8C%E6%9C%9B%E6%B8%BA%E8%8C%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792618255000.webp","sourceId":"rfi"},{"id":1792617929000,"createdDate":"2026-10-21 21:25","name":"法国国际广播电台","title":"法国再迎示威潮 马克龙要求严惩暴力 多地禁集会加强戒备","content":"法国部分地区连续第二晚实施宵禁后，总统马克龙周三（10月21日）呼吁，对暴力事件肇事者采取强硬措施。“黄背心”和青年群体计划周六（10月24日）再次发起抗议，目前距法国总统选举仅剩六个月，极右翼国民联盟领导人玛丽娜·勒庞指责政府”失去掌控局势的能力”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E6%B3%95%E5%9B%BD%E5%86%8D%E8%BF%8E%E7%A4%BA%E5%A8%81%E6%BD%AE-%E9%A9%AC%E5%85%8B%E9%BE%99%E8%A6%81%E6%B1%82%E4%B8%A5%E6%83%A9%E6%9A%B4%E5%8A%9B-%E5%A4%9A%E5%9C%B0%E7%A6%81%E9%9B%86%E4%BC%9A%E5%8A%A0%E5%BC%BA%E6%88%92%E5%A4%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792617929000.webp","sourceId":"rfi"},{"id":1792617681000,"createdDate":"2026-10-21 21:21","name":"法国国际广播电台","title":"误导脸书用户逾十年 Meta被判支付250亿美元创纪录罚款","content":"美国科技巨头Meta周三（10月21日）被判向新墨西哥州支付250亿美元，原因是该集团十多年来就用户数据的使用方式误导该州居民。这是Meta迄今面临的最高金额处罚。集团指责裁决变相对言论自由“征税”，并表示将提起上诉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E8%AF%AF%E5%AF%BC%E8%84%B8%E4%B9%A6%E7%94%A8%E6%88%B7%E9%80%BE%E5%8D%81%E5%B9%B4-meta%E8%A2%AB%E5%88%A4%E6%94%AF%E4%BB%98250%E4%BA%BF%E7%BE%8E%E5%85%83%E5%88%9B%E7%BA%AA%E5%BD%95%E7%BD%9A%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792617681000.webp","sourceId":"rfi"},{"id":1792617484000,"createdDate":"2026-10-21 21:18","name":"法国国际广播电台","title":"特朗普：俄乌战争“接近结束” 泽连斯基支持举行三方会谈","content":"美国总统特朗普周三（10月21日）再次表示，俄乌战争“接近结束”。美国特使威特科夫与俄罗斯总统普京周三在圣彼得堡会晤后，俄罗斯和乌克兰均表示，愿在美国斡旋下举行三方谈判，寻求结束战争。泽连斯基称，乌克兰支持尽快举行俄乌美三方会谈。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E7%89%B9%E6%9C%97%E6%99%AE-%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%89-%E6%8E%A5%E8%BF%91%E7%BB%93%E6%9D%9F-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%94%AF%E6%8C%81%E4%B8%BE%E8%A1%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792617484000.webp","sourceId":"rfi"},{"id":1792616732000,"createdDate":"2026-10-21 21:05","name":"法国国际广播电台","title":"美期中选举将至 民调显示共和党在中西部票仓面临压力","content":"美国共和党力拼在11月3日期中选举保住联邦众议院多数席次，但即使总统特朗普（DonaldTrump）2024年在爱阿华州以约13个百分点的优势胜出，共和党如今仍须防守该州4个联邦众议院选区中的3席。随着民调显示民主党支持度逐步上升，加上生活成本、能源价格及特朗普政府关税政策引发民怨，共和党在美国中西部传统票仓，面临愈来愈大的压力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E7%BE%8E%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E5%B0%86%E8%87%B3-%E6%B0%91%E8%B0%83%E6%98%BE%E7%A4%BA%E5%85%B1%E5%92%8C%E5%85%9A%E5%9C%A8%E4%B8%AD%E8%A5%BF%E9%83%A8%E7%A5%A8%E4%BB%93%E9%9D%A2%E4%B8%B4%E5%8E%8B%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792616732000.webp","sourceId":"rfi"}]