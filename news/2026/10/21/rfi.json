[{"id":1792543490000,"createdDate":"2026-10-21 00:44","name":"法国国际广播电台","title":"马斯克承诺捐赠SpaceX股份给每个美国儿童 潜在捐赠额达107亿美元","content":"埃隆·马斯克承诺明年将向每位美国儿童赠送SpaceX公司的股份，价值约107亿美元（95亿欧元）。但他并未具体说明哪些儿童有资格获得股份，也未说明股份将如何分配。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261021-%E9%A9%AC%E6%96%AF%E5%85%8B%E6%89%BF%E8%AF%BA%E6%8D%90%E8%B5%A0spacex%E8%82%A1%E4%BB%BD%E7%BB%99%E6%AF%8F%E4%B8%AA%E7%BE%8E%E5%9B%BD%E5%84%BF%E7%AB%A5-%E6%BD%9C%E5%9C%A8%E6%8D%90%E8%B5%A0%E9%A2%9D%E8%BE%BE107%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792543490000.webp","sourceId":"rfi"}]