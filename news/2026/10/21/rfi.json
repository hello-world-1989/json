[{"id":1792543490000,"createdDate":"2026-10-21 00:44","name":"法国国际广播电台","title":"马斯克承诺捐赠SpaceX股份给每个美国儿童 潜在捐赠额达107亿美元","content":"埃隆·马斯克承诺明年将向每位美国儿童赠送SpaceX公司的股份，价值约107亿美元（95亿欧元）。但他并未具体说明哪些儿童有资格获得股份，也未说明股份将如何分配。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261021-%E9%A9%AC%E6%96%AF%E5%85%8B%E6%89%BF%E8%AF%BA%E6%8D%90%E8%B5%A0spacex%E8%82%A1%E4%BB%BD%E7%BB%99%E6%AF%8F%E4%B8%AA%E7%BE%8E%E5%9B%BD%E5%84%BF%E7%AB%A5-%E6%BD%9C%E5%9C%A8%E6%8D%90%E8%B5%A0%E9%A2%9D%E8%BE%BE107%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792543490000.webp","sourceId":"rfi"},{"id":1792587826000,"createdDate":"2026-10-21 13:03","name":"法国国际广播电台","title":"中国总理与俄总理会谈透露中俄“相处”之道 塔斯社称李强承诺“解决现有问题”","content":"中国总理李强周三（21日）在圣彼得堡与俄总理·米舒斯京会晤。双方还签署和交换了协议但内容尚不得而知。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E4%B8%AD%E5%9B%BD%E6%80%BB%E7%90%86%E4%B8%8E%E4%BF%84%E6%80%BB%E7%90%86%E4%BC%9A%E8%B0%88%E9%80%8F%E9%9C%B2%E4%B8%AD%E4%BF%84-%E7%9B%B8%E5%A4%84-%E4%B9%8B%E9%81%93-%E5%A1%94%E6%96%AF%E7%A4%BE%E7%A7%B0%E6%9D%8E%E5%BC%BA%E6%89%BF%E8%AF%BA-%E8%A7%A3%E5%86%B3%E7%8E%B0%E6%9C%89%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792587826000.webp","sourceId":"rfi"},{"id":1792585106000,"createdDate":"2026-10-21 12:18","name":"法国国际广播电台","title":"俄再袭乌能源设施4人遇难 卢比奥重申美对星链和星盾问题“事先并不知情”","content":"乌克兰总理谢尔盖·科雷茨基周三表示，俄罗斯昨晚再次对乌克兰能源设施、铁路网络及居民楼发动袭击，造成至少4人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E4%BF%84%E5%86%8D%E8%A2%AD%E4%B9%8C%E8%83%BD%E6%BA%90%E8%AE%BE%E6%96%BD4%E4%BA%BA%E9%81%87%E9%9A%BE-%E5%8D%A2%E6%AF%94%E5%A5%A5%E9%87%8D%E7%94%B3%E7%BE%8E%E5%AF%B9%E6%98%9F%E9%93%BE%E5%92%8C%E6%98%9F%E7%9B%BE%E9%97%AE%E9%A2%98-%E4%BA%8B%E5%85%88%E5%B9%B6%E4%B8%8D%E7%9F%A5%E6%83%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792585106000.webp","sourceId":"rfi"},{"id":1792583728000,"createdDate":"2026-10-21 11:55","name":"法国国际广播电台","title":"巴西总统选举角逐白热化，两竞选人提请取消对方参选资格","content":"巴西总统选举将于本周日25日举行第二轮投票。两位进入第二轮角逐的候选人，现任总统卢拉和挑战者，前总统雅伊尔·博索纳罗之子、自由党候选人弗拉维奥·博索纳罗先后宣布，要向高等选举法院提请撤销对方参选资格。双方引据的理由都与美国科技巨头Meta旗下的脸书等社交媒体平台是否干预选举有关。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261021-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E8%A7%92%E9%80%90%E7%99%BD%E7%83%AD%E5%8C%96%EF%BC%8C%E4%B8%A4%E7%AB%9E%E9%80%89%E4%BA%BA%E6%8F%90%E8%AF%B7%E5%8F%96%E6%B6%88%E5%AF%B9%E6%96%B9%E5%8F%82%E9%80%89%E8%B5%84%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792583728000.webp","sourceId":"rfi"},{"id":1792583174000,"createdDate":"2026-10-21 11:46","name":"法国国际广播电台","title":"特朗普特使在圣彼得堡与普京谈乌克兰问题 欧盟等待获知结果","content":"特朗普特使维特科夫周三上午抵达圣彼得堡，与普京举行会谈，旨在结束乌克兰战争。此前一天，美国特使维特科夫与乌克兰总统泽连斯基进行了会谈，双方都表示取得了共同进展。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E7%89%B9%E6%9C%97%E6%99%AE%E7%89%B9%E4%BD%BF%E5%9C%A8%E5%9C%A3%E5%BD%BC%E5%BE%97%E5%A0%A1%E4%B8%8E%E6%99%AE%E4%BA%AC%E8%B0%88%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98-%E6%AC%A7%E7%9B%9F%E7%AD%89%E5%BE%85%E8%8E%B7%E7%9F%A5%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792583174000.webp","sourceId":"rfi"},{"id":1792582671000,"createdDate":"2026-10-21 11:37","name":"法国国际广播电台","title":"法德罕见联手 批人民币低估加剧中欧贸易失衡","content":"周三（10月21日）法国各大主要报纸继续大篇幅围绕10月17日法国大规模示威及暴力事件的社会危机展开，Àlarue陷入困境，《解放报》以带有讽刺意味的标题，凸显政府在危机中的被动与失措，事件过去四天，尽管执政阵营内部不断有升级强硬安全措施的主张，但政府寻求政治解决方案仍显无解。《费加罗报》头版聚焦事件对总统选举格局的影响，民调显示，极右翼国民联盟成最大受益者。《十字架报》头版标题“算法下的暴力”，关注社交媒体对示威动员和暴力扩散的影响，反应法国社会对平台责任、信息传播与公共安全关系的争论。经济性《回声报》头版在报道勒科尔尼政府承认对骚乱预判和警力部署存在不足，并承诺采取大规模应对措施的同时，也聚焦总体马克龙对海湾国家的访问，访问旨在争取增加柴油供应，以保障法国冬季能源需求。巴林和阿联酋将分别增加每月10万吨柴油供应，但能否抑制油价仍极不确定。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261021-%E6%B3%95%E5%BE%B7%E7%BD%95%E8%A7%81%E8%81%94%E6%89%8B-%E6%89%B9%E8%AF%84%E4%BA%BA%E6%B0%91%E5%B8%81%E4%BD%8E%E4%BC%B0%E5%8A%A0%E5%89%A7%E4%B8%AD%E6%AC%A7%E8%B4%B8%E6%98%93%E5%A4%B1%E8%A1%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792582671000.webp","sourceId":"rfi"},{"id":1792581724000,"createdDate":"2026-10-21 11:22","name":"法国国际广播电台","title":"幻影2000D战斗机在法国南锡附近坠毁 至少一人死亡","content":"一架法国幻影2000D战斗机周二晚间在南锡附近执行训练飞行任务时坠毁。法国空军和航天部队报告称，事故造成至少一名机组人员死亡，目前正在搜寻另一名遇难者。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261021-%E5%B9%BB%E5%BD%B12000d%E6%88%98%E6%96%97%E6%9C%BA%E5%9C%A8%E6%B3%95%E5%9B%BD%E5%8D%97%E9%94%A1%E9%99%84%E8%BF%91%E5%9D%A0%E6%AF%81-%E8%87%B3%E5%B0%91%E4%B8%80%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792581724000.webp","sourceId":"rfi"},{"id":1792580834000,"createdDate":"2026-10-21 11:07","name":"法国国际广播电台","title":"台湾政治风向指标关键新北市，苏巧慧能否打破过去21年蓝营执政","content":"距离九合一选举剩下约6个星期，各区选战都已进入白热化的「选战模式」。受到台北市「洋流崛起」影响选情，过往让蓝营引以为豪的双北票仓，都传出失守危机。而新北市因身为全台最大票仓，被国民党视为「绝对不能输的重中之重」与2028年总统大选重返执政的关键基地。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8F%B0%E5%8C%97%E4%B8%80%E5%91%A8/20261021-%E5%8F%B0%E6%B9%BE%E6%94%BF%E6%B2%BB%E9%A3%8E%E5%90%91%E6%8C%87%E6%A0%87%E5%85%B3%E9%94%AE%E6%96%B0%E5%8C%97%E5%B8%82%EF%BC%8C%E8%8B%8F%E5%B7%A7%E6%85%A7%E8%83%BD%E5%90%A6%E6%89%93%E7%A0%B4%E8%BF%87%E5%8E%BB21%E5%B9%B4%E8%93%9D%E8%90%A5%E6%89%A7%E6%94%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792580834000.webp","sourceId":"rfi"},{"id":1792572652000,"createdDate":"2026-10-21 08:50","name":"法国国际广播电台","title":"日本外务省欧洲局长赴俄罗斯  要求释放日本记者","content":"日本外务省21日宣布，欧洲局局长中村仁威已赴俄罗斯，并于当地时间20日访问莫斯科的俄罗斯外交部，与负责对日关系等事务的俄罗斯外交部亚洲第三局局长柳德米拉·博罗维约娃举行会谈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261021-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E7%9C%81%E6%AC%A7%E6%B4%B2%E5%B1%80%E9%95%BF%E8%B5%B4%E4%BF%84%E7%BD%97%E6%96%AF-%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792572652000.webp","sourceId":"rfi"},{"id":1792572028000,"createdDate":"2026-10-21 08:40","name":"法国国际广播电台","title":"中国纪念台湾光复81周年与孙文160周年诞辰 被指企图操作两岸叙事","content":"北京当局近年扩大对台统战，不仅将「台湾光复」立法化，中共领导人习近平更将亲自出席11月12日的孙文诞辰160周年大会，定调「孙文一生为促统」。国安官员分析，中国一系列活动主要在建构三大意图目标。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261021-%E4%B8%AD%E5%9B%BD%E7%BA%AA%E5%BF%B5%E5%8F%B0%E6%B9%BE%E5%85%89%E5%A4%8D81%E5%91%A8%E5%B9%B4%E4%B8%8E%E5%AD%99%E6%96%87160%E5%91%A8%E5%B9%B4%E8%AF%9E%E8%BE%B0-%E4%BC%81%E5%9B%BE%E6%93%8D%E4%BD%9C%E4%B8%A4%E5%B2%B8%E5%8F%99%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792572028000.webp","sourceId":"rfi"},{"id":1792571695000,"createdDate":"2026-10-21 08:34","name":"法国国际广播电台","title":"亚太经合财长会议在港闭幕 共识是增协调以加强财金系统韧性 保区域稳定","content":"一连两日的亚太经济合作组织（APEC）财长会议今(21日)午在港闭幕，主持会议的中国财长蓝佛安表示，各成员经济体在坦诚丶深入丶富有建设性的交流下，核准及发布今年APEC财长联合声明等文件，为亚太经济体深化财经合作明确方向和提供指引。他在一天半的会议期间，多次强调地缘冲突影响外溢扩散，各成员经济体应通过开放合作，共同应对挑战。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261021-%E4%BA%9A%E5%A4%AA%E7%BB%8F%E5%90%88%E8%B4%A2%E9%95%BF%E4%BC%9A%E8%AE%AE%E5%9C%A8%E6%B8%AF%E9%97%AD%E5%B9%95-%E5%85%B1%E8%AF%86%E6%98%AF%E5%A2%9E%E5%8D%8F%E8%B0%83%E4%BB%A5%E5%8A%A0%E5%BC%BA%E8%B4%A2%E9%87%91%E7%B3%BB%E7%BB%9F%E9%9F%A7%E6%80%A7-%E4%BF%9D%E5%8C%BA%E5%9F%9F%E7%A8%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792571695000.webp","sourceId":"rfi"},{"id":1792562553000,"createdDate":"2026-10-21 06:02","name":"法国国际广播电台","title":"港府对法发出黄色外遊警示 成第17个示警地区 港师生下月国际赛程或受影响","content":"法国近期持续出现大型示威及冲突，港府周二（20日）对法国发出黄色外遊警示，呼吁身处当地或计划前往法国的港人提高警惕，避开示威地区，是第17个向法国发出旅遊警示的国家或地区。港府发出警示除了影响旅客行程安排外，亦可能使原定下月赴法参加国际大赛的近六百名香港师生退赛及取消行程。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261021-%E6%B8%AF%E5%BA%9C%E5%AF%B9%E6%B3%95%E5%8F%91%E5%87%BA%E9%BB%84%E8%89%B2%E5%A4%96%E9%81%8A%E8%AD%A6%E7%A4%BA-%E6%88%90%E7%AC%AC17%E4%B8%AA%E7%A4%BA%E8%AD%A6%E5%9C%B0%E5%8C%BA-%E6%B8%AF%E5%B8%88%E7%94%9F%E4%B8%8B%E6%9C%88%E5%9B%BD%E9%99%85%E8%B5%9B%E7%A8%8B%E6%88%96%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/21/1792562553000.webp","sourceId":"rfi"}]