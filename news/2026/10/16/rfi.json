[{"id":1792156737000,"createdDate":"2026-10-16 13:18","name":"法国国际广播电台","title":"英贸易相称愿就中国电动汽车关税问题与欧盟行动一致 法德就英车企加入“欧洲制造”计划条件曝光","content":"英国贸易大臣萨瓦尔（AnasSarwar）在受访时表示，英国与欧盟必须“携手合作、行动一致”，以应对中国在汽车领域的主导地位。这些言论释放出一个迄今为止最明确的信号：英国政府准备在针对中国电动汽车进口的关税问题上与欧盟保持一致，从而争取参与欧盟的“欧洲制造”（MadeinEurope）产业计划。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E8%8B%B1%E8%B4%B8%E6%98%93%E7%9B%B8%E7%A7%B0%E6%84%BF%E5%B0%B1%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E5%85%B3%E7%A8%8E%E9%97%AE%E9%A2%98%E4%B8%8E%E6%AC%A7%E7%9B%9F%E8%A1%8C%E5%8A%A8%E4%B8%80%E8%87%B4-%E6%B3%95%E5%BE%B7%E5%B0%B1%E8%8B%B1%E8%BD%A6%E4%BC%81%E5%8A%A0%E5%85%A5-%E6%AC%A7%E6%B4%B2%E5%88%B6%E9%80%A0-%E8%AE%A1%E5%88%92%E6%9D%A1%E4%BB%B6%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792156737000.webp","sourceId":"rfi"},{"id":1792152772000,"createdDate":"2026-10-16 12:12","name":"法国国际广播电台","title":"朝鲜增加对中国贸易，但审慎避免政治依附北京","content":"周五法国各大主要报纸头版主题各有侧重，《费加罗报》关注，在法国国民议会正在审议政府2027年财政预算案时，布鲁塞尔欧盟峰会也在就欧盟2028—2034年多年期预算展开谈判博弈，德、法各为代表的所谓“节俭”与增加预算两大阵营对峙，相关议题也进入到法国总统选举的辩论中，极右国民联盟呼吁减少法国对欧盟预算的分摊。该报还刊登有关移民入籍问题的调查，指2000年至2024年间，约有300万人获得法国国籍，并探讨这一增长对选民结构及选举的可能影响。同样是有关法国总统选举，《回声报》关注赢得左翼初选后的格吕克斯曼支持率上升，最新民调显示，他与中间阵营的菲利普、极左翼梅朗雄目前支持率相当，争夺进入大选第二轮的竞争激烈，而极右翼勒庞仍大幅领先。报纸标题即为“争夺第二名之战”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261016-%E6%9C%9D%E9%B2%9C%E5%A2%9E%E5%8A%A0%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%B4%B8%E6%98%93%EF%BC%8C%E4%BD%86%E8%AD%A6%E6%83%95%E5%AF%B9%E5%8C%97%E4%BA%AC%E6%94%BF%E6%B2%BB%E4%BE%9D%E9%99%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152772000.webp","sourceId":"rfi"},{"id":1792152218000,"createdDate":"2026-10-16 12:03","name":"法国国际广播电台","title":"美国对俄政策转向 冲击与乌克兰关系","content":"美国总统特朗普（DonaldTrump）近期接连调整对俄罗斯与乌克兰政策，令美乌关系面临新一轮考验。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261016-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E4%BF%84%E6%94%BF%E7%AD%96%E8%BD%AC%E5%90%91-%E5%86%B2%E5%87%BB%E4%B8%8E%E4%B9%8C%E5%85%8B%E5%85%B0%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152218000.webp","sourceId":"rfi"},{"id":1792152080000,"createdDate":"2026-10-16 12:01","name":"法国国际广播电台","title":"特朗普称正同俄中就无核化进行沟通 北京：现阶段要求中方参加三边核裁军谈判不可行","content":"美国总统特朗普（DonaldTrump）周四声称，华盛顿正与莫斯科和北京进行会谈，旨在推动这些拥有最大规模核武库的国家实现无核化。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261016-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%AD%A3%E5%90%8C%E4%BF%84%E4%B8%AD%E5%B0%B1%E6%97%A0%E6%A0%B8%E5%8C%96%E8%BF%9B%E8%A1%8C%E6%B2%9F%E9%80%9A-%E5%8C%97%E4%BA%AC-%E7%8E%B0%E9%98%B6%E6%AE%B5%E8%A6%81%E6%B1%82%E4%B8%AD%E6%96%B9%E5%8F%82%E5%8A%A0%E4%B8%89%E8%BE%B9%E6%A0%B8%E8%A3%81%E5%86%9B%E8%B0%88%E5%88%A4%E4%B8%8D%E5%8F%AF%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152080000.webp","sourceId":"rfi"},{"id":1792150352000,"createdDate":"2026-10-16 11:32","name":"法国国际广播电台","title":"斐济将部署澳大利亚军用无人船在太平洋巡航缉毒","content":"根据法新社16日发自悉尼的报道，太平洋岛国斐济明年将在附近水域部署澳大利亚军用无人船，打击毒品走私及其它非法活动。澳大利亚当局称，这是两国去年9月达成的合作协议的一部分。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261016-%E6%96%90%E6%B5%8E%E5%B0%86%E9%83%A8%E7%BD%B2%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E5%86%9B%E7%94%A8%E6%97%A0%E4%BA%BA%E8%88%B9%E5%9C%A8%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B7%A1%E8%88%AA%E7%BC%89%E6%AF%92","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792150352000.webp","sourceId":"rfi"},{"id":1792147590000,"createdDate":"2026-10-16 10:46","name":"法国国际广播电台","title":"为削减巨额对华贸易逆差 欧委会拟在12月领导人峰会前提出进一步方案","content":"欧盟正准备创设新的贸易权限，在必要时可彻底切断对方进入欧洲单一市场的准入。这是欧盟为缩减对华贸易逆差而采取的一项重大新举措。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E4%B8%BA%E5%89%8A%E5%87%8F%E5%B7%A8%E9%A2%9D%E5%AF%B9%E5%8D%8E%E8%B4%B8%E6%98%93%E9%80%86%E5%B7%AE-%E6%AC%A7%E5%A7%94%E4%BC%9A%E6%8B%9F%E5%9C%A812%E6%9C%88%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%B3%B0%E4%BC%9A%E5%89%8D%E6%8F%90%E5%87%BA%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792147590000.webp","sourceId":"rfi"},{"id":1792144520000,"createdDate":"2026-10-16 09:55","name":"法国国际广播电台","title":"中国驻菲大使称“若我们想动用武力，或会轻易获胜” 菲总统证实将召见弄清含义","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）周五证实，将召见中国驻菲律宾大使井泉。此前，井泉在周四表示，中国若与菲律宾发生军事冲突，能够“轻易取胜”；但他同时强调，中方不会动用武力。小马科斯则认为，井泉的这番言论听起来“像是威胁”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261016-%E4%B8%AD%E5%9B%BD%E9%A9%BB%E8%8F%B2%E5%A4%A7%E4%BD%BF%E7%A7%B0-%E8%8B%A5%E6%88%91%E4%BB%AC%E6%83%B3%E5%8A%A8%E7%94%A8%E6%AD%A6%E5%8A%9B%EF%BC%8C%E6%88%96%E4%BC%9A%E8%BD%BB%E6%98%93%E8%8E%B7%E8%83%9C-%E8%8F%B2%E6%80%BB%E7%BB%9F%E8%AF%81%E5%AE%9E%E5%B0%86%E5%8F%AC%E8%A7%81%E5%BC%84%E6%B8%85%E5%90%AB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792144520000.webp","sourceId":"rfi"},{"id":1792142483000,"createdDate":"2026-10-16 09:21","name":"法国国际广播电台","title":"日本政府气象厅误报发生9.9级史上最大级地震 为此道歉","content":"日本气象厅于日本时间中午12时40分发布紧急地震速报，称“千岛群岛发生了震级9.9级的地震”，并呼吁北海道至东海地区广大范围内的居民警惕强烈震动,此时全日本的手机紧急地震警报响起，电视台节目停播，呼吁避难，社交平台X（原推特）可能因用户大量涌入，一度出现时间线无法显示的情况。此外，雅虎搜索等服务也因访问量过大而持续出现连接困难的状况，而实际上是一次误报，日本气象厅于在下午2时召开记者会，为此道歉。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261016-%E6%97%A5%E6%9C%AC%E6%94%BF%E5%BA%9C%E6%B0%94%E8%B1%A1%E5%8E%85%E8%AF%AF%E6%8A%A5%E5%8F%91%E7%94%9F9-9%E7%BA%A7%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E7%BA%A7%E5%9C%B0%E9%9C%87-%E4%B8%BA%E6%AD%A4%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792142483000.webp","sourceId":"rfi"},{"id":1792141825000,"createdDate":"2026-10-16 09:10","name":"法国国际广播电台","title":"思觉失调妇住宅门外贴「驱共」字句 被裁定煽动罪成 判入院3个月","content":"香港国安警提控的案件日益伸向普罗市民：一名患有思觉失调症和怀疑妄想症的家庭主妇，因在住所大门外的墙上丶单位外走廊及高层客厅窗户张贴「光复香港」丶「驱逐共产党」等字句及英治时代的香港旗(港英旗)，经自行辩护後，遭裁定触犯国安法下的新煽动罪，遭判处三个月住院令，须强制接受精神治疗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E6%80%9D%E8%A7%89%E5%A4%B1%E8%B0%83%E5%A6%87%E4%BD%8F%E5%AE%85%E9%97%A8%E5%A4%96%E8%B4%B4-%E9%A9%B1%E5%85%B1-%E5%AD%97%E5%8F%A5-%E8%A2%AB%E8%A3%81%E5%AE%9A%E7%85%BD%E5%8A%A8%E7%BD%AA%E6%88%90-%E5%88%A4%E5%85%A5%E9%99%A23%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792141825000.webp","sourceId":"rfi"},{"id":1792140504000,"createdDate":"2026-10-16 08:48","name":"法国国际广播电台","title":"受限AI硬件走私大陆将追刑责 台经济部长指拟加紧出口管制与美接轨","content":"据台北方面一位高级官员透露，台湾政府正准备收紧针对人工智能（AI）芯片的出口管制，以进一步与美国的限制措施保持一致；此举也响应了特朗普政府旨在打击向中国走私尖端半导体行为的管控行动。台湾经济部部长龚明鑫在接受彭博社采访时表示，台方计划将人工智能服务器及尖端半导体产品纳入管制清单。他指出，在相关措施生效后，向中国运送受限的人工智能硬件将构成《贸易法》所规定的刑事犯罪。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E5%8F%97%E9%99%90ai%E7%A1%AC%E4%BB%B6%E8%B5%B0%E7%A7%81%E5%A4%A7%E9%99%86%E5%B0%86%E8%BF%BD%E5%88%91%E8%B4%A3-%E5%8F%B0%E7%BB%8F%E6%B5%8E%E9%83%A8%E9%95%BF%E6%8C%87%E6%8B%9F%E5%8A%A0%E7%B4%A7%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6%E4%B8%8E%E7%BE%8E%E6%8E%A5%E8%BD%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792140504000.webp","sourceId":"rfi"},{"id":1792131033000,"createdDate":"2026-10-16 06:10","name":"法国国际广播电台","title":"风变：香港再有同志活动因场地问题被取消 两年内至少四宗","content":"在港人支持保障同性恋者权利丶但政治体制和法律平权却有收缩的情况下，原定下月举行的同志活动「彩虹市集」因场地方称重覆租用而被迫取消，是连续两年因场地突被取消而无法举办活动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E9%A3%8E%E5%8F%98-%E9%A6%99%E6%B8%AF%E5%86%8D%E6%9C%89%E5%90%8C%E5%BF%97%E6%B4%BB%E5%8A%A8%E5%9B%A0%E5%9C%BA%E5%9C%B0%E9%97%AE%E9%A2%98%E8%A2%AB%E5%8F%96%E6%B6%88-%E4%B8%A4%E5%B9%B4%E5%86%85%E8%87%B3%E5%B0%91%E5%9B%9B%E5%AE%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792131033000.webp","sourceId":"rfi"}]