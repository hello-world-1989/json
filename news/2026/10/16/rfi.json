[{"id":1792156737000,"createdDate":"2026-10-16 13:18","name":"法国国际广播电台","title":"英贸易相称愿就中国电动汽车关税问题与欧盟行动一致 法德就英车企加入“欧洲制造”计划条件曝光","content":"英国贸易大臣萨瓦尔（AnasSarwar）在受访时表示，英国与欧盟必须“携手合作、行动一致”，以应对中国在汽车领域的主导地位。这些言论释放出一个迄今为止最明确的信号：英国政府准备在针对中国电动汽车进口的关税问题上与欧盟保持一致，从而争取参与欧盟的“欧洲制造”（MadeinEurope）产业计划。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E8%8B%B1%E8%B4%B8%E6%98%93%E7%9B%B8%E7%A7%B0%E6%84%BF%E5%B0%B1%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E5%85%B3%E7%A8%8E%E9%97%AE%E9%A2%98%E4%B8%8E%E6%AC%A7%E7%9B%9F%E8%A1%8C%E5%8A%A8%E4%B8%80%E8%87%B4-%E6%B3%95%E5%BE%B7%E5%B0%B1%E8%8B%B1%E8%BD%A6%E4%BC%81%E5%8A%A0%E5%85%A5-%E6%AC%A7%E6%B4%B2%E5%88%B6%E9%80%A0-%E8%AE%A1%E5%88%92%E6%9D%A1%E4%BB%B6%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792156737000.webp","sourceId":"rfi"},{"id":1792152772000,"createdDate":"2026-10-16 12:12","name":"法国国际广播电台","title":"朝鲜增加对中国贸易，但审慎避免政治依附北京","content":"周五法国各大主要报纸头版主题各有侧重，《费加罗报》关注，在法国国民议会正在审议政府2027年财政预算案时，布鲁塞尔欧盟峰会也在就欧盟2028—2034年多年期预算展开谈判博弈，德、法各为代表的所谓“节俭”与增加预算两大阵营对峙，相关议题也进入到法国总统选举的辩论中，极右国民联盟呼吁减少法国对欧盟预算的分摊。该报还刊登有关移民入籍问题的调查，指2000年至2024年间，约有300万人获得法国国籍，并探讨这一增长对选民结构及选举的可能影响。同样是有关法国总统选举，《回声报》关注赢得左翼初选后的格吕克斯曼支持率上升，最新民调显示，他与中间阵营的菲利普、极左翼梅朗雄目前支持率相当，争夺进入大选第二轮的竞争激烈，而极右翼勒庞仍大幅领先。报纸标题即为“争夺第二名之战”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261016-%E6%9C%9D%E9%B2%9C%E5%A2%9E%E5%8A%A0%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%B4%B8%E6%98%93%EF%BC%8C%E4%BD%86%E8%AD%A6%E6%83%95%E5%AF%B9%E5%8C%97%E4%BA%AC%E6%94%BF%E6%B2%BB%E4%BE%9D%E9%99%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152772000.webp","sourceId":"rfi"},{"id":1792152218000,"createdDate":"2026-10-16 12:03","name":"法国国际广播电台","title":"美国对俄政策转向 冲击与乌克兰关系","content":"美国总统特朗普（DonaldTrump）近期接连调整对俄罗斯与乌克兰政策，令美乌关系面临新一轮考验。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261016-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E4%BF%84%E6%94%BF%E7%AD%96%E8%BD%AC%E5%90%91-%E5%86%B2%E5%87%BB%E4%B8%8E%E4%B9%8C%E5%85%8B%E5%85%B0%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152218000.webp","sourceId":"rfi"},{"id":1792152080000,"createdDate":"2026-10-16 12:01","name":"法国国际广播电台","title":"特朗普称正同俄中就无核化进行沟通 北京：现阶段要求中方参加三边核裁军谈判不可行","content":"美国总统特朗普（DonaldTrump）周四声称，华盛顿正与莫斯科和北京进行会谈，旨在推动这些拥有最大规模核武库的国家实现无核化。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261016-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%AD%A3%E5%90%8C%E4%BF%84%E4%B8%AD%E5%B0%B1%E6%97%A0%E6%A0%B8%E5%8C%96%E8%BF%9B%E8%A1%8C%E6%B2%9F%E9%80%9A-%E5%8C%97%E4%BA%AC-%E7%8E%B0%E9%98%B6%E6%AE%B5%E8%A6%81%E6%B1%82%E4%B8%AD%E6%96%B9%E5%8F%82%E5%8A%A0%E4%B8%89%E8%BE%B9%E6%A0%B8%E8%A3%81%E5%86%9B%E8%B0%88%E5%88%A4%E4%B8%8D%E5%8F%AF%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792152080000.webp","sourceId":"rfi"},{"id":1792150352000,"createdDate":"2026-10-16 11:32","name":"法国国际广播电台","title":"斐济将部署澳大利亚军用无人船在太平洋巡航缉毒","content":"根据法新社16日发自悉尼的报道，太平洋岛国斐济明年将在附近水域部署澳大利亚军用无人船，打击毒品走私及其它非法活动。澳大利亚当局称，这是两国去年9月达成的合作协议的一部分。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261016-%E6%96%90%E6%B5%8E%E5%B0%86%E9%83%A8%E7%BD%B2%E6%BE%B3%E5%A4%A7%E5%88%A9%E4%BA%9A%E5%86%9B%E7%94%A8%E6%97%A0%E4%BA%BA%E8%88%B9%E5%9C%A8%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B7%A1%E8%88%AA%E7%BC%89%E6%AF%92","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792150352000.webp","sourceId":"rfi"},{"id":1792147590000,"createdDate":"2026-10-16 10:46","name":"法国国际广播电台","title":"为削减巨额对华贸易逆差 欧委会拟在12月领导人峰会前提出进一步方案","content":"欧盟正准备创设新的贸易权限，在必要时可彻底切断对方进入欧洲单一市场的准入。这是欧盟为缩减对华贸易逆差而采取的一项重大新举措。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E4%B8%BA%E5%89%8A%E5%87%8F%E5%B7%A8%E9%A2%9D%E5%AF%B9%E5%8D%8E%E8%B4%B8%E6%98%93%E9%80%86%E5%B7%AE-%E6%AC%A7%E5%A7%94%E4%BC%9A%E6%8B%9F%E5%9C%A812%E6%9C%88%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%B3%B0%E4%BC%9A%E5%89%8D%E6%8F%90%E5%87%BA%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792147590000.webp","sourceId":"rfi"},{"id":1792144520000,"createdDate":"2026-10-16 09:55","name":"法国国际广播电台","title":"中国驻菲大使称“若我们想动用武力，或会轻易获胜” 菲总统证实将召见弄清含义","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）周五证实，将召见中国驻菲律宾大使井泉。此前，井泉在周四表示，中国若与菲律宾发生军事冲突，能够“轻易取胜”；但他同时强调，中方不会动用武力。小马科斯则认为，井泉的这番言论听起来“像是威胁”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261016-%E4%B8%AD%E5%9B%BD%E9%A9%BB%E8%8F%B2%E5%A4%A7%E4%BD%BF%E7%A7%B0-%E8%8B%A5%E6%88%91%E4%BB%AC%E6%83%B3%E5%8A%A8%E7%94%A8%E6%AD%A6%E5%8A%9B%EF%BC%8C%E6%88%96%E4%BC%9A%E8%BD%BB%E6%98%93%E8%8E%B7%E8%83%9C-%E8%8F%B2%E6%80%BB%E7%BB%9F%E8%AF%81%E5%AE%9E%E5%B0%86%E5%8F%AC%E8%A7%81%E5%BC%84%E6%B8%85%E5%90%AB%E4%B9%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792144520000.webp","sourceId":"rfi"},{"id":1792142483000,"createdDate":"2026-10-16 09:21","name":"法国国际广播电台","title":"日本政府气象厅误报发生9.9级史上最大级地震 为此道歉","content":"日本气象厅于日本时间中午12时40分发布紧急地震速报，称“千岛群岛发生了震级9.9级的地震”，并呼吁北海道至东海地区广大范围内的居民警惕强烈震动,此时全日本的手机紧急地震警报响起，电视台节目停播，呼吁避难，社交平台X（原推特）可能因用户大量涌入，一度出现时间线无法显示的情况。此外，雅虎搜索等服务也因访问量过大而持续出现连接困难的状况，而实际上是一次误报，日本气象厅于在下午2时召开记者会，为此道歉。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261016-%E6%97%A5%E6%9C%AC%E6%94%BF%E5%BA%9C%E6%B0%94%E8%B1%A1%E5%8E%85%E8%AF%AF%E6%8A%A5%E5%8F%91%E7%94%9F9-9%E7%BA%A7%E5%8F%B2%E4%B8%8A%E6%9C%80%E5%A4%A7%E7%BA%A7%E5%9C%B0%E9%9C%87-%E4%B8%BA%E6%AD%A4%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792142483000.webp","sourceId":"rfi"},{"id":1792141825000,"createdDate":"2026-10-16 09:10","name":"法国国际广播电台","title":"思觉失调妇住宅门外贴「驱共」字句 被裁定煽动罪成 判入院3个月","content":"香港国安警提控的案件日益伸向普罗市民：一名患有思觉失调症和怀疑妄想症的家庭主妇，因在住所大门外的墙上丶单位外走廊及高层客厅窗户张贴「光复香港」丶「驱逐共产党」等字句及英治时代的香港旗(港英旗)，经自行辩护後，遭裁定触犯国安法下的新煽动罪，遭判处三个月住院令，须强制接受精神治疗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E6%80%9D%E8%A7%89%E5%A4%B1%E8%B0%83%E5%A6%87%E4%BD%8F%E5%AE%85%E9%97%A8%E5%A4%96%E8%B4%B4-%E9%A9%B1%E5%85%B1-%E5%AD%97%E5%8F%A5-%E8%A2%AB%E8%A3%81%E5%AE%9A%E7%85%BD%E5%8A%A8%E7%BD%AA%E6%88%90-%E5%88%A4%E5%85%A5%E9%99%A23%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792141825000.webp","sourceId":"rfi"},{"id":1792140504000,"createdDate":"2026-10-16 08:48","name":"法国国际广播电台","title":"受限AI硬件走私大陆将追刑责 台经济部长指拟加紧出口管制与美接轨","content":"据台北方面一位高级官员透露，台湾政府正准备收紧针对人工智能（AI）芯片的出口管制，以进一步与美国的限制措施保持一致；此举也响应了特朗普政府旨在打击向中国走私尖端半导体行为的管控行动。台湾经济部部长龚明鑫在接受彭博社采访时表示，台方计划将人工智能服务器及尖端半导体产品纳入管制清单。他指出，在相关措施生效后，向中国运送受限的人工智能硬件将构成《贸易法》所规定的刑事犯罪。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E5%8F%97%E9%99%90ai%E7%A1%AC%E4%BB%B6%E8%B5%B0%E7%A7%81%E5%A4%A7%E9%99%86%E5%B0%86%E8%BF%BD%E5%88%91%E8%B4%A3-%E5%8F%B0%E7%BB%8F%E6%B5%8E%E9%83%A8%E9%95%BF%E6%8C%87%E6%8B%9F%E5%8A%A0%E7%B4%A7%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6%E4%B8%8E%E7%BE%8E%E6%8E%A5%E8%BD%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792140504000.webp","sourceId":"rfi"},{"id":1792131033000,"createdDate":"2026-10-16 06:10","name":"法国国际广播电台","title":"风变：香港再有同志活动因场地问题被取消 两年内至少四宗","content":"在港人支持保障同性恋者权利丶但政治体制和法律平权却有收缩的情况下，原定下月举行的同志活动「彩虹市集」因场地方称重覆租用而被迫取消，是连续两年因场地突被取消而无法举办活动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E9%A3%8E%E5%8F%98-%E9%A6%99%E6%B8%AF%E5%86%8D%E6%9C%89%E5%90%8C%E5%BF%97%E6%B4%BB%E5%8A%A8%E5%9B%A0%E5%9C%BA%E5%9C%B0%E9%97%AE%E9%A2%98%E8%A2%AB%E5%8F%96%E6%B6%88-%E4%B8%A4%E5%B9%B4%E5%86%85%E8%87%B3%E5%B0%91%E5%9B%9B%E5%AE%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792131033000.webp","sourceId":"rfi"},{"id":1792179030000,"createdDate":"2026-10-16 19:30","name":"法国国际广播电台","title":"消息人士：特朗普的新任新闻秘书凯蒂·扎卡里亚已离职","content":"上任才一周，特朗普就逼走了他的新任新闻秘书。一位美国高级官员周五向法新社证实说，新任白宫新闻秘书凯蒂·扎卡里亚（KatieZacharia）已经离职。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261016-%E4%B8%8A%E4%BB%BB%E6%89%8D%E4%B8%80%E5%91%A8%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%B1%E9%80%BC%E8%B5%B0%E4%BA%86%E4%BB%96%E7%9A%84%E6%96%B0%E4%BB%BB%E6%96%B0%E9%97%BB%E7%A7%98%E4%B9%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792179030000.webp","sourceId":"rfi"},{"id":1792174119000,"createdDate":"2026-10-16 18:08","name":"法国国际广播电台","title":"新白宫发言人扎卡里亚承认未通过美国律师考试　赴中工作经历受关注","content":"新任白宫发言人凯蒂・扎卡里亚（KatieZacharia）周四（10月15日）承认，她从未通过美国律师资格考试，也没有重考。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E6%96%B0%E7%99%BD%E5%AE%AB%E5%8F%91%E8%A8%80%E4%BA%BA%E6%89%8E%E5%8D%A1%E9%87%8C%E4%BA%9A%E6%89%BF%E8%AE%A4%E6%9C%AA%E9%80%9A%E8%BF%87%E7%BE%8E%E5%9B%BD%E5%BE%8B%E5%B8%88%E8%80%83%E8%AF%95-%E8%B5%B4%E4%B8%AD%E5%B7%A5%E4%BD%9C%E7%BB%8F%E5%8E%86%E5%8F%97%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792174119000.webp","sourceId":"rfi"},{"id":1792173347000,"createdDate":"2026-10-16 17:55","name":"法国国际广播电台","title":"德法共识：进一步放宽燃油车淘汰政策","content":"据德国广播电台报道，柏林和巴黎达成一致，再次放宽了逐步淘汰燃油车的相关规定。这一直是德国联邦政府的主要诉求之一。但德国与法国提出的汽车行业未来欧盟监管方案，引发了截然不同的反应。柏林和巴黎两国政府对协议表示赞赏，但部分反对党和环保组织以及媒体则提出了尖锐批评。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261016-%E5%BE%B7%E6%B3%95%E5%85%B1%E8%AF%86-%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%94%BE%E5%AE%BD%E7%87%83%E6%B2%B9%E8%BD%A6%E6%B7%98%E6%B1%B0%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792173347000.webp","sourceId":"rfi"},{"id":1792167527000,"createdDate":"2026-10-16 16:18","name":"法国国际广播电台","title":"冲绳县知事同意美军“鱼鹰”运输机部署：撤回部署或停止使用并不现实","content":"日本冲绳县知事古谢玄太周五表示，同意在冲绳县宜野湾市的普天间机场部署美军MV-22“鱼鹰”运输机。冲绳县此前一直以“鱼鹰”运输机自2012年部署至普天间前就存在安全隐患为由表示反对，但如今立场已发生转变。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261016-%E5%86%B2%E7%BB%B3%E5%8E%BF%E7%9F%A5%E4%BA%8B%E5%90%8C%E6%84%8F%E7%BE%8E%E5%86%9B-%E9%B1%BC%E9%B9%B0-%E8%BF%90%E8%BE%93%E6%9C%BA%E9%83%A8%E7%BD%B2-%E6%92%A4%E5%9B%9E%E9%83%A8%E7%BD%B2%E6%88%96%E5%81%9C%E6%AD%A2%E4%BD%BF%E7%94%A8%E5%B9%B6%E4%B8%8D%E7%8E%B0%E5%AE%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792167527000.webp","sourceId":"rfi"},{"id":1792166713000,"createdDate":"2026-10-16 16:05","name":"法国国际广播电台","title":"希腊小港城埃莱夫西斯 如今身处中美霸权争夺中心","content":"在希腊第一大港比雷埃夫斯附近的埃莱夫西斯港（Eleusis），美国计划打造一个全新的军事和能源中心","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E5%B8%8C%E8%85%8A%E5%B0%8F%E6%B8%AF%E5%9F%8E%E5%9F%83%E8%8E%B1%E5%A4%AB%E8%A5%BF%E6%96%AF-%E5%A6%82%E4%BB%8A%E8%BA%AB%E5%A4%84%E4%B8%AD%E7%BE%8E%E9%9C%B8%E6%9D%83%E4%BA%89%E5%A4%BA%E4%B8%AD%E5%BF%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792166713000.webp","sourceId":"rfi"},{"id":1792165987000,"createdDate":"2026-10-16 15:53","name":"法国国际广播电台","title":"张婉莹被指曾坐太子集团“共谋者二号”超跑拍照 更多细节被曝光","content":"据哥伦比亚广播公司（CBS）的一项调查显示，一名被控充当中国代理人的加州房地产经纪人，与一个涉嫌在柬埔寨运作的犯罪组织存在关联；该组织被指利用强迫劳动，针对美国民众实施了涉案金额高达数十亿美元的诈骗活动。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261016-%E5%BC%A0%E5%A9%89%E8%8E%B9%E8%A2%AB%E6%8C%87%E6%9B%BE%E5%9D%90%E5%A4%AA%E5%AD%90%E9%9B%86%E5%9B%A2-%E5%85%B1%E8%B0%8B%E8%80%85%E4%BA%8C%E5%8F%B7-%E8%B6%85%E8%B7%91%E6%8B%8D%E7%85%A7-%E6%9B%B4%E5%A4%9A%E7%BB%86%E8%8A%82%E8%A2%AB%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792165987000.webp","sourceId":"rfi"},{"id":1792164641000,"createdDate":"2026-10-16 15:30","name":"法国国际广播电台","title":"FMI警告全球经济风险加大 亚洲经济增长将放缓","content":"国际货币基金组织与世界银行从10月12日至18日在曼谷举行2026年秋季年会，国际货币基金组织总裁克里斯塔利娜·格奥尔基耶娃警告：沙特阿美石油行政大楼遭受袭击等对全球经济造成冲击会导致亚洲经济增长放缓以及利率上升将带来严重后果。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261016-fmi%E8%AD%A6%E5%91%8A%E5%85%A8%E7%90%83%E7%BB%8F%E6%B5%8E%E9%A3%8E%E9%99%A9%E5%8A%A0%E5%A4%A7-%E4%BA%9A%E6%B4%B2%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF%E5%B0%86%E6%94%BE%E7%BC%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792164641000.webp","sourceId":"rfi"},{"id":1792164187000,"createdDate":"2026-10-16 15:23","name":"法国国际广播电台","title":"新西兰安全情报局将协助斐济情报审查 以应对外国渗透","content":"在新西兰情报部门的支持下，斐济政府正对其国家安全与情报系统进行内部评估，此前美国警告中国在斐济存在渗透活动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%AE%89%E5%85%A8%E6%83%85%E6%8A%A5%E5%B1%80%E5%B0%86%E5%8D%8F%E5%8A%A9%E6%96%90%E6%B5%8E%E6%83%85%E6%8A%A5%E5%AE%A1%E6%9F%A5-%E4%BB%A5%E5%BA%94%E5%AF%B9%E5%A4%96%E5%9B%BD%E5%B9%B2%E9%A2%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792164187000.webp","sourceId":"rfi"},{"id":1792160386000,"createdDate":"2026-10-16 14:19","name":"法国国际广播电台","title":"中国拟限禁AI、生物医药和光伏三领域共40项技术的出口","content":"中国商务部、科技部周五（16日）发布2026年第48号公告，就修订《中国禁止出口限制出口技术目录》（以下简称《目录》）公开征求意见，并对相关技术实施出口前登记的临时管理措施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261016-%E4%B8%AD%E5%9B%BD%E6%8B%9F%E9%99%90%E7%A6%81ai-%E7%94%9F%E7%89%A9%E5%8C%BB%E8%8D%AF%E5%92%8C%E5%85%89%E4%BC%8F%E4%B8%89%E9%A2%86%E5%9F%9F%E5%85%B140%E9%A1%B9%E6%8A%80%E6%9C%AF%E7%9A%84%E5%87%BA%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792160386000.webp","sourceId":"rfi"},{"id":1792160322000,"createdDate":"2026-10-16 14:18","name":"法国国际广播电台","title":"黑海商船频繁遇袭：俄乌战争外溢效应逼近欧洲？","content":"正在布鲁塞尔出席欧洲联盟领导人峰会的罗马尼亚总统15日与北约秘书长以及保加利亚总理会谈后表示，北约将讨论黑海水域过境商船遭遇无人机袭击事件。北约负责人也表示，已经将近期货船在黑海水域遭遇无人机袭击事件纳入下周在布鲁塞尔召开的成员国大使常会的讨论日程。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261016-%E9%BB%91%E6%B5%B7%E5%95%86%E8%88%B9%E9%A2%91%E7%B9%81%E9%81%87%E8%A2%AD-%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%89%E5%A4%96%E6%BA%A2%E6%95%88%E5%BA%94%E9%80%BC%E8%BF%91%E6%AC%A7%E6%B4%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792160322000.webp","sourceId":"rfi"},{"id":1792157284000,"createdDate":"2026-10-16 13:28","name":"法国国际广播电台","title":"第17届生物多样性峰会看点与中国立场","content":"联合国《生物多样性公约》第17次缔约方大会（CBDCOP17）将于本月的19日至30日在亚美尼亚首都埃里温（Yerevan）举行，此次峰会的着重点是要对 “昆明—蒙特利尔全球生物多样性框架”（简称“昆蒙框架”）达成后的全球履约情况进行审查。评估各国在“保护30%的陆地和海洋”等核心目标上的进展。那么，除此之外，还有一些什么别的看点？另外，中国作为“昆蒙框架”的主要推动国，中国的表现如何？法广就此电话采访了法国智库，法国可持续发展与国际关系学院（IDDRI）的生物多样性项目负责人JulietteLandry女士，她的中文名字叫做兰朱莉：","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261016-%E7%AC%AC17%E5%B1%8A%E7%94%9F%E7%89%A9%E5%A4%9A%E6%A0%B7%E6%80%A7%E5%B3%B0%E4%BC%9A%E7%9C%8B%E7%82%B9%E4%B8%8E%E4%B8%AD%E5%9B%BD%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/16/1792157284000.webp","sourceId":"rfi"}]