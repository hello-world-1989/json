[{"id":1793023988000,"createdDate":"2026-10-26 14:13","name":"法国国际广播电台","title":"中国车企欧洲季度销量首超日本车企 9月欧洲销量份额占12.7%","content":"据彭博社报导，在欧洲市场，中国汽车制造商在一个完整的季度内，其销量首次超过了日本竞争对手。这一现象凸显出比亚迪和奇瑞汽车等中国品牌在欧洲销量上升之迅猛。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E6%AC%A7%E6%B4%B2%E5%AD%A3%E5%BA%A6%E9%94%80%E9%87%8F%E9%A6%96%E6%AC%A1%E8%B6%85%E6%97%A5%E6%9C%AC%E8%BD%A6%E4%BC%81-9%E6%9C%88%E6%AC%A7%E6%B4%B2%E9%94%80%E9%87%8F%E4%BB%BD%E9%A2%9D12-7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793023988000.webp","sourceId":"rfi"},{"id":1793022054000,"createdDate":"2026-10-26 13:40","name":"法国国际广播电台","title":"电商平台加强应对危险品措施  欧盟接受Temu承诺","content":"中国电商巨头Temu今天向欧盟承诺将实施一项行动计划，以打击通过其平台销售危险品的行为。此前在今年5月因Temu未能有效遏制平台上销售非法及危险商品，欧盟对其处以2亿欧元罚款。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261026-%E7%94%B5%E5%95%86%E5%B9%B3%E5%8F%B0%E5%8A%A0%E5%BC%BA%E5%BA%94%E5%AF%B9%E5%8D%B1%E9%99%A9%E5%93%81%E6%8E%AA%E6%96%BD-%E6%AC%A7%E7%9B%9F%E6%8E%A5%E5%8F%97temu%E6%89%BF%E8%AF%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793022054000.webp","sourceId":"rfi"},{"id":1793020087000,"createdDate":"2026-10-26 13:08","name":"法国国际广播电台","title":"巴西：卢拉逆转获胜第四次连任  对手拒绝承认败选","content":"巴西左翼总统卢拉周日出人预料地实现逆转，史无前例地获得了第四个任期。统计显示，卢拉以51.79%的有效选票击败了得票率为48.21%的弗拉维奥·博索纳罗，比对手多获得440万张选票，赢得了连任。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261026-%E5%B7%B4%E8%A5%BF-%E5%8D%A2%E6%8B%89%E9%80%86%E8%BD%AC%E8%8E%B7%E8%83%9C%E7%AC%AC%E5%9B%9B%E6%AC%A1%E8%BF%9E%E4%BB%BB-%E5%AF%B9%E6%89%8B%E6%8B%92%E7%BB%9D%E6%89%BF%E8%AE%A4%E8%B4%A5%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793020087000.webp","sourceId":"rfi"},{"id":1793019975000,"createdDate":"2026-10-26 13:06","name":"法国国际广播电台","title":"乌情报部门呼吁限制向俄军工综合体供应设备的中国厂商供应零部件","content":"乌克兰国防部情报总局在“战争与制裁”门户网站上公布了俄罗斯生产弹道武器企业使用的三十台外国制造技术设备的数据和相关信息。该军事情报机构称，“俄罗斯军工综合体仍然严重依赖外国技术。特别值得一提的是，尽管作出了种种努力，俄罗斯联邦仍无法用国产设备来替代来自全球制造商的工业装备”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E4%B9%8C%E5%9B%BD%E9%98%B2%E9%83%A8%E6%83%85%E6%8A%A5%E6%80%BB%E5%B1%80%E5%91%BC%E5%90%81%E9%99%90%E5%88%B6%E5%90%91%E4%BF%84%E5%86%9B%E5%B7%A5%E7%BB%BC%E5%90%88%E4%BD%93%E4%BE%9B%E5%BA%94%E8%AE%BE%E5%A4%87%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%8E%82%E5%95%86%E4%BE%9B%E5%BA%94%E9%9B%B6%E9%83%A8%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793019975000.webp","sourceId":"rfi"},{"id":1793016776000,"createdDate":"2026-10-26 12:12","name":"法国国际广播电台","title":"欧盟据报拟采取保障措施 目标中国化学品、家具和机械等行业产品","content":"据彭博社援引知情人士报导称，欧盟正计划采取保障措施，以减少从中国进口化学品、家具和机械等行业的产品。知情人士表示，这些措施可能会采取进口上限或关税的形式，最早可能会在2027年第一季度出台。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E6%AC%A7%E7%9B%9F%E6%8D%AE%E6%8A%A5%E6%8B%9F%E9%87%87%E5%8F%96%E4%BF%9D%E9%9A%9C%E6%8E%AA%E6%96%BD-%E7%9B%AE%E6%A0%87%E4%B8%AD%E5%9B%BD%E5%8C%96%E5%AD%A6%E5%93%81-%E5%AE%B6%E5%85%B7%E5%92%8C%E6%9C%BA%E6%A2%B0%E7%AD%89%E8%A1%8C%E4%B8%9A%E4%BA%A7%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793016776000.webp","sourceId":"rfi"},{"id":1793016000000,"createdDate":"2026-10-26 12:00","name":"法国国际广播电台","title":"继对小包裹征税后 欧盟又将征收手续费","content":"为了遏制中国商品涌入欧盟市场并加强管控，欧盟将从本周日起对所有进口包裹加收2欧元的“手续费。随着“黑色星期五”和圣诞节购物季的临近，欧盟开始的项新措施将给跨境电商带来不少影响。。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E7%BB%A7%E5%AF%B9%E5%B0%8F%E5%8C%85%E8%A3%B9%E5%BE%81%E7%A8%8E%E5%90%8E-%E6%AC%A7%E7%9B%9F%E5%8F%88%E5%B0%86%E5%BE%81%E6%94%B6%E6%89%8B%E7%BB%AD%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793016000000.webp","sourceId":"rfi"},{"id":1793013699000,"createdDate":"2026-10-26 11:21","name":"法国国际广播电台","title":"中印边境再现波澜印官员指对峙持续 北京：望印方同中方相向而行","content":"近日，网上流传片段显示中印两军在边境对峙，中国外交部发言人郭嘉昆在周一的例行记者会上应询时表示，“希望印方同中方相向而行，共同落实双方达成的共识，以实际行动维护边境地区的和平安宁”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261026-%E4%B8%AD%E5%8D%B0%E8%BE%B9%E5%A2%83%E5%86%8D%E7%8E%B0%E6%B3%A2%E6%BE%9C%E5%8D%B0%E5%AE%98%E5%91%98%E6%8C%87%E5%AF%B9%E5%B3%99%E6%8C%81%E7%BB%AD-%E5%8C%97%E4%BA%AC-%E6%9C%9B%E5%8D%B0%E6%96%B9%E5%90%8C%E4%B8%AD%E6%96%B9%E7%9B%B8%E5%90%91%E8%80%8C%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793013699000.webp","sourceId":"rfi"},{"id":1793011429000,"createdDate":"2026-10-26 10:43","name":"法国国际广播电台","title":"欧洲思想文化长廊  【专题】希腊：欧洲文化永不磨灭的光辉：欧里庇德斯笔下的女性","content":"在希腊三大悲剧作家中，欧里庇德斯最注重女性题材。尽管妇女在希腊城邦中地位不高，但她们通过欧里庇德斯的创作，在希腊悲剧舞台上熠熠闪光。他的剧作为妇女伸张正义，表现妇女的高尚品德，描绘妇女的愤怒与复仇。他笔下涌出同情妇女的泉水，冲刷着傲慢无情的大男子主义。为此，他受攻击，遭嘲讽，但他不为所动，终使笔下人物永远流传。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261026-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E4%B8%93%E9%A2%98-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E6%AC%A7%E9%87%8C%E5%BA%87%E5%BE%B7%E6%96%AF%E7%AC%94%E4%B8%8B%E7%9A%84%E5%A5%B3%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793011429000.webp","sourceId":"rfi"},{"id":1793010348000,"createdDate":"2026-10-26 10:25","name":"法国国际广播电台","title":"中共二十大五中全会：强化治理措施 为习近平第四任期铺路？","content":"中国政治领导人周一（10月26号）开启为期四天的二十大五中全会，聚焦“全面从严治党”。与此同时，中国国家主席习近平正敦促官员们提高忠诚度和可靠性，并深化其多年来的反腐运动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261026-%E4%B8%AD%E5%85%B1%E4%BA%8C%E5%8D%81%E5%A4%A7%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A-%E5%BC%BA%E5%8C%96%E6%B2%BB%E7%90%86%E6%8E%AA%E6%96%BD-%E4%B8%BA%E4%B9%A0%E8%BF%91%E5%B9%B3%E7%AC%AC%E5%9B%9B%E4%BB%BB%E6%9C%9F%E9%93%BA%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793010348000.webp","sourceId":"rfi"},{"id":1793007771000,"createdDate":"2026-10-26 09:42","name":"法国国际广播电台","title":"蔡康永昨称望两岸友好来往 没支持过台独 今现身蒋万安竞总成立大会观摩","content":"蔡康永日前出席民进党台北市长参选人沈伯洋的竞选总部成立大会，以“蔡康永现身台独分子竞选现场”一度登上微博热搜。他在周日晚发文表示，希望两岸友好，从未支持台独。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261026-%E8%94%A1%E5%BA%B7%E6%B0%B8%E5%8F%91%E6%96%87%E7%A7%B0%E6%9C%9B%E4%B8%A4%E5%B2%B8%E5%8F%8B%E5%A5%BD%E6%9D%A5%E5%BE%80-%E6%B2%A1%E6%94%AF%E6%8C%81%E8%BF%87%E5%8F%B0%E7%8B%AC%E5%90%8E-%E7%8E%B0%E8%BA%AB%E8%92%8B%E4%B8%87%E5%AE%89%E7%AB%9E%E6%80%BB%E6%88%90%E7%AB%8B%E5%A4%A7%E4%BC%9A%E8%A7%82%E6%91%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793007771000.webp","sourceId":"rfi"},{"id":1793006567000,"createdDate":"2026-10-26 09:22","name":"法国国际广播电台","title":"蒋万安市长成立竞总大会 选情告急国民党「三子合体」到场支持","content":"台北市长蒋万安26日举行竞选总部成立大会，除了国民党「三子合体」现身会场，借此凸显国民党内部的团结。国民党主席郑丽文与民众党黄国昌也一同站台，以展现「蓝白合作」的默契。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261026-%E8%92%8B%E4%B8%87%E5%AE%89%E5%B8%82%E9%95%BF%E6%88%90%E7%AB%8B%E7%AB%9E%E6%80%BB%E5%A4%A7%E4%BC%9A-%E9%80%89%E6%83%85%E5%91%8A%E6%80%A5%E5%9B%BD%E6%B0%91%E5%85%9A-%E4%B8%89%E5%AD%90%E5%90%88%E4%BD%93-%E5%88%B0%E5%9C%BA%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793006567000.webp","sourceId":"rfi"},{"id":1793006188000,"createdDate":"2026-10-26 09:16","name":"法国国际广播电台","title":"日本前首相福田康夫逝世  中国在第一时间表示沉痛哀悼","content":"日本自民党10月26日宣布，日本前首相福田康夫于22日去世，享年90岁。高市早苗首相于26日发表首相谈话对福田康夫的逝世表示哀悼，中国外交部发言人郭嘉昆在26日的记者会上表示，我们对福田康夫前首相逝世表示沉痛哀悼，向他的家属致以诚挚慰问。福田康夫先生是中国人民的老朋友，为推动中日关系改善发展作出积极贡献。新华社等在第一时间报道了福田康夫去世的消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E6%97%A5%E6%9C%AC%E5%89%8D%E9%A6%96%E7%9B%B8%E7%A6%8F%E7%94%B0%E5%BA%B7%E5%A4%AB%E9%80%9D%E4%B8%96-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E7%AC%AC%E4%B8%80%E6%97%B6%E9%97%B4%E8%A1%A8%E7%A4%BA%E6%B2%89%E7%97%9B%E5%93%80%E6%82%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793006188000.webp","sourceId":"rfi"},{"id":1792995136000,"createdDate":"2026-10-26 06:12","name":"法国国际广播电台","title":"新皇岗口岸连续两晚人车拥堵  港府再遭狠批管理规划不善","content":"连接香港和深圳的新皇岗口岸，连续两个周末出现人流拥堵，而在刚过去的周末和周日，更连续两晚出现人流丶车流拥堵的问题。港府再次遭滞留的中国内地旅客狠批；评论指出，港府只从保安角度管理口岸，未能全盘审视口岸运作情况，导致规划和管理均有不足。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261026-%E6%96%B0%E7%9A%87%E5%B2%97%E5%8F%A3%E5%B2%B8%E8%BF%9E%E7%BB%AD%E4%B8%A4%E6%99%9A%E4%BA%BA%E8%BD%A6%E6%8B%A5%E5%A0%B5-%E6%B8%AF%E5%BA%9C%E5%86%8D%E9%81%AD%E7%8B%A0%E6%89%B9%E7%AE%A1%E7%90%86%E8%A7%84%E5%88%92%E4%B8%8D%E5%96%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1792995136000.webp","sourceId":"rfi"}]