[{"id":1793023988000,"createdDate":"2026-10-26 14:13","name":"法国国际广播电台","title":"中国车企欧洲季度销量首超日本车企 9月欧洲销量份额占12.7%","content":"据彭博社报导，在欧洲市场，中国汽车制造商在一个完整的季度内，其销量首次超过了日本竞争对手。这一现象凸显出比亚迪和奇瑞汽车等中国品牌在欧洲销量上升之迅猛。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E6%AC%A7%E6%B4%B2%E5%AD%A3%E5%BA%A6%E9%94%80%E9%87%8F%E9%A6%96%E6%AC%A1%E8%B6%85%E6%97%A5%E6%9C%AC%E8%BD%A6%E4%BC%81-9%E6%9C%88%E6%AC%A7%E6%B4%B2%E9%94%80%E9%87%8F%E4%BB%BD%E9%A2%9D12-7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793023988000.webp","sourceId":"rfi"},{"id":1793022054000,"createdDate":"2026-10-26 13:40","name":"法国国际广播电台","title":"电商平台加强应对危险品措施  欧盟接受Temu承诺","content":"中国电商巨头Temu今天向欧盟承诺将实施一项行动计划，以打击通过其平台销售危险品的行为。此前在今年5月因Temu未能有效遏制平台上销售非法及危险商品，欧盟对其处以2亿欧元罚款。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261026-%E7%94%B5%E5%95%86%E5%B9%B3%E5%8F%B0%E5%8A%A0%E5%BC%BA%E5%BA%94%E5%AF%B9%E5%8D%B1%E9%99%A9%E5%93%81%E6%8E%AA%E6%96%BD-%E6%AC%A7%E7%9B%9F%E6%8E%A5%E5%8F%97temu%E6%89%BF%E8%AF%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793022054000.webp","sourceId":"rfi"},{"id":1793020087000,"createdDate":"2026-10-26 13:08","name":"法国国际广播电台","title":"巴西：卢拉逆转获胜第四次连任  对手拒绝承认败选","content":"巴西左翼总统卢拉周日出人预料地实现逆转，史无前例地获得了第四个任期。统计显示，卢拉以51.79%的有效选票击败了得票率为48.21%的弗拉维奥·博索纳罗，比对手多获得440万张选票，赢得了连任。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261026-%E5%B7%B4%E8%A5%BF-%E5%8D%A2%E6%8B%89%E9%80%86%E8%BD%AC%E8%8E%B7%E8%83%9C%E7%AC%AC%E5%9B%9B%E6%AC%A1%E8%BF%9E%E4%BB%BB-%E5%AF%B9%E6%89%8B%E6%8B%92%E7%BB%9D%E6%89%BF%E8%AE%A4%E8%B4%A5%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793020087000.webp","sourceId":"rfi"},{"id":1793019975000,"createdDate":"2026-10-26 13:06","name":"法国国际广播电台","title":"乌情报部门呼吁限制向俄军工综合体供应设备的中国厂商供应零部件","content":"乌克兰国防部情报总局在“战争与制裁”门户网站上公布了俄罗斯生产弹道武器企业使用的三十台外国制造技术设备的数据和相关信息。该军事情报机构称，“俄罗斯军工综合体仍然严重依赖外国技术。特别值得一提的是，尽管作出了种种努力，俄罗斯联邦仍无法用国产设备来替代来自全球制造商的工业装备”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E4%B9%8C%E5%9B%BD%E9%98%B2%E9%83%A8%E6%83%85%E6%8A%A5%E6%80%BB%E5%B1%80%E5%91%BC%E5%90%81%E9%99%90%E5%88%B6%E5%90%91%E4%BF%84%E5%86%9B%E5%B7%A5%E7%BB%BC%E5%90%88%E4%BD%93%E4%BE%9B%E5%BA%94%E8%AE%BE%E5%A4%87%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%8E%82%E5%95%86%E4%BE%9B%E5%BA%94%E9%9B%B6%E9%83%A8%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793019975000.webp","sourceId":"rfi"},{"id":1793016776000,"createdDate":"2026-10-26 12:12","name":"法国国际广播电台","title":"欧盟据报拟采取保障措施 目标中国化学品、家具和机械等行业产品","content":"据彭博社援引知情人士报导称，欧盟正计划采取保障措施，以减少从中国进口化学品、家具和机械等行业的产品。知情人士表示，这些措施可能会采取进口上限或关税的形式，最早可能会在2027年第一季度出台。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E6%AC%A7%E7%9B%9F%E6%8D%AE%E6%8A%A5%E6%8B%9F%E9%87%87%E5%8F%96%E4%BF%9D%E9%9A%9C%E6%8E%AA%E6%96%BD-%E7%9B%AE%E6%A0%87%E4%B8%AD%E5%9B%BD%E5%8C%96%E5%AD%A6%E5%93%81-%E5%AE%B6%E5%85%B7%E5%92%8C%E6%9C%BA%E6%A2%B0%E7%AD%89%E8%A1%8C%E4%B8%9A%E4%BA%A7%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793016776000.webp","sourceId":"rfi"},{"id":1793016000000,"createdDate":"2026-10-26 12:00","name":"法国国际广播电台","title":"继对小包裹征税后 欧盟又将征收手续费","content":"为了遏制中国商品涌入欧盟市场并加强管控，欧盟将从本周日起对所有进口包裹加收2欧元的“手续费。随着“黑色星期五”和圣诞节购物季的临近，欧盟开始的项新措施将给跨境电商带来不少影响。。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E7%BB%A7%E5%AF%B9%E5%B0%8F%E5%8C%85%E8%A3%B9%E5%BE%81%E7%A8%8E%E5%90%8E-%E6%AC%A7%E7%9B%9F%E5%8F%88%E5%B0%86%E5%BE%81%E6%94%B6%E6%89%8B%E7%BB%AD%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793016000000.webp","sourceId":"rfi"},{"id":1793013699000,"createdDate":"2026-10-26 11:21","name":"法国国际广播电台","title":"中印边境再现波澜印官员指对峙持续 北京：望印方同中方相向而行","content":"近日，网上流传片段显示中印两军在边境对峙，中国外交部发言人郭嘉昆在周一的例行记者会上应询时表示，“希望印方同中方相向而行，共同落实双方达成的共识，以实际行动维护边境地区的和平安宁”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261026-%E4%B8%AD%E5%8D%B0%E8%BE%B9%E5%A2%83%E5%86%8D%E7%8E%B0%E6%B3%A2%E6%BE%9C%E5%8D%B0%E5%AE%98%E5%91%98%E6%8C%87%E5%AF%B9%E5%B3%99%E6%8C%81%E7%BB%AD-%E5%8C%97%E4%BA%AC-%E6%9C%9B%E5%8D%B0%E6%96%B9%E5%90%8C%E4%B8%AD%E6%96%B9%E7%9B%B8%E5%90%91%E8%80%8C%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793013699000.webp","sourceId":"rfi"},{"id":1793011429000,"createdDate":"2026-10-26 10:43","name":"法国国际广播电台","title":"欧洲思想文化长廊  【专题】希腊：欧洲文化永不磨灭的光辉：欧里庇德斯笔下的女性","content":"在希腊三大悲剧作家中，欧里庇德斯最注重女性题材。尽管妇女在希腊城邦中地位不高，但她们通过欧里庇德斯的创作，在希腊悲剧舞台上熠熠闪光。他的剧作为妇女伸张正义，表现妇女的高尚品德，描绘妇女的愤怒与复仇。他笔下涌出同情妇女的泉水，冲刷着傲慢无情的大男子主义。为此，他受攻击，遭嘲讽，但他不为所动，终使笔下人物永远流传。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261026-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E4%B8%93%E9%A2%98-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E6%AC%A7%E9%87%8C%E5%BA%87%E5%BE%B7%E6%96%AF%E7%AC%94%E4%B8%8B%E7%9A%84%E5%A5%B3%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793011429000.webp","sourceId":"rfi"},{"id":1793010348000,"createdDate":"2026-10-26 10:25","name":"法国国际广播电台","title":"中共二十大五中全会：强化治理措施 为习近平第四任期铺路？","content":"中国政治领导人周一（10月26号）开启为期四天的二十大五中全会，聚焦“全面从严治党”。与此同时，中国国家主席习近平正敦促官员们提高忠诚度和可靠性，并深化其多年来的反腐运动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261026-%E4%B8%AD%E5%85%B1%E4%BA%8C%E5%8D%81%E5%A4%A7%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A-%E5%BC%BA%E5%8C%96%E6%B2%BB%E7%90%86%E6%8E%AA%E6%96%BD-%E4%B8%BA%E4%B9%A0%E8%BF%91%E5%B9%B3%E7%AC%AC%E5%9B%9B%E4%BB%BB%E6%9C%9F%E9%93%BA%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793010348000.webp","sourceId":"rfi"},{"id":1793007771000,"createdDate":"2026-10-26 09:42","name":"法国国际广播电台","title":"蔡康永昨称望两岸友好来往 没支持过台独 今现身蒋万安竞总成立大会观摩","content":"蔡康永日前出席民进党台北市长参选人沈伯洋的竞选总部成立大会，以“蔡康永现身台独分子竞选现场”一度登上微博热搜。他在周日晚发文表示，希望两岸友好，从未支持台独。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261026-%E8%94%A1%E5%BA%B7%E6%B0%B8%E5%8F%91%E6%96%87%E7%A7%B0%E6%9C%9B%E4%B8%A4%E5%B2%B8%E5%8F%8B%E5%A5%BD%E6%9D%A5%E5%BE%80-%E6%B2%A1%E6%94%AF%E6%8C%81%E8%BF%87%E5%8F%B0%E7%8B%AC%E5%90%8E-%E7%8E%B0%E8%BA%AB%E8%92%8B%E4%B8%87%E5%AE%89%E7%AB%9E%E6%80%BB%E6%88%90%E7%AB%8B%E5%A4%A7%E4%BC%9A%E8%A7%82%E6%91%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793007771000.webp","sourceId":"rfi"},{"id":1793006567000,"createdDate":"2026-10-26 09:22","name":"法国国际广播电台","title":"蒋万安市长成立竞总大会 选情告急国民党「三子合体」到场支持","content":"台北市长蒋万安26日举行竞选总部成立大会，除了国民党「三子合体」现身会场，借此凸显国民党内部的团结。国民党主席郑丽文与民众党黄国昌也一同站台，以展现「蓝白合作」的默契。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261026-%E8%92%8B%E4%B8%87%E5%AE%89%E5%B8%82%E9%95%BF%E6%88%90%E7%AB%8B%E7%AB%9E%E6%80%BB%E5%A4%A7%E4%BC%9A-%E9%80%89%E6%83%85%E5%91%8A%E6%80%A5%E5%9B%BD%E6%B0%91%E5%85%9A-%E4%B8%89%E5%AD%90%E5%90%88%E4%BD%93-%E5%88%B0%E5%9C%BA%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793006567000.webp","sourceId":"rfi"},{"id":1793006188000,"createdDate":"2026-10-26 09:16","name":"法国国际广播电台","title":"日本前首相福田康夫逝世  中国在第一时间表示沉痛哀悼","content":"日本自民党10月26日宣布，日本前首相福田康夫于22日去世，享年90岁。高市早苗首相于26日发表首相谈话对福田康夫的逝世表示哀悼，中国外交部发言人郭嘉昆在26日的记者会上表示，我们对福田康夫前首相逝世表示沉痛哀悼，向他的家属致以诚挚慰问。福田康夫先生是中国人民的老朋友，为推动中日关系改善发展作出积极贡献。新华社等在第一时间报道了福田康夫去世的消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E6%97%A5%E6%9C%AC%E5%89%8D%E9%A6%96%E7%9B%B8%E7%A6%8F%E7%94%B0%E5%BA%B7%E5%A4%AB%E9%80%9D%E4%B8%96-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E7%AC%AC%E4%B8%80%E6%97%B6%E9%97%B4%E8%A1%A8%E7%A4%BA%E6%B2%89%E7%97%9B%E5%93%80%E6%82%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793006188000.webp","sourceId":"rfi"},{"id":1792995136000,"createdDate":"2026-10-26 06:12","name":"法国国际广播电台","title":"新皇岗口岸连续两晚人车拥堵  港府再遭狠批管理规划不善","content":"连接香港和深圳的新皇岗口岸，连续两个周末出现人流拥堵，而在刚过去的周末和周日，更连续两晚出现人流丶车流拥堵的问题。港府再次遭滞留的中国内地旅客狠批；评论指出，港府只从保安角度管理口岸，未能全盘审视口岸运作情况，导致规划和管理均有不足。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261026-%E6%96%B0%E7%9A%87%E5%B2%97%E5%8F%A3%E5%B2%B8%E8%BF%9E%E7%BB%AD%E4%B8%A4%E6%99%9A%E4%BA%BA%E8%BD%A6%E6%8B%A5%E5%A0%B5-%E6%B8%AF%E5%BA%9C%E5%86%8D%E9%81%AD%E7%8B%A0%E6%89%B9%E7%AE%A1%E7%90%86%E8%A7%84%E5%88%92%E4%B8%8D%E5%96%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1792995136000.webp","sourceId":"rfi"},{"id":1793054874000,"createdDate":"2026-10-26 22:47","name":"法国国际广播电台","title":"中国的“毒贷款”如何将赞比亚推入债务危机","content":"法国世界报周一刊出的一篇调查文章显示了，中国的“毒贷款”是如何将赞比亚推入债务危机的。法国世界报参加的国际调查记者同盟（ICIJ）发起了一项名为《中国资本》（China Capital）的合作调查。调查显示，自2010年代以来，中国成为赞比亚最大的债权国。中国工商银行等金融机构向赞比亚提供了大量贷款，用于建设电力设施、公路、机场等项目。这些资金一度帮助赞比亚推进基础设施建设，但是，部分贷款的利息高、项目的风险大，加上铜价下跌，通货膨胀上升，利率上涨，贷款成本越来越高，最终使赞比亚陷入严重的债务危机。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261026-%E4%B8%AD%E5%9B%BD%E7%9A%84-%E6%AF%92%E8%B4%B7%E6%AC%BE-%E5%A6%82%E4%BD%95%E5%B0%86%E8%B5%9E%E6%AF%94%E4%BA%9A%E6%8E%A8%E5%85%A5%E5%80%BA%E5%8A%A1%E5%8D%B1%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793054874000.webp","sourceId":"rfi"},{"id":1793054244000,"createdDate":"2026-10-26 22:37","name":"法国国际广播电台","title":"微软推出自愿离职方案，涉及约6万名员工","content":"微软10月26日（周一）宣布，将为美国、加拿大、印度和英国的约6万名员工提供一项新的自愿离职计划，约占公司员工总数的1/4。该计划是继4月份类似计划之后的第二次。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E5%BE%AE%E8%BD%AF%E6%8E%A8%E5%87%BA%E8%87%AA%E6%84%BF%E7%A6%BB%E8%81%8C%E6%96%B9%E6%A1%88%EF%BC%8C%E6%B6%89%E5%8F%8A%E7%BA%A66%E5%90%8D%E5%91%98%E5%B7%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793054244000.webp","sourceId":"rfi"},{"id":1793048900000,"createdDate":"2026-10-26 21:08","name":"法国国际广播电台","title":"以在希伯伦的军事行动：联合国警告存在“种族清洗”风险","content":"联合国人权事务高级专员沃尔克·图尔克（VolkerTürk）周一警告称，在被占领的约旦河西岸城市希伯伦存在“种族清洗”的风险。此前，两名以色列士兵于周五在希伯伦遭到袭击身亡，以色列军队随后展开了大规模军事行动。以色列称联合国调查委员会提出的新种族灭绝指控是大肆的“宣传”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261026-%E4%BB%A5%E5%9C%A8%E5%B8%8C%E4%BC%AF%E4%BC%A6%E7%9A%84%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8-%E8%81%94%E5%90%88%E5%9B%BD%E8%AD%A6%E5%91%8A%E5%AD%98%E5%9C%A8-%E7%A7%8D%E6%97%8F%E6%B8%85%E6%B4%97-%E9%A3%8E%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793048900000.webp","sourceId":"rfi"},{"id":1793048494000,"createdDate":"2026-10-26 21:01","name":"法国国际广播电台","title":"内塔尼亚胡对手埃森科特呼吁“全国团结”","content":"以色列定于本月27日举行议会选举，这是2023年本轮巴以冲突爆发以来该国首次选举，被视作对内塔尼亚胡领导的极右翼政府的检验。朝野阵营选情胶着，在野党只有“正直党”的埃森科特（GadiEisenkot）有机会挑战利库德第一大党的地位。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261026-%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E5%AF%B9%E6%89%8B%E5%9F%83%E6%A3%AE%E7%A7%91%E7%89%B9%E5%91%BC%E5%90%81-%E5%85%A8%E5%9B%BD%E5%9B%A2%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793048494000.webp","sourceId":"rfi"},{"id":1793048276000,"createdDate":"2026-10-26 20:57","name":"法国国际广播电台","title":"哥伦比亚加强与美禁毒合作","content":"哥伦比亚国防部周一宣布，预计300多名美军士兵将于周二抵达哥伦比亚，与哥伦比亚军队进行联合训练演习","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261026-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E5%8A%A0%E5%BC%BA%E4%B8%8E%E7%BE%8E%E7%A6%81%E6%AF%92%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793048276000.webp","sourceId":"rfi"},{"id":1793048149000,"createdDate":"2026-10-26 20:55","name":"法国国际广播电台","title":"美议员警告企业不得进口俄柴油","content":"10月26日，众多美国议员警告多家公司不要向美国进口俄罗斯柴油。尽管特朗普和普京达成协议，但议员们认为这种行为非法，并将面临法律和国会的制裁。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261026-%E7%BE%8E%E8%AE%AE%E5%91%98%E8%AD%A6%E5%91%8A%E4%BC%81%E4%B8%9A%E4%B8%8D%E5%BE%97%E8%BF%9B%E5%8F%A3%E4%BF%84%E6%9F%B4%E6%B2%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793048149000.webp","sourceId":"rfi"},{"id":1793047919000,"createdDate":"2026-10-26 20:51","name":"法国国际广播电台","title":"五强国防部长：欧洲“必须为自身安全承担更大责任”","content":"北约五大军事强国周一表示，应在北约内部承担“更大的政治和军事责任”，欧洲“必须为自身安全承担更大责任”，同时强调美国的支持不可或缺。五国国防部长在巴黎发表声明表示：“法国、德国、意大利、波兰和英国（E5）国防部长表示：欧洲必须承担更多自身安全责任”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261026-%E4%BA%94%E5%BC%BA%E5%9B%BD%E9%98%B2%E9%83%A8%E9%95%BF-%E6%AC%A7%E6%B4%B2-%E5%BF%85%E9%A1%BB%E4%B8%BA%E8%87%AA%E8%BA%AB%E5%AE%89%E5%85%A8%E6%89%BF%E6%8B%85%E6%9B%B4%E5%A4%A7%E8%B4%A3%E4%BB%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793047919000.webp","sourceId":"rfi"},{"id":1793047627000,"createdDate":"2026-10-26 20:47","name":"法国国际广播电台","title":"特朗普重金悬赏100万美元抓选举舞弊","content":"距离中期选举仅剩几天之际，特朗普周一承诺，任何提供信息并最终促成选举舞弊定罪的人，都将获得100万美元的奖励。特朗普在真实社交平台上写道：“任何举报过去选举或2026年中期选举中选民舞弊行为的人，在舞弊者被捕并定罪后，都将获得100万美元的奖励！”","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261026-%E7%89%B9%E6%9C%97%E6%99%AE%E9%87%8D%E9%87%91%E6%82%AC%E8%B5%8F100%E4%B8%87%E7%BE%8E%E5%85%83%E6%8A%93%E9%80%89%E4%B8%BE%E8%88%9E%E5%BC%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793047627000.webp","sourceId":"rfi"},{"id":1793047570000,"createdDate":"2026-10-26 20:46","name":"法国国际广播电台","title":"中期选举前美国前总统奥巴马打破沉默挑战特朗普","content":"上周六，美国前总统奥巴马打破沉默，在克利夫兰和底特律参加中期选举集会，与当晚也举办造势集会的美国总统特朗普形成了罕见的同期对比。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261026-%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%89%8D%E7%BE%8E%E5%9B%BD%E5%89%8D%E6%80%BB%E7%BB%9F%E5%A5%A5%E5%B7%B4%E9%A9%AC%E6%89%93%E7%A0%B4%E6%B2%89%E9%BB%98%E6%8C%91%E6%88%98%E7%89%B9%E6%9C%97%E6%99%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793047570000.webp","sourceId":"rfi"},{"id":1793047169000,"createdDate":"2026-10-26 20:39","name":"法国国际广播电台","title":"民主党敦促调查特朗普与爱泼斯坦之间的联系","content":"距离中期选举仅剩不到10天之际，美国国会民主党议员周一呼吁任命特别检察官，调查特朗普与性侵犯罪犯杰弗里·爱泼斯坦之间的联系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E6%B0%91%E4%B8%BB%E5%85%9A%E6%95%A6%E4%BF%83%E8%B0%83%E6%9F%A5%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E7%88%B1%E6%B3%BC%E6%96%AF%E5%9D%A6%E4%B9%8B%E9%97%B4%E7%9A%84%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793047169000.webp","sourceId":"rfi"},{"id":1793046468000,"createdDate":"2026-10-26 20:27","name":"法国国际广播电台","title":"术后    良十四世南美洲牧灵之旅如期举行","content":"梵蒂冈周一证实，教宗良十四世术后恢复“持续进展顺利”，将于11月6日至17日按计划出访乌拉圭、阿根廷和秘鲁。此前，他接受了肺部手术，至今已近两周。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261026-%E6%9C%AF%E5%90%8E-%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%8D%97%E7%BE%8E%E6%B4%B2%E7%89%A7%E7%81%B5%E4%B9%8B%E6%97%85%E5%A6%82%E6%9C%9F%E4%B8%BE%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793046468000.webp","sourceId":"rfi"},{"id":1793046328000,"createdDate":"2026-10-26 20:25","name":"法国国际广播电台","title":"几番周折  华裔客户获得租车公司巨额退款","content":"多伦多一名华裔男子在租车七天后，被租车公司安飞士（Avis）索要6,000加元的天价费用。经媒体介入后，安飞士承认数据输入错误并承诺退款。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261026-%E5%87%A0%E7%95%AA%E5%91%A8%E6%8A%98-%E5%8D%8E%E8%A3%94%E5%AE%A2%E6%88%B7%E8%8E%B7%E5%BE%97%E7%A7%9F%E8%BD%A6%E5%85%AC%E5%8F%B8%E5%B7%A8%E9%A2%9D%E9%80%80%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793046328000.webp","sourceId":"rfi"},{"id":1793045894000,"createdDate":"2026-10-26 20:18","name":"法国国际广播电台","title":"法前卫生部长巴尔扎赫（Michèle Barzach）辞世","content":"米歇尔·巴尔扎赫（MichèleBarzach）曾任希拉克年代的卫生部长。她是一名妇产科医生，于10月26日在巴黎去世，享年83岁。她的女儿向法新社证实了这一消息。巴尔扎赫在20世纪80年代中期经历了艾滋病疫情的急剧蔓延。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261026-%E6%B3%95%E5%89%8D%E5%8D%AB%E7%94%9F%E9%83%A8%E9%95%BF%E5%B7%B4%E5%B0%94%E6%89%8E%E8%B5%AB-mich%C3%A8le-barzach-%E8%BE%9E%E4%B8%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793045894000.webp","sourceId":"rfi"},{"id":1793045787000,"createdDate":"2026-10-26 20:16","name":"法国国际广播电台","title":"美国拟延长中国关联船舶港口费豁免至明年1月","content":"美国贸易代表署（USTR）提议，将针对中国关联船舶及部分中国制港口装卸设备的费用措施暂停期延长两个月，至2027年1月9日，为美中继续协商海事、物流及造船业贸易争端争取时间。若提案获批，相关港口费及部分设备额外关税将继续暂停，避免航运公司及出口商短期内承担额外成本。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261026-%E7%BE%8E%E5%9B%BD%E6%8B%9F%E5%BB%B6%E9%95%BF%E4%B8%AD%E5%9B%BD%E5%85%B3%E8%81%94%E8%88%B9%E8%88%B6%E6%B8%AF%E5%8F%A3%E8%B4%B9%E8%B1%81%E5%85%8D%E8%87%B3%E6%98%8E%E5%B9%B41%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793045787000.webp","sourceId":"rfi"},{"id":1793045409000,"createdDate":"2026-10-26 20:10","name":"法国国际广播电台","title":"周二以色列议会选举 内塔尼亚胡极右翼政府受检验","content":"本周二10月27日，以色列将举行议会选举，这是2023年本轮巴以冲突爆发以来该国首次选举，被视作对内塔尼亚胡领导的极右翼政府的检验。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261026-%E5%91%A8%E4%BA%8C%E4%BB%A5%E8%89%B2%E5%88%97%E8%AE%AE%E4%BC%9A%E9%80%89%E4%B8%BE-%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%94%BF%E5%BA%9C%E5%8F%97%E6%A3%80%E9%AA%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793045409000.webp","sourceId":"rfi"},{"id":1793043592000,"createdDate":"2026-10-26 19:39","name":"法国国际广播电台","title":"加蓬海上平台事故令人深感悲痛","content":"BW集团（BWGroupe）旗下挪威石油公司[BW能源]（BWEnergy）在西非国家加蓬（leGabon）西南部马永巴（Mayumba）沿海的一座石油钻探平台因作业事故于上周六晚沉没，一百一十人获救。五名失联者中，有三人是加蓬公民，另有两名外籍雇员。加蓬总统表示，他深受这起事故触动。国际金融界内的最新传闻说，有人遇难。加蓬的中文国名也有译作加彭（theGaboneseRepublic）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261026-rfi%E6%B3%95%E5%B9%BF%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%8A%A0%E8%93%AC%E6%B5%B7%E4%B8%8A%E5%B9%B3%E5%8F%B0%E4%BA%8B%E6%95%85%E4%BB%A4%E4%BA%BA%E6%B7%B1%E6%84%9F%E6%82%B2%E7%97%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793043592000.webp","sourceId":"rfi"},{"id":1793032779000,"createdDate":"2026-10-26 16:39","name":"法国国际广播电台","title":"借鉴北约第四条 日本有意与澳法等国构建双边紧急磋商机制","content":"据《读卖新闻》报导，日本政府正加紧构建一套双边紧急磋商机制，旨在确保在发生紧急事态时，能与价值观相同的志同道合国家开展有效协作。为提升协作质量并增强地区的威慑力，日本已与澳大利亚、法国等国就建立紧急磋商机制达成共识。此外，日本还计划在年内修订的《国家安全保障战略》等“安保三文件”中，明确写入加强与志同道合国家协作的方针。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261026-%E5%80%9F%E9%89%B4%E5%8C%97%E7%BA%A6%E7%AC%AC%E5%9B%9B%E6%9D%A1-%E6%97%A5%E6%9C%AC%E6%9C%89%E6%84%8F%E4%B8%8E%E6%BE%B3%E6%B3%95%E7%AD%89%E5%9B%BD%E6%9E%84%E5%BB%BA%E5%8F%8C%E8%BE%B9%E7%B4%A7%E6%80%A5%E7%A3%8B%E5%95%86%E6%9C%BA%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793032779000.webp","sourceId":"rfi"},{"id":1793032282000,"createdDate":"2026-10-26 16:31","name":"法国国际广播电台","title":"专访王军涛谈中共二十届五中全会的看点","content":"中共二十届五中全会本周一（10月26号）到周四在北京召开。这次会议锁定的主题简单说是“推进全面从严治党”，距离中共二十一大召开约一年时间之际，五中全会也成为了观察中共如何整顿干部队伍、强化权力的监督，为下一届换届建立政治纪律的一个重要窗口。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%9B%BD%E9%99%85%E7%BA%B5%E6%A8%AA/20261026-%E4%B8%93%E8%AE%BF%E7%8E%8B%E5%86%9B%E6%B6%9B%E8%B0%88%E4%B8%AD%E5%85%B1%E4%BA%8C%E5%8D%81%E5%B1%8A%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E7%9A%84%E5%87%A0%E5%A4%A7%E7%9C%8B%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793032282000.webp","sourceId":"rfi"},{"id":1793031178000,"createdDate":"2026-10-26 16:12","name":"法国国际广播电台","title":"菲美日上周在南中国海进行联演 台赠菲金门舰参与跟踪辽宁舰编队","content":"菲律宾武装部队周日（25日）表示，已在西菲律宾海（菲方对其专属经济区内南中国海海域的称呼）完成了为期六天的海上演习。此次演习由菲律宾军方和日本及美国的相关力量共同参与，旨在加强各方在海事安全、后勤保障以及搜救行动方面的协调配合。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261026-%E8%8F%B2%E7%BE%8E%E6%97%A5%E4%B8%8A%E5%91%A8%E5%9C%A8%E5%8D%97%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%BF%9B%E8%A1%8C%E8%81%94%E6%BC%94-%E5%8F%B0%E8%B5%A0%E8%8F%B2%E9%87%91%E9%97%A8%E8%88%B0%E5%8F%82%E4%B8%8E%E8%B7%9F%E8%B8%AA%E8%BE%BD%E5%AE%81%E8%88%B0%E7%BC%96%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793031178000.webp","sourceId":"rfi"},{"id":1793028639000,"createdDate":"2026-10-26 15:30","name":"法国国际广播电台","title":"欧洲多国青年抗议潮：Z世代的声音能否被倾听？","content":"从法国到意大利、从阿尔巴尼亚和葡萄牙，欧洲多国近期接连出现青年抗议。生活成本高企、住房条件恶化、就业困难、公共服务下降…，尽管各国引发示威的原因各不相同，但对社会不公的愤怒、对未来的焦虑，对体制运行的不满，跨域国界，在伴随着智能手机成长起来的Z世代中正在形成一种共同情绪。他们的声音，是否能够被得到倾听？本次专题就介绍两位法国资深记者阿勒莫尼埃（PatriciaALLEMONIERE）和达鲁（BrunoDAROUX），在与法广同属世界媒体集团的法国24台节目中对此运动风潮的观察。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E6%AC%A7%E6%B4%B2/20261026-%E6%AC%A7%E6%B4%B2%E5%A4%9A%E5%9B%BD%E9%9D%92%E5%B9%B4%E6%8A%97%E8%AE%AE%E6%BD%AE-z%E4%B8%96%E4%BB%A3%E7%9A%84%E5%A3%B0%E9%9F%B3%E8%83%BD%E5%90%A6%E5%BE%97%E5%88%B0%E5%80%BE%E5%90%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793028639000.webp","sourceId":"rfi"},{"id":1793027165000,"createdDate":"2026-10-26 15:06","name":"法国国际广播电台","title":"嘉手纳空军基地比亚迪车辆禁入令生效 其他驻日美军基地是否效仿未明","content":"出于安全方面的顾虑，美军已禁止中国汽车制造商比亚迪生产的车辆进入其位于日本冲绳县的嘉手纳空军基地。《日本时报》报导指，该禁令于周一（26日）生效，目前仅适用于嘉手纳空军基地——这是美军在亚太地区最大的空军基地。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261026-%E5%98%89%E6%89%8B%E7%BA%B3%E7%A9%BA%E5%86%9B%E5%9F%BA%E5%9C%B0%E7%A6%81%E6%AD%A2%E6%AF%94%E4%BA%9A%E8%BF%AA%E8%BD%A6%E8%BE%86%E8%BF%9B%E5%85%A5%E7%A6%81%E4%BB%A4%E7%94%9F%E6%95%88-%E5%85%B6%E4%BB%96%E9%A9%BB%E6%97%A5%E7%BE%8E%E5%86%9B%E5%9F%BA%E5%9C%B0%E6%98%AF%E5%90%A6%E6%95%88%E4%BB%BF%E4%B8%8D%E6%98%8E%E7%A1%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793027165000.webp","sourceId":"rfi"},{"id":1793024519000,"createdDate":"2026-10-26 14:21","name":"法国国际广播电台","title":"中美俄首脑或举行首次首脑峰会  日本担心什么？","content":"最近，关于于11月18日、19日在中国深圳举行的亚太经济合作组织（APEC）领导人会议，将举行中美俄三国领导人会谈的消息日益显现出实现的现实性，而三国的首脑会谈，也会对把美国作为唯一同盟国的日本造成一定的冲击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20261026-%E4%B8%AD%E7%BE%8E%E4%BF%84%E9%A6%96%E8%84%91%E6%88%96%E4%B8%BE%E8%A1%8C%E9%A6%96%E6%AC%A1%E9%A6%96%E8%84%91%E5%B3%B0%E4%BC%9A-%E6%97%A5%E6%9C%AC%E6%8B%85%E5%BF%83%E4%BB%80%E4%B9%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793024519000.webp","sourceId":"rfi"},{"id":1793023635000,"createdDate":"2026-10-26 14:07","name":"法国国际广播电台","title":"中共二十届五中全会召开 法媒聚焦习近平对军队高层的持续整肃","content":"周一法国各主要报仍然围绕众多的国内议题展开：社会危机、财政压力，周六新一轮全国示威秩序总体得以维持，国际评级穆迪出乎预料没有下调法国的主权信用评级，法国政府本避免了最坏情况的发生，暂获喘息但风险犹在。在总理勒科尔尼今天即将会见学生代表之际，工会已发出新的示威呼吁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261026-%E4%B8%AD%E5%85%B1%E4%BA%8C%E5%8D%81%E5%B1%8A%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%8F%AC%E5%BC%80-%E6%B3%95%E5%AA%92%E8%81%9A%E7%84%A6%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%AF%B9%E5%86%9B%E9%98%9F%E9%AB%98%E5%B1%82%E7%9A%84%E6%8C%81%E7%BB%AD%E6%95%B4%E8%82%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/26/1793023635000.webp","sourceId":"rfi"}]