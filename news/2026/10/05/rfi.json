[{"id":1791217878000,"createdDate":"2026-10-05 16:31","name":"法国国际广播电台","title":"法德促欧盟设置“紧急开关”必要时立即阻断中国进入欧盟市场","content":"法国总统埃马纽埃尔·马克龙和德国总理弗里德里希·默茨呼吁欧盟建立一套新的法律工具，以便在发生贸易战（尤其是与中国的贸易战）时能够更迅速做出反应。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261005-%E6%B3%95%E5%BE%B7%E4%BF%83%E6%AC%A7%E7%9B%9F%E8%AE%BE%E7%BD%AE-%E7%B4%A7%E6%80%A5%E5%BC%80%E5%85%B3-%E5%BF%85%E8%A6%81%E6%97%B6%E7%AB%8B%E5%8D%B3%E9%98%BB%E6%96%AD%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%85%A5%E6%AC%A7%E7%9B%9F%E5%B8%82%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791217878000.webp","sourceId":"rfi"},{"id":1791212102000,"createdDate":"2026-10-05 14:55","name":"法国国际广播电台","title":"美国海洋防务焦虑：甩不开中国因素","content":"大家好，欢迎收听法国报纸摘要。周一10月5日出刊的《费加罗报》和《十字架报》头版继续关注法国高中生，因为这场风波远未平息。《费加罗报》表示，尽管周五因高中生抗议活动而受到影响的场所数量较前一天减少了30%……但对执法部门而言，这是充满危险的一周；《十字架报》社论则指出，这场危机让“成年人的世界”不得不直面其责任。面对这种在某些地方已经失控的愤怒，我们该如何应对，更重要的是，该采取怎样的立场？另外，距离美国中期选举仅剩一个月之际《解放报》推出专题分析特朗普的处境，並聚焦了国会中竞争最激烈的选区。与此同时《回声报》观点栏目登出《美国面对中国的海军疑虑》分析文章。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261005-%E7%BE%8E%E5%9B%BD%E6%B5%B7%E6%B4%8B%E9%98%B2%E5%8A%A1%E7%84%A6%E8%99%91-%E7%94%A9%E4%B8%8D%E5%BC%80%E4%B8%AD%E5%9B%BD%E5%9B%A0%E7%B4%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791212102000.webp","sourceId":"rfi"},{"id":1791211635000,"createdDate":"2026-10-05 14:47","name":"法国国际广播电台","title":"印巴拒绝握手、朝韩国歌播错、台湾部长一度被拒...金牌榜外的亚运会","content":"第20届亚洲运动会亚运会10月4日在日本名古屋闭幕。这届赛事从一开始就出现不少特殊情况：从安排运动员住进邮轮、播错朝韩国歌、欢迎仪式上的台湾风波，印巴球员拒绝握手、乔装成男性，才得以在祖国训练的阿富汗女性自行车手，以及希望赢得金牌，好让队友不用服兵役的韩国高夫而运动员 …本次节目一起关注中国断崖式领先的金牌榜之外的亚运会故事。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20261005-%E5%8D%B0%E5%B7%B4%E6%8B%92%E7%BB%9D%E6%8F%A1%E6%89%8B-%E6%9C%9D%E9%9F%A9%E5%9B%BD%E6%AD%8C%E6%92%AD%E9%94%99-%E5%8F%B0%E6%B9%BE%E9%83%A8%E9%95%BF%E4%B8%80%E5%BA%A6%E8%A2%AB%E6%8B%92-%E9%87%91%E7%89%8C%E6%A6%9C%E5%A4%96%E7%9A%84%E4%BA%9A%E8%BF%90%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791211635000.webp","sourceId":"rfi"},{"id":1791211490000,"createdDate":"2026-10-05 14:44","name":"法国国际广播电台","title":"也门总统宣布发起攻势收复领土 沙特联军宣布参与“也门黎明”行动","content":"由沙特阿拉伯支持的也门政府军周一宣布，已对由亲伊朗的胡塞武装控制的首都萨那发起进攻。其发言人马吉德·纳齐利在X平台上写道：“我军已在萨那发起战略攻势”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261005-%E4%B9%9F%E9%97%A8%E6%80%BB%E7%BB%9F%E5%AE%A3%E5%B8%83%E5%8F%91%E8%B5%B7%E6%94%BB%E5%8A%BF%E6%94%B6%E5%A4%8D%E9%A2%86%E5%9C%9F-%E6%B2%99%E7%89%B9%E8%81%94%E5%86%9B%E5%AE%A3%E5%B8%83%E5%8F%82%E4%B8%8E-%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791211490000.webp","sourceId":"rfi"},{"id":1791209228000,"createdDate":"2026-10-05 14:07","name":"法国国际广播电台","title":"俄罗斯疑似鼠疫 研究所女子碰破损试管后死亡 俄方淡化 美国“密切关注”","content":"据多家俄罗斯媒体周五报道，伊尔库茨克防治鼠疫研究所一名28岁的实验室技术员达里娅·奇皮洛娃去世，此事引发了强烈担忧。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261005-%E4%BF%84%E7%BD%97%E6%96%AF%E7%96%91%E4%BC%BC%E9%BC%A0%E7%96%AB-%E7%A0%94%E7%A9%B6%E6%89%80%E5%A5%B3%E5%AD%90%E7%A2%B0%E7%A0%B4%E6%8D%9F%E8%AF%95%E7%AE%A1%E5%90%8E%E6%AD%BB%E4%BA%A1-%E4%BF%84%E6%96%B9%E6%B7%A1%E5%8C%96-%E7%BE%8E%E5%9B%BD-%E5%AF%86%E5%88%87%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791209228000.webp","sourceId":"rfi"},{"id":1791208373000,"createdDate":"2026-10-05 13:52","name":"法国国际广播电台","title":"法国债务升至119%，压力从民生传导到欧盟","content":"法国公共债务已达到国内生产总值的119%。政府计划削减540亿欧元支出，但实现年度国家预算平衡依旧艰难。法国明年的预算将再次超过欧盟的支出上限，预计国债增长至接近GDP的122%，创下新高。法国不断恶化的预算状况让整个欧洲开始担心新一轮危机何时爆发。欧盟更加关注法国的政治局势，2027年法国总统选举也让法国的经济更加不确定。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261005-%E6%B3%95%E5%9B%BD%E5%80%BA%E5%8A%A1%E5%8D%87%E8%87%B3119-%EF%BC%8C%E5%8E%8B%E5%8A%9B%E4%BB%8E%E6%B0%91%E7%94%9F%E4%BC%A0%E5%AF%BC%E5%88%B0%E6%AC%A7%E7%9B%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791208373000.webp","sourceId":"rfi"},{"id":1791206544000,"createdDate":"2026-10-05 13:22","name":"法国国际广播电台","title":"巴西大选：博索纳罗爆冷领先 三周后决选对阵卢拉","content":"巴西大选首轮投票周日结束，异于选前民调，前总统博索纳罗之子、45岁的右翼候选人弗拉维奥·博索纳罗以47%的得票率领先现任总统、80岁的左翼领袖卢拉，卢拉获得约45%的选票，两人确定将进入第二轮选举对决。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261005-%E5%B7%B4%E8%A5%BF%E5%A4%A7%E9%80%89-%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E7%88%86%E5%86%B7%E9%A2%86%E5%85%88-%E4%B8%89%E5%91%A8%E5%90%8E%E5%86%B3%E9%80%89%E5%AF%B9%E9%98%B5%E5%8D%A2%E6%8B%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791206544000.webp","sourceId":"rfi"},{"id":1791202876000,"createdDate":"2026-10-05 12:21","name":"法国国际广播电台","title":"政治豪赌：西班牙首相宣布解散议会提前大选","content":"西班牙首相桑切斯周一宣布解散议会提前举行大选。此前，上周五，议会否决了他的政府为摆脱住房危机而提出的措施。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261005-%E6%94%BF%E6%B2%BB%E8%B1%AA%E8%B5%8C-%E8%A5%BF%E7%8F%AD%E7%89%99%E9%A6%96%E7%9B%B8%E5%AE%A3%E5%B8%83%E8%A7%A3%E6%95%A3%E8%AE%AE%E4%BC%9A%E6%8F%90%E5%89%8D%E5%A4%A7%E9%80%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791202876000.webp","sourceId":"rfi"},{"id":1791201509000,"createdDate":"2026-10-05 11:58","name":"法国国际广播电台","title":"中国关闭数百家银行以巩固金融体系","content":"据金融时报4日消息，中国去年共有超过670家金融机构关闭，创下历史新高；惠誉表示，小型金融机构仍是该行业最薄弱的环节。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E4%B8%AD%E5%9B%BD%E5%85%B3%E9%97%AD%E6%95%B0%E7%99%BE%E5%AE%B6%E9%93%B6%E8%A1%8C%E4%BB%A5%E5%B7%A9%E5%9B%BA%E9%87%91%E8%9E%8D%E4%BD%93%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791201509000.webp","sourceId":"rfi"},{"id":1791197441000,"createdDate":"2026-10-05 10:50","name":"法国国际广播电台","title":"2026年诺贝尔奖季拉开帷幕：医学奖花落美国和德国","content":"10月5日，位于瑞典斯德哥尔摩的卡罗林斯卡医学院揭晓了本年度首个诺贝尔奖项——医学奖的获奖名单，也称生理学奖的这一奖项由美国科学家卡尔·代瑟罗特（KarlDeisseroth）、和两位德国科学家：彼得·黑格曼（PeterHegemann）、格奥尔格·纳格尔（GeorgNagel）三人共同获得。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261005-2026%E5%B9%B4%E8%AF%BA%E8%B4%9D%E5%B0%94%E5%A5%96%E5%AD%A3%E6%8B%89%E5%BC%80%E5%B8%B7%E5%B9%95-%E5%8C%BB%E5%AD%A6%E5%A5%96%E8%8A%B1%E8%90%BD%E7%BE%8E%E5%9B%BD%E5%92%8C%E5%BE%B7%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791197441000.webp","sourceId":"rfi"},{"id":1791189191000,"createdDate":"2026-10-05 08:33","name":"法国国际广播电台","title":"34岁美国华裔女子涉嫌监视赖清德家人在美国被捕","content":"美国联邦调查局（FBI）周日（10月4日）在洛杉矶国际机场逮捕一名34岁华裔女子，她被控受中国政府指使，在美国监视台湾总统赖清德的家人。台湾方面表示，对这一“跨国镇压”行为严厉谴责。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261005-34%E5%B2%81%E7%BE%8E%E5%9B%BD%E5%8D%8E%E8%A3%94%E5%A5%B3%E5%AD%90%E6%B6%89%E5%AB%8C%E7%9B%91%E8%A7%86%E8%B5%96%E6%B8%85%E5%BE%B7%E5%AE%B6%E4%BA%BA%E5%9C%A8%E7%BE%8E%E5%9B%BD%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791189191000.webp","sourceId":"rfi"},{"id":1791187493000,"createdDate":"2026-10-05 08:04","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉：安提戈涅：神法与人法的冲突","content":"城邦，也就是执政当局，禁止埋葬因叛国而死的自己的哥哥波吕涅克斯，但安提戈涅冒死也要给死去的亲人一个葬礼。因为在她看来，血亲关系是自然的纽带，而行政命令是外来的人为的行为。这个冲突揭示出一个人类社会在立法层面的根本问题：自然法与人定法的关系。这是一个极其重要的问题，因为在当代社会，我们眼见到专制国家以法律法治之名推行极其残酷的暴政。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261005-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E5%AE%89%E6%8F%90%E6%88%88%E6%B6%85-%E7%A5%9E%E6%B3%95%E4%B8%8E%E4%BA%BA%E6%B3%95%E7%9A%84%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791187493000.webp","sourceId":"rfi"},{"id":1791186636000,"createdDate":"2026-10-05 07:50","name":"法国国际广播电台","title":"高市施政讲演称中国是“重要邻国” 表示继续支持国际刑事法院","content":"日本时间2026年10月5日下午，日本首相高市早苗在当天召集的临时国会众参两院正式会议上发表施政演说，将“负责任的积极财政”与应对物价高涨的“消费减税”作为经济政策的核心，在谈及外交问题时，她称中国是“重要的邻国”，并表示将继续支持倍受特朗普攻讦的国际刑事法院。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261005-%E9%AB%98%E5%B8%82%E6%96%BD%E6%94%BF%E8%AE%B2%E6%BC%94%E7%A7%B0%E4%B8%AD%E5%9B%BD%E6%98%AF-%E9%87%8D%E8%A6%81%E9%82%BB%E5%9B%BD-%E8%A1%A8%E7%A4%BA%E7%BB%A7%E7%BB%AD%E6%94%AF%E6%8C%81%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791186636000.webp","sourceId":"rfi"},{"id":1791184446000,"createdDate":"2026-10-05 07:14","name":"法国国际广播电台","title":"香港「K型」经济加剧：新股集资额同比倍增 惟家庭负债率同步上升","content":"香港今年的新股集资额大幅上升，成为港府力证香港金融市场及经济表现向好的重要数据，但金融管理局(金管局)最新数据显示，香港家庭负债及私人贷款增长同步加快，情况引发关注。资深财经评论人担忧，新数据为香港破产和失业恶化响起警号；经济学者则认为，港府应该思考如何将表现不俗的「中环经济」，转化成惠及全港800万人的经济成果。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261005-%E9%A6%99%E6%B8%AF-k%E5%9E%8B-%E7%BB%8F%E6%B5%8E%E5%8A%A0%E5%89%A7-%E6%96%B0%E8%82%A1%E9%9B%86%E8%B5%84%E9%A2%9D%E5%90%8C%E6%AF%94%E5%80%8D%E5%A2%9E-%E6%83%9F%E5%AE%B6%E5%BA%AD%E8%B4%9F%E5%80%BA%E7%8E%87%E5%90%8C%E6%AD%A5%E4%B8%8A%E5%8D%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791184446000.webp","sourceId":"rfi"},{"id":1791240668000,"createdDate":"2026-10-05 22:51","name":"法国国际广播电台","title":"西伯利亚鼠疫研究所女实验员猝逝 俄民众担心爆发鼠疫","content":"西伯利亚一家鼠疫研究所实验室技术员周五突然死亡后，截至目前数十人已被隔离起来。当地媒体『贝加尔湖人民报』报道说，这位实验员很可能触碰一个破碎的试管后感染了肺鼠疫。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E8%A5%BF%E4%BC%AF%E5%88%A9%E4%BA%9A%E9%BC%A0%E7%96%AB%E7%A0%94%E7%A9%B6%E6%89%80%E5%A5%B3%E5%AE%9E%E9%AA%8C%E5%91%98%E7%8C%9D%E9%80%9D-%E4%BF%84%E6%B0%91%E4%BC%97%E6%8B%85%E5%BF%83%E7%88%86%E5%8F%91%E9%BC%A0%E7%96%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791240668000.webp","sourceId":"rfi"},{"id":1791240145000,"createdDate":"2026-10-05 22:42","name":"法国国际广播电台","title":"美国众议院中国委员会主席促美国纽黑文大学终止对华合作","content":"美国众议院中国问题特别委员会主席穆勒纳尔（JohnMoolenaar）5日要求康乃狄克州纽黑文大学（UniversityofNewHaven）尽速终止与中国西安邮电大学的合作计划，指西安邮电大学与中国军方、国防工业及“军民融合”战略关系密切，合作可能让美国人才、研究成果及技术知识被中国国防体系利用。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E7%BE%8E%E5%9B%BD%E4%BC%97%E8%AE%AE%E9%99%A2%E4%B8%AD%E5%9B%BD%E5%A7%94%E5%91%98%E4%BC%9A%E4%B8%BB%E5%B8%AD%E4%BF%83%E7%BE%8E%E5%9B%BD%E7%BA%BD%E9%BB%91%E6%96%87%E5%A4%A7%E5%AD%A6%E7%BB%88%E6%AD%A2%E5%AF%B9%E5%8D%8E%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791240145000.webp","sourceId":"rfi"},{"id":1791239618000,"createdDate":"2026-10-05 22:33","name":"法国国际广播电台","title":"中欧“最后的谈判”能否避免贸易大战？","content":"欧盟贸易专员塞夫科维奇10月8日至9日前往北京，使命重大，这是一次被形容为“最后的谈判”的贸易谈判，一旦破裂，中欧贸易战可能爆发。中国报复手段可谓庞大，首先可能便是限制甚至禁止在能源、国防、人工智能、航天等战略性领域不可或缺稀土及战略金属的出口。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E4%B8%AD%E6%AC%A7-%E6%9C%80%E5%90%8E%E7%9A%84%E8%B0%88%E5%88%A4-%E8%83%BD%E5%90%A6%E9%81%BF%E5%85%8D%E8%B4%B8%E6%98%93%E5%A4%A7%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791239618000.webp","sourceId":"rfi"},{"id":1791239501000,"createdDate":"2026-10-05 22:31","name":"法国国际广播电台","title":"中国电动车为什么越来越“短命”？","content":"法国世界报周一关注中国的电动车为什么越来越“短命”？该报表示，中国的电动车市场，有一个典型的现象：这就是，车型更新太快，刚买的新车甚至没有几个月就过时了，市场上很快就出现了配置更高但却更便宜的新车型。结果是，汽车的价值下降得很快。消费者不愿意买贵车。汽车制造商也越来越难建立长期的高端品牌。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261005-%E4%B8%AD%E5%9B%BD%E7%94%B5%E5%8A%A8%E8%BD%A6%E4%B8%BA%E4%BB%80%E4%B9%88%E8%B6%8A%E6%9D%A5%E8%B6%8A-%E7%9F%AD%E5%91%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791239501000.webp","sourceId":"rfi"},{"id":1791236993000,"createdDate":"2026-10-05 21:49","name":"法国国际广播电台","title":"法国高中生抗议运动：人权组织严厉批评警方和当局的应对方式","content":"周二是法国高中学生抗议运动的全国动员日。面对近日法国警方应对高中生示威抗议的方式，人权组织批评“失控”，国际特赦组织呼吁“降温”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261005-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E6%8A%97%E8%AE%AE%E8%BF%90%E5%8A%A8-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E4%B8%A5%E5%8E%89%E6%89%B9%E8%AF%84%E8%AD%A6%E6%96%B9%E5%92%8C%E5%BD%93%E5%B1%80%E7%9A%84%E5%BA%94%E5%AF%B9%E6%96%B9%E5%BC%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791236993000.webp","sourceId":"rfi"},{"id":1791235620000,"createdDate":"2026-10-05 21:27","name":"法国国际广播电台","title":"罗马尼亚总统提名外交官组阁 力求打破僵局避免提前选举","content":"罗马尼亚总统达恩周一（10月5日）提名一名外交官出任总理。这是他自今年5月以来提出的第四名总理候选人，旨在避免提前选举，使极右翼势力进一步壮大。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E7%BD%97%E9%A9%AC%E5%B0%BC%E4%BA%9A%E6%80%BB%E7%BB%9F%E6%8F%90%E5%90%8D%E5%A4%96%E4%BA%A4%E5%AE%98%E7%BB%84%E9%98%81-%E5%8A%9B%E6%B1%82%E6%89%93%E7%A0%B4%E5%83%B5%E5%B1%80%E9%81%BF%E5%85%8D%E6%8F%90%E5%89%8D%E9%80%89%E4%B8%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791235620000.webp","sourceId":"rfi"},{"id":1791235373000,"createdDate":"2026-10-05 21:22","name":"法国国际广播电台","title":"中国经济放缓 中日关系紧张 日本企业加速撤离中国","content":"一项最新调查显示，日本企业正以创纪录的速度撤离中国。随着中国经济增长放缓、中日关系持续紧张，日本企业加快重新评估在全球第二大经济体的业务布局。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E%E6%94%BE%E7%BC%93-%E4%B8%AD%E6%97%A5%E5%85%B3%E7%B3%BB%E7%B4%A7%E5%BC%A0-%E6%97%A5%E6%9C%AC%E4%BC%81%E4%B8%9A%E5%8A%A0%E9%80%9F%E6%92%A4%E7%A6%BB%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791235373000.webp","sourceId":"rfi"},{"id":1791234724000,"createdDate":"2026-10-05 21:12","name":"法国国际广播电台","title":"鲁比奥访问冰岛 美国持续推进北极战略","content":"美国国务卿鲁比奥周一（10月5日）抵达冰岛进行短暂访问。在美国就格陵兰岛达成安全协议后，鲁比奥此行将继续推进华盛顿在北极地区的战略布局。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E9%B2%81%E6%AF%94%E5%A5%A5%E8%AE%BF%E9%97%AE%E5%86%B0%E5%B2%9B-%E7%BE%8E%E5%9B%BD%E6%8C%81%E7%BB%AD%E6%8E%A8%E8%BF%9B%E5%8C%97%E6%9E%81%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791234724000.webp","sourceId":"rfi"},{"id":1791234453000,"createdDate":"2026-10-05 21:07","name":"法国国际广播电台","title":"巴西总统选举：弗拉维奥·博索纳罗首轮领先卢拉 特朗普祝贺其取得“重大胜利”","content":"美国总统特朗普周一(10月5日）称赞其盟友弗拉维奥·博索纳罗在巴西总统选举首轮投票中取得“重大胜利”。最新结果显示，这位前极右翼总统之子以47%的得票率领先于获得45%选票的左翼现任总统卢拉，两人将于10月25日展开第二轮对决。多国右翼领导人表示祝贺，选举结果推动圣保罗股市周一开盘上涨超过8%。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261005-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE-%E5%BC%97%E6%8B%89%E7%BB%B4%E5%A5%A5%C2%B7%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E9%A6%96%E8%BD%AE%E9%A2%86%E5%85%88%E5%8D%A2%E6%8B%89-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A5%9D%E8%B4%BA%E5%85%B6%E5%8F%96%E5%BE%97-%E9%87%8D%E5%A4%A7%E8%83%9C%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791234453000.webp","sourceId":"rfi"},{"id":1791230905000,"createdDate":"2026-10-05 20:08","name":"法国国际广播电台","title":"黑海货船起火致死伤，涉俄乌土耳其罗马尼亚等国","content":"10月5日路透社消息，日前一艘货船在罗马尼亚领海外的黑海海域发生火灾，两人死亡，多名船员获救。乌克兰方面称此船由土耳其拥有，船上有阿塞拜疆公民和印度公民，同时指责此事由俄罗斯无人机造成。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261005-%E9%BB%91%E6%B5%B7%E8%B4%A7%E8%88%B9%E8%B5%B7%E7%81%AB%E8%87%B4%E6%AD%BB%E4%BC%A4%EF%BC%8C%E6%B6%89%E4%BF%84%E4%B9%8C%E5%9C%9F%E8%80%B3%E5%85%B6%E7%BD%97%E9%A9%AC%E5%B0%BC%E4%BA%9A%E7%AD%89%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791230905000.webp","sourceId":"rfi"},{"id":1791226801000,"createdDate":"2026-10-05 19:00","name":"法国国际广播电台","title":"非洲:刚果(金)战乱中抗击埃博拉","content":"法兰西第七届全国人道主义会议（7eConférencenationalehumanitaire-CNH）将于2026年10月06日（星期二）在巴黎开幕。当今世界多地的重大危机被列入会议议题，其中包括处于战乱中的非洲国家刚果民主共和国（laRDCongo）和苏丹（leSoudan），中东地区的加沙（Gaza），以及欧洲大陆的乌克兰（l’Ukraine）。在此背景下，本台-法国国际广播电台非洲组（RFIAfrique）今天（2026年10月05日星期一）发布的一则最新法文报道，聚焦联合国驻刚果民主共和国维和部队（MONUSCO）与刚果（金）军方如何支持应对第17轮本迪布焦型埃博拉病毒（EbolaBundibugyo）疫情。在刚果（金）东部疫区，如何确保抗疫行动能够安全接触当地民众，并在复杂的安全环境下开展防疫，依然是一项严峻挑战。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261005-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%88%9A%E6%9E%9C-%E9%87%91-%E6%88%98%E4%B9%B1%E4%B8%AD%E6%8A%97%E5%87%BB%E5%9F%83%E5%8D%9A%E6%8B%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/05/1791226801000.webp","sourceId":"rfi"}]