[{"id":1791872792000,"createdDate":"2026-10-13 06:26","name":"法国国际广播电台","title":"香港黄之锋狱中六渡生辰 欧洲议会报告促放黄之锋等政治犯暂未如愿","content":"今(13日)天是在囚泛民主派年轻核心之一的黄之锋三十岁生辰，在此之前不足一星期，欧洲议会通过「关於欧盟与中国政治关系的建议」，当中呼吁释放黄之锋等多位香港政治犯，并暂停引渡安排。中国外交部和港府表明反对，但人权团体则藉此点明，议会的建议表示，欧盟与北京打交道时，不能不管香港，敦促欧盟成员国向中国政府提出要求。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E9%A6%99%E6%B8%AF%E9%BB%84%E4%B9%8B%E9%94%8B%E7%8B%B1%E4%B8%AD%E5%85%AD%E6%B8%A1%E7%94%9F%E8%BE%B0-%E6%AC%A7%E6%B4%B2%E8%AE%AE%E4%BC%9A%E6%8A%A5%E5%91%8A%E4%BF%83%E6%94%BE%E9%BB%84%E4%B9%8B%E9%94%8B%E7%AD%89%E6%94%BF%E6%B2%BB%E7%8A%AF%E6%9A%82%E6%9C%AA%E5%A6%82%E6%84%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791872792000.webp","sourceId":"rfi"},{"id":1791905833000,"createdDate":"2026-10-13 15:37","name":"法国国际广播电台","title":"国际货币基金组织：下调中国经济增长，上调全球经济增长","content":"国际货币基金组织周二在曼谷公布报告，小幅下调了中国经济增长预期，同时轻微上调了全球经济增长，指出美国和亚洲增长强劲，其中预计台湾增长10.7%。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261013-%E5%9B%BD%E9%99%85%E8%B4%A7%E5%B8%81%E5%9F%BA%E9%87%91%E7%BB%84%E7%BB%87-%E4%B8%8B%E8%B0%83%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF%EF%BC%8C%E4%B8%8A%E8%B0%83%E5%85%A8%E7%90%83%E7%BB%8F%E6%B5%8E%E5%A2%9E%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791905833000.webp","sourceId":"rfi"},{"id":1791903182000,"createdDate":"2026-10-13 14:53","name":"法国国际广播电台","title":"刚果（金）前总统卡比拉变身该国东部反叛联盟首领","content":"刚果（金）前总统约瑟夫·卡比拉目前作为反对派人士，因叛国罪面临死刑判决，现已成为一个新的政治军事运动的领导人，该运动包括邻国卢旺达支持的M23组织，这证实了他与该反政府武装的关系，M23控制着该国东部的大片领土。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261013-%E5%88%9A%E6%9E%9C-%E9%87%91-%E5%89%8D%E6%80%BB%E7%BB%9F%E5%8D%A1%E6%AF%94%E6%8B%89%E5%8F%98%E8%BA%AB%E8%AF%A5%E5%9B%BD%E4%B8%9C%E9%83%A8%E5%8F%8D%E5%8F%9B%E8%81%94%E7%9B%9F%E9%A6%96%E9%A2%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791903182000.webp","sourceId":"rfi"},{"id":1791901353000,"createdDate":"2026-10-13 14:22","name":"法国国际广播电台","title":"法国高中生发起第五轮抗议，瑞典环保少女现身支援","content":"厌倦了“这个只提供失业和不稳定生活的社会”，法国数以万计的人，包括年轻人和教师，于10月13日又一次走上街头。这是他们的“第五轮动员行动”。新一轮示威意外得到了瑞典环保活动人士格蕾塔·通贝里的支持。法国政府试图给这场持续数周的运动降温，但学生组织要求政府明确回应诉求。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261013-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E5%8F%91%E8%B5%B7%E7%AC%AC%E4%BA%94%E8%BD%AE%E6%8A%97%E8%AE%AE%EF%BC%8C%E7%91%9E%E5%85%B8%E7%8E%AF%E4%BF%9D%E5%B0%91%E5%A5%B3%E7%8E%B0%E8%BA%AB%E6%94%AF%E6%8F%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791901353000.webp","sourceId":"rfi"},{"id":1791900288000,"createdDate":"2026-10-13 14:04","name":"法国国际广播电台","title":"视频 2026年第20届欧莱雅-联合国教科文组织表彰“投身科学女性”","content":"35位杰出法国女性科研人员荣获第20届欧莱雅-联合国教科文组织“投身科学女性”奖，欧莱雅女性基金10月6日颁奖表彰她们在生物学、物理学、化学、数学、计算机科学、工程学等科学领域取得的成就，获奖者们在各自领域展现了卓越的专业知识，该奖项致力于通过鼓励女性参加科研创造一个更公平、更可持续的未来，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E8%A7%86%E9%A2%91-2026%E5%B9%B4%E7%AC%AC20%E5%B1%8A%E6%AC%A7%E8%8E%B1%E9%9B%85-%E8%81%94%E5%90%88%E5%9B%BD%E6%95%99%E7%A7%91%E6%96%87%E7%BB%84%E7%BB%87%E8%A1%A8%E5%BD%B0-%E6%8A%95%E8%BA%AB%E7%A7%91%E5%AD%A6%E5%A5%B3%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791900288000.webp","sourceId":"rfi"},{"id":1791898849000,"createdDate":"2026-10-13 13:40","name":"法国国际广播电台","title":"中共五中全会将召开 18项维稳密令涉敏感外国人情报收集和行为预判","content":"中央社13日电：中共20届五中全会将于10月26日起在北京召开；X平台「爆点周刊」（BaodianTimes）引述密档披露中共为此次会议部署18项维稳安保措施，包括加强有关敏感外国人情报收集和行为预判。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%B0%86%E5%8F%AC%E5%BC%80-18%E9%A1%B9%E7%BB%B4%E7%A8%B3%E5%AF%86%E4%BB%A4%E6%B6%89%E6%95%8F%E6%84%9F%E5%A4%96%E5%9B%BD%E4%BA%BA%E6%83%85%E6%8A%A5%E6%94%B6%E9%9B%86%E5%92%8C%E8%A1%8C%E4%B8%BA%E9%A2%84%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791898849000.webp","sourceId":"rfi"},{"id":1791894727000,"createdDate":"2026-10-13 12:32","name":"法国国际广播电台","title":"韩国将推进建设韩国型三轴体系、人工智能及有人与无人协同作战系统的战力","content":"韩国防卫事业厅表示，将适时推进韩国型三轴体系、人工智能（AI）及有人-无人协同作战系统等核心战力建设，并研发尖端技术，从而确保技术主权。这是防卫事业厅当天在向韩国国会国防委员会提交的国政监查工作报告中阐述的。报告说，这是为了应对朝鲜核武及大规模杀伤性武器威胁，以及确保收回战时作战指挥权的能力。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261013-%E9%9F%A9%E5%9B%BD%E5%B0%86%E6%8E%A8%E8%BF%9B%E5%BB%BA%E8%AE%BE%E9%9F%A9%E5%9B%BD%E5%9E%8B%E4%B8%89%E8%BD%B4%E4%BD%93%E7%B3%BB-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%8F%8A%E6%9C%89%E4%BA%BA%E4%B8%8E%E6%97%A0%E4%BA%BA%E5%8D%8F%E5%90%8C%E4%BD%9C%E6%88%98%E7%B3%BB%E7%BB%9F%E7%9A%84%E6%88%98%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791894727000.webp","sourceId":"rfi"},{"id":1791894273000,"createdDate":"2026-10-13 12:24","name":"法国国际广播电台","title":"美国国务院：特朗普政府反对中国“胁迫和攻击”行使主权权利的国家","content":"路透社13日消息，美国国务院表示，特朗普政府反对中国针对行使自己主权权利的国家实施“胁迫和攻击”。此前，北京因伯利兹和巴拉圭两名部长与台湾的联系而对他们实施制裁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261013-%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%8A%A1%E9%99%A2-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%8F%8D%E5%AF%B9%E4%B8%AD%E5%9B%BD-%E8%83%81%E8%BF%AB%E5%92%8C%E6%94%BB%E5%87%BB-%E8%A1%8C%E4%BD%BF%E4%B8%BB%E6%9D%83%E6%9D%83%E5%88%A9%E7%9A%84%E5%9B%BD%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791894273000.webp","sourceId":"rfi"},{"id":1791893264000,"createdDate":"2026-10-13 12:07","name":"法国国际广播电台","title":"黑海商船再遇袭11人失踪 保加利亚召见俄大使 北约调整部署 欧盟强烈谴责","content":"保加利亚总理周二宣布，再有两艘商船在黑海保加利亚近海遭到袭击。此次袭击造成11人失踪，并导致北约调整部署，拉德夫总理随后召见了俄罗斯大使。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261013-%E9%BB%91%E6%B5%B7%E5%95%86%E8%88%B9%E5%86%8D%E9%81%87%E8%A2%AD11%E4%BA%BA%E5%A4%B1%E8%B8%AA-%E4%BF%9D%E5%8A%A0%E5%88%A9%E4%BA%9A%E5%8F%AC%E8%A7%81%E4%BF%84%E5%A4%A7%E4%BD%BF-%E5%8C%97%E7%BA%A6%E8%B0%83%E6%95%B4%E9%83%A8%E7%BD%B2-%E6%AC%A7%E7%9B%9F%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791893264000.webp","sourceId":"rfi"},{"id":1791892506000,"createdDate":"2026-10-13 11:55","name":"法国国际广播电台","title":"法广独家： IPCC第三小组主席收受石油公司奖励","content":"今年九月中旬，由多家欧洲媒体（包括《人道报》和《卫报》）组成的联盟披露了联合国政府间气候变化专门委员会（IPCC）第三工作小组的11位作者均受雇于沙特石油利益集团之后，一位不愿意透露姓名的IPCC前执行委员会成员向法广披露说IPCC第三工作组的马来西亚籍联合主席接受了一家石油公司基金的奖励。此一消息再度凸显了IPCC在处理利益冲突方面存在困难。而本周，IPCC的成员们正汇聚在非洲的埃塞俄比亚，试图进一步推动第七次气候变化评估报告的起草工作，而该报告具体应该何时发表也是一个敏感话题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261013-%E6%B3%95%E5%B9%BF%E7%8B%AC%E5%AE%B6-ipcc%E7%AC%AC%E4%B8%89%E5%B0%8F%E7%BB%84%E4%B8%BB%E5%B8%AD%E6%94%B6%E5%8F%97%E7%9F%B3%E6%B2%B9%E5%85%AC%E5%8F%B8%E5%A5%96%E5%8A%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791892506000.webp","sourceId":"rfi"},{"id":1791881765000,"createdDate":"2026-10-13 08:56","name":"法国国际广播电台","title":"中石油子公司在尼日尔发生喷涌泄漏已超两周，尼方称构成“极严重环境事故”","content":"综合法新社、路透社消息，尼日尔东北部沙漠地区自9月底以来持续发生原油和天然气喷涌事件。尼日尔石油部10月13日星期一晚间发布公报称，这一事件已构成“程度极其严重”的环境事故。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261013-%E4%B8%AD%E7%9F%B3%E6%B2%B9%E5%AD%90%E5%85%AC%E5%8F%B8%E5%9C%A8%E5%B0%BC%E6%97%A5%E5%B0%94%E5%8F%91%E7%94%9F%E5%96%B7%E6%B6%8C%E6%B3%84%E6%BC%8F%E5%B7%B2%E8%B6%85%E4%B8%A4%E5%91%A8%EF%BC%8C%E5%B0%BC%E6%96%B9%E7%A7%B0%E6%9E%84%E6%88%90-%E6%9E%81%E4%B8%A5%E9%87%8D%E7%8E%AF%E5%A2%83%E4%BA%8B%E6%95%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791881765000.webp","sourceId":"rfi"},{"id":1791880551000,"createdDate":"2026-10-13 08:35","name":"法国国际广播电台","title":"中国将跨境镇压伸向台湾两友邦政要 台湾致力抵制任何霸权极权的扩张","content":"中国外交部对台湾友邦巴拉圭与贝里斯两位友台政要祭出「饭制措施」。台湾官员表示，中国此举为对台跨国镇压的新模式。且台湾将持续抵制任何霸权极权的扩张。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261013-%E4%B8%AD%E5%9B%BD%E5%B0%86%E8%B7%A8%E5%A2%83%E9%95%87%E5%8E%8B%E4%BC%B8%E5%90%91%E5%8F%B0%E6%B9%BE%E4%B8%A4%E5%8F%8B%E9%82%A6%E6%94%BF%E8%A6%81-%E5%8F%B0%E6%B9%BE%E8%87%B4%E5%8A%9B%E6%8A%B5%E5%88%B6%E4%BB%BB%E4%BD%95%E9%9C%B8%E6%9D%83%E6%9E%81%E6%9D%83%E7%9A%84%E6%89%A9%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791880551000.webp","sourceId":"rfi"},{"id":1791880145000,"createdDate":"2026-10-13 08:29","name":"法国国际广播电台","title":"朝鲜发射弹道导弹  日美韩当局紧急举行协议","content":"10月13日，针对朝鲜于10月12日发射弹道导弹一事，日美韩三国外交部门负责朝鲜事务的官员举行了电话磋商。参加磋商的有日本外务省亚洲大洋洲局审议官有吉孝史、韩国外交部朝鲜半岛政策局局长白镛填（音译：白永镇），以及美国国务院助理国务卿代理戴维·维拉佐尔。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261013-%E6%9C%9D%E9%B2%9C%E5%8F%91%E5%B0%84%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9-%E6%97%A5%E7%BE%8E%E9%9F%A9%E5%BD%93%E5%B1%80%E7%B4%A7%E6%80%A5%E4%B8%BE%E8%A1%8C%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791880145000.webp","sourceId":"rfi"},{"id":1791931267000,"createdDate":"2026-10-13 22:41","name":"法国国际广播电台","title":"万润南周年追思会：“他们能让我流亡却不能让我成为奴隶”","content":"四通公司创办人、流亡海外的民运领袖万润南逝世一周年。10月13日，数十名生活在海外的中国民运人士，生前友好通过视频参加了这一由欧洲之声主办的纪念大会。与会者称赞万润南是“中国民主运动中一座象征良知与勇气的精神灯塔”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E4%B8%87%E6%B6%A6%E5%8D%97%E5%91%A8%E5%B9%B4%E8%BF%BD%E6%80%9D%E4%BC%9A-%E4%BB%96%E4%BB%AC%E8%83%BD%E8%AE%A9%E6%88%91%E6%B5%81%E4%BA%A1%E5%8D%B4%E4%B8%8D%E8%83%BD%E8%AE%A9%E6%88%91%E6%88%90%E4%B8%BA%E5%A5%B4%E9%9A%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791931267000.webp","sourceId":"rfi"},{"id":1791930784000,"createdDate":"2026-10-13 22:33","name":"法国国际广播电台","title":"薄熙来搭档黄奇帆  不倒翁为何倒了","content":"两天前海外社交网络突然传出前重庆市长黄奇帆被抓的消息，令人难以置信，周二，官媒宣布，黄奇帆“涉嫌违纪违法”，传言落地成真！这位“政坛不倒翁”，终于栽倒了。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E8%96%84%E7%86%99%E6%9D%A5%E6%90%AD%E6%A1%A3%E9%BB%84%E5%A5%87%E5%B8%86-%E4%B8%8D%E5%80%92%E7%BF%81%E4%B8%BA%E4%BD%95%E5%80%92%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791930784000.webp","sourceId":"rfi"},{"id":1791929087000,"createdDate":"2026-10-13 22:04","name":"法国国际广播电台","title":"巴黎车展显示：欧洲车企仍有实力和信心与中国车企较量","content":"在巴黎车展开幕之际，法国世界报周二刊出文章认为，欧洲车企仍然有底气与中国车企较量。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261013-%E5%B7%B4%E9%BB%8E%E8%BD%A6%E5%B1%95%E6%98%BE%E7%A4%BA-%E6%AC%A7%E6%B4%B2%E8%BD%A6%E4%BC%81%E4%BB%8D%E6%9C%89%E5%AE%9E%E5%8A%9B%E5%92%8C%E4%BF%A1%E5%BF%83%E4%B8%8E%E4%B8%AD%E5%9B%BD%E8%BD%A6%E4%BC%81%E8%BE%83%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791929087000.webp","sourceId":"rfi"},{"id":1791928947000,"createdDate":"2026-10-13 22:02","name":"法国国际广播电台","title":"俄罗斯指控一名日本记者从事间谍活动，并将其逮捕","content":"法新社报道，俄罗斯周二宣布，在远东地区的萨哈林岛逮捕了一名日本记者。该记者供职于日本地方报纸《北海道新闻》，俄罗斯指控其从事间谍活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261013-%E4%BF%84%E7%BD%97%E6%96%AF%E6%8C%87%E6%8E%A7%E4%B8%80%E5%90%8D%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%EF%BC%8C%E5%B9%B6%E5%B0%86%E5%85%B6%E9%80%AE%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791928947000.webp","sourceId":"rfi"},{"id":1791927307000,"createdDate":"2026-10-13 21:35","name":"法国国际广播电台","title":"中国诈骗案比特币归属之争：伦敦裁决或使英国保留部分巨额资产","content":"法新社周二（10月13日）援引知情人士报道，伦敦一家法院就一起中国大规模诈骗案作出的裁决，可能增加英国财政部保留部分涉案比特币的机会。英国警方在该案中查获约6.1万枚比特币，目前估值约50亿美元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E4%B8%AD%E5%9B%BD%E8%AF%88%E9%AA%97%E6%A1%88%E6%AF%94%E7%89%B9%E5%B8%81%E5%BD%92%E5%B1%9E%E4%B9%8B%E4%BA%89-%E4%BC%A6%E6%95%A6%E8%A3%81%E5%86%B3%E6%88%96%E4%BD%BF%E8%8B%B1%E5%9B%BD%E4%BF%9D%E7%95%99%E9%83%A8%E5%88%86%E5%B7%A8%E9%A2%9D%E8%B5%84%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791927307000.webp","sourceId":"rfi"},{"id":1791927093000,"createdDate":"2026-10-13 21:31","name":"法国国际广播电台","title":"资生堂旗下法国公司起诉希音不正当竞争 索赔超过260万欧元","content":"日本化妆品集团资生堂旗下的一家法国公司周二（10月13日）起诉电商巨头希音，指控其未经授权销售该公司的美容产品，构成不正当竞争，并请求法院判令希音赔偿逾260万欧元。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E8%B5%84%E7%94%9F%E5%A0%82%E6%97%97%E4%B8%8B%E6%B3%95%E5%9B%BD%E5%85%AC%E5%8F%B8%E8%B5%B7%E8%AF%89%E5%B8%8C%E9%9F%B3%E4%B8%8D%E6%AD%A3%E5%BD%93%E7%AB%9E%E4%BA%89-%E7%B4%A2%E8%B5%94%E8%B6%85%E8%BF%87260%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791927093000.webp","sourceId":"rfi"},{"id":1791926838000,"createdDate":"2026-10-13 21:27","name":"法国国际广播电台","title":"法国高中生再度上街誓言“不放弃”政府称抗议势头减弱","content":"法国高中生和大学生周二(10月13日）再次大规模走上街头，誓言“绝不放弃”，政府则评估抗议规模正在减弱。示威组织者号召学生参加周六反“生活成本高涨”的示威行列。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E5%86%8D%E5%BA%A6%E4%B8%8A%E8%A1%97%E8%AA%93%E8%A8%80-%E4%B8%8D%E6%94%BE%E5%BC%83-%E6%94%BF%E5%BA%9C%E7%A7%B0%E6%8A%97%E8%AE%AE%E5%8A%BF%E5%A4%B4%E5%87%8F%E5%BC%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791926838000.webp","sourceId":"rfi"},{"id":1791926623000,"createdDate":"2026-10-13 21:23","name":"法国国际广播电台","title":"台湾外长提醒欧洲：依赖中国供应链恐危及自由与主权","content":"台湾外交部长林佳龙周二（10月13日）在波兰发表演讲，他告诫欧盟依赖中国供应商可能危及自身自由。欧盟领导人即将在布鲁塞尔举行峰会，对华贸易将是重要议题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E5%8F%B0%E6%B9%BE%E5%A4%96%E9%95%BF%E6%8F%90%E9%86%92%E6%AC%A7%E6%B4%B2-%E4%BE%9D%E8%B5%96%E4%B8%AD%E5%9B%BD%E4%BE%9B%E5%BA%94%E9%93%BE%E6%81%90%E5%8D%B1%E5%8F%8A%E8%87%AA%E7%94%B1%E4%B8%8E%E4%B8%BB%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791926623000.webp","sourceId":"rfi"},{"id":1791926287000,"createdDate":"2026-10-13 21:18","name":"法国国际广播电台","title":"特朗普指责胡塞武装在美国中期选举前蓄意推高油价","content":"美国总统特朗普周二（10月13日）指责也门胡塞武装试图在美国中期选举前“推高油价”，但并未宣布加大对沙特阿拉伯的支持。沙特周二空袭也门首都，胡塞武装誓言还击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8C%87%E8%B4%A3%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E5%9C%A8%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%89%8D%E8%93%84%E6%84%8F%E6%8E%A8%E9%AB%98%E6%B2%B9%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791926287000.webp","sourceId":"rfi"},{"id":1791926105000,"createdDate":"2026-10-13 21:15","name":"法国国际广播电台","title":"沙特联军确认空袭也门 利雅得传出爆炸 军方称拦截多枚导弹","content":"沙特主导的军事联军周二（10月13日）确认，对也门境内为胡塞武装作战提供支撑的设施发动空袭，并宣布在利雅得上空拦截多枚导弹。沙特首都当天传出爆炸声。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261013-%E6%B2%99%E7%89%B9%E8%81%94%E5%86%9B%E7%A1%AE%E8%AE%A4%E7%A9%BA%E8%A2%AD%E4%B9%9F%E9%97%A8-%E5%88%A9%E9%9B%85%E5%BE%97%E4%BC%A0%E5%87%BA%E7%88%86%E7%82%B8-%E5%86%9B%E6%96%B9%E7%A7%B0%E6%8B%A6%E6%88%AA%E5%A4%9A%E6%9E%9A%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/13/1791926105000.webp","sourceId":"rfi"}]