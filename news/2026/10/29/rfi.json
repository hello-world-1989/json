[{"id":1793251283000,"createdDate":"2026-10-29 05:21","name":"法国国际广播电台","title":"奢侈品：这项新税可能会让中国富人更加低调","content":"中国的奢侈品新税措施可能会让中国富人更加低调。自新冠病毒疫情引发房地产危机以来，中国的奢侈品消费一直低迷。如今，一项针对中国富豪海外信托基金的新税收政策令各大品牌感到担忧。原因如下。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261029-%E5%A5%A2%E4%BE%88%E5%93%81-%E8%BF%99%E9%A1%B9%E6%96%B0%E7%A8%8E%E5%8F%AF%E8%83%BD%E4%BC%9A%E8%AE%A9%E4%B8%AD%E5%9B%BD%E5%AF%8C%E4%BA%BA%E6%9B%B4%E5%8A%A0%E4%BD%8E%E8%B0%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793251283000.webp","sourceId":"rfi"},{"id":1793276075000,"createdDate":"2026-10-29 12:14","name":"法国国际广播电台","title":"欧盟与加拿大在蒙特利尔举行峰会，谋求大幅提升伙伴关系","content":"欧洲联盟与加拿大29日起在蒙特利尔举行峰会，有意在当前动荡的国际形势下，进一步紧密合作关系，将伙伴关系提升到前所未有的水平。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261029-%E6%AC%A7%E7%9B%9F%E4%B8%8E%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%9C%A8%E8%92%99%E7%89%B9%E5%88%A9%E5%B0%94%E4%B8%BE%E8%A1%8C%E5%B3%B0%E4%BC%9A%EF%BC%8C%E8%B0%8B%E6%B1%82%E5%A4%A7%E5%B9%85%E6%8F%90%E5%8D%87%E4%BC%99%E4%BC%B4%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793276075000.webp","sourceId":"rfi"},{"id":1793273764000,"createdDate":"2026-10-29 11:36","name":"法国国际广播电台","title":"五中全会闭幕 军委副主席张升民入政治局 确认张又侠、刘建超等33人开除党籍","content":"据官媒新华社周四发布的中共二十届五中全会公报显示，全会审议并通过了中央纪委和中央军委分别提交的18名党政官员及16名军方人员严重违纪违法问题审查报告，确认中央政治局此前作出的处分决定，包括给予张又侠、刘振立、马兴瑞、刘建超等33人开除党籍处分，以及给予李云泽撤销党内职务处分。全会增选张升民为中央政治局委员。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261029-%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E9%97%AD%E5%B9%95-%E5%86%9B%E5%A7%94%E5%89%AF%E4%B8%BB%E5%B8%AD%E5%BC%A0%E5%8D%87%E6%B0%91%E5%85%A5%E6%94%BF%E6%B2%BB%E5%B1%80-%E7%A1%AE%E8%AE%A4%E5%88%98%E5%BB%BA%E8%B6%85-%E5%BC%A0%E5%8F%88%E4%BE%A0%E7%AD%8933%E4%BA%BA%E5%BC%80%E9%99%A4%E5%85%9A%E7%B1%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793273764000.webp","sourceId":"rfi"},{"id":1793270548000,"createdDate":"2026-10-29 10:42","name":"法国国际广播电台","title":"中方指责公器私用 称多数东盟国家质疑反对 菲防长指是中方立场，非东盟立场","content":"就记者提问：“今年，中国防长未出席在菲律宾举行的第13届东盟防长扩大会，中方派武官参会，请问是出于什么考虑？”中国国防部新闻发言人张晓刚在当地时间周四下午的例行记者会上回应称，“作为本届东盟防长扩大会轮值主席国，菲方放任个别政客肆意妄为、公器私用，重重设障阻碍中方参会，严重破坏东盟协商一致原则，严重违背东盟防长扩大会开放包容精神，不符合基本外交礼仪，损害中方作为机制成员的正当权利，多数东盟国家纷纷予以质疑和反对”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261029-%E4%B8%AD%E6%96%B9%E6%8C%87%E8%B4%A3%E5%85%AC%E5%99%A8%E7%A7%81%E7%94%A8-%E7%A7%B0%E5%A4%9A%E6%95%B0%E4%B8%9C%E7%9B%9F%E5%9B%BD%E5%AE%B6%E8%B4%A8%E7%96%91%E5%8F%8D%E5%AF%B9-%E8%8F%B2%E9%98%B2%E9%95%BF%E6%8C%87%E8%BF%99%E6%98%AF%E4%B8%AD%E6%96%B9%E7%AB%8B%E5%9C%BA%EF%BC%8C%E9%9D%9E%E4%B8%9C%E7%9B%9F%E7%AB%8B%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793270548000.webp","sourceId":"rfi"},{"id":1793270044000,"createdDate":"2026-10-29 10:34","name":"法国国际广播电台","title":"宏福苑大火事隔近一年 港府高层鞠躬道歉 一名局长下台称负责","content":"造成香港77年来最多人死亡的大埔宏福苑火灾发生後近一年，香港行政长官李家超终於带领七名司局长向灾民及市民鞠躬致歉，而房屋局长何永贤则请辞，作为为事件负上政治责任的表现。另外，当局会将大维修工程出现的「围标」行为刑事化以减少工程受贪腐侵蚀，更会成立新的法定组织去支援居民进行大维修。但对多名记者质疑其他司局长应否负上政治责任，则被特首李家超严辞回应，声称这是他的政治决定，令其他司局长毋须开腔回应。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261029-%E5%AE%8F%E7%A6%8F%E8%8B%91%E5%A4%A7%E7%81%AB%E4%BA%8B%E9%9A%94%E8%BF%91%E4%B8%80%E5%B9%B4-%E6%B8%AF%E5%BA%9C%E9%AB%98%E5%B1%82%E9%9E%A0%E8%BA%AC%E9%81%93%E6%AD%89-%E4%B8%80%E5%90%8D%E5%B1%80%E9%95%BF%E4%B8%8B%E5%8F%B0%E7%A7%B0%E8%B4%9F%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793270044000.webp","sourceId":"rfi"},{"id":1793269578000,"createdDate":"2026-10-29 10:26","name":"法国国际广播电台","title":"全球安全动荡 美提议新东盟防务框架","content":"当今世界局势动荡，亚洲安全同样受到影响。围绕与中国的主权争端不断升级，南海地区与中印边境冲突频发。随着美日韩、美英澳（AUKUS）三边合作、四边机制（QUAD）等多边安全构架不断强化，美防长提出建立美国-东盟防务框架。东南亚国家在经济与安保之间的平衡难度加大，惟求继续维持多边对话机制且不断升级有效的风险管控。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261029-%E5%85%A8%E7%90%83%E5%AE%89%E5%85%A8%E5%8A%A8%E8%8D%A1-%E7%BE%8E%E6%8F%90%E8%AE%AE%E6%96%B0%E4%B8%9C%E7%9B%9F%E9%98%B2%E5%8A%A1%E6%A1%86%E6%9E%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793269578000.webp","sourceId":"rfi"},{"id":1793269529000,"createdDate":"2026-10-29 10:25","name":"法国国际广播电台","title":"日剧《别班》被指“抹黑中国” 三丽鸥登公告道歉","content":"拥有玉桂狗、美乐蒂、酷洛米等高人气角色的日本三丽鸥，此前与TBS电视台推出联名产品日剧《别班》（VIVANT），在中国媒体上引发批评，被指“严重抹黑中国”。三丽鸥于日本时间29日更新了官方网站，宣布终止与TBS电视剧《别班》的联名商品企划，并对此表示歉意。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261029-%E6%97%A5%E5%89%A7-%E5%88%AB%E7%8F%AD-%E8%A2%AB%E6%8C%87-%E6%8A%B9%E9%BB%91%E4%B8%AD%E5%9B%BD-%E4%B8%89%E4%B8%BD%E9%B8%A5%E7%99%BB%E5%85%AC%E5%91%8A%E9%81%93%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793269529000.webp","sourceId":"rfi"},{"id":1793268348000,"createdDate":"2026-10-29 10:05","name":"法国国际广播电台","title":"德国总统在北大演讲提中国不应在其他市场造成单方依赖","content":"德国总统施泰因迈尔（Frank-WalterSteinmeier）周四在北京大学发表演讲时指出，中国在追求经济自给自足的过程中，绝不能在其他市场造成单方面依赖。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261029-%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%BB%9F%E5%9C%A8%E5%8C%97%E5%A4%A7%E6%BC%94%E8%AE%B2%E6%8F%90%E4%B8%AD%E5%9B%BD%E4%B8%8D%E5%BA%94%E5%9C%A8%E5%85%B6%E4%BB%96%E5%B8%82%E5%9C%BA%E9%80%A0%E6%88%90%E5%8D%95%E6%96%B9%E9%9D%A2%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793268348000.webp","sourceId":"rfi"},{"id":1793259512000,"createdDate":"2026-10-29 07:38","name":"法国国际广播电台","title":"美财政官员在港会晤七美资大行 谈美元角色及经济安全","content":"首次在香港举行的亚太经济合作组织（APEC）财长会议，上周虽已曲终人散，但与会官员部分活动细节近日才曝光，当中，美国财政部国际事务次长布艾琳(ErinBrowne音译)公布，在港期间，除会晤与会官员商讨双边合作事宜外，还与七间美资大行的香港高层会晤，听取对方就美元角色和「经济安全」等议题的在地意见。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261029-%E7%BE%8E%E8%B4%A2%E6%94%BF%E5%AE%98%E5%91%98%E5%9C%A8%E6%B8%AF%E4%BC%9A%E6%99%A4%E4%B8%83%E7%BE%8E%E8%B5%84%E5%A4%A7%E8%A1%8C-%E8%B0%88%E7%BE%8E%E5%85%83%E8%A7%92%E8%89%B2%E5%8F%8A%E7%BB%8F%E6%B5%8E%E5%AE%89%E5%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793259512000.webp","sourceId":"rfi"},{"id":1793308563000,"createdDate":"2026-10-29 21:16","name":"法国国际广播电台","title":"俄喷射无人机击中乌第聂伯罗火车站一月台至少13死5伤","content":"乌克兰东南部大城第聂伯罗（Dnipro）火车站的1个月台在10月29日遭到1架俄罗斯无人机击中，当时有1列火车停靠月台旁，造成至少13人死亡，另有至少5人受伤。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261029-%E4%BF%84%E5%96%B7%E5%B0%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%87%BB%E4%B8%AD%E4%B9%8C%E7%AC%AC%E8%81%82%E4%BC%AF%E7%BD%97%E7%81%AB%E8%BD%A6%E7%AB%99%E4%B8%80%E6%9C%88%E5%8F%B0%E8%87%B3%E5%B0%9113%E6%AD%BB5%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793308563000.webp","sourceId":"rfi"},{"id":1793306845000,"createdDate":"2026-10-29 20:47","name":"法国国际广播电台","title":"31日法将出动7万名警察和宪兵维护治安","content":"法国内政部长洛朗·努涅斯宣布，为应对周六计划举行的第三轮街头抗议活动，将动员约7万名警察和宪兵。他表示，此次“特殊部署”将持续进行，并警告称当天“公共秩序混乱的风险极高”。周六派出的警力多达7万人。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261029-31%E6%97%A5%E6%B3%95%E5%B0%86%E5%87%BA%E5%8A%A87%E4%B8%87%E5%90%8D%E8%AD%A6%E5%AF%9F%E5%92%8C%E5%AE%AA%E5%85%B5%E7%BB%B4%E6%8A%A4%E6%B2%BB%E5%AE%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793306845000.webp","sourceId":"rfi"},{"id":1793306483000,"createdDate":"2026-10-29 20:41","name":"法国国际广播电台","title":"12个欧盟国家将投放4260万桶石油     其中一半是柴油","content":"根据周四发布的一份声明，12个欧盟成员国将根据七国集团（G7）框架内作出的承诺，从其战略储备中释放约4260万桶石油，其中一半为柴油。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261029-12%E4%B8%AA%E6%AC%A7%E7%9B%9F%E5%9B%BD%E5%AE%B6%E5%B0%86%E6%8A%95%E6%94%BE4260%E4%B8%87%E6%A1%B6%E7%9F%B3%E6%B2%B9-%E5%85%B6%E4%B8%AD%E4%B8%80%E5%8D%8A%E6%98%AF%E6%9F%B4%E6%B2%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793306483000.webp","sourceId":"rfi"},{"id":1793306214000,"createdDate":"2026-10-29 20:36","name":"法国国际广播电台","title":"民主党议员要求特朗普保留与AI的聊天记录","content":"美国国会民主党议员已要求白宫保存所有与特朗普使用人工智能聊天机器人就国家安全问题做出决策相关的文档，以应对国会可能展开的调查。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261029-%E6%B0%91%E4%B8%BB%E5%85%9A%E8%AE%AE%E5%91%98%E8%A6%81%E6%B1%82%E7%89%B9%E6%9C%97%E6%99%AE%E4%BF%9D%E7%95%99%E4%B8%8Eai%E7%9A%84%E8%81%8A%E5%A4%A9%E8%AE%B0%E5%BD%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793306214000.webp","sourceId":"rfi"},{"id":1793305997000,"createdDate":"2026-10-29 20:33","name":"法国国际广播电台","title":"姆巴佩或将被迫向中国支付数百万欧元！","content":"来自中国的最新消息对姆巴佩来说无疑是雪上加霜，他可能不得不向此前与他签约的公司支付巨额赔偿金。媒体报道称，“品牌方可以根据合同中的违约赔偿条款直接提出索赔，包括偿还已支付的费用以及赔偿违约金和广告材料损失。”因此，姆巴佩可能被迫向终止合作的公司支付巨额赔偿金……","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261029-%E5%A7%86%E5%B7%B4%E4%BD%A9%E6%88%96%E5%B0%86%E8%A2%AB%E8%BF%AB%E5%90%91%E4%B8%AD%E5%9B%BD%E6%94%AF%E4%BB%98%E6%95%B0%E7%99%BE%E4%B8%87%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305997000.webp","sourceId":"rfi"},{"id":1793305758000,"createdDate":"2026-10-29 20:29","name":"法国国际广播电台","title":"法《鸟类呼唤》获得2026年小说大奖","content":"法国文学院于周四将2026年小说大奖授予作家塞巴斯蒂安·拉帕克（SébastienLapaque），获奖作品为诗意盎然的《鸟类的呼唤》（Lerappeldesoiseaux，ActesSud出版社）。小说讲述了一个名叫Noé（诺埃）的角色，在失去挚爱Azou陷入痛苦后，跟随鸟儿的歌声踏上类似亚西西的圣方济各（Françoisd'Assise）足迹的内省与疗愈之旅。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261029-%E6%B3%95-%E9%B8%9F%E7%B1%BB%E5%91%BC%E5%94%A4-%E8%8E%B7%E5%BE%972026%E5%B9%B4%E5%B0%8F%E8%AF%B4%E5%A4%A7%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305758000.webp","sourceId":"rfi"},{"id":1793305511000,"createdDate":"2026-10-29 20:25","name":"法国国际广播电台","title":"伊武装部队：四艘油轮穿过霍尔木兹时触雷起火","content":"伊朗武装部队周四声称，又有四艘油轮在霍尔木兹海峡触雷起火，而华盛顿方面则坚称已基本清除该区域的水雷。伊朗伊斯兰革命卫队（IRGC）最初曾表示，三艘“违规”船只“在试图使用海峡南部未经授权的航线时触雷爆炸起火”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261029-%E4%BC%8A%E6%AD%A6%E8%A3%85%E9%83%A8%E9%98%9F-%E5%9B%9B%E8%89%98%E6%B2%B9%E8%BD%AE%E7%A9%BF%E8%BF%87%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%97%B6%E8%A7%A6%E9%9B%B7%E8%B5%B7%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305511000.webp","sourceId":"rfi"},{"id":1793305364000,"createdDate":"2026-10-29 20:22","name":"法国国际广播电台","title":"人工智能：加拿大向Cohere投资16亿加元","content":"加拿大总理马克·卡尼周四宣布，加拿大将向其国家人工智能公司Cohere投资16亿加元（约合10亿欧元），以确保人工智能的发展方向不会由“其他地方”决定。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261029-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%90%91cohere%E6%8A%95%E8%B5%8416%E4%BA%BF%E5%8A%A0%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305364000.webp","sourceId":"rfi"},{"id":1793305252000,"createdDate":"2026-10-29 20:20","name":"法国国际广播电台","title":"一架欧盟部队直升机在波斯尼亚坠毁   死伤多人","content":"欧盟驻波黑部队（EUFOR）指挥部在一份声明中表示，一架意大利军用直升机坠毁，造成多名欧盟驻波黑部队成员死亡，另有多人重伤。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261029-%E4%B8%80%E6%9E%B6%E6%AC%A7%E7%9B%9F%E9%83%A8%E9%98%9F%E7%9B%B4%E5%8D%87%E6%9C%BA%E5%9C%A8%E6%B3%A2%E6%96%AF%E5%B0%BC%E4%BA%9A%E5%9D%A0%E6%AF%81-%E6%AD%BB%E4%BC%A4%E5%A4%9A%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305252000.webp","sourceId":"rfi"},{"id":1793305015000,"createdDate":"2026-10-29 20:16","name":"法国国际广播电台","title":"油价和物价困扰着美国选民","content":"美国中期选举让民众最关心的是油价和物价。和许多美国人一样，马修·摩尔（MatthewMoore）很担心生活成本，而特朗普政府执政期间，生活成本持续上涨。这位63岁的律师在劳德代尔堡提前投票后感叹道，物价上涨“影响着交通、商品，方方面面”。他把票投给了民主党。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261029-%E6%B2%B9%E4%BB%B7%E5%92%8C%E7%89%A9%E4%BB%B7%E5%9B%B0%E6%89%B0%E7%9D%80%E7%BE%8E%E5%9B%BD%E9%80%89%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793305015000.webp","sourceId":"rfi"},{"id":1793304809000,"createdDate":"2026-10-29 20:13","name":"法国国际广播电台","title":"英影视演员斯图尔特离世   享年83岁","content":"英国演员帕特里克·斯图尔特（SirPatrickStewart）逝世，享年83岁。他主演了《星际迷航》和《X战警》。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261029-%E8%8B%B1%E5%BD%B1%E8%A7%86%E6%BC%94%E5%91%98%E6%96%AF%E5%9B%BE%E5%B0%94%E7%89%B9%E7%A6%BB%E4%B8%96-%E4%BA%AB%E5%B9%B483%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793304809000.webp","sourceId":"rfi"},{"id":1793304457000,"createdDate":"2026-10-29 20:07","name":"法国国际广播电台","title":"非洲 :马里社会的两桩重大事件","content":"非洲内陆国马里（leMali）的各大高校因教职员工和研究人员的大罢工陷入瘫痪，工会的号召得到响应。另外，马里传统的多佐（Dozos）猎人在没有驻军守卫的地区与圣战者爆发冲突。这是本台法广非洲组（RFIAfrique）2026年10月29日星期四的关注焦点之一。据报，马里多佐（dozos）猎人一位首领的儿子在战斗中被杀。马里的中文国名也有译作馬利共和国（RepublicofMali）。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261029-rfi%E6%B3%95%E5%B9%BF%E4%B8%AD%E6%96%87-%E2%80%93-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E2%80%93%E9%9D%9E%E6%B4%B2-%E9%A9%AC%E9%87%8C%E7%A4%BE%E4%BC%9A%E7%9A%84%E4%B8%A4%E6%A1%A9%E9%87%8D%E5%A4%A7%E4%BA%8B%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793304457000.webp","sourceId":"rfi"},{"id":1793303564000,"createdDate":"2026-10-29 19:52","name":"法国国际广播电台","title":"美国联邦通信委员会禁止中国实验室为美国市场产品测试","content":"美国联邦通信委员会（FCC）29日表决通过新规，禁止中国实验室及其他未与美国建立互认机制的国家和地区之检测实验室、认证机构，为销往美国市场的电子产品进行测试。新规预计于2028年12月生效，涵盖智能手机、相机、电脑等设备。美方表示，此举是为了加强国家安全、保障通讯网络及知识产权，并要求外国检测机构给予美国同等市场待遇。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261029-%E7%BE%8E%E5%9B%BD%E8%81%94%E9%82%A6%E9%80%9A%E4%BF%A1%E5%A7%94%E5%91%98%E4%BC%9A%E7%A6%81%E6%AD%A2%E4%B8%AD%E5%9B%BD%E5%AE%9E%E9%AA%8C%E5%AE%A4%E4%B8%BA%E7%BE%8E%E5%9B%BD%E5%B8%82%E5%9C%BA%E4%BA%A7%E5%93%81%E6%B5%8B%E8%AF%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793303564000.webp","sourceId":"rfi"},{"id":1793303166000,"createdDate":"2026-10-29 19:46","name":"法国国际广播电台","title":"旅意中国维权人士“李老师”遭跟踪监视威胁案有新进展","content":"中央社10月29日发自罗马的报道显示：旅居意大利的知名中国维权人士“李老师”遭跟踪监视威胁案有了新的进展：米兰检方已侦结10名嫌犯。这些嫌犯向“反对中国国家主席习近平政策的中国侨民”施加恐吓，被控多项罪名。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261029-%E6%97%85%E6%84%8F%E4%B8%AD%E5%9B%BD%E7%BB%B4%E6%9D%83%E4%BA%BA%E5%A3%AB-%E6%9D%8E%E8%80%81%E5%B8%88-%E9%81%AD%E8%B7%9F%E8%B8%AA%E7%9B%91%E8%A7%86%E5%A8%81%E8%83%81%E6%A1%88%E6%9C%89%E6%96%B0%E8%BF%9B%E5%B1%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793303166000.webp","sourceId":"rfi"},{"id":1793295692000,"createdDate":"2026-10-29 17:41","name":"法国国际广播电台","title":"美国将在日本建空对空导弹总装厂 宣布增加对菲军队现代化资助","content":"日本防卫大臣小泉进次郎表示，美日两国已达成协议，将在日本建立一处设施，用于联合生产先进中程空对空导弹。这是美日两国采取的最新举措；此前，双方已多次对中国在亚洲日益强硬的姿态和扩军表示关切。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261029-%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%9C%A8%E6%97%A5%E6%9C%AC%E5%BB%BA%E7%A9%BA%E5%AF%B9%E7%A9%BA%E5%AF%BC%E5%BC%B9%E6%80%BB%E8%A3%85%E5%8E%82-%E5%A2%9E%E5%8A%A0%E5%AF%B9%E8%8F%B2%E5%86%9B%E9%98%9F%E7%8E%B0%E4%BB%A3%E5%8C%96%E8%B5%84%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793295692000.webp","sourceId":"rfi"},{"id":1793291638000,"createdDate":"2026-10-29 16:33","name":"法国国际广播电台","title":"法国足协主席：姆巴佩无意侮辱或冒犯中国人民","content":"法国足球协会主席迪亚洛（PhilippeDiallo）在周四接受《法国西部报》采访时，为身兼西甲皇马球员的法国男足国家队队长姆巴佩（KylianMbappé）进行了辩护，称围绕姆巴佩关于由其形象合成的基于中国前领导人毛泽东宣传画的梗图的言论所引发的争议“有些过为有力”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261029-%E6%B3%95%E5%9B%BD%E8%B6%B3%E5%8D%8F%E4%B8%BB%E5%B8%AD-%E5%A7%86%E5%B7%B4%E4%BD%A9%E6%97%A0%E6%84%8F%E4%BE%AE%E8%BE%B1%E6%88%96%E5%86%92%E7%8A%AF%E4%B8%AD%E5%9B%BD%E4%BA%BA%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793291638000.webp","sourceId":"rfi"},{"id":1793288485000,"createdDate":"2026-10-29 15:41","name":"法国国际广播电台","title":"五角大楼发布新《太空安全挑战》报告 中国航天飞机高清在轨照片曝光","content":"周一，美国国防情报局发布了一份新报告，评估了敌手在太空领域所构成威胁的范围与宽度，其中包含了一张迄今为止最清晰的中国高度机密航天飞机的图像。这张照片进一步印证了中国在太空领域的进展；美国国防情报局的调查结果，也让人们得以一窥北京在​​轨道武器方面的扩充情况。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261029-%E4%BA%94%E8%A7%92%E5%A4%A7%E6%A5%BC%E5%8F%91%E5%B8%83%E6%96%B0-%E5%A4%AA%E7%A9%BA%E5%AE%89%E5%85%A8%E6%8C%91%E6%88%98-%E6%8A%A5%E5%91%8A-%E4%B8%AD%E5%9B%BD%E8%88%AA%E5%A4%A9%E9%A3%9E%E6%9C%BA%E9%AB%98%E6%B8%85%E5%9C%A8%E8%BD%A8%E7%85%A7%E7%89%87%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793288485000.webp","sourceId":"rfi"},{"id":1793287906000,"createdDate":"2026-10-29 15:31","name":"法国国际广播电台","title":"非洲:第17轮埃博拉确诊病例破万","content":"非洲大陆上埃博拉第17轮疫情的确诊病例已于2026年10月27日星期二破万。疫区也已开始从非洲中部向东非和西非地区扩散。一旦恶化，没有哪个国家可以置身事外。这是本台法广非洲组（RFIAfrique）今天2026年10月29日星期四的关注焦点之一。尼日利亚(leNigeria)当局现已要求所有过关旅客，填写一份在线健康申报表。非洲埃博拉疫情的区域形势需要“更多支持”（Ebola:lasituationrégionaleappelle«àdavantagedesoutien»）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261029-rfi%E6%B3%95%E5%B9%BF%E4%B8%AD%E6%96%87-%E2%80%93-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E2%80%93-%E9%9D%9E%E6%B4%B2-%E7%AC%AC17%E8%BD%AE%E5%9F%83%E5%8D%9A%E6%8B%89%E7%A1%AE%E8%AF%8A%E7%97%85%E4%BE%8B%E7%A0%B4%E4%B8%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793287906000.webp","sourceId":"rfi"},{"id":1793283934000,"createdDate":"2026-10-29 14:25","name":"法国国际广播电台","title":"在姆巴佩的“独裁者门”事件之后 西班牙和法国是否会受到影响？","content":"周四法国刊出的各大全国性报纸头版主要关注西班牙周三发生的火车撞车事故，以及以色列的立法大选。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261029-%E5%9C%A8%E5%A7%86%E5%B7%B4%E4%BD%A9%E7%9A%84-%E7%8B%AC%E8%A3%81%E8%80%85%E9%97%A8-%E4%BA%8B%E4%BB%B6%E4%B9%8B%E5%90%8E-%E8%A5%BF%E7%8F%AD%E7%89%99%E5%92%8C%E6%B3%95%E5%9B%BD%E6%98%AF%E5%90%A6%E4%BC%9A%E5%8F%97%E5%88%B0%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793283934000.webp","sourceId":"rfi"},{"id":1793281114000,"createdDate":"2026-10-29 13:38","name":"法国国际广播电台","title":"中国女高管与黄仁勋密切往来 美认定情报资产 特朗普据报知情未行动","content":"据《纽约时报》报导称，一位与英伟达首席执行官黄仁勋一度关系密切的中国女商人被发现曾向北京传递情报。美国总统特朗普获悉此事后，并未采取任何行动。新加坡一家数据中心公司的一名高管因涉嫌将英伟达的先进人工智能（AI）芯片输送至中国而受到监控。如今，美国官员已认定她是中国的情报资产，向北京方面输送信息。但接下来发生的事更令人警觉：对这名高管——中国公民黄小乐（英文名AliceHuang）——的监控显示，她与黄仁勋建立了密切关系。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261029-%E4%B8%AD%E5%9B%BD%E5%A5%B3%E9%AB%98%E7%AE%A1%E4%B8%8E%E9%BB%84%E4%BB%81%E5%8B%8B%E5%AF%86%E5%88%87%E5%BE%80%E6%9D%A5-%E7%BE%8E%E8%AE%A4%E5%AE%9A%E6%83%85%E6%8A%A5%E8%B5%84%E4%BA%A7-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8D%AE%E6%8A%A5%E7%9F%A5%E6%83%85%E6%9C%AA%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/29/1793281114000.webp","sourceId":"rfi"}]