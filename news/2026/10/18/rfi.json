[{"id":1792323513000,"createdDate":"2026-10-18 11:38","name":"法国国际广播电台","title":"菲美能源部长会谈 拟扩大在能源安全领域的双边合作","content":"菲律宾能源部长加林（SharonS.Garin）周四在华盛顿会见了美国能源部长赖特（ChrisWright）。据悉，双方探讨了扩大双边合作的议题，旨在加强菲律宾的能源安全、实现能源供应多元化，并推动本土能源资源的开发。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261018-%E8%8F%B2%E7%BE%8E%E8%83%BD%E6%BA%90%E9%83%A8%E9%95%BF%E4%BC%9A%E8%B0%88-%E6%8B%9F%E6%89%A9%E5%A4%A7%E5%9C%A8%E8%83%BD%E6%BA%90%E5%AE%89%E5%85%A8%E9%A2%86%E5%9F%9F%E7%9A%84%E5%8F%8C%E8%BE%B9%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792323513000.webp","sourceId":"rfi"},{"id":1792320913000,"createdDate":"2026-10-18 10:55","name":"法国国际广播电台","title":"马克龙是如何与法国年轻人走向决裂的","content":"各位好，欢迎收听本期的法国报纸摘要。由于10月18日星期日本台订阅的法国主流日刊大多不出刊，我们为您选取出刊的法国世界报的重点做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261018-%E9%A9%AC%E5%85%8B%E9%BE%99%E6%98%AF%E5%A6%82%E4%BD%95%E4%B8%8E%E6%B3%95%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%BA%BA%E8%B5%B0%E5%90%91%E5%86%B3%E8%A3%82%E7%9A%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792320913000.webp","sourceId":"rfi"},{"id":1792320590000,"createdDate":"2026-10-18 10:49","name":"法国国际广播电台","title":"中国对高市早苗向靖国神社供奉祭品表示强烈谴责 韩国表示遗憾","content":"日本首相高市早苗于17日，在东京九段北的靖国神社开始举行秋季例行大祭的第一天，以“内阁总理大臣高市早苗”的名义，向神社供奉了祭祀用品真榊（一种用于神道祭祀的供品）。为此，中国驻日使馆17日发表《驻日本使馆发言人就日方涉靖国神社消极动向答记者问》一文指出：中方强烈谴责日方涉靖国神社消极动向。韩国外交部17日就高市早苗首相在靖国神社秋季例行大祭期间奉纳供品一事发表发言人评论。评论称：“对于日本负有责任的领导人再次向美化日本过去侵略战争、合祀战争罪犯的靖国神社奉纳供品或反复参拜一事，我们再次表示深深的失望和遗憾。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%90%91%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE%E4%BE%9B%E5%A5%89%E7%A5%AD%E5%93%81%E8%A1%A8%E7%A4%BA%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3-%E9%9F%A9%E5%9B%BD%E8%A1%A8%E7%A4%BA%E9%81%97%E6%86%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792320590000.webp","sourceId":"rfi"},{"id":1792319134000,"createdDate":"2026-10-18 10:25","name":"法国国际广播电台","title":"卢比奥率团飞抵乌兹别克 华盛顿加强在中亚的布局","content":"美国国务卿卢比奥周日抵达乌兹别克斯坦，展开中亚和南亚之行。华盛顿希望通过加强经贸合作，扩大在这一战略地区的影响力，并在与俄罗斯和中国的竞争中争取更大空间。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E5%8D%A2%E6%AF%94%E5%A5%A5%E7%8E%87%E5%9B%A2%E9%A3%9E%E6%8A%B5%E4%B9%8C%E5%85%B9%E5%88%AB%E5%85%8B-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%8A%A0%E5%BC%BA%E5%9C%A8%E4%B8%AD%E4%BA%9A%E7%9A%84%E5%B8%83%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792319134000.webp","sourceId":"rfi"},{"id":1792318534000,"createdDate":"2026-10-18 10:15","name":"法国国际广播电台","title":"共和党议员抨击特朗普给予俄制裁豁免 格雷厄姆之妹指要和特朗普座谈","content":"多位美国国会共和党议员猛烈抨击了特朗普总统的一项决定，即豁免一项上月通过的、旨在限制俄罗斯能源出口的关税法律。这些议员认为，此举将有助于莫斯科继续对乌克兰的战争并从中获益。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E5%85%B1%E5%92%8C%E5%85%9A%E8%AE%AE%E5%91%98%E6%8A%A8%E5%87%BB%E7%89%B9%E6%9C%97%E6%99%AE%E7%BB%99%E4%BA%88%E4%BF%84%E5%88%B6%E8%A3%81%E8%B1%81%E5%85%8D-%E6%A0%BC%E9%9B%B7%E5%8E%84%E5%A7%86%E4%B9%8B%E5%A6%B9%E6%8C%87%E8%A6%81%E5%92%8C%E7%89%B9%E6%9C%97%E6%99%AE%E5%BA%A7%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792318534000.webp","sourceId":"rfi"},{"id":1792314865000,"createdDate":"2026-10-18 09:14","name":"法国国际广播电台","title":"图斯克称已受邀访华 ：绝不允许波兰成为特洛伊木马或第五纵队","content":"在布鲁塞尔举行的为期两天的欧盟峰会结束后，波兰总理图斯克（DonaldTusk）宣布，他已向其他领导人通报了自己收到中方邀请一事。他补充说，对中国的正式访问可能会在今年晚些时候进行。图斯克强调，波兰在对华关系中将维护欧盟的共同利益。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261018-%E5%9B%BE%E6%96%AF%E5%85%8B%E7%A7%B0%E5%B7%B2%E5%8F%97%E9%82%80%E8%AE%BF%E5%8D%8E-%E7%BB%9D%E4%B8%8D%E5%85%81%E8%AE%B8%E6%B3%A2%E5%85%B0%E6%88%90%E4%B8%BA%E7%89%B9%E6%B4%9B%E4%BC%8A%E6%9C%A8%E9%A9%AC%E6%88%96%E7%AC%AC%E4%BA%94%E7%BA%B5%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792314865000.webp","sourceId":"rfi"},{"id":1792303767000,"createdDate":"2026-10-18 06:09","name":"法国国际广播电台","title":"意大利多地反生活成本上涨示威演变为暴力冲突，警方动用催泪弹和高压水炮","content":"综合美联社、路透社报道，10月17日，意大利米兰和博洛尼亚发生了抗议活动，其中米兰市中心出现严重的警民冲突。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E6%84%8F%E5%A4%A7%E5%88%A9%E5%A4%9A%E5%9C%B0%E5%8F%8D%E7%94%9F%E6%B4%BB%E6%88%90%E6%9C%AC%E4%B8%8A%E6%B6%A8%E7%A4%BA%E5%A8%81%E6%BC%94%E5%8F%98%E4%B8%BA%E6%9A%B4%E5%8A%9B%E5%86%B2%E7%AA%81%EF%BC%8C%E8%AD%A6%E6%96%B9%E5%8A%A8%E7%94%A8%E5%82%AC%E6%B3%AA%E5%BC%B9%E5%92%8C%E9%AB%98%E5%8E%8B%E6%B0%B4%E7%82%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792303767000.webp","sourceId":"rfi"}]