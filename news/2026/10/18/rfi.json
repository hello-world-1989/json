[{"id":1792323513000,"createdDate":"2026-10-18 11:38","name":"法国国际广播电台","title":"菲美能源部长会谈 拟扩大在能源安全领域的双边合作","content":"菲律宾能源部长加林（SharonS.Garin）周四在华盛顿会见了美国能源部长赖特（ChrisWright）。据悉，双方探讨了扩大双边合作的议题，旨在加强菲律宾的能源安全、实现能源供应多元化，并推动本土能源资源的开发。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261018-%E8%8F%B2%E7%BE%8E%E8%83%BD%E6%BA%90%E9%83%A8%E9%95%BF%E4%BC%9A%E8%B0%88-%E6%8B%9F%E6%89%A9%E5%A4%A7%E5%9C%A8%E8%83%BD%E6%BA%90%E5%AE%89%E5%85%A8%E9%A2%86%E5%9F%9F%E7%9A%84%E5%8F%8C%E8%BE%B9%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792323513000.webp","sourceId":"rfi"},{"id":1792320913000,"createdDate":"2026-10-18 10:55","name":"法国国际广播电台","title":"马克龙是如何与法国年轻人走向决裂的","content":"各位好，欢迎收听本期的法国报纸摘要。由于10月18日星期日本台订阅的法国主流日刊大多不出刊，我们为您选取出刊的法国世界报的重点做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261018-%E9%A9%AC%E5%85%8B%E9%BE%99%E6%98%AF%E5%A6%82%E4%BD%95%E4%B8%8E%E6%B3%95%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%BA%BA%E8%B5%B0%E5%90%91%E5%86%B3%E8%A3%82%E7%9A%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792320913000.webp","sourceId":"rfi"},{"id":1792320590000,"createdDate":"2026-10-18 10:49","name":"法国国际广播电台","title":"中国对高市早苗向靖国神社供奉祭品表示强烈谴责 韩国表示遗憾","content":"日本首相高市早苗于17日，在东京九段北的靖国神社开始举行秋季例行大祭的第一天，以“内阁总理大臣高市早苗”的名义，向神社供奉了祭祀用品真榊（一种用于神道祭祀的供品）。为此，中国驻日使馆17日发表《驻日本使馆发言人就日方涉靖国神社消极动向答记者问》一文指出：中方强烈谴责日方涉靖国神社消极动向。韩国外交部17日就高市早苗首相在靖国神社秋季例行大祭期间奉纳供品一事发表发言人评论。评论称：“对于日本负有责任的领导人再次向美化日本过去侵略战争、合祀战争罪犯的靖国神社奉纳供品或反复参拜一事，我们再次表示深深的失望和遗憾。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%90%91%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE%E4%BE%9B%E5%A5%89%E7%A5%AD%E5%93%81%E8%A1%A8%E7%A4%BA%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3-%E9%9F%A9%E5%9B%BD%E8%A1%A8%E7%A4%BA%E9%81%97%E6%86%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792320590000.webp","sourceId":"rfi"},{"id":1792319134000,"createdDate":"2026-10-18 10:25","name":"法国国际广播电台","title":"卢比奥率团飞抵乌兹别克 华盛顿加强在中亚的布局","content":"美国国务卿卢比奥周日抵达乌兹别克斯坦，展开中亚和南亚之行。华盛顿希望通过加强经贸合作，扩大在这一战略地区的影响力，并在与俄罗斯和中国的竞争中争取更大空间。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E5%8D%A2%E6%AF%94%E5%A5%A5%E7%8E%87%E5%9B%A2%E9%A3%9E%E6%8A%B5%E4%B9%8C%E5%85%B9%E5%88%AB%E5%85%8B-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%8A%A0%E5%BC%BA%E5%9C%A8%E4%B8%AD%E4%BA%9A%E7%9A%84%E5%B8%83%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792319134000.webp","sourceId":"rfi"},{"id":1792318534000,"createdDate":"2026-10-18 10:15","name":"法国国际广播电台","title":"共和党议员抨击特朗普给予俄制裁豁免 格雷厄姆之妹指要和特朗普座谈","content":"多位美国国会共和党议员猛烈抨击了特朗普总统的一项决定，即豁免一项上月通过的、旨在限制俄罗斯能源出口的关税法律。这些议员认为，此举将有助于莫斯科继续对乌克兰的战争并从中获益。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E5%85%B1%E5%92%8C%E5%85%9A%E8%AE%AE%E5%91%98%E6%8A%A8%E5%87%BB%E7%89%B9%E6%9C%97%E6%99%AE%E7%BB%99%E4%BA%88%E4%BF%84%E5%88%B6%E8%A3%81%E8%B1%81%E5%85%8D-%E6%A0%BC%E9%9B%B7%E5%8E%84%E5%A7%86%E4%B9%8B%E5%A6%B9%E6%8C%87%E8%A6%81%E5%92%8C%E7%89%B9%E6%9C%97%E6%99%AE%E5%BA%A7%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792318534000.webp","sourceId":"rfi"},{"id":1792314865000,"createdDate":"2026-10-18 09:14","name":"法国国际广播电台","title":"图斯克称已受邀访华 ：绝不允许波兰成为特洛伊木马或第五纵队","content":"在布鲁塞尔举行的为期两天的欧盟峰会结束后，波兰总理图斯克（DonaldTusk）宣布，他已向其他领导人通报了自己收到中方邀请一事。他补充说，对中国的正式访问可能会在今年晚些时候进行。图斯克强调，波兰在对华关系中将维护欧盟的共同利益。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261018-%E5%9B%BE%E6%96%AF%E5%85%8B%E7%A7%B0%E5%B7%B2%E5%8F%97%E9%82%80%E8%AE%BF%E5%8D%8E-%E7%BB%9D%E4%B8%8D%E5%85%81%E8%AE%B8%E6%B3%A2%E5%85%B0%E6%88%90%E4%B8%BA%E7%89%B9%E6%B4%9B%E4%BC%8A%E6%9C%A8%E9%A9%AC%E6%88%96%E7%AC%AC%E4%BA%94%E7%BA%B5%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792314865000.webp","sourceId":"rfi"},{"id":1792303767000,"createdDate":"2026-10-18 06:09","name":"法国国际广播电台","title":"意大利多地反生活成本上涨示威演变为暴力冲突，警方动用催泪弹和高压水炮","content":"综合美联社、路透社报道，10月17日，意大利米兰和博洛尼亚发生了抗议活动，其中米兰市中心出现严重的警民冲突。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E6%84%8F%E5%A4%A7%E5%88%A9%E5%A4%9A%E5%9C%B0%E5%8F%8D%E7%94%9F%E6%B4%BB%E6%88%90%E6%9C%AC%E4%B8%8A%E6%B6%A8%E7%A4%BA%E5%A8%81%E6%BC%94%E5%8F%98%E4%B8%BA%E6%9A%B4%E5%8A%9B%E5%86%B2%E7%AA%81%EF%BC%8C%E8%AD%A6%E6%96%B9%E5%8A%A8%E7%94%A8%E5%82%AC%E6%B3%AA%E5%BC%B9%E5%92%8C%E9%AB%98%E5%8E%8B%E6%B0%B4%E7%82%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792303767000.webp","sourceId":"rfi"},{"id":1792346230000,"createdDate":"2026-10-18 17:57","name":"法国国际广播电台","title":"乌克兰总统泽连斯基称美国恢复情报分享 帮助乌克兰防俄军空袭","content":"乌克兰总统泽连斯基在18日播出的访问内容中表示，经历短暂中断之后，美国恢复向基辅当局提供重要情报，以协助乌方防御俄罗斯飞弹攻击。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261018-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%80%BB%E7%BB%9F%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%A7%B0%E7%BE%8E%E5%9B%BD%E6%81%A2%E5%A4%8D%E6%83%85%E6%8A%A5%E5%88%86%E4%BA%AB-%E5%B8%AE%E5%8A%A9%E4%B9%8C%E5%85%8B%E5%85%B0%E9%98%B2%E4%BF%84%E5%86%9B%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792346230000.webp","sourceId":"rfi"},{"id":1792343903000,"createdDate":"2026-10-18 17:18","name":"法国国际广播电台","title":"消费电子产品：中国为何正在超越西方","content":"从运动相机、智能手机到扫地机器人和电动汽车，中国品牌正在全球市场迅速崛起，并超越西方。中国的优势在哪里呢？","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E6%B6%88%E8%B4%B9%E7%94%B5%E5%AD%90%E4%BA%A7%E5%93%81-%E4%B8%AD%E5%9B%BD%E4%B8%BA%E4%BD%95%E6%AD%A3%E5%9C%A8%E8%B6%85%E8%B6%8A%E8%A5%BF%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792343903000.webp","sourceId":"rfi"},{"id":1792341549000,"createdDate":"2026-10-18 16:39","name":"法国国际广播电台","title":"特朗普支持率再创新低 美国期中选举前民主党领先","content":"美国总统特朗普（DonaldTrump）支持率在期中选举前跌至第二任期新低。多项民调显示，美国民众对经济、生活成本及政府施政的不满持续升高，民主党在国会选举意向调查中也领先共和党。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%AF%E6%8C%81%E7%8E%87%E5%86%8D%E5%88%9B%E6%96%B0%E4%BD%8E-%E7%BE%8E%E5%9B%BD%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E5%89%8D%E6%B0%91%E4%B8%BB%E5%85%9A%E9%A2%86%E5%85%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792341549000.webp","sourceId":"rfi"},{"id":1792341286000,"createdDate":"2026-10-18 16:34","name":"法国国际广播电台","title":"泽连斯基：若美国站在普京一边，将是历史性错误","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周日在受访时警告称，如果美国正式站在俄罗斯总统普京一边，那将是一个“历史性错误”。不过他也表示，尽管美国总统特朗普采取了一系列令乌方及其在美国国会的盟友感到不安的举动，但他仍将特朗普视为盟友。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E8%8B%A5%E7%BE%8E%E5%9B%BD%E7%AB%99%E5%9C%A8%E6%99%AE%E4%BA%AC%E4%B8%80%E8%BE%B9%EF%BC%8C%E5%B0%86%E6%98%AF%E5%8E%86%E5%8F%B2%E6%80%A7%E9%94%99%E8%AF%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792341286000.webp","sourceId":"rfi"},{"id":1792338537000,"createdDate":"2026-10-18 15:48","name":"法国国际广播电台","title":"贝森特：我今春曾要求欧洲盟友与我们一道，对中印实施次级关税但遭拒绝","content":"美国总统特朗普周五（16日）签署了一份行政令，豁免多项涉俄制裁措施。更早时，特朗普9日在“真相社交”发文称，他与俄罗斯总统普京进行了一次“非常成功”的讨论：“双方同意，俄罗斯将立即向美国及全球市场供应超过30万吨柴油，并在11月再供应50万吨，随后立即再供应100万吨。此外，根据俄罗斯炼油厂的状况，俄方还将在短时间内供应300万吨柴油”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261018-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E6%88%91%E4%BB%8A%E6%98%A5%E6%9B%BE%E8%A6%81%E6%B1%82%E6%AC%A7%E6%B4%B2%E7%9B%9F%E5%8F%8B%E4%B8%8E%E6%88%91%E4%BB%AC%E4%B8%80%E9%81%93%EF%BC%8C%E5%AF%B9%E4%B8%AD%E5%8D%B0%E5%AE%9E%E6%96%BD%E6%AC%A1%E7%BA%A7%E5%85%B3%E7%A8%8E%E4%BD%86%E9%81%AD%E6%8B%92%E7%BB%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792338537000.webp","sourceId":"rfi"},{"id":1792332076000,"createdDate":"2026-10-18 14:01","name":"法国国际广播电台","title":"行业组织估计周六暴力事件全法直接波及1500家商户 马克龙周日晚发表讲话","content":"据法国商业与分销联合会主席邦帕德（AlexandreBompard）周日估计，前一天席卷法国全国多地的抗议活动中发生的暴力事件，直接波及了1500家商户，造成的损失金额高达数亿欧元。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261018-%E8%A1%8C%E4%B8%9A%E7%BB%84%E7%BB%87%E4%BC%B0%E8%AE%A1%E5%91%A8%E5%85%AD%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6%E5%85%A8%E6%B3%95%E7%9B%B4%E6%8E%A5%E6%B3%A2%E5%8F%8A%E5%88%B01500%E5%AE%B6%E5%BA%97%E4%B8%BB-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%91%A8%E4%BA%94%E6%99%9A%E5%8F%91%E8%A1%A8%E8%AE%B2%E8%AF%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792332076000.webp","sourceId":"rfi"},{"id":1792329587000,"createdDate":"2026-10-18 13:19","name":"法国国际广播电台","title":"“法国正在走下坡路”：10月17日的社会动员与暴力事件频发","content":"周六（10月17日），法国多地爆发大规模游行示威。抗议者走上街头，表达对生活成本持续上涨的不满，并要求政府捍卫公共服务。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261018-%E6%B3%95%E5%9B%BD%E6%AD%A3%E5%9C%A8%E8%B5%B0%E4%B8%8B%E5%9D%A1%E8%B7%AF-10%E6%9C%8817%E6%97%A5%E7%9A%84%E7%A4%BE%E4%BC%9A%E5%8A%A8%E5%91%98%E4%B8%8E%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6%E9%A2%91%E5%8F%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792329587000.webp","sourceId":"rfi"},{"id":1792329048000,"createdDate":"2026-10-18 13:10","name":"法国国际广播电台","title":"菲议员促中国大使就动武言论道歉否则应宣布不受欢迎的人 中使馆：请快点","content":"菲律宾参议员埃赫西托（JVEjercito）周日表示，菲律宾参议院正考虑就中国大使馆向菲律宾议员发出的论战通过一项决议，此前中国驻菲大使井泉因发表涉及对菲律宾动武的言论，被一些菲律宾参议员要求将其宣布为“不受欢迎的人”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E8%8F%B2%E8%AE%AE%E5%91%98%E5%91%BC%E5%90%81%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF%E5%B0%B1%E5%8A%A8%E6%AD%A6%E8%A8%80%E8%AE%BA%E9%81%93%E6%AD%89%E5%90%A6%E5%88%99%E5%BA%94%E5%AE%A3%E5%B8%83%E4%B8%8D%E5%8F%97%E6%AC%A2%E8%BF%8E%E7%9A%84%E4%BA%BA-%E4%B8%AD%E4%BD%BF%E9%A6%86-%E8%AF%B7%E5%BF%AB%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792329048000.webp","sourceId":"rfi"},{"id":1792359307000,"createdDate":"2026-10-18 21:35","name":"法国国际广播电台","title":"特朗普：法国出现的暴力事件要怪罪移民","content":"对于法国各地昨天民众抗议活动出现严重混乱，使得许多商家和政府机关遭纵火破坏。美国总统特朗普周日表示，这些状况要怪罪移民，他呼吁法国收紧相关法规。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E7%89%B9%E6%9C%97%E6%99%AE-%E6%B3%95%E5%9B%BD%E5%87%BA%E7%8E%B0%E7%9A%84%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6%E8%A6%81%E6%80%AA%E7%BD%AA%E7%A7%BB%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792359307000.webp","sourceId":"rfi"},{"id":1792358814000,"createdDate":"2026-10-18 21:26","name":"法国国际广播电台","title":"法国政府和议会审视暴力事件及执法行动","content":"法国内政部长努涅斯（LaurentNunez）周日表示，法国爆发暴力抗议活动，示威期间及事后共逮捕1800多人，目前正在进行调查，以查明从事这些行为的肇事者，并将他们绳之以法。”","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E6%B3%95%E5%9B%BD%E6%94%BF%E5%BA%9C%E5%92%8C%E8%AE%AE%E4%BC%9A%E5%AE%A1%E8%A7%86%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6%E5%8F%8A%E6%89%A7%E6%B3%95%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792358814000.webp","sourceId":"rfi"},{"id":1792357120000,"createdDate":"2026-10-18 20:58","name":"法国国际广播电台","title":"非洲:索马里大选延至2027有争议","content":"在东非国家索马里（laSomalie），在一项引入普选的选举改革框架内，原定2026年的大选现已延后。依照新的选举时间表，立法选举（leslégislatives）将于2027年4月展开，总统选举（laprésidentielle）则定于2027年5月进行。这是本台法广非洲组（RFIAfrique）今天（2026年10月18号周日）刊出的最新法文消息之一。索马里独立国家选举委员会（laCommissionélectoralenationaleindépendante）于本周四对外宣布的这一安排引发争议。索马里的中文国名也有译作索馬利亞（FederalRepublicofSomalia）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261018-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E7%B4%A2%E9%A9%AC%E9%87%8C%E5%A4%A7%E9%80%89%E5%BB%B6%E8%87%B32027%E6%9C%89%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792357120000.webp","sourceId":"rfi"},{"id":1792351909000,"createdDate":"2026-10-18 19:31","name":"法国国际广播电台","title":"非洲足球2026/2027两场冠军联赛","content":"在非洲足联（CAF）2026年至2027年冠军联赛框架内，坦桑尼亚[非洲青年队]（YoungAfricans）于2026年10月17日周六以4比0大胜主场的马达加斯加的CFFA足球队。刚果民主共和国（laRDCongo）的TPMazembe则当天下午晚些时候，在卢本巴希（Lubumbashi）主场踢平突尼斯（laTunisie）的[非洲人俱乐部队]（ClubAfricain）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261018-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2%E8%B6%B3%E7%90%832026-2027%E4%B8%A4%E5%9C%BA%E5%86%A0%E5%86%9B%E8%81%94%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792351909000.webp","sourceId":"rfi"},{"id":1792351754000,"createdDate":"2026-10-18 19:29","name":"法国国际广播电台","title":"法国总统马克龙：极左边缘团体煽动者伙同犯罪分子在我们的城市中肆意施暴","content":"周六,法国几十万人反对高物价游行演变为罕见暴力事件，多个城市发生纵火破坏抢劫。一天之后，法国总统马克龙发表电视讲话说：“昨天，10月17日星期六，来自极左边缘团体的煽动者，伙同众多犯罪分子，在我们的城市中肆意施暴。”","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261018-%E6%B3%95%E5%9B%BD%E6%80%BB%E7%BB%9F%E9%A9%AC%E5%85%8B%E9%BE%99-%E6%9E%81%E5%B7%A6%E8%BE%B9%E7%BC%98%E5%9B%A2%E4%BD%93%E7%85%BD%E5%8A%A8%E8%80%85%E4%BC%99%E5%90%8C%E7%8A%AF%E7%BD%AA%E5%88%86%E5%AD%90%E5%9C%A8%E6%88%91%E4%BB%AC%E7%9A%84%E5%9F%8E%E5%B8%82%E4%B8%AD%E8%82%86%E6%84%8F%E6%96%BD%E6%9A%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/18/1792351754000.webp","sourceId":"rfi"}]