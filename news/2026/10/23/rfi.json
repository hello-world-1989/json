[{"id":1792757525000,"createdDate":"2026-10-23 12:12","name":"法国国际广播电台","title":"巴黎一间枪械店老板：一周销量“增十倍”，“商户们正武装自己”","content":"据法新社介绍，巴黎一家狩猎枪械店的老板伊夫·戈莱提（YvesGollety）表示，自上周末抗议期间发生抢劫事件以来，他的销售额“增长了十倍”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261023-%E5%B7%B4%E9%BB%8E%E4%B8%80%E9%97%B4%E6%9E%AA%E6%A2%B0%E5%BA%97%E8%80%81%E6%9D%BF-%E4%B8%80%E5%91%A8%E9%94%80%E9%87%8F-%E5%A2%9E%E5%8D%81%E5%80%8D-%EF%BC%8C-%E5%95%86%E6%88%B7%E4%BB%AC%E6%AD%A3%E6%AD%A6%E8%A3%85%E8%87%AA%E5%B7%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792757525000.webp","sourceId":"rfi"},{"id":1792749876000,"createdDate":"2026-10-23 10:04","name":"法国国际广播电台","title":"越南共产党总书记兼国家主席苏林夫妇将访日","content":"日本外务省23日宣布，越南共产党中央委员会总书记、越南社会主义共和国国家主席苏林及其夫人将于11月8日至11日以正式工作访问贵宾的身份访问日本，这是苏林以现任职务首次正式访日。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261023-%E8%B6%8A%E5%8D%97%E5%85%B1%E4%BA%A7%E5%85%9A%E6%80%BB%E4%B9%A6%E8%AE%B0%E5%85%BC%E5%9B%BD%E5%AE%B6%E4%B8%BB%E5%B8%AD%E8%8B%8F%E6%9E%97%E5%A4%AB%E5%A6%87%E5%B0%86%E8%AE%BF%E6%97%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792749876000.webp","sourceId":"rfi"},{"id":1792746112000,"createdDate":"2026-10-23 09:01","name":"法国国际广播电台","title":"美财政部拟出新规 限制对中国及其他对手国家高科技投资","content":"美国财政部周四提出一项新规，旨在限制美国在超级计算、人工智能等高科技领域对中国、俄罗斯、朝鲜及其他“受关注国家”的投资。草案将在公众意见征询期结束后定案。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261023-%E7%BE%8E%E8%B4%A2%E6%94%BF%E9%83%A8%E6%8B%9F%E5%87%BA%E6%96%B0%E8%A7%84-%E9%99%90%E5%88%B6%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8F%8A%E5%85%B6%E4%BB%96%E5%AF%B9%E6%89%8B%E5%9B%BD%E5%AE%B6%E9%AB%98%E7%A7%91%E6%8A%80%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792746112000.webp","sourceId":"rfi"},{"id":1792739117000,"createdDate":"2026-10-23 07:05","name":"法国国际广播电台","title":"英国报告再吁释放黎智英　批港府扩大国安权力和对付海外港人　中方提交涉","content":"英国政府发表最新一份《香港半年报告》，指中国持续不遵守《中英联合声明》，批评港府持续扩大国安法律权力及适用范围，并关注《苹果日报》创办人黎智英被重判20年和黄之锋在狱中被加控国安罪行等在港人士，以及港府对海外港人采取国安措施的情况。中方和港府均批评报告粗暴干涉中国内政，中国驻英大使馆表示，已向英方提出严正交涉，并要求英方停止发表半年报告。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E8%8B%B1%E5%9B%BD%E6%8A%A5%E5%91%8A%E5%86%8D%E5%90%81%E9%87%8A%E6%94%BE%E9%BB%8E%E6%99%BA%E8%8B%B1-%E6%89%B9%E6%B8%AF%E5%BA%9C%E6%89%A9%E5%A4%A7%E5%9B%BD%E5%AE%89%E6%9D%83%E5%8A%9B%E5%92%8C%E5%AF%B9%E4%BB%98%E6%B5%B7%E5%A4%96%E6%B8%AF%E4%BA%BA-%E4%B8%AD%E6%96%B9%E6%8F%90%E4%BA%A4%E6%B6%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792739117000.webp","sourceId":"rfi"},{"id":1792778459000,"createdDate":"2026-10-23 18:00","name":"法国国际广播电台","title":"安全风险: 美国防部切断数十所大学部分外联 北京指责华盛顿“破坏”科学合作","content":"美国国防部宣布30所美国大学已减少与那些“引发国家安全担忧”的机构的联系，引发了北京的谴责。据报这与华盛顿限制与中国高校合作实体的经费有关。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261023-%E5%AE%89%E5%85%A8%E9%A3%8E%E9%99%A9-%E7%BE%8E%E5%9B%BD%E9%98%B2%E9%83%A8%E5%88%87%E6%96%AD%E6%95%B0%E5%8D%81%E6%89%80%E5%A4%A7%E5%AD%A6%E9%83%A8%E5%88%86%E5%A4%96%E8%81%94-%E5%8C%97%E4%BA%AC%E6%8C%87%E8%B4%A3%E5%8D%8E%E7%9B%9B%E9%A1%BF-%E7%A0%B4%E5%9D%8F-%E7%A7%91%E5%AD%A6%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792778459000.webp","sourceId":"rfi"},{"id":1792775471000,"createdDate":"2026-10-23 17:11","name":"法国国际广播电台","title":"路透：更严格的纪律和习近平的权威是中共五中全会的关键","content":"中国执政的共产党将于下周召集约300名最高级别成员，讨论加强党内纪律。分析人士称，这次会议可能是2027年领导层改组前的最后一次重要党内会议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E8%B7%AF%E9%80%8F-%E6%9B%B4%E4%B8%A5%E6%A0%BC%E7%9A%84%E7%BA%AA%E5%BE%8B%E5%92%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E7%9A%84%E6%9D%83%E5%A8%81%E6%98%AF%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E7%9A%84%E5%85%B3%E9%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792775471000.webp","sourceId":"rfi"},{"id":1792771225000,"createdDate":"2026-10-23 16:00","name":"法国国际广播电台","title":"蔷琵台风袭击台湾 1人遇难350人受伤","content":"周五，一场强台风袭击了台湾，当局警告称将出现“破坏性大风”，并敦促民众寻找避难场所以躲避风暴。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261023-%E8%94%B7%E7%90%B5%E5%8F%B0%E9%A3%8E%E8%A2%AD%E5%87%BB%E5%8F%B0%E6%B9%BE-1%E4%BA%BA%E9%81%87%E9%9A%BE350%E4%BA%BA%E5%8F%97%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792771225000.webp","sourceId":"rfi"},{"id":1792769556000,"createdDate":"2026-10-23 15:32","name":"法国国际广播电台","title":"菲律宾防长：中国若试图强行拖走“马德雷山”号军舰将是战争行为","content":"菲律宾每日问询者报消息，菲律宾国防部长特奥多罗周五警告称，中国若试图强行拖走搁浅的“马德雷山”（BRPSierraMadre）号军舰，将构成针对菲律宾的“战争行为”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261023-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E9%98%B2%E9%95%BF-%E4%B8%AD%E5%9B%BD%E8%8B%A5%E8%AF%95%E5%9B%BE%E5%BC%BA%E8%A1%8C%E6%8B%96%E8%B5%B0-%E9%A9%AC%E5%BE%B7%E9%9B%B7%E5%B1%B1-%E5%8F%B7%E5%86%9B%E8%88%B0%E5%B0%86%E6%98%AF%E6%88%98%E4%BA%89%E8%A1%8C%E4%B8%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792769556000.webp","sourceId":"rfi"},{"id":1792769481000,"createdDate":"2026-10-23 15:31","name":"法国国际广播电台","title":"巴黎大区伊夫林省发生枪击 至少1死5伤 嫌犯被捕 反恐检方已启动调查","content":"巴黎大区伊夫林省特拉普(Trappes）和拉韦里耶尔市（Verrière ）周五（10月23日）发生枪击事件，一名男子在车中向行人连开数枪，造成至少一人死亡，5人受伤。国家反恐检察院（Pnat）已启动案件调查。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261023-%E5%B7%B4%E9%BB%8E%E5%A4%A7%E5%8C%BA%E4%BC%8A%E5%A4%AB%E6%9E%97%E7%9C%81%E5%8F%91%E7%94%9F%E6%9E%AA%E5%87%BB-%E8%87%B3%E5%B0%911%E6%AD%BB5%E4%BC%A4-%E5%AB%8C%E7%8A%AF%E8%A2%AB%E9%80%AE%E6%8D%95-%E5%8F%8D%E6%81%90%E6%A3%80%E6%96%B9%E5%B7%B2%E5%90%AF%E5%8A%A8%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792769481000.webp","sourceId":"rfi"},{"id":1792766891000,"createdDate":"2026-10-23 14:48","name":"法国国际广播电台","title":"“奥斯汀”风暴袭法国：288,600户家庭断电","content":"今年秋季的首场风暴“奥斯汀”（Austen）周五席卷法国西北部沿海地区至巴黎大区。已有23个省份发布大风橙色警报，上午有超过28.8万户家庭断电。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261023-%E5%A5%A5%E6%96%AF%E6%B1%80-%E9%A3%8E%E6%9A%B4%E8%A2%AD%E6%B3%95%E5%9B%BD-288-600%E6%88%B7%E5%AE%B6%E5%BA%AD%E6%96%AD%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792766891000.webp","sourceId":"rfi"},{"id":1792764773000,"createdDate":"2026-10-23 14:12","name":"法国国际广播电台","title":"西藏7级强震至少16人遇难 习近平提到“重大伤亡”呼吁全力救援","content":"法新社23日引述中国官媒报道，中国国家主席习近平周五呼吁竭尽全力救援受地震影响的民众。此次地震发生在西藏偏远地区，已造成至少16人遇难、76人受伤。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E8%A5%BF%E8%97%8F7%E7%BA%A7%E5%BC%BA%E9%9C%87%E8%87%B3%E5%B0%9116%E4%BA%BA%E9%81%87%E9%9A%BE-%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8F%90%E5%88%B0-%E9%87%8D%E5%A4%A7%E4%BC%A4%E4%BA%A1-%E5%91%BC%E5%90%81%E5%85%A8%E5%8A%9B%E6%95%91%E6%8F%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792764773000.webp","sourceId":"rfi"},{"id":1792763974000,"createdDate":"2026-10-23 13:59","name":"法国国际广播电台","title":"社会政治经济三重压力下 法国政府严阵以待周末抗议活动","content":"上周末经历了多年来最严重的暴力事件，法国至今仍在努力恢复元气。虽然巴黎和其他一些城市的宵禁已经过去，没有发生重大事件。但周六，法国各地预计将爆发第二波抗议活动。为了防止上周末震惊全法国甚至全世界的暴力事件重演，法国政府严阵以待，出台多项应对措施并加强警力维安。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261023-%E7%A4%BE%E4%BC%9A%E6%94%BF%E6%B2%BB%E7%BB%8F%E6%B5%8E%E4%B8%89%E9%87%8D%E5%8E%8B%E5%8A%9B%E4%B8%8B-%E6%B3%95%E5%9B%BD%E6%94%BF%E5%BA%9C%E4%B8%A5%E9%98%B5%E4%BB%A5%E5%BE%85%E5%91%A8%E6%9C%AB%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792763974000.webp","sourceId":"rfi"},{"id":1792763699000,"createdDate":"2026-10-23 13:54","name":"法国国际广播电台","title":"工资、购买力与通胀：生活成本如何加剧法国社会不满","content":"法国近期引发社会震荡的接连示威，核心诉求是抗议生活成本上涨和购买力下降，随着燃油、食品和能源价格不断上涨，这个2018年就曾引发“黄背心”运动的议题重新成为社会讨论的焦点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261023-%E5%B7%A5%E8%B5%84-%E8%B4%AD%E4%B9%B0%E5%8A%9B%E4%B8%8E%E9%80%9A%E8%83%80-%E7%94%9F%E6%B4%BB%E6%88%90%E6%9C%AC%E5%A6%82%E4%BD%95%E5%8A%A0%E5%89%A7%E6%B3%95%E5%9B%BD%E7%A4%BE%E4%BC%9A%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792763699000.webp","sourceId":"rfi"},{"id":1792761764000,"createdDate":"2026-10-23 13:22","name":"法国国际广播电台","title":"费加罗报：外国因素抹黑法国，加剧法国社会内部的分裂","content":"各位好，我是安东尼，欢迎收听法国报纸摘要。\"根据我们掌握的信息及一份详尽的报告，克里姆林宫、德黑兰以及阿尔及利亚的部分媒体不遗余力地抹黑法国的声誉，并进一步加剧了法国社会内部的分裂\"。这是今天法国费加罗报的一个重点内容。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261023-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E5%A4%96%E5%9B%BD%E5%9B%A0%E7%B4%A0%E6%8A%B9%E9%BB%91%E6%B3%95%E5%9B%BD%EF%BC%8C%E5%8A%A0%E5%89%A7%E6%B3%95%E5%9B%BD%E7%A4%BE%E4%BC%9A%E5%86%85%E9%83%A8%E7%9A%84%E5%88%86%E8%A3%82","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792761764000.webp","sourceId":"rfi"},{"id":1792751882000,"createdDate":"2026-10-23 10:38","name":"法国国际广播电台","title":"美国期中选举AI反弹升温　数据中心成两党攻防焦点","content":"美国期中选举11月3日登场，人工智能（AI）已从科技政策议题跃升为影响选情的重要因素。数据中心耗电、耗水引发地方反弹，AI可能取代工作、加剧假消息及干预选举的疑虑也持续升高，促使民主、共和两党候选人纷纷调整立场，将科技产业列为竞选攻防焦点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261023-%E7%BE%8E%E5%9B%BD%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BEai%E5%8F%8D%E5%BC%B9%E5%8D%87%E6%B8%A9-%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E6%88%90%E4%B8%A4%E5%85%9A%E6%94%BB%E9%98%B2%E7%84%A6%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792751882000.webp","sourceId":"rfi"},{"id":1792794956000,"createdDate":"2026-10-23 22:35","name":"法国国际广播电台","title":"中共五中全会在即 反腐不能停 接班人何处寻","content":"周一开幕的中共五中全会的主题为“全面从严治党”，北京在近日采取的一系列密集的行动紧扣这一主题，努力做到习近平所要求的“反腐一刻不能停”，全力识别“形形色色的两面人”，剑指“第一方阵”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E5%9C%A8%E5%8D%B3-%E5%8F%8D%E8%85%90%E4%B8%8D%E8%83%BD%E5%81%9C-%E6%8E%A5%E7%8F%AD%E4%BA%BA%E4%BD%95%E5%A4%84%E5%AF%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792794956000.webp","sourceId":"rfi"},{"id":1792793954000,"createdDate":"2026-10-23 22:19","name":"法国国际广播电台","title":"中国手机微短剧的90%由AI制作，成本大幅下降，但创作者的收入却暴跌","content":"法国世界报刊出的一篇文章介绍了在中国，在短短几个月的时间内，生成式人工智能就几乎把微短剧行业给占领了。现在，中国手机微短剧的90%由AI制作，手机微短剧的制作成本降至原来的十分之一。但是，制作成本的下降并没有让微短剧创作者的收入增加，恰恰相反，AI制作让微短剧创作者的收入大幅下滑，急剧下降。这是怎么回事呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261023-%E4%B8%AD%E5%9B%BD%E6%89%8B%E6%9C%BA%E5%BE%AE%E7%9F%AD%E5%89%A7%E7%9A%8490-%E7%94%B1ai%E5%88%B6%E4%BD%9C%EF%BC%8C%E6%88%90%E6%9C%AC%E5%A4%A7%E5%B9%85%E4%B8%8B%E9%99%8D%EF%BC%8C%E4%BD%86%E5%88%9B%E4%BD%9C%E8%80%85%E7%9A%84%E6%94%B6%E5%85%A5%E5%8D%B4%E6%9A%B4%E8%B7%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792793954000.webp","sourceId":"rfi"},{"id":1792792374000,"createdDate":"2026-10-23 21:52","name":"法国国际广播电台","title":"特朗普称星链服务已恢复 乌克兰表示仍无法正常使用","content":"尽管美国总统特朗普周四称马斯克已恢复乌克兰军队对SpaceX“星盾”（Starshield）军事卫星通信系统的使用权限，基辅周五表示，但该系统仍无法正常使用。英国首相伯纳姆周五与特朗普通话时表示，乌克兰应获得星链的“完全使用权”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%98%9F%E9%93%BE%E6%9C%8D%E5%8A%A1%E5%B7%B2%E6%81%A2%E5%A4%8D-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%A1%A8%E7%A4%BA%E4%BB%8D%E6%97%A0%E6%B3%95%E6%AD%A3%E5%B8%B8%E4%BD%BF%E7%94%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792792374000.webp","sourceId":"rfi"},{"id":1792791896000,"createdDate":"2026-10-23 21:44","name":"法国国际广播电台","title":"美驻联合国大使沃尔兹警告伊朗战事恐再持续一年","content":"美国驻联合国大使沃尔兹（MikeWaltz）警告，美国与伊朗的战争可能再持续一年，与总统特朗普（DonaldTrump）此前表示，战争将在11月3日美国期中选举后结束的说法形成落差。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E7%BE%8E%E9%A9%BB%E8%81%94%E5%90%88%E5%9B%BD%E5%A4%A7%E4%BD%BF%E6%B2%83%E5%B0%94%E5%85%B9%E8%AD%A6%E5%91%8A%E4%BC%8A%E6%9C%97%E6%88%98%E4%BA%8B%E6%81%90%E5%86%8D%E6%8C%81%E7%BB%AD%E4%B8%80%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792791896000.webp","sourceId":"rfi"},{"id":1792791717000,"createdDate":"2026-10-23 21:41","name":"法国国际广播电台","title":"希音同意支付1亿美元 与美国联邦贸易委员会达成和解","content":"一名直接知情人士周五（10月23日）向路透社透露，中国快时尚巨头希音已同意支付1亿美元，与美国联邦贸易委员会就发货延误及其他消费者投诉展开的调查达成和解。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E5%B8%8C%E9%9F%B3%E5%90%8C%E6%84%8F%E6%94%AF%E4%BB%981%E4%BA%BF%E7%BE%8E%E5%85%83-%E4%B8%8E%E7%BE%8E%E5%9B%BD%E8%81%94%E9%82%A6%E8%B4%B8%E6%98%93%E5%A7%94%E5%91%98%E4%BC%9A%E8%BE%BE%E6%88%90%E5%92%8C%E8%A7%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792791717000.webp","sourceId":"rfi"},{"id":1792791568000,"createdDate":"2026-10-23 21:39","name":"法国国际广播电台","title":"欧盟拟通过对华谈判应对“中国冲击2.0” 聚焦化工与机械行业","content":"欧盟多国部长周五（10月23日）表示，欧盟应着重通过与北京对话，减少化工、机械等产品进口，遏制不断扩大的对华贸易逆差。与此同时，欧盟正考虑对塑料实施进口配额。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E6%AC%A7%E7%9B%9F%E6%8B%9F%E9%80%9A%E8%BF%87%E5%AF%B9%E5%8D%8E%E8%B0%88%E5%88%A4%E5%BA%94%E5%AF%B9-%E4%B8%AD%E5%9B%BD%E5%86%B2%E5%87%BB2-0-%E8%81%9A%E7%84%A6%E5%8C%96%E5%B7%A5%E4%B8%8E%E6%9C%BA%E6%A2%B0%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792791568000.webp","sourceId":"rfi"},{"id":1792791413000,"createdDate":"2026-10-23 21:36","name":"法国国际广播电台","title":"美国特使：美方最快本周末可能打击伊朗","content":"美国特使汤姆·巴拉克周五(10月23日）表示，美国最快可能于本周末对伊朗发动打击。此前数日，华盛顿和以色列接连发出对伊朗动武的威胁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261023-%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF-%E7%BE%8E%E6%96%B9%E6%9C%80%E5%BF%AB%E6%9C%AC%E5%91%A8%E6%9C%AB%E5%8F%AF%E8%83%BD%E6%89%93%E5%87%BB%E4%BC%8A%E6%9C%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792791413000.webp","sourceId":"rfi"},{"id":1792791219000,"createdDate":"2026-10-23 21:33","name":"法国国际广播电台","title":"法国周末将举行新一轮示威 凡尔赛宫等多家文化场所关闭","content":"法国周六（10月24日）将举行新一轮示威活动，因担忧再度发生骚乱，巴黎歌剧院、凡尔赛宫等多家博物馆和文化场所周五纷纷宣布，将于周六全天或部分时段关闭。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261023-%E6%B3%95%E5%9B%BD%E5%91%A8%E6%9C%AB%E5%B0%86%E4%B8%BE%E8%A1%8C%E6%96%B0%E4%B8%80%E8%BD%AE%E7%A4%BA%E5%A8%81-%E5%87%A1%E5%B0%94%E8%B5%9B%E5%AE%AB%E7%AD%89%E5%A4%9A%E5%AE%B6%E6%96%87%E5%8C%96%E5%9C%BA%E6%89%80%E5%85%B3%E9%97%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792791219000.webp","sourceId":"rfi"},{"id":1792790932000,"createdDate":"2026-10-23 21:28","name":"法国国际广播电台","title":"巴黎近郊枪击导致一死五伤 马克龙谴责“种族主义恐怖袭击”","content":"法国巴黎近郊周五（10月23日）发生枪击，一名男子从汽车内连续开火，造成一人死亡、五人受伤，其中包括一名12岁女孩。嫌疑人被怀疑有意针对移民背景人士。法国总统马克龙当天前往现场，将事件定性为“种族主义恐怖袭击”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261023-%E5%B7%B4%E9%BB%8E%E8%BF%91%E9%83%8A%E6%9E%AA%E5%87%BB%E5%AF%BC%E8%87%B4%E4%B8%80%E6%AD%BB%E4%BA%94%E4%BC%A4-%E9%A9%AC%E5%85%8B%E9%BE%99%E8%B0%B4%E8%B4%A3-%E7%A7%8D%E6%97%8F%E4%B8%BB%E4%B9%89%E6%81%90%E6%80%96%E8%A2%AD%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792790932000.webp","sourceId":"rfi"},{"id":1792789264000,"createdDate":"2026-10-23 21:01","name":"法国国际广播电台","title":"法国高中生抗议运动：周五，马克龙首次会见高中生代表","content":"在法国高中生抗议活动开始一个多月后，法国总统马克龙周五亲自介入了高中生们的抗议活动。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261023-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E6%8A%97%E8%AE%AE%E8%BF%90%E5%8A%A8-%E5%91%A8%E4%BA%94%EF%BC%8C%E9%A9%AC%E5%85%8B%E9%BE%99%E9%A6%96%E6%AC%A1%E4%BC%9A%E8%A7%81%E9%AB%98%E4%B8%AD%E7%94%9F%E4%BB%A3%E8%A1%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792789264000.webp","sourceId":"rfi"}]