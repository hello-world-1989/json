[{"id":1792757525000,"createdDate":"2026-10-23 12:12","name":"法国国际广播电台","title":"巴黎一间枪械店老板：一周销量“增十倍”，“商户们正武装自己”","content":"据法新社介绍，巴黎一家狩猎枪械店的老板伊夫·戈莱提（YvesGollety）表示，自上周末抗议期间发生抢劫事件以来，他的销售额“增长了十倍”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261023-%E5%B7%B4%E9%BB%8E%E4%B8%80%E9%97%B4%E6%9E%AA%E6%A2%B0%E5%BA%97%E8%80%81%E6%9D%BF-%E4%B8%80%E5%91%A8%E9%94%80%E9%87%8F-%E5%A2%9E%E5%8D%81%E5%80%8D-%EF%BC%8C-%E5%95%86%E6%88%B7%E4%BB%AC%E6%AD%A3%E6%AD%A6%E8%A3%85%E8%87%AA%E5%B7%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792757525000.webp","sourceId":"rfi"},{"id":1792749876000,"createdDate":"2026-10-23 10:04","name":"法国国际广播电台","title":"越南共产党总书记兼国家主席苏林夫妇将访日","content":"日本外务省23日宣布，越南共产党中央委员会总书记、越南社会主义共和国国家主席苏林及其夫人将于11月8日至11日以正式工作访问贵宾的身份访问日本，这是苏林以现任职务首次正式访日。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261023-%E8%B6%8A%E5%8D%97%E5%85%B1%E4%BA%A7%E5%85%9A%E6%80%BB%E4%B9%A6%E8%AE%B0%E5%85%BC%E5%9B%BD%E5%AE%B6%E4%B8%BB%E5%B8%AD%E8%8B%8F%E6%9E%97%E5%A4%AB%E5%A6%87%E5%B0%86%E8%AE%BF%E6%97%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792749876000.webp","sourceId":"rfi"},{"id":1792746112000,"createdDate":"2026-10-23 09:01","name":"法国国际广播电台","title":"美财政部拟出新规 限制对中国及其他对手国家高科技投资","content":"美国财政部周四提出一项新规，旨在限制美国在超级计算、人工智能等高科技领域对中国、俄罗斯、朝鲜及其他“受关注国家”的投资。草案将在公众意见征询期结束后定案。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261023-%E7%BE%8E%E8%B4%A2%E6%94%BF%E9%83%A8%E6%8B%9F%E5%87%BA%E6%96%B0%E8%A7%84-%E9%99%90%E5%88%B6%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%8F%8A%E5%85%B6%E4%BB%96%E5%AF%B9%E6%89%8B%E5%9B%BD%E5%AE%B6%E9%AB%98%E7%A7%91%E6%8A%80%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792746112000.webp","sourceId":"rfi"},{"id":1792739117000,"createdDate":"2026-10-23 07:05","name":"法国国际广播电台","title":"英国报告再吁释放黎智英　批港府扩大国安权力和对付海外港人　中方提交涉","content":"英国政府发表最新一份《香港半年报告》，指中国持续不遵守《中英联合声明》，批评港府持续扩大国安法律权力及适用范围，并关注《苹果日报》创办人黎智英被重判20年和黄之锋在狱中被加控国安罪行等在港人士，以及港府对海外港人采取国安措施的情况。中方和港府均批评报告粗暴干涉中国内政，中国驻英大使馆表示，已向英方提出严正交涉，并要求英方停止发表半年报告。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261023-%E8%8B%B1%E5%9B%BD%E6%8A%A5%E5%91%8A%E5%86%8D%E5%90%81%E9%87%8A%E6%94%BE%E9%BB%8E%E6%99%BA%E8%8B%B1-%E6%89%B9%E6%B8%AF%E5%BA%9C%E6%89%A9%E5%A4%A7%E5%9B%BD%E5%AE%89%E6%9D%83%E5%8A%9B%E5%92%8C%E5%AF%B9%E4%BB%98%E6%B5%B7%E5%A4%96%E6%B8%AF%E4%BA%BA-%E4%B8%AD%E6%96%B9%E6%8F%90%E4%BA%A4%E6%B6%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/23/1792739117000.webp","sourceId":"rfi"}]