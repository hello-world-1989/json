[{"id":1792845919000,"createdDate":"2026-10-24 12:45","name":"法国国际广播电台","title":"五角大楼将美国境内的孔子学院列为国家安全威胁","content":"美国国防部长皮特·赫格塞斯周五表示，美国国防部将中国资助、设在大学校园内的文化中心（即所谓的“孔子学院”）视为对美国国家安全的威胁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E4%BA%94%E8%A7%92%E5%A4%A7%E6%A5%BC%E5%B0%86%E7%BE%8E%E5%9B%BD%E5%A2%83%E5%86%85%E7%9A%84%E5%AD%94%E5%AD%90%E5%AD%A6%E9%99%A2%E5%88%97%E4%B8%BA%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792845919000.webp","sourceId":"rfi"},{"id":1792844245000,"createdDate":"2026-10-24 12:17","name":"法国国际广播电台","title":"法国部署7万警力迎来新一轮抗议活动 “黄背心”卷土重来","content":"法国在经历了暴力与抢劫事件一周后，周六迎来新一轮抗议活动：黄背心、工会、高中生及大学生将在极度紧张的氛围中举行新一轮游行。多条游行路线被禁，安保级别升高，当局部署了7万名警察和宪兵严阵以待。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261024-%E6%B3%95%E5%9B%BD%E9%83%A8%E7%BD%B27%E4%B8%87%E8%AD%A6%E5%8A%9B%E8%BF%8E%E6%9D%A5%E6%96%B0%E4%B8%80%E8%BD%AE%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8-%E9%BB%84%E8%83%8C%E5%BF%83-%E5%8D%B7%E5%9C%9F%E9%87%8D%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792844245000.webp","sourceId":"rfi"},{"id":1792835005000,"createdDate":"2026-10-24 09:43","name":"法国国际广播电台","title":"韩媒：中国总理李强赴丹东迎接金正恩","content":"据韩国政府和韩联社报道，金正恩周六经由近期通车的朝中边境大桥，抵达了中国与朝鲜接壤的边境城市丹东。韩国媒体说，中国总理李强赴丹东迎接朝鲜领导人金正恩...，但金正恩接下来的访华行程未透露。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E9%9F%A9%E5%AA%92-%E4%B8%AD%E5%9B%BD%E6%80%BB%E7%90%86%E6%9D%8E%E5%BC%BA%E8%B5%B4%E4%B8%B9%E4%B8%9C%E8%BF%8E%E6%8E%A5%E9%87%91%E6%AD%A3%E6%81%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792835005000.webp","sourceId":"rfi"},{"id":1792832634000,"createdDate":"2026-10-24 09:03","name":"法国国际广播电台","title":"巴西总统选举第二轮投票在即，两候选人民调支持率趋向势均力敌","content":"巴西2026总统大选进入决定胜负的最后阶段。第二轮投票将在周日25日举行。两名候选人23日晚最后一次公开辩论。相较于一周前的首次公开辩论，双方言辞各有收敛，但激烈争辩互不相让。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261024-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E7%AC%AC%E4%BA%8C%E8%BD%AE%E6%8A%95%E7%A5%A8%E5%9C%A8%E5%8D%B3%EF%BC%8C%E4%B8%A4%E5%80%99%E9%80%89%E4%BA%BA%E6%B0%91%E8%B0%83%E6%94%AF%E6%8C%81%E7%8E%87%E8%B6%8B%E5%90%91%E5%8A%BF%E5%9D%87%E5%8A%9B%E6%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792832634000.webp","sourceId":"rfi"},{"id":1792826439000,"createdDate":"2026-10-24 07:20","name":"法国国际广播电台","title":"韩联社：朝鲜领导人金正恩抵达中国丹东","content":"朝鲜领导人金正恩周六经由近期通车的朝中边境大桥，抵达中国与朝鲜接壤的边境城市丹东。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261024-%E9%9F%A9%E8%81%94%E7%A4%BE-%E6%9C%9D%E9%B2%9C%E9%A2%86%E5%AF%BC%E4%BA%BA%E9%87%91%E6%AD%A3%E6%81%A9%E6%8A%B5%E8%BE%BE%E4%B8%AD%E5%9B%BD%E4%B8%B9%E4%B8%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792826439000.webp","sourceId":"rfi"},{"id":1792863062000,"createdDate":"2026-10-24 17:31","name":"法国国际广播电台","title":"伊朗总统将赴莫斯科与普京会晤 并出席天然气出口国会议","content":"伊朗总统佩泽什基安将于下周二在莫斯科与俄罗斯总统·普京会面，并将出席天然气出口国会议。他周六在发布于网络的演讲中表示，由于与美国之间的冲突导致对伊朗的经济压力加剧，许多伊朗人难以维持生计。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E4%BC%8A%E6%9C%97%E6%80%BB%E7%BB%9F%E5%B0%86%E8%B5%B4%E8%8E%AB%E6%96%AF%E7%A7%91%E4%B8%8E%E6%99%AE%E4%BA%AC%E4%BC%9A%E6%99%A4-%E5%B9%B6%E5%87%BA%E5%B8%AD%E5%A4%A9%E7%84%B6%E6%B0%94%E5%87%BA%E5%8F%A3%E5%9B%BD%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792863062000.webp","sourceId":"rfi"},{"id":1792861761000,"createdDate":"2026-10-24 17:09","name":"法国国际广播电台","title":"迹象显示美国或将重启对伊朗大规模空袭","content":"多位美国专家表示，美国似乎正在准备对伊朗恢复大规模空袭，但对双方而言，军事解决方案似乎都行不通。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E8%BF%B9%E8%B1%A1%E6%98%BE%E7%A4%BA-%E7%BE%8E%E5%9B%BD%E6%88%96%E5%B0%86%E9%87%8D%E5%90%AF%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792861761000.webp","sourceId":"rfi"},{"id":1792856091000,"createdDate":"2026-10-24 15:34","name":"法国国际广播电台","title":"气候变化：为何必须迅速制定SF6排放国际标准？","content":"美国的气候变化新闻网站InsideClimateNews上个月发表了一篇有关中国的温室气体排放的文章，文章的标题十分醒目：中国电网排放的超级污染物正在烤煮地球。文章介绍说，中国的电网有一个不可告人的秘密。尽管中国在可再生能源开发方面领先全球，但它也是地球上最强的温室气体的最大排放国。这个最强效的温室气体的名字就叫做六氟化硫，英文简称为SF6。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261024-%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96-%E4%B8%BA%E4%BD%95%E5%BF%85%E9%A1%BB%E8%BF%85%E9%80%9F%E5%88%B6%E5%AE%9Asf6%E6%8E%92%E6%94%BE%E6%A0%87%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792856091000.webp","sourceId":"rfi"},{"id":1792855865000,"createdDate":"2026-10-24 15:31","name":"法国国际广播电台","title":"欧洲考虑出台新配额和关税以遏制中国进口激增","content":"欧盟贸易主管周五表示，在与北京进一步谈判之前，欧盟可能会对更多中国行业实施配额或加征关税，并点名调查取得实质进展的塑料行业。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E6%AC%A7%E6%B4%B2%E8%80%83%E8%99%91%E5%87%BA%E5%8F%B0%E6%96%B0%E9%85%8D%E9%A2%9D%E5%92%8C%E5%85%B3%E7%A8%8E%E4%BB%A5%E9%81%8F%E5%88%B6%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%8F%A3%E6%BF%80%E5%A2%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792855865000.webp","sourceId":"rfi"},{"id":1792853484000,"createdDate":"2026-10-24 14:51","name":"法国国际广播电台","title":"法国高风险行动日：警方高度戒备之下的大规模社会动员","content":"法国全国24日面对新一波社会风潮和它可能伴随的暴力事件。一周前10月17日示威游行活动明显失控、暴力混乱的场面显然并未吓住人们想要上街表达不满的决心。原本由中学生率先发起的抗议活动正汇集来自黄背心运动团体、劳工团体以及中学生和大学生团体的诉求。这些不同社会团体诉求各有不同，但在对物价上涨带来的购买力下降以及公共服务设施缺失的不满上找到了共同点。人们无疑对一周前示威抗议活动中出现的严重的打砸抢场面仍然心有余悸。政府再三强调已做好充分准备、不会让局面再度失控的承诺却未必让无论是示威活动参与者还是大街小巷的店铺主人真正放心，尤其是政府限制游行的努力也正带来新的紧张关系，平添发生冲突的风险。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261024-%E6%B3%95%E5%9B%BD%E9%AB%98%E9%A3%8E%E9%99%A9%E8%A1%8C%E5%8A%A8%E6%97%A5-%E8%AD%A6%E6%96%B9%E9%AB%98%E5%BA%A6%E6%88%92%E5%A4%87%E4%B9%8B%E4%B8%8B%E7%9A%84%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%A4%BE%E4%BC%9A%E5%8A%A8%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792853484000.webp","sourceId":"rfi"},{"id":1792853008000,"createdDate":"2026-10-24 14:43","name":"法国国际广播电台","title":"梅拉尼娅-特朗普宣布在乌克兰一座“濒临灾难”的城市停火","content":"美国第一夫人梅拉尼娅·特朗普周五宣布，在被俄军占领的乌克兰城市奥列奇基（Olechky）实施停火，这个城市的居民被困在前线，正临食品和药品短缺。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E6%A2%85%E6%8B%89%E5%B0%BC%E5%A8%85-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E5%9C%A8%E4%B9%8C%E5%85%8B%E5%85%B0%E4%B8%80%E5%BA%A7-%E6%BF%92%E4%B8%B4%E7%81%BE%E9%9A%BE-%E7%9A%84%E5%9F%8E%E5%B8%82%E5%81%9C%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792853008000.webp","sourceId":"rfi"},{"id":1792881667000,"createdDate":"2026-10-24 22:41","name":"法国国际广播电台","title":"中共五中全会会否有重大权力布局","content":"中共20届五中全会10月26日开幕，全会是该党中央委员会的闭门会议，由大约300名高级成员组成，会上将就国家及党内重大决策进行讨论。本次会议的核心议题将聚焦党的治理问题。包括减少腐败，提高干部工作效率，增强他们的忠诚度。下面我们综述法新社的相关报道以及专家的观点来分析目前比较关心的几个问题，其中之一是会否设立党主席。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E4%B8%AD%E5%85%B1%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A%E4%BC%9A%E5%90%A6%E6%9C%89%E9%87%8D%E5%A4%A7%E6%9D%83%E5%8A%9B%E5%B8%83%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792881667000.webp","sourceId":"rfi"},{"id":1792878344000,"createdDate":"2026-10-24 21:45","name":"法国国际广播电台","title":"金正恩过鸭绿江为何转了一圈就返回了","content":"朝鲜领导人金正恩的专列周六驶过闲置了十几年的中朝新鸭绿江大桥，来到彼岸的中国城市丹东，访问仅持续几小时，金正恩又返回了。没有去北京，没有见习近平，原因不明。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E9%87%91%E6%AD%A3%E6%81%A9%E8%BF%87%E9%B8%AD%E7%BB%BF%E6%B1%9F%E4%B8%BA%E4%BD%95%E8%BD%AC%E4%BA%86%E4%B8%80%E5%9C%88%E5%B0%B1%E8%BF%94%E5%9B%9E%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792878344000.webp","sourceId":"rfi"},{"id":1792877876000,"createdDate":"2026-10-24 21:37","name":"法国国际广播电台","title":"访问普京后：德国前总理施罗德现身中国全球治理论坛","content":"德国前总理、社民党（SPD）政治人物格哈德·施罗德出席了中国全球治理论坛（GlobalGovernanceForum）的开幕式，引发德国多份媒体惊讶。德国《明镜》周刊、《图片报》等都做了报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E8%AE%BF%E9%97%AE%E6%99%AE%E4%BA%AC%E5%90%8E-%E5%BE%B7%E5%9B%BD%E5%89%8D%E6%80%BB%E7%90%86%E6%96%BD%E7%BD%97%E5%BE%B7%E7%8E%B0%E8%BA%AB%E4%B8%AD%E5%9B%BD%E5%85%A8%E7%90%83%E6%B2%BB%E7%90%86%E8%AE%BA%E5%9D%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877876000.webp","sourceId":"rfi"},{"id":1792877710000,"createdDate":"2026-10-24 21:35","name":"法国国际广播电台","title":"中方敦促美国停止扩大对华投资限制","content":"中国商务部周六（10月24日）敦促美国停止扩大对华投资限制，称美方针对敏感技术提出的新规将扰乱双边经贸关系。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E4%B8%AD%E6%96%B9%E6%95%A6%E4%BF%83%E7%BE%8E%E5%9B%BD%E5%81%9C%E6%AD%A2%E6%89%A9%E5%A4%A7%E5%AF%B9%E5%8D%8E%E6%8A%95%E8%B5%84%E9%99%90%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877710000.webp","sourceId":"rfi"},{"id":1792877598000,"createdDate":"2026-10-24 21:33","name":"法国国际广播电台","title":"特朗普外交政策成期中选举共和党包袱","content":"美国期中选举11月3日登场，总统特朗普（DonaldTrump）对伊朗开战及推行关税政策，推高能源价格与生活成本，正成为共和党争取选票的重大包袱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A4%96%E4%BA%A4%E6%94%BF%E7%AD%96%E6%88%90%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E5%85%B1%E5%92%8C%E5%85%9A%E5%8C%85%E8%A2%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877598000.webp","sourceId":"rfi"},{"id":1792877466000,"createdDate":"2026-10-24 21:31","name":"法国国际广播电台","title":"巴西举行总统选举第二轮投票 卢拉与弗拉维奥势均力敌","content":"巴西总统选举第二轮投票前夕，数以千计的民众周六（10月24日）走上街头，分别为寻求连任的总统卢拉及其保守派对手弗拉维奥·博索纳罗举行最后一轮声援集会。两名候选人选情势均力敌，激烈的竞选交锋也再次凸显这个拉美大国的深刻分歧。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261024-%E5%B7%B4%E8%A5%BF%E4%B8%BE%E8%A1%8C%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E7%AC%AC%E4%BA%8C%E8%BD%AE%E6%8A%95%E7%A5%A8-%E5%8D%A2%E6%8B%89%E4%B8%8E%E5%BC%97%E6%8B%89%E7%BB%B4%E5%A5%A5%E5%8A%BF%E5%9D%87%E5%8A%9B%E6%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877466000.webp","sourceId":"rfi"},{"id":1792877455000,"createdDate":"2026-10-24 21:30","name":"法国国际广播电台","title":"中国交换生抖音秀「捏赖清德头」遭强制出境 中国网友抱不平质疑台湾言论自由","content":"在台湾大学短期交换的陆籍王姓男学生，因在抖音上传「手捏赖清德头部的错位照片」，并写下「小小赖清德拿下拿下」等统战字眼。在16日遭台湾移民署驱逐出境病限制五年不得来台。事实上，陆籍人士因言论涉武统争议被驱逐出境过去已有多起案例，包括陆配「亚亚」与「小微」。而对于言论自由与国安问题的红线，也引起中国网友正反两方的辩论。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261024-%E4%B8%AD%E5%9B%BD%E4%BA%A4%E6%8D%A2%E7%94%9F%E6%8A%96%E9%9F%B3%E7%A7%80-%E6%8D%8F%E8%B5%96%E6%B8%85%E5%BE%B7%E5%A4%B4-%E9%81%AD%E5%BC%BA%E5%88%B6%E5%87%BA%E5%A2%83-%E4%B8%AD%E5%9B%BD%E7%BD%91%E5%8F%8B%E6%8A%B1%E4%B8%8D%E5%B9%B3%E8%B4%A8%E7%96%91%E5%8F%B0%E6%B9%BE%E8%A8%80%E8%AE%BA%E8%87%AA%E7%94%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877455000.webp","sourceId":"rfi"},{"id":1792877075000,"createdDate":"2026-10-24 21:24","name":"法国国际广播电台","title":"泽连斯基：星链和星盾通信系统恢复限速前水平","content":"乌克兰周六（10月24日）表示，乌军高度依赖的太空探索技术公司星链系统已恢复“稳定连接”。此前，在基辅与华盛顿关系紧张之际，该系统连续数日受到限速影响。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261024-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E6%98%9F%E9%93%BE%E5%92%8C%E6%98%9F%E7%9B%BE%E9%80%9A%E4%BF%A1%E7%B3%BB%E7%BB%9F%E6%81%A2%E5%A4%8D%E9%99%90%E9%80%9F%E5%89%8D%E6%B0%B4%E5%B9%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792877075000.webp","sourceId":"rfi"},{"id":1792876890000,"createdDate":"2026-10-24 21:21","name":"法国国际广播电台","title":"意大利严阵以待应对示威暴力 警方逮捕9人、短暂拘留数百人","content":"意大利上周末发生严重冲突后，当局展开大规模打击行动，并部署大批安全部队，应对周六新一轮示威抗议。周末集会规模最终较为有限，大多以和平方式进行。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261024-%E6%84%8F%E5%A4%A7%E5%88%A9%E4%B8%A5%E9%98%B5%E4%BB%A5%E5%BE%85%E5%BA%94%E5%AF%B9%E7%A4%BA%E5%A8%81%E6%9A%B4%E5%8A%9B-%E8%AD%A6%E6%96%B9%E9%80%AE%E6%8D%959%E4%BA%BA-%E7%9F%AD%E6%9A%82%E6%8B%98%E7%95%99%E6%95%B0%E7%99%BE%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792876890000.webp","sourceId":"rfi"},{"id":1792876672000,"createdDate":"2026-10-24 21:17","name":"法国国际广播电台","title":"法国新一轮大规模示威暴力减少 全国近千人被捕","content":"法国各地周六（10月24日）再次爆发大规模社会抗议。在当局增派警力、严格管控游行的情况下，示威总体平静，暴力程度远低于上周，但巴黎等多个城市仍发生警民冲突。内政部长洛朗·努内兹表示，全国近千人被捕。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261024-%E6%B3%95%E5%9B%BD%E6%96%B0%E4%B8%80%E8%BD%AE%E5%A4%A7%E8%A7%84%E6%A8%A1%E7%A4%BA%E5%A8%81%E6%9A%B4%E5%8A%9B%E5%87%8F%E5%B0%91-%E5%85%A8%E5%9B%BD%E8%BF%91%E5%8D%83%E4%BA%BA%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792876672000.webp","sourceId":"rfi"},{"id":1792876615000,"createdDate":"2026-10-24 21:16","name":"法国国际广播电台","title":"德国总理默茨将访日  加强日德在防卫与经济安全领域合作","content":"德国总理弗里德里希·默茨（FriedrichMerz）将于2026年10月28日至29日访问日本，并与日本首相高市早苗举行首脑会谈。这是默茨自2025年就任德国总理以来首次访问日本。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261024-%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%90%86%E9%BB%98%E8%8C%A8%E5%B0%86%E8%AE%BF%E6%97%A5-%E5%8A%A0%E5%BC%BA%E6%97%A5%E5%BE%B7%E5%9C%A8%E9%98%B2%E5%8D%AB%E4%B8%8E%E7%BB%8F%E6%B5%8E%E5%AE%89%E5%85%A8%E9%A2%86%E5%9F%9F%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792876615000.webp","sourceId":"rfi"}]