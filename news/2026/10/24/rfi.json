[{"id":1792845919000,"createdDate":"2026-10-24 12:45","name":"法国国际广播电台","title":"五角大楼将美国境内的孔子学院列为国家安全威胁","content":"美国国防部长皮特·赫格塞斯周五表示，美国国防部将中国资助、设在大学校园内的文化中心（即所谓的“孔子学院”）视为对美国国家安全的威胁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261024-%E4%BA%94%E8%A7%92%E5%A4%A7%E6%A5%BC%E5%B0%86%E7%BE%8E%E5%9B%BD%E5%A2%83%E5%86%85%E7%9A%84%E5%AD%94%E5%AD%90%E5%AD%A6%E9%99%A2%E5%88%97%E4%B8%BA%E5%9B%BD%E5%AE%B6%E5%AE%89%E5%85%A8%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792845919000.webp","sourceId":"rfi"},{"id":1792844245000,"createdDate":"2026-10-24 12:17","name":"法国国际广播电台","title":"法国部署7万警力迎来新一轮抗议活动 “黄背心”卷土重来","content":"法国在经历了暴力与抢劫事件一周后，周六迎来新一轮抗议活动：黄背心、工会、高中生及大学生将在极度紧张的氛围中举行新一轮游行。多条游行路线被禁，安保级别升高，当局部署了7万名警察和宪兵严阵以待。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261024-%E6%B3%95%E5%9B%BD%E9%83%A8%E7%BD%B27%E4%B8%87%E8%AD%A6%E5%8A%9B%E8%BF%8E%E6%9D%A5%E6%96%B0%E4%B8%80%E8%BD%AE%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8-%E9%BB%84%E8%83%8C%E5%BF%83-%E5%8D%B7%E5%9C%9F%E9%87%8D%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792844245000.webp","sourceId":"rfi"},{"id":1792835005000,"createdDate":"2026-10-24 09:43","name":"法国国际广播电台","title":"韩媒：中国总理李强赴丹东迎接金正恩","content":"据韩国政府和韩联社报道，金正恩周六经由近期通车的朝中边境大桥，抵达了中国与朝鲜接壤的边境城市丹东。韩国媒体说，中国总理李强赴丹东迎接朝鲜领导人金正恩...，但金正恩接下来的访华行程未透露。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261024-%E9%9F%A9%E5%AA%92-%E4%B8%AD%E5%9B%BD%E6%80%BB%E7%90%86%E6%9D%8E%E5%BC%BA%E8%B5%B4%E4%B8%B9%E4%B8%9C%E8%BF%8E%E6%8E%A5%E9%87%91%E6%AD%A3%E6%81%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792835005000.webp","sourceId":"rfi"},{"id":1792832634000,"createdDate":"2026-10-24 09:03","name":"法国国际广播电台","title":"巴西总统选举第二轮投票在即，两候选人民调支持率趋向势均力敌","content":"巴西2026总统大选进入决定胜负的最后阶段。第二轮投票将在周日25日举行。两名候选人23日晚最后一次公开辩论。相较于一周前的首次公开辩论，双方言辞各有收敛，但激烈争辩互不相让。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261024-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E7%AC%AC%E4%BA%8C%E8%BD%AE%E6%8A%95%E7%A5%A8%E5%9C%A8%E5%8D%B3%EF%BC%8C%E4%B8%A4%E5%80%99%E9%80%89%E4%BA%BA%E6%B0%91%E8%B0%83%E6%94%AF%E6%8C%81%E7%8E%87%E8%B6%8B%E5%90%91%E5%8A%BF%E5%9D%87%E5%8A%9B%E6%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792832634000.webp","sourceId":"rfi"},{"id":1792826439000,"createdDate":"2026-10-24 07:20","name":"法国国际广播电台","title":"韩联社：朝鲜领导人金正恩抵达中国丹东","content":"朝鲜领导人金正恩周六经由近期通车的朝中边境大桥，抵达中国与朝鲜接壤的边境城市丹东。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261024-%E9%9F%A9%E8%81%94%E7%A4%BE-%E6%9C%9D%E9%B2%9C%E9%A2%86%E5%AF%BC%E4%BA%BA%E9%87%91%E6%AD%A3%E6%81%A9%E6%8A%B5%E8%BE%BE%E4%B8%AD%E5%9B%BD%E4%B8%B9%E4%B8%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/24/1792826439000.webp","sourceId":"rfi"}]