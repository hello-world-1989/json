[{"id":1791641577000,"createdDate":"2026-10-10 14:12","name":"法国国际广播电台","title":"小马科斯谈其最大的担心 并指仍希望促成菲中南海油气联合勘探","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）在受访时表示，在南中国海等问题上，菲方对华立场与东盟其他声索国保持一致；他驳斥了有关菲律宾采取更强硬姿态可能使其成为地区例外的说法。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E5%B0%8F%E9%A9%AC%E7%A7%91%E6%96%AF%E8%B0%88%E5%85%B6%E6%9C%80%E5%A4%A7%E7%9A%84%E6%8B%85%E5%BF%83-%E5%B9%B6%E6%8C%87%E4%BB%8D%E5%B8%8C%E6%9C%9B%E4%BF%83%E6%88%90%E8%8F%B2%E4%B8%AD%E5%8D%97%E6%B5%B7%E6%B2%B9%E6%B0%94%E8%81%94%E5%90%88%E5%8B%98%E6%8E%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791641577000.webp","sourceId":"rfi"},{"id":1791634665000,"createdDate":"2026-10-10 12:17","name":"法国国际广播电台","title":"中国掀起AI 历史剧热潮却引发历史叙事权与AI创作边界的争议","content":"近年来中国兴起一股AI生成历史剧热潮，广受观众关注与讨论，像是《霍去病》、《问苍生》和《千里江山图》都在短时间内于平台上创下惊人播放量。然而，近来这部由网络小说改编的AI历史剧《秦始皇：朕有华夏全明星阵容》却引起争议，更被大量举报而导致最新一季审查停滞。部分批评者认为此剧带有中国沙文主义，部分内容与史实也有所不符。不过，究竟历史诠释权与ＡI创作自由的拿捏该如何衡量，中国网友们又是怎么看？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261010-%E4%B8%AD%E5%9B%BD%E6%8E%80%E8%B5%B7ai-%E5%8E%86%E5%8F%B2%E5%89%A7%E7%83%AD%E6%BD%AE%E5%8D%B4%E5%BC%95%E5%8F%91%E5%8E%86%E5%8F%B2%E5%8F%99%E4%BA%8B%E6%9D%83%E4%B8%8Eai%E5%88%9B%E4%BD%9C%E8%BE%B9%E7%95%8C%E7%9A%84%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791634665000.webp","sourceId":"rfi"},{"id":1791633825000,"createdDate":"2026-10-10 12:03","name":"法国国际广播电台","title":"美国针对伊朗“影子舰队”网络 多家中国企业及关联船舶受制裁","content":"美国国务院周四（8日）宣布对涉及伊朗原产石油或石化产品贸易的10个实体、6名个人及5艘船只实施制裁。此外，美国财政部当天也宣布对17个实体及伊朗“影子舰队”的船只实施制裁。这些措施旨在切断伊朗政权的资金来源，并阻止其利用“影子舰队”运输伊朗石油和石化产品以规避美方制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261010-%E7%BE%8E%E5%9B%BD%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97-%E5%BD%B1%E5%AD%90%E8%88%B0%E9%98%9F-%E7%BD%91%E7%BB%9C-%E5%A4%9A%E5%AE%B6%E9%99%86%E6%B8%AF%E4%BC%81%E4%B8%9A%E5%8F%8A%E5%85%B3%E8%81%94%E8%88%B9%E8%88%B6%E5%8F%97%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633825000.webp","sourceId":"rfi"},{"id":1791633482000,"createdDate":"2026-10-10 11:58","name":"法国国际广播电台","title":"美国议员呼吁限制向更多的中国高校提供美国的研究资金","content":"一位美国共和党议员呼吁国防部对另外数十所中国高校实施美国研究资金限制，其中包括一所与美国顶尖商界领袖有联系的大学。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E7%BE%8E%E5%9B%BD%E8%AE%AE%E5%91%98%E5%91%BC%E5%90%81%E9%99%90%E5%88%B6%E5%90%91%E6%9B%B4%E5%A4%9A%E7%9A%84%E4%B8%AD%E5%9B%BD%E9%AB%98%E6%A0%A1%E6%8F%90%E4%BE%9B%E7%BE%8E%E5%9B%BD%E7%9A%84%E7%A0%94%E7%A9%B6%E8%B5%84%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633482000.webp","sourceId":"rfi"},{"id":1791633181000,"createdDate":"2026-10-10 11:53","name":"法国国际广播电台","title":"日本首相与外相就美国制裁国际刑事法院发表谈话表示深度关切","content":"针对美国特朗普政府将国际刑事法院（ICC）这一机构本身列为制裁对象，日本首相高市早苗10月9日在自己的X上投稿，日本外务大臣茂木敏充发表谈话，对这一制裁表示深度关切，并重申了日本坚决支持国际刑事法院的立场。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E4%B8%8E%E5%A4%96%E7%9B%B8%E5%B0%B1%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E5%8F%91%E8%A1%A8%E8%B0%88%E8%AF%9D%E8%A1%A8%E7%A4%BA%E6%B7%B1%E5%BA%A6%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633181000.webp","sourceId":"rfi"},{"id":1791626684000,"createdDate":"2026-10-10 10:04","name":"法国国际广播电台","title":"参与者被指受当局骚扰 美国已暂停在陆港澳的专业人才赴美交流项目招募","content":"据共同社援引知情人士报导称，由于中国有关部门骚扰潜在的参与者，美国已暂停在中国大陆、香港和澳门开展专业交流项目的参与者招募工作。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261010-%E5%8F%82%E4%B8%8E%E8%80%85%E8%A2%AB%E6%8C%87%E5%8F%97%E5%BD%93%E5%B1%80%E9%AA%9A%E6%89%B0-%E7%BE%8E%E5%9B%BD%E5%B7%B2%E6%9A%82%E5%81%9C%E5%9C%A8%E9%99%86%E6%B8%AF%E6%BE%B3%E7%9A%84%E4%B8%93%E4%B8%9A%E4%BA%BA%E6%89%8D%E8%B5%B4%E7%BE%8E%E4%BA%A4%E6%B5%81%E9%A1%B9%E7%9B%AE%E6%8B%9B%E5%8B%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791626684000.webp","sourceId":"rfi"},{"id":1791624604000,"createdDate":"2026-10-10 09:30","name":"法国国际广播电台","title":"美国称中国在台附近行动“极具破坏性”  赖清德:通过增加国防开支来“防止战争”","content":"路透社周六（10月10号）发自台北报道称，美国国务院表示，中国在台湾东海岸的海上行动“极具破坏性”，只会加剧紧张局势。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261010-%E7%BE%8E%E5%9B%BD%E7%A7%B0%E4%B8%AD%E5%9B%BD%E5%9C%A8%E5%8F%B0%E9%99%84%E8%BF%91%E8%A1%8C%E5%8A%A8-%E6%9E%81%E5%85%B7%E7%A0%B4%E5%9D%8F%E6%80%A7-%E8%B5%96%E6%B8%85%E5%BE%B7-%E9%80%9A%E8%BF%87%E5%A2%9E%E5%8A%A0%E5%9B%BD%E9%98%B2%E5%BC%80%E6%94%AF%E6%9D%A5-%E9%98%B2%E6%AD%A2%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791624604000.webp","sourceId":"rfi"},{"id":1791624426000,"createdDate":"2026-10-10 09:27","name":"法国国际广播电台","title":"涉转运搭载英伟达先进AI芯片服务器至中国 超微电脑案中间人认罪","content":"根据周五提交的一份法庭文件，一名与超微电脑（SuperMicroComputer）有关联的承包商已承认参与了一项非法向中国出口搭载英伟达先进人工智能芯片的计算机服务器的计划。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261010-%E6%B6%89%E8%BD%AC%E8%BF%90%E6%90%AD%E8%BD%BD%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%85%88%E8%BF%9Bai%E8%8A%AF%E7%89%87%E6%9C%8D%E5%8A%A1%E5%99%A8%E8%87%B3%E4%B8%AD%E5%9B%BD-%E8%B6%85%E5%BE%AE%E7%94%B5%E8%84%91%E6%A1%88%E4%B8%AD%E9%97%B4%E4%BA%BA%E8%AE%A4%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791624426000.webp","sourceId":"rfi"},{"id":1791618549000,"createdDate":"2026-10-10 07:49","name":"法国国际广播电台","title":"总统赖清德发表国庆演说 聚焦台湾经济成长表现要让全民共享福利","content":"台湾115年国庆大会在10日上午登场，由立法院长韩国瑜担任大会主席。赖清德总统发表就职后第三次国庆演说，今年焦点聚焦台湾亮眼经济成长。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261010-%E6%80%BB%E7%BB%9F%E8%B5%96%E6%B8%85%E5%BE%B7%E5%8F%91%E8%A1%A8%E5%9B%BD%E5%BA%86%E6%BC%94%E8%AF%B4-%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B9%BE%E7%BB%8F%E6%B5%8E%E6%88%90%E9%95%BF%E8%A1%A8%E7%8E%B0%E8%A6%81%E8%AE%A9%E5%85%A8%E6%B0%91%E5%85%B1%E4%BA%AB%E7%A6%8F%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791618549000.webp","sourceId":"rfi"},{"id":1791663378000,"createdDate":"2026-10-10 20:16","name":"法国国际广播电台","title":"德国编辑部网络：中国做出让步是精于算计的现实考量","content":"中国宣布将减少混合动力汽车对欧出口，引起德国媒体密切关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261010-%E5%BE%B7%E5%9B%BD%E7%BC%96%E8%BE%91%E9%83%A8%E7%BD%91%E7%BB%9C-%E4%B8%AD%E5%9B%BD%E5%81%9A%E5%87%BA%E8%AE%A9%E6%AD%A5%E6%98%AF%E7%B2%BE%E4%BA%8E%E7%AE%97%E8%AE%A1%E7%9A%84%E7%8E%B0%E5%AE%9E%E8%80%83%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791663378000.webp","sourceId":"rfi"},{"id":1791662276000,"createdDate":"2026-10-10 19:57","name":"法国国际广播电台","title":"伊朗情侣狱中完婚 几小时后新郎被绞死","content":"因抗议伊朗政权而入狱的一对年轻情侣，近日在狱中通过电话举行了婚礼。然而，就在结婚数小时后，新郎便遭绞刑而死，两人从此天人永隔。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261010-%E4%BC%8A%E6%9C%97%E6%83%85%E4%BE%A3%E7%8B%B1%E4%B8%AD%E5%AE%8C%E5%A9%9A-%E5%87%A0%E5%B0%8F%E6%97%B6%E5%90%8E%E6%96%B0%E9%83%8E%E8%A2%AB%E7%BB%9E%E6%AD%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791662276000.webp","sourceId":"rfi"},{"id":1791659988000,"createdDate":"2026-10-10 19:19","name":"法国国际广播电台","title":"台湾总统赖清德国庆演说引发国际关注和评论","content":"台湾总统赖清德10月10日发表国庆演说，中央社报道：外媒聚焦赖总统强调国防支出增加是为吓阻战争、民主国家团结共同应对威胁等角度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261010-%E5%8F%B0%E6%B9%BE%E6%80%BB%E7%BB%9F%E8%B5%96%E6%B8%85%E5%BE%B7%E5%9B%BD%E5%BA%86%E6%BC%94%E8%AF%B4%E5%BC%95%E5%8F%91%E5%9B%BD%E9%99%85%E5%85%B3%E6%B3%A8%E5%92%8C%E8%AF%84%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791659988000.webp","sourceId":"rfi"},{"id":1791657700000,"createdDate":"2026-10-10 18:41","name":"法国国际广播电台","title":"特朗普怒斥泽连斯基   说：“乌克兰该换总统了”！","content":"周六，特朗普严厉批评了乌克兰总统泽连斯基，称由于乌克兰无力结束与俄罗斯的战争，“乌克兰是时候换个总统了”。特朗普在白宫对记者表示：“我建议他们换个能达成协议的新领导人。”他谴责乌克兰袭击俄罗斯炼油厂的行为，称这些袭击只会加剧柴油短缺的“全球性问题”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261010-%E7%89%B9%E6%9C%97%E6%99%AE%E6%80%92%E6%96%A5%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E8%AF%B4-%E4%B9%8C%E5%85%8B%E5%85%B0%E8%AF%A5%E6%8D%A2%E6%80%BB%E7%BB%9F%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791657700000.webp","sourceId":"rfi"},{"id":1791648631000,"createdDate":"2026-10-10 16:10","name":"法国国际广播电台","title":"欧盟拟采取保障措施 旨将中国混动车进口量削减一半 或于12月实施","content":"据彭博社援引知情人士报导称，欧盟有意采取保障措施，将从中国进口的混合动力汽车数量削减一半。欧盟委员会贸易和经济安全委员谢夫乔维奇（MarosSefcovic）向欧洲官员通报称，尽管有关限制进口机制的具体事宜仍需下周与欧盟领导人讨论，但预计将采取保障措施。其中一位知情人士称，如果达成一致，这些措施可能于今年12月实施。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261010-%E6%AC%A7%E7%9B%9F%E6%8B%9F%E9%87%87%E5%8F%96%E4%BF%9D%E9%9A%9C%E6%8E%AA%E6%96%BD-%E6%97%A8%E5%B0%86%E4%B8%AD%E5%9B%BD%E6%B7%B7%E5%8A%A8%E8%BD%A6%E8%BF%9B%E5%8F%A3%E9%87%8F%E5%89%8A%E5%87%8F%E4%B8%80%E5%8D%8A-%E6%88%96%E4%BA%8E12%E6%9C%88%E5%AE%9E%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791648631000.webp","sourceId":"rfi"},{"id":1791647441000,"createdDate":"2026-10-10 15:50","name":"法国国际广播电台","title":"威特科夫等据报威胁若不停止袭击俄炼油厂或断情报支持 泽连斯基担心阿拉斯加2.0","content":"据英国《金融时报》报导，美国官员加大了对乌克兰的施压，要求其停止袭击俄罗斯炼油厂，并威胁若不听劝阻，将切断关键的情报共享；与此同时，美国总统特朗普宣布与俄方达成一项向全球市场供应柴油的协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E5%A8%81%E7%89%B9%E7%A7%91%E5%A4%AB%E7%AD%89%E6%8D%AE%E6%8A%A5%E5%A8%81%E8%83%81%E8%8B%A5%E4%B8%8D%E5%81%9C%E6%AD%A2%E8%A2%AD%E5%87%BB%E4%BF%84%E7%82%BC%E6%B2%B9%E5%8E%82%E6%88%96%E6%96%AD%E6%83%85%E6%8A%A5%E6%94%AF%E6%8C%81-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8B%85%E5%BF%83%E9%98%BF%E6%8B%89%E6%96%AF%E5%8A%A02-0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791647441000.webp","sourceId":"rfi"},{"id":1791643077000,"createdDate":"2026-10-10 14:37","name":"法国国际广播电台","title":"武汉封城时任市长 周先旺受贿案一审获刑14年","content":"据官媒新华社报导，河南省商丘市中级人民法院周六（10日）一审公开宣判湖北省政协原党组成员、副主席周先旺受贿一案，对被告人周先旺以受贿罪判处有期徒刑十四年，并处罚金人民币五百万元；对追缴在案的周先旺犯罪所得财物及孳息依法上缴国库，不足部分继续追缴。2018年5月，周先旺被任命为武汉市委副书记，市政府党组书记、副市长、代市长，4个月后转正。2021年1月，武汉市抗击新冠疫情一周年之际，周先旺辞去武汉市市长职务，之后转任湖北省政协副主席、党组成员，后于2023年1月卸任。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261010-%E6%AD%A6%E6%B1%89%E5%B0%81%E5%9F%8E%E6%97%B6%E4%BB%BB%E5%B8%82%E9%95%BF-%E5%91%A8%E5%85%88%E6%97%BA%E5%8F%97%E8%B4%BF%E6%A1%88%E4%B8%80%E5%AE%A1%E8%8E%B7%E5%88%9114%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791643077000.webp","sourceId":"rfi"},{"id":1791665136000,"createdDate":"2026-10-10 20:45","name":"法国国际广播电台","title":"特朗普：将“很快”决定是否加入沙特对胡塞武装的空袭行动","content":"德国、加拿大和西班牙周六建议其公民不要途经利雅得机场，该机场此前遭到也门胡塞武装的空袭。特朗普周六表示，在亲伊朗的胡塞武装袭击利雅得机场后，他将“很快”决定美国是否会加入沙特阿拉伯对也门胡塞武装的打击行动。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261010-%E7%89%B9%E6%9C%97%E6%99%AE-%E5%B0%86-%E5%BE%88%E5%BF%AB-%E5%86%B3%E5%AE%9A%E6%98%AF%E5%90%A6%E5%8A%A0%E5%85%A5%E6%B2%99%E7%89%B9%E5%AF%B9%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E7%9A%84%E7%A9%BA%E8%A2%AD%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791665136000.webp","sourceId":"rfi"},{"id":1791664583000,"createdDate":"2026-10-10 20:36","name":"法国国际广播电台","title":"古巴东部地区又一次大断电","content":"古巴国家电力公司周六宣布，在该岛陷入严重能源危机、华盛顿石油封锁长达九个月的背景下，古巴东部发生新的停电事件，导致该国失去电力供应。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261010-%E5%8F%A4%E5%B7%B4%E4%B8%9C%E9%83%A8%E5%9C%B0%E5%8C%BA%E5%8F%88%E4%B8%80%E6%AC%A1%E5%A4%A7%E6%96%AD%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791664583000.webp","sourceId":"rfi"},{"id":1791664368000,"createdDate":"2026-10-10 20:32","name":"法国国际广播电台","title":"被注射两剂死刑药物后仍存活    美国女囚返回监狱","content":"上周在美国被判死刑后“死里逃生”的克丽斯塔·派克（ChristaPike）已于周六出院返回监狱，她的律师宣布了这一消息。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261010-%E8%A2%AB%E6%B3%A8%E5%B0%84%E4%B8%A4%E5%89%82%E6%AD%BB%E5%88%91%E8%8D%AF%E7%89%A9%E5%90%8E%E4%BB%8D%E5%AD%98%E6%B4%BB-%E7%BE%8E%E5%9B%BD%E5%A5%B3%E5%9B%9A%E8%BF%94%E5%9B%9E%E7%9B%91%E7%8B%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791664368000.webp","sourceId":"rfi"},{"id":1791664023000,"createdDate":"2026-10-10 20:27","name":"法国国际广播电台","title":"巴勒斯坦摄影师马哈茂德·阿布·哈姆达荣获巴约战地记者奖","content":"巴勒斯坦摄影师马哈茂德·阿布·哈姆达（MahmoudAbuHamda）周六凭借其在加沙的报道，荣获享有盛誉的巴约战地记者奖摄影类奖项。除了最高奖项外，常驻加沙地带的哈姆达还凭借其报道《战争留下的痕迹》（Whatthewarleavesbehindit）荣获公众选择奖。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261010-%E5%B7%B4%E5%8B%92%E6%96%AF%E5%9D%A6%E6%91%84%E5%BD%B1%E5%B8%88%E9%A9%AC%E5%93%88%E8%8C%82%E5%BE%B7%C2%B7%E9%98%BF%E5%B8%83%C2%B7%E5%93%88%E5%A7%86%E8%BE%BE%E8%8D%A3%E8%8E%B7%E5%B7%B4%E7%BA%A6%E6%88%98%E5%9C%B0%E8%AE%B0%E8%80%85%E5%A5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791664023000.webp","sourceId":"rfi"},{"id":1791663767000,"createdDate":"2026-10-10 20:22","name":"法国国际广播电台","title":"卢比奥就驻日美军士兵涉抢劫杀人表示同情和慰问","content":"美国国务卿马可·卢比奥周一就冲绳一名女子遇害一事向日本外相茂木敏充表示“诚挚慰问”。据悉，一名美国海军陆战队员涉嫌与此案有关。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261010-%E5%8D%A2%E6%AF%94%E5%A5%A5%E5%B0%B1%E9%A9%BB%E6%97%A5%E7%BE%8E%E5%86%9B%E5%A3%AB%E5%85%B5%E6%B6%89%E6%8A%A2%E5%8A%AB%E6%9D%80%E4%BA%BA%E8%A1%A8%E7%A4%BA%E5%90%8C%E6%83%85%E5%92%8C%E6%85%B0%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791663767000.webp","sourceId":"rfi"},{"id":1791663424000,"createdDate":"2026-10-10 20:17","name":"法国国际广播电台","title":"英约克郡野生动物园出意外   一名男子被老虎咬成重伤","content":"警方称，周六，一名男子在英格兰北部约克郡野生动物园（YorkshireWildlife）遭到老虎袭击，身受重伤。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261010-%E8%8B%B1%E7%BA%A6%E5%85%8B%E9%83%A1%E9%87%8E%E7%94%9F%E5%8A%A8%E7%89%A9%E5%9B%AD%E5%87%BA%E6%84%8F%E5%A4%96-%E4%B8%80%E5%90%8D%E7%94%B7%E5%AD%90%E8%A2%AB%E8%80%81%E8%99%8E%E5%92%AC%E6%88%90%E9%87%8D%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791663424000.webp","sourceId":"rfi"},{"id":1791663074000,"createdDate":"2026-10-10 20:11","name":"法国国际广播电台","title":"郑钦文首进中网女单决赛    创中国网球历史","content":"10日在北京进行的2026中国网球公开赛女子单打半决赛中，中国选手郑钦文以7:5、6:2力克赛会13号种子、比利时名将梅尔滕斯，职业生涯首次晋级中网女单决赛。她将在11日的决赛中对阵4号种子、今年的法网女单冠军安德烈耶娃（MirraAndreeva）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261010-%E9%83%91%E9%92%A6%E6%96%87%E9%A6%96%E8%BF%9B%E4%B8%AD%E7%BD%91%E5%A5%B3%E5%8D%95%E5%86%B3%E8%B5%9B-%E5%88%9B%E4%B8%AD%E5%9B%BD%E7%BD%91%E7%90%83%E5%8E%86%E5%8F%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791663074000.webp","sourceId":"rfi"}]