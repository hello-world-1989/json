[{"id":1791641577000,"createdDate":"2026-10-10 14:12","name":"法国国际广播电台","title":"小马科斯谈其最大的担心 并指仍希望促成菲中南海油气联合勘探","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）在受访时表示，在南中国海等问题上，菲方对华立场与东盟其他声索国保持一致；他驳斥了有关菲律宾采取更强硬姿态可能使其成为地区例外的说法。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E5%B0%8F%E9%A9%AC%E7%A7%91%E6%96%AF%E8%B0%88%E5%85%B6%E6%9C%80%E5%A4%A7%E7%9A%84%E6%8B%85%E5%BF%83-%E5%B9%B6%E6%8C%87%E4%BB%8D%E5%B8%8C%E6%9C%9B%E4%BF%83%E6%88%90%E8%8F%B2%E4%B8%AD%E5%8D%97%E6%B5%B7%E6%B2%B9%E6%B0%94%E8%81%94%E5%90%88%E5%8B%98%E6%8E%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791641577000.webp","sourceId":"rfi"},{"id":1791634665000,"createdDate":"2026-10-10 12:17","name":"法国国际广播电台","title":"中国掀起AI 历史剧热潮却引发历史叙事权与AI创作边界的争议","content":"近年来中国兴起一股AI生成历史剧热潮，广受观众关注与讨论，像是《霍去病》、《问苍生》和《千里江山图》都在短时间内于平台上创下惊人播放量。然而，近来这部由网络小说改编的AI历史剧《秦始皇：朕有华夏全明星阵容》却引起争议，更被大量举报而导致最新一季审查停滞。部分批评者认为此剧带有中国沙文主义，部分内容与史实也有所不符。不过，究竟历史诠释权与ＡI创作自由的拿捏该如何衡量，中国网友们又是怎么看？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261010-%E4%B8%AD%E5%9B%BD%E6%8E%80%E8%B5%B7ai-%E5%8E%86%E5%8F%B2%E5%89%A7%E7%83%AD%E6%BD%AE%E5%8D%B4%E5%BC%95%E5%8F%91%E5%8E%86%E5%8F%B2%E5%8F%99%E4%BA%8B%E6%9D%83%E4%B8%8Eai%E5%88%9B%E4%BD%9C%E8%BE%B9%E7%95%8C%E7%9A%84%E4%BA%89%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791634665000.webp","sourceId":"rfi"},{"id":1791633825000,"createdDate":"2026-10-10 12:03","name":"法国国际广播电台","title":"美国针对伊朗“影子舰队”网络 多家中国企业及关联船舶受制裁","content":"美国国务院周四（8日）宣布对涉及伊朗原产石油或石化产品贸易的10个实体、6名个人及5艘船只实施制裁。此外，美国财政部当天也宣布对17个实体及伊朗“影子舰队”的船只实施制裁。这些措施旨在切断伊朗政权的资金来源，并阻止其利用“影子舰队”运输伊朗石油和石化产品以规避美方制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261010-%E7%BE%8E%E5%9B%BD%E9%92%88%E5%AF%B9%E4%BC%8A%E6%9C%97-%E5%BD%B1%E5%AD%90%E8%88%B0%E9%98%9F-%E7%BD%91%E7%BB%9C-%E5%A4%9A%E5%AE%B6%E9%99%86%E6%B8%AF%E4%BC%81%E4%B8%9A%E5%8F%8A%E5%85%B3%E8%81%94%E8%88%B9%E8%88%B6%E5%8F%97%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633825000.webp","sourceId":"rfi"},{"id":1791633482000,"createdDate":"2026-10-10 11:58","name":"法国国际广播电台","title":"美国议员呼吁限制向更多的中国高校提供美国的研究资金","content":"一位美国共和党议员呼吁国防部对另外数十所中国高校实施美国研究资金限制，其中包括一所与美国顶尖商界领袖有联系的大学。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E7%BE%8E%E5%9B%BD%E8%AE%AE%E5%91%98%E5%91%BC%E5%90%81%E9%99%90%E5%88%B6%E5%90%91%E6%9B%B4%E5%A4%9A%E7%9A%84%E4%B8%AD%E5%9B%BD%E9%AB%98%E6%A0%A1%E6%8F%90%E4%BE%9B%E7%BE%8E%E5%9B%BD%E7%9A%84%E7%A0%94%E7%A9%B6%E8%B5%84%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633482000.webp","sourceId":"rfi"},{"id":1791633181000,"createdDate":"2026-10-10 11:53","name":"法国国际广播电台","title":"日本首相与外相就美国制裁国际刑事法院发表谈话表示深度关切","content":"针对美国特朗普政府将国际刑事法院（ICC）这一机构本身列为制裁对象，日本首相高市早苗10月9日在自己的X上投稿，日本外务大臣茂木敏充发表谈话，对这一制裁表示深度关切，并重申了日本坚决支持国际刑事法院的立场。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261010-%E6%97%A5%E6%9C%AC%E9%A6%96%E7%9B%B8%E4%B8%8E%E5%A4%96%E7%9B%B8%E5%B0%B1%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E5%8F%91%E8%A1%A8%E8%B0%88%E8%AF%9D%E8%A1%A8%E7%A4%BA%E6%B7%B1%E5%BA%A6%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791633181000.webp","sourceId":"rfi"},{"id":1791626684000,"createdDate":"2026-10-10 10:04","name":"法国国际广播电台","title":"参与者被指受当局骚扰 美国已暂停在陆港澳的专业人才赴美交流项目招募","content":"据共同社援引知情人士报导称，由于中国有关部门骚扰潜在的参与者，美国已暂停在中国大陆、香港和澳门开展专业交流项目的参与者招募工作。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261010-%E5%8F%82%E4%B8%8E%E8%80%85%E8%A2%AB%E6%8C%87%E5%8F%97%E5%BD%93%E5%B1%80%E9%AA%9A%E6%89%B0-%E7%BE%8E%E5%9B%BD%E5%B7%B2%E6%9A%82%E5%81%9C%E5%9C%A8%E9%99%86%E6%B8%AF%E6%BE%B3%E7%9A%84%E4%B8%93%E4%B8%9A%E4%BA%BA%E6%89%8D%E8%B5%B4%E7%BE%8E%E4%BA%A4%E6%B5%81%E9%A1%B9%E7%9B%AE%E6%8B%9B%E5%8B%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791626684000.webp","sourceId":"rfi"},{"id":1791624604000,"createdDate":"2026-10-10 09:30","name":"法国国际广播电台","title":"美国称中国在台附近行动“极具破坏性”  赖清德:通过增加国防开支来“防止战争”","content":"路透社周六（10月10号）发自台北报道称，美国国务院表示，中国在台湾东海岸的海上行动“极具破坏性”，只会加剧紧张局势。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261010-%E7%BE%8E%E5%9B%BD%E7%A7%B0%E4%B8%AD%E5%9B%BD%E5%9C%A8%E5%8F%B0%E9%99%84%E8%BF%91%E8%A1%8C%E5%8A%A8-%E6%9E%81%E5%85%B7%E7%A0%B4%E5%9D%8F%E6%80%A7-%E8%B5%96%E6%B8%85%E5%BE%B7-%E9%80%9A%E8%BF%87%E5%A2%9E%E5%8A%A0%E5%9B%BD%E9%98%B2%E5%BC%80%E6%94%AF%E6%9D%A5-%E9%98%B2%E6%AD%A2%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791624604000.webp","sourceId":"rfi"},{"id":1791624426000,"createdDate":"2026-10-10 09:27","name":"法国国际广播电台","title":"涉转运搭载英伟达先进AI芯片服务器至中国 超微电脑案中间人认罪","content":"根据周五提交的一份法庭文件，一名与超微电脑（SuperMicroComputer）有关联的承包商已承认参与了一项非法向中国出口搭载英伟达先进人工智能芯片的计算机服务器的计划。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261010-%E6%B6%89%E8%BD%AC%E8%BF%90%E6%90%AD%E8%BD%BD%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%85%88%E8%BF%9Bai%E8%8A%AF%E7%89%87%E6%9C%8D%E5%8A%A1%E5%99%A8%E8%87%B3%E4%B8%AD%E5%9B%BD-%E8%B6%85%E5%BE%AE%E7%94%B5%E8%84%91%E6%A1%88%E4%B8%AD%E9%97%B4%E4%BA%BA%E8%AE%A4%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791624426000.webp","sourceId":"rfi"},{"id":1791618549000,"createdDate":"2026-10-10 07:49","name":"法国国际广播电台","title":"总统赖清德发表国庆演说 聚焦台湾经济成长表现要让全民共享福利","content":"台湾115年国庆大会在10日上午登场，由立法院长韩国瑜担任大会主席。赖清德总统发表就职后第三次国庆演说，今年焦点聚焦台湾亮眼经济成长。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261010-%E6%80%BB%E7%BB%9F%E8%B5%96%E6%B8%85%E5%BE%B7%E5%8F%91%E8%A1%A8%E5%9B%BD%E5%BA%86%E6%BC%94%E8%AF%B4-%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B9%BE%E7%BB%8F%E6%B5%8E%E6%88%90%E9%95%BF%E8%A1%A8%E7%8E%B0%E8%A6%81%E8%AE%A9%E5%85%A8%E6%B0%91%E5%85%B1%E4%BA%AB%E7%A6%8F%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/10/1791618549000.webp","sourceId":"rfi"}]