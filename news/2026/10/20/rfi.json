[{"id":1792502583000,"createdDate":"2026-10-20 13:23","name":"法国国际广播电台","title":"加拿大阿省公投决定「留在加拿大」 分析：更有底气跟美国谈判","content":"美国总统特朗普每次对加拿大喊出激烈言论，都会适得其反，令加拿大人更团结对抗美国的无理要求，最终损害美国的利益。不论是关税战，还有今天举行的阿尔伯塔省投票率最高的公投，当地人以大比数选择继续作为加拿大其中一个省，放弃独立主张。这个结果，令总理卡尼得到更多的筹码，跟美国进行长期的贸易谈判。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8C%97%E7%BE%8E%E6%9D%A5%E9%B8%BF/20261020-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E9%98%BF%E7%9C%81%E5%85%AC%E6%8A%95%E5%86%B3%E5%AE%9A-%E7%95%99%E5%9C%A8%E5%8A%A0%E6%8B%BF%E5%A4%A7-%E5%88%86%E6%9E%90-%E6%9B%B4%E6%9C%89%E5%BA%95%E6%B0%94%E8%B7%9F%E7%BE%8E%E5%9B%BD%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792502583000.webp","sourceId":"rfi"},{"id":1792502193000,"createdDate":"2026-10-20 13:16","name":"法国国际广播电台","title":"智谱四创办人据报曾与被英国军情五处示警的中国机构开发AI工具","content":"据彭博社报导，根据中国公开的研究论文以及英国军情五处（MI5）上月发布的一份“间谍警报”显示，中国最具潜力的人工智能公司之一——智谱（Z.ai）的四位创始人，曾参与过一项与中国通用技术研究院（CGTRI）的联合研究项目；而英方的上述警报称：“军情五处已认定，中国通用技术研究院的主要目的是资助那些能直接提升中国国安部间谍技术能力的学术研究”。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261020-%E6%99%BA%E8%B0%B1%E5%9B%9B%E5%88%9B%E5%8A%9E%E4%BA%BA%E6%8D%AE%E6%8A%A5%E6%9B%BE%E4%B8%8E%E8%A2%AB%E8%8B%B1%E5%9B%BD%E5%86%9B%E6%83%85%E4%BA%94%E5%A4%84%E7%A4%BA%E8%AD%A6%E7%9A%84%E4%B8%AD%E5%9B%BD%E6%9C%BA%E6%9E%84%E5%BC%80%E5%8F%91ai%E5%B7%A5%E5%85%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792502193000.webp","sourceId":"rfi"},{"id":1792496530000,"createdDate":"2026-10-20 11:42","name":"法国国际广播电台","title":"险些酿成事故 印尼调查疑似中国火箭残骸坠落事件","content":"印尼官方今天展开调查疑似中国火箭残骸事件，此前一块如汽车大小的金属残骸坠落在该国婆罗洲中加里曼丹省的一座棕榈油种植园，所幸未造成任何人员伤亡与财产损失。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261020-%E9%99%A9%E4%BA%9B%E9%85%BF%E6%88%90%E4%BA%8B%E6%95%85-%E5%8D%B0%E5%B0%BC%E8%B0%83%E6%9F%A5%E7%96%91%E4%BC%BC%E4%B8%AD%E5%9B%BD%E7%81%AB%E7%AE%AD%E6%AE%8B%E9%AA%B8%E5%9D%A0%E8%90%BD%E4%BA%8B%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792496530000.webp","sourceId":"rfi"},{"id":1792491695000,"createdDate":"2026-10-20 10:21","name":"法国国际广播电台","title":"字节、阿里和腾讯向英伟达订购了总值逾350亿美元的显卡","content":"据路透社援引两位知情人士报导称，字节跳动、阿里巴巴和腾讯已订购了超过300万张英伟达新款RTXPRO5500专业工作站显卡，总标价超过350亿美元。在美国对华贸易限制的背景下，这些中国科技巨头正争相采购此类性能相对较低、但符合出口合规要求的芯片。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261020-%E5%AD%97%E8%8A%82-%E9%98%BF%E9%87%8C%E5%92%8C%E8%85%BE%E8%AE%AF%E5%90%91%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%AE%A2%E8%B4%AD%E4%BA%86%E6%80%BB%E5%80%BC%E9%80%BE350%E4%BA%BF%E7%BE%8E%E5%85%83%E7%9A%84%E6%98%BE%E5%8D%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792491695000.webp","sourceId":"rfi"},{"id":1792489616000,"createdDate":"2026-10-20 09:46","name":"法国国际广播电台","title":"美国政府非军事机构全面禁用DeepSeek","content":"美国国土安全部昨(19日)天发出通告，要求美国民用机构的电脑系统移除中国开发的人工智能模型DeepSeek，以及所有使用DeepSeek第三方服务的系统和产品，并禁止机构日後采购相关产品。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261020-%E7%BE%8E%E5%9B%BD%E6%94%BF%E5%BA%9C%E9%9D%9E%E5%86%9B%E4%BA%8B%E6%9C%BA%E6%9E%84%E5%85%A8%E9%9D%A2%E7%A6%81%E7%94%A8deepseek","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792489616000.webp","sourceId":"rfi"},{"id":1792489553000,"createdDate":"2026-10-20 09:45","name":"法国国际广播电台","title":"涉涡轮机制造等 日本的钇供应据报仅能维持数月 求美促中放宽出口管制","content":"据英国《金融时报》报导，日本的关键金属钇供应仅能维持数月，已请求美国敦促中方放宽稀土出口管制，因为这些管制措施可能对全球汽车、国防和芯片行业造成严重干扰。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261020-%E6%B6%89%E6%B6%A1%E8%BD%AE%E6%9C%BA%E5%88%B6%E9%80%A0%E7%AD%89-%E6%97%A5%E6%9C%AC%E7%9A%84%E9%92%87%E4%BE%9B%E5%BA%94%E6%8D%AE%E6%8A%A5%E4%BB%85%E8%83%BD%E7%BB%B4%E6%8C%81%E6%95%B0%E6%9C%88-%E6%B1%82%E7%BE%8E%E4%BF%83%E4%B8%AD%E6%94%BE%E5%AE%BD%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792489553000.webp","sourceId":"rfi"},{"id":1792486974000,"createdDate":"2026-10-20 09:02","name":"法国国际广播电台","title":"前谷歌工程师丁林葳案后续 美国务院制裁五家中国实体","content":"美国已将一家由前微软人工智能科学家陆奇创立的中国风险投资机构列入黑名单，理由是该机构与一家被指控窃取谷歌技术的初创企业存在关联。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261020-%E5%89%8D%E8%B0%B7%E6%AD%8C%E5%B7%A5%E7%A8%8B%E5%B8%88%E4%B8%81%E6%9E%97%E8%91%B3%E6%A1%88%E5%90%8E%E7%BB%AD-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2%E5%88%B6%E8%A3%81%E4%BA%94%E5%AE%B6%E4%B8%AD%E5%9B%BD%E5%AE%9E%E4%BD%93","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792486974000.webp","sourceId":"rfi"},{"id":1792486309000,"createdDate":"2026-10-20 08:51","name":"法国国际广播电台","title":"黑客恶用源自中国开源 AI 网络安全工具  日企业泄漏信息1.8亿条","content":"在最近日本发生的大规模网络攻击事件中，民间网络公司通过调查发现，近期日本国内接连发生的非法访问网页事件中，有部分事件使用了中国背景的人工智能（AI）安全工具“ARTEX（阿尔特克斯）”。IT企业GMO互联网集团旗下专门从事信息安全业务的子公司的一名负责人表示：“经过调查，我们确认使用了中国背景的AI。”","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261020-%E9%BB%91%E5%AE%A2%E6%81%B6%E7%94%A8%E6%BA%90%E8%87%AA%E4%B8%AD%E5%9B%BD%E5%BC%80%E6%BA%90-ai-%E7%BD%91%E7%BB%9C%E5%AE%89%E5%85%A8%E5%B7%A5%E5%85%B7-%E6%97%A5%E4%BC%81%E4%B8%9A%E6%B3%84%E6%BC%8F%E4%BF%A1%E6%81%AF1-8%E4%BA%BF%E6%9D%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792486309000.webp","sourceId":"rfi"},{"id":1792485966000,"createdDate":"2026-10-20 08:46","name":"法国国际广播电台","title":"地方大选前7周提「松山机场迁建AI园区」引争议 蒋万安称产业发展更重要","content":"台北市长蒋万安宣布规画松山机场迁移，300公顷用地打造台北AI园区。然而，将土地开发与时下最热门的AI科技浪潮紧密相扣，看似充满经济诱因，但若缺乏长远的战略思考，将可能成为短视之举。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261020-%E5%9C%B0%E6%96%B9%E5%A4%A7%E9%80%89%E5%89%8D7%E5%91%A8%E6%8F%90-%E6%9D%BE%E5%B1%B1%E6%9C%BA%E5%9C%BA%E8%BF%81%E5%BB%BAai%E5%9B%AD%E5%8C%BA-%E5%BC%95%E4%BA%89%E8%AE%AE-%E8%92%8B%E4%B8%87%E5%AE%89%E7%A7%B0%E4%BA%A7%E4%B8%9A%E5%8F%91%E5%B1%95%E6%9B%B4%E9%87%8D%E8%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792485966000.webp","sourceId":"rfi"},{"id":1792485251000,"createdDate":"2026-10-20 08:34","name":"法国国际广播电台","title":"香港首办APEC财长会今早召开 先谈推动亚太区增长","content":"亚太经合组织APEC财政部长会议今(20日)早起一连两日在香港举行，今早先行召开的财长闭门会议，据议程显示，与会者就推动亚太区经济增长进行非正式讨论，中国财政部长蓝佛安下午会致开幕辞，并会通报APEC「中国年」工作进展及成果。香港特首李家超表示，财长会是下月APEC领导人非正式会议在深圳召开前最後一个专业部长级会议，对於香港发挥金融优势丶服务APEC中国年的意义重大。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261020-%E9%A6%99%E6%B8%AF%E9%A6%96%E5%8A%9Eapec%E8%B4%A2%E9%95%BF%E4%BC%9A%E4%BB%8A%E6%97%A9%E5%8F%AC%E5%BC%80-%E5%85%88%E8%B0%88%E6%8E%A8%E5%8A%A8%E4%BA%9A%E5%A4%AA%E5%8C%BA%E5%A2%9E%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/20/1792485251000.webp","sourceId":"rfi"}]