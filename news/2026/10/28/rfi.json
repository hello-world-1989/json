[{"id":1793200800000,"createdDate":"2026-10-28 15:20","name":"法国国际广播电台","title":"姆巴佩“不能翻译 ”的涉华言论继续发酵  皇马也道歉了","content":"法国球星基利安·姆巴佩涉华事件继续发酵。在姆巴佩本人，西甲联盟周二（10月27号）道歉之后，最新的进展是，周二拒绝置评皇家马德里方面周三也发出声明道歉。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261028-%E5%A7%86%E5%B7%B4%E4%BD%A9-%E4%B8%8D%E8%83%BD%E7%BF%BB%E8%AF%91-%E7%9A%84%E6%B6%89%E5%8D%8E%E8%A8%80%E8%AE%BA%E7%BB%A7%E7%BB%AD%E5%8F%91%E9%85%B5-%E7%9A%87%E9%A9%AC%E4%B9%9F%E9%81%93%E6%AD%89%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793200800000.webp","sourceId":"rfi"},{"id":1793198677000,"createdDate":"2026-10-28 14:44","name":"法国国际广播电台","title":"英财相要求在线交易平台代收零售商应缴纳的增值税 拟明年10月起实施","content":"英国财政大臣希利（JohnHealey）周三表示，将要求在线交易平台负责代收在其平台上销售的零售商所应缴纳的增值税（VAT）。希利在向英国议会发表预算演讲时称：“我将加强针对在线交易平台的监管要求，以确保卖家在进行在线销售时无法逃避缴纳增值税”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E8%8B%B1%E8%B4%A2%E7%9B%B8%E8%A6%81%E6%B1%82%E5%9C%A8%E7%BA%BF%E4%BA%A4%E6%98%93%E5%B9%B3%E5%8F%B0%E4%BB%A3%E6%94%B6%E9%9B%B6%E5%94%AE%E5%95%86%E5%BA%94%E7%BC%B4%E7%BA%B3%E7%9A%84%E5%A2%9E%E5%80%BC%E7%A8%8E-%E6%8B%9F%E6%98%8E%E5%B9%B410%E6%9C%88%E8%B5%B7%E5%AE%9E%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793198677000.webp","sourceId":"rfi"},{"id":1793197766000,"createdDate":"2026-10-28 14:29","name":"法国国际广播电台","title":"法媒热评被球迷比作独裁者的姆巴贝如何触碰了中国的敏感神经","content":"28日出版的法国全国性大报继续以大版篇幅聚焦对法国近期出现的大规模社会运动以及其中出现的暴力事件的调查和反思。各报在国际版关注的话题有：乌克兰战争进展、以色列大选、巴西总统选举、美国中期选举等等。法国足球明星姆巴贝因一则搞笑梗图而在中国卷入一场舆论风暴，连带他本人以及他服务的球队失去中国市场所代表的巨大经济利益。《解放报》、《费加罗报》和天主教报刊《十字架报》都刊登文章，发表评论。《费加罗报》也刊登文章，介绍正在召开的中共二十届五中全会。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261028-%E6%B3%95%E5%AA%92%E7%83%AD%E8%AF%84%E8%A2%AB%E7%90%83%E8%BF%B7%E6%AF%94%E4%BD%9C%E7%8B%AC%E8%A3%81%E8%80%85%E7%9A%84%E5%A7%86%E5%B7%B4%E8%B4%9D%E5%A6%82%E4%BD%95%E8%A7%A6%E7%A2%B0%E4%BA%86%E4%B8%AD%E5%9B%BD%E7%9A%84%E6%95%8F%E6%84%9F%E7%A5%9E%E7%BB%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793197766000.webp","sourceId":"rfi"},{"id":1793194883000,"createdDate":"2026-10-28 13:41","name":"法国国际广播电台","title":"美国将三家中国基因组学公司列入强迫劳动实体清单 禁止进口产品","content":"美国周三禁止从三家中国基因组学公司进口产品，理由是这些公司涉嫌与新疆当地政府合作，助力针对维吾尔族及其他少数民族的强迫劳动。这三家公司分别是：华大基因、华大智造以及深圳华大基因科技有限公司；美方指，该公司也被称为华大集团（BGIGroup）。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-%E7%BE%8E%E5%9B%BD%E5%B0%86%E4%B8%89%E5%AE%B6%E4%B8%AD%E5%9B%BD%E5%9F%BA%E5%9B%A0%E7%BB%84%E5%AD%A6%E5%85%AC%E5%8F%B8%E5%88%97%E5%85%A5%E5%BC%BA%E8%BF%AB%E5%8A%B3%E5%8A%A8%E5%AE%9E%E4%BD%93%E6%B8%85%E5%8D%95-%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3%E4%BA%A7%E5%93%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793194883000.webp","sourceId":"rfi"},{"id":1793193812000,"createdDate":"2026-10-28 13:23","name":"法国国际广播电台","title":"维吾尔语言学者：一个文化的命肯定比一个政治制度和政治人物长","content":"目前流亡挪威的维吾尔族学者阿不都外力-阿尤普（AbduweliAyup）是位语言学学者。多年前在美国留学期间参加的一次国际濒危语言记录大会让他对维吾尔语的存续传承已进入濒危状态有了切身具体的体验。2009年乌鲁木齐“七-五”事件爆发带来的伤痛以及随后十个月无法与在新疆的家人联络的经历更让他有了一种倘若失去母语以及母语文化“我将非我”的危机感。他于2013年因在新疆各地开办维吾尔语、英语和汉语三语幼儿园而被判刑入狱一年多。这次经历凸显出维吾尔语及有着深远历史渊源的维吾尔族传统文化面对的汉化压力。阿不都外力-阿尤普近日途径巴黎期间接受本台采访，为大家梳理中央政府一波又一波的同化政策推动如何让维吾尔语一步步陷入存续濒危的险境","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%85%AC%E6%B0%91%E8%AE%BA%E5%9D%9B/20261028-%E7%BB%B4%E5%90%BE%E5%B0%94%E8%AF%AD%E8%A8%80%E5%AD%A6%E5%AD%A6%E8%80%85-%E4%B8%80%E4%B8%AA%E6%96%87%E5%8C%96%E7%9A%84%E5%91%BD%E8%82%AF%E5%AE%9A%E6%AF%94%E4%B8%80%E4%B8%AA%E6%94%BF%E6%B2%BB%E4%BA%BA%E7%89%A9%E7%9A%84%E5%91%BD%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793193812000.webp","sourceId":"rfi"},{"id":1793192691000,"createdDate":"2026-10-28 13:04","name":"法国国际广播电台","title":"澳防长指有望从2030年前后接收弗吉尼亚级核潜艇 美海军科罗拉多号进驻西澳","content":"澳大利亚副总理兼国防部长马尔斯（RichardMarles）周三表示，澳方从美国获取首艘核动力潜艇的计划正按既定轨道推进。马尔斯在受访时说道：“我们正加紧工作，旨在为澳大利亚获得核动力潜艇能力制定出最佳路径”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-%E6%BE%B3%E9%98%B2%E9%95%BF%E6%8C%87%E6%9C%89%E6%9C%9B%E4%BB%8E2030%E5%B9%B4%E5%89%8D%E5%90%8E%E6%8E%A5%E6%94%B6%E5%BC%97%E5%90%89%E5%B0%BC%E4%BA%9A%E7%BA%A7%E6%A0%B8%E6%BD%9C%E8%89%87-%E7%BE%8E%E6%B5%B7%E5%86%9B%E7%A7%91%E7%BD%97%E6%8B%89%E5%A4%9A%E5%8F%B7%E8%BF%9B%E9%A9%BB%E8%A5%BF%E6%BE%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793192691000.webp","sourceId":"rfi"},{"id":1793191918000,"createdDate":"2026-10-28 12:51","name":"法国国际广播电台","title":"台湾九合一大选｜新竹成「蓝白合」核心指标示范区 「洋流」外溢拉抬绿营选情","content":"在2026年九合一地方大选中，新竹市与新竹县的选情被各界视为重塑台湾政治版图与在野合作的「关键试金石」。然而，在9月民众党宣布在竹北市「蓝白合」正式破局。在新竹市长选举也行成三强激烈竞争的「三脚督」态势。究竟在野整合在新竹发生什么事？这对九合一地方选举以及2028大选又有什么更深远的影响？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20261028-%E5%8F%B0%E6%B9%BE%E4%B9%9D%E5%90%88%E4%B8%80%E5%A4%A7%E9%80%89%EF%BD%9C%E6%96%B0%E7%AB%B9%E6%88%90-%E8%93%9D%E7%99%BD%E5%90%88-%E6%A0%B8%E5%BF%83%E6%8C%87%E6%A0%87%E7%A4%BA%E8%8C%83%E5%8C%BA-%E6%B4%8B%E6%B5%81-%E5%A4%96%E6%BA%A2%E6%8B%89%E6%8A%AC%E7%BB%BF%E8%90%A5%E9%80%89%E6%83%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793191918000.webp","sourceId":"rfi"},{"id":1793189015000,"createdDate":"2026-10-28 12:03","name":"法国国际广播电台","title":"巴基斯坦对台湾航空公司关闭领空 巴防长指遵循一中政策","content":"据彭博社周三报导，巴基斯坦已禁止台湾的航空公司使用其领空，以支持北京方面的“一个中国”立场；巴基斯坦也因此成为全球首个采取此类举措的国家。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261028-%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E5%AF%B9%E5%8F%B0%E6%B9%BE%E8%88%AA%E7%A9%BA%E5%85%AC%E5%8F%B8%E5%85%B3%E9%A2%86%E7%A9%BA-%E5%B7%B4%E9%98%B2%E9%95%BF%E7%A7%B0%E9%81%B5%E5%BE%AA%E4%B8%80%E4%B8%AD%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793189015000.webp","sourceId":"rfi"},{"id":1793187408000,"createdDate":"2026-10-28 11:36","name":"法国国际广播电台","title":"陆委会称中共操作「艺人牌」企图介入台湾地方选举、加深社会对立","content":"陆委会表示，中共介选不仅再次操弄「艺人牌」，还扩大实施跨境镇压，试图制造台湾社会对立。台湾学者警告，中共介选比起左右选情，更是一场破坏民主的长期认知作战，目的是要分化台湾民众。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261028-%E9%99%86%E5%A7%94%E4%BC%9A%E7%A7%B0%E4%B8%AD%E5%85%B1%E6%93%8D%E4%BD%9C-%E8%89%BA%E4%BA%BA%E7%89%8C-%E4%BC%81%E5%9B%BE%E4%BB%8B%E5%85%A5%E5%8F%B0%E6%B9%BE%E5%9C%B0%E6%96%B9%E9%80%89%E4%B8%BE-%E5%8A%A0%E6%B7%B1%E7%A4%BE%E4%BC%9A%E5%AF%B9%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793187408000.webp","sourceId":"rfi"},{"id":1793187234000,"createdDate":"2026-10-28 11:33","name":"法国国际广播电台","title":"欧方经济高官拟访华 旨说服中方停止压低人民币汇率","content":"据《南华早报》报导，在成功促使中方同意对其混合动力汽车出口设定上限后，未来几个月，多位欧洲高级金融与银行官员将前往中国首都，执行一项更为棘手的任务：说服北京方面停止压低人民币汇率，以帮助挽救欧盟陷入困境的产业。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261028-%E6%AC%A7%E6%96%B9%E7%BB%8F%E6%B5%8E%E9%AB%98%E5%AE%98%E6%8B%9F%E8%AE%BF%E5%8D%8E-%E6%97%A8%E8%AF%B4%E6%9C%8D%E4%B8%AD%E6%96%B9%E5%81%9C%E6%AD%A2%E5%8E%8B%E4%BD%8E%E4%BA%BA%E6%B0%91%E5%B8%81%E6%B1%87%E7%8E%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793187234000.webp","sourceId":"rfi"},{"id":1793186393000,"createdDate":"2026-10-28 11:19","name":"法国国际广播电台","title":"东盟防长会议 菲防长拟提出解决南海和泰柬争端问题","content":"菲律宾防长特奥多罗今天主持召开第20届东盟国防部长会议，他表示南海问题是会议讨论的一部分。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261028-%E4%B8%9C%E7%9B%9F%E9%98%B2%E9%95%BF%E5%B3%B0%E4%BC%9A-%E8%8F%B2%E5%BE%8B%E6%8F%90%E5%87%BA%E8%A7%A3%E5%86%B3%E5%8D%97%E6%B5%B7%E5%92%8C%E6%B3%B0%E6%9F%AC%E4%BA%89%E7%AB%AF%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793186393000.webp","sourceId":"rfi"},{"id":1793184899000,"createdDate":"2026-10-28 10:54","name":"法国国际广播电台","title":"冯哲芸： 北京正就叙利亚维吾尔人议题与大马士革谈判","content":"十多年前叙利亚内战最激烈的时候外界发现一群来自中国的维吾尔人出现在反叛武装的阵营中，今天叙利亚的战火已熄，这群维吾尔人的命运如何？他们与叙利亚新政府的关系如何？北京政府是否已经就维吾尔议题向叙利亚新政府施压？这批来自新疆的维吾尔人又是通过何种途径来到叙利亚的？他们为何要与反叛组织并肩作战？十多年来他们与叙利亚当地人相处得如何？他们对自己的未来又有何期待？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE/20261028-%E5%86%AF%E5%93%B2%E8%8A%B8-%E5%8C%97%E4%BA%AC%E6%94%BF%E5%BA%9C%E6%AD%A3%E5%B0%B1%E5%8F%99%E5%88%A9%E4%BA%9A%E7%BB%B4%E5%90%BE%E5%B0%94%E4%BA%BA%E4%B8%8E%E6%96%B0%E6%94%BF%E5%BA%9C%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793184899000.webp","sourceId":"rfi"},{"id":1793184842000,"createdDate":"2026-10-28 10:54","name":"法国国际广播电台","title":"美国防长提议东盟与美国建立“雄心勃勃”的防务框架","content":"美国国防部长皮特·赫格塞斯周三(10月28号)在菲律宾提议与东盟建立一个新的、雄心勃勃的防务框架，并告诉东盟领导人，这一伙伴关系可以帮助他们应对未来几年“至关重要”的挑战。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-%E7%BE%8E%E5%9B%BD%E9%98%B2%E9%95%BF%E6%8F%90%E8%AE%AE%E4%B8%9C%E7%9B%9F%E4%B8%8E%E7%BE%8E%E5%9B%BD%E5%BB%BA%E7%AB%8B-%E9%9B%84%E5%BF%83%E5%8B%83%E5%8B%83-%E7%9A%84%E9%98%B2%E5%8A%A1%E6%A1%86%E6%9E%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793184842000.webp","sourceId":"rfi"},{"id":1793180905000,"createdDate":"2026-10-28 09:48","name":"法国国际广播电台","title":"为何习近平向福田遗属而非高市致唁电 日官房长官：这是中方的考量","content":"日本内阁官房长官木原稔在周三的记者会上，未就中国国家主席习近平在福田康夫前首相去世后向其遗属，而非现任首相高市早苗发送唁电一事作出说明。木原表示：“日本政府不处于对此进行说明的立场。这是中方的考量”。去年，在前首相村山富市去世时，习近平曾向时任日本首相石破茂发送过唁电。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261028-%E4%B8%BA%E4%BD%95%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%91%E7%A6%8F%E7%94%B0%E9%81%97%E5%B1%9E%E8%80%8C%E9%9D%9E%E9%AB%98%E5%B8%82%E8%87%B4%E5%94%81%E7%94%B5-%E6%97%A5%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98-%E8%BF%99%E6%98%AF%E4%B8%AD%E6%96%B9%E7%9A%84%E8%80%83%E9%87%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793180905000.webp","sourceId":"rfi"},{"id":1793179844000,"createdDate":"2026-10-28 09:30","name":"法国国际广播电台","title":"泽连斯基：望俄中美峰会不会成为新雅尔塔会议，看不出对中方有何好处","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）在受访时推测，在俄、中、美三方可能举行的会晤中，可能会讨论中东和乌克兰相关议题。他指出，俄方对这类会晤最感兴趣，因为这种形式能为莫斯科带来重大的外交优势。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E6%9C%9B%E4%BF%84%E4%B8%AD%E7%BE%8E%E5%B3%B0%E4%BC%9A%E4%B8%8D%E4%BC%9A%E6%88%90%E4%B8%BA%E6%96%B0%E9%9B%85%E5%B0%94%E5%A1%94%E4%BC%9A%E8%AE%AE%EF%BC%8C%E7%9C%8B%E4%B8%8D%E5%87%BA%E5%AF%B9%E4%B8%AD%E6%96%B9%E6%9C%89%E4%BB%80%E4%B9%88%E5%A5%BD%E5%A4%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793179844000.webp","sourceId":"rfi"},{"id":1793177782000,"createdDate":"2026-10-28 08:56","name":"法国国际广播电台","title":"日美防长会谈 确认为强化第一岛链防卫合作","content":"日本防卫大臣小泉进次郎与美国国防部长赫格塞思于10月28日在访问菲律宾中部城市宿务期间举行会谈。美国国防部宣布，双方一致认为，“为构建第一岛链的有效防御态势，增加国防投资并持续开展战略协调至关重要”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261028-%E6%97%A5%E7%BE%8E%E9%98%B2%E9%95%BF%E4%BC%9A%E8%B0%88-%E7%A1%AE%E8%AE%A4%E4%B8%BA%E5%BC%BA%E5%8C%96%E7%AC%AC%E4%B8%80%E5%B2%9B%E9%93%BE%E9%98%B2%E5%8D%AB%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793177782000.webp","sourceId":"rfi"},{"id":1793176993000,"createdDate":"2026-10-28 08:43","name":"法国国际广播电台","title":"港女诱骗友人到缅甸诈骗园遭判刑4年 惟新园区正招人 诈骗目标为英语人士","content":"在中国和东南亚国家大力打击当地电骗园区的背景下，香港区域法院昨(27日)午裁定，一名在港诱骗两名女子到缅甸诈骗园区的港女入狱四年。事件中，被「卖猪仔」的两名港女的家人须付出20万至30万港元(折合约2.3万至3.4万欧元)赎款才能回港，法官则指责被告行为歹毒丶泯灭人性。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261028-%E6%B8%AF%E5%A5%B3%E8%AF%B1%E9%AA%97%E5%8F%8B%E4%BA%BA%E5%88%B0%E7%BC%85%E7%94%B8%E8%AF%88%E9%AA%97%E5%9B%AD%E9%81%AD%E5%88%A4%E5%88%914%E5%B9%B4-%E6%83%9F%E6%96%B0%E5%9B%AD%E5%8C%BA%E6%AD%A3%E6%8B%9B%E4%BA%BA-%E8%AF%88%E9%AA%97%E7%9B%AE%E6%A0%87%E4%B8%BA%E8%8B%B1%E8%AF%AD%E4%BA%BA%E5%A3%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793176993000.webp","sourceId":"rfi"},{"id":1793172819000,"createdDate":"2026-10-28 07:33","name":"法国国际广播电台","title":"视频 球星姆巴佩道歉 只因被指提及毛泽东“表情包”网络梗 在中国遭品牌抵制","content":"多家中国品牌已宣布与法国国家队队长姆巴佩（KylianMbappé）终止合作，有报道称事情起因是此前姆巴佩的一段视频暗示中国已故领导人毛泽东为“独裁者”的梗图，引发不满，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261028-%E8%A7%86%E9%A2%91-%E7%90%83%E6%98%9F%E5%A7%86%E5%B7%B4%E4%BD%A9%E9%81%93%E6%AD%89-%E5%8F%AA%E5%9B%A0%E8%A2%AB%E6%8C%87%E6%8F%90%E5%8F%8A%E5%89%8D%E9%A2%86%E5%AF%BC%E4%BA%BA%E7%9A%84-%E8%A1%A8%E6%83%85%E5%8C%85-%E7%BD%91%E7%BB%9C%E6%A2%97-%E5%9C%A8%E4%B8%AD%E5%9B%BD%E9%81%AD%E5%93%81%E7%89%8C%E6%8A%B5%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793172819000.webp","sourceId":"rfi"},{"id":1793222039000,"createdDate":"2026-10-28 21:13","name":"法国国际广播电台","title":"西班牙交通部长初步判定是调度出错儿","content":"西班牙首都马德里以南发生两列高速列车追尾相撞事故，导致多节车厢脱轨、至少68人死亡，另有108人受伤，目前还不清楚有没有失踪的乘客。桑切斯宣布全国哀悼三天。西班牙交通部长奥斯卡·普恩特（OscarPuente）提及了“人为事故”，目前正在调查是否调度出现误判，今后如何避免此种悲剧。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E8%A5%BF%E7%8F%AD%E7%89%99%E4%BA%A4%E9%80%9A%E9%83%A8%E9%95%BF%E5%88%9D%E6%AD%A5%E5%88%A4%E5%AE%9A%E6%98%AF%E8%B0%83%E5%BA%A6%E5%87%BA%E9%94%99%E5%84%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793222039000.webp","sourceId":"rfi"},{"id":1793221793000,"createdDate":"2026-10-28 21:09","name":"法国国际广播电台","title":"中国显现焚烧姆巴佩法国队或皇马球衣视频","content":"“我永远不会原谅他”：一名中国公民拍摄自己焚烧印有姆巴佩名字的球衣视频在中国，姆巴佩关于毛泽东的言论引发的愤怒情绪持续升温。一些中国公民拍摄了自己焚烧姆巴佩球衣或损毁印有他头像的广告海报的视频。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E4%B8%AD%E5%9B%BD%E6%98%BE%E7%8E%B0%E7%84%9A%E7%83%A7%E5%A7%86%E5%B7%B4%E4%BD%A9%E6%B3%95%E5%9B%BD%E9%98%9F%E6%88%96%E7%9A%87%E9%A9%AC%E7%90%83%E8%A1%A3%E8%A7%86%E9%A2%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793221793000.webp","sourceId":"rfi"},{"id":1793221476000,"createdDate":"2026-10-28 21:04","name":"法国国际广播电台","title":"皇马就姆巴佩涉华言论致歉","content":"皇家马德里俱乐部周三就其球星姆巴佩疑似拿毛泽东开玩笑一事向中国道歉。该言论引发社交媒体风暴，并导致西班牙足球赛事被中国国家电视台停播","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E7%9A%87%E9%A9%AC%E5%B0%B1%E5%A7%86%E5%B7%B4%E4%BD%A9%E6%B6%89%E5%8D%8E%E8%A8%80%E8%AE%BA%E8%87%B4%E6%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793221476000.webp","sourceId":"rfi"},{"id":1793221271000,"createdDate":"2026-10-28 21:01","name":"法国国际广播电台","title":"法国参议院通过“谁砸谁赔”法案：示威者须对街头示威活动造成损失负担财务责任","content":"法国国会参议院28日通过一项法案，规定示威者须对街头示威活动造成的损失负担财务责任。尽管批评者警告，此举可能限制人民的抗议权利，法案仍获得通过。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261028-%E6%B3%95%E5%9B%BD%E5%8F%82%E8%AE%AE%E9%99%A2%E9%80%9A%E8%BF%87-%E8%B0%81%E7%A0%B8%E8%B0%81%E8%B5%94-%E6%B3%95%E6%A1%88-%E7%A4%BA%E5%A8%81%E8%80%85%E9%A1%BB%E5%AF%B9%E8%A1%97%E5%A4%B4%E7%A4%BA%E5%A8%81%E6%B4%BB%E5%8A%A8%E9%80%A0%E6%88%90%E6%8D%9F%E5%A4%B1%E8%B4%9F%E6%8B%85%E8%B4%A2%E5%8A%A1%E8%B4%A3%E4%BB%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793221271000.webp","sourceId":"rfi"},{"id":1793221171000,"createdDate":"2026-10-28 20:59","name":"法国国际广播电台","title":"法新社：败选的弗拉维奥·博索纳罗已抵美国","content":"据法新社记者报道，在总统选举中落败后逃离巴西并接受多项调查的弗拉维奥·博索纳罗于周三抵达美国。他的护照已经被吊销，卢拉周二宣称，弗拉维奥·博索纳罗逃离巴西是“可耻的”。卢拉在81岁生日庆祝活动上愤怒地说道：“巴西已经不是他第一故乡。他的第一故乡是舔美国的靴子”。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261028-%E6%B3%95%E6%96%B0%E7%A4%BE-%E8%B4%A5%E9%80%89%E7%9A%84%E5%BC%97%E6%8B%89%E7%BB%B4%E5%A5%A5%C2%B7%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E5%B7%B2%E6%8A%B5%E7%BE%8E%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793221171000.webp","sourceId":"rfi"},{"id":1793220930000,"createdDate":"2026-10-28 20:55","name":"法国国际广播电台","title":"COP31呼吁各国就人工智能带来的气候挑战做出承诺","content":"COP31主席国周三发布了首份关于人工智能（AI）问题的政策文件，呼吁各国自愿承诺将人工智能作为“应对气候挑战的解决方案之一”，而不是温室气体排放激增的新来源。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-cop31%E5%91%BC%E5%90%81%E5%90%84%E5%9B%BD%E5%B0%B1%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%B8%A6%E6%9D%A5%E7%9A%84%E6%B0%94%E5%80%99%E6%8C%91%E6%88%98%E5%81%9A%E5%87%BA%E6%89%BF%E8%AF%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793220930000.webp","sourceId":"rfi"},{"id":1793220278000,"createdDate":"2026-10-28 20:44","name":"法国国际广播电台","title":"伦敦向银行征税减轻家庭能源负担","content":"英国政府周三在公布其首份预算案时宣布，将提高银行附加费，以资助对家庭的定向援助，特别是帮助家庭支付能源账单。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E4%BC%A6%E6%95%A6%E5%90%91%E9%93%B6%E8%A1%8C%E5%BE%81%E7%A8%8E%E5%87%8F%E8%BD%BB%E5%AE%B6%E5%BA%AD%E8%83%BD%E6%BA%90%E8%B4%9F%E6%8B%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793220278000.webp","sourceId":"rfi"},{"id":1793219962000,"createdDate":"2026-10-28 20:39","name":"法国国际广播电台","title":"科威特谴责伊朗“干涉”其内政","content":"科威特周三谴责伊朗“公然干涉”其内政，此前科威特判处一名伊朗公民死刑，罪名是策划暗杀科威特一位部长。德黑兰方面也对这一判决表示谴责。据法新社报道，两名司法消息人士透露，这名伊朗男子和另外两人于周一被判处死刑，他们被控策划暗杀科威特副首相兼内政部长法赫德·优素福（Fahadal-Yousef）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261028-%E7%A7%91%E5%A8%81%E7%89%B9%E8%B0%B4%E8%B4%A3%E4%BC%8A%E6%9C%97-%E5%B9%B2%E6%B6%89-%E5%85%B6%E5%86%85%E6%94%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793219962000.webp","sourceId":"rfi"},{"id":1793219540000,"createdDate":"2026-10-28 20:32","name":"法国国际广播电台","title":"英极右翼活动人士汤米·罗宾逊被判骚扰记者罪名成立","content":"英国极右翼活动家汤米·罗宾逊（TommyRobinson）周三在伦敦被判骚扰《每日邮报》两名记者罪名成立，他曾在社交媒体上威胁这两名记者。罗宾逊真名斯蒂芬·亚克斯利-连农（StephenYaxley-Lennon），现年43岁，将于12月16日接受量刑。在此之前，他仍可保释。这位曾多次入狱的活动家面临最高十年的监禁。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E8%8B%B1%E6%9E%81%E5%8F%B3%E7%BF%BC%E6%B4%BB%E5%8A%A8%E4%BA%BA%E5%A3%AB%E6%B1%A4%E7%B1%B3%C2%B7%E7%BD%97%E5%AE%BE%E9%80%8A%E8%A2%AB%E5%88%A4%E9%AA%9A%E6%89%B0%E8%AE%B0%E8%80%85%E7%BD%AA%E5%90%8D%E6%88%90%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793219540000.webp","sourceId":"rfi"},{"id":1793218986000,"createdDate":"2026-10-28 20:23","name":"法国国际广播电台","title":"大众汽车：“在中国研发的技术更具竞争力”","content":"大众汽车周三宣布，已完成其在中国研发的关键技术，这将使这家陷入困境的集团能够到2030年实现每年从中国向发展中国家出口30万辆汽车的目标。大众制造商还表示，将首次把这些“中国制造”的技术出口到海外（亚洲、中东和南美），但“目前”暂不出口到欧洲。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261028-%E5%A4%A7%E4%BC%97%E6%B1%BD%E8%BD%A6-%E5%9C%A8%E4%B8%AD%E5%9B%BD%E7%A0%94%E5%8F%91%E7%9A%84%E6%8A%80%E6%9C%AF%E6%9B%B4%E5%85%B7%E7%AB%9E%E4%BA%89%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793218986000.webp","sourceId":"rfi"},{"id":1793217768000,"createdDate":"2026-10-28 20:02","name":"法国国际广播电台","title":"姆巴佩辱华事件：毫无幽默感的国度把自己制成全球笑料","content":"正常情况下，一个缺乏幽默感的人是难以令别人发笑的，但一个毫无幽默感的国家却居然能让全世界啼笑皆非，甚至成了全球笑料。这就是法国球星姆巴佩不经意间引发的真实故事：一句并无恶意的玩笑，竟引发了一场不折不扣的国际政治风波。政治小白姆巴佩不明不白地付出惨重代价，但最后的输家并不是他。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261028-%E5%A7%86%E5%B7%B4%E4%BD%A9%E8%BE%B1%E5%8D%8E%E4%BA%8B%E4%BB%B6-%E6%AF%AB%E6%97%A0%E5%B9%BD%E9%BB%98%E6%84%9F%E7%9A%84%E5%9B%BD%E5%BA%A6%E6%8A%8A%E8%87%AA%E5%B7%B1%E5%88%B6%E6%88%90%E5%85%A8%E7%90%83%E7%AC%91%E6%96%99","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793217768000.webp","sourceId":"rfi"},{"id":1793210462000,"createdDate":"2026-10-28 18:01","name":"法国国际广播电台","title":"支持朝鲜融资网络？华盛顿予以制裁","content":"美国财政部周三宣布对约10名个人和一家公司实施制裁，指控他们协助建立一个旨在“诈骗美国公司并为朝鲜牟利“的网络。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261028-%E6%94%AF%E6%8C%81%E6%9C%9D%E9%B2%9C%E8%9E%8D%E8%B5%84%E7%BD%91%E7%BB%9C-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%BA%88%E4%BB%A5%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793210462000.webp","sourceId":"rfi"},{"id":1793205214000,"createdDate":"2026-10-28 16:33","name":"法国国际广播电台","title":"日菲防长会 日方承诺尽快向菲海军移交阿武隈级护卫舰","content":"随着两国不断扩大防务合作，菲律宾与日本已达成共识，将推动在日本海上自卫队的阿武隈级护卫舰退役后，尽快将首艘该级军舰移交给菲律宾海军。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261028-%E6%97%A5%E8%8F%B2%E9%98%B2%E9%95%BF%E4%BC%9A-%E6%97%A5%E6%96%B9%E6%89%BF%E8%AF%BA%E5%B0%BD%E5%BF%AB%E5%90%91%E8%8F%B2%E6%B5%B7%E5%86%9B%E7%A7%BB%E4%BA%A4%E9%98%BF%E6%AD%A6%E9%9A%88%E7%BA%A7%E6%8A%A4%E5%8D%AB%E8%88%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793205214000.webp","sourceId":"rfi"},{"id":1793203337000,"createdDate":"2026-10-28 16:02","name":"法国国际广播电台","title":"朝令夕改？巴基斯坦允许华航和长荣使用其领空至明年3月27日","content":"巴基斯坦周三准许台湾航空公司使用其领空，期限至2027年3月。根据《黎明报》所见文件，台湾的中华航空和长荣航空已获准在2027年3月27日之前运营相关航班。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261028-%E6%9C%9D%E4%BB%A4%E5%A4%95%E6%94%B9-%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E5%85%81%E8%AE%B8%E5%8D%8E%E8%88%AA%E5%92%8C%E9%95%BF%E8%8D%A3%E4%BD%BF%E7%94%A8%E5%85%B6%E9%A2%86%E7%A9%BA%E8%87%B3%E6%98%8E%E5%B9%B43%E6%9C%8827%E6%97%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793203337000.webp","sourceId":"rfi"},{"id":1793203128000,"createdDate":"2026-10-28 15:58","name":"法国国际广播电台","title":"西班牙今年第二起火车事故至少68人遇难 首相：“整个国家都在悲痛中”","content":"据西班牙官方消息，周三（10月28号）在马德里以南约150公里处发生的两列火车相撞事故造成至少68人死亡，几十人受伤。这一初步统计的死亡人数使其成为继今年1月的惨剧之后，西班牙最严重的铁路事故之一。首相桑切斯周三称“整个西班牙都沉浸在悲痛之中”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261028-%E8%A5%BF%E7%8F%AD%E7%89%99%E4%BB%8A%E5%B9%B4%E7%AC%AC%E4%BA%8C%E8%B5%B7%E7%81%AB%E8%BD%A6%E4%BA%8B%E6%95%85%E8%87%B3%E5%B0%9168%E4%BA%BA%E9%81%87%E9%9A%BE-%E6%80%BB%E7%90%86-%E6%95%B4%E4%B8%AA%E5%9B%BD%E5%AE%B6%E9%83%BD%E5%9C%A8%E6%82%B2%E7%97%9B%E4%B8%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793203128000.webp","sourceId":"rfi"},{"id":1793202067000,"createdDate":"2026-10-28 15:41","name":"法国国际广播电台","title":"高市称日德为“优质伙伴” 默茨指双方共同点之多可称邻国","content":"日本首相高市早苗周三在东京官邸与到访的德国总理默茨（FriedrichMerz）举行了会谈，双方就建立“日德人工智能高层对话”以推进在人工智能（AI）领域的合作达成共识。鉴于中国实施的出口管制，日德双方确认将在经济安保领域加强协作。默茨在会谈后的联合记者会上表示，有意参与由日本、英国和意大利共同推进的下一代战斗机开发计划——“全球作战空中计划”。这是默茨自去年5月就任德国总理以来首次访日。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261028-%E9%AB%98%E5%B8%82%E7%A7%B0%E6%97%A5%E5%BE%B7%E4%B8%BA-%E4%BC%98%E8%B4%A8%E4%BC%99%E4%BC%B4-%E9%BB%98%E8%8C%A8%E6%8C%87%E5%8F%8C%E6%96%B9%E5%85%B1%E5%90%8C%E7%82%B9%E4%B9%8B%E5%A4%9A%E5%8F%AF%E7%A7%B0%E4%B8%BA%E9%82%BB%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/28/1793202067000.webp","sourceId":"rfi"}]