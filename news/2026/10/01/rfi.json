[{"id":1790866387000,"createdDate":"2026-10-01 14:53","name":"法国国际广播电台","title":"解放报专访《当中国操纵世界》新书作者：让人以为中国绝对不可或缺，是其施加影响力的核心杠杆！","content":"《解放报》10月1日登出该报对《当中国操纵世界》这本新书作者战略研究基金会（FRC）亚洲国际关系与战略问题专家瓦莱丽·尼凯（ValérieNiquet）的专访实录，并指出可以一句话总结：中国塑造“看起来”比实际上更强大的形象，这就是这位国际关系研究员关于北京影响力战略的理论。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261001-%E8%A7%A3%E6%94%BE%E6%8A%A5%E4%B8%93%E8%AE%BF-%E5%BD%93%E4%B8%AD%E5%9B%BD%E6%93%8D%E7%BA%B5%E4%B8%96%E7%95%8C-%E6%96%B0%E4%B9%A6%E4%BD%9C%E8%80%85-%E8%AE%A9%E4%BA%BA%E4%BB%A5%E4%B8%BA%E4%B8%AD%E5%9B%BD%E7%BB%9D%E5%AF%B9%E4%B8%8D%E5%8F%AF%E6%88%96%E7%BC%BA%EF%BC%8C%E6%98%AF%E5%85%B6%E6%96%BD%E5%8A%A0%E5%BD%B1%E5%93%8D%E5%8A%9B%E7%9A%84%E6%A0%B8%E5%BF%83%E6%9D%A0%E6%9D%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790866387000.webp","sourceId":"rfi"},{"id":1790864673000,"createdDate":"2026-10-01 14:24","name":"法国国际广播电台","title":"美网安公司指疑似中国黑客冒充美AI前高官及Anthropic高管以获信息","content":"一家美国网络安全公司周四表示，疑似来自中国的黑客曾冒充Anthropic公司员工及美国前官员，发起了一场旨在窥探美国人工智能（AI）发展情况的间谍活动。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261001-%E7%BE%8E%E7%BD%91%E5%AE%89%E5%85%AC%E5%8F%B8%E6%8C%87%E7%96%91%E4%BC%BC%E4%B8%AD%E5%9B%BD%E9%BB%91%E5%AE%A2%E5%86%92%E5%85%85%E7%BE%8Eai%E9%AB%98%E5%AE%98%E5%8F%8Aanthropic%E9%AB%98%E7%AE%A1%E4%BB%A5%E8%8E%B7%E4%BF%A1%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790864673000.webp","sourceId":"rfi"},{"id":1790861711000,"createdDate":"2026-10-01 13:35","name":"法国国际广播电台","title":"中国国庆77周年：北京对台立场措辞更加强硬 香港特首盛赞中国制造业","content":"今天是10月1日，是中国建国77周年的国庆日。像往常一样，头天晚上（9月30日），人民大会堂会举办国庆招待会，然后中国国家主席习近平发表长篇致辞讲话。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261001-%E4%B8%AD%E5%9B%BD%E5%9B%BD%E5%BA%8677%E5%91%A8%E5%B9%B4-%E5%8C%97%E4%BA%AC%E5%AF%B9%E5%8F%B0%E7%AB%8B%E5%9C%BA%E6%8E%AA%E8%BE%9E%E6%9B%B4%E5%8A%A0%E5%BC%BA%E7%A1%AC-%E9%A6%99%E6%B8%AF%E7%89%B9%E9%A6%96%E7%9B%9B%E8%B5%9E%E4%B8%AD%E5%9B%BD%E5%88%B6%E9%80%A0%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790861711000.webp","sourceId":"rfi"},{"id":1790860768000,"createdDate":"2026-10-01 13:19","name":"法国国际广播电台","title":"腾讯据报已与甲骨文签署数据中心租赁协议 能使用10万枚尖端AI芯片算力","content":"据英国《金融时报》报导，随着腾讯正努力在日益激烈的人工智能（AI）竞赛中追赶对手，该公司已与美国云服务提供商甲骨文签署了其迄今为止规模最大的海外租赁协议。两位知情人士透露称，腾讯于今年达成协议，租用甲骨文位于东南亚的多个数据中心的资源，租期为五年。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261001-%E8%85%BE%E8%AE%AF%E6%8D%AE%E6%8A%A5%E5%B7%B2%E4%B8%8E%E7%94%B2%E9%AA%A8%E6%96%87%E7%AD%BE%E7%BD%B2%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E7%A7%9F%E8%B5%81%E5%8D%8F%E8%AE%AE-%E8%83%BD%E4%BD%BF%E7%94%A810%E4%B8%87%E6%9E%9A%E5%B0%96%E7%AB%AFai%E8%8A%AF%E7%89%87%E7%AE%97%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790860768000.webp","sourceId":"rfi"},{"id":1790859530000,"createdDate":"2026-10-01 12:58","name":"法国国际广播电台","title":"社交还是统战 中国女子的布鲁塞尔社交俱乐部让情报机构警觉","content":"据法国调查媒体《LaLettre》报导称，一个面向企业首席执行官（CEO）及高管的商业俱乐部，其活动已引起西方情报机构的关注，并引发了欧洲机构高层的担忧。这位常驻布鲁塞尔的中国女子成功打入了北约网络安全承包商的小圈子，并于今夏与法国首富阿尔诺（BernardArnault）在活动上合影。自诩为非营利组织的全球CEO晚宴俱乐部（GlobalCEOsDinnerClub）在布鲁塞尔举办名流活动，汇聚了商界领袖与政界人士，目前正寻求向法国拓展。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261001-%E7%A4%BE%E4%BA%A4%E8%BF%98%E6%98%AF%E7%BB%9F%E6%88%98-%E4%B8%AD%E5%9B%BD%E5%A5%B3%E5%AD%90%E7%9A%84%E5%B8%83%E9%B2%81%E5%A1%9E%E5%B0%94%E7%A4%BE%E4%BA%A4%E4%BF%B1%E4%B9%90%E9%83%A8%E8%AE%A9%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E8%AD%A6%E8%A7%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790859530000.webp","sourceId":"rfi"},{"id":1790856223000,"createdDate":"2026-10-01 12:03","name":"法国国际广播电台","title":"习近平国庆涉台讲话：“坚决打击”台独势力","content":"大家好，欢迎收听法国报纸摘要。周四10月1日出刊的法国各大主流日报头版和经济版无不聚焦于法国政府即将公布的2027年预算，据《费加罗报》报道，政府今天将提交两份预算案，以及寻求避免受到谴责的方法。尽管社会党（PS）公开表示敌对，但国民联盟（RN）可能会采取更为和解的态度。与此同时《费加罗报》国际版关注了中国国家主席习近平在国庆讲话中表示：中国“坚决打击”台独势力！","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261001-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%9B%BD%E5%BA%86%E6%B6%89%E5%8F%B0%E8%AE%B2%E8%AF%9D-%E5%9D%9A%E5%86%B3%E6%89%93%E5%87%BB-%E5%8F%B0%E7%8B%AC%E5%8A%BF%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790856223000.webp","sourceId":"rfi"},{"id":1790855964000,"createdDate":"2026-10-01 11:59","name":"法国国际广播电台","title":"美国参议员拟11月推动立法 永久限制中国汽车进入美国市场","content":"据美国国会的消息人士透露，两名支持永久限制中国汽车进入美国市场法案的参议员计划在11月参议院休会结束后，再次寻求推动法案获得批准。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261001-%E7%BE%8E%E5%9B%BD%E5%8F%82%E8%AE%AE%E5%91%98%E6%8B%9F11%E6%9C%88%E6%8E%A8%E5%8A%A8%E7%AB%8B%E6%B3%95-%E6%B0%B8%E4%B9%85%E9%99%90%E5%88%B6%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E8%BF%9B%E5%85%A5%E7%BE%8E%E5%9B%BD%E5%B8%82%E5%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790855964000.webp","sourceId":"rfi"},{"id":1790853676000,"createdDate":"2026-10-01 11:21","name":"法国国际广播电台","title":"美国据报放缓对华出口飞机零部件 以寻求增强贸易谈判筹码","content":"据路透社援引知情人士报导，特朗普政府正采取措施，试图将中国对美国航空供应商的依赖转化为贸易谈判中的筹码。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261001-%E7%BE%8E%E5%9B%BD%E6%8D%AE%E6%8A%A5%E6%94%BE%E7%BC%93%E5%AF%B9%E5%8D%8E%E5%87%BA%E5%8F%A3%E9%A3%9E%E6%9C%BA%E9%9B%B6%E9%83%A8%E4%BB%B6-%E4%BB%A5%E5%AF%BB%E6%B1%82%E5%A2%9E%E5%BC%BA%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E7%AD%B9%E7%A0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790853676000.webp","sourceId":"rfi"},{"id":1790853248000,"createdDate":"2026-10-01 11:14","name":"法国国际广播电台","title":"中美暂告休战  亚太安全依旧严峻","content":"2026年9月下旬中美元首峰会后，全球政治与安全格局进入了一个微妙的调整时期。世界两大经济体之间的冲突暂告缓和，这为亚太地区国家带来了短暂的喘息机会。然而，北朝鲜核导能力的持续飙升依然是东北亚最严峻的现实威胁，日本则持续强化其防务政策与威慑能力。在此背景下，以泰国为代表的东盟国家正积极推动外交政策朝着“战略自主”（StrategicAutonomy）方向落实，摒弃明显的选边站队立场，采用灵活的多边外交应对错综复杂的安全局势。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261001-%E4%B8%AD%E7%BE%8E%E6%9A%82%E5%91%8A%E4%BC%91%E6%88%98-%E4%BA%9A%E5%A4%AA%E5%AE%89%E5%85%A8%E4%BE%9D%E6%97%A7%E4%B8%A5%E5%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790853248000.webp","sourceId":"rfi"},{"id":1790848796000,"createdDate":"2026-10-01 09:59","name":"法国国际广播电台","title":"美官员据报认为中方在2028年前入侵台湾可能性越来越小","content":"据路透社援引熟悉美方想法的人士报导称，尽管中国国家主席习近平曾指示解放军“在2027年前做好成功入侵台湾的准备”，但美国官员认为，中国在2028年前入侵台湾的可能性越来越小。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261001-%E7%BE%8E%E5%AE%98%E5%91%98%E6%8D%AE%E6%8A%A5%E8%AE%A4%E4%B8%BA%E4%B8%AD%E6%96%B9%E5%9C%A82028%E5%B9%B4%E5%89%8D%E5%85%A5%E4%BE%B5%E5%8F%B0%E6%B9%BE%E5%8F%AF%E8%83%BD%E6%80%A7%E8%B6%8A%E6%9D%A5%E8%B6%8A%E5%B0%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790848796000.webp","sourceId":"rfi"},{"id":1790844111000,"createdDate":"2026-10-01 08:41","name":"法国国际广播电台","title":"是否与习近平谈及黎智英等政治犯案 特朗普：确实谈了，望讨论富有成效","content":"美国总统特朗普（DonaldTrump）周三向媒体表示，他在上周与中国国家主席习近平会晤时，曾讨论过释放在华被押政治犯的问题。","newsLink":"https://www.rfi.fr/cn/%E4%BA%BA%E6%9D%83/20261001-%E6%98%AF%E5%90%A6%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%B0%88%E5%8F%8A%E9%BB%8E%E6%99%BA%E8%8B%B1%E7%AD%89%E6%94%BF%E6%B2%BB%E7%8A%AF%E6%A1%88-%E7%89%B9%E6%9C%97%E6%99%AE-%E7%A1%AE%E5%AE%9E%E8%B0%88%E4%BA%86%EF%BC%8C%E6%9C%9B%E8%AE%A8%E8%AE%BA%E8%83%BD%E5%AF%8C%E6%9C%89%E6%88%90%E6%95%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790844111000.webp","sourceId":"rfi"},{"id":1790842942000,"createdDate":"2026-10-01 08:22","name":"法国国际广播电台","title":"AI热潮助推韩国9月出口创历史新高，芯片出口激增262%","content":"韩国周四（10月1日）公布的数据显示，韩国9月出口额达到约1070亿欧元，同比大幅增长83.5%。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261001-ai%E7%83%AD%E6%BD%AE%E5%8A%A9%E6%8E%A8%E9%9F%A9%E5%9B%BD9%E6%9C%88%E5%87%BA%E5%8F%A3%E5%88%9B%E5%8E%86%E5%8F%B2%E6%96%B0%E9%AB%98%EF%BC%8C%E8%8A%AF%E7%89%87%E5%87%BA%E5%8F%A3%E6%BF%80%E5%A2%9E262","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790842942000.webp","sourceId":"rfi"},{"id":1790842072000,"createdDate":"2026-10-01 08:07","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第10：索福克勒斯：哲人剧作家","content":"希腊三大悲剧作家中被人讨论最多的是索福克勒斯，因为他的剧作总引出一些具有哲学意味的话题。他笔下最著名的戏剧人物俄狄浦斯已经成为心理学的一个案例，直接帮助精神分析学诊断心理疾病。我们可以说他笔下的每一个人都能促使人们深思带有普遍意义的命题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261001-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC10%E7%B4%A2%E7%A6%8F%E5%85%8B%E5%8B%92%E6%96%AF-%E5%93%B2%E4%BA%BA%E5%89%A7%E4%BD%9C%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790842072000.webp","sourceId":"rfi"},{"id":1790841451000,"createdDate":"2026-10-01 07:57","name":"法国国际广播电台","title":"闯入驻日中国大使馆原自卫官初审在东京举行 被问胁迫罪等","content":"今年3月持菜刀闯入东京港区中国驻日大使馆的前自卫官，被控犯有建筑物侵入和胁迫罪等罪名的村田晃大的首次公审，10月1日在东京地方法院举行。村田被告承认闯入大使馆等事实，但对于胁迫罪则表示“交由律师处理”。辩护方主张“不构成胁迫罪”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261001-%E9%97%AF%E5%85%A5%E9%A9%BB%E6%97%A5%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF%E9%A6%86%E5%8E%9F%E8%87%AA%E5%8D%AB%E5%AE%98%E5%88%9D%E5%AE%A1%E5%9C%A8%E4%B8%9C%E4%BA%AC%E4%B8%BE%E8%A1%8C-%E8%A2%AB%E9%97%AE%E8%83%81%E8%BF%AB%E7%BD%AA%E7%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790841451000.webp","sourceId":"rfi"},{"id":1790840785000,"createdDate":"2026-10-01 07:46","name":"法国国际广播电台","title":"香港上天下海庆国庆 惟港人北上仍较陆客来港多","content":"今天是中国77周年国庆日，国家主席习近平在国庆前夕的庆祝晚会上重申，支持香港和澳门更好融入和服务国家发展大局，保持长期繁荣稳定。在香港，特首李家超今早在国庆酒会上致辞时亦解释，刻下制定香港首份五年规划，是要主动融入和服务国家发展大局，令香港发展得更好；而港府和不同机构亦推出不同优惠，以吸引港人留港消费及庆祝，参与机构和人士可以说是上天下海，无所不包，而最特别的，是香港首个载荷专家黎家盈从太空送回祝愿。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261001-%E9%A6%99%E6%B8%AF%E4%B8%8A%E5%A4%A9%E4%B8%8B%E6%B5%B7%E5%BA%86%E5%9B%BD%E5%BA%86-%E6%83%9F%E6%B8%AF%E4%BA%BA%E5%8C%97%E4%B8%8A%E4%BB%8D%E8%BE%83%E9%99%86%E5%AE%A2%E6%9D%A5%E6%B8%AF%E5%A4%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790840785000.webp","sourceId":"rfi"},{"id":1790840321000,"createdDate":"2026-10-01 07:38","name":"法国国际广播电台","title":"抗争悼念活动被指煽动 港警拘8人 抓网媒遭新闻组织谴责","content":"在中国国庆前夕，香港政府化警方公布，在三轮行动中，共拘捕八人，指他们在「831」事件七周年时，在港铁太子站外持花站立和喊口号，散播假消息，意图抹黑警队，属於煽动。警方没有具体交待被捕人士身份，但其中一人是在现场直播悼念活动的网媒「爆炸头」。无国界记者发声明谴责，指港府在将新闻工作刑事化，促放人；而香港记者协会则指警方若因该网媒的记者工作而把他拘捕，将令所有前线记者日後采访公众活动时面对同样风险。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261001-%E6%8A%97%E4%BA%89%E6%82%BC%E5%BF%B5%E6%B4%BB%E5%8A%A8%E8%A2%AB%E6%8C%87%E7%85%BD%E5%8A%A8-%E6%B8%AF%E8%AD%A6%E6%8B%988%E4%BA%BA-%E6%8A%93%E7%BD%91%E5%AA%92%E9%81%AD%E6%96%B0%E9%97%BB%E7%BB%84%E7%BB%87%E8%B0%B4%E8%B4%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790840321000.webp","sourceId":"rfi"},{"id":1790839204000,"createdDate":"2026-10-01 07:20","name":"法国国际广播电台","title":"前总统陈水扁狱中书《台湾的十字架》新书会将近 担忧是否遭下令抓回看守所","content":"陈水扁预计20日举行狱中新书《台湾的十字架》发表会，但有舰先前被禁播案例，他担心发表会能否顺利举办，不知道府院高层会不会下令矫正单位到新书发表会场，把他带回看守所。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261001-%E5%89%8D%E6%80%BB%E7%BB%9F%E9%99%88%E6%B0%B4%E6%89%81%E7%8B%B1%E4%B8%AD%E4%B9%A6-%E5%8F%B0%E6%B9%BE%E7%9A%84%E5%8D%81%E5%AD%97%E6%9E%B6-%E6%96%B0%E4%B9%A6%E4%BC%9A%E5%B0%86%E8%BF%91-%E6%8B%85%E5%BF%A7%E6%98%AF%E5%90%A6%E9%81%AD%E4%B8%8B%E4%BB%A4%E6%8A%93%E5%9B%9E%E7%9C%8B%E5%AE%88%E6%89%80","thumbnail":"","detailImage":"news/detail/rfi/2026/10/01/1790839204000.webp","sourceId":"rfi"}]