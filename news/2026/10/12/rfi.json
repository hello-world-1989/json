[{"id":1791827774000,"createdDate":"2026-10-12 17:56","name":"法国国际广播电台","title":"巴黎车展：比亚迪表示法国已进入该公司工厂选址“候选名单”","content":"法新社消息：中国汽车制造商比亚迪（BYD）执行副总裁李柯周一在巴黎车展开幕式上表示，法国已被列入该公司计划建设新工厂的国家候选名单。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E5%B7%B4%E9%BB%8E%E8%BD%A6%E5%B1%95-%E6%AF%94%E4%BA%9A%E8%BF%AA%E8%A1%A8%E7%A4%BA%E6%B3%95%E5%9B%BD%E5%B7%B2%E8%BF%9B%E5%85%A5%E8%AF%A5%E5%85%AC%E5%8F%B8%E5%B7%A5%E5%8E%82%E9%80%89%E5%9D%80-%E5%80%99%E9%80%89%E5%90%8D%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791827774000.webp","sourceId":"rfi"},{"id":1791825447000,"createdDate":"2026-10-12 17:17","name":"法国国际广播电台","title":"欧盟批准对涉俄乌战争1600人和实体实施新制裁 主要打击弹道导弹生产链","content":"欧盟外交与安全政策高级代表卡拉斯（KajaKallas）宣布，欧盟周一通过了针对近1600个实体和个人的新制裁措施，这些实体和个人均与俄罗斯对乌克兰发动的战争有关。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261012-%E6%AC%A7%E7%9B%9F%E6%89%B9%E5%87%86%E5%AF%B9%E6%B6%89%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%891600%E4%BA%BA%E5%92%8C%E5%AE%9E%E4%BD%93%E5%AE%9E%E6%96%BD%E6%96%B0%E5%88%B6%E8%A3%81-%E4%B8%BB%E8%A6%81%E6%89%93%E5%87%BB%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9%E7%94%9F%E4%BA%A7%E9%93%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791825447000.webp","sourceId":"rfi"},{"id":1791824353000,"createdDate":"2026-10-12 16:59","name":"法国国际广播电台","title":"波兰总理呼吁西方更强硬：“乌克兰为生存而战，俄罗斯为霸权而战”","content":"波兰总理图斯克周一呼吁“整个西方”对弗拉基米尔·普京领导的俄罗斯采取更强硬的立场。他称该国正“为争夺霸权而战”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E6%B3%A2%E5%85%B0%E6%80%BB%E7%90%86%E5%91%BC%E5%90%81%E8%A5%BF%E6%96%B9%E6%9B%B4%E5%BC%BA%E7%A1%AC-%E4%B9%8C%E5%85%8B%E5%85%B0%E4%B8%BA%E7%94%9F%E5%AD%98%E8%80%8C%E6%88%98%EF%BC%8C%E4%BF%84%E7%BD%97%E6%96%AF%E4%B8%BA%E9%9C%B8%E6%9D%83%E8%80%8C%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791824353000.webp","sourceId":"rfi"},{"id":1791821095000,"createdDate":"2026-10-12 16:04","name":"法国国际广播电台","title":"俄罗斯疑似鼠疫死亡案例 中国内蒙呼伦贝尔市发布风险提示","content":"中央社11日消息，俄罗斯西伯利亚近日传出一名实验室研究员疑似因鼠疫而死亡的消息，引起国际关注，毗邻俄罗斯远东地区的中国内蒙呼伦贝尔市疾控中心为此发出鼠疫防控风险提示。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261012-%E4%BF%84%E7%BD%97%E6%96%AF%E7%96%91%E4%BC%BC%E9%BC%A0%E7%96%AB%E6%AD%BB%E4%BA%A1%E6%A1%88%E4%BE%8B-%E4%B8%AD%E5%9B%BD%E5%86%85%E8%92%99%E5%91%BC%E4%BC%A6%E8%B4%9D%E5%B0%94%E5%B8%82%E5%8F%91%E5%B8%83%E9%A3%8E%E9%99%A9%E6%8F%90%E7%A4%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791821095000.webp","sourceId":"rfi"},{"id":1791819442000,"createdDate":"2026-10-12 15:37","name":"法国国际广播电台","title":"特朗普宣布俄乌“能源停火” 欧盟英法德加澳都表态支持","content":"美国总统特朗普周日出人意料宣布乌克兰与俄罗斯达成“能源停火”协议，基辅对此感到惊讶，莫斯科保持沉默。但欧盟和伦敦、巴黎、柏林、渥太华及堪培拉都表示支持俄乌“能源停火”。法国总统马克龙补充说，“寻求停火并重启和平谈判有必要”，但绝不能向俄罗斯的威胁屈服”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AE%A3%E5%B8%83%E4%BF%84%E4%B9%8C-%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB-%E6%AC%A7%E7%9B%9F%E8%8B%B1%E6%B3%95%E5%BE%B7%E5%8A%A0%E6%BE%B3%E9%83%BD%E8%A1%A8%E6%80%81%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791819442000.webp","sourceId":"rfi"},{"id":1791818958000,"createdDate":"2026-10-12 15:29","name":"法国国际广播电台","title":"中国宣布对巴拉圭和伯利兹两位亲台湾部长实施制裁","content":"中国周一宣布对巴拉圭和伯利兹的各一名部长实施制裁，理由是他们支持与台湾保持外交关系；北京方面称此举是对任何采取类似行动者的“警告”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E4%B8%AD%E5%9B%BD%E5%AE%A3%E5%B8%83%E5%AF%B9%E5%B7%B4%E6%8B%89%E5%9C%AD%E5%92%8C%E4%BC%AF%E5%88%A9%E5%85%B9%E4%B8%A4%E4%BD%8D%E4%BA%B2%E5%8F%B0%E6%B9%BE%E9%83%A8%E9%95%BF%E5%AE%9E%E6%96%BD%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791818958000.webp","sourceId":"rfi"},{"id":1791818828000,"createdDate":"2026-10-12 15:27","name":"法国国际广播电台","title":"《面对中国，西方的失败》作者董尼德 ：傲慢与蔑视导致西方失败","content":"《当中国觉醒……世界将颤抖》1973年出版的法国作家兼政治家阿兰·佩雷菲特（AlainPeyrefitte）的著作，在这个题目后，是佩雷菲特1971年，以国民议会文化和社会事务委员会主席的身份率领议会代表团访问中国期间，撰写的关于当时正处于文化大革命时期的中国状况的报告。主要论点是，鉴于中国人口的规模和增长速度，一旦中国掌握了足够的技术，就必然会主宰世界。2026年，中国已在电动汽车、光伏和电池等战略领域占据主导地位，并在人工智能、太空探索、量子物理和核聚变等领域投入巨资。当欧洲和美国仍在努力理解这场变革的规模时，中国正崛起为21世纪举足轻重的角色。但西方国家今天对中国究竟了解多少？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%9B%BD%E9%99%85%E7%BA%B5%E6%A8%AA/20261012-%E9%9D%A2%E5%AF%B9%E4%B8%AD%E5%9B%BD%EF%BC%8C%E8%A5%BF%E6%96%B9%E7%9A%84%E5%A4%B1%E8%B4%A5-%E4%BD%9C%E8%80%85%E8%91%A3%E5%B0%BC%E5%BE%B7-%E5%82%B2%E6%85%A2%E4%B8%8E%E8%94%91%E8%A7%86%E5%AF%BC%E8%87%B4%E8%A5%BF%E6%96%B9%E5%A4%B1%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791818828000.webp","sourceId":"rfi"},{"id":1791818616000,"createdDate":"2026-10-12 15:23","name":"法国国际广播电台","title":"王国臣：中欧贸易失衡 只靠谈判恐难解决","content":"欧中贸易关系正经历关键时期，欧盟贸易与经济安全专员谢夫乔维奇本周在北京与中国商务王文涛举行两天密集磋商，据会后联合声明，双方就混合动力汽车贸易达成谅解，此次磋商被称为“务实富有成效“，双方就贸易投资、出口管制、知识产权和世贸组织改革等领域形成16项成果共识。这些进展能否真正缓解中欧巨大的贸易失衡？推动未来谈判取得实质性成果以避免贸易战的发生？在欧中北京谈判之际，我们电话采访了专攻中国经济及国际政治经济学者、台湾中华经济研究院中国经济研究所副研究员王国臣先生。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E6%AC%A7%E6%B4%B2/20261012-%E7%8E%8B%E5%9B%BD%E8%87%A3-%E4%B8%AD%E6%AC%A7%E8%B4%B8%E6%98%93%E5%A4%B1%E8%A1%A1-%E5%8F%AA%E9%9D%A0%E8%B0%88%E5%88%A4%E6%81%90%E9%9A%BE%E8%A7%A3%E5%86%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791818616000.webp","sourceId":"rfi"},{"id":1791816898000,"createdDate":"2026-10-12 14:54","name":"法国国际广播电台","title":"俄乌“能源停火\"? 基辅指俄罗斯继续打击其能源设施 欧盟批准涉俄新制裁","content":"美国总统特朗普周日（10月12日）出人意外宣布乌克兰与俄罗斯已达成“能源停火”协议，引发不同反应。基辅感到惊讶，莫斯科则在最初沉默后，周一表示仍在与美方磋商，拒绝说明是否停火。英国、法国、加拿大、及欧盟等方面在表示支持美国总统的“呼吁”同时，对俄罗斯能否能否遵守任何对乌克兰的协议表示怀疑。泽连斯基周一表示，俄罗斯仍在继续打击乌克兰的能源基础设施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261012-%E4%BF%84%E4%B9%8C-%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB-%E5%9F%BA%E8%BE%85%E6%8C%87%E4%BF%84%E7%BD%97%E6%96%AF%E7%BB%A7%E7%BB%AD%E6%89%93%E5%87%BB%E5%85%B6%E8%83%BD%E6%BA%90%E8%AE%BE%E6%96%BD-%E6%AC%A7%E7%9B%9F%E6%89%B9%E5%87%86%E6%B6%89%E4%BF%84%E6%96%B0%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791816898000.webp","sourceId":"rfi"},{"id":1791814957000,"createdDate":"2026-10-12 14:22","name":"法国国际广播电台","title":"安琪巴黎「自由谈」沙龙纪要与述评：诗歌何为？在场者何为――第三代诗人宋琳谈「诗人的态度」","content":"2026年6月30日，巴黎「自由谈」沙龙荣幸邀请中国第三代诗歌的代表诗人、1980年代城市诗的主要参与者宋琳先生莅临沙龙，作题为「诗人的态度」的演讲。有学人学者、影视人士、策展人、艺术家、媒体人士等多位嘉宾出席，并即兴朗诵了宋琳的诗歌数首，气氛温馨热烈。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261012-%E5%AE%89%E7%90%AA%E5%B7%B4%E9%BB%8E-%E8%87%AA%E7%94%B1%E8%B0%88-%E6%B2%99%E9%BE%99%E7%BA%AA%E8%A6%81%E4%B8%8E%E8%BF%B0%E8%AF%84-%E8%AF%97%E6%AD%8C%E4%BD%95%E4%B8%BA-%E5%9C%A8%E5%9C%BA%E8%80%85%E4%BD%95%E4%B8%BA%E2%80%95%E2%80%95%E7%AC%AC%E4%B8%89%E4%BB%A3%E8%AF%97%E4%BA%BA%E5%AE%8B%E7%90%B3%E8%B0%88-%E8%AF%97%E4%BA%BA%E7%9A%84%E6%80%81%E5%BA%A6","thumbnail":"","detailImage":"","sourceId":"rfi"},{"id":1791814735000,"createdDate":"2026-10-12 14:18","name":"法国国际广播电台","title":"台湾“密切关注”中国新一轮实弹演习","content":"台湾国防部长顾立雄（WellingtonKoo）表示，将“密切关注”中国定于周一启动、为期一周以上的军事演习，尤其是在台湾近海区域的演习。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261012-%E5%8F%B0%E6%B9%BE-%E5%AF%86%E5%88%87%E5%85%B3%E6%B3%A8-%E4%B8%AD%E5%9B%BD%E6%96%B0%E4%B8%80%E8%BD%AE%E5%AE%9E%E5%BC%B9%E6%BC%94%E4%B9%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791814735000.webp","sourceId":"rfi"},{"id":1791813885000,"createdDate":"2026-10-12 14:04","name":"法国国际广播电台","title":"巴黎国际车展突出电气化、欧洲优先和创新","content":"第91届巴黎国际车展于周一开幕，马克龙总统主持开幕式并推进电气化、欧洲优先和创新，旨在引领欧洲应对中国竞争。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261012-%E5%B7%B4%E9%BB%8E%E5%9B%BD%E9%99%85%E8%BD%A6%E5%B1%95%E7%AA%81%E5%87%BA%E7%94%B5%E6%B0%94%E5%8C%96-%E6%AC%A7%E6%B4%B2%E4%BC%98%E5%85%88%E5%92%8C%E5%88%9B%E6%96%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791813885000.webp","sourceId":"rfi"},{"id":1791813810000,"createdDate":"2026-10-12 14:03","name":"法国国际广播电台","title":"中国汽车在驰骋 欧洲车却熄火了","content":"10月12号周一法国各大报都关注的国内焦点议题是，周末举行的中左翼政党总统候选人初选投票后，公共广场创始人格鲁克思曼以66.17%大幅领先的优势第一轮就胜出的消息。在国际议题上，上周末美国总统特朗普震撼宣布与俄罗斯达成的柴油出口协议受到法国各报的聚焦。在中国议题上，各报也难得一致，配合周一开始在巴黎凡尔赛们展览馆开幕的国际车展，分析中国汽车给市场带来的冲击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261012-%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E5%9C%A8%E9%A9%B0%E9%AA%8B-%E6%AC%A7%E6%B4%B2%E8%BD%A6%E5%8D%B4%E7%86%84%E7%81%AB%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791813810000.webp","sourceId":"rfi"},{"id":1791813345000,"createdDate":"2026-10-12 13:55","name":"法国国际广播电台","title":"俄乌“能源停火\"? 基辅指俄罗斯继续打击其能源设施 欧盟批准涉俄新制裁","content":"美国总统特朗普周日（10月12日）出人意外宣布乌克兰与俄罗斯已达成“能源停火”，引发不同反应。基辅感到惊讶，莫斯科则在最初沉默后周一表示仍在与美方磋商，拒绝说明是否停火。英国、法国、加拿大、及欧盟等方面在表示支持美国总统的“呼吁”同时，对俄罗斯能否能否遵守任何对乌克兰的协议表示怀疑。泽连斯基周一表示，俄罗斯仍在继续打击乌克兰的能源基础设施。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E4%BF%84%E4%B9%8C-%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB-%E5%9F%BA%E8%BE%85%E6%8C%87%E4%BF%84%E7%BD%97%E6%96%AF%E7%BB%A7%E7%BB%AD%E6%89%93%E5%87%BB%E5%85%B6%E8%83%BD%E6%BA%90%E8%AE%BE%E6%96%BD-%E6%AC%A7%E7%9B%9F%E6%89%B9%E5%87%86%E6%B6%89%E4%BF%84%E6%96%B0%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791813345000.webp","sourceId":"rfi"},{"id":1791813301000,"createdDate":"2026-10-12 13:55","name":"法国国际广播电台","title":"法国数百家超市遭遇网络攻击 制冷系统遭破坏","content":"法国数百家超市从周日晚间到今天周一遭遇网络黑客攻击，导致制冷系统被破坏，部分冷冻食品无法销售。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261012-%E6%B3%95%E5%9B%BD%E6%95%B0%E7%99%BE%E5%AE%B6%E8%B6%85%E5%B8%82%E9%81%AD%E9%81%87%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB-%E5%88%B6%E5%86%B7%E7%B3%BB%E7%BB%9F%E9%81%AD%E7%A0%B4%E5%9D%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791813301000.webp","sourceId":"rfi"},{"id":1791801869000,"createdDate":"2026-10-12 10:44","name":"法国国际广播电台","title":"诺贝尔经济学奖今揭晓 美国两位学者摘得桂冠","content":"2026年诺贝尔获奖者名单宣布季最后的的高潮——诺贝尔经济学奖获奖者今天授予美国人迈克尔·伍德福德与罗伯特·霍尔，表彰他们开发了旨在实施有效稳定政策的宏观经济新模型。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E8%AF%BA%E8%B4%9D%E5%B0%94%E7%BB%8F%E6%B5%8E%E5%A5%96%E4%BB%8A%E6%8F%AD%E6%99%93-%E7%BE%8E%E5%9B%BD%E4%B8%A4%E5%AD%A6%E8%80%85%E6%91%98%E5%BE%97%E6%A1%82%E5%86%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791801869000.webp","sourceId":"rfi"},{"id":1791800129000,"createdDate":"2026-10-12 10:15","name":"法国国际广播电台","title":"专家谈厄尔尼诺方方面面及对中国的影响","content":"今年4月以来，不断有联合国气象部门的专家以及各国的气候专家发出警告，担心今年将会出现超级的厄尔尼诺。今年夏季，台湾以及中国沿海地区屡屡出现的台风，以及印尼连续多个月的巨大火灾更是将厄尔尼诺推向前台。那么厄尔尼诺现象究竟是如何形成的？它与印尼的火灾以及中国的台风之间是否存在关联？为何今年会出现超强级的厄尔尼诺？它对全世界各地的气候会产生何等影响？中国是否也会受到该现象的影响？就以上一系列问题，法广电话采访了法国国家科研中心主任、研究员李肇新先生。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261012-%E4%B8%93%E5%AE%B6%E8%B0%88%E5%8E%84%E5%B0%94%E5%B0%BC%E8%AF%BA%E6%96%B9%E6%96%B9%E9%9D%A2%E9%9D%A2%E5%8F%8A%E5%AF%B9%E4%B8%AD%E5%9B%BD%E7%9A%84%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791800129000.webp","sourceId":"rfi"},{"id":1791797158000,"createdDate":"2026-10-12 09:25","name":"法国国际广播电台","title":"国际刑事法院主席团21国发表声明反对美国制裁","content":"在国际刑事法院（ICC）被美国列为新的制裁对象后，包括日本在内的国际刑事法院缔约国大会主席团于10日发表声明，要求立即撤销制裁。声明表示：“将维护国际司法原则和司法独立，支持国际刑事法院及其工作人员。”表达了对制裁措施的反对。面对美国对国际刑事法院的制裁，日本政府虽然表示关切和支持国际刑事法院的立场，但未单独明确表示“反对”，而是试图在美方与国际刑事法院之间斡旋，寻求问题的解决方案。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261012-%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E4%B8%BB%E5%B8%AD%E5%9B%A221%E5%9B%BD%E5%8F%91%E8%A1%A8%E5%A3%B0%E6%98%8E%E5%8F%8D%E5%AF%B9%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791797158000.webp","sourceId":"rfi"},{"id":1791792975000,"createdDate":"2026-10-12 08:16","name":"法国国际广播电台","title":"朝鲜再发多枚弹道导弹  一个月来的第四次发射","content":"韩国军方表示，朝鲜周一（10月12日）向其东海岸海域发射了多枚弹道导弹，这是平壤在最近一个月内的第四次发射，此前首尔刚刚在8日成功试射了首枚自研的高超音速滑翔飞行器（HGV）。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261012-%E6%9C%9D%E9%B2%9C%E5%86%8D%E5%8F%91%E5%A4%9A%E6%9E%9A%E5%BC%B9%E9%81%93%E5%AF%BC%E5%BC%B9-%E4%B8%80%E4%B8%AA%E6%9C%88%E6%9D%A5%E7%9A%84%E7%AC%AC%E5%9B%9B%E6%AC%A1%E5%8F%91%E5%B0%84","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791792975000.webp","sourceId":"rfi"},{"id":1791792324000,"createdDate":"2026-10-12 08:05","name":"法国国际广播电台","title":"美媒：ICE机场至少扣12港人 迫签自愿离境协议","content":"美国移民和海关执法局(ICE)今年头八个月已拘留38名香港市民，近月更进一步影响合法留境及工作的港人。根据当地政治网媒报道，自6月以来，ICE在美国多个机场拘留最少12名香港人，胁迫他们签署自愿离境协议。协助相关港人获释的团体估计，当局此举可能是要在他们的合法居留身份於明年2月届满时，尽快将他们驱逐出境。而这些人当中，不少人若被遣返回港，有可能被捕。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261012-%E7%BE%8E%E5%AA%92-ice%E6%9C%BA%E5%9C%BA%E8%87%B3%E5%B0%91%E6%89%A312%E6%B8%AF%E4%BA%BA-%E8%BF%AB%E7%AD%BE%E8%87%AA%E6%84%BF%E7%A6%BB%E5%A2%83%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791792324000.webp","sourceId":"rfi"},{"id":1791791566000,"createdDate":"2026-10-12 07:52","name":"法国国际广播电台","title":"新皇岗口岸今通关 首采港深「合作查验丶一次放行」 评论忧香港褪色兼楼市下跌","content":"历时七年方完成重建丶并以中港两地「合作查验丶一次放行」方式让市民通关的皇岗口岸，今晨正式开通，市民通关时间大减。香港行政长官李家超致词时表示，通关可促进跨境流动，是大湾区互联互通的重要里程碑。但有评论指出，新口岸将会加速深港同城化，香港特色褪色之馀，楼市和消费模式亦会随着「深圳居住丶香港工作」的模式更加流行而大受冲击，促请港府研究，不要只谈机遇。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261012-%E6%96%B0%E7%9A%87%E5%B2%97%E5%8F%A3%E5%B2%B8%E4%BB%8A%E9%80%9A%E5%85%B3-%E9%A6%96%E9%87%87%E6%B8%AF%E6%B7%B1-%E5%90%88%E4%BD%9C%E6%9F%A5%E9%AA%8C%E4%B8%B6%E4%B8%80%E6%AC%A1%E6%94%BE%E8%A1%8C-%E8%AF%84%E8%AE%BA%E5%BF%A7%E9%A6%99%E6%B8%AF%E8%A4%AA%E8%89%B2%E5%85%BC%E6%A5%BC%E5%B8%82%E4%B8%8B%E8%B7%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791791566000.webp","sourceId":"rfi"},{"id":1791791048000,"createdDate":"2026-10-12 07:44","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第12：俄狄浦斯：智识与命运","content":"索福克洛斯的《俄狄浦斯王》一剧塑造了一位智识过人，但终为命运摆布的悲剧人物，其含义深厚。索福克洛斯用这个形象探讨了几个问题，其中之一是自以为聪慧，有能力破解万物之谜的人物能否掌握自己的命运。面对宇宙的奥秘，人的智识能走多远。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261012-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC12-%E4%BF%84%E7%8B%84%E6%B5%A6%E6%96%AF-%E6%99%BA%E8%AF%86%E4%B8%8E%E5%91%BD%E8%BF%90","thumbnail":"","detailImage":"news/detail/rfi/2026/10/12/1791791048000.webp","sourceId":"rfi"}]