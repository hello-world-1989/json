[{"id":1791123466000,"createdDate":"2026-10-04 14:17","name":"法国国际广播电台","title":"G20未能就强迫劳动和产能过剩达成协议 中国辩称因特朗普关税","content":"周日，中国就二十国集团（G20）未能就“产能过剩”和“强迫劳动”问题达成协议一事辩解称：这是由于成员国之间存在“意见分歧”，而美国加征的关税加剧了这种分歧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-g20%E6%9C%AA%E8%83%BD%E5%B0%B1%E5%BC%BA%E8%BF%AB%E5%8A%B3%E5%8A%A8%E5%92%8C%E4%BA%A7%E8%83%BD%E8%BF%87%E5%89%A9%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE-%E4%B8%AD%E5%9B%BD%E8%BE%A9%E7%A7%B0%E5%9B%A0%E7%89%B9%E6%9C%97%E6%99%AE%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791123466000.webp","sourceId":"rfi"},{"id":1791120220000,"createdDate":"2026-10-04 13:23","name":"法国国际广播电台","title":"胡塞武装袭击沙特首都利雅得石油设施 也门政府军轰炸胡塞在首都萨那的目标","content":"据法新社报道，也门政府军周日宣布轰炸了首都萨那的亲伊朗胡塞叛军目标；胡塞武装则宣称在前一天袭击了位于利雅得的一处沙特石油巨头阿美（Aramco）设施，现场冒起浓烟。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261004-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%A2%AD%E5%87%BB%E6%B2%99%E7%89%B9%E9%A6%96%E9%83%BD%E5%88%A9%E9%9B%85%E5%BE%97%E7%9F%B3%E6%B2%B9%E8%AE%BE%E6%96%BD-%E4%B9%9F%E9%97%A8%E6%94%BF%E5%BA%9C%E5%86%9B%E8%BD%B0%E7%82%B8%E8%83%A1%E5%A1%9E%E5%9C%A8%E9%A6%96%E9%83%BD%E8%90%A8%E9%82%A3%E7%9A%84%E7%9B%AE%E6%A0%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791120220000.webp","sourceId":"rfi"},{"id":1791119075000,"createdDate":"2026-10-04 13:04","name":"法国国际广播电台","title":"美国海军陆战队员涉嫌在冲绳抢劫并杀害女性 日本向美国提出强烈抗议","content":"日本时间3日凌晨，在那霸市一家酒店的房间内发现该市一名39岁女性遗体，4日，冲绳县警方以涉嫌抢劫杀人紧急逮捕了驻冲绳县宜野湾市美军普天间飞行场的美国海军陆战队一等兵德文·雅各布·巴拉德（20岁）。在该男子被捕后，日本外务省向美方提出强烈抗议，并要求美方配合调查、防止类似事件再次发生，日本首相高市早苗与防卫大臣小泉进次郎4日也分别对此事件表示抗议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261004-%E7%BE%8E%E5%9B%BD%E6%B5%B7%E5%86%9B%E9%99%86%E6%88%98%E9%98%9F%E5%91%98%E6%B6%89%E5%AB%8C%E5%9C%A8%E5%86%B2%E7%BB%B3%E6%8A%A2%E5%8A%AB%E5%B9%B6%E6%9D%80%E5%AE%B3%E5%A5%B3%E6%80%A7-%E6%97%A5%E6%9C%AC%E5%90%91%E7%BE%8E%E5%9B%BD%E6%8F%90%E5%87%BA%E5%BC%BA%E7%83%88%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791119075000.webp","sourceId":"rfi"},{"id":1791118848000,"createdDate":"2026-10-04 13:00","name":"法国国际广播电台","title":"伊朗外长称美伊两国冲突没有“军事解决方案”","content":"伊朗外长阿拉格奇于10月4日表示，如果美国发动军事攻击，伊朗的回应将“比以往更加强烈”，他同时强调伊朗与美国之间的冲突“既没有军事解决方案，也没有任何基于新制裁的解决方案”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261004-%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E7%A7%B0%E7%BE%8E%E4%BC%8A%E4%B8%A4%E5%9B%BD%E5%86%B2%E7%AA%81%E6%B2%A1%E6%9C%89-%E5%86%9B%E4%BA%8B%E8%A7%A3%E5%86%B3%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791118848000.webp","sourceId":"rfi"},{"id":1791118178000,"createdDate":"2026-10-04 12:49","name":"法国国际广播电台","title":"巴西大选：卢拉与前总统博索纳罗之子的左右对决","content":"巴西周日（9月4日）迎来大选首轮投票，超过1.58亿选民将通过电子投票机投下选票，选出新一任总统、各州州长以及新一届国会议员。总统之争尤其受到高度关注，在13个候选人中，民调遥遥领先的两大主要对手：现任总统、左翼领袖卢拉与右翼候选人、前总统博索纳罗之子弗拉维奥·博索纳罗支持率接近，结果充满悬念。而此次选举不仅关系巴西未来数年的政治与经济走向，也将影响特朗普支持下多国右转的拉美未来政治格局。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261004-%E5%B7%B4%E8%A5%BF%E5%A4%A7%E9%80%89-%E5%8D%A2%E6%8B%89%E4%B8%8E%E5%89%8D%E6%80%BB%E7%BB%9F%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E4%B9%8B%E5%AD%90%E7%9A%84%E5%B7%A6%E5%8F%B3%E5%AF%B9%E5%86%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791118178000.webp","sourceId":"rfi"},{"id":1791116800000,"createdDate":"2026-10-04 12:26","name":"法国国际广播电台","title":"拉脱维亚议会选举：尽管民粹和主权势力崛起，亲欧洲和乌克兰政党获胜","content":"拉脱维亚周六议会选举后，计票结果显示，这个与俄罗斯接壤的北约和欧盟成员国仍将保持向西方发展的路线，尽管人口占比35%的俄语选民比较倾向选择投票给民粹主义政党。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261004-%E6%8B%89%E8%84%B1%E7%BB%B4%E4%BA%9A%E8%AE%AE%E4%BC%9A%E9%80%89%E4%B8%BE-%E5%B0%BD%E7%AE%A1%E6%B0%91%E7%B2%B9%E5%92%8C%E4%B8%BB%E6%9D%83%E5%8A%BF%E5%8A%9B%E5%B4%9B%E8%B5%B7%EF%BC%8C%E4%BA%B2%E6%AC%A7%E6%B4%B2%E5%92%8C%E4%B9%8C%E5%85%8B%E5%85%B0%E6%94%BF%E5%85%9A%E8%8E%B7%E8%83%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791116800000.webp","sourceId":"rfi"},{"id":1791102092000,"createdDate":"2026-10-04 08:21","name":"法国国际广播电台","title":"德国总理默茨突访基辅  将宣布10亿欧元军援等系列援乌措施","content":"德国总理默茨周日（10月4日）突访基辅，展现对乌克兰的支持。访问之际，俄罗斯正加紧对乌克兰的攻击，莫斯科在前一天呼吁外国人撤离基辅。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261004-%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%90%86%E9%BB%98%E8%8C%A8%E7%AA%81%E8%AE%BF%E5%9F%BA%E8%BE%85-%E5%B0%86%E5%AE%A3%E5%B8%8310%E4%BA%BF%E6%AC%A7%E5%85%83%E5%86%9B%E6%8F%B4%E7%AD%89%E7%B3%BB%E5%88%97%E6%8F%B4%E4%B9%8C%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791102092000.webp","sourceId":"rfi"},{"id":1791138595000,"createdDate":"2026-10-04 18:29","name":"法国国际广播电台","title":"非洲:加纳国足队欧裔主教练辞职","content":"在2027年非洲国家杯（CAN2027）预选赛框架内，绰号[黑星]（BlackStar）的非洲加纳（leGhana）国家足球队于2026年09月29日星期二在本国首都阿克拉体育场（AccraSportsStadium）主场对阵甘比亚（laGambie）国家足球队败北。两天后的十月初，加纳国家足球队的葡萄牙籍主教练宣布辞职。加纳（leGhana）的中文国名也有译作[迦納]；而冈比亚的中文则也有译作甘比亚（laGambie）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261004-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%8A%A0%E7%BA%B3%E5%9B%BD%E8%B6%B3%E9%98%9F%E6%AC%A7%E8%A3%94%E4%B8%BB%E6%95%99%E7%BB%83%E8%BE%9E%E8%81%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791138595000.webp","sourceId":"rfi"},{"id":1791134554000,"createdDate":"2026-10-04 17:22","name":"法国国际广播电台","title":"印尼政府宣布两头“极濒危”物种苏门答腊犀牛将产仔","content":"印尼政府宣布，两头苏门答腊犀牛已怀孕，这对于该物种的生存来说是个好消息，苏门答腊犀牛是哺乳动物中最为稀有且濒危的物种之一。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261004-%E5%8D%B0%E5%B0%BC%E6%94%BF%E5%BA%9C%E5%AE%A3%E5%B8%83%E4%B8%A4%E5%A4%B4-%E6%9E%81%E6%BF%92%E5%8D%B1-%E7%89%A9%E7%A7%8D%E8%8B%8F%E9%97%A8%E7%AD%94%E8%85%8A%E7%8A%80%E7%89%9B%E5%B0%86%E4%BA%A7%E4%BB%94","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791134554000.webp","sourceId":"rfi"},{"id":1791130033000,"createdDate":"2026-10-04 16:07","name":"法国国际广播电台","title":"埃塞俄比亚冲突：华盛顿呼吁克制，埃及召开小型峰会","content":"美国呼吁非洲之角各方保持克制并开展对话。目前，埃塞俄比亚指责邻国厄立特里亚支持埃塞北部提格雷地区叛乱活动，而厄立特里亚、埃及、索马里领导人以及苏丹军队总司令将于周日在埃及举行会晤。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261004-%E5%9F%83%E5%A1%9E%E4%BF%84%E6%AF%94%E4%BA%9A%E5%86%B2%E7%AA%81-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%91%BC%E5%90%81%E5%85%8B%E5%88%B6%EF%BC%8C%E5%9F%83%E5%8F%8A%E5%8F%AC%E5%BC%80%E5%B0%8F%E5%9E%8B%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791130033000.webp","sourceId":"rfi"},{"id":1791124863000,"createdDate":"2026-10-04 14:41","name":"法国国际广播电台","title":"菲律宾袭击非法网络赌博窝点宣布逮捕200多名外国人“大多数是中国人”","content":"法新社10月4日马尼拉消息，菲律宾移民局周六宣布，在对非法在线博彩运营商开展的今年最大规模行动中，当局逮捕了200多名外籍员工，“其中大多数是中国人”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261004-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E8%A2%AD%E5%87%BB%E9%9D%9E%E6%B3%95%E7%BD%91%E7%BB%9C%E8%B5%8C%E5%8D%9A%E7%AA%9D%E7%82%B9-%E5%AE%A3%E5%B8%83%E9%80%AE%E6%8D%95200%E5%A4%9A%E5%90%8D%E5%A4%96%E5%9B%BD%E4%BA%BA-%E5%A4%A7%E5%A4%9A%E6%95%B0%E6%98%AF%E4%B8%AD%E5%9B%BD%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791124863000.webp","sourceId":"rfi"},{"id":1791156320000,"createdDate":"2026-10-04 23:25","name":"法国国际广播电台","title":"博索纳罗大幅领先 巴西右翼东山再起？","content":"巴西周日开启第一轮总统大选，代表左翼力量，年逾80争取第四任的现任总统卢拉，与希望让极右翼力量重新掌控国家的参议员、45岁的前总统博索纳罗之子弗拉维奥·博索纳罗展开激烈对决，根据对64%的选票统计，博索纳罗遥遥领先。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E5%A4%A7%E5%B9%85%E9%A2%86%E5%85%88-%E5%B7%B4%E8%A5%BF%E5%8F%B3%E7%BF%BC%E4%B8%9C%E5%B1%B1%E5%86%8D%E8%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791156320000.webp","sourceId":"rfi"},{"id":1791154504000,"createdDate":"2026-10-04 22:55","name":"法国国际广播电台","title":"不安全的中国机械——德国机械设备制造业联合会要求禁止进口","content":"据德国《世界报》报道：德国机械制造商要求加强对来自第三国的进口机械的市场监管，以防止不安全的机械进入欧洲市场。德国机械设备制造业联合会（VDMA）批评说，这类机械不仅会危及公平竞争，还会削弱欧洲的安全标准。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E4%B8%8D%E5%AE%89%E5%85%A8%E7%9A%84%E4%B8%AD%E5%9B%BD%E6%9C%BA%E6%A2%B0-%E5%BE%B7%E5%9B%BD%E6%9C%BA%E6%A2%B0%E8%AE%BE%E5%A4%87%E5%88%B6%E9%80%A0%E4%B8%9A%E8%81%94%E5%90%88%E4%BC%9A%E8%A6%81%E6%B1%82%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791154504000.webp","sourceId":"rfi"},{"id":1791153927000,"createdDate":"2026-10-04 22:45","name":"法国国际广播电台","title":"特朗普任命国安情报总监兼任AI沙皇　成立“超级智能部队”","content":"美国总统特朗普（DonaldTrump）周日宣布，任命国家情报总监克雷顿（JayClayton）兼任白宫人工智能（AI）沙皇，并成立“超级智能部队”（SuperIntelligenceForce，SIF），负责统筹联邦政府对人工智能的政策及监督工作。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BB%BB%E5%91%BD%E5%9B%BD%E5%AE%89%E6%83%85%E6%8A%A5%E6%80%BB%E7%9B%91%E5%85%BC%E4%BB%BBai%E6%B2%99%E7%9A%87-%E6%88%90%E7%AB%8B-%E8%B6%85%E7%BA%A7%E6%99%BA%E8%83%BD%E9%83%A8%E9%98%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791153927000.webp","sourceId":"rfi"},{"id":1791153564000,"createdDate":"2026-10-04 22:39","name":"法国国际广播电台","title":"男乒世界第一易主非中国选手登顶 中国国足0比5惨败巴勒斯坦官媒震惊","content":"法国『队报』报道，国际乒联新一期世界排名周一更新，19岁的日本新星松岛辉空跃升第一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E7%94%B7%E4%B9%92%E4%B8%96%E7%95%8C%E7%AC%AC%E4%B8%80%E6%98%93%E4%B8%BB%E9%9D%9E%E4%B8%AD%E5%9B%BD%E9%80%89%E6%89%8B%E7%99%BB%E9%A1%B6-%E4%B8%AD%E5%9B%BD%E5%9B%BD%E8%B6%B30%E6%AF%945%E6%83%A8%E8%B4%A5%E5%B7%B4%E5%8B%92%E6%96%AF%E5%9D%A6%E5%AE%98%E5%AA%92%E9%9C%87%E6%83%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791153564000.webp","sourceId":"rfi"},{"id":1791149941000,"createdDate":"2026-10-04 21:39","name":"法国国际广播电台","title":"菲律宾指责中国海警阻挠南海执法 称军机近距离接近巡逻机","content":"菲律宾海岸警卫队周日(10月4日）表示，中国船只在南海由菲律宾控制的中业岛附近，阻挠菲方对一艘涉嫌使用炸药捕鱼的外国渔船开展执法行动。菲律宾军方并称，一架中国歼-16战斗机在存在主权争议的黄岩岛上空，多次近距离接近一架菲律宾巡逻机，造成航空安全风险。这是马尼拉与北京近期一系列海上对峙中的最新一起事件。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E8%8F%B2%E5%BE%8B%E5%AE%BE%E6%8C%87%E8%B4%A3%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E9%98%BB%E6%8C%A0%E5%8D%97%E6%B5%B7%E6%89%A7%E6%B3%95-%E7%A7%B0%E5%86%9B%E6%9C%BA%E8%BF%91%E8%B7%9D%E7%A6%BB%E6%8E%A5%E8%BF%91%E5%B7%A1%E9%80%BB%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791149941000.webp","sourceId":"rfi"},{"id":1791149775000,"createdDate":"2026-10-04 21:36","name":"法国国际广播电台","title":"默茨访乌承诺逾13亿欧元援助 美国10月底与俄乌代表举行三方会谈","content":"德国总理默茨周日（10月4日）抵达基辅，表达对乌克兰的支持，并承诺提供超过13亿欧元的新一轮援助。同一天，基辅一座桥梁再遭俄罗斯袭击。泽连斯基宣布，美国计划于10月底与俄罗斯和乌克兰代表举行三方会谈。印度外交部长苏杰生表示，印度寻求在俄乌之间发挥更大的斡旋作用，推动结束战争。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E9%BB%98%E8%8C%A8%E8%AE%BF%E4%B9%8C%E6%89%BF%E8%AF%BA%E9%80%BE13%E4%BA%BF%E6%AC%A7%E5%85%83%E6%8F%B4%E5%8A%A9-%E7%BE%8E%E5%9B%BD10%E6%9C%88%E5%BA%95%E4%B8%8E%E4%BF%84%E4%B9%8C%E4%BB%A3%E8%A1%A8%E4%B8%BE%E8%A1%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791149775000.webp","sourceId":"rfi"},{"id":1791149583000,"createdDate":"2026-10-04 21:33","name":"法国国际广播电台","title":"法国高中生抗议浪潮持续 总理要求安全条件允许的学校周一复课","content":"法国高中生持续一周的封锁校园抗议引发多起暴力事件，数百所高中被迫停课。法国总理勒科尔尼周日（10月4日）晚要求，所有具备安全条件的学校周一恢复上课，并公布回应部分学生诉求的时间表。学生计划于周二发起新一轮抗议，使部分政界人士担忧。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E6%8A%97%E8%AE%AE%E6%B5%AA%E6%BD%AE%E6%8C%81%E7%BB%AD-%E6%80%BB%E7%90%86%E8%A6%81%E6%B1%82%E5%AE%89%E5%85%A8%E6%9D%A1%E4%BB%B6%E5%85%81%E8%AE%B8%E7%9A%84%E5%AD%A6%E6%A0%A1%E5%91%A8%E4%B8%80%E5%A4%8D%E8%AF%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791149583000.webp","sourceId":"rfi"},{"id":1791149321000,"createdDate":"2026-10-04 21:28","name":"法国国际广播电台","title":"波黑大选：亲俄领导人多迪克宣布其政党在塞族共和国获胜","content":"波黑塞族共和国前领导人、亲俄政治人物米洛拉德·多迪克周日（10月4日）宣布，其政党在当天举行的大选中保住了在塞族共和国的执政权。选举当局正陆续公布初步结果。距投票站关闭四小时前初步统计，投票率为27%，较2022年上次大选下降8%。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E6%B3%A2%E9%BB%91%E5%A4%A7%E9%80%89-%E4%BA%B2%E4%BF%84%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%A4%9A%E8%BF%AA%E5%85%8B%E5%AE%A3%E5%B8%83%E5%85%B6%E6%94%BF%E5%85%9A%E5%9C%A8%E5%A1%9E%E6%97%8F%E5%85%B1%E5%92%8C%E5%9B%BD%E8%8E%B7%E8%83%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791149321000.webp","sourceId":"rfi"},{"id":1791149088000,"createdDate":"2026-10-04 21:24","name":"法国国际广播电台","title":"巴西总统大选首轮投票结束：卢拉与博索纳罗之子激烈角逐 选民屏息等待结果","content":"巴西总统选举首轮投票周日（10月4日）结束，选民正屏息焦急等待选举结果。左翼现任总统卢拉与保守派对手弗拉维奥·博索纳罗展开激烈角逐，在拉美经历一股右转浪潮之际，特朗普称“密切关注选举”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261004-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89%E9%A6%96%E8%BD%AE%E6%8A%95%E7%A5%A8%E7%BB%93%E6%9D%9F-%E5%8D%A2%E6%8B%89%E4%B8%8E%E5%8D%9A%E7%B4%A2%E7%BA%B3%E7%BD%97%E4%B9%8B%E5%AD%90%E6%BF%80%E7%83%88%E8%A7%92%E9%80%90-%E9%80%89%E6%B0%91%E5%B1%8F%E6%81%AF%E7%AD%89%E5%BE%85%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791149088000.webp","sourceId":"rfi"},{"id":1791147103000,"createdDate":"2026-10-04 20:51","name":"法国国际广播电台","title":"法国外长赴非洲探访埃博拉疫区","content":"法国外交部长让-诺埃尔·巴罗（Jean-NoëlBarrot）于2026年10月04日星期日结束了对非洲国家刚果民主共和国（RDCongo）为期两天的访问。本台法广非洲组（RFIAfrique）特派记者（envoyéespéciale）在过去几天对法国外长此次访问进行了跟踪报道。巴罗外长于10月02日星期五抵达金沙萨。10月03日星期六，他亲赴本轮埃博拉(Ebola)疫情震中——刚果（金）东部伊图里省（Ituri）省会布尼亚（Bunia），实地了解疫情及当地应对情况。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261004-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E6%B3%95%E5%9B%BD%E5%A4%96%E9%95%BF%E8%B5%B4%E9%9D%9E%E6%B4%B2%E6%8E%A2%E8%AE%BF%E5%9F%83%E5%8D%9A%E6%8B%89%E7%96%AB%E5%8C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/04/1791147103000.webp","sourceId":"rfi"}]