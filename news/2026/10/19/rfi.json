[{"id":1792421984000,"createdDate":"2026-10-19 14:59","name":"法国国际广播电台","title":"美国土安全部下达DeepSeek产品联邦民事机构禁购及移除令","content":"根据在《联邦公报》上周一可看到的一份指令公告显示，美国国土安全部长已签发一项指令：(1)在联邦民事机构的采购中，排除由杭州深度求索人工智能有限公司（简称DeepSeek）——包括适用法规所界定的关联实体——所开发的信息技术产品与服务；(2)从民事机构的信息技术系统中，移除所有DeepSeek及其关联实体的产品，以及使用DeepSeek（技术）实现所开发的第三方产品与服务。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261019-%E7%BE%8E%E5%9B%BD%E5%9C%9F%E5%AE%89%E5%85%A8%E9%83%A8%E4%B8%8B%E8%BE%BEdeepseek%E4%BA%A7%E5%93%81%E8%81%94%E9%82%A6%E6%B0%91%E4%BA%8B%E6%9C%BA%E6%9E%84%E7%A6%81%E8%B4%AD%E5%8F%8A%E7%A7%BB%E9%99%A4%E4%BB%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792421984000.webp","sourceId":"rfi"},{"id":1792421190000,"createdDate":"2026-10-19 14:46","name":"法国国际广播电台","title":"法媒热议周末民间抗议活动中暴力事件：责任在谁？","content":"10月17日法国全国各地的大规模示威抗议活动以及其中暴力事件占据19日出版的法国全国性大报大版篇幅。各报在国际版关注的话题主要有：美国立场出现动摇对乌克兰战争的影响、以色列大选以及加沙走廊局势、联合国生物多样性峰会、加拿大艾伯塔省的独立倾向等等。关于中国，《费加罗报》刊登文章，介绍中国国安部的反间谍宣传。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261019-%E6%B3%95%E5%AA%92%E7%83%AD%E8%AF%84%E5%91%A8%E6%9C%AB%E6%B0%91%E9%97%B4%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8%E4%B8%AD%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6-%E8%B4%A3%E4%BB%BB%E5%9C%A8%E8%B0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792421190000.webp","sourceId":"rfi"},{"id":1792419669000,"createdDate":"2026-10-19 14:21","name":"法国国际广播电台","title":"中国对盾构机实施出口管制 印媒担忧基建隧道项目受影响","content":"中国商务部周一接连发布了四份公告，涉及公布优化调整无人机相关物项出口管制措施的决定；公布对盾构机等物项实施出口管制的决定；公布优化调整挖泥船相关物项出口管制措施的决定，以及进一步优化两用物项出口管制质疑和鉴别工作有关事项。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261019-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E7%9B%BE%E6%9E%84%E6%9C%BA%E5%AE%9E%E6%96%BD%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6-%E5%8D%B0%E5%AA%92%E6%8B%85%E5%BF%A7%E5%9F%BA%E5%BB%BA%E9%9A%A7%E9%81%93%E9%A1%B9%E7%9B%AE%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792419669000.webp","sourceId":"rfi"},{"id":1792418055000,"createdDate":"2026-10-19 13:54","name":"法国国际广播电台","title":"中企退出斯里兰卡港口物流合资项目","content":"斯里兰卡港务局今天周一表示，一家中国国有企业已退出一项价值3.92亿美元的合资项目，该项目原计划在斯里兰卡主要海港开发一个大型物流枢纽。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261019-%E4%B8%AD%E5%9B%BD%E9%80%80%E5%87%BA%E6%96%AF%E9%87%8C%E5%85%B0%E5%8D%A1%E6%B8%AF%E5%8F%A3%E7%89%A9%E6%B5%81%E5%90%88%E8%B5%84%E9%A1%B9%E7%9B%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792418055000.webp","sourceId":"rfi"},{"id":1792416896000,"createdDate":"2026-10-19 13:34","name":"法国国际广播电台","title":"日本能够调停美国和国际刑事法院之间的冲突吗？","content":"最近，美国加紧制裁国际刑事法院（ICC）进行制裁，美国政府于8月18，对国际刑事法院（ICC）日本人院长赤根智子和一名来自塞内加尔、隶属于检察官办公室的律师列入新的制裁对象。据国际刑事法院介绍，自2025年2月特朗普签署可以制裁国际刑事法院的总统令以来，美国已对国际刑事法院17名相关人员实施了制裁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20261019-%E6%97%A5%E6%9C%AC%E8%83%BD%E5%A4%9F%E8%B0%83%E5%81%9C%E7%BE%8E%E5%9B%BD%E5%92%8C%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2%E4%B9%8B%E9%97%B4%E7%9A%84%E5%86%B2%E7%AA%81%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792416896000.webp","sourceId":"rfi"},{"id":1792412256000,"createdDate":"2026-10-19 12:17","name":"法国国际广播电台","title":"埃森哲据报拟出售在华业务 估值可达15亿美元","content":"据英国《金融时报》报导，总部位于爱尔兰的全球专业服务公司埃森哲（Accenture）正考虑出售其中国业务，交易金额可能高达15亿美元。作为全球最大的上市IT咨询公司，埃森哲此举旨在聚焦其增长最快的业务领域，并向投资者证明其有能力适应人工智能（AI）浪潮带来的变革。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261019-%E5%9F%83%E6%A3%AE%E5%93%B2%E6%8D%AE%E6%8A%A5%E6%8B%9F%E5%87%BA%E5%94%AE%E5%9C%A8%E5%8D%8E%E4%B8%9A%E5%8A%A1-%E4%BA%A4%E6%98%93%E9%87%91%E9%A2%9D%E5%8F%AF%E8%BE%BE15%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792412256000.webp","sourceId":"rfi"},{"id":1792406661000,"createdDate":"2026-10-19 10:44","name":"法国国际广播电台","title":"与澳洲加强合作 瓦努阿图指预计中方警务存在会随时间推移而减少","content":"澳大利亚政府在太平洋地区取得了一项可能具有重大意义的战略胜利：太平洋西南部岛国瓦努阿图表示，在与澳大利亚签署《纳卡马尔协议》后，中国在瓦努阿图的警务存在“预计会随时间推移而减少”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261019-%E4%B8%8E%E6%BE%B3%E6%B4%B2%E5%8A%A0%E5%BC%BA%E5%90%88%E4%BD%9C-%E7%93%A6%E5%8A%AA%E9%98%BF%E5%9B%BE%E6%8C%87%E9%A2%84%E8%AE%A1%E4%B8%AD%E6%96%B9%E8%AD%A6%E5%8A%A1%E5%AD%98%E5%9C%A8%E4%BC%9A%E9%9A%8F%E6%97%B6%E9%97%B4%E6%8E%A8%E7%A7%BB%E8%80%8C%E5%87%8F%E5%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792406661000.webp","sourceId":"rfi"},{"id":1792405773000,"createdDate":"2026-10-19 10:29","name":"法国国际广播电台","title":"法国部分城市执法失控 马克龙婉拒内政部长辞职","content":"法国部分城市执法失控，总统总统马克龙拒绝了内政部长努涅斯的辞职，要求他继续留任，并尽快采取新的措施，打击抗议活动期间发生的打砸抢行为。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261019-%E6%B3%95%E5%9B%BD%E9%83%A8%E5%88%86%E5%9F%8E%E5%B8%82%E6%89%A7%E6%B3%95%E5%A4%B1%E6%8E%A7-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%A9%89%E6%8B%92%E5%86%85%E6%94%BF%E9%83%A8%E9%95%BF%E8%BE%9E%E8%81%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792405773000.webp","sourceId":"rfi"},{"id":1792405031000,"createdDate":"2026-10-19 10:17","name":"法国国际广播电台","title":"乌外长：普京是战犯，不配与特习同席而坐","content":"乌克兰外交部长瑟比加（AndriiSybiha）周一通过社媒平台表示，“乌克兰、美国和俄罗斯领导人之间的三方会晤，或许有助于促使这场战争早日结束。而俄罗斯、中国和美国领导人之间的三方会晤，则只会适得其反——即助长普京继续这场战争”。此前，《华尔街日报》周日援引知情人士报导称，俄总统普京提议下月与美中领导人举行峰会，以谈判达成一项有利于俄方的结束俄乌战争的协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261019-%E4%B9%8C%E5%A4%96%E9%95%BF-%E6%99%AE%E4%BA%AC%E6%98%AF%E6%88%98%E7%8A%AF%EF%BC%8C%E4%B8%8D%E9%85%8D%E4%B8%8E%E7%89%B9%E4%B9%A0%E5%90%8C%E5%B8%AD%E8%80%8C%E5%9D%90","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792405031000.webp","sourceId":"rfi"},{"id":1792403705000,"createdDate":"2026-10-19 09:55","name":"法国国际广播电台","title":"泽连斯基：我相信已采取步骤，旨在说服乌克兰投降","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周日在受访时指责美国总统特朗普（DonaldTrump）试图施压乌方向俄罗斯投降，这使得他与特朗普之间持续一周的争端进一步升级。泽连斯基在接受彭博社采访时还提出了一项新方案：同意特朗普的要求，停止针对俄罗斯炼油厂的袭击——此举旨在应对高企的柴油价格，以此换取更多“爱国者”防空导弹的供应。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261019-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E6%88%91%E7%9B%B8%E4%BF%A1%E5%B7%B2%E9%87%87%E5%8F%96%E6%AD%A5%E9%AA%A4%EF%BC%8C%E6%97%A8%E5%9C%A8%E8%AF%B4%E6%9C%8D%E4%B9%8C%E5%85%8B%E5%85%B0%E6%8A%95%E9%99%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792403705000.webp","sourceId":"rfi"},{"id":1792401781000,"createdDate":"2026-10-19 09:23","name":"法国国际广播电台","title":"日本超百名议员参拜靖国神社  国土交通大臣参拜","content":"19日，日本跨党派议员团体“大家一起参拜靖国神社国会议员之会”所属的执政党和在野党100多名国会议员集体前往靖国神社参拜。高市内阁国土交通大臣井林辰宪于19日参拜了靖国神社。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261019-%E6%97%A5%E6%9C%AC%E8%B6%85%E7%99%BE%E5%90%8D%E8%AE%AE%E5%91%98%E5%8F%82%E6%8B%9C%E9%9D%96%E5%9B%BD%E7%A5%9E%E7%A4%BE-%E5%9B%BD%E5%9C%9F%E4%BA%A4%E9%80%9A%E5%A4%A7%E8%87%A3%E5%8F%82%E6%8B%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792401781000.webp","sourceId":"rfi"},{"id":1792400464000,"createdDate":"2026-10-19 09:01","name":"法国国际广播电台","title":"菲外长召见中国大使就其动武言论表强烈反对 总统府指不会宣布不受欢迎的人","content":"菲律宾外交部周一召见了中国驻菲律宾大使井泉，就其发表涉及对菲律宾动武的言论提出交涉。菲律宾外交部长拉扎罗（Ma.TheresaP.Lazaro）召见了井泉，表达了菲方对他的公开言论的反对立场。菲律宾外交部此前曾将这位大使的言论定性为“隐晦的威胁”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261019-%E8%8F%B2%E5%A4%96%E9%95%BF%E5%8F%AC%E8%A7%81%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF%E5%B0%B1%E5%85%B6%E5%8A%A8%E6%AD%A6%E8%A8%80%E8%AE%BA%E8%A1%A8%E7%A4%BA%E5%BC%BA%E7%83%88%E5%8F%8D%E5%AF%B9-%E6%80%BB%E7%BB%9F%E5%BA%9C%E6%8C%87%E4%B8%8D%E4%BC%9A%E5%AE%A3%E5%B8%83%E4%B8%8D%E5%8F%97%E6%AC%A2%E8%BF%8E%E7%9A%84%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792400464000.webp","sourceId":"rfi"},{"id":1792399553000,"createdDate":"2026-10-19 08:45","name":"法国国际广播电台","title":"美国媒体: 普京提议与特朗普和习近平就乌克兰问题举行峰会  各方回应","content":"据美国媒体《华尔街日报》周日（10月18）援引知情人士报道，俄罗斯总统弗拉基米尔·普京提议与美国和中国领导人举行峰会，以谈判达成一项有利于俄罗斯的结束乌克兰战争的协议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261019-%E7%BE%8E%E5%9B%BD%E5%AA%92%E4%BD%93-%E6%99%AE%E4%BA%AC%E6%8F%90%E8%AE%AE%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E5%92%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%B0%B1%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98%E4%B8%BE%E8%A1%8C%E5%B3%B0%E4%BC%9A-%E5%90%84%E6%96%B9%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792399553000.webp","sourceId":"rfi"},{"id":1792399280000,"createdDate":"2026-10-19 08:41","name":"法国国际广播电台","title":"欧洲思想文化长廊/希腊：欧洲文化永不磨灭的光辉第13：欧里庇得斯：古希腊的现代作家","content":"和埃斯库罗斯、索福克洛斯相比，欧里庇得斯的戏剧更具现代性。这就是说他的戏剧主题，价值判断更容易让现代人理解。他的戏剧主人公面对的问题和解决问题的方式也更易让我们产生共鸣。欧里庇得斯剧作的一个显著特点是让女性占上舞台中央。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261019-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC13-%E6%AC%A7%E9%87%8C%E5%BA%87%E5%BE%97%E6%96%AF-%E5%8F%A4%E5%B8%8C%E8%85%8A%E7%9A%84%E7%8E%B0%E4%BB%A3%E4%BD%9C%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792399280000.webp","sourceId":"rfi"},{"id":1792396250000,"createdDate":"2026-10-19 07:50","name":"法国国际广播电台","title":"新皇岗口岸启用首周日现大混乱 等数小时仍过不了关 内地客：香港管理不行","content":"历时七年重建丶连接深圳与香港的新皇岗口岸，在启用后的首个周日出现大批出境旅客挤爆关口的大混乱情况，更有旅客称滞留数小时仍然无法通关。港府解释，北上深圳的出境人次较过往同期大幅增加近九倍，强调已启动预案疏导人流。不过，两地受影响者均在社交平台批评，现场缺乏人员疏导排队人流，通关指示也不清晰，滞留情况是港方管理混乱所致。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261019-%E6%96%B0%E7%9A%87%E5%B2%97%E5%8F%A3%E5%B2%B8%E5%90%AF%E7%94%A8%E9%A6%96%E5%91%A8%E6%97%A5%E7%8E%B0%E5%A4%A7%E6%B7%B7%E4%B9%B1-%E7%AD%89%E6%95%B0%E5%B0%8F%E6%97%B6%E4%BB%8D%E8%BF%87%E4%B8%8D%E4%BA%86%E5%85%B3-%E5%86%85%E5%9C%B0%E5%AE%A2-%E9%A6%99%E6%B8%AF%E7%AE%A1%E7%90%86%E4%B8%8D%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792396250000.webp","sourceId":"rfi"},{"id":1792444119000,"createdDate":"2026-10-19 21:08","name":"法国国际广播电台","title":"特朗普称已准备好与普京和习近平举行三方会晤","content":"特朗普周一表示，他已准备好于11月在中国与中国国家主席习近平和俄罗斯总统普京举行三方会晤。此前，克里姆林宫发言人曾表示，此次会晤“正在讨论中”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261019-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%B7%B2%E5%87%86%E5%A4%87%E5%A5%BD%E4%B8%8E%E6%99%AE%E4%BA%AC%E5%92%8C%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%BE%E8%A1%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E6%99%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792444119000.webp","sourceId":"rfi"},{"id":1792442173000,"createdDate":"2026-10-19 20:36","name":"法国国际广播电台","title":"德国政府宣布与英伟达（NVIDIA）建立合作伙伴关系","content":"德国政府10月19日宣布与美国人工智能（AI）晶片巨擘英伟达（NVIDIA）的合作伙伴关系，以加速AI在工业应用领域的发展。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261019-%E5%BE%B7%E5%9B%BD%E6%94%BF%E5%BA%9C%E5%AE%A3%E5%B8%83%E4%B8%8E%E8%8B%B1%E4%BC%9F%E8%BE%BE-nvidia-%E5%BB%BA%E7%AB%8B%E5%90%88%E4%BD%9C%E4%BC%99%E4%BC%B4%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792442173000.webp","sourceId":"rfi"},{"id":1792440893000,"createdDate":"2026-10-19 20:14","name":"法国国际广播电台","title":"埃博拉疫情在非洲大陆继续扩散","content":"在非洲大陆，由本迪布焦病毒（EbolaBundibugyo）引发的第17轮埃博拉疫情仍在扩散。这是本台法广非洲组（RFIAfrique）在刚刚过去的周末两天里的法文报道关注焦点之一。在位于刚果民主共和国（RDCongo）西北部、与中非共和国(RCA)接壤地区，继南乌班吉省（ProvinceduSud-Ubangi）于一个月前发现首位确诊患者之后，邻近的北乌班吉省（Nord-Ubangi）现在成为该国第8个被本轮疫情波及的省份。当地至少已有2宗新的确诊病例，其中一人染病身亡。在东非国家肯尼亚(leKenya)境内，内罗毕卫生当局于2026年10月18日星期天通报了该国第8宗埃博拉确诊病例，另有约130人遭隔离。这是法兰西24小时新闻频道（France24）的一则最新法文消息。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261019-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E5%9F%83%E5%8D%9A%E6%8B%89%E7%96%AB%E6%83%85%E5%9C%A8%E9%9D%9E%E6%B4%B2%E5%A4%A7%E9%99%86%E7%BB%A7%E7%BB%AD%E6%89%A9%E6%95%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792440893000.webp","sourceId":"rfi"},{"id":1792440082000,"createdDate":"2026-10-19 20:01","name":"法国国际广播电台","title":"美国：民主党传选后施压撤换赫格塞斯 国防预算成谈判筹码","content":"美国国防部长赫格塞斯（PeteHegseth）成为期中选举前夕的政治焦点。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261019-%E7%BE%8E%E5%9B%BD-%E6%B0%91%E4%B8%BB%E5%85%9A%E4%BC%A0%E9%80%89%E5%90%8E%E6%96%BD%E5%8E%8B%E6%92%A4%E6%8D%A2%E8%B5%AB%E6%A0%BC%E5%A1%9E%E6%96%AF-%E5%9B%BD%E9%98%B2%E9%A2%84%E7%AE%97%E6%88%90%E8%B0%88%E5%88%A4%E7%AD%B9%E7%A0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792440082000.webp","sourceId":"rfi"},{"id":1792439040000,"createdDate":"2026-10-19 19:44","name":"法国国际广播电台","title":"在俄导弹袭乌的轰炸中 俄中美“联盟”显形了?","content":"周一19日凌晨俄罗斯发射多波导弹袭击基辅，至少造成1人死亡、8人受伤。乌克兰总统泽连斯基就此表示：虽然俄罗斯以弹道导弹攻击基辅及周边地区的能源设施，但乌方事前并未收到盟国的预警。所谓的盟国指的当然是美国","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261019-%E5%9C%A8%E4%BF%84%E5%AF%BC%E5%BC%B9%E8%A2%AD%E4%B9%8C%E7%9A%84%E8%BD%B0%E7%82%B8%E4%B8%AD-%E4%BF%84%E4%B8%AD%E7%BE%8E-%E8%81%94%E7%9B%9F-%E6%98%BE%E5%BD%A2%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792439040000.webp","sourceId":"rfi"},{"id":1792438966000,"createdDate":"2026-10-19 19:42","name":"法国国际广播电台","title":"法国暴力事件：政府宣布首批措施，在巴黎、里昂、里尔和尼斯实施“局部”宵禁","content":"周一下午，法国政府宣布了应对全国多座城市周末骚乱的首批措施，首先在巴黎、里昂、里尔和尼斯实施“部分”和“局部”宵禁。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261019-%E6%B3%95%E5%9B%BD%E6%9A%B4%E5%8A%9B%E4%BA%8B%E4%BB%B6-%E6%94%BF%E5%BA%9C%E5%AE%A3%E5%B8%83%E9%A6%96%E6%89%B9%E6%8E%AA%E6%96%BD%EF%BC%8C%E5%9C%A8%E5%B7%B4%E9%BB%8E-%E9%87%8C%E6%98%82-%E9%87%8C%E5%B0%94%E5%92%8C%E5%B0%BC%E6%96%AF%E5%AE%9E%E6%96%BD-%E5%B1%80%E9%83%A8-%E5%AE%B5%E7%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792438966000.webp","sourceId":"rfi"},{"id":1792427605000,"createdDate":"2026-10-19 16:33","name":"法国国际广播电台","title":"特朗普一次次改变立场，还有谁仍然相信他呢？","content":"欢迎收听国际纵横节目。我是阿曼亭，本次节目关注的是在俄乌战争问题上，美国总统特朗普再度改变态度，松绑对俄罗斯的制裁，同时极力施压乌克兰。特朗普一次次改变立场，谁还会再相信唐纳德·特朗普呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%9B%BD%E9%99%85%E7%BA%B5%E6%A8%AA/20261019-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%80%E6%AC%A1%E6%AC%A1%E6%94%B9%E5%8F%98%E7%AB%8B%E5%9C%BA%EF%BC%8C%E8%BF%98%E6%9C%89%E8%B0%81%E4%BB%8D%E7%84%B6%E7%9B%B8%E4%BF%A1%E4%BB%96%E5%91%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792427605000.webp","sourceId":"rfi"},{"id":1792425747000,"createdDate":"2026-10-19 16:02","name":"法国国际广播电台","title":"韩议员：过去三年左右，通过海路非法入境的绝大多数是中国人","content":"周一，在韩国国会农林畜产食品海洋水产委员会对韩国海警进行的国政监查中，最大在野党、国民力量党议员金善教指出，在过去三年左右的时间里，42名海上非法入境者中，有41人（97.6%）是中国籍。另有议员质疑，韩国海警旨在防止非法海上入境的监视系统存在严重缺陷。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261019-%E9%9F%A9%E8%AE%AE%E5%91%98-%E8%BF%87%E5%8E%BB%E4%B8%89%E5%B9%B4%E5%B7%A6%E5%8F%B3%EF%BC%8C%E9%80%9A%E8%BF%87%E6%B5%B7%E8%B7%AF%E9%9D%9E%E6%B3%95%E5%85%A5%E5%A2%83%E7%9A%8497-6-%E4%B8%BA%E4%B8%AD%E5%9B%BD%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792425747000.webp","sourceId":"rfi"},{"id":1792424960000,"createdDate":"2026-10-19 15:49","name":"法国国际广播电台","title":"北京预计2035年进入重度老龄化社会 每三人就有一人年过60岁","content":"路透社援引中国官媒报道，北京预计到2035年将进入重度老龄化社会，60岁及以上人口占比将超过三分之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261019-%E5%8C%97%E4%BA%AC%E9%A2%84%E8%AE%A12035%E5%B9%B4%E8%BF%9B%E5%85%A5%E9%87%8D%E5%BA%A6%E8%80%81%E9%BE%84%E5%8C%96%E7%A4%BE%E4%BC%9A-%E6%AF%8F%E4%B8%89%E4%BA%BA%E5%B0%B1%E6%9C%89%E4%B8%80%E4%BA%BA%E5%B9%B4%E6%BB%A160%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792424960000.webp","sourceId":"rfi"},{"id":1792418705000,"createdDate":"2026-10-19 14:05","name":"法国国际广播电台","title":"法国深陷暴力泥潭 马克龙出访海湾国家：权力真空 ？","content":"在经历了一个充满暴力的周末后，法国总统埃马纽埃尔·马克龙因这一事件可能危及本已混乱的五年任期尾声而饱受批评。但周一，面对国内巨大的压力，他还是按计划开启了海湾地区访问行程，旨在确保石油和柴油供应，从而降低加油站的油价。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261019-%E6%B3%95%E5%9B%BD%E6%B7%B1%E9%99%B7%E6%9A%B4%E5%8A%9B%E6%B3%A5%E6%BD%AD-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%BC%80%E5%90%AF%E4%B8%AD%E4%B8%9C%E6%B5%B7%E6%B9%BE%E5%9B%BD%E5%AE%B6%E8%AE%BF%E9%97%AE-%E6%9D%83%E5%8A%9B%E7%9C%9F%E7%A9%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/19/1792418705000.webp","sourceId":"rfi"}]