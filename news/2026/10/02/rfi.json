[{"id":1790949977000,"createdDate":"2026-10-02 14:06","name":"法国国际广播电台","title":"普京：若领土遭攻击 将动用所有武器 不排除核武","content":"俄罗斯总统普京在瓦尔代国际辩论俱乐部发表讲话，该俱乐部是位于莫斯科的一个智库和国际辩论论坛，就多个议题发表看法。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E6%99%AE%E4%BA%AC-%E8%8B%A5%E9%A2%86%E5%9C%9F%E9%81%AD%E6%94%BB%E5%87%BB-%E5%B0%86%E5%8A%A8%E7%94%A8%E6%89%80%E6%9C%89%E6%AD%A6%E5%99%A8-%E4%B8%8D%E6%8E%92%E9%99%A4%E6%A0%B8%E6%AD%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790949977000.webp","sourceId":"rfi"},{"id":1790947329000,"createdDate":"2026-10-02 13:22","name":"法国国际广播电台","title":"美国加州男子因向中国走私超过3亿美元受出口管制计算机服务器被捕","content":"一家总部位于加州圣加布里埃尔谷的科技公司老板今日被捕，他面临三项联邦指控，被控向中国走私价值超过3亿美元的受美国出口管制的高端计算机服务器，这些服务器内含通常用于超级智能（SI）应用的美国制造的图形处理器（GPU）。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E7%BE%8E%E5%9B%BD%E5%8A%A0%E5%B7%9E%E7%94%B7%E5%AD%90%E5%9B%A0%E5%90%91%E4%B8%AD%E5%9B%BD%E8%B5%B0%E7%A7%81%E8%B6%85%E8%BF%873%E4%BA%BF%E7%BE%8E%E5%85%83%E5%8F%97%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6%E8%AE%A1%E7%AE%97%E6%9C%BA%E6%9C%8D%E5%8A%A1%E5%99%A8%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790947329000.webp","sourceId":"rfi"},{"id":1790947154000,"createdDate":"2026-10-02 13:19","name":"法国国际广播电台","title":"点燃学校、封堵校门、与警察对峙，法国高中生抗议运动为何迅速席卷全国？","content":"连日来，愤怒像一把野火在法国高中学校里迅速蔓延。只要打开手机上的社交媒体，就能看到许多学校燃起熊熊烈火或被垃圾桶和一众学生封锁的画面，而学校外学生们正在和警察紧张对峙，一些学生情绪激动地控诉无法忍受的种种经历。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261002-%E7%82%B9%E7%87%83%E5%AD%A6%E6%A0%A1-%E5%B0%81%E5%A0%B5%E6%A0%A1%E9%97%A8-%E4%B8%8E%E8%AD%A6%E5%AF%9F%E5%AF%B9%E5%B3%99%EF%BC%8C%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E7%94%9F%E6%8A%97%E8%AE%AE%E8%BF%90%E5%8A%A8%E4%B8%BA%E4%BD%95%E8%BF%85%E9%80%9F%E5%B8%AD%E5%8D%B7%E5%85%A8%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790947154000.webp","sourceId":"rfi"},{"id":1790942467000,"createdDate":"2026-10-02 12:01","name":"法国国际广播电台","title":"法国高中暴力抗议持续 400所学校被封 极左翼党被指煽动暴力","content":"法国高中暴力抗议运动持续，大约400所高中学校被抗议者封锁，大量课程转为线上授课。此刻距离法国总统大选7个月。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261002-%E6%B3%95%E5%9B%BD%E9%AB%98%E4%B8%AD%E6%9A%B4%E5%8A%9B%E6%8A%97%E8%AE%AE%E6%8C%81%E7%BB%AD-400%E6%89%80%E5%AD%A6%E6%A0%A1%E8%A2%AB%E5%B0%81-%E6%9E%81%E5%B7%A6%E7%BF%BC%E5%85%9A%E8%A2%AB%E6%8C%87%E7%85%BD%E5%8A%A8%E6%9A%B4%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790942467000.webp","sourceId":"rfi"},{"id":1790942317000,"createdDate":"2026-10-02 11:58","name":"法国国际广播电台","title":"一场不能输的AI竞赛　美中在安全与领先间拉锯","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平近期在华盛顿会晤后，美中同意建立人工智能（AI）对话机制，就AI风险与利益交换意见，但双方在先进芯片、AI模型及运算能力上的竞争并未降温。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261002-%E4%B8%80%E5%9C%BA%E4%B8%8D%E8%83%BD%E8%BE%93%E7%9A%84ai%E7%AB%9E%E8%B5%9B-%E7%BE%8E%E4%B8%AD%E5%9C%A8%E5%AE%89%E5%85%A8%E4%B8%8E%E9%A2%86%E5%85%88%E9%97%B4%E6%8B%89%E9%94%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790942317000.webp","sourceId":"rfi"},{"id":1790942051000,"createdDate":"2026-10-02 11:54","name":"法国国际广播电台","title":"中美“捕猎”，“肥硕慵懒的欧洲须重新长出獠牙与尖爪”","content":"本台订阅的法国主流日刊10月2日头版头条集中关注法国的高中正在燃烧。法国政府力度空前地试图填补高额债务，也是各大日刊的焦点，多家报刊在社论当中讨论了法国严重的债务问题。与中国相关的话题也很多，我们在本期法国报纸摘要节目中，重点选取法国债务与2027年预算案、全法高中生的愤怒、以及与中国相关的话题做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%9B%BD%E9%99%85%E7%BA%B5%E6%A8%AA/20261002-%E4%B8%AD%E7%BE%8E-%E6%8D%95%E7%8C%8E-%EF%BC%8C-%E8%82%A5%E7%A1%95%E6%85%B5%E6%87%92%E7%9A%84%E6%AC%A7%E6%B4%B2%E9%A1%BB%E9%87%8D%E6%96%B0%E9%95%BF%E5%87%BA%E7%8D%A0%E7%89%99%E4%B8%8E%E5%B0%96%E7%88%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790942051000.webp","sourceId":"rfi"},{"id":1790938387000,"createdDate":"2026-10-02 10:53","name":"法国国际广播电台","title":"能源危机：欧盟开会商讨应对柴油价格飙升","content":"面对柴油价格持续飙升，以及来自美国方面的压力，欧盟成员国今天举行紧急会议，讨论如何通过释放战略库存等方式，缓解燃料供应紧张。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E8%83%BD%E6%BA%90%E5%8D%B1%E6%9C%BA-%E6%AC%A7%E6%B4%B2%E5%BC%80%E4%BC%9A%E5%95%86%E8%AE%A8%E5%BA%94%E5%AF%B9%E6%9F%B4%E6%B2%B9%E4%BB%B7%E6%A0%BC%E9%A3%99%E5%8D%87","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790938387000.webp","sourceId":"rfi"},{"id":1790936363000,"createdDate":"2026-10-02 10:19","name":"法国国际广播电台","title":"“金九银十”期待落空 中国锂价再暴跌 宁德时代股价也受累","content":"据回声报本周三（9月30日）报道，中国锂市场波动性空前加剧。9月份，中国锂价暴跌25%，创下2026年下半年以来最大单月跌幅。这反映出需求疲软和库存高企。尽管长期前景可观，但中国产能过剩和经济不确定性正严重拖累着该行业。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261002-%E9%87%91%E4%B9%9D%E9%93%B6%E5%8D%81-%E8%90%BD%E7%A9%BA-%E4%B8%AD%E5%9B%BD%E9%94%82%E4%BB%B7%E5%8F%88%E6%9A%B4%E8%B7%8C-%E5%AE%81%E5%BE%B7%E6%97%B6%E4%BB%A3%E8%82%A1%E4%BB%B7%E4%B9%9F%E5%8F%97%E7%B4%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790936363000.webp","sourceId":"rfi"},{"id":1790931399000,"createdDate":"2026-10-02 08:56","name":"法国国际广播电台","title":"特朗普劝习近平与高市早苗直接对话 高市称与中国保持沟通","content":"据悉，美国总统特朗普在9月24日于华盛顿与中国国家主席习近平会谈时，曾向习近平表达了“（中国）应该与日本对话”的看法，劝习近平与高市早苗直接对话，日本政府相关人士于10月2日透露了这一消息。美中两国政府此前均未公布日本及日中关系是此次会谈的议题，而日本首相高市早苗则一直呼吁与中国对话，表示：“正因为存在令人担忧的问题和各种课题，才更有必要在各个层面开展对话。”","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261002-%E7%89%B9%E6%9C%97%E6%99%AE%E5%8A%9D%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%8E%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E7%9B%B4%E6%8E%A5%E5%AF%B9%E8%AF%9D-%E9%AB%98%E5%B8%82%E7%A7%B0%E4%B8%8E%E4%B8%AD%E5%9B%BD%E4%BF%9D%E6%8C%81%E6%B2%9F%E9%80%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790931399000.webp","sourceId":"rfi"},{"id":1790929978000,"createdDate":"2026-10-02 08:32","name":"法国国际广播电台","title":"台湾接收首批两架美制F-16V战斗机，系特朗普第一任期对台军售协议内容","content":"美国对台军售终于迎来了一些新进展。周五（10月2日），台湾接收了首批两架新一代F-16V战斗机，这批战机属于一项总额80亿美元的采购案，是2019年美国总统特朗普第一任期内获得华盛顿批准的，其中包含66架F-16V战斗机。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261002-%E5%8F%B0%E6%B9%BE%E6%8E%A5%E6%94%B6%E9%A6%96%E6%89%B9%E4%B8%A4%E6%9E%B6%E7%BE%8E%E5%88%B6f-16v%E6%88%98%E6%96%97%E6%9C%BA%EF%BC%8C%E7%B3%BB%E7%89%B9%E6%9C%97%E6%99%AE%E7%AC%AC%E4%B8%80%E4%BB%BB%E6%9C%9F%E5%AF%B9%E5%8F%B0%E5%86%9B%E5%94%AE%E5%8D%8F%E8%AE%AE%E5%86%85%E5%AE%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790929978000.webp","sourceId":"rfi"},{"id":1790928647000,"createdDate":"2026-10-02 08:10","name":"法国国际广播电台","title":"涉煽动罪被捕 网媒创办人「爆炸头」等人于国庆日后获准保释","content":"今年直播「831」事件七周年悼念活动後被香港警方国安处以涉嫌散播假消息煽动为由而拘捕的网媒「爆炸头」创办人邓浩荣，以及同日被捕的社运活跃人士李盈姿，已于国庆日过后获准保释。有意见认为，港警拘捕关注「831」事件的人，是想为警方当年的执法行动「洗底」。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261002-%E6%B6%89%E7%85%BD%E5%8A%A8%E7%BD%AA%E8%A2%AB%E6%8D%95-%E7%BD%91%E5%AA%92%E5%88%9B%E5%8A%9E%E4%BA%BA-%E7%88%86%E7%82%B8%E5%A4%B4-%E7%AD%89%E4%BA%BA%E4%BA%8E%E5%9B%BD%E5%BA%86%E6%97%A5%E5%90%8E%E8%8E%B7%E5%87%86%E4%BF%9D%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790928647000.webp","sourceId":"rfi"},{"id":1790928576000,"createdDate":"2026-10-02 08:09","name":"法国国际广播电台","title":"拯救黎智英：港媒引消息指美驻港领事邀港商界襄助遭冷待","content":"美国总统特朗普（DonaldTrump，台湾译作川普）早前表示，上周与中国国家主席习近平会晤时，曾讨论释放包括前《苹果日报》创办人黎智英等政治犯的问题。中港官方虽未有就此作出回应，但美方似已采取行动，有港媒引述消息指，美国驻港总领事馆高层近日曾联络香港具分量的商界人士，希望他们协助营救黎智英，但遭到冷待。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261002-%E6%8B%AF%E6%95%91%E9%BB%8E%E6%99%BA%E8%8B%B1-%E6%B8%AF%E5%AA%92%E5%BC%95%E6%B6%88%E6%81%AF%E6%8C%87%E7%BE%8E%E9%A9%BB%E6%B8%AF%E9%A2%86%E4%BA%8B%E9%82%80%E6%B8%AF%E5%95%86%E7%95%8C%E8%A5%84%E5%8A%A9%E9%81%AD%E5%86%B7%E5%BE%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790928576000.webp","sourceId":"rfi"},{"id":1790974262000,"createdDate":"2026-10-02 20:51","name":"法国国际广播电台","title":"物价高涨冲击特朗普民调　65%美国人认为政策难辞其咎","content":"美国总统特朗普（DonaldTrump）面临经济与物价压力，民调显示，多数美国人把物价飞涨归咎于特朗普，比例创下他第2任期新低。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261002-%E7%89%A9%E4%BB%B7%E9%AB%98%E6%B6%A8%E5%86%B2%E5%87%BB%E7%89%B9%E6%9C%97%E6%99%AE%E6%B0%91%E8%B0%83-65-%E7%BE%8E%E5%9B%BD%E4%BA%BA%E8%AE%A4%E4%B8%BA%E6%94%BF%E7%AD%96%E9%9A%BE%E8%BE%9E%E5%85%B6%E5%92%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790974262000.webp","sourceId":"rfi"},{"id":1790974028000,"createdDate":"2026-10-02 20:47","name":"法国国际广播电台","title":"七国集团同意释放大量柴油储备缓解油价","content":"为缓解不断飞涨的油价，七国集团领导人周五达成一致，将在未来5个月内释放最多1亿桶柴油和原油储备。主持七国集团视频会议的法国总统马克龙宣布了这一结果。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E4%B8%83%E5%9B%BD%E9%9B%86%E5%9B%A2%E5%90%8C%E6%84%8F%E9%87%8A%E6%94%BE%E5%A4%A7%E9%87%8F%E6%9F%B4%E6%B2%B9%E5%82%A8%E5%A4%87%E7%BC%93%E8%A7%A3%E6%B2%B9%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790974028000.webp","sourceId":"rfi"},{"id":1790963331000,"createdDate":"2026-10-02 17:48","name":"法国国际广播电台","title":"巴西总统大选冲刺 最后一刻取消辩论 81岁卢拉汗流浃背奔跑显示体力好","content":"巴西定于周日举行的总统选举首轮投票，竞选活动在巴西守护圣母的争议以及电视辩论最后一刻被取消的背景下结束。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261002-%E5%B7%B4%E8%A5%BF%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89%E5%86%B2%E5%88%BA-%E6%9C%80%E5%90%8E%E4%B8%80%E5%88%BB%E5%8F%96%E6%B6%88%E8%BE%A9%E8%AE%BA-81%E5%B2%81%E5%8D%A2%E6%8B%89%E6%B1%97%E6%B5%81%E6%B5%83%E8%83%8C%E5%A5%94%E8%B7%91%E6%98%BE%E7%A4%BA%E4%BD%93%E5%8A%9B%E5%A5%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790963331000.webp","sourceId":"rfi"},{"id":1790960946000,"createdDate":"2026-10-02 17:09","name":"法国国际广播电台","title":"披露转移朝鲜战俘：韩国总统警告乌克兰若不道歉将采取相应措施","content":"韩国总统李在明周五警告称，如果乌克兰拒绝就基辅单方面披露将两名朝鲜战俘移交韩国一事作出正式道歉，首尔将采取“措施”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E6%8A%AB%E9%9C%B2%E8%BD%AC%E7%A7%BB%E6%9C%9D%E9%B2%9C%E6%88%98%E4%BF%98-%E9%9F%A9%E5%9B%BD%E6%80%BB%E7%BB%9F%E8%AD%A6%E5%91%8A%E4%B9%8C%E5%85%8B%E5%85%B0%E8%8B%A5%E4%B8%8D%E9%81%93%E6%AD%89%E5%B0%86%E9%87%87%E5%8F%96%E7%9B%B8%E5%BA%94%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790960946000.webp","sourceId":"rfi"},{"id":1790955922000,"createdDate":"2026-10-02 15:45","name":"法国国际广播电台","title":"蔡英文下周访美 卸任总统后首次 将赴斯坦福大学演讲","content":"路透社台北消息，台湾前总统蔡英文周五（10月2日）表示，她将于下周访问美国，在斯坦福大学安全会议上发表演讲，这将是她自2024年卸任以来首次访问美国。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261002-%E8%94%A1%E8%8B%B1%E6%96%87%E4%B8%8B%E5%91%A8%E8%AE%BF%E7%BE%8E-%E5%8D%B8%E4%BB%BB%E6%80%BB%E7%BB%9F%E5%90%8E%E9%A6%96%E6%AC%A1-%E5%B0%86%E8%B5%B4%E6%96%AF%E5%9D%A6%E7%A6%8F%E5%A4%A7%E5%AD%A6%E6%BC%94%E8%AE%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790955922000.webp","sourceId":"rfi"},{"id":1790953459000,"createdDate":"2026-10-02 15:04","name":"法国国际广播电台","title":"迪拜航空袭击事件：特朗普称怀疑与伊朗有关 威胁对其重击","content":"美国总统唐纳德·特朗普周四威胁称，如果证实德黑兰方面与迪拜航空一架航班的机长遭其副驾驶持刀袭击一事有关，将会“重创”伊朗；以色列方面则指出，该航班副驾驶曾接受“伊斯兰主义思想灌输”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261002-%E8%BF%AA%E6%8B%9C%E8%88%AA%E7%A9%BA%E8%A2%AD%E5%87%BB%E4%BA%8B%E4%BB%B6-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E6%80%80%E7%96%91%E4%B8%8E%E4%BC%8A%E6%9C%97%E6%9C%89%E5%85%B3-%E5%A8%81%E8%83%81%E5%AF%B9%E5%85%B6%E9%87%8D%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/02/1790953459000.webp","sourceId":"rfi"}]