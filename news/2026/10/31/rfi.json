[{"id":1793406979000,"createdDate":"2026-10-31 00:36","name":"法国国际广播电台","title":"习近平不断发起清洗，暴露出他对中国共产党的不满与失望","content":"法国世界报周五的一篇文章关注刚刚结束的中共20届5中全会。该报指出，中国领导人习近平长期、大规模地开展反腐运动，不断地发起清洗，暴露出他对中国共产党的不满与失望。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261031-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%8D%E6%96%AD%E5%8F%91%E8%B5%B7%E6%B8%85%E6%B4%97%EF%BC%8C%E6%9A%B4%E9%9C%B2%E5%87%BA%E4%BB%96%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%85%B1%E4%BA%A7%E5%85%9A%E7%9A%84%E4%B8%8D%E6%BB%A1%E4%B8%8E%E5%A4%B1%E6%9C%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793406979000.webp","sourceId":"rfi"},{"id":1793406846000,"createdDate":"2026-10-31 00:34","name":"法国国际广播电台","title":"欧洲港口码头工人罢工，反对港口越来越军事化","content":"10月30日，欧洲及其他共22个国家的约100个海港减少了作业规模。此次行动源于欧洲码头工人委员会发起的罢工号召。国际上的其他码头工人联合会也纷纷响应，其中包括土耳其、印度和摩洛哥的相关工会组织。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261031-%E6%AC%A7%E6%B4%B2%E6%B8%AF%E5%8F%A3%E7%A0%81%E5%A4%B4%E5%B7%A5%E4%BA%BA%E7%BD%A2%E5%B7%A5%EF%BC%8C%E5%8F%8D%E5%AF%B9%E6%B8%AF%E5%8F%A3%E8%B6%8A%E6%9D%A5%E8%B6%8A%E5%86%9B%E4%BA%8B%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793406846000.webp","sourceId":"rfi"},{"id":1793456018000,"createdDate":"2026-10-31 14:13","name":"法国国际广播电台","title":"朝中新鸭绿江大桥开通一周后朝鲜海关出现数百辆中国货车","content":"韩联社消息，韩国统一部28日公开的一份资料显示，连接朝中边境的新鸭绿江大桥本月15日开通以来，仅一周时间，朝方海关区域便出现数百辆货车。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261031-%E6%9C%9D%E4%B8%AD%E6%96%B0%E9%B8%AD%E7%BB%BF%E6%B1%9F%E5%A4%A7%E6%A1%A5%E5%BC%80%E9%80%9A%E4%B8%80%E5%91%A8%E5%90%8E%E6%9C%9D%E9%B2%9C%E6%B5%B7%E5%85%B3%E5%87%BA%E7%8E%B0%E6%95%B0%E7%99%BE%E8%BE%86%E4%B8%AD%E5%9B%BD%E8%B4%A7%E8%BD%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793456018000.webp","sourceId":"rfi"},{"id":1793455110000,"createdDate":"2026-10-31 13:58","name":"法国国际广播电台","title":"两名中国公民因对美国海军进行间谍活动被判两年半监禁加三年监外看管","content":"两名中国公民因代表中国国安部向美国海军人员收集情报、招募潜在线人并协助进行秘密现金支付，被判处两年半监禁，随后三年监外看管。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261031-%E4%B8%A4%E5%90%8D%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E5%9B%A0%E5%AF%B9%E7%BE%8E%E5%9B%BD%E6%B5%B7%E5%86%9B%E8%BF%9B%E8%A1%8C%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E8%A2%AB%E5%88%A4%E4%B8%A4%E5%B9%B4%E5%8D%8A%E7%9B%91%E7%A6%81%E5%8A%A0%E4%B8%89%E5%B9%B4%E7%9B%91%E5%A4%96%E7%9C%8B%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793455110000.webp","sourceId":"rfi"},{"id":1793451459000,"createdDate":"2026-10-31 12:57","name":"法国国际广播电台","title":"万圣节之夜，法国迎来第三轮抗议活动，预计至少35万人参加","content":"本周六（10月31日）法国迎来了第三轮抗议活动，这已经是连续第三个周末法国民众走上街头，抗议生活成本上涨及教育问题。今天还是万圣节之夜，法国内政部长已警告，不能以变装为借口，在公共场所遮挡面部，从而“实施扰乱公共秩序的行为”。法国法律允许民众在万圣节等节庆活动期间于公共场所佩戴面具，但禁止在存在公共秩序风险的示威活动周边蒙面。目前，当局担心重演10月17日的混乱局面，因此严阵以待，部署了7万名警察和宪兵。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261031-%E4%B8%87%E5%9C%A3%E8%8A%82%E4%B9%8B%E5%A4%9C%EF%BC%8C%E6%B3%95%E5%9B%BD%E8%BF%8E%E6%9D%A5%E7%AC%AC%E4%B8%89%E8%BD%AE%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8%EF%BC%8C%E9%A2%84%E8%AE%A1%E8%87%B3%E5%B0%9135%E4%B8%87%E4%BA%BA%E5%8F%82%E5%8A%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793451459000.webp","sourceId":"rfi"},{"id":1793449206000,"createdDate":"2026-10-31 12:20","name":"法国国际广播电台","title":"姆巴佩迷因风波被指「冒犯民族情感」遭中国封杀、引网友众怒都因「毛泽东热」？","content":"法国球星姆巴佩（KylianMbappé）因一段影片称毛泽东为独裁者，引起「辱华」争议，遭到中国官方抵制与多家品牌解约。姆巴佩在27日随即发表中、英、法三语声明向中国人致歉。皇家马德里俱乐部、西甲联盟以及法国足协也相继发文灭火，称其并非有意冒犯。但姆巴佩的道歉似乎仍未能平息舆论，许多网友仍坚决不买帐。姆巴佩的迷因风波会引起中国强烈反弹，背后可能与中国Z世代毛泽东热与近年的《英烈保护法》有关。那么，中国网友又是怎么看的？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261031-%E5%A7%86%E5%B7%B4%E4%BD%A9%E8%BF%B7%E5%9B%A0%E9%A3%8E%E6%B3%A2%E8%A2%AB%E6%8C%87-%E5%86%92%E7%8A%AF%E6%B0%91%E6%97%8F%E6%83%85%E6%84%9F-%E9%81%AD%E4%B8%AD%E5%9B%BD%E5%B0%81%E6%9D%80-%E5%BC%95%E7%BD%91%E5%8F%8B%E4%BC%97%E6%80%92%E9%83%BD%E5%9B%A0-%E6%AF%9B%E6%B3%BD%E4%B8%9C%E7%83%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793449206000.webp","sourceId":"rfi"},{"id":1793448802000,"createdDate":"2026-10-31 12:13","name":"法国国际广播电台","title":"“梅拉尼娅应获诺贝尔和平奖” ：赫尔松在72小时停火中暂获安宁","content":"在周六预计法国即将再次掀起新一波示威浪潮之际，《解放报》头版聚焦法国燃油价格持续上涨引发的民生危机：“开车还是吃饭，必须二选一”，由于油价高企，依赖汽车出行的民众面临日益沉重的经济压力。另一份周末出刊的报纸《费加罗报》头版同样关注周六全国多地即将举行的第三波社会动员，主要侧重于政府方面的高度戒备，由于正值万圣节，此次动员被评估“公共秩序混乱风险极高”、尤其在入夜之后，网络已有发帖呼呼变装游行“黑暗之夜“。和上周六一样，内政部将部署7万警察和宪兵维安，防止10月17日暴力混乱局面重现。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261031-%E6%A2%85%E6%8B%89%E5%B0%BC%E5%A8%85%E5%BA%94%E8%AF%A5%E8%8E%B7%E5%92%8C%E5%B9%B3%E8%AF%BA%E5%A5%96-%E8%B5%AB%E5%B0%94%E6%9D%BE%E5%9C%A872%E5%B0%8F%E6%97%B6%E5%81%9C%E7%81%AB%E4%B8%AD%E6%9A%82%E8%8E%B7%E5%AE%89%E5%AE%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793448802000.webp","sourceId":"rfi"},{"id":1793448582000,"createdDate":"2026-10-31 12:09","name":"法国国际广播电台","title":"“梅拉尼娅应获诺贝尔和平奖” ：赫尔松在72小时停火中暂获安宁","content":"在周六预计法国即将再次掀起新一波示威浪潮之际，《解放报》头版聚焦法国燃油价格持续上涨引发的民生危机：“开车还是吃饭，必须二选一”，由于油价高企，依赖汽车出行的民众面临日益沉重的经济压力。另一份周末出刊的报纸《费加罗报》头版同样关注周六全国多地即将举行的第三波社会动员，主要侧重于政府方面的高度戒备，由于正值万圣节，此次动员被评估“公共秩序混乱风险极高”、尤其在入夜之后，网络已有发帖呼呼变装游行“黑暗之夜“。和上周六一样，内政部将部署7万警察和宪兵维安，防止10月17日暴力混乱局面重现。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261031-%E6%A2%85%E6%8B%89%E5%B0%BC%E5%A8%85%E5%BA%94%E8%AF%A5%E8%8E%B7%E5%92%8C%E5%B9%B3%E8%AF%BA%E5%A5%96-%E8%B5%AB%E5%B0%94%E6%9D%BE%E5%9C%A872%E5%B0%8F%E6%97%B6%E5%81%9C%E7%81%AB%E4%B8%AD%E6%9A%82%E8%8E%B7%E5%AE%89%E5%AE%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793448582000.webp","sourceId":"rfi"},{"id":1793443078000,"createdDate":"2026-10-31 10:37","name":"法国国际广播电台","title":"台北市长辩论：蒋万安猛攻批评对手 沈伯洋称辩论应为展现立场与讨论市政议题","content":"2026台北市长选举电视辩论直播于31日中午12点登场，现任台北市长蒋万安与对手民进党台北市长参选人沈伯洋正面交锋，辩论过程中双方不断交火。辩论由TVBS与三立电视共同主办，进行两小时，流程分为开场申论、交叉诘问、媒体提问及终场结论四阶段。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261031-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E8%BE%A9%E8%AE%BA-%E8%92%8B%E4%B8%87%E5%AE%89%E7%8C%9B%E6%94%BB%E6%89%B9%E8%AF%84%E5%AF%B9%E6%89%8B-%E6%B2%88%E4%BC%AF%E6%B4%8B%E7%A7%B0%E8%BE%A9%E8%AE%BA%E5%BA%94%E4%B8%BA%E5%B1%95%E7%8E%B0%E7%AB%8B%E5%9C%BA%E4%B8%8E%E8%AE%A8%E8%AE%BA%E5%B8%82%E6%94%BF%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793443078000.webp","sourceId":"rfi"},{"id":1793442648000,"createdDate":"2026-10-31 10:30","name":"法国国际广播电台","title":"日俄外长时隔五年会谈  日本要求释放日本记者","content":"日本外务大臣茂木敏充于日本时间31日凌晨，在访问美国期间与俄罗斯外长拉夫罗夫举行会谈，强烈要求俄方立即释放被拘押的日本记者，这是日俄外长相隔约5年后首次举行外长会谈。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261031-%E6%97%A5%E4%BF%84%E5%A4%96%E9%95%BF%E6%97%B6%E9%9A%94%E4%BA%94%E5%B9%B4%E4%BC%9A%E8%B0%88-%E6%97%A5%E6%9C%AC%E8%A6%81%E6%B1%82%E9%87%8A%E6%94%BE%E6%97%A5%E6%9C%AC%E8%AE%B0%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793442648000.webp","sourceId":"rfi"},{"id":1793437207000,"createdDate":"2026-10-31 09:00","name":"法国国际广播电台","title":"多家科技巨头向媒体承诺：将出台新方案，禁止抓取新闻内容用以训练AI模型","content":"法新社周六（10月31日）消息称，多家人工智能（AI）行业巨头周五承诺，将为媒体及其他网站提供一种统一的方式，以便阻止出版的内容被抓取用于训练AI模型，目前已承诺参与的公司包括OpenAI、谷歌、微软和Anthropic。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261031-%E5%A4%9A%E5%AE%B6%E7%A7%91%E6%8A%80%E5%B7%A8%E5%A4%B4%E5%90%91%E5%AA%92%E4%BD%93%E6%89%BF%E8%AF%BA-%E5%B0%86%E5%87%BA%E5%8F%B0%E6%96%B0%E6%96%B9%E6%A1%88%EF%BC%8C%E7%A6%81%E6%AD%A2%E6%8A%93%E5%8F%96%E6%96%B0%E9%97%BB%E5%86%85%E5%AE%B9%E7%94%A8%E4%BB%A5%E8%AE%AD%E7%BB%83ai%E6%A8%A1%E5%9E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793437207000.webp","sourceId":"rfi"},{"id":1793436598000,"createdDate":"2026-10-31 08:49","name":"法国国际广播电台","title":"美国以国安为由 计划禁止中国电信企业直接接入美国电话号码","content":"路透社报道，美国以国家安全为由，计划近期禁止中国电信企业直接接入美国电话号码，以防范诈骗电话和非法自动拨号活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261031-%E7%BE%8E%E5%9B%BD%E4%BB%A5%E5%9B%BD%E5%AE%89%E4%B8%BA%E7%94%B1-%E8%AE%A1%E5%88%92%E7%A6%81%E6%AD%A2%E4%B8%AD%E5%9B%BD%E7%94%B5%E4%BF%A1%E4%BC%81%E4%B8%9A%E7%9B%B4%E6%8E%A5%E6%8E%A5%E5%85%A5%E7%BE%8E%E5%9B%BD%E7%94%B5%E8%AF%9D%E5%8F%B7%E7%A0%81","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793436598000.webp","sourceId":"rfi"},{"id":1793477069000,"createdDate":"2026-10-31 20:04","name":"法国国际广播电台","title":"四方安全对话外长联合声明　未点名剑指中国经济政策","content":"美国、日本、印度和澳洲四方安全对话，也就是“Quad”外长星期六发表联合声明，对“经济胁迫”、任意出口限制，以及导致产能过剩的非市场政策表达严重关切。虽然声明没有点名任何国家，但外界普遍认为，矛头指向中国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261031-%E5%9B%9B%E6%96%B9%E5%AE%89%E5%85%A8%E5%AF%B9%E8%AF%9D%E5%A4%96%E9%95%BF%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E-%E6%9C%AA%E7%82%B9%E5%90%8D%E5%89%91%E6%8C%87%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793477069000.webp","sourceId":"rfi"},{"id":1793471260000,"createdDate":"2026-10-31 18:27","name":"法国国际广播电台","title":"退休11年 前中国中石化董事长傅成玉被查","content":"前中国中石化董事长傅成玉在退休11年后，被宣布因涉嫌严重违纪违法，接受中央纪委国家监委纪律审查和监察调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261031-%E9%80%80%E4%BC%9111%E5%B9%B4-%E5%89%8D%E4%B8%AD%E5%9B%BD%E4%B8%AD%E7%9F%B3%E5%8C%96%E8%91%A3%E4%BA%8B%E9%95%BF%E5%82%85%E6%88%90%E7%8E%89%E8%A2%AB%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793471260000.webp","sourceId":"rfi"},{"id":1793470785000,"createdDate":"2026-10-31 18:19","name":"法国国际广播电台","title":"糟糕的中期选举结果 可能促使特朗普对伊朗发动大规模攻击","content":"美国与伊朗紧张关系再度升温，双方一边透过卡达斡旋寻求恢复谈判，一边加紧军事部署。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261031-%E7%B3%9F%E7%B3%95%E7%9A%84%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E7%BB%93%E6%9E%9C-%E5%8F%AF%E8%83%BD%E4%BF%83%E4%BD%BF%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%8F%91%E5%8A%A8%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%94%BB%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/10/31/1793470785000.webp","sourceId":"rfi"},{"id":1793469127000,"createdDate":"2026-10-31 17:52","name":"法国国际广播电台","title":"波兰宪法法院争夺白热化：防爆警察封锁法院 总统出访紧急折返","content":"波兰总理图斯克的中右翼政府要求上届民粹保守党执政时期任命的法官们离职，引发保守党“法律与公正党”支持者连续数周包围