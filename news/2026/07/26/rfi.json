[{"id":1785060203000,"createdDate":"2026-07-26 10:03","name":"法国国际广播电台","title":"泽连斯基：俄罗斯望再接收3万朝鲜兵，已开展接收准备工作","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周六表示，俄罗斯希望再接收3万名朝鲜军人参与这场已持续近四年半的战争，并已着手准备接收这批部队。朝鲜曾于2024年向俄罗斯库尔斯克州派遣了约1.4万名军人，以协助莫斯科击退乌军对该地区的大规模入侵。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260726-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E4%BF%84%E7%BD%97%E6%96%AF%E6%9C%9B%E5%86%8D%E6%8E%A5%E6%94%B63%E4%B8%87%E6%9C%9D%E9%B2%9C%E5%85%B5%EF%BC%8C%E5%B7%B2%E5%BC%80%E5%B1%95%E6%8E%A5%E6%94%B6%E5%87%86%E5%A4%87%E5%B7%A5%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785060203000.webp","sourceId":"rfi"},{"id":1785055910000,"createdDate":"2026-07-26 08:51","name":"法国国际广播电台","title":"6岁女童接受基因编辑试验后死亡 上海交大医学院：对事件进行全面调查","content":"国际顶级学术期刊《科学》与知名学术诚信监督平台“撤稿观察”（RetractionWatch）周四（23日）联合披露了一起临床试验死亡事件：2025年3月24日，上海交通大学医学院附属新华医院为一名6岁女童实施了实验性脑部碱基编辑治疗。按照项目团队当时的说法，这是全球首例脑靶向基因编辑治疗。7天后，女童死于与该治疗相关的严重免疫反应。医院伦理委员会随后认定，她的死亡与治疗“肯定相关”。女童是这项试验唯一的受试者，而这起死亡此后一年多没有公开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260726-6%E5%B2%81%E5%A5%B3%E7%AB%A5%E6%8E%A5%E5%8F%97%E5%9F%BA%E5%9B%A0%E7%BC%96%E8%BE%91%E8%AF%95%E9%AA%8C%E5%90%8E%E6%AD%BB%E4%BA%A1-%E4%B8%8A%E6%B5%B7%E4%BA%A4%E5%A4%A7%E5%8C%BB%E5%AD%A6%E9%99%A2-%E5%AF%B9%E4%BA%8B%E4%BB%B6%E8%BF%9B%E8%A1%8C%E5%85%A8%E9%9D%A2%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785055910000.webp","sourceId":"rfi"},{"id":1785054560000,"createdDate":"2026-07-26 08:29","name":"法国国际广播电台","title":"柏林骄傲节汽车撞人已致1死16伤  21岁嫌疑人与伊斯兰团体存在关联","content":"德国警方周日（7月26日）发布通缉令，追捕一名在柏林骄傲节游行附近驾车冲撞事件后潜逃的嫌疑人。嫌疑人涉嫌于周六深夜驾驶一辆汽车撞伤多人，随后一名或多名人员离开了该车辆。此外，还有数人疑似遭到持刀袭击。这起事件已造成1人死亡、至少16人受伤。据悉，柏林骄傲节是欧洲规模最大的LGBTQ+庆典之一。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260726-%E6%9F%8F%E6%9E%97%E9%AA%84%E5%82%B2%E8%8A%82%E6%B1%BD%E8%BD%A6%E6%92%9E%E4%BA%BA%E4%BA%8B%E4%BB%B6-%E5%B7%B2%E8%87%B41%E6%AD%BB16%E4%BC%A4-21%E5%B2%81%E5%AB%8C%E7%96%91%E4%BA%BA%E4%B8%8E%E4%BC%8A%E6%96%AF%E5%85%B0%E5%9B%A2%E4%BD%93%E5%AD%98%E5%9C%A8%E5%85%B3%E8%81%94","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785054560000.webp","sourceId":"rfi"},{"id":1785054105000,"createdDate":"2026-07-26 08:21","name":"法国国际广播电台","title":"中方否认日中外相曾在东盟外长会议上交谈？","content":"最近日本媒体纷纷报道：在东盟（ASEAN）相关外长会议于马尼拉举行期间，日本外相茂木敏于22日与中国外交部长王毅进行了短暂接触。自去年11月日本首相高市早苗就“台湾有事”作出相关答辩，这是两国外长之间首次进行对话。但是日本共同社25日报道称：中国国营的中国国际电视台（CGTN）旗下账号25日在微博发文称，中国外交部长王毅在菲律宾马尼拉表示：“没有与日方安排会谈，也没有交谈。”日本外相茂木敏充则在此前表示，他于22日中午前后在菲律宾与王毅进行了短暂接触。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260726-%E4%B8%AD%E6%96%B9%E5%90%A6%E8%AE%A4%E6%97%A5%E4%B8%AD%E5%A4%96%E7%9B%B8%E6%9B%BE%E5%9C%A8%E4%B8%9C%E7%9B%9F%E5%A4%96%E9%95%BF%E4%BC%9A%E8%AE%AE%E4%B8%8A%E4%BA%A4%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785054105000.webp","sourceId":"rfi"},{"id":1785050681000,"createdDate":"2026-07-26 07:24","name":"法国国际广播电台","title":"莫迪罕见妥协：印度教育部长因“泄题风暴”辞职，青年抗议者高喊胜利","content":"路透社新德里消息，周六，随着教育部长宣布辞职，莫迪政府向抗议者的核心诉求低头——同意整改屡屡发生作弊漏洞的考试系统，印度青年抗议者在街头欢呼庆祝，并宣布结束持续数周的示威活动。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260726-%E8%8E%AB%E8%BF%AA%E7%BD%95%E8%A7%81%E5%A6%A5%E5%8D%8F-%E5%8D%B0%E5%BA%A6%E6%95%99%E8%82%B2%E9%83%A8%E9%95%BF%E5%9B%A0-%E6%B3%84%E9%A2%98%E9%A3%8E%E6%9A%B4-%E8%BE%9E%E8%81%8C%EF%BC%8C%E9%9D%92%E5%B9%B4%E6%8A%97%E8%AE%AE%E8%80%85%E9%AB%98%E5%96%8A%E8%83%9C%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785050681000.webp","sourceId":"rfi"},{"id":1785080460000,"createdDate":"2026-07-26 15:41","name":"法国国际广播电台","title":"被美国要求效仿其针对中国钢铁和铝产品的关税壁垒 墨西哥据报持开放态度","content":"据彭博社援引四位知情人士报导称，美国已要求墨西哥效仿美方针对中国钢铁和铝产品设立的关税壁垒，对来自北美以外地区的进口产品征收类似“232条款”的关税。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260726-%E8%A2%AB%E7%BE%8E%E5%9B%BD%E8%A6%81%E6%B1%82%E6%95%88%E4%BB%BF%E5%85%B6%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E9%92%A2%E9%93%81%E5%92%8C%E9%93%9D%E4%BA%A7%E5%93%81%E7%9A%84%E5%85%B3%E7%A8%8E%E5%A3%81%E5%9E%92-%E5%A2%A8%E8%A5%BF%E5%93%A5%E6%8D%AE%E6%8A%A5%E6%8C%81%E5%BC%80%E6%94%BE%E6%80%81%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785080460000.webp","sourceId":"rfi"},{"id":1785078559000,"createdDate":"2026-07-26 15:09","name":"法国国际广播电台","title":"伊朗军方称鉴于美军停止新的攻击 其亦停止报复行动 特朗普下一步受关注","content":"伊朗军方周日表示，在美方过去两晚停止对该国的打击后，伊朗也已暂停针对美国中东盟友的报复性袭击。伊朗军方发表此番声明之际，这场已持续近五个月的冲突正处于华盛顿暂停行动的间歇期；此外，有报道称，弹药储备日益减少的担忧正制约着进一步升级冲突的计划。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20260726-%E4%BC%8A%E6%9C%97%E5%86%9B%E6%96%B9%E7%A7%B0%E9%89%B4%E4%BA%8E%E7%BE%8E%E5%86%9B%E5%81%9C%E6%AD%A2%E6%96%B0%E7%9A%84%E6%94%BB%E5%87%BB-%E5%85%B6%E4%BA%A6%E5%81%9C%E6%AD%A2%E6%8A%A5%E5%A4%8D%E8%A1%8C%E5%8A%A8-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8B%E4%B8%80%E6%AD%A5%E5%8F%97%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785078559000.webp","sourceId":"rfi"},{"id":1785076938000,"createdDate":"2026-07-26 14:42","name":"法国国际广播电台","title":"美中无人机竞争已至珠峰 今年登山季尼泊尔一度禁飞两国无人机","content":"据《华尔街日报》报导，美国官员正力推一款美制无人机，试图在为登山者提供支持的这一新兴竞争领域挑战中国竞争对手；这场美中之间的较量，发生在地球上最偏远的地区之一。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260726-%E7%BE%8E%E4%B8%AD%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%AB%9E%E4%BA%89%E5%B7%B2%E8%87%B3%E7%8F%A0%E5%B3%B0-%E4%BB%8A%E5%B9%B4%E7%99%BB%E5%B1%B1%E5%AD%A3%E5%B0%BC%E6%B3%8A%E5%B0%94%E4%B8%80%E5%BA%A6%E8%AE%A9%E4%B8%A4%E5%9B%BD%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%A6%81%E9%A3%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785076938000.webp","sourceId":"rfi"},{"id":1785068892000,"createdDate":"2026-07-26 12:28","name":"法国国际广播电台","title":"三名乐金显示前员工因向中企泄露显示器技术在韩被判刑","content":"三名向中国竞争对手公司泄露大型有机发光二极管（OLED）显示器量产技术的韩企乐金显示（LGDisplay）前员工，在一审中分别被判处1年至5年不等有期徒刑。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260726-%E4%B8%89%E5%90%8D%E4%B9%90%E9%87%91%E6%98%BE%E7%A4%BA%E5%89%8D%E5%91%98%E5%B7%A5%E5%9B%A0%E5%90%91%E4%B8%AD%E4%BC%81%E6%B3%84%E9%9C%B2%E6%98%BE%E7%A4%BA%E5%99%A8%E6%8A%80%E6%9C%AF%E5%9C%A8%E9%9F%A9%E8%A2%AB%E5%88%A4%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785068892000.webp","sourceId":"rfi"},{"id":1785064031000,"createdDate":"2026-07-26 11:07","name":"法国国际广播电台","title":"世界报：法国山火、中国台风、美国“飞虎队”85年后成了北京的大外宣","content":"大家好，周日7月26日法国《世界报》头版大篇幅报道法国续遭失控山火的肆虐，自周三以来，吉伦特省已有22万人撤离，该地区4.2万公顷土地遭大火吞噬，波尔多以南的铁路交通中断。该报国际版同时关注了今年袭击中国的最强台风“红霞”于周日凌晨在中国南部沿海登陆。此外《世界报》北京通讯员注意到，美国飞虎队这支曾在二战期间支援中国军队抵御日军进攻的空中部队，如今正被北京方面用于外交手段，试图影响华盛顿对中国的态度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260726-%E4%B8%96%E7%95%8C%E6%8A%A5-%E6%B3%95%E5%9B%BD%E5%B1%B1%E7%81%AB-%E4%B8%AD%E5%9B%BD%E5%8F%B0%E9%A3%8E-%E7%BE%8E%E5%9B%BD-%E9%A3%9E%E8%99%8E%E9%98%9F-85%E5%B9%B4%E5%90%8E%E6%88%90%E4%BA%86%E5%8C%97%E4%BA%AC%E7%9A%84%E5%A4%A7%E5%A4%96%E5%AE%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785064031000.webp","sourceId":"rfi"},{"id":1785062548000,"createdDate":"2026-07-26 10:42","name":"法国国际广播电台","title":"菲美日在南海进行为期5天的联演后 解放军海空力量进行例行巡航","content":"据美国太平洋司令部介绍，7月21日至25日，菲律宾武装部队、日本海上自卫队与美国海军在菲律宾专属经济区内开展了“多边海事合作活动”（MMCA）。美国太平洋司令部称，“此次活动彰显了各方致力于加强区域与国际合作，以支持自由开放的印度-太平洋的共同承诺”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260726-%E8%8F%B2%E7%BE%8E%E6%97%A5%E5%9C%A8%E5%8D%97%E6%B5%B7%E8%BF%9B%E8%A1%8C%E4%B8%BA%E6%9C%9F5%E5%A4%A9%E7%9A%84%E8%81%94%E6%BC%94%E5%90%8E-%E8%A7%A3%E6%94%BE%E5%86%9B%E6%B5%B7%E7%A9%BA%E5%8A%9B%E9%87%8F%E8%BF%9B%E8%A1%8C%E4%BE%8B%E8%A1%8C%E5%B7%A1%E8%88%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/26/1785062548000.webp","sourceId":"rfi"}]