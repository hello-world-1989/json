[{"id":1785197386000,"createdDate":"2026-07-28 00:09","name":"法国国际广播电台","title":"重庆山崩现场寻获失联客运中巴车及人体残骸","content":"重庆市彭水县17日9时左右发生大型山体崩塌事件，造成10人受伤、11人死亡、50人失联。失联人员凶多吉少。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260728-%E9%87%8D%E5%BA%86%E5%B1%B1%E5%B4%A9%E7%8E%B0%E5%9C%BA%E5%AF%BB%E8%8E%B7%E5%A4%B1%E8%81%94%E5%AE%A2%E8%BF%90%E4%B8%AD%E5%B7%B4%E8%BD%A6%E5%8F%8A%E4%BA%BA%E4%BD%93%E6%AE%8B%E9%AA%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785197386000.webp","sourceId":"rfi"},{"id":1785196886000,"createdDate":"2026-07-28 00:01","name":"法国国际广播电台","title":"是否应该封杀华为？欧洲电信运营商与欧盟委员会分歧严重","content":"法国世界报周一刊出文章表示，就是否应该全面禁止华为设备一事，欧洲电信运营商与欧盟委员会分歧严重。欧盟委员会希望将华为和中兴等中国通信设备企业逐步排除出欧洲的电信网络，理由是国家安全和网络安全。但欧洲多家电信运营商认为，这样做代价太高，可能给整个行业带来巨大损失。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260728-%E6%98%AF%E5%90%A6%E5%BA%94%E8%AF%A5%E5%B0%81%E6%9D%80%E5%8D%8E%E4%B8%BA-%E6%AC%A7%E6%B4%B2%E7%94%B5%E4%BF%A1%E8%BF%90%E8%90%A5%E5%95%86%E4%B8%8E%E6%AC%A7%E7%9B%9F%E5%A7%94%E5%91%98%E4%BC%9A%E5%88%86%E6%AD%A7%E4%B8%A5%E9%87%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785196886000.webp","sourceId":"rfi"},{"id":1785235515000,"createdDate":"2026-07-28 10:45","name":"法国国际广播电台","title":"乌战伊战交锋 白宫同一天接待内塔尼亚胡和泽连斯基：且看谁更受特朗普青睐赢得支持","content":"美国总统特朗普周二将在白宫分别接待以色列总理内塔尼亚胡和乌克兰总统泽连斯基。目前，伊朗和乌克兰的战争都处于关键阶段，而特朗普与这两位领导人的关系也明显不同。据路透社报道，内塔尼亚胡和泽连斯基两人此次前往华盛顿，是为了参加参议员林赛·格雷厄姆的追悼会。但两人想要游说特朗普的目标则不同。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260728-%E4%B9%8C%E6%88%98%E4%BC%8A%E6%88%98%E4%BA%A4%E9%94%8B-%E7%99%BD%E5%AE%AB%E5%90%8C%E4%B8%80%E5%A4%A9%E6%8E%A5%E5%BE%85%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E5%92%8C%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E4%B8%94%E7%9C%8B%E8%B0%81%E6%9B%B4%E5%8F%97%E7%89%B9%E6%9C%97%E6%99%AE%E9%9D%92%E7%9D%90%E8%B5%A2%E5%BE%97%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785235515000.webp","sourceId":"rfi"},{"id":1785234873000,"createdDate":"2026-07-28 10:34","name":"法国国际广播电台","title":"欧盟对从中国进口的聚酰胺纱线征收临时反倾销税","content":"为保护欧盟生产商，欧盟已开始对中国产聚酰胺纱线征收临时反倾销税。欧盟委员会周二在一份声明中表示，经调查，相关税率定在60%至67.5%之间。声明指出，欧盟聚酰胺纱线市场——该产品用于纺织行业——价值4亿欧元，该行业雇用了2000名员工。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260728-%E6%AC%A7%E7%9B%9F%E5%AF%B9%E4%BB%8E%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%8F%A3%E7%9A%84%E8%81%9A%E9%85%B0%E8%83%BA%E7%BA%B1%E7%BA%BF%E5%BE%81%E6%94%B6%E5%8F%8D%E5%80%BE%E9%94%80%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785234873000.webp","sourceId":"rfi"},{"id":1785234302000,"createdDate":"2026-07-28 10:25","name":"法国国际广播电台","title":"上海爱晟纳生产自主沉浸式深紫外光刻机受关注 知情人士指仍需进一步测试","content":"据路透社援引知情人士报导，中国已开始批量生产自主研发的沉浸式深紫外（DUV）光刻机——这是一项对先进芯片制造至关重要的技术；此举标志着中国在减少对外国技术依赖的进程中迈出了关键一步。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260728-%E4%B8%8A%E6%B5%B7%E7%88%B1%E6%99%9F%E7%BA%B3%E6%89%B9%E9%87%8F%E7%94%9F%E4%BA%A7%E8%87%AA%E4%B8%BB%E6%B2%89%E6%B5%B8%E5%BC%8F%E6%B7%B1%E7%B4%AB%E5%A4%96%E5%85%89%E5%88%BB%E6%9C%BA%E5%8F%97%E5%85%B3%E6%B3%A8-%E7%9F%A5%E6%83%85%E4%BA%BA%E5%A3%AB%E6%8C%87%E4%BB%8D%E9%9C%80%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%B5%8B%E8%AF%95","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785234302000.webp","sourceId":"rfi"},{"id":1785231844000,"createdDate":"2026-07-28 09:44","name":"法国国际广播电台","title":"大马柔佛警方捣毁两个网络诈骗团伙 逮捕335人，含309名中国公民","content":"柔佛州总警长表示，大马警方在该州突击搜查了32处涉嫌从事网络诈骗活动的场所，逮捕了335人，并查获了价值约100万马来西亚林吉特（约合24.5万美元）的资产。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260728-%E5%A4%A7%E9%A9%AC%E6%9F%94%E4%BD%9B%E8%AD%A6%E6%96%B9%E6%8D%A3%E6%AF%81%E4%B8%A4%E4%B8%AA%E8%AF%88%E9%AA%97%E5%9B%A2%E4%BC%99-%E9%80%AE%E6%8D%95335%E5%90%8D%E4%BA%BA%EF%BC%8C%E5%90%AB309%E5%90%8D%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785231844000.webp","sourceId":"rfi"},{"id":1785230090000,"createdDate":"2026-07-28 09:14","name":"法国国际广播电台","title":"非法滞留外国人连年减少 日本仍加大打击力度","content":"日本政府7月28日在内阁会议上决定了一项修改政令，紧急增加226名出入国在留管理厅（入管厅）工作人员，以加强对非法滞留外国人的查处，并防止通过不正当手段取得在留资格。此次增员是为了呼应高市政权从严管理外国人的新政策。值得注意的是，日本非法滞留人数已连续两年出现下降趋势，但是日本政府学习美国特朗普政权排斥移民的政策，无论从批准永住资格、批准投资经营签证及打击非法滞留等方面，都越来越严厉。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260728-%E9%9D%9E%E6%B3%95%E6%BB%9E%E7%95%99%E5%A4%96%E5%9B%BD%E4%BA%BA%E8%BF%9E%E5%B9%B4%E5%87%8F%E5%B0%91-%E6%97%A5%E6%9C%AC%E4%BB%8D%E5%8A%A0%E5%A4%A7%E6%89%93%E5%87%BB%E5%8A%9B%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785230090000.webp","sourceId":"rfi"},{"id":1785229679000,"createdDate":"2026-07-28 09:07","name":"法国国际广播电台","title":"向中港澳走私高阶芯片案 台官员搜英伟达 逮捕一涉案业务经理","content":"据《自由时报》等媒体报导，基隆地检署侦办台湾业者走私超微电脑（Supermicro）高阶人工智能服务器至中港澳案，继上月28日搜索股票上柜公司青云、是方电讯及超微电脑在台分公司等12处地点后，24日发动第三波搜索，搜索英伟达与公司张姓业务经理住处；经检察官复讯后，认定张犯罪嫌疑重大，并有逃亡、湮灭证据之虞，当庭予以逮捕，并向法院声请羁押禁见获准。张姓男子也成为基隆地检署5月20日发动第一波搜索以来，第7名被声押禁见的被告。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260728-%E5%90%91%E4%B8%AD%E6%B8%AF%E6%BE%B3%E8%B5%B0%E7%A7%81%E9%AB%98%E9%98%B6%E8%8A%AF%E7%89%87%E6%A1%88-%E5%8F%B0%E5%AE%98%E5%91%98%E6%90%9C%E8%8B%B1%E4%BC%9F%E8%BE%BE-%E9%80%AE%E6%8D%95%E4%B8%80%E6%B6%89%E6%A1%88%E4%B8%9A%E5%8A%A1%E7%BB%8F%E7%90%86","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785229679000.webp","sourceId":"rfi"},{"id":1785228210000,"createdDate":"2026-07-28 08:43","name":"法国国际广播电台","title":"疑虑翻涌：数以千计社运判刑人士忧入英时成第二个胡志伟 倡设「白名单」","content":"香港前民主党主席胡志伟一度遭英国边防拒绝入境一事馀波不息，香港政治犯能否入境英国的问题尤其凸出，不少同在「47人案」被判刑者认同，事件突显因政治原因被判囚者入境英国存在的制度问题，建议设立入境「白名单」，让经审核者可以享有与其他港人相同的赴英权利。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260728-%E7%96%91%E8%99%91%E7%BF%BB%E6%B6%8C-%E6%95%B0%E4%BB%A5%E5%8D%83%E8%AE%A1%E7%A4%BE%E8%BF%90%E5%88%A4%E5%88%91%E4%BA%BA%E5%A3%AB%E5%BF%A7%E5%85%A5%E8%8B%B1%E6%97%B6%E6%88%90%E7%AC%AC%E4%BA%8C%E4%B8%AA%E8%83%A1%E5%BF%97%E4%BC%9F-%E5%80%A1%E8%AE%BE-%E7%99%BD%E5%90%8D%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785228210000.webp","sourceId":"rfi"},{"id":1785227470000,"createdDate":"2026-07-28 08:31","name":"法国国际广播电台","title":"贸易谈判之际 美海关官员已对越南境内中国关联工厂展开突击检查","content":"据彭博社援引知情人士报导，美国海关官员已对越南境内与中国有关联的工厂进行了突击检查；此举加剧了外界的担忧，即白宫可能很快会寻找理由，对越南加征更多关税。检查人员审查了相关文件、原材料来源及生产流程，旨在核实产品在出口至美国前究竟产生了多少增值。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260728-%E8%B4%B8%E6%98%93%E8%B0%88%E5%88%A4%E4%B9%8B%E9%99%85-%E7%BE%8E%E6%B5%B7%E5%85%B3%E5%AE%98%E5%91%98%E5%B7%B2%E5%AF%B9%E8%B6%8A%E5%8D%97%E5%A2%83%E5%86%85%E4%B8%AD%E5%9B%BD%E5%85%B3%E8%81%94%E5%B7%A5%E5%8E%82%E5%B1%95%E5%BC%80%E7%AA%81%E5%87%BB%E6%A3%80%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785227470000.webp","sourceId":"rfi"},{"id":1785226407000,"createdDate":"2026-07-28 08:13","name":"法国国际广播电台","title":"胡志伟遣返危机暂除　入境申请上诉成功获准留英6个月","content":"前民主党主席胡志伟遭英国边防拒绝入境，需在周三(29日)遣返香港限期届满前，获英国政界声援，经包括前港督彭定康丶前外相聂伟敬（MalcolmRifkind）和英国各大党派议员等人去信英国内政大臣马曼婷（ShabanaMahmood）游说後，英国当局推翻原来决定，在当地时间周一（27日）下午，批准胡志伟能与其他BN(O)护照持有人享有同等待遇，以旅客身份逗留英国最长6个月。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260728-%E8%83%A1%E5%BF%97%E4%BC%9F%E9%81%A3%E8%BF%94%E5%8D%B1%E6%9C%BA%E6%9A%82%E9%99%A4-%E5%85%A5%E5%A2%83%E7%94%B3%E8%AF%B7%E4%B8%8A%E8%AF%89%E6%88%90%E5%8A%9F%E8%8E%B7%E5%87%86%E7%95%99%E8%8B%B16%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785226407000.webp","sourceId":"rfi"},{"id":1785225810000,"createdDate":"2026-07-28 08:03","name":"法国国际广播电台","title":"台湾年度汉光演习将登场 首度测试战时转移武器生产线","content":"路透社台北消息，台湾国防部周二（7月28日）宣布，将在8月登场的汉光演习中，首度模拟在中国发动攻击的情况下，将武器生产线转移至安全地点，并动员民用工厂投入军事生产，以确保战时国防供应链不中断。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260728-%E5%8F%B0%E6%B9%BE%E5%B9%B4%E5%BA%A6%E6%B1%89%E5%85%89%E6%BC%94%E4%B9%A0%E5%B0%86%E7%99%BB%E5%9C%BA-%E9%A6%96%E5%BA%A6%E6%B5%8B%E8%AF%95%E6%88%98%E6%97%B6%E8%BD%AC%E7%A7%BB%E6%AD%A6%E5%99%A8%E7%94%9F%E4%BA%A7%E7%BA%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785225810000.webp","sourceId":"rfi"},{"id":1785253887000,"createdDate":"2026-07-28 15:51","name":"法国国际广播电台","title":"小马科斯：近来，我们作为人的人性甚至遭到质疑，菲律宾人绝不屈服","content":"菲律宾总统小马科斯（FerdinandMarcosJr.）周一在位于马尼拉大都会奎松市的菲众议院发表了其第五次国情咨文。小马科斯在讲话中誓言其政府将捍卫2016年南海仲裁案裁决，并表示菲律宾人“绝不屈服”。中方则长期坚持“不接受、不承认”该裁决的立场。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260728-%E5%B0%8F%E9%A9%AC%E7%A7%91%E6%96%AF-%E8%BF%91%E6%9D%A5%EF%BC%8C%E6%88%91%E4%BB%AC%E4%BD%9C%E4%B8%BA%E4%BA%BA%E7%9A%84%E4%BA%BA%E6%80%A7%E7%94%9A%E8%87%B3%E9%81%AD%E5%88%B0%E8%B4%A8%E7%96%91%EF%BC%8C%E8%8F%B2%E5%BE%8B%E5%AE%BE%E4%BA%BA%E7%BB%9D%E4%B8%8D%E5%B1%88%E6%9C%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785253887000.webp","sourceId":"rfi"},{"id":1785251938000,"createdDate":"2026-07-28 15:18","name":"法国国际广播电台","title":"曾在中国办班 前阵风战机飞行员因“与外国势力进行情报勾结”等重罪被立案审查","content":"曾驾驶“阵风”舰载战斗机的法国海军前飞行员舒埃特（Pierre-HenriChuet）在遭法国对内安全总局（DGSI）拘押后，于上周出庭接受预审法官讯问；他随后被置于司法监管之下，并因涉嫌“与外国势力进行情报勾结”及“向外国势力传递信息”等罪名而被立案审查。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260728-%E6%9B%BE%E5%9C%A8%E4%B8%AD%E5%9B%BD%E5%8A%9E%E7%8F%AD-%E5%89%8D%E9%98%B5%E9%A3%8E%E8%88%B0%E8%BD%BD%E6%88%98%E6%9C%BA%E9%A3%9E%E8%A1%8C%E5%91%98%E5%9B%A0-%E4%B8%8E%E5%A4%96%E5%9B%BD%E5%8A%BF%E5%8A%9B%E8%BF%9B%E8%A1%8C%E6%83%85%E6%8A%A5%E5%8B%BE%E7%BB%93-%E7%AD%89%E9%87%8D%E7%BD%AA%E8%A2%AB%E7%AB%8B%E6%A1%88%E5%AE%A1%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785251938000.webp","sourceId":"rfi"},{"id":1785249354000,"createdDate":"2026-07-28 14:35","name":"法国国际广播电台","title":"台大新闻研究所洪贞玲、林丽云教授谈AI与媒体：记者叙事能力难以被取代，但产业模式正被重塑","content":"大家好，生成式的AI正在为各个产业带来前所未有的典范转移，也使得传统新闻产制流程面临前所未有的挑战。本期中华世界，我们特地邀请台大新闻研究所洪贞玲与林丽云两位教授作为法广的录音间嘉宾，和法广的听友们分享她们的经验与看法。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%AD%E5%8D%8E%E4%B8%96%E7%95%8C/20260728-%E5%8F%B0%E5%A4%A7%E6%96%B0%E9%97%BB%E7%A0%94%E7%A9%B6%E6%89%80%E6%B4%AA%E8%B4%9E%E7%8E%B2-%E6%9E%97%E4%B8%BD%E4%BA%91%E6%95%99%E6%8E%88%E8%B0%88ai%E4%B8%8E%E5%AA%92%E4%BD%93-%E8%AE%B0%E8%80%85%E5%8F%99%E4%BA%8B%E8%83%BD%E5%8A%9B%E9%9A%BE%E4%BB%A5%E8%A2%AB%E5%8F%96%E4%BB%A3%EF%BC%8C%E4%BD%86%E4%BA%A7%E4%B8%9A%E6%A8%A1%E5%BC%8F%E6%AD%A3%E8%A2%AB%E9%87%8D%E5%A1%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785249354000.webp","sourceId":"rfi"},{"id":1785247288000,"createdDate":"2026-07-28 14:01","name":"法国国际广播电台","title":"加拿大华裔实习生北约军事总部涉谍案 加公安部长誓言彻查","content":"加拿大公共安全部长阿南达桑加里（GaryAnandasangaree）周一承诺，将“彻查”一名加拿大公民在欧洲因涉嫌间谍活动被捕一事。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260728-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%AE%9E%E4%B9%A0%E7%94%9F%E5%8C%97%E7%BA%A6%E5%86%9B%E4%BA%8B%E6%80%BB%E9%83%A8%E6%B6%89%E8%B0%8D%E6%A1%88-%E5%8A%A0%E5%85%AC%E5%AE%89%E9%83%A8%E9%95%BF%E8%AA%93%E8%A8%80%E5%BD%BB%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785247288000.webp","sourceId":"rfi"},{"id":1785246032000,"createdDate":"2026-07-28 13:40","name":"法国国际广播电台","title":"超快时尚“希音”2026年第一季度亏损9900万美元","content":"28日出版的法国全国性大报头版头条一致关注在法国西南吉伦特地区势头持续不减的森林大火，尤其是这场规模前所未有的大火带来的经济损失。在国际版，各报关注的话题主要有美国特朗普政府在伊朗进退两难的困局、乌克兰在里海袭击伊朗货船暗示的战争走向、叙利亚摆脱阿萨德政权后的首届议会以及其中女性代表屈指可数的局面，等等。关于中国，《回声报》和《费加罗报》都刊登文章，关注即将在香港上市的超快时尚平台“希音”目前令人失望的营业成绩。《回声报》刊登文章介绍中国“长鑫存储”首日在上海上市获得的巨大成功。《费加罗报》则聚焦美国硅谷科技巨头围绕是否应当与中国一样，在人工智能领域采取开源模式的争议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260728-%E8%B6%85%E5%BF%AB%E6%97%B6%E5%B0%9A-%E5%B8%8C%E9%9F%B3-2026%E5%B9%B4%E7%AC%AC%E4%B8%80%E5%AD%A3%E5%BA%A6%E4%BA%8F%E6%8D%9F9900%E4%B8%87%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785246032000.webp","sourceId":"rfi"},{"id":1785245363000,"createdDate":"2026-07-28 13:29","name":"法国国际广播电台","title":"德官员评估中国经济弱点为贸易战作准备 奔驰康林松：面对中国竞争德国需要生产力攻势","content":"据彭博社援引知情人士报导，德国官员正着手在幕后识别中国的经济脆弱环节；一旦欧盟与这个世界第二大经济体爆发贸易战，这些弱点便可能成为德国可利用的切入点。消息人士透露，德国政府正通过分析贸易流向、供应链及企业层面数据，非正式地梳理中国的薄弱之处。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20260728-%E5%BE%B7%E5%AE%98%E5%91%98%E8%AF%84%E4%BC%B0%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E%E5%BC%B1%E7%82%B9%E4%B8%BA%E8%B4%B8%E6%98%93%E6%88%98%E4%BD%9C%E5%87%86%E5%A4%87-%E5%A5%94%E9%A9%B0%E5%BA%B7%E6%9E%97%E6%9D%BE-%E9%9D%A2%E5%AF%B9%E4%B8%AD%E5%9B%BD%E7%AB%9E%E4%BA%89%E5%BE%B7%E5%9B%BD%E9%9C%80%E8%A6%81%E7%94%9F%E4%BA%A7%E5%8A%9B%E6%94%BB%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785245363000.webp","sourceId":"rfi"},{"id":1785244780000,"createdDate":"2026-07-28 13:19","name":"法国国际广播电台","title":"中国的人工智能会成为欧洲的福音吗？","content":"中国人工智能发展之快，引发德国媒体多方关注。《南德意志报》感叹说：人工智能在中国就像自来水一样普及。人工智能在中国早已不是未来技术，而是日常生活的一部分。它可以配送面条、辅助医疗、陪伴孩子学习，它正在迅速改变中国人的生活。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20260728-%E4%B8%AD%E5%9B%BD%E7%9A%84%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%BC%9A%E6%88%90%E4%B8%BA%E6%AC%A7%E6%B4%B2%E7%9A%84%E7%A6%8F%E9%9F%B3%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785244780000.webp","sourceId":"rfi"},{"id":1785244634000,"createdDate":"2026-07-28 13:17","name":"法国国际广播电台","title":"日本西南部发生7.1级强震","content":"据日本气象厅（JMA）表示，地震发生在西南部九州的熊本县，当地时间16点27分，格林威治时间早晨7点27分，震感强烈，在日本的地震强度等级——“震度”中达到最高的七级。强震已经造成数十人受伤、建筑物倒塌并引发火灾；不过震后发布的海啸警报现已解除。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260728-%E6%97%A5%E6%9C%AC%E8%A5%BF%E5%8D%97%E9%83%A8%E5%8F%91%E7%94%9F7-1%E7%BA%A7%E5%BC%BA%E9%9C%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785244634000.webp","sourceId":"rfi"},{"id":1785240532000,"createdDate":"2026-07-28 12:08","name":"法国国际广播电台","title":"俄副外长：俄中正商讨实施永久免签政策的前景","content":"俄罗斯外交部副部长鲁坚科在受访时表示，俄中正在商讨永久性地为两国公民建立免签旅行制度的前景。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260728-%E4%BF%84%E5%89%AF%E5%A4%96%E9%95%BF-%E4%BF%84%E4%B8%AD%E6%AD%A3%E5%95%86%E8%AE%A8%E5%AE%9E%E6%96%BD%E6%B0%B8%E4%B9%85%E5%85%8D%E7%AD%BE%E6%94%BF%E7%AD%96%E5%89%8D%E6%99%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785240532000.webp","sourceId":"rfi"},{"id":1785238282000,"createdDate":"2026-07-28 11:31","name":"法国国际广播电台","title":"金正恩携女儿金主爱高调出席停战周年活动","content":"朝鲜国家电视台KTR7月28日播出画面，展示最高领导人金正恩携女儿金主爱、夫人李雪主出席朝鲜战争停战73周年纪念活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260728-%E9%87%91%E6%AD%A3%E6%81%A9%E6%90%BA%E5%A5%B3%E5%84%BF%E9%87%91%E4%B8%BB%E7%88%B1%E9%AB%98%E8%B0%83%E5%87%BA%E5%B8%AD%E5%81%9C%E6%88%98%E5%91%A8%E5%B9%B4%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785238282000.webp","sourceId":"rfi"}]