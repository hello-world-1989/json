[{"id":1785197386000,"createdDate":"2026-07-28 00:09","name":"法国国际广播电台","title":"重庆山崩现场寻获失联客运中巴车及人体残骸","content":"重庆市彭水县17日9时左右发生大型山体崩塌事件，造成10人受伤、11人死亡、50人失联。失联人员凶多吉少。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260728-%E9%87%8D%E5%BA%86%E5%B1%B1%E5%B4%A9%E7%8E%B0%E5%9C%BA%E5%AF%BB%E8%8E%B7%E5%A4%B1%E8%81%94%E5%AE%A2%E8%BF%90%E4%B8%AD%E5%B7%B4%E8%BD%A6%E5%8F%8A%E4%BA%BA%E4%BD%93%E6%AE%8B%E9%AA%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785197386000.webp","sourceId":"rfi"},{"id":1785196886000,"createdDate":"2026-07-28 00:01","name":"法国国际广播电台","title":"是否应该封杀华为？欧洲电信运营商与欧盟委员会分歧严重","content":"法国世界报周一刊出文章表示，就是否应该全面禁止华为设备一事，欧洲电信运营商与欧盟委员会分歧严重。欧盟委员会希望将华为和中兴等中国通信设备企业逐步排除出欧洲的电信网络，理由是国家安全和网络安全。但欧洲多家电信运营商认为，这样做代价太高，可能给整个行业带来巨大损失。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260728-%E6%98%AF%E5%90%A6%E5%BA%94%E8%AF%A5%E5%B0%81%E6%9D%80%E5%8D%8E%E4%B8%BA-%E6%AC%A7%E6%B4%B2%E7%94%B5%E4%BF%A1%E8%BF%90%E8%90%A5%E5%95%86%E4%B8%8E%E6%AC%A7%E7%9B%9F%E5%A7%94%E5%91%98%E4%BC%9A%E5%88%86%E6%AD%A7%E4%B8%A5%E9%87%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/28/1785196886000.webp","sourceId":"rfi"}]