[{"id":1784972930000,"createdDate":"2026-07-25 09:48","name":"法国国际广播电台","title":"中核集团原总经理顾军等3落马官员同日被开除党籍","content":"中央纪委国家监委网站周日（25日）在同一时间公布了中核集团原党组副书记、总经理顾军，海南省人大常委会原党组成员、副主任肖杰，以及华润集团原党委委员、副总经理韩嵩因严重违纪违法被开除中共党籍；韩嵩也被开除公职。三人皆被指丧失理想信念，违反或无视中央八项规定精神，利用职权为他人谋利并收受巨额财物等。此前，三人已在今年年初被相继官宣接受纪律审查和监察调查。其中，韩嵩主动投案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E4%B8%AD%E6%A0%B8%E9%9B%86%E5%9B%A2%E5%8E%9F%E6%80%BB%E7%BB%8F%E7%90%86%E9%A1%BE%E5%86%9B%E7%AD%893%E8%90%BD%E9%A9%AC%E5%AE%98%E5%91%98%E5%90%8C%E6%97%A5%E8%A2%AB%E5%BC%80%E9%99%A4%E5%85%9A%E7%B1%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784972930000.webp","sourceId":"rfi"},{"id":1784971472000,"createdDate":"2026-07-25 09:24","name":"法国国际广播电台","title":"被罚没51.79亿元 携程：诚恳接受、坚决服从 公布十九项整改措施","content":"中国国家市场监督管理总局周日（25日）通报，依据《中华人民共和国反垄断法》相关规定，对携程集团有限公司滥用市场支配地位实施垄断行为作出行政处罚，没收违法所得16.58亿元，并处以罚款35.21亿元，罚没款合计51.79亿元。同时，责令其全额退还强制扣除酒店经营者的订单储备金1.22亿元，要求企业全面整改并公开整改措施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E8%A2%AB%E7%BD%9A%E6%B2%A151-79%E4%BA%BF%E5%85%83-%E6%90%BA%E7%A8%8B-%E8%AF%9A%E6%81%B3%E6%8E%A5%E5%8F%97-%E5%9D%9A%E5%86%B3%E6%9C%8D%E4%BB%8E-%E5%85%AC%E5%B8%83%E5%8D%81%E4%B9%9D%E9%A1%B9%E6%95%B4%E6%94%B9%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784971472000.webp","sourceId":"rfi"},{"id":1784968611000,"createdDate":"2026-07-25 08:36","name":"法国国际广播电台","title":"中俄外长会谈 表示“绝不允许日本重新武装”","content":"中共中央政治局委员、外交部长王毅24日在吉尔吉斯斯坦出席上海合作组织外长会期间会见俄罗斯外长拉夫罗夫。在会谈中，双方一致表示：绝不允许日本重新武装。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E4%B8%AD%E4%BF%84%E5%A4%96%E9%95%BF%E4%BC%9A%E8%B0%88-%E8%A1%A8%E7%A4%BA-%E7%BB%9D%E4%B8%8D%E5%85%81%E8%AE%B8%E6%97%A5%E6%9C%AC%E9%87%8D%E6%96%B0%E6%AD%A6%E8%A3%85","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784968611000.webp","sourceId":"rfi"},{"id":1784968453000,"createdDate":"2026-07-25 08:34","name":"法国国际广播电台","title":"美国301新关税机制上路 台湾相较日、韩、中等国有2.5％差距的优势","content":"美国24日起将依贸易法301条款对60个贸易伙伴课征新的10%与12.5%关税。台湾适用于较低的10％，相较起日、韩、中等国有2.5%%的差距。学者表示，对全球供应链来说，很可能是未来几年订单重新分配的重要依据。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E7%BE%8E%E5%9B%BD301%E6%96%B0%E5%85%B3%E7%A8%8E%E6%9C%BA%E5%88%B6%E4%B8%8A%E8%B7%AF-%E5%8F%B0%E6%B9%BE%E7%9B%B8%E8%BE%83%E6%97%A5-%E9%9F%A9-%E4%B8%AD%E7%AD%89%E5%9B%BD%E6%9C%892-5%EF%BC%85%E5%B7%AE%E8%B7%9D%E7%9A%84%E4%BC%98%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784968453000.webp","sourceId":"rfi"},{"id":1784966439000,"createdDate":"2026-07-25 08:00","name":"法国国际广播电台","title":"曾在北约司令部实习的加拿大华裔女子 涉间谍活动在比利时被捕","content":"法新社布鲁塞尔消息，比利时联邦检察院周六（7月25日）宣布，一名在北约实习的华裔加拿大籍女子因涉嫌“为第三国从事间谍活动”，于周四被比利时联邦司法警察逮捕。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E6%9B%BE%E5%9C%A8%E5%8C%97%E7%BA%A6%E5%AE%9E%E4%B9%A0%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%A5%B3%E5%AD%90-%E6%B6%89%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E5%9C%A8%E6%AF%94%E5%88%A9%E6%97%B6%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784966439000.webp","sourceId":"rfi"},{"id":1784965075000,"createdDate":"2026-07-25 07:37","name":"法国国际广播电台","title":"中国公安部长与FBI局长北京会晤：承诺加强执法合作","content":"路透社北京消息称，中国公安部长和美国联邦调查局局长周五（7月24日）在北京会晤后，北京方面表示，双方同意深化两国在执法领域的合作。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%AE%89%E9%83%A8%E9%95%BF%E4%B8%8Efbi%E5%B1%80%E9%95%BF%E5%8C%97%E4%BA%AC%E4%BC%9A%E6%99%A4-%E6%89%BF%E8%AF%BA%E5%8A%A0%E5%BC%BA%E6%89%A7%E6%B3%95%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784965075000.webp","sourceId":"rfi"},{"id":1784964306000,"createdDate":"2026-07-25 07:25","name":"法国国际广播电台","title":"泽连斯基称将在美国建无人机工厂  白宫官员透露可能于下周二访美会见特朗普","content":"据路透社周六（7月25日）消息，乌克兰总统泽连斯基在周五播出的采访中表示，基辅与华盛顿在无人机领域的合作将包括在美国建厂，利用乌克兰的先进技术来生产无人机。此外，泽连斯基或将于下周二访美会见特朗普。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%A7%B0%E5%B0%86%E5%9C%A8%E7%BE%8E%E5%9B%BD%E5%BB%BA%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%B7%A5%E5%8E%82-%E7%99%BD%E5%AE%AB%E5%AE%98%E5%91%98%E9%80%8F%E9%9C%B2%E5%8F%AF%E8%83%BD%E4%BA%8E%E4%B8%8B%E5%91%A8%E4%BA%8C%E8%AE%BF%E7%BE%8E%E4%BC%9A%E8%A7%81%E7%89%B9%E6%9C%97%E6%99%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784964306000.webp","sourceId":"rfi"},{"id":1784997550000,"createdDate":"2026-07-25 16:39","name":"法国国际广播电台","title":"“火烧眉毛”    法首次调用A400M军用运输机参与灭火","content":"法国西南部吉伦特和朗德省的火势毫无减弱的趋势，虽然25日气温降低、也可能会降雨，但省政府在撤离了16万7000居民的前提下，为了保险起见让波尔多市7个卫星城居民夜间撤离。在动员了上千名军人增援后，法国25日下午第一次调用军用运输机A400M参与吉伦特省的灭火行动。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260725-%E7%81%AB%E7%83%A7%E7%9C%89%E6%AF%9B-%E6%B3%95%E9%A6%96%E6%AC%A1%E8%B0%83%E7%94%A8a400m%E5%86%9B%E7%94%A8%E8%BF%90%E8%BE%93%E6%9C%BA%E5%8F%82%E4%B8%8E%E7%81%AD%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784997550000.webp","sourceId":"rfi"},{"id":1784993820000,"createdDate":"2026-07-25 15:37","name":"法国国际广播电台","title":"托卡耶夫当面告知普京：俄乌并非内战而是国家间冲突 指是时候冻结冲突","content":"周六，乌克兰无人机袭击了西伯利亚的一家炼油厂，并导致乌拉尔地区的一场田径比赛中断；同日，在西伯利亚城市鄂木斯克举行的一场论坛上，哈萨克斯坦总统托卡耶夫当面告知俄罗斯总统普京，现在是冻结俄乌当前冲突的时候了。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260725-%E6%89%98%E5%8D%A1%E8%80%B6%E5%A4%AB%E5%BD%93%E9%9D%A2%E5%91%8A%E7%9F%A5%E6%99%AE%E4%BA%AC-%E4%BF%84%E4%B9%8C%E5%B9%B6%E9%9D%9E%E5%86%85%E6%88%98%E8%80%8C%E6%98%AF%E5%9B%BD%E5%AE%B6%E9%97%B4%E5%86%B2%E7%AA%81-%E6%8C%87%E6%98%AF%E6%97%B6%E5%80%99%E5%86%BB%E7%BB%93%E5%86%B2%E7%AA%81","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784993820000.webp","sourceId":"rfi"},{"id":1784991264000,"createdDate":"2026-07-25 14:54","name":"法国国际广播电台","title":"北京着手监管个人海外财富 中国将对离岸信托征税","content":"中国财政部、国家税务总局周五（24日）发布《关于离岸信托个人所得税有关事项的公告》（以下简称《公告》），明确了离岸信托设立、存续、终止清算等环节的征税规定。此举标志着中国将正式开始对本国公民设立的离岸信托征税，从而堵住一个长期以来被富裕家庭用于资产保护和传承规划的漏洞。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E5%8C%97%E4%BA%AC%E7%9D%80%E6%89%8B%E7%9B%91%E7%AE%A1%E6%B5%B7%E5%A4%96%E8%B4%A2%E5%AF%8C-%E4%B8%AD%E5%9B%BD%E5%B0%86%E5%AF%B9%E7%A6%BB%E5%B2%B8%E4%BF%A1%E6%89%98%E5%BE%81%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784991264000.webp","sourceId":"rfi"},{"id":1784986619000,"createdDate":"2026-07-25 13:36","name":"法国国际广播电台","title":"中国外卖员王计兵诗集获中国最高文学奖 从蓝领工人文学作品一窥中国庞大零工经济景况","content":"中国外卖员王计兵的诗集《低处飞行》15日获得鲁迅文学奖，其作品是他在送餐间隙写在小纸片上的诗词。喜爱阅读的他，过去十年来不断在社媒上发表诗歌和散文，并逐渐受到关注。许多网友称他的诗歌让人看到了中国社会底层人的挣扎、蓝领工人的辛苦。王计兵的获奖其实也反映了中国当今「新大众文艺」的热潮。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20260725-%E4%B8%AD%E5%9B%BD%E5%A4%96%E5%8D%96%E5%91%98%E7%8E%8B%E8%AE%A1%E5%85%B5%E8%AF%97%E9%9B%86%E8%8E%B7%E4%B8%AD%E5%9B%BD%E6%9C%80%E9%AB%98%E6%96%87%E5%AD%A6%E5%A5%96-%E4%BB%8E%E8%93%9D%E9%A2%86%E5%B7%A5%E4%BA%BA%E6%96%87%E5%AD%A6%E4%BD%9C%E5%93%81%E4%B8%80%E7%AA%A5%E4%B8%AD%E5%9B%BD%E5%BA%9E%E5%A4%A7%E9%9B%B6%E5%B7%A5%E7%BB%8F%E6%B5%8E%E6%99%AF%E5%86%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784986619000.webp","sourceId":"rfi"},{"id":1784980487000,"createdDate":"2026-07-25 11:54","name":"法国国际广播电台","title":"《科学》指中国一6岁女童接受基因编辑试验后死亡 涉事医学院：在调查中","content":"据《科学》杂志和“撤稿观察”（RetractionWatch）网站联合开展的一项调查显示，一名六岁中国女童去年在接受一项旨在矫正非致命性病症的试验性基因疗法后不幸去世。“撤稿观察”是一个报道科学论文撤稿及相关议题的网站。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E7%A7%91%E5%AD%A6-%E6%8C%87%E4%B8%AD%E5%9B%BD%E4%B8%806%E5%B2%81%E5%A5%B3%E7%AB%A5%E6%8E%A5%E5%8F%97%E5%9F%BA%E5%9B%A0%E7%BC%96%E8%BE%91%E8%AF%95%E9%AA%8C%E5%90%8E%E6%AD%BB%E4%BA%A1-%E6%B6%89%E4%BA%8B%E5%8C%BB%E5%AD%A6%E9%99%A2-%E5%9C%A8%E8%B0%83%E6%9F%A5%E4%B8%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784980487000.webp","sourceId":"rfi"},{"id":1784976732000,"createdDate":"2026-07-25 10:52","name":"法国国际广播电台","title":"丁薛祥坐镇 中国AI芯片攻坚全面启动，中美科技战白热化 可还有合作空间？","content":"据《华尔街日报》披露的一份内部文件显示，中共中央政治局常委、国务院副总理丁薛祥亲自组建了一个高规格委员会，在AI芯片的多个关键领域部署顶尖攻坚团队，试图在与美国的科技竞赛中实现弯道超车。这一消息揭示了中国在AI领域的战略部署已上升至国家最高层，也标志着中美科技竞争进入一个新的、更加激烈的阶段。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260725-%E4%B8%81%E8%96%9B%E7%A5%A5%E5%9D%90%E9%95%87-%E4%B8%AD%E5%9B%BDai%E8%8A%AF%E7%89%87%E6%94%BB%E5%9D%9A%E5%85%A8%E9%9D%A2%E5%90%AF%E5%8A%A8%EF%BC%8C%E4%B8%AD%E7%BE%8E%E7%A7%91%E6%8A%80%E6%88%98%E7%99%BD%E7%83%AD%E5%8C%96-%E5%8F%AF%E8%BF%98%E6%9C%89%E5%90%88%E4%BD%9C%E7%A9%BA%E9%97%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784976732000.webp","sourceId":"rfi"},{"id":1784976293000,"createdDate":"2026-07-25 10:44","name":"法国国际广播电台","title":"着眼三菱重工 乌高官呼吁日本支持“爱国者”拦截导弹的授权生产","content":"乌克兰总统办公室第一副主任基斯利察（SergiyKyslytsya）周五表示，乌方希望获得日本的支持，以便在美国许可下生产“爱国者”防空系统；此举着眼于三菱重工拥有的专业技术，该公司负责为日本自卫队生产“爱国者”拦截导弹。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260725-%E7%9D%80%E7%9C%BC%E4%B8%89%E8%8F%B1%E9%87%8D%E5%B7%A5-%E4%B9%8C%E9%AB%98%E5%AE%98%E5%91%BC%E5%90%81%E6%97%A5%E6%9C%AC%E6%94%AF%E6%8C%81-%E7%88%B1%E5%9B%BD%E8%80%85-%E6%8B%A6%E6%88%AA%E5%AF%BC%E5%BC%B9%E7%9A%84%E6%8E%88%E6%9D%83%E7%94%9F%E4%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784976293000.webp","sourceId":"rfi"},{"id":1784974930000,"createdDate":"2026-07-25 10:22","name":"法国国际广播电台","title":"澳防长：中国既是我们最大贸易伙伴，也是我们最大安全焦虑","content":"澳大利亚副总理兼国防部长马尔斯（RichardMarles）周六在出席党内活动时将中国形容为澳大利亚“最大的安全焦虑”来源，同时也主张尽管存在持续的战略紧张局势，澳方仍必须继续与北京保持接触。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260725-%E6%BE%B3%E9%98%B2%E9%95%BF-%E4%B8%AD%E5%9B%BD%E6%97%A2%E6%98%AF%E6%88%91%E4%BB%AC%E6%9C%80%E5%A4%A7%E8%B4%B8%E6%98%93%E4%BC%99%E4%BC%B4%EF%BC%8C%E4%B9%9F%E6%98%AF%E6%88%91%E4%BB%AC%E6%9C%80%E5%A4%A7%E5%AE%89%E5%85%A8%E7%84%A6%E8%99%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784974930000.webp","sourceId":"rfi"}]