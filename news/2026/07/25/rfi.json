[{"id":1784972930000,"createdDate":"2026-07-25 09:48","name":"法国国际广播电台","title":"中核集团原总经理顾军等3落马官员同日被开除党籍","content":"中央纪委国家监委网站周日（25日）在同一时间公布了中核集团原党组副书记、总经理顾军，海南省人大常委会原党组成员、副主任肖杰，以及华润集团原党委委员、副总经理韩嵩因严重违纪违法被开除中共党籍；韩嵩也被开除公职。三人皆被指丧失理想信念，违反或无视中央八项规定精神，利用职权为他人谋利并收受巨额财物等。此前，三人已在今年年初被相继官宣接受纪律审查和监察调查。其中，韩嵩主动投案。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E4%B8%AD%E6%A0%B8%E9%9B%86%E5%9B%A2%E5%8E%9F%E6%80%BB%E7%BB%8F%E7%90%86%E9%A1%BE%E5%86%9B%E7%AD%893%E8%90%BD%E9%A9%AC%E5%AE%98%E5%91%98%E5%90%8C%E6%97%A5%E8%A2%AB%E5%BC%80%E9%99%A4%E5%85%9A%E7%B1%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784972930000.webp","sourceId":"rfi"},{"id":1784971472000,"createdDate":"2026-07-25 09:24","name":"法国国际广播电台","title":"被罚没51.79亿元 携程：诚恳接受、坚决服从 公布十九项整改措施","content":"中国国家市场监督管理总局周日（25日）通报，依据《中华人民共和国反垄断法》相关规定，对携程集团有限公司滥用市场支配地位实施垄断行为作出行政处罚，没收违法所得16.58亿元，并处以罚款35.21亿元，罚没款合计51.79亿元。同时，责令其全额退还强制扣除酒店经营者的订单储备金1.22亿元，要求企业全面整改并公开整改措施。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E8%A2%AB%E7%BD%9A%E6%B2%A151-79%E4%BA%BF%E5%85%83-%E6%90%BA%E7%A8%8B-%E8%AF%9A%E6%81%B3%E6%8E%A5%E5%8F%97-%E5%9D%9A%E5%86%B3%E6%9C%8D%E4%BB%8E-%E5%85%AC%E5%B8%83%E5%8D%81%E4%B9%9D%E9%A1%B9%E6%95%B4%E6%94%B9%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784971472000.webp","sourceId":"rfi"},{"id":1784968611000,"createdDate":"2026-07-25 08:36","name":"法国国际广播电台","title":"中俄外长会谈 表示“绝不允许日本重新武装”","content":"中共中央政治局委员、外交部长王毅24日在吉尔吉斯斯坦出席上海合作组织外长会期间会见俄罗斯外长拉夫罗夫。在会谈中，双方一致表示：绝不允许日本重新武装。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E4%B8%AD%E4%BF%84%E5%A4%96%E9%95%BF%E4%BC%9A%E8%B0%88-%E8%A1%A8%E7%A4%BA-%E7%BB%9D%E4%B8%8D%E5%85%81%E8%AE%B8%E6%97%A5%E6%9C%AC%E9%87%8D%E6%96%B0%E6%AD%A6%E8%A3%85","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784968611000.webp","sourceId":"rfi"},{"id":1784968453000,"createdDate":"2026-07-25 08:34","name":"法国国际广播电台","title":"美国301新关税机制上路 台湾相较日、韩、中等国有2.5％差距的优势","content":"美国24日起将依贸易法301条款对60个贸易伙伴课征新的10%与12.5%关税。台湾适用于较低的10％，相较起日、韩、中等国有2.5%%的差距。学者表示，对全球供应链来说，很可能是未来几年订单重新分配的重要依据。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E7%BE%8E%E5%9B%BD301%E6%96%B0%E5%85%B3%E7%A8%8E%E6%9C%BA%E5%88%B6%E4%B8%8A%E8%B7%AF-%E5%8F%B0%E6%B9%BE%E7%9B%B8%E8%BE%83%E6%97%A5-%E9%9F%A9-%E4%B8%AD%E7%AD%89%E5%9B%BD%E6%9C%892-5%EF%BC%85%E5%B7%AE%E8%B7%9D%E7%9A%84%E4%BC%98%E5%8A%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784968453000.webp","sourceId":"rfi"},{"id":1784966439000,"createdDate":"2026-07-25 08:00","name":"法国国际广播电台","title":"曾在北约司令部实习的加拿大华裔女子 涉间谍活动在比利时被捕","content":"法新社布鲁塞尔消息，比利时联邦检察院周六（7月25日）宣布，一名在北约实习的华裔加拿大籍女子因涉嫌“为第三国从事间谍活动”，于周四被比利时联邦司法警察逮捕。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E6%9B%BE%E5%9C%A8%E5%8C%97%E7%BA%A6%E5%AE%9E%E4%B9%A0%E7%9A%84%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%A5%B3%E5%AD%90-%E6%B6%89%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E5%9C%A8%E6%AF%94%E5%88%A9%E6%97%B6%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784966439000.webp","sourceId":"rfi"},{"id":1784965075000,"createdDate":"2026-07-25 07:37","name":"法国国际广播电台","title":"中国公安部长与FBI局长北京会晤：承诺加强执法合作","content":"路透社北京消息称，中国公安部长和美国联邦调查局局长周五（7月24日）在北京会晤后，北京方面表示，双方同意深化两国在执法领域的合作。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260725-%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%AE%89%E9%83%A8%E9%95%BF%E4%B8%8Efbi%E5%B1%80%E9%95%BF%E5%8C%97%E4%BA%AC%E4%BC%9A%E6%99%A4-%E6%89%BF%E8%AF%BA%E5%8A%A0%E5%BC%BA%E6%89%A7%E6%B3%95%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784965075000.webp","sourceId":"rfi"},{"id":1784964306000,"createdDate":"2026-07-25 07:25","name":"法国国际广播电台","title":"泽连斯基称将在美国建无人机工厂  白宫官员透露可能于下周二访美会见特朗普","content":"据路透社周六（7月25日）消息，乌克兰总统泽连斯基在周五播出的采访中表示，基辅与华盛顿在无人机领域的合作将包括在美国建厂，利用乌克兰的先进技术来生产无人机。此外，泽连斯基或将于下周二访美会见特朗普。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260725-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E7%A7%B0%E5%B0%86%E5%9C%A8%E7%BE%8E%E5%9B%BD%E5%BB%BA%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%B7%A5%E5%8E%82-%E7%99%BD%E5%AE%AB%E5%AE%98%E5%91%98%E9%80%8F%E9%9C%B2%E5%8F%AF%E8%83%BD%E4%BA%8E%E4%B8%8B%E5%91%A8%E4%BA%8C%E8%AE%BF%E7%BE%8E%E4%BC%9A%E8%A7%81%E7%89%B9%E6%9C%97%E6%99%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/07/25/1784964306000.webp","sourceId":"rfi"}]