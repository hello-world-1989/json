[{"id":1785402204000,"createdDate":"2026-07-30 09:03","name":"法国国际广播电台","title":"中国警告美国若坚持实施机器人进口限制将“坚决予以反制”","content":"针对美国周二（7月28日）宣布一项针对中国先进人形机器人和电力逆变器进口限制措施，中国商务部周四回应称，如果美国坚持单方面实施相关进口禁令，中国将坚决予以反制，维护自身利益。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260730-%E4%B8%AD%E5%9B%BD%E8%AD%A6%E5%91%8A%E8%8B%A5%E7%BE%8E%E5%9B%BD%E5%9D%9A%E6%8C%81%E5%AE%9E%E6%96%BD%E6%9C%BA%E5%99%A8%E4%BA%BA%E8%BF%9B%E5%8F%A3%E9%99%90%E5%88%B6%E5%B0%86-%E5%9D%9A%E5%86%B3%E5%8F%8D%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785402204000.webp","sourceId":"rfi"},{"id":1785396191000,"createdDate":"2026-07-30 07:23","name":"法国国际广播电台","title":"日本熊本大地震遇难人数上升至30人","content":"有关在日本熊本县发生的7.1级强烈地震，日本首相高市早苗在日本时间7月30日下午宣布，在此次熊本地震中，包括目前仍在调查是否与灾害有关的死亡案例在内，死亡人数已增至30人。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260730-%E6%97%A5%E6%9C%AC%E7%86%8A%E6%9C%AC%E5%A4%A7%E5%9C%B0%E9%9C%87%E9%81%87%E9%9A%BE%E4%BA%BA%E6%95%B0%E4%B8%8A%E5%8D%87%E8%87%B330%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785396191000.webp","sourceId":"rfi"},{"id":1785395737000,"createdDate":"2026-07-30 07:15","name":"法国国际广播电台","title":"罗奇再谈香港“玩完”　称旧香港国际金融中心时代正式终结","content":"摩根士丹利亚洲区前主席丶现任美国耶鲁大学高级研究员罗奇（StephenRoach），早前发文指《HongKongisOver》(《香港玩完》)，引发巨大回响；他其后一度因应香港股市回升而修正其说法，但近日再度撰文补充，指香港现时展现的经济成果和城市韧性，是一个「中国制造」的新香港故事，并形容「旧香港已正式终结」，更以普通话拼音「Xianggang」作为香港的英文名称。其言论再次引起讨论，港府财金高层更撰文反驳，批评其观点是基于对中国的偏见而成，并非客观事实。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260730-%E7%BD%97%E5%A5%87%E5%86%8D%E8%B0%88%E9%A6%99%E6%B8%AF-%E7%8E%A9%E5%AE%8C-%E7%A7%B0%E6%97%A7%E9%A6%99%E6%B8%AF%E5%9B%BD%E9%99%85%E9%87%91%E8%9E%8D%E4%B8%AD%E5%BF%83%E6%97%B6%E4%BB%A3%E6%AD%A3%E5%BC%8F%E7%BB%88%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785395737000.webp","sourceId":"rfi"},{"id":1785395191000,"createdDate":"2026-07-30 07:06","name":"法国国际广播电台","title":"现身立法会受冲击现场被指暴动囚57个月　学生会前会长孙晓岚刑满获释","content":"香港大学前学生会会长孙晓岚，因在2019年7月1日立法会，被拍摄到现身遭示威者占据的立法会会议厅内，并曾拉下口罩与人交谈，虽然没有使用暴力，仍被裁定暴动罪成，判囚4年9个月。她昨(29日)晨刑满获释，十多名亲友到屏狱外迎接，孙晓岚与父亲及友人相拥而泣，她对能重获自由表示感恩，亦感谢各界一直以来的关心。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260730-%E7%8E%B0%E8%BA%AB%E7%AB%8B%E6%B3%95%E4%BC%9A%E5%8F%97%E5%86%B2%E5%87%BB%E7%8E%B0%E5%9C%BA%E8%A2%AB%E6%8C%87%E6%9A%B4%E5%8A%A8%E5%9B%9A57%E4%B8%AA%E6%9C%88-%E5%AD%A6%E7%94%9F%E4%BC%9A%E5%89%8D%E4%BC%9A%E9%95%BF%E5%AD%99%E6%99%93%E5%B2%9A%E5%88%91%E6%BB%A1%E8%8E%B7%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785395191000.webp","sourceId":"rfi"},{"id":1785432466000,"createdDate":"2026-07-30 17:27","name":"法国国际广播电台","title":"法国西班牙大火有望平息 希腊克里特岛火灾8000人撤离","content":"法国、西班牙预料山火暂息，而欧洲其他地区又爆发新火情，其中希腊南部克里特岛火情严重。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E6%B3%95%E5%9B%BD%E8%A5%BF%E7%8F%AD%E7%89%99%E5%A4%A7%E7%81%AB%E6%9C%89%E6%9C%9B%E5%B9%B3%E6%81%AF-%E5%B8%8C%E8%85%8A%E5%85%8B%E9%87%8C%E7%89%B9%E5%B2%9B%E7%81%AB%E7%81%BE8000%E4%BA%BA%E6%92%A4%E7%A6%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785432466000.webp","sourceId":"rfi"},{"id":1785430982000,"createdDate":"2026-07-30 17:03","name":"法国国际广播电台","title":"路透：中国共产党将于10月召开内部治理会议（五中全会）","content":"据路透社7月30日北京电：官方新华社周四援引政治局会议消息称，执政的中国共产党将于10月在北京召开中央全会，讨论党的自我治理问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260730-%E8%B7%AF%E9%80%8F-%E4%B8%AD%E5%9B%BD%E5%85%B1%E4%BA%A7%E5%85%9A%E5%B0%86%E4%BA%8E10%E6%9C%88%E5%8F%AC%E5%BC%80%E5%86%85%E9%83%A8%E6%B2%BB%E7%90%86%E4%BC%9A%E8%AE%AE-%E4%BA%94%E4%B8%AD%E5%85%A8%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785430982000.webp","sourceId":"rfi"},{"id":1785428958000,"createdDate":"2026-07-30 16:29","name":"法国国际广播电台","title":"新西兰外长呛中国出生议员“滚回你的国家”中国驻该国大使抗议","content":"新西兰外长温斯顿·彼得斯（WinstonPeters）周四在议会有关新冠疫情的辩论中，对一名出生在中国的议员说“滚回你自己的国家”等言论，中国驻新西兰大使提出抗议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E6%96%B0%E8%A5%BF%E5%85%B0%E5%A4%96%E9%95%BF%E5%91%9B%E4%B8%AD%E5%9B%BD%E5%87%BA%E7%94%9F%E8%AE%AE%E5%91%98-%E6%BB%9A%E5%9B%9E%E4%BD%A0%E7%9A%84%E5%9B%BD%E5%AE%B6-%E4%B8%AD%E5%9B%BD%E9%A9%BB%E8%AF%A5%E5%9B%BD%E5%A4%A7%E4%BD%BF%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785428958000.webp","sourceId":"rfi"},{"id":1785425686000,"createdDate":"2026-07-30 15:34","name":"法国国际广播电台","title":"赞比亚系列报道之六 ：一个被屏蔽的故事 --中资企业强占岛屿暴力驱赶渔民","content":"位于赞比亚与津巴布韦边境的卡里巴湖（Kariba）是世界上水量最大的人工湖，这里景色秀丽，气候宜人，湖中的岛屿上生活着数百名渔民极其家人，然而，几年前这些渔民家庭的命运却发生了翻天覆地的变化，其中原因与一家中资养鱼公司有关。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20260730-%E8%B5%9E%E6%AF%94%E4%BA%9A%E7%B3%BB%E5%88%97%E6%8A%A5%E9%81%93%E4%B9%8B%E5%85%AD-%E4%B8%80%E4%B8%AA%E8%A2%AB%E5%B1%8F%E8%94%BD%E7%9A%84%E6%95%85%E4%BA%8B-%E4%B8%AD%E8%B5%84%E4%BC%81%E4%B8%9A%E5%BC%BA%E5%8D%A0%E5%B2%9B%E5%B1%BF%E6%9A%B4%E5%8A%9B%E9%A9%B1%E8%B5%B6%E6%B8%94%E6%B0%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785425686000.webp","sourceId":"rfi"},{"id":1785421707000,"createdDate":"2026-07-30 14:28","name":"法国国际广播电台","title":"乌克兰无人机再袭俄罗斯某电商巨头仓库","content":"俄罗斯电商巨头野莓（Wildberries）表示两周以来持续成为乌克兰袭击目标。其两座仓库，在周四凌晨再遭乌方无人机袭击。当地政府和该公司均证实了这一消息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%97%A0%E4%BA%BA%E6%9C%BA%E5%86%8D%E8%A2%AD%E4%BF%84%E7%BD%97%E6%96%AF%E6%9F%90%E7%94%B5%E5%95%86%E5%B7%A8%E5%A4%B4%E4%BB%93%E5%BA%93","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785421707000.webp","sourceId":"rfi"},{"id":1785421133000,"createdDate":"2026-07-30 14:18","name":"法国国际广播电台","title":"俄罗斯空袭乌克兰8人遇难 波兰境内发生爆炸出现弹坑","content":"法新社30日基辅消息，乌克兰经历又一个轰炸之夜，共有8人遇难，包括一家6口。周四，总统泽连斯基再次敦促盟友提供反导弹系统。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A9%BA%E8%A2%AD%E4%B9%8C%E5%85%8B%E5%85%B08%E4%BA%BA%E9%81%87%E9%9A%BE-%E6%B3%A2%E5%85%B0%E5%A2%83%E5%86%85%E5%8F%91%E7%94%9F%E7%88%86%E7%82%B8%E5%87%BA%E7%8E%B0%E5%BC%B9%E5%9D%91","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785421133000.webp","sourceId":"rfi"},{"id":1785420491000,"createdDate":"2026-07-30 14:08","name":"法国国际广播电台","title":"美国制裁运送伊朗石油“影子船队”中港6公司背景被美财政部网站贴出","content":"周三，美国对一批中港航运公司实施了制裁，指控其运营的船只曾将伊朗石油运往中国，此举显示美国要切断德黑兰革命卫队打仗的经济来源。美国财政部列出这8个公司情况如下：","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E8%BF%90%E9%80%81%E4%BC%8A%E6%9C%97%E7%9F%B3%E6%B2%B9-%E5%BD%B1%E5%AD%90%E8%88%B9%E9%98%9F-%E4%B8%AD%E6%B8%AF6%E5%85%AC%E5%8F%B8%E8%83%8C%E6%99%AF%E8%A2%AB%E7%BE%8E%E8%B4%A2%E6%94%BF%E9%83%A8%E7%BD%91%E7%AB%99%E8%B4%B4%E5%87%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785420491000.webp","sourceId":"rfi"},{"id":1785416567000,"createdDate":"2026-07-30 13:02","name":"法国国际广播电台","title":"“越限制中国，它就越会寻求解决方案”？","content":"7月30日（周四）法国几份全国性发行大报头版聚焦几个重点：肆虐了几天的林火基本得到控制之际对气候暖化导致的酷暑及火灾的思考；俄乌战场局势风向正在朝乌克兰有利的方向转变；法国大选前的各党派幕后运作以及被法国内政部下令驱逐的前『今日俄罗斯』电视台法国分部负责人克塞尼亚·费多罗娃（XeniaFedorova）等事件......","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260730-%E8%B6%8A%E9%99%90%E5%88%B6%E4%B8%AD%E5%9B%BD%EF%BC%8C%E5%AE%83%E5%B0%B1%E8%B6%8A%E4%BC%9A%E5%AF%BB%E6%B1%82%E8%A7%A3%E5%86%B3%E6%96%B9%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785416567000.webp","sourceId":"rfi"},{"id":1785415917000,"createdDate":"2026-07-30 12:51","name":"法国国际广播电台","title":"中东战火重燃  东盟蒙受影响","content":"由于美国、以色列和伊朗之间维持停火协议的努力告吹，中东地区战火重燃，更多国家卷入这场战争，可能使中东冲突进一步升级，从而给动荡的世界增添更多不确定性，包括能源进口高度依赖中东的东南亚地区，无论经济稳定、能源安全乃至民生福祉都蒙上了一层阴影。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20260730-%E4%B8%AD%E4%B8%9C%E6%88%98%E7%81%AB%E9%87%8D%E7%87%83-%E4%B8%9C%E7%9B%9F%E8%92%99%E5%8F%97%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785415917000.webp","sourceId":"rfi"},{"id":1785415846000,"createdDate":"2026-07-30 12:50","name":"法国国际广播电台","title":"科威特：伊朗袭击中国公司致一人死亡","content":"科威特周四宣布，伊朗发动的一次袭击，击中了科威特北部一栋属于一家中国公司的建筑，造成一人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E7%A7%91%E5%A8%81%E7%89%B9-%E4%BC%8A%E6%9C%97%E8%A2%AD%E5%87%BB%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%8F%B8%E8%87%B4%E4%B8%80%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785415846000.webp","sourceId":"rfi"},{"id":1785411657000,"createdDate":"2026-07-30 11:40","name":"法国国际广播电台","title":"美国恢复空袭伊朗后 巴基斯坦宣布华盛顿与德黑兰正在谈判","content":"美国周四宣布对伊朗实施了一轮“猛烈”空袭，以报复伊朗对美国驻中东部队的袭击；伊朗媒体称，两个省发生爆炸，造成三人死亡。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260730-%E7%BE%8E%E5%9B%BD%E6%81%A2%E5%A4%8D%E7%A9%BA%E8%A2%AD%E4%BC%8A%E6%9C%97%E5%90%8E-%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E5%AE%A3%E5%B8%83%E5%8D%8E%E7%9B%9B%E9%A1%BF%E4%B8%8E%E5%BE%B7%E9%BB%91%E5%85%B0%E6%AD%A3%E5%9C%A8%E8%B0%88%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785411657000.webp","sourceId":"rfi"},{"id":1785407745000,"createdDate":"2026-07-30 10:35","name":"法国国际广播电台","title":"新加坡：因舔吸管被起诉 一法国留学生认罪获轻判","content":"一名法国留学生因舔吸管在新加坡面临刑事指控，周四他在新加坡的法庭上认罪获得从轻处理。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260730-%E6%96%B0%E5%8A%A0%E5%9D%A1-%E5%9B%A0%E8%88%94%E5%90%B8%E7%AE%A1%E8%A2%AB%E8%B5%B7%E8%AF%89-%E4%B8%80%E6%B3%95%E5%9B%BD%E7%95%99%E5%AD%A6%E7%94%9F%E8%AE%A4%E7%BD%AA%E8%8E%B7%E8%BD%BB%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/07/30/1785407745000.webp","sourceId":"rfi"}]