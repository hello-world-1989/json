[{"id":1785490023000,"createdDate":"2026-07-31 09:27","name":"法国国际广播电台","title":"日本战后首次成立中央集权型情报机构 中国猛批","content":"日本政府情报（信息收集与分析）工作的中枢机构——国家情报局于31日正式成立。该机构由内阁情报调查室（内调）升级改组而成。同日，由高市早苗首相担任议长的国家情报会议召开了首次会议。这是日本自第二次世界大战以后首次设立中央集权型情报机构。中国《环球时报》7月30日发表题为《日本竟在731这天成立新“特高课”，其心可诛》的社评指出：选择“731”作为“国家情报局”启动日，是日本右翼对战后国际秩序明目张胆的挑衅。当日本再次竖起情报集权的大旗，解下战后和平宪法和“专守防卫”的又一道束缚，亚洲各国和国际社会决不能沉默以对。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E6%97%A5%E6%9C%AC%E6%88%98%E5%90%8E%E9%A6%96%E6%AC%A1%E6%88%90%E7%AB%8B%E4%B8%AD%E5%A4%AE%E9%9B%86%E6%9D%83%E5%9E%8B%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84-%E4%B8%AD%E5%9B%BD%E7%8C%9B%E6%89%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785490023000.webp","sourceId":"rfi"},{"id":1785488580000,"createdDate":"2026-07-31 09:03","name":"法国国际广播电台","title":"一天内数万名非法移民涌入西班牙飞地  意大利要求暂停西班牙申根资格","content":"据西班牙内政部估计，在过去24小时内，约有近5万名移民从摩洛哥越过边境，进入西班牙飞地休达（Ceuta）。而根据警方的统计，过去几天内，非法移民达4万人。其中大部分是摩洛哥年轻人，包括一些未成年人，至少有18人遇难。据悉，西班牙首相桑切斯预计将访问该地，目前西班牙已关闭边境。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260731-%E4%B8%80%E5%A4%A9%E5%86%85%E6%95%B0%E4%B8%87%E5%90%8D%E9%9D%9E%E6%B3%95%E7%A7%BB%E6%B0%91%E6%B6%8C%E5%85%A5%E8%A5%BF%E7%8F%AD%E7%89%99%E9%A3%9E%E5%9C%B0-%E6%84%8F%E5%A4%A7%E5%88%A9%E8%A6%81%E6%B1%82%E6%9A%82%E5%81%9C%E8%A5%BF%E7%8F%AD%E7%89%99%E7%94%B3%E6%A0%B9%E8%B5%84%E6%A0%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785488580000.webp","sourceId":"rfi"},{"id":1785484539000,"createdDate":"2026-07-31 07:55","name":"法国国际广播电台","title":"香港外汇基金上半年投资收入仅1347亿 受港股表現差拖累按年跌37%","content":"用以维持港元兑美元汇率稳定的香港外汇基金，今年上半年受香港股票投资录得亏损所拖累，使整体投资收入同比下跌逾37%。当局预期，在通胀及利率忧虑持续的情况下，下半年的相关投资收益未必能够持续。但评论更忧虑，须注资发展北部都会区的外汇基金，随着流动性减少而令其资本累积能力被削。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E9%A6%99%E6%B8%AF%E5%A4%96%E6%B1%87%E5%9F%BA%E9%87%91%E4%B8%8A%E5%8D%8A%E5%B9%B4%E6%8A%95%E8%B5%84%E6%94%B6%E5%85%A5%E4%BB%851347%E4%BA%BF-%E5%8F%97%E6%B8%AF%E8%82%A1%E8%A1%A8%E7%8F%BE%E5%B7%AE%E6%8B%96%E7%B4%AF%E6%8C%89%E5%B9%B4%E8%B7%8C37","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785484539000.webp","sourceId":"rfi"},{"id":1785484229000,"createdDate":"2026-07-31 07:50","name":"法国国际广播电台","title":"23条首批被捕者之一的李盈姿 疑因服务机构受政府施压遭解雇","content":"因管理有关前支联会副主席邹幸彤脸书而成为《维护国家安全条例》(俗称23条)下首批新煽动罪被捕者之一的牙医李盈姿，疑因在7月21日元朗地铁袭击事件七周年当天重返现场追责而被便衣警员截查后，遭任职的非牟利机构解雇。李盈姿相信，机构因受压而将她解雇，但事件不会影响她继续发声，笑言被解雇后反而「无后顾之忧」，有更多时间发声。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-23%E6%9D%A1%E9%A6%96%E6%89%B9%E8%A2%AB%E6%8D%95%E8%80%85%E4%B9%8B%E4%B8%80%E7%9A%84%E6%9D%8E%E7%9B%88%E5%A7%BF-%E7%96%91%E5%9B%A0%E6%9C%8D%E5%8A%A1%E6%9C%BA%E6%9E%84%E5%8F%97%E6%94%BF%E5%BA%9C%E6%96%BD%E5%8E%8B%E9%81%AD%E8%A7%A3%E9%9B%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785484229000.webp","sourceId":"rfi"},{"id":1785537787000,"createdDate":"2026-07-31 22:43","name":"法国国际广播电台","title":"八一建军节 看将领们一个跟着一个落马","content":"今天是八一建军节，中国领导人习近平在7月31日的政治局会议上发表“高质量推进国防和军队现代化”讲话。要“如期实现建军一百年奋斗目标”!可谓雄心勃勃，要强军，要在其任内完成统一，要实现“中华民族伟大复兴”。然而，自从其开启第三任总书记任期以来，被视为军队“脊柱”的指挥系统已被打得七零八落，高级将领纷纷落马。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E5%85%AB%E4%B8%80%E5%BB%BA%E5%86%9B%E8%8A%82-%E7%9C%8B%E5%B0%86%E9%A2%86%E4%BB%AC%E4%B8%80%E4%B8%AA%E8%B7%9F%E7%9D%80%E4%B8%80%E4%B8%AA%E8%90%BD%E9%A9%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785537787000.webp","sourceId":"rfi"},{"id":1785537229000,"createdDate":"2026-07-31 22:33","name":"法国国际广播电台","title":"中国强化AI科技监管　危害国家产业安全将“禁止出境”","content":"中国周五（7月31日）公布“国务院关于出境入境管理的规定”，可能危害国家产业安全、技术安全的中国公民，可被禁止出境。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E4%B8%AD%E5%9B%BD%E5%BC%BA%E5%8C%96ai%E7%A7%91%E6%8A%80%E7%9B%91%E7%AE%A1-%E5%8D%B1%E5%AE%B3%E5%9B%BD%E5%AE%B6%E4%BA%A7%E4%B8%9A%E5%AE%89%E5%85%A8%E5%8F%AF%E7%A6%81%E6%AD%A2%E5%87%BA%E5%A2%83","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785537229000.webp","sourceId":"rfi"},{"id":1785537119000,"createdDate":"2026-07-31 22:31","name":"法国国际广播电台","title":"悄无声息地，刚果大量的铀被运到了中国","content":"法国世界报刊出长篇文章，介绍了发表在国际学术期刊《自然通讯NatureCommunications》上的一项调查研究。这一调查估计，在2000年至2024年之间的二十多年里，至少有2000吨铀离开了刚果。这些铀没有经过国际原子能机构（IAEA）的任何监管。如果全部用于制造核武器的话，这些铀足以生产约600枚核弹头。而这些铀最大的目的地，是中国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260731-%E6%82%84%E6%97%A0%E5%A3%B0%E6%81%AF%E5%9C%B0%EF%BC%8C%E5%88%9A%E6%9E%9C%E5%A4%A7%E9%87%8F%E7%9A%84%E9%93%80%E8%A2%AB%E8%BF%90%E5%88%B0%E4%BA%86%E4%B8%AD%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785537119000.webp","sourceId":"rfi"},{"id":1785534889000,"createdDate":"2026-07-31 21:54","name":"法国国际广播电台","title":"英国法院驳回阻止中国伦敦“超级使馆”诉讼 居民协会誓言继续抗争","content":"英国高等法院周五（7月31日）驳回一个居民协会针对中国在伦敦兴建大型新使馆计划提出的司法诉讼。该团体随即表示将申请上诉，继续阻止这一备受争议的项目。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E8%8B%B1%E5%9B%BD%E6%B3%95%E9%99%A2%E9%A9%B3%E5%9B%9E%E9%98%BB%E6%AD%A2%E4%B8%AD%E5%9B%BD%E4%BC%A6%E6%95%A6-%E8%B6%85%E7%BA%A7%E4%BD%BF%E9%A6%86-%E8%AF%89%E8%AE%BC-%E5%B1%85%E6%B0%91%E5%8D%8F%E4%BC%9A%E8%AA%93%E8%A8%80%E7%BB%A7%E7%BB%AD%E6%8A%97%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785534889000.webp","sourceId":"rfi"},{"id":1785534740000,"createdDate":"2026-07-31 21:52","name":"法国国际广播电台","title":"欧盟指责中国电商平台Temu阻碍反补贴调查","content":"欧盟委员会周五指责中国跨境电商平台Temu阻碍一项有关非法补贴的调查。不过，Temu坚决否认这一指控。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E6%AC%A7%E7%9B%9F%E6%8C%87%E8%B4%A3%E4%B8%AD%E5%9B%BD%E5%B9%B3%E5%8F%B0temu%E9%98%BB%E7%A2%8D%E5%8F%8D%E8%A1%A5%E8%B4%B4%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785534740000.webp","sourceId":"rfi"},{"id":1785534488000,"createdDate":"2026-07-31 21:48","name":"法国国际广播电台","title":"6万移民涌入休达震动欧盟 意大利暂停与西班牙申根自由通行","content":"约6万名移民从摩洛哥非法涌入西班牙北非飞地休达，马德里将这场大规模越境行动定性为对西班牙领土完整的“攻击”。这场危机星期五迅速波及欧盟，意大利宣布暂时中止与西班牙之间的申根自由通行安排。美国总统特朗普指责西班牙当局“助长了这场非法移民潮”。葡萄牙周五也宣布加强边境管控。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-6%E4%B8%87%E7%A7%BB%E6%B0%91%E6%B6%8C%E5%85%A5%E4%BC%91%E8%BE%BE%E9%9C%87%E5%8A%A8%E6%AC%A7%E7%9B%9F-%E6%84%8F%E5%A4%A7%E5%88%A9%E6%9A%82%E5%81%9C%E4%B8%8E%E8%A5%BF%E7%8F%AD%E7%89%99%E7%94%B3%E6%A0%B9%E8%87%AA%E7%94%B1%E9%80%9A%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785534488000.webp","sourceId":"rfi"},{"id":1785534353000,"createdDate":"2026-07-31 21:45","name":"法国国际广播电台","title":"6万移民涌入休达酿欧洲最严重移民危机之一 法国加强西班牙边境管控","content":"约6万名移民近日从摩洛哥经陆路和海路涌入西班牙北非飞地休达，引发欧洲迄今最严重的移民危机之一。法国政府周五（7月31日）宣布大幅加强法西边境管控，至周六将增派334名警察和宪兵，并出动飞机和无人机进行监视。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-6%E4%B8%87%E7%A7%BB%E6%B0%91%E6%B6%8C%E5%85%A5%E4%BC%91%E8%BE%BE%E9%85%BF%E6%AC%A7%E6%B4%B2%E6%9C%80%E4%B8%A5%E9%87%8D%E7%A7%BB%E6%B0%91%E5%8D%B1%E6%9C%BA%E4%B9%8B%E4%B8%80-%E6%B3%95%E5%9B%BD%E5%8A%A0%E5%BC%BA%E8%A5%BF%E7%8F%AD%E7%89%99%E8%BE%B9%E5%A2%83%E7%AE%A1%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785534353000.webp","sourceId":"rfi"},{"id":1785531621000,"createdDate":"2026-07-31 21:00","name":"法国国际广播电台","title":"马斯克称考虑出售特斯拉中国业务是假消息","content":"电动汽车集团特斯拉和SpaceX的首席执行官马斯克周五否认正考虑剥离特斯拉在中国的业务，从而为与太空探索公司SpaceX合并铺平道路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E9%A9%AC%E6%96%AF%E5%85%8B%E7%A7%B0%E8%80%83%E8%99%91%E5%87%BA%E5%94%AE%E7%89%B9%E6%96%AF%E6%8B%89%E4%B8%AD%E5%9B%BD%E4%B8%9A%E5%8A%A1%E6%98%AF%E5%81%87%E6%B6%88%E6%81%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785531621000.webp","sourceId":"rfi"},{"id":1785531292000,"createdDate":"2026-07-31 20:54","name":"法国国际广播电台","title":"美扩大新疆强迫劳动制裁 43家中国企业产品禁止输美","content":"美国政府周五宣布，将43家中国企业新增列入《维吾尔强迫劳动预防法》（UyghurForcedLaborPreventionAct）实体清单，涵盖铝业、食品、纺织、矿业、制药及交通建设等多个产业。美方表示，自8月3日起，相关企业生产的商品原则上禁止进入美国市场，使《维吾尔强迫劳动预防法》实体清单企业总数增至187家。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260731-%E7%BE%8E%E6%89%A9%E5%A4%A7%E6%96%B0%E7%96%86%E5%BC%BA%E8%BF%AB%E5%8A%B3%E5%8A%A8%E5%88%B6%E8%A3%81-43%E5%AE%B6%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E4%BA%A7%E5%93%81%E7%A6%81%E6%AD%A2%E8%BE%93%E7%BE%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785531292000.webp","sourceId":"rfi"},{"id":1785522758000,"createdDate":"2026-07-31 18:32","name":"法国国际广播电台","title":"法国本周末高温再次来袭  挑战出行高峰的休假者","content":"预计法国本周末将出现高温和雷暴天气，这将使在公路上开车去休假地的人们格外难熬，尤其是法国卢瓦尔河以南地区。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260731-%E6%B3%95%E5%9B%BD%E6%9C%AC%E5%91%A8%E6%9C%AB%E9%AB%98%E6%B8%A9%E5%86%8D%E6%AC%A1%E6%9D%A5%E8%A2%AD-%E6%8C%91%E6%88%98%E5%87%BA%E8%A1%8C%E9%AB%98%E5%B3%B0%E7%9A%84%E4%BC%91%E5%81%87%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785522758000.webp","sourceId":"rfi"},{"id":1785516654000,"createdDate":"2026-07-31 16:50","name":"法国国际广播电台","title":"俄罗斯电商巨头旗下仓库为何成为乌克兰袭击目标？","content":"据介绍，乌克兰这些空袭间接打击俄罗斯“数以万计的企业”及银行体系。每天处理超过2,000万笔交易的这家电商通过提供俄境内难买到的商品，协助规避西方制裁，并存储和运输“无人机零部件、导航设备及军事物资”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260731-%E4%BF%84%E7%BD%97%E6%96%AF%E7%94%B5%E5%95%86%E5%B7%A8%E5%A4%B4%E6%97%97%E4%B8%8B%E4%BB%93%E5%BA%93%E4%B8%BA%E4%BD%95%E6%88%90%E4%B8%BA%E4%B9%8C%E5%85%8B%E5%85%B0%E8%A2%AD%E5%87%BB%E7%9B%AE%E6%A0%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785516654000.webp","sourceId":"rfi"},{"id":1785514356000,"createdDate":"2026-07-31 16:12","name":"法国国际广播电台","title":"韩国央行：朝鲜经济连续第3年增长俄罗斯合作是重要动力","content":"朝鲜对俄武器出口提振了制造业，俄游客到来及交通网络完善刺激了建筑业和服务业。向俄派兵带来的“外汇”流入增加了国民收入。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260731-%E9%9F%A9%E5%9B%BD%E5%A4%AE%E8%A1%8C-%E6%9C%9D%E9%B2%9C%E7%BB%8F%E6%B5%8E%E8%BF%9E%E7%BB%AD%E7%AC%AC3%E5%B9%B4%E5%A2%9E%E9%95%BF%E4%BF%84%E7%BD%97%E6%96%AF%E5%90%88%E4%BD%9C%E6%98%AF%E9%87%8D%E8%A6%81%E5%8A%A8%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785514356000.webp","sourceId":"rfi"},{"id":1785512258000,"createdDate":"2026-07-31 15:37","name":"法国国际广播电台","title":"赞比亚大选：选民如何评论执政党 ？","content":"赞比亚将于8月13日举行总统选举，竞选活动从五月中旬起步目前已经进入高潮，那么赞比亚选民对执政将近五年来的现总统哈凯恩德·希奇莱马（HakaindeHichilema）的政绩有何评论？记者走访了赞比亚首都市中心的市场，请当地民众谈谈他们对执政党的看法。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20260731-%E8%B5%9E%E6%AF%94%E4%BA%9A%E5%A4%A7%E9%80%89-%E9%80%89%E6%B0%91%E8%AF%84%E6%89%A7%E6%94%BF%E5%85%9A%E5%8A%9F%E8%BF%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785512258000.webp","sourceId":"rfi"},{"id":1785509397000,"createdDate":"2026-07-31 14:49","name":"法国国际广播电台","title":"西班牙启动非法移民合法化：最初估50万 提申请者120万","content":"根据西班牙首相桑切斯（PedroSánchez）政府7月2日公布的数据，西班牙已收到近120万份非法移民提交的身份合法化申请。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260731-%E8%A5%BF%E7%8F%AD%E7%89%99%E9%9D%9E%E6%B3%95%E7%A7%BB%E6%B0%91%E5%90%88%E6%B3%95%E5%8C%96-%E6%9C%80%E5%88%9D%E4%BC%B050%E4%B8%87-%E6%8F%90%E7%94%B3%E8%AF%B7%E8%80%85120%E4%B8%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785509397000.webp","sourceId":"rfi"},{"id":1785507957000,"createdDate":"2026-07-31 14:25","name":"法国国际广播电台","title":"FBI突袭南加州官员及中文媒体 调查公共腐败与外国影响力","content":"美国联邦调查局（FBI）本周针对南加州圣贝纳迪诺县的民选官员和一家中文媒体公司展开一系列突击搜查，这次行动是南加州针对公共腐败和外国影响力的调查不断深入的一部分。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260731-fbi%E7%AA%81%E8%A2%AD%E5%8D%97%E5%8A%A0%E5%B7%9E%E5%AE%98%E5%91%98%E5%8F%8A%E4%B8%AD%E6%96%87%E5%AA%92%E4%BD%93-%E8%B0%83%E6%9F%A5%E5%85%AC%E5%85%B1%E8%85%90%E8%B4%A5%E4%B8%8E%E5%A4%96%E5%9B%BD%E5%BD%B1%E5%93%8D%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785507957000.webp","sourceId":"rfi"},{"id":1785504230000,"createdDate":"2026-07-31 13:23","name":"法国国际广播电台","title":"土耳其如何确立其在国防领域的关键地位","content":"从无人机到武器系统，土耳其在短短几十年内就打造了世界上最具活力的国防工业之一。这一战略优势使其能够在北约内部以及多个国际舞台上发挥更大的影响力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260731-%E5%9C%9F%E8%80%B3%E5%85%B6%E5%A6%82%E4%BD%95%E7%A1%AE%E7%AB%8B%E5%85%B6%E5%9C%A8%E5%9B%BD%E9%98%B2%E9%A2%86%E5%9F%9F%E7%9A%84%E5%85%B3%E9%94%AE%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/07/31/1785504230000.webp","sourceId":"rfi"},{"id":1785503031000,"createdDate":"2026-07-31 13:03","name":