[{"id":1785284098000,"createdDate":"2026-07-29 00:14","name":"法国国际广播电台","title":"特朗普政府加快遣返寻求庇护者","content":"特朗普政府有关庇护申请的新规，会让多达44万4千724人的案子可能受到影响。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260729-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%8A%A0%E5%BF%AB%E9%81%A3%E8%BF%94%E5%AF%BB%E6%B1%82%E5%BA%87%E6%8A%A4%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785284098000.webp","sourceId":"rfi"},{"id":1785283597000,"createdDate":"2026-07-29 00:06","name":"法国国际广播电台","title":"长鑫存储借助AI热潮，完成亚洲最大规模融资，成为中国最高市值公司","content":"法国世界报周二表示，近年来，人工智能快速发展，全球AI企业对存储芯片的需求快速增长。芯片企业也因此迎来新的增长机会。中国是全球第二大AI市场，仅次于美国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260729-%E4%B8%AD%E5%9B%BD%E8%8A%AF%E7%89%87%E4%BC%81%E4%B8%9A%E5%80%9F%E5%8A%A9ai%E7%83%AD%E6%BD%AE%EF%BC%8C%E5%AE%8C%E6%88%90%E4%BA%9A%E6%B4%B2%E6%9C%80%E5%A4%A7%E8%A7%84%E6%A8%A1%E8%9E%8D%E8%B5%84%EF%BC%8C%E6%88%90%E4%B8%BA%E4%B8%AD%E5%9B%BD%E6%9C%80%E9%AB%98%E5%B8%82%E5%80%BC%E5%85%AC%E5%8F%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785283597000.webp","sourceId":"rfi"},{"id":1785321755000,"createdDate":"2026-07-29 10:42","name":"法国国际广播电台","title":"中国在印太区域的军事扩张从导弹试射到台海周边军演 唯一目的就是要成为印太新军事霸权","content":"中国官方突然宣告在23和24日两天于台湾海峡部分海域进行实弹射，并发布航行警告。中国过去几年正试图将环台军演常态化，历年演习范围不断扩大。中共更在7月初于太平洋试射远程导弹「巨浪」，展现其日益壮大的核武库。台湾国安会副秘书长表示，中国诸多作为只有一个目的，那就是成为印太新军事霸权。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260729-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E5%8D%B0%E5%A4%AA%E5%8C%BA%E5%9F%9F%E7%9A%84%E5%86%9B%E4%BA%8B%E6%89%A9%E5%BC%A0%E4%BB%8E%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84%E5%88%B0%E5%8F%B0%E6%B5%B7%E5%91%A8%E8%BE%B9%E5%86%9B%E6%BC%94-%E5%94%AF%E4%B8%80%E7%9B%AE%E7%9A%84%E5%B0%B1%E6%98%AF%E8%A6%81%E6%88%90%E4%B8%BA%E5%8D%B0%E5%A4%AA%E6%96%B0%E5%86%9B%E4%BA%8B%E9%9C%B8%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785321755000.webp","sourceId":"rfi"},{"id":1785318205000,"createdDate":"2026-07-29 09:43","name":"法国国际广播电台","title":"美国禁止进口中国新型人形机器人  保护人工智能免受国安威胁","content":"特朗普政府周二（7月28号）宣布了一项针对新型中国机器人和电力逆变器进口的禁令，以保护美国人工智能产业免受国家安全威胁，并要将那些即将迎来爆发式增长的关键产业回流至美国本土。中国外交部称将采取必要措施坚决维护中国企业的权益。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260729-%E7%BE%8E%E5%9B%BD%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E6%96%B0%E5%9E%8B%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA-%E4%BF%9D%E6%8A%A4%E7%BE%8E%E5%9B%BD%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%85%8D%E5%8F%97%E5%9B%BD%E5%AE%89%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785318205000.webp","sourceId":"rfi"},{"id":1785316995000,"createdDate":"2026-07-29 09:23","name":"法国国际广播电台","title":"藤森庆子宣誓就职秘鲁总统 拉美右翼执政版图进一步扩大","content":"秘鲁新总统藤森庆子当地时间周二（7月28日）在首都利马宣誓就职，成为秘鲁史上首位选举产生的女性总统，也是10年来该国的第10位总统，她的就职进一步扩大了拉美右翼执政的版图。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E8%97%A4%E6%A3%AE%E5%BA%86%E5%AD%90%E5%AE%A3%E8%AA%93%E5%B0%B1%E8%81%8C%E7%A7%98%E9%B2%81%E6%80%BB%E7%BB%9F-%E6%8B%89%E7%BE%8E%E5%8F%B3%E7%BF%BC%E6%89%A7%E6%94%BF%E7%89%88%E5%9B%BE%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785316995000.webp","sourceId":"rfi"},{"id":1785313964000,"createdDate":"2026-07-29 08:32","name":"法国国际广播电台","title":"抗议巴布亚新几内亚因一中原则关闭驻处 台湾停止向其采购天然气","content":"巴布亚新几内亚15日宣布片面关闭台湾代表处并重申一中原则，台湾外交部28日宣布将暂停采购巴国天然气现货以表抗议。估计其将少掉来自台湾的进口收入达5亿美元。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-%E6%8A%97%E8%AE%AE%E5%B7%B4%E5%B8%83%E4%BA%9A%E6%96%B0%E5%87%A0%E5%86%85%E4%BA%9A%E5%9B%A0%E4%B8%80%E4%B8%AD%E5%8E%9F%E5%88%99%E5%85%B3%E9%97%AD%E4%BB%A3%E8%A1%A8%E5%A4%84-%E5%8F%B0%E6%B9%BE%E5%81%9C%E6%AD%A2%E5%90%91%E5%85%B6%E9%87%87%E8%B4%AD%E5%A4%A9%E7%84%B6%E6%B0%94","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785313964000.webp","sourceId":"rfi"},{"id":1785311280000,"createdDate":"2026-07-29 07:48","name":"法国国际广播电台","title":"日本熊本大地震死亡人数已上升为13人 赖清德第一时间表示慰问","content":"日本熊本县日本时间28日下午发生的里氏7.1级（暂定值）地震，使熊本县时隔10年再次遭遇了最高震度（感觉到的摇动强度）7的强烈震感。日本内阁官房长官木原稔于20日上午举行记者会，他表示：包括目前仍在调查是否与灾害有关的死亡案例在内，死亡人数已增至13人，另有重伤7人、轻伤29人，而台湾总统赖清德在地震发生后的第一时间在X上发帖，对日本熊本地震表示慰问。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260729-%E6%97%A5%E6%9C%AC%E7%86%8A%E6%9C%AC%E5%A4%A7%E5%9C%B0%E9%9C%87%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%B7%B2%E4%B8%8A%E5%8D%87%E4%B8%BA13%E4%BA%BA-%E8%B5%96%E6%B8%85%E5%BE%B7%E7%AC%AC%E4%B8%80%E6%97%B6%E9%97%B4%E8%A1%A8%E7%A4%BA%E6%85%B0%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785311280000.webp","sourceId":"rfi"},{"id":1785309513000,"createdDate":"2026-07-29 07:18","name":"法国国际广播电台","title":"「47人案」被告邹家成 获联合国工作组裁定属任意拘留 香港至今第三人","content":"继传媒大亨黎智英和前支联会副主席邹幸彤之後，联合国任意拘留问题工作组（UNWorkingGrouponArbitraryDetention，WGAD）裁定，因参与香港民主派初选「47人案」被重判入狱7年9个月的邹家成，遭港府任意拘留，违反国际法，要求港府立即释放邹家成及向他作出赔偿，是香港获相关认定的第三人。工作组又敦促港府废除国安法，在此之前，不要再执行此法例。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-47%E4%BA%BA%E6%A1%88-%E8%A2%AB%E5%91%8A%E9%82%B9%E5%AE%B6%E6%88%90-%E8%8E%B7%E8%81%94%E5%90%88%E5%9B%BD%E5%B7%A5%E4%BD%9C%E7%BB%84%E8%A3%81%E5%AE%9A%E5%B1%9E%E4%BB%BB%E6%84%8F%E6%8B%98%E7%95%99-%E9%A6%99%E6%B8%AF%E8%87%B3%E4%BB%8A%E7%AC%AC%E4%B8%89%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309513000.webp","sourceId":"rfi"},{"id":1785309166000,"createdDate":"2026-07-29 07:12","name":"法国国际广播电台","title":"伊朗数周内将获得中国肩扛式导弹系统","content":"路透独家消息称，该合同涉及300至400套中国QW-12型和FN-16型便携式防空导弹系统，交易价值在6000万至7000万美元之间，中国称这些消息毫无根据，巴基斯坦否认与此类武器转让有任何牵连。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E4%BC%8A%E6%9C%97%E6%95%B0%E5%91%A8%E5%86%85%E5%B0%86%E8%8E%B7%E5%BE%97%E4%B8%AD%E5%9B%BD%E8%82%A9%E6%89%9B%E5%BC%8F%E5%AF%BC%E5%BC%B9%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309166000.webp","sourceId":"rfi"},{"id":1785309157000,"createdDate":"2026-07-29 07:12","name":"法国国际广播电台","title":"港老牌独立书店「田园书屋」遭国安搜捕后　宣布租约期满后结业","content":"在香港开业五十年的田园书屋，本月中遭国安警上门搜查及拘捕相关人员后，突然于今(29日)晨宣布，将于租约期满后结业，成为本月内第三间宣布结业的独立书店。资深评论人对消息感到惋惜，认为独立书店相继结业，是官方对香港作为研究中国真貌基地的全面整肃。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-%E6%B8%AF%E8%80%81%E7%89%8C%E7%8B%AC%E7%AB%8B%E4%B9%A6%E5%BA%97-%E7%94%B0%E5%9B%AD%E4%B9%A6%E5%B1%8B-%E9%81%AD%E5%9B%BD%E5%AE%89%E6%90%9C%E6%8D%95%E5%90%8E-%E5%AE%A3%E5%B8%83%E7%A7%9F%E7%BA%A6%E6%9C%9F%E6%BB%A1%E5%90%8E%E7%BB%93%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309157000.webp","sourceId":"rfi"}]