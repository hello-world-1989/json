[{"id":1785284098000,"createdDate":"2026-07-29 00:14","name":"法国国际广播电台","title":"特朗普政府加快遣返寻求庇护者","content":"特朗普政府有关庇护申请的新规，会让多达44万4千724人的案子可能受到影响。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260729-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E5%8A%A0%E5%BF%AB%E9%81%A3%E8%BF%94%E5%AF%BB%E6%B1%82%E5%BA%87%E6%8A%A4%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785284098000.webp","sourceId":"rfi"},{"id":1785283597000,"createdDate":"2026-07-29 00:06","name":"法国国际广播电台","title":"长鑫存储借助AI热潮，完成亚洲最大规模融资，成为中国最高市值公司","content":"法国世界报周二表示，近年来，人工智能快速发展，全球AI企业对存储芯片的需求快速增长。芯片企业也因此迎来新的增长机会。中国是全球第二大AI市场，仅次于美国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20260729-%E4%B8%AD%E5%9B%BD%E8%8A%AF%E7%89%87%E4%BC%81%E4%B8%9A%E5%80%9F%E5%8A%A9ai%E7%83%AD%E6%BD%AE%EF%BC%8C%E5%AE%8C%E6%88%90%E4%BA%9A%E6%B4%B2%E6%9C%80%E5%A4%A7%E8%A7%84%E6%A8%A1%E8%9E%8D%E8%B5%84%EF%BC%8C%E6%88%90%E4%B8%BA%E4%B8%AD%E5%9B%BD%E6%9C%80%E9%AB%98%E5%B8%82%E5%80%BC%E5%85%AC%E5%8F%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785283597000.webp","sourceId":"rfi"},{"id":1785321755000,"createdDate":"2026-07-29 10:42","name":"法国国际广播电台","title":"中国在印太区域的军事扩张从导弹试射到台海周边军演 唯一目的就是要成为印太新军事霸权","content":"中国官方突然宣告在23和24日两天于台湾海峡部分海域进行实弹射，并发布航行警告。中国过去几年正试图将环台军演常态化，历年演习范围不断扩大。中共更在7月初于太平洋试射远程导弹「巨浪」，展现其日益壮大的核武库。台湾国安会副秘书长表示，中国诸多作为只有一个目的，那就是成为印太新军事霸权。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20260729-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E5%8D%B0%E5%A4%AA%E5%8C%BA%E5%9F%9F%E7%9A%84%E5%86%9B%E4%BA%8B%E6%89%A9%E5%BC%A0%E4%BB%8E%E5%AF%BC%E5%BC%B9%E8%AF%95%E5%B0%84%E5%88%B0%E5%8F%B0%E6%B5%B7%E5%91%A8%E8%BE%B9%E5%86%9B%E6%BC%94-%E5%94%AF%E4%B8%80%E7%9B%AE%E7%9A%84%E5%B0%B1%E6%98%AF%E8%A6%81%E6%88%90%E4%B8%BA%E5%8D%B0%E5%A4%AA%E6%96%B0%E5%86%9B%E4%BA%8B%E9%9C%B8%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785321755000.webp","sourceId":"rfi"},{"id":1785318205000,"createdDate":"2026-07-29 09:43","name":"法国国际广播电台","title":"美国禁止进口中国新型人形机器人  保护人工智能免受国安威胁","content":"特朗普政府周二（7月28号）宣布了一项针对新型中国机器人和电力逆变器进口的禁令，以保护美国人工智能产业免受国家安全威胁，并要将那些即将迎来爆发式增长的关键产业回流至美国本土。中国外交部称将采取必要措施坚决维护中国企业的权益。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20260729-%E7%BE%8E%E5%9B%BD%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E6%96%B0%E5%9E%8B%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA-%E4%BF%9D%E6%8A%A4%E7%BE%8E%E5%9B%BD%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%85%8D%E5%8F%97%E5%9B%BD%E5%AE%89%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785318205000.webp","sourceId":"rfi"},{"id":1785316995000,"createdDate":"2026-07-29 09:23","name":"法国国际广播电台","title":"藤森庆子宣誓就职秘鲁总统 拉美右翼执政版图进一步扩大","content":"秘鲁新总统藤森庆子当地时间周二（7月28日）在首都利马宣誓就职，成为秘鲁史上首位选举产生的女性总统，也是10年来该国的第10位总统，她的就职进一步扩大了拉美右翼执政的版图。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E8%97%A4%E6%A3%AE%E5%BA%86%E5%AD%90%E5%AE%A3%E8%AA%93%E5%B0%B1%E8%81%8C%E7%A7%98%E9%B2%81%E6%80%BB%E7%BB%9F-%E6%8B%89%E7%BE%8E%E5%8F%B3%E7%BF%BC%E6%89%A7%E6%94%BF%E7%89%88%E5%9B%BE%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785316995000.webp","sourceId":"rfi"},{"id":1785313964000,"createdDate":"2026-07-29 08:32","name":"法国国际广播电台","title":"抗议巴布亚新几内亚因一中原则关闭驻处 台湾停止向其采购天然气","content":"巴布亚新几内亚15日宣布片面关闭台湾代表处并重申一中原则，台湾外交部28日宣布将暂停采购巴国天然气现货以表抗议。估计其将少掉来自台湾的进口收入达5亿美元。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-%E6%8A%97%E8%AE%AE%E5%B7%B4%E5%B8%83%E4%BA%9A%E6%96%B0%E5%87%A0%E5%86%85%E4%BA%9A%E5%9B%A0%E4%B8%80%E4%B8%AD%E5%8E%9F%E5%88%99%E5%85%B3%E9%97%AD%E4%BB%A3%E8%A1%A8%E5%A4%84-%E5%8F%B0%E6%B9%BE%E5%81%9C%E6%AD%A2%E5%90%91%E5%85%B6%E9%87%87%E8%B4%AD%E5%A4%A9%E7%84%B6%E6%B0%94","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785313964000.webp","sourceId":"rfi"},{"id":1785311280000,"createdDate":"2026-07-29 07:48","name":"法国国际广播电台","title":"日本熊本大地震死亡人数已上升为13人 赖清德第一时间表示慰问","content":"日本熊本县日本时间28日下午发生的里氏7.1级（暂定值）地震，使熊本县时隔10年再次遭遇了最高震度（感觉到的摇动强度）7的强烈震感。日本内阁官房长官木原稔于20日上午举行记者会，他表示：包括目前仍在调查是否与灾害有关的死亡案例在内，死亡人数已增至13人，另有重伤7人、轻伤29人，而台湾总统赖清德在地震发生后的第一时间在X上发帖，对日本熊本地震表示慰问。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20260729-%E6%97%A5%E6%9C%AC%E7%86%8A%E6%9C%AC%E5%A4%A7%E5%9C%B0%E9%9C%87%E6%AD%BB%E4%BA%A1%E4%BA%BA%E6%95%B0%E5%B7%B2%E4%B8%8A%E5%8D%87%E4%B8%BA13%E4%BA%BA-%E8%B5%96%E6%B8%85%E5%BE%B7%E7%AC%AC%E4%B8%80%E6%97%B6%E9%97%B4%E8%A1%A8%E7%A4%BA%E6%85%B0%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785311280000.webp","sourceId":"rfi"},{"id":1785309513000,"createdDate":"2026-07-29 07:18","name":"法国国际广播电台","title":"「47人案」被告邹家成 获联合国工作组裁定属任意拘留 香港至今第三人","content":"继传媒大亨黎智英和前支联会副主席邹幸彤之後，联合国任意拘留问题工作组（UNWorkingGrouponArbitraryDetention，WGAD）裁定，因参与香港民主派初选「47人案」被重判入狱7年9个月的邹家成，遭港府任意拘留，违反国际法，要求港府立即释放邹家成及向他作出赔偿，是香港获相关认定的第三人。工作组又敦促港府废除国安法，在此之前，不要再执行此法例。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-47%E4%BA%BA%E6%A1%88-%E8%A2%AB%E5%91%8A%E9%82%B9%E5%AE%B6%E6%88%90-%E8%8E%B7%E8%81%94%E5%90%88%E5%9B%BD%E5%B7%A5%E4%BD%9C%E7%BB%84%E8%A3%81%E5%AE%9A%E5%B1%9E%E4%BB%BB%E6%84%8F%E6%8B%98%E7%95%99-%E9%A6%99%E6%B8%AF%E8%87%B3%E4%BB%8A%E7%AC%AC%E4%B8%89%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309513000.webp","sourceId":"rfi"},{"id":1785309166000,"createdDate":"2026-07-29 07:12","name":"法国国际广播电台","title":"伊朗数周内将获得中国肩扛式导弹系统","content":"路透独家消息称，该合同涉及300至400套中国QW-12型和FN-16型便携式防空导弹系统，交易价值在6000万至7000万美元之间，中国称这些消息毫无根据，巴基斯坦否认与此类武器转让有任何牵连。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E4%BC%8A%E6%9C%97%E6%95%B0%E5%91%A8%E5%86%85%E5%B0%86%E8%8E%B7%E5%BE%97%E4%B8%AD%E5%9B%BD%E8%82%A9%E6%89%9B%E5%BC%8F%E5%AF%BC%E5%BC%B9%E7%B3%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309166000.webp","sourceId":"rfi"},{"id":1785309157000,"createdDate":"2026-07-29 07:12","name":"法国国际广播电台","title":"港老牌独立书店「田园书屋」遭国安搜捕后　宣布租约期满后结业","content":"在香港开业五十年的田园书屋，本月中遭国安警上门搜查及拘捕相关人员后，突然于今(29日)晨宣布，将于租约期满后结业，成为本月内第三间宣布结业的独立书店。资深评论人对消息感到惋惜，认为独立书店相继结业，是官方对香港作为研究中国真貌基地的全面整肃。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20260729-%E6%B8%AF%E8%80%81%E7%89%8C%E7%8B%AC%E7%AB%8B%E4%B9%A6%E5%BA%97-%E7%94%B0%E5%9B%AD%E4%B9%A6%E5%B1%8B-%E9%81%AD%E5%9B%BD%E5%AE%89%E6%90%9C%E6%8D%95%E5%90%8E-%E5%AE%A3%E5%B8%83%E7%A7%9F%E7%BA%A6%E6%9C%9F%E6%BB%A1%E5%90%8E%E7%BB%93%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785309157000.webp","sourceId":"rfi"},{"id":1785342753000,"createdDate":"2026-07-29 16:32","name":"法国国际广播电台","title":"扼红海收通行费：中国与胡赛保持联系以确保其油轮安全穿越","content":"被国际承认的也门政府的一名部长周三向法新社表示，胡塞武装正与伊朗合作，计划向过往红海的船只收取通行费。在伊朗封锁霍尔木兹海峡之后，此举可能使另一条重要国际航道面临新威胁。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E6%89%BC%E7%BA%A2%E6%B5%B7%E6%94%B6%E9%80%9A%E8%A1%8C%E8%B4%B9-%E4%B8%AD%E5%9B%BD%E4%B8%8E%E8%83%A1%E8%B5%9B%E4%BF%9D%E6%8C%81%E8%81%94%E7%B3%BB%E4%BB%A5%E7%A1%AE%E4%BF%9D%E5%85%B6%E6%B2%B9%E8%BD%AE%E5%AE%89%E5%85%A8%E7%A9%BF%E8%B6%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785342753000.webp","sourceId":"rfi"},{"id":1785336182000,"createdDate":"2026-07-29 14:43","name":"法国国际广播电台","title":"朝鲜去年贸易规模同比增16% 对华占比达98.2%","content":"韩联社电：大韩贸易投资振兴公社（KOTRA）28日发布的一份报告显示，去年朝鲜进出口双双实现两位数增长，推动贸易规模同比增长16%。同时，对华贸易占比达98.2%","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E6%B6%89%E5%AB%8C%E5%9C%A8%E5%8C%97%E7%BA%A6%E4%B8%BA%E4%B8%AD%E5%9B%BD%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E5%8D%8E%E8%A3%94%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AE%9E%E4%B9%A0%E7%94%9F%E8%83%8C%E6%99%AF%E6%9B%9D%E5%85%89-1","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785336182000.webp","sourceId":"rfi"},{"id":1785335941000,"createdDate":"2026-07-29 14:39","name":"法国国际广播电台","title":"马航MH370失联：马航上诉案在北京开庭  部分家属“无比愤怒”","content":"在马航MH370航班离奇失踪12年后，该航空公司上诉案周二在北京开庭审理。法新社说，“无比愤怒”的部分中国乘客家属在北京向马来西亚航空公司追责，并呼吁当局允许家属自行组织搜索行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E9%A9%AC%E8%88%AAmh370%E5%A4%B1%E8%81%94-%E9%A9%AC%E8%88%AA%E4%B8%8A%E8%AF%89%E6%A1%88%E5%9C%A8%E5%8C%97%E4%BA%AC%E5%BC%80%E5%BA%AD-%E9%83%A8%E5%88%86%E5%AE%B6%E5%B1%9E-%E6%97%A0%E6%AF%94%E6%84%A4%E6%80%92","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785335941000.webp","sourceId":"rfi"},{"id":1785333786000,"createdDate":"2026-07-29 14:03","name":"法国国际广播电台","title":"赞比亚：卡富埃河边的河马池是如何消失的？","content":"赞比亚的铜带省是该国的经济命脉，活跃着来自全世界多个国家的矿业集团，这里铜矿开采历史悠久，位于基特韦附近的钦戈拉位于卡富埃河边，这里长期以来受到多家铜矿开采公司的污染。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20260729-%E8%B5%9E%E6%AF%94%E4%BA%9A-%E5%8D%A1%E5%AF%8C%E5%9F%83%E6%B2%B3%E8%BE%B9%E7%9A%84%E6%B2%B3%E9%A9%AC%E6%B1%A0%E6%98%AF%E5%A6%82%E4%BD%95%E6%B6%88%E5%A4%B1%E7%9A%84","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785333786000.webp","sourceId":"rfi"},{"id":1785333704000,"createdDate":"2026-07-29 14:01","name":"法国国际广播电台","title":"特朗普与泽连斯基会面谈及爱国者导弹及重启外交斡旋 美参议院通过制裁俄法案","content":"周二（7月28号），美国总统特朗普和乌克兰总统泽连斯基在美国参议员林赛·格雷厄姆的葬礼前夕举行会面，两位领导人讨论了乌克兰如何生产自己的强大武器以及“其他有助于”乌克兰在与俄罗斯的持续战争中取得胜利的想法。分析认为，这次会晤凸显了美国总统对泽连斯基的态度发生了巨大的转变。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20260729-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E4%BC%9A%E9%9D%A2%E8%B0%88%E5%8F%8A%E7%88%B1%E5%9B%BD%E8%80%85%E5%AF%BC%E5%BC%B9%E5%8F%8A%E9%87%8D%E5%90%AF%E5%A4%96%E4%BA%A4%E6%96%A1%E6%97%8B-%E7%BE%8E%E5%8F%82%E8%AE%AE%E9%99%A2%E9%80%9A%E8%BF%87%E5%88%B6%E8%A3%81%E4%BF%84%E6%B3%95%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785333704000.webp","sourceId":"rfi"},{"id":1785332583000,"createdDate":"2026-07-29 13:43","name":"法国国际广播电台","title":"涉嫌在北约为中国从事间谍活动的华裔加拿大实习生背景曝光","content":"被怀疑在北约为中国从事谍报活动的华裔加拿大实习生克莱尔·Z.是人工智能研究人员，被认为能收集到大量中国情报机构可能感兴趣的信息，例如人员姓名和身份、北约内部安全程序、建筑平面图，及警卫巡逻路线和监控摄像头位置。她的社媒账号显示，她曾在欧洲航天局（ESA）实习，并在世贸组织及加拿大政府机构多部门工作过。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E6%B6%89%E5%AB%8C%E5%9C%A8%E5%8C%97%E7%BA%A6%E4%B8%BA%E4%B8%AD%E5%9B%BD%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E5%8D%8E%E8%A3%94%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AE%9E%E4%B9%A0%E7%94%9F%E8%83%8C%E6%99%AF%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785332583000.webp","sourceId":"rfi"},{"id":1785329281000,"createdDate":"2026-07-29 12:48","name":"法国国际广播电台","title":"中东空袭重启 美沙联袭伊拉克亲伊朗民兵 油价再升","content":"在中东局势经历数日平静后，周三该地区的空袭再度爆发。美军宣布拦截了伊朗导弹，随后与沙特联合对伊拉克境内的亲伊朗民兵组织发动袭击，导致油价再次飙升。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E4%B8%AD%E4%B8%9C%E7%A9%BA%E8%A2%AD%E9%87%8D%E5%90%AF-%E7%BE%8E%E6%B2%99%E8%81%94%E8%A2%AD%E4%BC%8A%E6%8B%89%E5%85%8B%E4%BA%B2%E4%BC%8A%E6%9C%97%E6%B0%91%E5%85%B5-%E6%B2%B9%E4%BB%B7%E5%86%8D%E5%8D%87","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785329281000.webp","sourceId":"rfi"},{"id":1785326252000,"createdDate":"2026-07-29 11:57","name":"法国国际广播电台","title":"法国和西班牙在新一轮热浪来袭前夕全力控制林火","content":"周三，法国西南吉伦特省再现高温，加上海风助长，导致森林大火有再次加剧的趋势；不过，随着第二晚周二局势平静，此前被转移的居民得以返回家。西班牙已有超过2万名因火灾被疏散的居民返回家中。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260729-%E6%B3%95%E5%9B%BD%E5%92%8C%E8%A5%BF%E7%8F%AD%E7%89%99%E5%9C%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E7%83%AD%E6%B5%AA%E6%9D%A5%E8%A2%AD%E5%89%8D%E5%A4%95%E5%85%A8%E5%8A%9B%E6%8E%A7%E5%88%B6%E6%9E%97%E7%81%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785326252000.webp","sourceId":"rfi"},{"id":1785323138000,"createdDate":"2026-07-29 11:05","name":"法国国际广播电台","title":"面对精通分化的中国，欧盟必须敢于发动贸易战","content":"大家好，周三7月29日，法国又将迎来近40°C度的高温，位于西南部的吉伦特省山火目前虽已获得控制，但当局与居民担忧在酷热和强风下火苗复燃，无不严正以待成为《费加罗报》、《十字架报》及《回声报》头版焦点。与此同时，接替迪迪埃-德尚出任法国国家队总教练的齐达内则是《解放报》的封面人物，齐达内对媒体宣称：“我已经准备好迎接挑战！”另外，欧盟对华贸易逆差不断扩大，6月份已达到每天11亿欧元的历史纪录，欧盟委员会专家预计到年底可能达到每天15亿欧元，《快报》周刊欧洲组编辑认为这种状况已\"不可持续\"亦“无法承受”，发表社论指出欧盟必须敢于和中国开战。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20260729-%E9%9D%A2%E5%AF%B9%E7%B2%BE%E9%80%9A%E5%88%86%E5%8C%96%E7%9A%84%E4%B8%AD%E5%9B%BD%EF%BC%8C%E6%AC%A7%E7%9B%9F%E5%BF%85%E9%A1%BB%E6%95%A2%E4%BA%8E%E5%8F%91%E5%8A%A8%E8%B4%B8%E6%98%93%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/07/29/1785323138000.webp","sourceId":"rfi"}]