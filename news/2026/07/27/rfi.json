[{"id":1785149268000,"createdDate":"2026-07-27 10:47","name":"法国国际广播电台","title":"擅闯中国驻日大使馆的24岁自卫官在东京被起诉","content":"就曾擅闯中国驻日大使馆的隶属于日本陆上自卫队虾野驻地（宫崎县）的三等陆尉村田晃大，东京地方检察厅周一以擅闯建筑物、违反《枪刀法》和进行威胁的罪名对其加以起诉。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260727-%E6%93%85%E9%97%AF%E4%B8%AD%E5%9B%BD%E9%A9%BB%E6%97%A5%E5%A4%A7%E4%BD%BF%E9%A6%86%E7%9A%8424%E5%B2%81%E8%87%AA%E5%8D%AB%E5%AE%98%E8%A2%AB%E8%B5%B7%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785149268000.webp","sourceId":"rfi"},{"id":1785149046000,"createdDate":"2026-07-27 10:44","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉第2：信念造就考古奇迹，谢里曼的特洛伊与迈锡尼 （下）","content":"谢里曼凭借他对荷马史诗的坚信，寻到了他心目中的普里阿摩斯宝藏。但他并没有判定特洛伊城的准确位置。这个特洛伊是一个九层叠加的遗址，现在考古学界基本断定，普里阿摩斯与赫克托尔死守的城池是第六和第七层遗址。但谢里曼寻获的宝藏却被永远命名为普里阿摩斯宝藏。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20260727-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89%E7%AC%AC2-%E4%BF%A1%E5%BF%B5%E9%80%A0%E5%B0%B1%E8%80%83%E5%8F%A4%E5%A5%87%E8%BF%B9%EF%BC%8C%E8%B0%A2%E9%87%8C%E6%9B%BC%E7%9A%84%E7%89%B9%E6%B4%9B%E4%BC%8A%E4%B8%8E%E8%BF%88%E9%94%A1%E5%B0%BC-%E4%B8%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785149046000.webp","sourceId":"rfi"},{"id":1785147959000,"createdDate":"2026-07-27 10:25","name":"法国国际广播电台","title":"一中国男子拿装有2万澳元现金的茶叶袋向澳官员行贿在悉尼机场被捕","content":"一名中国公民因涉嫌试图向澳大利亚公职人员行贿而被捕，行贿物品是一袋装有2万澳元（约合94834人民币）现金的茶叶。该男子于7月24日在悉尼国际机场试图登机时被捕，并于上周六（25日）被引渡回昆士兰州。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20260727-%E4%B8%80%E4%B8%AD%E5%9B%BD%E7%94%B7%E5%AD%90%E6%8B%BF%E8%A3%85%E6%9C%892%E4%B8%87%E6%BE%B3%E5%85%83%E7%8E%B0%E9%87%91%E7%9A%84%E8%8C%B6%E5%8F%B6%E8%A2%8B%E5%90%91%E6%BE%B3%E5%AE%98%E5%91%98%E8%A1%8C%E8%B4%BF%E5%9C%A8%E6%82%89%E5%B0%BC%E6%9C%BA%E5%9C%BA%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785147959000.webp","sourceId":"rfi"},{"id":1785144093000,"createdDate":"2026-07-27 09:21","name":"法国国际广播电台","title":"金正恩参谒志愿军烈士陵园 在毛岸英墓前献花","content":"据官媒朝中社报导，朝鲜最高领导人金正恩在“祖国解放战争胜利73周年”（《朝鲜停战协定》签署日）到来之际，于26日前往位于平安南道桧仓郡的中国人民志愿军烈士陵园，向烈士们表示崇高敬意。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20260727-%E9%87%91%E6%AD%A3%E6%81%A9%E5%8F%82%E8%B0%92%E5%BF%97%E6%84%BF%E5%86%9B%E7%83%88%E5%A3%AB%E9%99%B5%E5%9B%AD-%E5%9C%A8%E6%AF%9B%E5%B2%B8%E8%8B%B1%E5%A2%93%E5%89%8D%E7%8C%AE%E8%8A%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785144093000.webp","sourceId":"rfi"},{"id":1785143555000,"createdDate":"2026-07-27 09:12","name":"法国国际广播电台","title":"日本强烈谴责朝鲜将向乌克兰战场增派3万士兵","content":"日本内阁官房长官木原稔27日在记者会上，就朝鲜向俄罗斯派遣士兵等俄朝军事合作动向表示：“对此予以强烈谴责。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20260727-%E6%97%A5%E6%9C%AC%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3%E6%9C%9D%E9%B2%9C%E5%B0%86%E5%90%91%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E5%9C%BA%E5%A2%9E%E6%B4%BE3%E4%B8%87%E5%A3%AB%E5%85%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785143555000.webp","sourceId":"rfi"},{"id":1785142025000,"createdDate":"2026-07-27 08:47","name":"法国国际广播电台","title":"6岁女童接受基因编辑试验后死亡 卫健委：相关部门人员已介入跟进","content":"国际顶级学术期刊《科学》与知名学术诚信监督平台“撤稿观察”（RetractionWatch）本月23日联合披露了一起临床试验死亡事件：2025年3月24日，上海交通大学医学院附属新华医院为一名6岁女童实施了实验性脑部碱基编辑治疗。按照项目团队当时的说法，这是全球首例脑靶向基因编辑治疗。7天后，女童死于与该治疗相关的严重免疫反应。医院伦理委员会随后认定，她的死亡与治疗“肯定相关”。女童是这项试验唯一的受试者，而这起死亡此后一年多没有公开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260727-6%E5%B2%81%E5%A5%B3%E7%AB%A5%E6%8E%A5%E5%8F%97%E5%9F%BA%E5%9B%A0%E7%BC%96%E8%BE%91%E8%AF%95%E9%AA%8C%E5%90%8E%E6%AD%BB%E4%BA%A1-%E4%B8%8A%E6%B5%B7%E5%8D%AB%E5%81%A5%E5%A7%94-%E7%9B%B8%E5%85%B3%E9%83%A8%E9%97%A8%E4%BA%BA%E5%91%98%E5%B7%B2%E4%BB%8B%E5%85%A5%E8%B7%9F%E8%BF%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785142025000.webp","sourceId":"rfi"},{"id":1785141706000,"createdDate":"2026-07-27 08:41","name":"法国国际广播电台","title":"六十五岁中国籍女性法国北部被杀身亡 检方称二十九岁嫌疑人被正式立案调查","content":"两周前，在法国北部一名中国女子在公寓内被杀，周六里尔检察官办公室在本周末宣布，凶杀案嫌犯被正式立案调查并被羁押。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20260727-%E5%85%AD%E5%8D%81%E4%BA%94%E5%B2%81%E4%B8%AD%E5%9B%BD%E7%B1%8D%E5%A5%B3%E6%80%A7%E6%B3%95%E5%9B%BD%E5%8C%97%E9%83%A8%E8%A2%AB%E6%9D%80%E8%BA%AB%E4%BA%A1-%E6%A3%80%E6%96%B9%E7%A7%B0%E4%BA%8C%E5%8D%81%E4%B9%9D%E5%B2%81%E5%AB%8C%E7%96%91%E4%BA%BA%E8%A2%AB%E6%AD%A3%E5%BC%8F%E7%AB%8B%E6%A1%88%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785141706000.webp","sourceId":"rfi"},{"id":1785133333000,"createdDate":"2026-07-27 06:22","name":"法国国际广播电台","title":"香港前民主党主席胡志伟疑遭英国限制逗留仅一周　忧影响日后与家人团聚","content":"香港前民主党主席胡志伟出狱后赴英与家人团聚一事疑再生变数。他接受外媒专访时透露，英国边境人员认为，他此次入境另有目的，只批准他逗留7天。事件除了打乱他与家人团聚的计划外，更令他担心日后是否仍有机会赴英国探望家人，同时忧虑其他曾因政治案件服刑的港人可能遇到同类情况，期望英国内政部能取消对他的入境限制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260727-%E9%A6%99%E6%B8%AF%E5%89%8D%E6%B0%91%E4%B8%BB%E5%85%9A%E4%B8%BB%E5%B8%AD%E8%83%A1%E5%BF%97%E4%BC%9F%E7%96%91%E9%81%AD%E8%8B%B1%E5%9B%BD%E9%99%90%E5%88%B6%E9%80%97%E7%95%99%E4%BB%85%E4%B8%80%E5%91%A8-%E5%BF%A7%E5%BD%B1%E5%93%8D%E6%97%A5%E5%90%8E%E4%B8%8E%E5%AE%B6%E4%BA%BA%E5%9B%A2%E8%81%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785133333000.webp","sourceId":"rfi"},{"id":1785132920000,"createdDate":"2026-07-27 06:15","name":"法国国际广播电台","title":"港警在全港最大图书馆进行反恐演习惹争议　分析：象征官方视知识有罪","content":"香港警方最新一次跨部门联合反恐演习，选址在全港最大的公共图书馆——中央图书馆举行。警方表示，希望透过演习提升前线人员的反恐应变能力。但有分析认为，挑在图书馆进行反恐演习，而非有潜在恐怖袭击的可能地点，令人联想到与近期港国安连串针对独立书店的行动有关，批评当权者是要把书本和知识视为威胁甚至犯罪的心态。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20260727-%E6%B8%AF%E8%AD%A6%E5%9C%A8%E5%85%A8%E6%B8%AF%E6%9C%80%E5%A4%A7%E5%9B%BE%E4%B9%A6%E9%A6%86%E8%BF%9B%E8%A1%8C%E5%8F%8D%E6%81%90%E6%BC%94%E4%B9%A0%E6%83%B9%E4%BA%89%E8%AE%AE-%E5%88%86%E6%9E%90-%E8%B1%A1%E5%BE%81%E5%AE%98%E6%96%B9%E8%A7%86%E7%9F%A5%E8%AF%86%E6%9C%89%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/07/27/1785132920000.webp","sourceId":"rfi"}]