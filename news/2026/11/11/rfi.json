[{"id":1794436385000,"createdDate":"2026-11-11 22:33","name":"法国国际广播电台","title":"西班牙举行总罢工：马德里和巴塞罗那数万名抗议者要求保障住房权益","content":"本周三（11月11日），西班牙各大工会（包括CCOO和CGT）联合租户联盟在全国范围内发起了一场为期24小时的总罢工。马德里、瓦伦西亚和巴塞罗那等地出现了路障，部分地区发生停电，列车和地铁服务也随之中断。据西班牙媒体报道，在马德里格兰大道（GranVía），防暴警察冲击了人群，约有40人被捕。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261111-%E8%A5%BF%E7%8F%AD%E7%89%99%E4%B8%BE%E8%A1%8C%E6%80%BB%E7%BD%A2%E5%B7%A5-%E9%A9%AC%E5%BE%B7%E9%87%8C%E5%92%8C%E5%B7%B4%E5%A1%9E%E7%BD%97%E9%82%A3%E6%95%B0%E4%B8%87%E5%90%8D%E6%8A%97%E8%AE%AE%E8%80%85%E8%A6%81%E6%B1%82%E4%BF%9D%E9%9A%9C%E4%BD%8F%E6%88%BF%E6%9D%83%E7%9B%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794436385000.webp","sourceId":"rfi"},{"id":1794436202000,"createdDate":"2026-11-11 22:30","name":"法国国际广播电台","title":"波兰独立日 从华沙街头传出的复杂信号","content":"波兰独立日在首都华沙爆发的“爱国大游行”在平静中结束，虽然没有像不少人担心的会出现严重暴力，但传递出一些令人不安的信号。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E6%B3%A2%E5%85%B0%E7%8B%AC%E7%AB%8B%E6%97%A5-%E4%BB%8E%E5%8D%8E%E6%B2%99%E8%A1%97%E5%A4%B4%E4%BC%A0%E5%87%BA%E7%9A%84%E5%A4%8D%E6%9D%82%E4%BF%A1%E5%8F%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794436202000.webp","sourceId":"rfi"},{"id":1794433597000,"createdDate":"2026-11-11 21:46","name":"法国国际广播电台","title":"伊朗 : 美国用中东地区以外的军事基地袭击伊朗， 伊朗将打击这些基地","content":"伊朗安全事务负责人穆赫辛·雷扎伊发出威胁称，如果美国利用自己在中东地区以外（包括欧洲）的军事基地对伊朗伊斯兰共和国发动袭击，伊朗将对这些基地实施打击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261111-%E4%BC%8A%E6%9C%97-%E7%BE%8E%E5%9B%BD%E7%94%A8%E4%B8%AD%E4%B8%9C%E5%9C%B0%E5%8C%BA%E4%BB%A5%E5%A4%96%E7%9A%84%E5%86%9B%E4%BA%8B%E5%9F%BA%E5%9C%B0%E8%A2%AD%E5%87%BB%E4%BC%8A%E6%9C%97%EF%BC%8C-%E4%BC%8A%E6%9C%97%E5%B0%86%E6%89%93%E5%87%BB%E8%BF%99%E4%BA%9B%E5%9F%BA%E5%9C%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794433597000.webp","sourceId":"rfi"},{"id":1794433467000,"createdDate":"2026-11-11 21:44","name":"法国国际广播电台","title":"德国军队禁止使用中国造无人机","content":"德国国防部周三宣布，出于安全考虑，德军将不再使用任何中国产无人机，理由是需要保护敏感设施和数据。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E5%BE%B7%E5%9B%BD%E5%86%9B%E9%98%9F%E7%A6%81%E6%AD%A2%E4%BD%BF%E7%94%A8%E4%B8%AD%E5%9B%BD%E9%80%A0%E6%97%A0%E4%BA%BA%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794433467000.webp","sourceId":"rfi"},{"id":1794433355000,"createdDate":"2026-11-11 21:42","name":"法国国际广播电台","title":"美国特使将于周四分别会晤普京和泽连斯基","content":"美国特使将于周四分别会晤俄罗斯总统普京和乌克兰总统泽连斯基。之前，他们在阿布扎比进行了为期两天的会谈，旨在为结束乌克兰战争寻求“突破口”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E7%BE%8E%E5%9B%BD%E7%89%B9%E4%BD%BF%E5%B0%86%E4%BA%8E%E5%91%A8%E5%9B%9B%E5%88%86%E5%88%AB%E4%BC%9A%E6%99%A4%E6%99%AE%E4%BA%AC%E5%92%8C%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794433355000.webp","sourceId":"rfi"},{"id":1794433006000,"createdDate":"2026-11-11 21:36","name":"法国国际广播电台","title":"中国大学被美国列入黑名单 仍购买英伟达h200芯片","content":"美国对中国出口先进人工智能（AI）芯片的限制再遭质疑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E4%B8%AD%E5%9B%BD%E5%A4%A7%E5%AD%A6%E8%A2%AB%E7%BE%8E%E5%9B%BD%E5%88%97%E5%85%A5%E9%BB%91%E5%90%8D%E5%8D%95-%E4%BB%8D%E8%B4%AD%E4%B9%B0%E8%8B%B1%E4%BC%9F%E8%BE%BEh200%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794433006000.webp","sourceId":"rfi"},{"id":1794422476000,"createdDate":"2026-11-11 18:41","name":"法国国际广播电台","title":"古巴外长访华，王毅承诺中国“坚定支持”古巴反制裁","content":"周三在中国首都举行的一次会晤中，中国外长王毅向到访的古巴同行保证，面对制裁，北京将“坚定支持”哈瓦那，此前华盛顿上周对古巴实施了新的限制措施，包括制裁两家中国企业。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E5%8F%A4%E5%B7%B4%E5%A4%96%E9%95%BF%E8%AE%BF%E5%8D%8E%EF%BC%8C%E7%8E%8B%E6%AF%85%E6%89%BF%E8%AF%BA%E4%B8%AD%E5%9B%BD-%E5%9D%9A%E5%AE%9A%E6%94%AF%E6%8C%81-%E5%8F%A4%E5%B7%B4%E5%8F%8D%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794422476000.webp","sourceId":"rfi"},{"id":1794422125000,"createdDate":"2026-11-11 18:35","name":"法国国际广播电台","title":"俄罗斯谈判代表：任何和平协议都不存在与基辅交换领土的可能","content":"综合塔斯社、路透社报道，俄罗斯的乌克兰问题谈判代表拒绝与基辅进行领土交换的方案。俄罗斯和平谈判首席代表弗拉基米尔·梅津斯基11日表示，在任何和平协议框架下，都不存在与乌克兰交换领土的可能性。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E4%BF%84%E7%BD%97%E6%96%AF%E8%B0%88%E5%88%A4%E4%BB%A3%E8%A1%A8-%E4%BB%BB%E4%BD%95%E5%92%8C%E5%B9%B3%E5%8D%8F%E8%AE%AE%E9%83%BD%E4%B8%8D%E5%AD%98%E5%9C%A8%E4%B8%8E%E5%9F%BA%E8%BE%85%E4%BA%A4%E6%8D%A2%E9%A2%86%E5%9C%9F%E7%9A%84%E5%8F%AF%E8%83%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794422125000.webp","sourceId":"rfi"},{"id":1794421249000,"createdDate":"2026-11-11 18:20","name":"法国国际广播电台","title":"台湾将由电脑制造商宏碁集团联合创始人施振荣代表出席亚太经合峰会","content":"台湾周三宣布，宏碁联合创始人施振荣将代表台湾出席下周在中国举行的亚太经济合作组织（APEC）峰会。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E5%8F%B0%E6%B9%BE%E5%B0%86%E7%94%B1%E7%94%B5%E8%84%91%E5%88%B6%E9%80%A0%E5%95%86%E5%AE%8F%E7%A2%81%E9%9B%86%E5%9B%A2%E8%81%94%E5%90%88%E5%88%9B%E5%A7%8B%E4%BA%BA%E6%96%BD%E6%8C%AF%E8%8D%A3%E4%BB%A3%E8%A1%A8%E5%87%BA%E5%B8%AD%E4%BA%9A%E5%A4%AA%E7%BB%8F%E5%90%88%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794421249000.webp","sourceId":"rfi"},{"id":1794419320000,"createdDate":"2026-11-11 17:48","name":"法国国际广播电台","title":"美国财长贝森特就英伟达客户输华芯片安全问题与商务部长卢特尼克对峙","content":"Axios11日引述知情人透露，美国财长贝森特上周在白宫内部就英伟达客户Megaspeed迟迟未被列入“对国家安全构成威胁的企业名单”一事，与商务部长卢特尼克发生了争执。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E7%BE%8E%E5%9B%BD%E8%B4%A2%E9%95%BF%E8%B4%9D%E6%A3%AE%E7%89%B9%E5%B0%B1%E5%AF%B9%E8%BE%93%E5%8D%8E%E8%8A%AF%E7%89%87%E5%AE%89%E5%85%A8%E4%B8%8D%E4%BD%9C%E4%B8%BA%E4%B8%8E%E5%95%86%E5%8A%A1%E9%83%A8%E9%95%BF%E5%8D%A2%E7%89%B9%E5%B0%BC%E5%85%8B%E5%AF%B9%E5%B3%99","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794419320000.webp","sourceId":"rfi"},{"id":1794415205000,"createdDate":"2026-11-11 16:40","name":"法国国际广播电台","title":"联合国第31届气候变化大会迎来元首发言时间 缺席者众","content":"数十位各国领导人预定周三和周四在土耳其安塔利亚举行的联合国气候变化大会上发言，但各方注意力主要集中在众多缺席的政要身上。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E8%81%94%E5%90%88%E5%9B%BD%E7%AC%AC31%E5%B1%8A%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E5%A4%A7%E4%BC%9A%E8%BF%8E%E6%9D%A5%E5%85%83%E9%A6%96%E5%8F%91%E8%A8%80%E6%97%B6%E9%97%B4-%E7%BC%BA%E5%B8%AD%E8%80%85%E4%BC%97","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794415205000.webp","sourceId":"rfi"},{"id":1794413514000,"createdDate":"2026-11-11 16:11","name":"法国国际广播电台","title":"伊朗将阿根廷海军和空军列为“恐怖组织”","content":"伊朗外交部周三宣布将阿根廷海军和空军列入其恐怖组织名单，此前数月，阿根廷曾对伊朗作出类似决定。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E4%BC%8A%E6%9C%97%E5%B0%86%E9%98%BF%E6%A0%B9%E5%BB%B7%E6%B5%B7%E5%86%9B%E5%92%8C%E7%A9%BA%E5%86%9B%E5%88%97%E4%B8%BA-%E6%81%90%E6%80%96%E7%BB%84%E7%BB%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794413514000.webp","sourceId":"rfi"},{"id":1794412771000,"createdDate":"2026-11-11 15:59","name":"法国国际广播电台","title":"美国：针对皮特·赫格塞斯的弹劾程序在国会受挫 特朗普欣喜","content":"针对美国国防部长皮特·赫格塞斯的弹劾程序于周二被共和党众议员扼杀在萌芽状态，因民主党占多数的新一届国会明年1月就职，所以为这位五角大楼负责人争取到了宝贵的喘息之机。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E7%BE%8E%E5%9B%BD-%E9%92%88%E5%AF%B9%E7%9A%AE%E7%89%B9%C2%B7%E8%B5%AB%E6%A0%BC%E5%A1%9E%E6%96%AF%E7%9A%84%E5%BC%B9%E5%8A%BE%E7%A8%8B%E5%BA%8F%E5%9C%A8%E5%9B%BD%E4%BC%9A%E5%8F%97%E6%8C%AB-%E7%89%B9%E6%9C%97%E6%99%AE%E6%AC%A3%E5%96%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794412771000.webp","sourceId":"rfi"},{"id":1794409099000,"createdDate":"2026-11-11 14:58","name":"法国国际广播电台","title":"俄罗斯：两名受雇于波兰情报机构的“特工”被捕","content":"俄罗斯联邦安全局（FSB）周三宣布，在与波兰和立陶宛接壤的俄罗斯飞地加里宁格勒逮捕了两名为波兰情报部门工作的“特工”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E4%BF%84%E7%BD%97%E6%96%AF-%E4%B8%A4%E5%90%8D%E5%8F%97%E9%9B%87%E4%BA%8E%E6%B3%A2%E5%85%B0%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E7%9A%84-%E7%89%B9%E5%B7%A5-%E8%A2%AB%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794409099000.webp","sourceId":"rfi"},{"id":1794405280000,"createdDate":"2026-11-11 13:54","name":"法国国际广播电台","title":"美国商务部推迟将Megaspeed列入贸易黑名单","content":"据金融时报透露，与英伟达首席执行官黄仁勋有染且被美国情报官员认为是中国女谍的黄乐所在公司Megaspeed，迟迟未被美国商务部列入“实体清单”，引关注。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E7%BE%8E%E5%9B%BD%E5%95%86%E5%8A%A1%E9%83%A8%E6%8E%A8%E8%BF%9F%E5%B0%86megaspeed%E5%88%97%E5%85%A5%E8%B4%B8%E6%98%93%E9%BB%91%E5%90%8D%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794405280000.webp","sourceId":"rfi"},{"id":1794400880000,"createdDate":"2026-11-11 12:41","name":"法国国际广播电台","title":"泽连斯基致敬美国态度“变化”后 俄乌谈判进入第二天","content":"美国斡旋俄乌谈判周三在阿布扎比进入第二天。此前周二在谈判首日，乌克兰总统泽连斯基致敬华盛顿在与莫斯科谈判定调上的转变。不过他强调需要为乌克兰提供安全保障。据泽连斯基称，接下来周三的会谈将就能源和黑海相关问题商讨“缓和局势的措施”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%87%B4%E6%95%AC%E7%BE%8E%E5%9B%BD%E6%80%81%E5%BA%A6-%E5%8F%98%E5%8C%96-%E5%90%8E-%E4%BF%84%E4%B9%8C%E8%B0%88%E5%88%A4%E8%BF%9B%E5%85%A5%E7%AC%AC%E4%BA%8C%E5%A4%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794400880000.webp","sourceId":"rfi"},{"id":1794399535000,"createdDate":"2026-11-11 12:18","name":"法国国际广播电台","title":"台湾九合一大选｜基隆不仅蓝绿战况极度胶着，更是中央与地方的政治角力舞台","content":"基隆市长选举被定位为「市政与政党对决」的百里侯之争，不仅是现任国民党籍市长谢国梁的连任保卫战，更是民进党全面动员，由议长童子玮挂帅企图翻转北台湾的重要指标。目前民调显示，蓝绿双方陷入肉搏战，两位候选人差距仅0.5个百分点，且另外还有25.8%民众未明确表态，这使年轻与中间选民的动向成为胜负关键。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20261111-%E5%8F%B0%E6%B9%BE%E4%B9%9D%E5%90%88%E4%B8%80%E5%A4%A7%E9%80%89%EF%BD%9C%E5%9F%BA%E9%9A%86%E4%B8%8D%E4%BB%85%E8%93%9D%E7%BB%BF%E6%88%98%E5%86%B5%E6%9E%81%E5%BA%A6%E8%83%B6%E7%9D%80%EF%BC%8C%E6%9B%B4%E6%98%AF%E4%B8%AD%E5%A4%AE%E4%B8%8E%E5%9C%B0%E6%96%B9%E7%9A%84%E6%94%BF%E6%B2%BB%E8%A7%92%E5%8A%9B%E8%88%9E%E5%8F%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794399535000.webp","sourceId":"rfi"},{"id":1794399004000,"createdDate":"2026-11-11 12:10","name":"法国国际广播电台","title":"费加罗报：英伟达事件的“职场第一戒律”警示","content":"由于假日的原因，今天法国各大日报中只有《费加罗报》出刊。该报头版主要的议题均聚焦国内，首先是法国近期社会运动中的出现的骚乱安保问题。 部分左翼人士声讨“警察暴力”，而该报以Odoxa为报纸所做最新民调显示，绝大多数法国人仍支持警察和宪兵，认为执法人员面对暴力骚乱时装备不足，批评政府未能有效维护公共秩序。另一则是有关法国大选，另一民粹政党候选人、前记者埃里克·泽穆尔周一宣布参选，在勒庞一揽极右影响下，泽穆尔选民基础缩小，但仍期望比自己5年前首次参选获得提升。法国著名影星让·迦本逝世五十周年，报纸头版图片献给这位深受喜爱的法国电影巨星，半个世纪过去，他的经典作品仍在不断重映，包括最为中国观众知晓的《悲惨世界》，周年之际，一部以他的传记电影正在筹备之中。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261111-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E4%BA%8B%E4%BB%B6%E5%BC%95%E5%8F%91%E4%BC%81%E4%B8%9A%E5%AE%89%E5%85%A8%E4%B8%8E%E9%97%B4%E8%B0%8D%E9%A3%8E%E9%99%A9%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794399004000.webp","sourceId":"rfi"},{"id":1794397436000,"createdDate":"2026-11-11 11:43","name":"法国国际广播电台","title":"亚太经合组织会议在即 北京驳斥加拿大干涉内政指控","content":"中国外交部今天周三驳斥了有关中国干涉加拿大内政的指控。此前加拿大总理卡尼表示，他将在亚太经合组织（APEC）峰会上向中国国家主席习近平提出这一问题。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E4%BA%9A%E5%A4%AA%E7%BB%8F%E5%90%88%E7%BB%84%E7%BB%87%E4%BC%9A%E8%AE%AE%E5%9C%A8%E5%8D%B3-%E5%8C%97%E4%BA%AC%E9%A9%B3%E6%96%A5%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%B9%B2%E6%B6%89%E5%86%85%E6%94%BF%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794397436000.webp","sourceId":"rfi"},{"id":1794391985000,"createdDate":"2026-11-11 10:13","name":"法国国际广播电台","title":"黄乐持香港护照数次来台接触AI供应链业者 是否引发国安疑虑？","content":"据报导，黄乐曾于2024及2025年至少两度持香港护照来台，访台期间她频繁接触台湾AI供应链业者，引发国安疑虑。在美国政府建议下，台湾2024年开始监控黄乐的访台行程。内政部长刘世芳11日指出，政府已经将黄乐废证，未来她无法再来台。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E9%BB%84%E4%B9%90%E6%8C%81%E9%A6%99%E6%B8%AF%E6%8A%A4%E7%85%A7%E6%95%B0%E6%AC%A1%E6%9D%A5%E5%8F%B0%E6%8E%A5%E8%A7%A6ai%E4%BE%9B%E5%BA%94%E9%93%BE%E4%B8%9A%E8%80%85-%E6%98%AF%E5%90%A6%E5%BC%95%E5%8F%91%E5%9B%BD%E5%AE%89%E7%96%91%E8%99%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794391985000.webp","sourceId":"rfi"},{"id":1794391565000,"createdDate":"2026-11-11 10:06","name":"法国国际广播电台","title":"中美俄首脑会谈呼之欲出  日本向美国表示关切与担忧","content":"美国国务卿鲁比奥10日表示，关于美国、中国和俄罗斯三国首脑会谈，他认为“有可能实现”。他表示，美方希望将全球核扩散问题列为会谈议题之一。鲁比奥是在访问法国巴黎期间回答记者提问时作出上述表态的。日本《每日新闻》11月10日报道称，据对相关人士的采访获悉，日本政府已就可能配合11月18日至19日在中国深圳举行的亚太经合组织（APEC）领导人非正式会议而召开中美俄三国首脑会谈，向美方表达了担忧。据称，美方回应说：“我们充分理解日本的担忧。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261111-%E4%B8%AD%E7%BE%8E%E4%BF%84%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88%E5%91%BC%E4%B9%8B%E6%AC%B2%E5%87%BA-%E6%97%A5%E6%9C%AC%E5%90%91%E7%BE%8E%E5%9B%BD%E8%A1%A8%E7%A4%BA%E5%85%B3%E5%88%87%E4%B8%8E%E6%8B%85%E5%BF%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794391565000.webp","sourceId":"rfi"},{"id":1794385324000,"createdDate":"2026-11-11 08:22","name":"法国国际广播电台","title":"英伟达间谍风波，揭开了美中科技冷战中比较隐蔽的一面","content":"美国科技巨头英伟达掌门人黄仁勋，承认自己曾与一名中国女子保持婚外情。美国情报部门怀疑这名女子为北京从事间谍活动。法国《世界报》经济版专栏记者伊莎贝尔·沙普龙周二从这一事件出发回顾了美中科技冷战中的往事。相关的文章表示，涉及英伟达老板黄仁勋的这一事件，揭开了美中科技冷战中更加隐蔽的一面。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261111-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E9%97%B4%E8%B0%8D%E9%A3%8E%E6%B3%A2%EF%BC%8C%E6%8F%AD%E5%BC%80%E4%BA%86%E7%BE%8E%E4%B8%AD%E7%A7%91%E6%8A%80%E5%86%B7%E6%88%98%E4%B8%AD%E6%AF%94%E8%BE%83%E9%9A%90%E8%94%BD%E7%9A%84%E4%B8%80%E9%9D%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794385324000.webp","sourceId":"rfi"},{"id":1794381755000,"createdDate":"2026-11-11 07:22","name":"法国国际广播电台","title":"黄乐拥港人身份 近月仍在香港设公司 疑续助「去中国化」或资本变现","content":"辉达行政总裁黄仁勋与黄乐的关系，被指促成了价值至少75亿美元的辉达晶片出口到中国。事件中的女主角至今行踪成谜，但本地传媒报道，拥有香港永久居民身份的黄乐，近来在港设立至少三家公司，疑似把「去中国化」的桥段或资本变现手段由新加坡延伸至香港。但相关布局会否受今次婚外情影响，有待观察；而她曾任董事的中国内地企业欲来港上市的计划，则肯定受到打击。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E9%BB%84%E4%B9%90%E6%8B%A5%E6%B8%AF%E4%BA%BA%E8%BA%AB%E4%BB%BD-%E8%BF%91%E6%9C%88%E4%BB%8D%E5%9C%A8%E9%A6%99%E6%B8%AF%E8%AE%BE%E5%85%AC%E5%8F%B8-%E7%96%91%E7%BB%AD%E5%8A%A9-%E5%8E%BB%E4%B8%AD%E5%9B%BD%E5%8C%96-%E6%88%96%E8%B5%84%E6%9C%AC%E5%8F%98%E7%8E%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794381755000.webp","sourceId":"rfi"},{"id":1794441081000,"createdDate":"2026-11-11 23:51","name":"法国国际广播电台","title":"黄仁勋再爆婚外情 华尔街日报称英伟达准备解除其首席执行官职务","content":"在传出英伟达首席执行官与疑似女间谍黄乐有染后，周三纽约时报爆出黄仁勋第二段婚外恋。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261111-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%86%8D%E7%88%86%E5%A9%9A%E5%A4%96%E6%83%85-%E5%8D%8E%E5%B0%94%E8%A1%97%E6%97%A5%E6%8A%A5%E7%A7%B0%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%87%86%E5%A4%87%E8%A7%A3%E9%99%A4%E5%85%B6%E9%A6%96%E5%B8%AD%E6%89%A7%E8%A1%8C%E5%AE%98%E8%81%8C%E5%8A%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/11/1794441081000.webp","sourceId":"rfi"}]