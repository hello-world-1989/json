[{"id":1795155623000,"createdDate":"2026-11-20 06:20","name":"法国国际广播电台","title":"苹果公司因计划性淘汰产品和阻止iPhone维修在巴黎受审","content":"苹果公司因计划性淘汰产品和阻止iPhone维修将在巴黎受审。如果罪名成立，这家美国科技公司将面临高达其年收入5%的罚款，约合217亿欧元。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261120-%E8%8B%B9%E6%9E%9C%E5%85%AC%E5%8F%B8%E5%9B%A0%E8%AE%A1%E5%88%92%E6%80%A7%E6%B7%98%E6%B1%B0%E4%BA%A7%E5%93%81%E5%92%8C%E9%98%BB%E6%AD%A2iphone%E7%BB%B4%E4%BF%AE%E5%B0%86%E5%9C%A8%E5%B7%B4%E9%BB%8E%E5%8F%97%E5%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795155623000.webp","sourceId":"rfi"},{"id":1795155520000,"createdDate":"2026-11-20 06:18","name":"法国国际广播电台","title":"习近平以APEC力捧深圳　香港称配合　评论指香港沦深圳发展「提款机」","content":"中国国家主席习近平在刚结束的亚太经济合作组织(APEC)峰会上，多次向各国领袖力推深圳，谈及粤港澳大湾区发展时，亦主要以深圳的发展成就为例，未有特别提及香港的角色。与此同时，以独立经济体领袖身份出席峰会的香港特首李家超，则强调香港如何服务中国发展及推动大湾区合作。有评论认为，从种种安排可见中央对深圳的重视，香港在大湾区的角色逐渐由昔日的经济主导者，转为深圳科技产业发展的支援者，甚至沦为深圳发展的「提款机」。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261120-%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%BB%A5apec%E5%8A%9B%E6%8D%A7%E6%B7%B1%E5%9C%B3-%E9%A6%99%E6%B8%AF%E7%A7%B0%E9%85%8D%E5%90%88-%E8%AF%84%E8%AE%BA%E6%8C%87%E9%A6%99%E6%B8%AF%E6%B2%A6%E6%B7%B1%E5%9C%B3%E5%8F%91%E5%B1%95-%E6%8F%90%E6%AC%BE%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795155520000.webp","sourceId":"rfi"},{"id":1795155170000,"createdDate":"2026-11-20 06:12","name":"法国国际广播电台","title":"习特深圳会晤未见提及黎智英　会前黎智英获美颁民主奖  其子续吁为父争自由","content":"美国总统特朗普昨(19日)午与中国国家主席习近平在深圳APEC会议期间会面，是两人今年内第三次，但双方会后公布的资料，暂未见提及有关曾讨论争取释放《苹果日报》创办人黎智英的信息。但在会议前夕，黎智英获美国凯特林基金会颁发民主奖，其子黎崇恩代为领奖时，再次呼吁外界继续为父亲争取自由。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261120-%E4%B9%A0%E7%89%B9%E6%B7%B1%E5%9C%B3%E4%BC%9A%E6%99%A4%E6%9C%AA%E8%A7%81%E6%8F%90%E5%8F%8A%E9%BB%8E%E6%99%BA%E8%8B%B1-%E4%BC%9A%E5%89%8D%E9%BB%8E%E6%99%BA%E8%8B%B1%E8%8E%B7%E7%BE%8E%E9%A2%81%E6%B0%91%E4%B8%BB%E5%A5%96-%E5%85%B6%E5%AD%90%E7%BB%AD%E5%90%81%E4%B8%BA%E7%88%B6%E4%BA%89%E8%87%AA%E7%94%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795155170000.webp","sourceId":"rfi"},{"id":1795189527000,"createdDate":"2026-11-20 15:45","name":"法国国际广播电台","title":"为什么伊斯兰教到了2035年应会成为世界第一大宗教？","content":"根据美国皮尤研究中心PewResearchCenter最新预测显示，穆斯林最早可能在2035年超越基督教，成为世界上最大的宗教群体。该研究指出，这一转变主要由穆斯林人口的年轻化和较高的生育率推动，并将重塑全球宗教格局。研究报告的数据显示，至2070年，全球穆斯林人口将达到36.4亿，而所有教派的基督徒人口将达到29.6亿。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261120-%E4%B8%BA%E4%BB%80%E4%B9%88%E4%BC%8A%E6%96%AF%E5%85%B0%E6%95%99%E5%88%B0%E4%BA%862035%E5%B9%B4%E5%BA%94%E4%BC%9A%E6%88%90%E4%B8%BA%E4%B8%96%E7%95%8C%E7%AC%AC%E4%B8%80%E5%A4%A7%E5%AE%97%E6%95%99","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795189527000.webp","sourceId":"rfi"},{"id":1795188311000,"createdDate":"2026-11-20 15:25","name":"法国国际广播电台","title":"欧英峰会：伯纳姆试图与欧盟进行风险重合","content":"英国首相安迪·伯纳姆于本周五（11月20日）抵达布鲁塞尔,参加第二次欧盟-英国峰会。双方将就食品出口、碳排放和青年流动等问题签署多项协议。这次峰会标志着欧盟与其前成员国之间始于去年的经济和政治和解进程进入了一个新的阶段。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261120-%E6%AC%A7%E8%8B%B1%E5%B3%B0%E4%BC%9A-%E4%BC%AF%E7%BA%B3%E5%A7%86%E8%AF%95%E5%9B%BE%E4%B8%8E%E6%AC%A7%E7%9B%9F%E8%BF%9B%E8%A1%8C%E9%A3%8E%E9%99%A9%E9%87%8D%E5%90%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795188311000.webp","sourceId":"rfi"},{"id":1795186528000,"createdDate":"2026-11-20 14:55","name":"法国国际广播电台","title":"台湾举报数千个疑似与中国有关的Threads账号，意图影响下周的选举","content":"路透社周五（11月20日）独家消息称，据三名台湾政府官员以及路透社查阅的内部报告显示，台湾方面已向Meta举报近2700个Threads的社交媒体账号，称这些账号疑似属于一项中国信息战行动的一部分，意图影响下周举行的台湾地方选举。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E5%8F%B0%E6%B9%BE%E4%B8%BE%E6%8A%A5%E6%95%B0%E5%8D%83%E4%B8%AA%E7%96%91%E4%BC%BC%E4%B8%8E%E4%B8%AD%E5%9B%BD%E6%9C%89%E5%85%B3%E7%9A%84threads%E8%B4%A6%E5%8F%B7%EF%BC%8C%E6%84%8F%E5%9B%BE%E5%BD%B1%E5%93%8D%E4%B8%8B%E5%91%A8%E7%9A%84%E9%80%89%E4%B8%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795186528000.webp","sourceId":"rfi"},{"id":1795186271000,"createdDate":"2026-11-20 14:51","name":"法国国际广播电台","title":"中国批评海牙国际法院裁定缅甸迫害罗兴亚人为种族灭绝，认为不利于解决争端","content":"中国周五（11月20日）对海牙国际法院（ICJ）裁定缅甸针对罗兴亚人的镇压构成种族灭绝表示批评，认为这一判决“不利于”相关争端的解决。国际法院本周四作出裁决，这是该联合国最高司法机构成立80年来首次认定一个国家犯有种族灭绝罪行。法院裁定，缅甸针对罗兴亚少数民族实施了种族灭绝，并要求确保罗兴亚难民能够安全返回家园，同时获得赔偿。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E4%B8%AD%E5%9B%BD%E6%89%B9%E8%AF%84%E6%B5%B7%E7%89%99%E5%9B%BD%E9%99%85%E6%B3%95%E9%99%A2%E8%A3%81%E5%AE%9A%E7%BC%85%E7%94%B8%E8%BF%AB%E5%AE%B3%E7%BD%97%E5%85%B4%E4%BA%9A%E4%BA%BA%E4%B8%BA%E7%A7%8D%E6%97%8F%E7%81%AD%E7%BB%9D%EF%BC%8C%E8%AE%A4%E4%B8%BA%E4%B8%8D%E5%88%A9%E4%BA%8E%E8%A7%A3%E5%86%B3%E4%BA%89%E7%AB%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795186271000.webp","sourceId":"rfi"},{"id":1795186220000,"createdDate":"2026-11-20 14:50","name":"法国国际广播电台","title":"法新社：高市在APEC峰会遭冷遇或反助其迎合国内排外情绪，进一步巩固保守派支持","content":"法新社周五（11月20日）报导称，分析人士认为，日本首相高市早苗首次访华期间遭遇中方冷淡对待，但这一来自北京的“冷遇”反而可能进一步巩固她在日本国内保守派选民中的支持基础。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E6%B3%95%E6%96%B0%E7%A4%BE-%E9%AB%98%E5%B8%82%E5%9C%A8apec%E5%B3%B0%E4%BC%9A%E9%81%AD%E5%86%B7%E9%81%87%E6%88%96%E5%8F%8D%E5%8A%A9%E5%85%B6%E8%BF%8E%E5%90%88%E5%9B%BD%E5%86%85%E6%8E%92%E5%A4%96%E6%83%85%E7%BB%AA%EF%BC%8C%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%B7%A9%E5%9B%BA%E4%BF%9D%E5%AE%88%E6%B4%BE%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795186220000.webp","sourceId":"rfi"},{"id":1795180990000,"createdDate":"2026-11-20 13:23","name":"法国国际广播电台","title":"Anthropic有史最大募股但未能消除对人工智能担忧 亚洲科技股普跌","content":"美国初创企业Anthropic公开募股创纪录，周四首日表现强劲但是未能重振市场对人工智能股票的信心，在早盘一度飙升后科技股也普遍遭到抛售。今天周五，这波逆转走低趋势蔓延至亚洲市场，加剧了人们的担忧，投资者对人工智能企业的估值和承诺正逐渐失去耐心。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261120-anthropic%E6%9C%89%E5%8F%B2%E6%9C%80%E5%A4%A7%E5%8B%9F%E8%82%A1%E4%BD%86%E6%9C%AA%E8%83%BD%E6%B6%88%E9%99%A4%E5%AF%B9%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E6%8B%85%E5%BF%A7-%E4%BA%9A%E6%B4%B2%E7%A7%91%E6%8A%80%E8%82%A1%E6%99%AE%E8%B7%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795180990000.webp","sourceId":"rfi"},{"id":1795180624000,"createdDate":"2026-11-20 13:17","name":"法国国际广播电台","title":"俄罗斯空袭基辅波及奥地利荷兰大使馆后 巴黎要求安理会召开紧急会议","content":"法国外交部长巴罗今天周五宣布，俄罗斯昨晚对基辅发动导弹袭击，在击中当地的奥地利和荷兰大使馆后，法国已要求联合国安理会召开紧急会议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E4%BF%84%E7%BD%97%E6%96%AF%E7%A9%BA%E8%A2%AD%E5%9F%BA%E8%BE%85%E6%B3%A2%E5%8F%8A%E5%A5%A5%E5%9C%B0%E5%88%A9%E8%8D%B7%E5%85%B0%E5%A4%A7%E4%BD%BF%E9%A6%86%E5%90%8E-%E5%B7%B4%E9%BB%8E%E8%A6%81%E6%B1%82%E5%AE%89%E7%90%86%E4%BC%9A%E5%8F%AC%E5%BC%80%E7%B4%A7%E6%80%A5%E4%BC%9A%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795180624000.webp","sourceId":"rfi"},{"id":1795174859000,"createdDate":"2026-11-20 11:40","name":"法国国际广播电台","title":"美众议院披露近88万枚AI芯片获批出口中国，其中包括国防部认证的“军工企业”","content":"据CNBC报导，美国众议院外交事务委员会周四公布的文件显示，截至2026年5月，美国商务部负责出口管制与执法的工业与安全局（BIS）已批准向中国企业出售超过87.9万枚人工智能芯片，其中涉及阿里巴巴、腾讯等中国科技公司。而2025年12月至2026年5月期间，美国企业共申请向中国出售约340万枚AI芯片，主要涉及英伟达（Nvidia）和超威半导体（AMD）的产品。其中约87.9万枚获得批准，获批比例约为四分之一。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E7%BE%8E%E4%BC%97%E8%AE%AE%E9%99%A2%E6%8A%AB%E9%9C%B2%E8%BF%9188%E4%B8%87%E6%9E%9Aai%E8%8A%AF%E7%89%87%E8%8E%B7%E6%89%B9%E5%87%BA%E5%8F%A3%E4%B8%AD%E5%9B%BD%EF%BC%8C%E5%85%B6%E4%B8%AD%E5%8C%85%E6%8B%AC%E5%9B%BD%E9%98%B2%E9%83%A8%E8%AE%A4%E8%AF%81%E7%9A%84-%E5%86%9B%E5%B7%A5%E4%BC%81%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795174859000.webp","sourceId":"rfi"},{"id":1795174008000,"createdDate":"2026-11-20 11:26","name":"法国国际广播电台","title":"中美俄：“新世界”的峰会","content":"20日法国两份主要报纸头版继续聚焦中美俄三国领导人在深圳会晤，《费加罗》报题为《习近平、特朗普和普京展示他们的新世界秩序》，指三“巨头”为一个以实力博弈为主导的世界做出“战略稳定”保证，并无具体承诺，但却重塑了普京治下俄罗斯的国际形象。《十字架报》以“摆拍的“新世界”为题，指一场冠以“历史性”的会晤，最终以空泛的承诺结束，三国元首表面上的和谐未必意味着一个真正稳定的新世界。其他报纸头版则把视角转向不同内容，《解放报》关注女性健康与医疗公平问题，采访记者萨凯与疼痛医学专家德尔芬·吕耶里，揭示女性的疼痛疾病长期在医疗体系和社会中被轻视及背后折射出深层性别歧视。经济性《回声报》头版报道人工智能公司Anthropic在美国纳斯达克的上市成功，募资规模已超过SpaceX创下的记录，周四开盘价较发行价上涨34%，公司市值突破2万亿美元，此外，报纸也在头版关注10月17日法国骚乱带来的经济损失，2000万欧元保险赔付金已超过黄背心运动时期造成的损失规模。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261120-%E4%B8%AD%E7%BE%8E%E4%BF%84-%E6%96%B0%E4%B8%96%E7%95%8C-%E7%9A%84%E5%B3%B0%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795174008000.webp","sourceId":"rfi"},{"id":1795173367000,"createdDate":"2026-11-20 11:16","name":"法国国际广播电台","title":"COP31 ： 非洲绝不接受缺乏落实资源的会议成果","content":"周四第二份封面决议草案出台后，峰会会场的反应十分激烈，继巴拿马周四明确表示坚决反对之后，气候受害国国家的政府代表，呼吁走出化石能源的国家，以及气候活动组织纷纷在峰会举行记者会，以表达他们对协议文本草案的不满。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261120-cop31-%E9%9D%9E%E6%B4%B2%E7%BB%9D%E4%B8%8D%E6%8E%A5%E5%8F%97%E7%BC%BA%E4%B9%8F%E8%90%BD%E5%AE%9E%E8%B5%84%E6%BA%90%E7%9A%84%E4%BC%9A%E8%AE%AE%E6%88%90%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795173367000.webp","sourceId":"rfi"},{"id":1795172487000,"createdDate":"2026-11-20 11:01","name":"法国国际广播电台","title":"APEC后美中关系恐仍有变数","content":"美国总统特朗普（DonaldTrump）与中国国家主席习近平在亚太经济合作会议（APEC）期间会晤后，双方虽同意推动建立具建设性、战略稳定的关系，但台湾问题、半导体出口管制及稀土供应等分歧仍未解决。美中贸易休战协议明年1月到期前，双方能否维持目前的缓和局面，也面临新的考验。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261120-apec%E5%90%8E%E7%BE%8E%E4%B8%AD%E5%85%B3%E7%B3%BB%E6%81%90%E4%BB%8D%E6%9C%89%E5%8F%98%E6%95%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795172487000.webp","sourceId":"rfi"},{"id":1795171711000,"createdDate":"2026-11-20 10:48","name":"法国国际广播电台","title":"日美首脑举行电话会谈 讨论中美俄首脑会谈","content":"日本首相高市早苗于日本时间19日晚与美国总统特朗普举行了电话会谈，双方交谈约20分钟。根据美中俄三国领导人会谈的情况，特朗普向高市介绍了与中国国家主席习近平、俄罗斯总统普京会谈的相关内容。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261120-%E6%97%A5%E7%BE%8E%E9%A6%96%E8%84%91%E4%B8%BE%E8%A1%8C%E7%94%B5%E8%AF%9D%E4%BC%9A%E8%B0%88-%E8%AE%A8%E8%AE%BA%E4%B8%AD%E7%BE%8E%E4%BF%84%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795171711000.webp","sourceId":"rfi"},{"id":1795168730000,"createdDate":"2026-11-20 09:58","name":"法国国际广播电台","title":"美国议员建议禁止认证中国制造飞机，限制对中国航天业及其法国合作伙伴的投资","content":"路透社周五（11月20日）报导，根据路透社查阅的一份美国国会报告，美国政府应停止对中国制造飞机的认证，同时，如果包括欧洲飞机制造商空客公司（Airbus）在内的国防承包商不终止对中国航空航天产业的投资，美国还应取消与这些企业的政府合同。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E7%BE%8E%E5%9B%BD%E8%AE%AE%E5%91%98%E5%BB%BA%E8%AE%AE%E7%A6%81%E6%AD%A2%E8%AE%A4%E8%AF%81%E4%B8%AD%E5%9B%BD%E5%88%B6%E9%80%A0%E9%A3%9E%E6%9C%BA%EF%BC%8C%E9%99%90%E5%88%B6%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%88%AA%E5%A4%A9%E4%B8%9A%E5%8F%8A%E5%85%B6%E6%B3%95%E5%9B%BD%E5%90%88%E4%BD%9C%E4%BC%99%E4%BC%B4%E7%9A%84%E6%8A%95%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795168730000.webp","sourceId":"rfi"},{"id":1795167425000,"createdDate":"2026-11-20 09:37","name":"法国国际广播电台","title":"APEC峰会结束后，中国敦促日本纠正涉台错误言论，在历史问题上调整自身“态度”","content":"APEC峰会闭幕后，中国于周五（11月20日）敦促日本纠正在台湾问题上的“错误”言行，并在历史问题上调整自身“态度”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261120-apec%E5%B3%B0%E4%BC%9A%E7%BB%93%E6%9D%9F%E5%90%8E%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%95%A6%E4%BF%83%E6%97%A5%E6%9C%AC%E7%BA%A0%E6%AD%A3%E6%B6%89%E5%8F%B0%E9%94%99%E8%AF%AF%E8%A8%80%E8%AE%BA%EF%BC%8C%E5%9C%A8%E5%8E%86%E5%8F%B2%E9%97%AE%E9%A2%98%E4%B8%8A%E8%B0%83%E6%95%B4%E8%87%AA%E8%BA%AB-%E6%80%81%E5%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795167425000.webp","sourceId":"rfi"},{"id":1795166641000,"createdDate":"2026-11-20 09:24","name":"法国国际广播电台","title":"特朗普离开时，白宫罕见收缴“空军一号”上记者手机","content":"特朗普于周四（11月19日）和习近平及普京会晤后返回美国，白宫以“安全原因”为由，收缴了部分搭乘总统专机“空军一号”离开中国的记者手机，这一做法极为罕见。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261120-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A6%BB%E5%BC%80%E6%97%B6%EF%BC%8C%E7%99%BD%E5%AE%AB%E7%BD%95%E8%A7%81%E6%94%B6%E7%BC%B4-%E7%A9%BA%E5%86%9B%E4%B8%80%E5%8F%B7-%E4%B8%8A%E8%AE%B0%E8%80%85%E6%89%8B%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795166641000.webp","sourceId":"rfi"},{"id":1795166078000,"createdDate":"2026-11-20 09:14","name":"法国国际广播电台","title":"美国加州检察官对英伟达及其对华芯片销售展开调查","content":"加利福尼亚州总检察长周四对英伟达发出传票以展开调查，以查明该公司是否就其尖端人工智能芯片的泄露风险向投资者隐瞒了真相。此举是导致该公司前首席执行官黄仁勋下台的丑闻的延伸。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261120-%E7%BE%8E%E5%9B%BD%E5%8A%A0%E5%B7%9E%E6%A3%80%E5%AF%9F%E5%AE%98%E5%AF%B9%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%8F%8A%E5%85%B6%E5%AF%B9%E5%8D%8E%E8%8A%AF%E7%89%87%E9%94%80%E5%94%AE%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795166078000.webp","sourceId":"rfi"},{"id":1795164950000,"createdDate":"2026-11-20 08:55","name":"法国国际广播电台","title":"澳总理称与习近平的会谈“富有建设性”，将妥善处理双方分歧","content":"澳大利亚总理阿尔巴尼斯周五（11月20日）在深圳与中国国家主席习近平举行会谈后表示，澳大利亚与其最大贸易伙伴中国保持着“富有建设性的”对话，并致力于妥善处理双方分歧。在上一届澳大利亚政府执政时期，澳中关系曾一度恶化。此前澳方呼吁就新冠疫情起源展开调查，引发北京方面强烈不满。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261120-%E6%BE%B3%E6%80%BB%E7%90%86%E7%A7%B0%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E7%9A%84%E4%BC%9A%E8%B0%88-%E5%AF%8C%E6%9C%89%E5%BB%BA%E8%AE%BE%E6%80%A7-%EF%BC%8C%E5%B0%86%E5%A6%A5%E5%96%84%E5%A4%84%E7%90%86%E5%8F%8C%E6%96%B9%E5%88%86%E6%AD%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/20/1795164950000.webp","sourceId":"rfi"}]