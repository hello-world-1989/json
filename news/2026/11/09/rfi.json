[{"id":1794244462000,"createdDate":"2026-11-09 17:14","name":"法国国际广播电台","title":"特朗普称与伊朗重启战争“极不可能”，国际油价下跌","content":"美国总统唐纳德·特朗普表示，只要与德黑兰的谈判取得进展，与伊朗重启战争“极不可能”。他在与卡塔尔首相会晤前做出此番表述。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261109-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%8E%E4%BC%8A%E6%9C%97%E9%87%8D%E5%90%AF%E6%88%98%E4%BA%89-%E6%9E%81%E4%B8%8D%E5%8F%AF%E8%83%BD-%EF%BC%8C%E5%9B%BD%E9%99%85%E6%B2%B9%E4%BB%B7%E4%B8%8B%E8%B7%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794244462000.webp","sourceId":"rfi"},{"id":1794240713000,"createdDate":"2026-11-09 16:11","name":"法国国际广播电台","title":"巴黎会议筹资修复俄军炸损的切尔诺贝利核电站隔离罩","content":"为修复切尔诺贝利前核电站防护罩的集资会议周一在巴黎举行，各捐助方承诺的资金略多于总预算的一半——该防护罩去年曾遭俄罗斯无人机破坏。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261109-%E5%B7%B4%E9%BB%8E%E4%BC%9A%E8%AE%AE%E7%AD%B9%E8%B5%84%E4%BF%AE%E5%A4%8D%E4%BF%84%E5%86%9B%E7%82%B8%E6%8D%9F%E7%9A%84%E5%88%87%E5%B0%94%E8%AF%BA%E8%B4%9D%E5%88%A9%E6%A0%B8%E7%94%B5%E7%AB%99%E9%9A%94%E7%A6%BB%E7%BD%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794240713000.webp","sourceId":"rfi"},{"id":1794237079000,"createdDate":"2026-11-09 15:11","name":"法国国际广播电台","title":"“落实型COP”： 第31届联合国气候变化大会在土耳其开幕","content":"第31届联合国气候变化大会（COP31）周一在土耳其南部滨海城市安塔利亚开幕。近200个国家和地区的代表与会，展开为期两周的气候谈判。路透社报道指，面对中东战事冲击全球能源供应、人工智能快速发展推高电力需求、以及美国持续弱化全球气候合作影响，分析普遍预计此次由土耳其和澳大利亚共同担任主席国的本届大会在推动加速能源转型、达成有力协议方面难有突破，两国将本次大会定位为“落实型COP”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261109-%E8%90%BD%E5%AE%9E%E5%9E%8Bcop-%E7%AC%AC31%E5%B1%8A%E8%81%94%E5%90%88%E5%9B%BD%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E5%A4%A7%E4%BC%9A%E5%9C%A8%E5%9C%9F%E8%80%B3%E5%85%B6%E5%BC%80%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794237079000.webp","sourceId":"rfi"},{"id":1794232644000,"createdDate":"2026-11-09 13:57","name":"法国国际广播电台","title":"2026年里斯本网络峰会 人形机器人成官方发言人","content":"第十届里斯本网络峰会（WebSummit）于今日开幕，并持续至周四，全球科技精英汇聚里斯本参加本次峰会，本届里斯本网络峰会标志着历史的新篇章，就是向实体人工智能领域转型。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-2026%E5%B9%B4%E9%87%8C%E6%96%AF%E6%9C%AC%E7%BD%91%E7%BB%9C%E5%B3%B0%E4%BC%9A-%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E6%88%90%E5%AE%98%E6%96%B9%E5%8F%91%E8%A8%80%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794232644000.webp","sourceId":"rfi"},{"id":1794230901000,"createdDate":"2026-11-09 13:28","name":"法国国际广播电台","title":"媒体：立陶宛要求台湾驻维尔纽斯办事处更名","content":"立陶宛国家广播电视台（lrt）11月9日消息，立陶宛外交部在9月份要求台湾驻维尔纽斯代表处在一周内更改其名称。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261109-%E5%AA%92%E4%BD%93-%E7%AB%8B%E9%99%B6%E5%AE%9B%E8%A6%81%E6%B1%82%E5%8F%B0%E6%B9%BE%E9%A9%BB%E7%BB%B4%E5%B0%94%E7%BA%BD%E6%96%AF%E5%8A%9E%E4%BA%8B%E5%A4%84%E6%9B%B4%E5%90%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794230901000.webp","sourceId":"rfi"},{"id":1794228201000,"createdDate":"2026-11-09 12:43","name":"法国国际广播电台","title":"在中国这个“追求极致速度的国家”，欧莱雅的发展秘诀","content":"11月9日星期一出刊的法国主流日刊侧重点各有不同。本期法国报纸摘要，一起聚焦和中国相关的话题。费加罗报本次聚焦了即将到来的双十一，和欧莱雅在中国“加速发展的秘诀”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261109-%E5%8F%8C%E5%8D%81%E4%B8%80%EF%BC%8C%E6%AC%A7%E8%8E%B1%E9%9B%85%E5%9C%A8%E4%B8%AD%E5%9B%BD-%E5%8A%A0%E9%80%9F%E5%8F%91%E5%B1%95%E7%9A%84%E7%A7%98%E8%AF%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794228201000.webp","sourceId":"rfi"},{"id":1794227774000,"createdDate":"2026-11-09 12:36","name":"法国国际广播电台","title":"美国务院曾就黄仁勋与中国间谍的关系发出过警告 卢比奥对此表示无可奉告","content":"对纽约时报透露美国国务院于今年5月在特朗普访华前曾就黄仁勋与中国间谍的关系向政府高层发出过警告一事，美国国务卿卢比奥表示无可奉告。那次，黄仁勋在最后一刻被特朗普召唤在阿拉斯加登上空军1号。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261109-%E7%BE%8E%E5%9B%BD%E5%8A%A1%E9%99%A2%E6%9B%BE%E5%B0%B1%E9%BB%84%E4%BB%81%E5%8B%8B%E4%B8%8E%E4%B8%AD%E5%9B%BD%E9%97%B4%E8%B0%8D%E7%9A%84%E5%85%B3%E7%B3%BB%E5%8F%91%E5%87%BA%E8%BF%87%E8%AD%A6%E5%91%8A-%E5%8D%A2%E6%AF%94%E5%A5%A5%E5%AF%B9%E6%AD%A4%E8%A1%A8%E7%A4%BA%E6%97%A0%E5%8F%AF%E5%A5%89%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794227774000.webp","sourceId":"rfi"},{"id":1794226531000,"createdDate":"2026-11-09 12:15","name":"法国国际广播电台","title":"美国执政党共和党在中期选举中惨败将给日本带来什么样的影响？","content":"在当地时间11月3日夜间举行的美国中期选举中，民主党夺得了联邦国会参众两院的多数席位，甚至在得克萨斯、俄亥俄、堪萨斯等共和党的传统根据地夺取了议席，并在州长选举中从选举前的24个州长职位增加到30个，这场选举对民主党而言是一场历史性大胜。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20261109-%E7%BE%8E%E5%9B%BD%E6%89%A7%E6%94%BF%E5%85%9A%E5%85%B1%E5%92%8C%E5%85%9A%E5%9C%A8%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E4%B8%AD%E6%83%A8%E8%B4%A5%E5%B0%86%E7%BB%99%E6%97%A5%E6%9C%AC%E5%B8%A6%E6%9D%A5%E4%BB%80%E4%B9%88%E6%A0%B7%E7%9A%84%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794226531000.webp","sourceId":"rfi"},{"id":1794216287000,"createdDate":"2026-11-09 09:24","name":"法国国际广播电台","title":"九合一大选将近中共频繁介选 立委担忧AI深伪影片影响台湾选情","content":"民进党立委林俊宪9日指出，网路上出现不少用AI深伪作出的影片以假乱真，台北市长候选人沈伯洋阵营就曾遭到假影片攻击。花莲县长参选人魏嘉贤也指控，有人组织性利用境外社群帐号介入花莲选举。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261109-%E4%B9%9D%E5%90%88%E4%B8%80%E5%A4%A7%E9%80%89%E5%B0%86%E8%BF%91%E4%B8%AD%E5%85%B1%E9%A2%91%E7%B9%81%E4%BB%8B%E9%80%89-%E7%AB%8B%E5%A7%94%E6%8B%85%E5%BF%A7ai%E6%B7%B1%E4%BC%AA%E5%BD%B1%E7%89%87%E5%BD%B1%E5%93%8D%E5%8F%B0%E6%B9%BE%E9%80%89%E6%83%85","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794216287000.webp","sourceId":"rfi"},{"id":1794213530000,"createdDate":"2026-11-09 08:38","name":"法国国际广播电台","title":"日本国家安保战略将不提中国“威胁”只提“挑战”","content":"日本政府已开始研究，在年内修订的《国家安全保障战略》中，继续维持现行战略的基本认识，即将中国定位为“最大的战略挑战”，而不采用经常用于指称敌对国家的“威胁”一词。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261109-%E6%97%A5%E6%9C%AC%E5%9B%BD%E5%AE%B6%E5%AE%89%E4%BF%9D%E6%88%98%E7%95%A5%E5%B0%86%E4%B8%8D%E6%8F%90%E4%B8%AD%E5%9B%BD-%E5%A8%81%E8%83%81-%E5%8F%AA%E6%8F%90-%E6%8C%91%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794213530000.webp","sourceId":"rfi"},{"id":1794213463000,"createdDate":"2026-11-09 08:37","name":"法国国际广播电台","title":"中国太原市一栋约40层高楼发生火灾 已致14人死亡 20多人受伤","content":"中国山西太原一座高层建筑周日（11月8日）晚发生大火，根据官方新华社报道，截至周一上午事故已造成14人死亡，另有25人送医治疗。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E4%B8%AD%E5%9B%BD%E5%A4%AA%E5%8E%9F%E5%B8%82%E4%B8%80%E6%A0%8B%E7%BA%A640%E5%B1%82%E9%AB%98%E6%A5%BC%E5%8F%91%E7%94%9F%E7%81%AB%E7%81%BE-%E5%B7%B2%E8%87%B414%E4%BA%BA%E6%AD%BB%E4%BA%A1-20%E5%A4%9A%E4%BA%BA%E5%8F%97%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794213463000.webp","sourceId":"rfi"},{"id":1794213278000,"createdDate":"2026-11-09 08:34","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉：斯巴达的特性","content":"希腊世界有两个截然相反的范例：雅典和斯巴达。前者象征着智慧，典雅，艺术与个性自由，后者象征着纪律，克制，简朴与集体行动。一般说来，这两种文化特性引向人类文明发展的两条路径，雅典培育着西方自由的文明，斯巴达则造就了严苛的集体管制性社会。当我们了解了雅典黄金时代精神文化之后，应该回过头来看看斯巴达这希腊文明的另一面。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261109-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E6%96%AF%E5%B7%B4%E8%BE%BE%E7%9A%84%E7%89%B9%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794213278000.webp","sourceId":"rfi"},{"id":1794212477000,"createdDate":"2026-11-09 08:21","name":"法国国际广播电台","title":"盛事之都？ 欧美艺人巡演多绕道香港 吸引力逊星洲  港官称展览业旺","content":"香港财政主责官员指在港举行的展览数目已经显着回升，去年访港的会展旅客人次达到251万，上升7%，其中约六成是过夜旅客。尴尬的是，一份智库研究发现，一直标榜是「盛事之都」的香港，对欧美艺人的巡演吸引力颇低，低於东京丶新加坡以至部分东南亚城市；相关情况在启德体育园启用後，并无明显改善。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E7%9B%9B%E4%BA%8B%E4%B9%8B%E9%83%BD-%E6%AC%A7%E7%BE%8E%E8%89%BA%E4%BA%BA%E5%B7%A1%E6%BC%94%E5%A4%9A%E7%BB%95%E9%81%93%E9%A6%99%E6%B8%AF-%E5%90%B8%E5%BC%95%E5%8A%9B%E9%80%8A%E6%98%9F%E6%B4%B2-%E6%B8%AF%E5%AE%98%E7%A7%B0%E5%B1%95%E8%A7%88%E4%B8%9A%E6%97%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794212477000.webp","sourceId":"rfi"},{"id":1794209316000,"createdDate":"2026-11-09 07:28","name":"法国国际广播电台","title":"中国登月计划目标:在美国之前实现达标 最早于2027年进行首次试飞并在2030前实现载人登月","content":"中国公布了登月计划：最早于2027年进行首次试飞，并在2030年前实现载人登月。中国公布的这项登月计划，目标是在美国之前实现这一目标。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E4%B8%AD%E5%9B%BD%E7%99%BB%E6%9C%88%E8%AE%A1%E5%88%92%EF%BC%8C%E7%9B%AE%E6%A0%87-%E5%9C%A8%E7%BE%8E%E5%9B%BD%E4%B9%8B%E5%89%8D%E5%AE%9E%E7%8E%B0%E8%BE%BE%E6%A0%87%EF%BC%8C%E6%9C%80%E6%97%A9%E4%BA%8E2027%E5%B9%B4%E8%BF%9B%E8%A1%8C%E9%A6%96%E6%AC%A1%E8%AF%95%E9%A3%9E%EF%BC%8C%E5%B9%B6%E5%9C%A82030%E5%89%8D%E5%AE%9E%E7%8E%B0%E8%BD%BD%E4%BA%BA%E7%99%BB%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794209316000.webp","sourceId":"rfi"},{"id":1794264797000,"createdDate":"2026-11-09 22:53","name":"法国国际广播电台","title":"陷入风暴的英伟达掌门人黄仁勋会倒下吗","content":"高科技界最具影响力的人物之一，英伟达首席执行官黄仁勋陷入“情色与间谍”风暴，这不仅因其婚外恋暴露，更因其情妇被美国情报机构认定是一名中国间谍。婚外恋是道德瑕疵，而涉及的对象疑似中国间谍则一下把事件的性质提升到国家安全层面。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E9%99%B7%E5%85%A5%E9%A3%8E%E6%9A%B4%E7%9A%84%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%8E%8C%E9%97%A8%E4%BA%BA%E9%BB%84%E4%BB%81%E5%8B%8B%E4%BC%9A%E5%80%92%E4%B8%8B%E5%90%97","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794264797000.webp","sourceId":"rfi"},{"id":1794263623000,"createdDate":"2026-11-09 22:33","name":"法国国际广播电台","title":"网路袭击法国境内超市冷藏设备是伊朗伊斯兰革命卫队干的， 法国外长发誓要制裁","content":"法国周一表示，伊朗伊斯兰革命卫队是上个月针对法国境内超市冷藏设备所发动“史无前例”网络攻击的幕后黑手，并誓言将在欧洲层面针对德黑兰实施制裁。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261109-%E7%BD%91%E8%B7%AF%E8%A2%AD%E5%87%BB%E6%B3%95%E5%9B%BD%E5%A2%83%E5%86%85%E8%B6%85%E5%B8%82%E5%86%B7%E8%97%8F%E8%AE%BE%E5%A4%87%E6%98%AF%E4%BC%8A%E6%9C%97%E4%BC%8A%E6%96%AF%E5%85%B0%E9%9D%A9%E5%91%BD%E5%8D%AB%E9%98%9F%E5%B9%B2%E7%9A%84%EF%BC%8C-%E6%B3%95%E5%9B%BD%E5%A4%96%E9%95%BF%E5%8F%91%E8%AA%93%E8%A6%81%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794263623000.webp","sourceId":"rfi"},{"id":1794263367000,"createdDate":"2026-11-09 22:29","name":"法国国际广播电台","title":"乌克兰2027年面临700亿欧元资金缺口，德国总理要欧盟就明年支持乌克兰所需的资金达成共识","content":"据法新社周一看到的一封信件显示，德国总理默茨表示，欧盟必须先就明年支持乌克兰所需的资金达成共识，才能解决该欧盟下一期预算方面的僵局。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261109-%E4%B9%8C%E5%85%8B%E5%85%B02027%E5%B9%B4%E9%9D%A2%E4%B8%B4700%E4%BA%BF%E6%AC%A7%E5%85%83%E8%B5%84%E9%87%91%E7%BC%BA%E5%8F%A3%EF%BC%8C%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%90%86%E8%A6%81%E6%AC%A7%E7%9B%9F%E5%B0%B1%E6%98%8E%E5%B9%B4%E6%94%AF%E6%8C%81%E4%B9%8C%E5%85%8B%E5%85%B0%E6%89%80%E9%9C%80%E7%9A%84%E8%B5%84%E9%87%91%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794263367000.webp","sourceId":"rfi"},{"id":1794263013000,"createdDate":"2026-11-09 22:23","name":"法国国际广播电台","title":"要依靠英伟达芯片的硅谷科技界力挺黄仁勋， 说他不可替代","content":"英伟达（Nvidia）首席执行官黄仁勋（JensenHuang）正处于人工智能热潮的中心。然而，上周末爆发的一起间谍丑闻，可能会动摇这家公司；这件事情的背景是：市场对人工智能狂热投资的信心本来就已经十分脆弱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E8%A6%81%E4%BE%9D%E9%9D%A0%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%8A%AF%E7%89%87%E7%9A%84%E7%A1%85%E8%B0%B7%E7%A7%91%E6%8A%80%E7%95%8C%E5%8A%9B%E6%8C%BA%E9%99%B7%E5%85%A5%E5%A9%9A%E5%A4%96%E6%81%8B%E5%92%8C%E7%96%91%E4%BC%BC%E9%97%B4%E8%B0%8D%E4%B8%91%E9%97%BB%E7%9A%84%E8%8B%B1%E4%BC%9F%E8%BE%BE%E9%A6%96%E5%B8%AD%E6%89%A7%E8%A1%8C%E5%AE%98%E9%BB%84%E4%BB%81%E5%8B%8B%EF%BC%8C-%E8%AF%B4%E4%BB%96%E4%B8%8D%E5%8F%AF%E6%9B%BF%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794263013000.webp","sourceId":"rfi"},{"id":1794262894000,"createdDate":"2026-11-09 22:21","name":"法国国际广播电台","title":"特朗普称下周或与习近平、普京在中国举行三方会谈","content":"美国总统特朗普（DonaldTrump）表示，预计本月18日至19日在中国深圳举行的亚太经济合作组织（APEC）领导人非正式会议期间，与中国国家主席习近平及俄罗斯总统普京（VladimirPutin）举行三方会谈。若会面成事，将是美、中、俄三国元首首次正式举行三方会谈。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%8B%E5%91%A8%E6%88%96%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3-%E6%99%AE%E4%BA%AC%E5%9C%A8%E4%B8%AD%E5%9B%BD%E4%B8%BE%E8%A1%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794262894000.webp","sourceId":"rfi"},{"id":1794262546000,"createdDate":"2026-11-09 22:15","name":"法国国际广播电台","title":"特朗普再次指责中期选举存在舞弊","content":"在共和党于中期选举中遭遇惨败近一周后，美国总统特朗普于周一再次毫无根据的指控中期选举存在舞弊。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E7%89%B9%E6%9C%97%E6%99%AE%E5%86%8D%E6%AC%A1%E6%8C%87%E8%B4%A3%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%AD%98%E5%9C%A8%E8%88%9E%E5%BC%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794262546000.webp","sourceId":"rfi"},{"id":1794256011000,"createdDate":"2026-11-09 20:26","name":"法国国际广播电台","title":"非洲:南非公布2026市镇选举结果","content":"在南非，该国选举委员会于昨天（11月08号，星期日）公布了于11月04日（上周三）举行的2026年市镇选举的正式结果。这是本台法广非洲组（RFIAfrique）今天（11月09号，星期一）最新法文报道的看点之一。以南非现总统西里尔·拉马福萨（leprésidentsud-africainCyrilRamaphosa）为首的[非洲人国民大会]（leCongrèsnationalafricain，简称[非国大]）虽然遭遇重挫，但就得票率来看，依然是南非第一大党。[非国大]（l’ANC）以略超30%的得票率，在总数278个城镇中的至少125个市镇领先。南非第二大党[民主联盟]（DA-AllianceDémocratique）得票率接近25%；而由南非前总统祖马（JacobZuma）牵头的政党[民族之矛]（MK-uMkhontoweSizwe），得票率接近10%，是南非政坛第三大政治力量。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261109-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%8D%97%E9%9D%9E%E5%85%AC%E5%B8%832026%E5%B8%82%E9%95%87%E9%80%89%E4%B8%BE%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794256011000.webp","sourceId":"rfi"},{"id":1794251396000,"createdDate":"2026-11-09 19:09","name":"法国国际广播电台","title":"中国2026年的能源投资估计或达9400亿美元","content":"中国2026年的能源投资预估或达到9400亿美元，位居世界各国之首。作为世界第二大经济体，中国正将支出转向电网和基础设施建设，以支持其快速发展的可再生能源行业。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261109-%E4%B8%AD%E5%9B%BD2026%E5%B9%B4%E7%9A%84%E8%83%BD%E6%BA%90%E6%8A%95%E8%B5%84%E4%BC%B0%E8%AE%A1%E6%88%96%E8%BE%BE%E5%88%B09400%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/09/1794251396000.webp","sourceId":"rfi"}]