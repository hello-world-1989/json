[{"id":1795682964000,"createdDate":"2026-11-26 08:49","name":"法国国际广播电台","title":"日本政府修改安保文件强调引进远程导弹","content":"日本政府将在年底修订的三份安保相关文件之一——《防卫力量整备计划》的指导方针已经曝光。文件提出，将引进一种新型反舰导弹，作为实施反击能力（攻击敌方基地能力）的远程导弹手段之一。这种导弹可以从自卫队舰艇上发射。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E6%97%A5%E6%9C%AC%E6%94%BF%E5%BA%9C%E4%BF%AE%E6%94%B9%E5%AE%89%E4%BF%9D%E6%96%87%E4%BB%B6%E5%BC%BA%E8%B0%83%E5%BC%95%E8%BF%9B%E8%BF%9C%E7%A8%8B%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795682964000.webp","sourceId":"rfi"},{"id":1795682365000,"createdDate":"2026-11-26 08:39","name":"法国国际广播电台","title":"美国对日中等国征收追加关税  日本官房长官反驳并表示遗憾","content":"美国特朗普政府公布了一项追加关税方案，拟对日本、中国等14个国家和地区加征关税。美国贸易代表办公室25日公布了追加关税方案，称日本、中国、欧盟等14个国家和地区拥有过剩生产能力，导致美国企业处于不利地位，因此拟对这些国家和地区加征关税。对于日本，根据贸易协议，将在现有关税的基础上，最高征收15%的关税。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E7%BE%8E%E5%9B%BD%E5%AF%B9%E6%97%A5%E4%B8%AD%E7%AD%89%E5%9B%BD%E5%BE%81%E6%94%B6%E8%BF%BD%E5%8A%A0%E5%85%B3%E7%A8%8E-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E5%8F%8D%E9%A9%B3%E5%B9%B6%E8%A1%A8%E7%A4%BA%E9%81%97%E6%86%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795682365000.webp","sourceId":"rfi"},{"id":1795681621000,"createdDate":"2026-11-26 08:27","name":"法国国际广播电台","title":"宏福苑火灾一周年 港人在警力彰显中悼念","content":"今天是做成168人死亡的宏福苑大火一周年，在官方声言只许「合法悼念」的情况下，有市民陆续到受灾屋苑旁边的公园悼念，亦有团体举办图片展览让市民抒发怀念之情，而更多的，是不同宗教团体举办追思弥撒。而在周年前夕於天主教总堂举办的弥撒，满堂悼念者听着火灾遗属念出168名死者的名字，以示尊重；不过，这些人当中不包括港府高官。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261126-%E5%AE%8F%E7%A6%8F%E8%8B%91%E7%81%AB%E7%81%BE%E4%B8%80%E5%91%A8%E5%B9%B4-%E6%B8%AF%E4%BA%BA%E5%9C%A8%E8%AD%A6%E5%8A%9B%E5%BD%B0%E6%98%BE%E4%B8%AD%E6%82%BC%E5%BF%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795681621000.webp","sourceId":"rfi"},{"id":1795737103000,"createdDate":"2026-11-26 23:51","name":"法国国际广播电台","title":"陈吉宁落马：在习近平执政时期，政治忠诚正在取代专业能力","content":"就上海市委书记陈吉宁落马，法国世界报周四刊出文章表示，近年来，中国高层政治清洗的规模不断扩大，随着将于2027年秋季举行的中共第二十一次全国代表大会越来越近，中共高层政治清洗又加大了速度和力度。连仕途曾被看好的技术官僚、上海市委书记陈吉宁，也成为最新一名落马的高级官员。这一事件再次反映出，在习近平执政时期，即使身居高位、拥有专业能力和丰富行政经验，也未必能够获得政治安全保障。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261126-%E9%99%88%E5%90%89%E5%AE%81%E8%90%BD%E9%A9%AC-%E5%9C%A8%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%89%A7%E6%94%BF%E6%97%B6%E6%9C%9F%EF%BC%8C%E6%94%BF%E6%B2%BB%E5%BF%A0%E8%AF%9A%E6%AD%A3%E5%9C%A8%E5%8F%96%E4%BB%A3%E4%B8%93%E4%B8%9A%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795737103000.webp","sourceId":"rfi"},{"id":1795736924000,"createdDate":"2026-11-26 23:48","name":"法国国际广播电台","title":"乌克兰情报机构：俄罗斯和朝鲜外交现裂痕，朝鲜暂停向俄运送导弹","content":"乌克兰情报总局26日表示，朝鲜与其盟友俄罗斯爆发外交摩擦，现已暂停部分对俄军事合作，包括停止运交KN-23弹道导弹。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84-%E4%BF%84%E7%BD%97%E6%96%AF%E5%92%8C%E6%9C%9D%E9%B2%9C%E5%A4%96%E4%BA%A4%E7%8E%B0%E8%A3%82%E7%97%95%EF%BC%8C%E6%9C%9D%E9%B2%9C%E6%9A%82%E5%81%9C%E5%90%91%E4%BF%84%E8%BF%90%E9%80%81%E5%AF%BC%E5%BC%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795736924000.webp","sourceId":"rfi"},{"id":1795730001000,"createdDate":"2026-11-26 21:53","name":"法国国际广播电台","title":"报告显示亚洲移民被遣返人数激增逾11倍","content":"美国总统特朗普（DonaldTrump）第二任期移民打击行动持续扩大，亚洲移民成为受影响群体之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261126-%E6%8A%A5%E5%91%8A%E6%98%BE%E7%A4%BA%E4%BA%9A%E6%B4%B2%E7%A7%BB%E6%B0%91%E8%A2%AB%E9%81%A3%E8%BF%94%E4%BA%BA%E6%95%B0%E6%BF%80%E5%A2%9E%E9%80%BE11%E5%80%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795730001000.webp","sourceId":"rfi"},{"id":1795727938000,"createdDate":"2026-11-26 21:18","name":"法国国际广播电台","title":"为科军方维护雷达天线   两名意人遇袭身亡","content":"据称由伊朗发动的无人机袭击导致两名意大利人在科威特丧生，这是数月来海湾地区发生的首起致命袭击事件。--伊朗军方否认了此次袭击，并声称其在该地区“没有进行任何军事行动”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261126-%E4%B8%BA%E7%A7%91%E5%86%9B%E6%96%B9%E7%BB%B4%E6%8A%A4%E9%9B%B7%E8%BE%BE%E5%A4%A9%E7%BA%BF-%E4%B8%A4%E5%90%8D%E6%84%8F%E4%BA%BA%E9%81%87%E8%A2%AD%E8%BA%AB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795727938000.webp","sourceId":"rfi"},{"id":1795727638000,"createdDate":"2026-11-26 21:13","name":"法国国际广播电台","title":"特朗普对美三季度GDP增速大幅上修至4.3% 深表不满","content":"美国商务部经济分析局周三公布的数据显示，美国第三季度实际国内生产总值(GDP)按年率计算增长了4.3%，显著高于此前初值3.4%，也超过市场预期的3.5%。特朗普周四呼吁对前一天宣布的美国经济增长数据进行调查，似乎将其视为与他的阵营在11月初输掉的选举有关的损害。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261126-%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E7%BE%8E%E4%B8%89%E5%AD%A3%E5%BA%A6gdp%E5%A2%9E%E9%80%9F%E5%A4%A7%E5%B9%85%E4%B8%8A%E4%BF%AE%E8%87%B34-3-%E6%B7%B1%E8%A1%A8%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795727638000.webp","sourceId":"rfi"},{"id":1795727537000,"createdDate":"2026-11-26 21:12","name":"法国国际广播电台","title":"瑞典召见俄大使   对俄导弹侵入波兰以示抗议","content":"瑞典周四宣布召见俄罗斯大使，抗议俄罗斯导弹近期侵犯波兰领空以及据称在丹麦境内暗杀一名拥有美国和乌克兰双重国籍的公民的阴谋。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261126-%E7%91%9E%E5%85%B8%E5%8F%AC%E8%A7%81%E4%BF%84%E5%A4%A7%E4%BD%BF-%E5%AF%B9%E4%BF%84%E5%AF%BC%E5%BC%B9%E4%BE%B5%E5%85%A5%E6%B3%A2%E5%85%B0%E4%BB%A5%E7%A4%BA%E6%8A%97%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795727537000.webp","sourceId":"rfi"},{"id":1795727349000,"createdDate":"2026-11-26 21:09","name":"法国国际广播电台","title":"Rockstar Games员工否决公司内部工会的合法化提案","content":"美国游戏发行商RockstarGames员工否决了公司内部工会的合法化提案。英国独立工人联盟(IWGB)表示，如果该工会获得认可，将成为英国电子游戏行业规模最大的工会。游戏发行商近来发行的《侠盗猎车手》系列最为知名。游戏发售前已售出3250万份，首日全球零售销售额达37.9亿美元，创下娱乐产品首发销售额新纪录。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-rockstar-games%E5%91%98%E5%B7%A5%E5%90%A6%E5%86%B3%E5%85%AC%E5%8F%B8%E5%86%85%E9%83%A8%E5%B7%A5%E4%BC%9A%E7%9A%84%E5%90%88%E6%B3%95%E5%8C%96%E6%8F%90%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795727349000.webp","sourceId":"rfi"},{"id":1795727210000,"createdDate":"2026-11-26 21:06","name":"法国国际广播电台","title":"法媒：欧洲要接管一个没有中国背景的TikTok","content":"TikTok在欧洲的运营很可能需要变更所有权。德国和奥地利希望迫使TikTok的中国母公司字节跳动将其欧洲业务出售给当地投资者。两国希望效仿美国的做法。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261126-%E6%B3%95%E5%AA%92-%E6%AC%A7%E6%B4%B2%E8%A6%81%E6%8E%A5%E7%AE%A1%E4%B8%80%E4%B8%AA%E6%B2%A1%E6%9C%89%E4%B8%AD%E5%9B%BD%E8%83%8C%E6%99%AF%E7%9A%84tiktok","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795727210000.webp","sourceId":"rfi"},{"id":1795726941000,"createdDate":"2026-11-26 21:02","name":"法国国际广播电台","title":"英欧允每年10万青年互赴工作留学    学费仍未落实","content":"英国政府周四向议会提交了一份旨在落实与布鲁塞尔就贸易和能源达成的协议的法案草案，但由于尚未就欧洲学生赴英留学达成协议，该法案的实施仍存在不确定性。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261126-%E8%8B%B1%E6%AC%A7%E5%85%81%E6%AF%8F%E5%B9%B410%E4%B8%87%E9%9D%92%E5%B9%B4%E4%BA%92%E8%B5%B4%E5%B7%A5%E4%BD%9C%E7%95%99%E5%AD%A6-%E5%AD%A6%E8%B4%B9%E4%BB%8D%E6%9C%AA%E8%90%BD%E5%AE%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795726941000.webp","sourceId":"rfi"},{"id":1795726770000,"createdDate":"2026-11-26 20:59","name":"法国国际广播电台","title":"中男足国家队的最年轻球员赵松源","content":"在U17世界杯的初期阶段，中国U17男足前锋赵松源就已展现出惊人的天赋，在中国国内引发广泛关注。这位身高1.94米的17岁前锋，被誉为“伊布拉希莫维奇”，他的经历也如同他的背景一样非同寻常：他目前仍在读高中，并且没有加入任何职业俱乐部。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261126-%E4%B8%AD%E7%94%B7%E8%B6%B3%E5%9B%BD%E5%AE%B6%E9%98%9F%E7%9A%84%E6%9C%80%E5%B9%B4%E8%BD%BB%E7%90%83%E5%91%98%E8%B5%B5%E6%9D%BE%E6%BA%90","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795726770000.webp","sourceId":"rfi"},{"id":1795726537000,"createdDate":"2026-11-26 20:55","name":"法国国际广播电台","title":"西度假胜地外海油轮沉没   当局严防海洋污染","content":"11月26日凌晨，一艘悬挂马耳他国旗、载有约7000吨柴油/燃油的油轮“MedEmre”号在西班牙伊维萨岛（Ibiza）附近海域发生进水倾覆事故（最初报道为沉没，后搜救发现船体翻转漂浮），造成1名船员死亡、6名船员轻伤。根据Kpler公司的海事跟踪数据，这艘油轮载有约6.6万桶成品油。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261126-%E8%A5%BF%E5%BA%A6%E5%81%87%E8%83%9C%E5%9C%B0%E5%A4%96%E6%B5%B7%E6%B2%B9%E8%BD%AE%E6%B2%89%E6%B2%A1-%E5%BD%93%E5%B1%80%E4%B8%A5%E9%98%B2%E6%B5%B7%E6%B4%8B%E6%B1%A1%E6%9F%93","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795726537000.webp","sourceId":"rfi"},{"id":1795726405000,"createdDate":"2026-11-26 20:53","name":"法国国际广播电台","title":"法国总统大选：极左极右都不支持乌克兰 等待温和中派组成大联盟","content":"法国明年春天将举行总统大选，最新民调显示极右派领袖玛琳．勒庞与极左派领袖梅兰雄声势看涨，很可能双双挺进第二轮决选。处于法国政治光谱极右和极左两端的这两人，在乌克兰问题上却有类似的立场，他们都质疑对乌克兰的支持和援助。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261126-%E6%B3%95%E5%9B%BD%E6%80%BB%E7%BB%9F%E5%A4%A7%E9%80%89-%E6%9E%81%E5%B7%A6%E6%9E%81%E5%8F%B3%E9%83%BD%E4%B8%8D%E6%94%AF%E6%8C%81%E4%B9%8C%E5%85%8B%E5%85%B0-%E7%AD%89%E5%BE%85%E6%B8%A9%E5%92%8C%E4%B8%AD%E6%B4%BE%E7%BB%84%E6%88%90%E5%A4%A7%E8%81%94%E7%9B%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795726405000.webp","sourceId":"rfi"},{"id":1795722269000,"createdDate":"2026-11-26 19:44","name":"法国国际广播电台","title":"感恩节之际特朗普敦促普京停战 欧盟启动第22轮对俄制裁","content":"美国总统特朗普11月26日发文说：他已敦促俄罗斯总统普京停止在欧洲的所有军事侵略，并认为俄国与乌克兰可以迅速达成协议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261126-%E6%84%9F%E6%81%A9%E8%8A%82%E4%B9%8B%E9%99%85%E7%89%B9%E6%9C%97%E6%99%AE%E6%95%A6%E4%BF%83%E6%99%AE%E4%BA%AC%E5%81%9C%E6%88%98-%E6%AC%A7%E7%9B%9F%E5%90%AF%E5%8A%A8%E7%AC%AC22%E8%BD%AE%E5%AF%B9%E4%BF%84%E5%88%B6%E8%A3%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795722269000.webp","sourceId":"rfi"},{"id":1795722028000,"createdDate":"2026-11-26 19:40","name":"法国国际广播电台","title":"法二人电子音乐组合在《侠盗猎车手VI》大放异彩","content":"作为全球文化现象级电子游戏《侠盗猎车手VI》（GTAVI）原声带的创作者，法国电子音乐二人组Justice（由GaspardAugé和XavierdeRosnay组成）于周四表达了他们参与这一非凡音乐项目的“自豪感”。游戏发布后，Justice的歌曲便登上了Spotify全球流媒体排行榜榜首。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-%E6%B3%95%E4%BA%8C%E4%BA%BA%E7%94%B5%E5%AD%90%E9%9F%B3%E4%B9%90%E7%BB%84%E5%90%88%E5%9C%A8-%E4%BE%A0%E7%9B%97%E7%8C%8E%E8%BD%A6%E6%89%8Bvi-%E5%A4%A7%E6%94%BE%E5%BC%82%E5%BD%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795722028000.webp","sourceId":"rfi"},{"id":1795711434000,"createdDate":"2026-11-26 16:43","name":"法国国际广播电台","title":"AI新云被告知若算力出租给中国公司，将无法购买英伟达芯片","content":"据知情人士向消费者新闻与商业频道（CNBC）透露，AI新云（neoclouds）公司被告知，如果计算能力中有任何部分将被中国公司租用，将无法购买英伟达芯片。所谓AI新云是一类专注于为人工智能工作负载提供高性能图形处理器（GPU）算力租赁服务的新型云计算服务商。在此之前，特朗普政府于11月16日发布了一项新规定，旨在限制对人工智能半导体的远程访问。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-ai%E6%96%B0%E4%BA%91%E8%A2%AB%E5%91%8A%E7%9F%A5%E8%8B%A5%E7%AE%97%E5%8A%9B%E5%87%BA%E7%A7%9F%E7%BB%99%E4%B8%AD%E5%9B%BD%E5%85%AC%E5%8F%B8%EF%BC%8C%E5%B0%86%E6%97%A0%E6%B3%95%E8%B4%AD%E4%B9%B0%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795711434000.webp","sourceId":"rfi"},{"id":1795709319000,"createdDate":"2026-11-26 16:08","name":"法国国际广播电台","title":"美国会关于禁止进口中国汽车的两党立法有望年内通过","content":"据政客新闻网报导，今年，美国国会通过一项禁止进口中国汽车的两党立法，其可能性正日益增加；该法案在美国参议院的支持者已成功争取到了汽车行业关键力量的认可。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261126-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E5%85%B3%E4%BA%8E%E7%A6%81%E6%AD%A2%E8%BF%9B%E5%8F%A3%E4%B8%AD%E5%9B%BD%E6%B1%BD%E8%BD%A6%E7%9A%84%E4%B8%A4%E5%85%9A%E7%AB%8B%E6%B3%95%E6%9C%89%E6%9C%9B%E5%B9%B4%E5%86%85%E9%80%9A%E8%BF%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795709319000.webp","sourceId":"rfi"},{"id":1795707017000,"createdDate":"2026-11-26 15:30","name":"法国国际广播电台","title":"金正恩视察核设施提发展战术核武器：绝不会寻求任何人承认或批准","content":"据朝中社报导，朝鲜最高领导人金正恩周三（25日）对核材料生产及核武器研究部门的工作进行了现场指导。报导称，金正恩先后视察了武器级核材料生产基地、核动力相关设备生产基地以及核武器研究所，听取并总结了2026年度核材料及核武器生产部门为落实劳动党第九次代表大会所提出的核战略计划而开展的各项活动。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E9%87%91%E6%AD%A3%E6%81%A9%E8%A7%86%E5%AF%9F%E6%A0%B8%E8%AE%BE%E6%96%BD%E6%8F%90%E5%8F%91%E5%B1%95%E6%88%98%E6%9C%AF%E6%A0%B8%E6%AD%A6%E5%99%A8-%E7%BB%9D%E4%B8%8D%E4%BC%9A%E5%AF%BB%E6%B1%82%E4%BB%BB%E4%BD%95%E4%BA%BA%E6%89%BF%E8%AE%A4%E6%88%96%E6%89%B9%E5%87%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795707017000.webp","sourceId":"rfi"},{"id":1795705446000,"createdDate":"2026-11-26 15:04","name":"法国国际广播电台","title":"涉嫌间谍活动的北约加拿大华裔实习生将继续被羁押","content":"比利时检方周四表示， 一名因涉嫌间谍活动而在比利时被捕的加拿大籍北约实习生，在针对关于将其释放并实施电子监控的法院裁决提出上诉期间，将继续被羁押。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261126-%E6%B6%89%E5%AB%8C%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E5%8C%97%E7%BA%A6%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%8D%8E%E8%A3%94%E5%AE%9E%E4%B9%A0%E7%94%9F%E5%B0%86%E7%BB%A7%E7%BB%AD%E8%A2%AB%E7%BE%81%E6%8A%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795705446000.webp","sourceId":"rfi"},{"id":1795703997000,"createdDate":"2026-11-26 14:39","name":"法国国际广播电台","title":"中俄两军举行战略磋商 日本修订安保文件拟提中俄朝军事合作深化","content":"据中国国防部网站消息，中俄两军周四（26日）以视频会议方式举行战略磋商。中方新闻稿称，“双方围绕落实两国元首共识、推动两军关系持续深化拓展进行交流，就国际和地区形势深入交换意见，表示两军将进一步加强沟通协作，共同维护国际和地区安全稳定”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E4%B8%AD%E4%BF%84%E5%9B%BD%E9%98%B2%E9%83%A8%E4%B8%BE%E8%A1%8C%E9%A6%96%E8%BD%AE%E6%88%98%E7%95%A5%E7%A3%8B%E5%95%86-%E6%97%A5%E6%9C%AC%E4%BF%AE%E8%AE%A2%E5%AE%89%E4%BF%9D%E6%96%87%E4%BB%B6%E6%8B%9F%E6%8F%90%E4%B8%AD%E4%BF%84%E6%9C%9D%E5%86%9B%E4%BA%8B%E5%90%88%E4%BD%9C%E6%B7%B1%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795703997000.webp","sourceId":"rfi"},{"id":1795699555000,"createdDate":"2026-11-26 13:25","name":"法国国际广播电台","title":"《费加罗报》：中国在特朗普的帮助下试图孤立日本","content":"26日出版的法国全国性大报特别关注的国内国际话题有：欧盟围绕2028-2034七年预算案的讨论以及围绕是否继续向乌克兰提供财政支持议题的内部分歧、美国特朗普政府对贸易伙伴推出的新一波关税措施、西班牙在围绕住房危机的社会紧张关系背景下的立法选举、比亚迪汽车可能通过企业收购登陆法国引发的广泛关注、伊朗政权进一步升级对社会的控制的努力、法国总统竞选争夺背景下的全国市长大会、等等。关于中国，《回声报》刊登文章，关注上海市委书记陈吉宁落马的消息。《费加罗报》刊登文章，聚焦一周前落幕的亚太经合组织深圳峰会上，中国国家主席习近平孤立日本首相的努力，认为这项努力得到了特朗普的帮助。该报深圳特派记者SébastienFalletti的文章也特别介绍日本软实力对中国政府的民族主义叙事的挑战。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261126-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E5%B8%AE%E5%8A%A9%E4%B8%8B%E8%AF%95%E5%9B%BE%E5%AD%A4%E7%AB%8B%E6%97%A5%E6%9C%AC","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795699555000.webp","sourceId":"rfi"},{"id":1795698183000,"createdDate":"2026-11-26 13:03","name":"法国国际广播电台","title":"调查揭示中资加州公司购买英伟达受限尖端芯片漏洞","content":"据哥伦比亚广播公司（CBS）的一项调查发现，英伟达正将其最尖端的芯片出售给至少两家总部位于美国、但实际由中国企业控制的公司。这一情况引发了新的质疑：在防止敏感技术落入美国竞争对手手中这一问题上，相关管控措施是否有效。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-%E8%B0%83%E6%9F%A5%E6%8F%AD%E7%A4%BA%E4%B8%AD%E8%B5%84%E5%8A%A0%E5%B7%9E%E5%85%AC%E5%8F%B8%E8%B4%AD%E4%B9%B0%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%8F%97%E9%99%90%E5%B0%96%E7%AB%AF%E8%8A%AF%E7%89%87%E6%BC%8F%E6%B4%9E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795698183000.webp","sourceId":"rfi"},{"id":1795695315000,"createdDate":"2026-11-26 12:15","name":"法国国际广播电台","title":"德国顶级经济学家建议将大众汽车出售给中国：“趁我们还能卖个好价钱”","content":"据德国《商报》报道：在一场工业会议上，德国顶级经济学家、基尔世界经济研究所所长舒拉里克（MoritzSchularick）的一番言论引起全场震动。他提出的建议直指德国汽车工业巨头大众汽车（VW），在大众看来，这无疑是一种有意的挑衅。这位经济学家甚至认为，德国在汽车制造领域已经沦为一个“发展中国家”。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261126-%E5%BE%B7%E5%9B%BD%E9%A1%B6%E7%BA%A7%E7%BB%8F%E6%B5%8E%E5%AD%A6%E5%AE%B6%E5%BB%BA%E8%AE%AE%E5%B0%86%E5%A4%A7%E4%BC%97%E6%B1%BD%E8%BD%A6%E5%87%BA%E5%94%AE%E7%BB%99%E4%B8%AD%E5%9B%BD-%E8%B6%81%E6%88%91%E4%BB%AC%E8%BF%98%E8%83%BD%E5%8D%96%E4%B8%AA%E5%A5%BD%E4%BB%B7%E9%92%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795695315000.webp","sourceId":"rfi"},{"id":1795691427000,"createdDate":"2026-11-26 11:10","name":"法国国际广播电台","title":"尼泊尔启动程序将宣布8月洪灾中失踪的人员死亡","content":"在边境地区发生自然灾难三个月后，尼泊尔政府周四宣布，已开始启动程序，将依法宣布今夏灾难性洪灾后仍失踪的数千人死亡。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E5%B0%BC%E6%B3%8A%E5%B0%94%E5%90%AF%E5%8A%A8%E7%A8%8B%E5%BA%8F%E5%B0%86%E5%AE%A3%E5%B8%838%E6%9C%88%E6%B4%AA%E7%81%BE%E4%B8%AD%E5%A4%B1%E8%B8%AA%E7%9A%84%E4%BA%BA%E5%91%98%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795691427000.webp","sourceId":"rfi"},{"id":1795691129000,"createdDate":"2026-11-26 11:05","name":"法国国际广播电台","title":"东亚地缘政治格局正在悄然改变","content":"2026年11月，从中国深圳亚太经合组织峰会的大国元首会晤，到缅甸总统首次访问越南出席多边会议，一北一南两场外交大戏登场，正推动亚太地缘政治发生一场前所未有的变局。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261126-%E4%B8%9C%E4%BA%9A%E5%9C%B0%E7%BC%98%E6%94%BF%E6%B2%BB%E6%A0%BC%E5%B1%80%E6%AD%A3%E5%9C%A8%E6%82%84%E7%84%B6%E6%94%B9%E5%8F%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795691129000.webp","sourceId":"rfi"},{"id":1795689988000,"createdDate":"2026-11-26 10:46","name":"法国国际广播电台","title":"美芯片、算力等限制及对蒸馏防范加强迫使中国AI模型发展放缓","content":"据路透社援引知情人士报导，中国人工智能公司智谱AI（Z.AI）的下一代旗舰模型开发进度已落后于原定计划；与此同时，竞争对手月之暗面（MoonshotAI）则预计，如果无法继续获取海外算力资源，其重大模型版本的发布间隔可能会从六个月延长至一年甚至更久。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261126-%E7%BE%8E%E8%8A%AF%E7%89%87%E7%AE%97%E5%8A%9B%E7%AD%89%E9%99%90%E5%88%B6%E5%8F%8A%E5%AF%B9%E8%92%B8%E9%A6%8F%E9%98%B2%E8%8C%83%E5%8A%A0%E5%BC%BA%E8%BF%AB%E4%BD%BF%E4%B8%AD%E5%9B%BDai%E6%A8%A1%E5%9E%8B%E5%8F%91%E5%B1%95%E6%94%BE%E7%BC%93","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795689988000.webp","sourceId":"rfi"},{"id":1795689283000,"createdDate":"2026-11-26 10:34","name":"法国国际广播电台","title":"欧盟峰会聚焦长期预算：如何协调450亿对乌克兰贷款等的分歧？","content":"11月26日，欧盟领导人在比利时布鲁塞尔举行峰会，重点讨论2028年至2034年的长期预算安排，以及向乌克兰提供新一轮450亿欧元贷款的计划。此次会议的主要挑战包括如何弥合成员国在预算规模和资金分配上的分歧，尤其是面对乌克兰明年的经济和军事需求，欧盟可以提供何种现实可行的支持。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261126-%E6%AC%A7%E7%9B%9F%E5%B3%B0%E4%BC%9A%E8%81%9A%E7%84%A6%E9%95%BF%E6%9C%9F%E9%A2%84%E7%AE%97-%E5%A6%82%E4%BD%95%E5%8D%8F%E8%B0%83450%E4%BA%BF%E5%AF%B9%E4%B9%8C%E5%85%8B%E5%85%B0%E8%B4%B7%E6%AC%BE%E7%AD%89%E7%9A%84%E5%88%86%E6%AD%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795689283000.webp","sourceId":"rfi"},{"id":1795687162000,"createdDate":"2026-11-26 09:59","name":"法国国际广播电台","title":"美情报机构知晓黄乐至少从去年春季起就与国安部官员有联系","content":"据哥伦比亚广播公司（CBS）援引熟悉简报情况的人士报导称，美国情报官员周二向国会工作人员表示，在黄乐与英伟达首席执行官黄仁勋之间的婚外情开始后，中国国家安全部或曾对黄乐实施监视，并从她那里获取信息。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-%E7%BE%8E%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E7%9F%A5%E6%99%93%E9%BB%84%E4%B9%90%E8%87%B3%E5%B0%91%E4%BB%8E%E5%8E%BB%E5%B9%B4%E6%98%A5%E5%AD%A3%E8%B5%B7%E5%B0%B1%E4%B8%8E%E5%9B%BD%E5%AE%89%E9%83%A8%E5%AE%98%E5%91%98%E6%9C%89%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795687162000.webp","sourceId":"rfi"},{"id":1795686252000,"createdDate":"2026-11-26 09:44","name":"法国国际广播电台","title":"李在明内阁重大改组，涉外交部长、统一部部长、情报院长等","content":"日前，韩国总统李在明出人意料地宣布对内阁进行改组，调整与韩国国家安全密切相关的职位，其中就包括统一部部长一职。路透社11月26日消息，该部部长官提名人洪翼杓（音）表示，他打算采取“现实主义”的方式，推动改善韩国与朝鲜的关系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261126-%E6%9D%8E%E5%9C%A8%E6%98%8E%E5%86%85%E9%98%81%E9%87%8D%E5%A4%A7%E6%94%B9%E7%BB%84%EF%BC%8C%E6%B6%89%E5%A4%96%E4%BA%A4%E9%83%A8%E9%95%BF-%E7%BB%9F%E4%B8%80%E9%83%A8%E9%83%A8%E9%95%BF-%E6%83%85%E6%8A%A5%E9%99%A2%E9%95%BF%E7%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795686252000.webp","sourceId":"rfi"},{"id":1795683695000,"createdDate":"2026-11-26 09:01","name":"法国国际广播电台","title":"英伟达告知戴尔等合作商停止向新马泰印尼四国发送服务器","content":"随着英伟达和黄仁勋事件引发对相关问题的关注，美国开始加强出口管制措施，旨在防止中国获取先进人工智能（AI）算力，英伟达已要求其制造合作伙伴停止向四个东南亚国家发运服务器。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261126-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%91%8A%E7%9F%A5%E6%88%B4%E5%B0%94%E7%AD%89%E5%90%88%E4%BD%9C%E5%95%86%E5%81%9C%E6%AD%A2%E5%90%91%E6%96%B0%E9%A9%AC%E6%B3%B0%E5%8D%B0%E5%B0%BC%E5%9B%9B%E5%9B%BD%E5%8F%91%E9%80%81%E6%9C%8D%E5%8A%A1%E5%99%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/26/1795683695000.webp","sourceId":"rfi"}]