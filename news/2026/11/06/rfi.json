[{"id":1793980798000,"createdDate":"2026-11-06 15:59","name":"法国国际广播电台","title":"黄之锋重判10年 鲁比奥：美国强烈谴责，呼吁立即释放","content":"美国国务卿鲁比奥（MarcoRubio）周五通过社媒平台X发文称，“美国强烈谴责香港法院再次判处黄之锋因行使言论自由而入狱的决定。他一直以和平方式捍卫香港所有个人被承诺过的权利。我们呼吁立即将他释放以及释放所有被不公正拘留的人士”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E9%B2%81%E6%AF%94%E5%A5%A5-%E7%BE%8E%E5%9B%BD%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3%E9%A6%99%E6%B8%AF%E6%B3%95%E9%99%A2%E5%86%8D%E6%AC%A1%E5%88%A4%E5%A4%84%E9%BB%84%E4%B9%8B%E9%94%8B%E5%9B%A0%E8%A1%8C%E4%BD%BF%E8%A8%80%E8%AE%BA%E8%87%AA%E7%94%B1%E8%80%8C%E5%85%A5%E7%8B%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793980798000.webp","sourceId":"rfi"},{"id":1793979799000,"createdDate":"2026-11-06 15:43","name":"法国国际广播电台","title":"打击走私 英伟达采取措施加强在东南亚的芯片追踪","content":"英伟达正在加强对在东南亚销售的人工智能加速器的追踪，这是该公司为遏制半导体走私而采取的一项战略举措。此前，英伟达因未采取足够措施来阻止非法货物运往中国企业而受到批评。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261106-%E6%89%93%E5%87%BB%E8%B5%B0%E7%A7%81-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E9%87%87%E5%8F%96%E6%8E%AA%E6%96%BD%E5%8A%A0%E5%BC%BA%E5%9C%A8%E4%B8%9C%E5%8D%97%E4%BA%9A%E7%9A%84%E8%8A%AF%E7%89%87%E8%BF%BD%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793979799000.webp","sourceId":"rfi"},{"id":1793976807000,"createdDate":"2026-11-06 14:53","name":"法国国际广播电台","title":"欧委会初步认定TikTok为你推荐信息流存在兔子洞效应 违反《数字服务法》","content":"欧盟科技监管机构周五指控社交媒体平台TikTok违反了欧盟的在线内容规则，并要求其整改推荐系统的所谓“兔子洞效应”。该系统会将用户的注意力吸引到源源不断的类似视频中。监管机构表示，如果TikTok的中国母公司字节跳动无法解决这一问题，明年可能面临至高其全球年营业额6%的罚款。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%AC%A7%E5%A7%94%E4%BC%9A%E5%88%9D%E6%AD%A5%E8%AE%A4%E5%AE%9Atiktok%E4%B8%BA%E4%BD%A0%E6%8E%A8%E8%8D%90%E4%BF%A1%E6%81%AF%E6%B5%81%E5%AD%98%E5%9C%A8%E5%85%94%E5%AD%90%E6%B4%9E%E6%95%88%E5%BA%94-%E8%BF%9D%E5%8F%8D-%E6%95%B0%E5%AD%97%E6%9C%8D%E5%8A%A1%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793976807000.webp","sourceId":"rfi"},{"id":1793975009000,"createdDate":"2026-11-06 14:23","name":"法国国际广播电台","title":"意检方结束对“李老师”遭跟踪监视威胁案调查 4嫌疑人最高可判7年监禁","content":"意大利检方结束了一项调查，他们指该网络与中国当局有关联，多年来一直跟踪、恐吓和骚扰居住在意大利的网名为“李老师不是你老师”的社媒博主李颖。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%84%8F%E6%A3%80%E6%96%B9%E7%BB%93%E6%9D%9F%E5%AF%B9-%E6%9D%8E%E8%80%81%E5%B8%88-%E9%81%AD%E8%B7%9F%E8%B8%AA%E7%9B%91%E8%A7%86%E5%A8%81%E8%83%81%E6%A1%88%E8%B0%83%E6%9F%A5-4%E5%AB%8C%E7%96%91%E4%BA%BA%E6%9C%80%E9%AB%98%E5%8F%AF%E5%88%A47%E5%B9%B4%E7%9B%91%E7%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793975009000.webp","sourceId":"rfi"},{"id":1793970637000,"createdDate":"2026-11-06 13:10","name":"法国国际广播电台","title":"黄之锋重判10年 美英法德日意澳加等10国外交部发联合声明 促当局履行国际承诺","content":"包括美国、英国、德国和法国在内的十个国家政府周五发布联合声明，谴责香港民主活动人士黄之锋被判处10年监禁。此前，正就初选47人案服刑的前香港众志秘书长黄之锋，去年6月在狱中被捕，被控2020年串谋勾结罗冠聪等危害国安。他今年9月认罪，周四在高等法院被判囚10年，当中两个月零两日与47人案刑期同期执行，即黄之锋被加监9年10个月。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261106-%E9%BB%84%E4%B9%8B%E9%94%8B%E9%87%8D%E5%88%A410%E5%B9%B4-%E7%BE%8E%E8%8B%B1%E6%B3%95%E5%BE%B7%E6%97%A5%E6%84%8F%E6%BE%B3%E5%8A%A0%E7%AD%8910%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%91%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E-%E4%BF%83%E5%BD%93%E5%B1%80%E5%B1%A5%E8%A1%8C%E5%9B%BD%E9%99%85%E6%89%BF%E8%AF%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793970637000.webp","sourceId":"rfi"},{"id":1793968878000,"createdDate":"2026-11-06 12:41","name":"法国国际广播电台","title":"积压许久的刘德华主演抗疫题材电影《白衣逆行者》疑撤档","content":"综合消息显示，由香港导演邱礼涛执导、影星刘德华和杨子姗等主演的电影《白衣逆行者》原定于11月6日在中国全国上映，并曾通过央视电影频道《中国电影报道》等渠道宣传，但随后在11月6日上映前夕出现疑似临时撤档或调整情况，目前在部分购票平台暂无法正常购票，豆瓣等平台显示上映日期已改为空白或延后。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261106-%E7%A7%AF%E5%8E%8B%E8%AE%B8%E4%B9%85%E7%9A%84%E5%88%98%E5%BE%B7%E5%8D%8E%E4%B8%BB%E6%BC%94%E6%8A%97%E7%96%AB%E9%A2%98%E6%9D%90%E7%94%B5%E5%BD%B1-%E7%99%BD%E8%A1%A3%E9%80%86%E8%A1%8C%E8%80%85-%E7%96%91%E6%92%A4%E6%A1%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793968878000.webp","sourceId":"rfi"},{"id":1793965445000,"createdDate":"2026-11-06 11:44","name":"法国国际广播电台","title":"打击跨国电诈 美国制裁太子集团41关联实体及4个人","content":"美国财政部周四宣布对与总部位于柬埔寨的太子集团有关联的4名个人和41个实体实施制裁。美国国务院发言人皮戈特（TommyPigott）当天通过新闻稿表示，“今天，美国对与总部位于柬埔寨的太子集团跨国犯罪组织有关联的4名个人和41家实体实施制裁，此举是继2025年10月和2026年6月针对该组织头目、关联公司及金融协助者实施制裁后的又一举措。这些制裁措施由美国财政部海外资产控制办公室负责执行”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261106-%E6%89%93%E5%87%BB%E8%B7%A8%E5%9B%BD%E7%94%B5%E8%AF%88-%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E5%A4%AA%E5%AD%90%E9%9B%86%E5%9B%A241%E5%85%B3%E8%81%94%E4%BC%81%E4%B8%9A%E5%8F%8A4%E4%B8%AA%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793965445000.webp","sourceId":"rfi"},{"id":1793963073000,"createdDate":"2026-11-06 11:04","name":"法国国际广播电台","title":"民主党夺回两院，如何影响美中关系？","content":"美国民主党在11月3日国会期中选举中大胜，夺回众议院及参议院控制权，重挫总统特朗普（DonaldTrump）及共和党，为未来两年美国对华政策增添变数。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261106-%E6%B0%91%E4%B8%BB%E5%85%9A%E5%A4%BA%E5%9B%9E%E4%B8%A4%E9%99%A2%EF%BC%8C%E5%A6%82%E4%BD%95%E5%BD%B1%E5%93%8D%E7%BE%8E%E4%B8%AD%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793963073000.webp","sourceId":"rfi"},{"id":1793961034000,"createdDate":"2026-11-06 10:30","name":"法国国际广播电台","title":"请注意，法国正在召回这些酸奶；它们可能含有玻璃碎片","content":"法国媒体呼吁消费者要注意，法国正在召回一些酸奶，因它们可能含有玻璃碎片。法国的Auchan、SuperU和E.Leclerc三大超商集团销售的这些酸奶已被紧急召回。以下是受影响的批次。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261106-%E8%AF%B7%E6%B3%A8%E6%84%8F%EF%BC%8C%E6%B3%95%E5%9B%BD%E6%AD%A3%E5%9C%A8%E5%8F%AC%E5%9B%9E%E8%BF%99%E4%BA%9B%E9%85%B8%E5%A5%B6-%E5%AE%83%E4%BB%AC%E5%8F%AF%E8%83%BD%E5%90%AB%E6%9C%89%E7%8E%BB%E7%92%83%E7%A2%8E%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793961034000.webp","sourceId":"rfi"},{"id":1793959552000,"createdDate":"2026-11-06 10:05","name":"法国国际广播电台","title":"调查：币安黑客开始透过中国洗钱网络转移资金","content":"彭博周四报道称，根据区块链分析公司Chainalysis最新调查，涉嫌窃取币安（Binance）约63亿美元加密资产的黑客，正透过中国的洗钱网络，试图将部分赃款转换为现金。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261106-%E8%B0%83%E6%9F%A5-%E5%B8%81%E5%AE%89%E9%BB%91%E5%AE%A2%E5%BC%80%E5%A7%8B%E9%80%8F%E8%BF%87%E4%B8%AD%E5%9B%BD%E6%B4%97%E9%92%B1%E7%BD%91%E7%BB%9C%E8%BD%AC%E7%A7%BB%E8%B5%84%E9%87%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793959552000.webp","sourceId":"rfi"},{"id":1793959000000,"createdDate":"2026-11-06 09:56","name":"法国国际广播电台","title":"中国对原产于欧盟的乙叉降冰片烯和对位芳纶长丝发起反倾销调查","content":"中国商务部周五（6日）接连发布两份公告，分别宣布对原产于欧盟、日本的进口乙叉降冰片烯发起反倾销立案调查以及对原产于欧盟的进口对位芳纶长丝发起反倾销立案调查。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261106-%E4%B8%AD%E5%9B%BD%E5%AF%B9%E5%8E%9F%E4%BA%A7%E4%BA%8E%E6%AC%A7%E7%9B%9F%E7%9A%84%E4%B9%99%E5%8F%89%E9%99%8D%E5%86%B0%E7%89%87%E7%83%AF%E5%92%8C%E5%AF%B9%E4%BD%8D%E8%8A%B3%E7%BA%B6%E9%95%BF%E4%B8%9D%E5%8F%91%E8%B5%B7%E5%8F%8D%E5%80%BE%E9%94%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793959000000.webp","sourceId":"rfi"},{"id":1793958057000,"createdDate":"2026-11-06 09:40","name":"法国国际广播电台","title":"万公不死: 万公润南逝世周年祭","content":"哪里是家园，安放死者的摇篮——北岛《歧路行》","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261106-%E4%B8%87%E5%85%AC%E4%B8%8D%E6%AD%BB-%E4%B8%87%E5%85%AC%E6%B6%A6%E5%8D%97%E9%80%9D%E4%B8%96%E5%91%A8%E5%B9%B4%E7%A5%AD","thumbnail":"","detailImage":"","sourceId":"rfi"},{"id":1793957530000,"createdDate":"2026-11-06 09:32","name":"法国国际广播电台","title":"美众院三委员会主席致信黄仁勋 要求出席闭门简报会 说明与中国女高管往来","content":"美国国会众议院的三位共和党籍委员会主席致信要求英伟达首席执行官黄仁勋出席联席闭门简报会，以了解他与一位被指是中国情报资产的科技公司高管之间的往来等信息。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261106-%E7%BE%8E%E4%BC%97%E9%99%A2%E4%B8%89%E5%A7%94%E5%91%98%E4%BC%9A%E4%B8%BB%E5%B8%AD%E8%87%B4%E4%BF%A1%E9%BB%84%E4%BB%81%E5%8B%8B-%E8%A6%81%E6%B1%82%E5%87%BA%E5%B8%AD%E9%97%AD%E9%97%A8%E7%AE%80%E6%8A%A5%E4%BC%9A-%E8%AF%B4%E6%98%8E%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%A5%B3%E9%AB%98%E7%AE%A1%E5%BE%80%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793957530000.webp","sourceId":"rfi"},{"id":1793957287000,"createdDate":"2026-11-06 09:28","name":"法国国际广播电台","title":"加国助十万香港和乌克兰人获永居权 保守党反对增加移民配额","content":"加拿大联邦政府过去两年大刀阔斧缩减移民配额后，周四向国会提出新的计划，将会以人道为理由，在2027年额外拨出20万个永久居留权名额，主要留给已在加拿大的香港和乌克兰人，以及有人道需要的人士。在野保守党大力反对，指大幅增加移民配额只会损害加拿大人利益。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E5%8A%A0%E5%9B%BD%E5%8A%A9%E5%8D%81%E4%B8%87%E9%A6%99%E6%B8%AF%E5%92%8C%E4%B9%8C%E5%85%8B%E5%85%B0%E4%BA%BA%E8%8E%B7%E6%B0%B8%E5%B1%85%E6%9D%83-%E4%BF%9D%E5%AE%88%E5%85%9A%E5%8F%8D%E5%AF%B9%E5%A2%9E%E5%8A%A0%E7%A7%BB%E6%B0%91%E9%85%8D%E9%A2%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793957287000.webp","sourceId":"rfi"},{"id":1793954632000,"createdDate":"2026-11-06 08:43","name":"法国国际广播电台","title":"高市首相“台湾有事”发言一周年  日本官房长官避谈撤回发言","content":"日本内阁官房长官木原稔在11月6日的记者会上，就去年11月7日高市早苗首相在国会答辩中表示台湾有事“可能构成存亡危机事态”一事强调，正如1972年《日中联合声明》所表明的那样，日本充分理解并尊重中国有关台湾问题“一个中国”的立场，对此“没有任何改变”。他回避了是否会接受中方撤回相关言论的要求。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8-%E5%8F%B0%E6%B9%BE%E6%9C%89%E4%BA%8B-%E5%8F%91%E8%A8%80%E4%B8%80%E5%91%A8%E5%B9%B4-%E6%97%A5%E6%9C%AC%E5%AE%98%E6%88%BF%E9%95%BF%E5%AE%98%E9%81%BF%E8%B0%88%E6%92%A4%E5%9B%9E%E5%8F%91%E8%A8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793954632000.webp","sourceId":"rfi"},{"id":1793954323000,"createdDate":"2026-11-06 08:38","name":"法国国际广播电台","title":"欧洲思想文化长廊：希腊：欧洲文化永不磨灭的光辉：美狄亚：复仇的女性","content":"《美狄亚》是欧里庇德斯最著名的一部戏剧，它表现了女性在遭受男性背叛与羞辱之后所采取的极端报复行动。可以说它把人类爱恨情仇的极端表现展示在舞台上。有人问，美狄亚的疯狂举动毫无边界，这报复合理吗？她的行为在哪种伦理的意义上有正当性呢？我们来看看欧里庇德斯的解说。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E7%BE%8E%E7%8B%84%E4%BA%9A-%E5%A4%8D%E4%BB%87%E7%9A%84%E5%A5%B3%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793954323000.webp","sourceId":"rfi"},{"id":1793954078000,"createdDate":"2026-11-06 08:34","name":"法国国际广播电台","title":"首案：澳门民主派前议员区锦新因颠覆等罪判监12年半 人权组织批过程不公吁放人","content":"经闭门审讯和官派律师作辩方代表後，澳门前立法会议员区锦新今(6日)早被当地初级法院裁定，其颠覆国家政权、与境外组织联系危害国家安全，以及违反保密等多项罪名成立，判处监禁12年半，成为澳门制定《维护国家安全法》以来首宗公开案例。人权观察指责澳门藉案件向批评者发出令人不寒而栗的警告，而审讯过程亦不公平及不正当，促葡萄牙和欧盟强力敦促澳门立即释放区锦新。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E9%A6%96%E6%A1%88-%E6%BE%B3%E9%97%A8%E6%B0%91%E4%B8%BB%E6%B4%BE%E5%89%8D%E8%AE%AE%E5%91%98%E5%8C%BA%E9%94%A6%E6%96%B0%E5%9B%A0%E9%A2%A0%E8%A6%86%E7%AD%89%E7%BD%AA%E5%88%A4%E7%9B%9112%E5%B9%B4%E5%8D%8A-%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E6%89%B9%E8%BF%87%E7%A8%8B%E4%B8%8D%E5%85%AC%E5%90%81%E6%94%BE%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793954078000.webp","sourceId":"rfi"},{"id":1793953488000,"createdDate":"2026-11-06 08:24","name":"法国国际广播电台","title":"黄之锋再被重判10年 昔日战友齐批刑期过重  罗冠聪：法庭服膺于北京旨意","content":"前香港众志秘书长黄之锋因串谋勾结外国势力罪遭法院重判监禁10年，被指涉案丶已流亡海外的香港众志前主席罗冠聪批评，官方把参与民主运动的黄之锋丶戴耀廷和黎智英描绘为「幕后黑手」，再罗织罪名，把三人判处轸刑，显示香港法庭已服膺于北京旨意。法律学者亦质疑，法庭在黄之锋案中，未有充分解释相关行为如何构成严重危害国家安全，量刑理据难免引起争议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E9%BB%84%E4%B9%8B%E9%94%8B%E5%86%8D%E8%A2%AB%E9%87%8D%E5%88%A410%E5%B9%B4-%E6%98%94%E6%97%A5%E6%88%98%E5%8F%8B%E9%BD%90%E6%89%B9%E5%88%91%E6%9C%9F%E8%BF%87%E9%87%8D-%E7%BD%97%E5%86%A0%E8%81%AA-%E6%B3%95%E5%BA%AD%E6%9C%8D%E8%86%BA%E4%BA%8E%E5%8C%97%E4%BA%AC%E6%97%A8%E6%84%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793953488000.webp","sourceId":"rfi"},{"id":1793999654000,"createdDate":"2026-11-06 21:14","name":"法国国际广播电台","title":"教宗良十四世开启12天南美访问","content":"教宗良十四世于周五开启了充满情感的南美之旅。就在三周前，他刚刚接受了早期肺腺癌手术。此次南美之行，让他重返这片塑造了他圣召的土地。此行他将访问乌拉圭、阿根廷和秘鲁。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%BC%80%E5%90%AF12%E5%A4%A9%E5%8D%97%E7%BE%8E%E8%AE%BF%E9%97%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793999654000.webp","sourceId":"rfi"},{"id":1793999395000,"createdDate":"2026-11-06 21:09","name":"法国国际广播电台","title":"对巴拉圭佩尼亚总统弹劾审判开始","content":"巴拉圭总统佩尼亚（SantiagoPena）因银行倒闭引发金融及政治危机，宣布辞职后，检察官宣布，佩尼亚因一家大型数字银行倒闭而受到刑事调查。佩尼亚周五提出的三天延期申请被驳回。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261106-%E5%AF%B9%E5%B7%B4%E6%8B%89%E5%9C%AD%E4%BD%A9%E5%B0%BC%E4%BA%9A%E6%80%BB%E7%BB%9F%E5%BC%B9%E5%8A%BE%E5%AE%A1%E5%88%A4%E5%BC%80%E5%A7%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793999395000.webp","sourceId":"rfi"},{"id":1793999287000,"createdDate":"2026-11-06 21:08","name":"法国国际广播电台","title":"法新社谴责警方暴力对待其记者","content":"法新社（AFP）周五谴责“执法部门在法国高中生运动和抗议高生活成本的示威活动中对其记者实施暴力”。此前，多名法新社记者遭到警棍殴打，甚至被闪光弹击中。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261106-%E6%B3%95%E6%96%B0%E7%A4%BE%E8%B0%B4%E8%B4%A3%E8%AD%A6%E6%96%B9%E6%9A%B4%E5%8A%9B%E5%AF%B9%E5%BE%85%E5%85%B6%E8%AE%B0%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793999287000.webp","sourceId":"rfi"},{"id":1793999162000,"createdDate":"2026-11-06 21:06","name":"法国国际广播电台","title":"特朗普兴建凯旋门计划受阻  白宫表示乐观","content":"美国一位法官阻止了特朗普在华盛顿特区建造巨型凯旋门的计划，但白宫周五表示，他们相信法院最终会做出有利于他们的裁决。白宫发言人戴维斯·英格尔在X网站上写道，他将周四晚间做出裁决的法官描述为“激进分子”，并表示：“我们相信法院最终会完全支持我们，我们期待着看到这座宏伟的凯旋门建成。”","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261106-%E7%89%B9%E6%9C%97%E6%99%AE%E5%85%B4%E5%BB%BA%E5%87%AF%E6%97%8B%E9%97%A8%E8%AE%A1%E5%88%92%E5%8F%97%E9%98%BB-%E7%99%BD%E5%AE%AB%E8%A1%A8%E7%A4%BA%E4%B9%90%E8%A7%82","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793999162000.webp","sourceId":"rfi"},{"id":1793998812000,"createdDate":"2026-11-06 21:00","name":"法国国际广播电台","title":"美中期选举：密西西比州还未有明确结果","content":"美国中期选举于周二举行，但截至周五上午，密西西比州参议院席位争夺战的关键结果仍未出炉，主要原因是仍有大量邮寄选票尚未清点。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261106-%E7%BE%8E%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE-%E5%AF%86%E8%A5%BF%E8%A5%BF%E6%AF%94%E5%B7%9E%E8%BF%98%E6%9C%AA%E6%9C%89%E6%98%8E%E7%A1%AE%E7%BB%93%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793998812000.webp","sourceId":"rfi"},{"id":1793998590000,"createdDate":"2026-11-06 20:56","name":"法国国际广播电台","title":"皇马与中国之间的紧张关系能否缓和？","content":"在姆巴佩发表有关毛泽东的争议性言论一周多后，中国政府与皇马之间的关系似乎正在朝着改善的方向发展。即便如此，西甲联赛重返中国国家电视台转播的事宜仍未最终敲定。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261106-%E7%9A%87%E9%A9%AC%E4%B8%8E%E4%B8%AD%E5%9B%BD%E4%B9%8B%E9%97%B4%E7%9A%84%E7%B4%A7%E5%BC%A0%E5%85%B3%E7%B3%BB%E8%83%BD%E5%90%A6%E7%BC%93%E5%92%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793998590000.webp","sourceId":"rfi"},{"id":1793998462000,"createdDate":"2026-11-06 20:54","name":"法国国际广播电台","title":"欧盟对澳门前民主派议员定罪表示“遗憾”","content":"欧盟周五对澳门民主活动人士区锦新（AuKamSan）被判入狱表示谴责。区锦新是澳门首位因颠覆国家政权罪被定罪的人。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%AC%A7%E7%9B%9F%E5%AF%B9%E6%BE%B3%E9%97%A8%E5%89%8D%E6%B0%91%E4%B8%BB%E6%B4%BE%E8%AE%AE%E5%91%98%E5%AE%9A%E7%BD%AA%E8%A1%A8%E7%A4%BA-%E9%81%97%E6%86%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793998462000.webp","sourceId":"rfi"},{"id":1793998356000,"createdDate":"2026-11-06 20:52","name":"法国国际广播电台","title":"华盛顿呼吁北京当局尊重双方贸易协定条款","content":"美国政府11月6日呼吁中国“全面、立即”履行去年为缓和两国贸易冲突而作出的承诺。贝森特和格里尔近期进一步向中方施压，要求中方全面履行2025年10月在韩国釜山达成的贸易协议条款（包括稀土及农产品采购等承诺）。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261106-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E5%91%BC%E5%90%81%E5%8C%97%E4%BA%AC%E5%BD%93%E5%B1%80%E5%B0%8A%E9%87%8D%E5%8F%8C%E6%96%B9%E8%B4%B8%E6%98%93%E5%8D%8F%E5%AE%9A%E6%9D%A1%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793998356000.webp","sourceId":"rfi"},{"id":1793997020000,"createdDate":"2026-11-06 20:30","name":"法国国际广播电台","title":"印度首都新政：为50万个贫民窟家庭提供永久住房的计划","content":"印度首都新德里政府公布安置住房领域的新政，为住在暂时性贫民窟、临时性棚屋的民众，提供永久性住房，预料将有50万个家庭、约200万人受惠。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261106-%E5%8D%B0%E5%BA%A6%E9%A6%96%E9%83%BD%E6%96%B0%E6%94%BF-%E4%B8%BA50%E4%B8%87%E4%B8%AA%E8%B4%AB%E6%B0%91%E7%AA%9F%E5%AE%B6%E5%BA%AD%E6%8F%90%E4%BE%9B%E6%B0%B8%E4%B9%85%E4%BD%8F%E6%88%BF%E7%9A%84%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793997020000.webp","sourceId":"rfi"},{"id":1793994119000,"createdDate":"2026-11-06 19:41","name":"法国国际广播电台","title":"特朗普:将很快决定是否恢复对伊朗大规模军事行动","content":"曾在中期选举前称不会选前攻打伊朗的美国总统特朗普周四在白宫对媒体表示：他将很快决定是否恢复对德黑兰的大规模军事行动。还说：伊朗不会拥有核武器。他们自己知道这一点，我也知道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261106-%E7%89%B9%E6%9C%97%E6%99%AE-%E5%B0%86%E5%BE%88%E5%BF%AB%E5%86%B3%E5%AE%9A%E6%98%AF%E5%90%A6%E6%81%A2%E5%A4%8D%E5%AF%B9%E5%BE%B7%E9%BB%91%E5%85%B0%E5%A4%A7%E8%A7%84%E6%A8%A1%E5%86%9B%E4%BA%8B%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793994119000.webp","sourceId":"rfi"},{"id":1793989036000,"createdDate":"2026-11-06 18:17","name":"法国国际广播电台","title":"法国一辆校车开至马路对面   两名学生死亡  3人重伤","content":"周五上午法国东部安省（Ain）发生的巴士冲出公路事故中，司机已被警方拘留。布雷斯地区布尔格检察官在新闻发布会上宣布，司机告诉调查人员，他当时开车时睡着了。司机的失误造成两名学生死亡、三名重伤。法国交通部长赶至现场。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261106-%E6%B3%95%E5%9B%BD%E4%B8%80%E8%BE%86%E6%A0%A1%E8%BD%A6%E5%BC%80%E8%87%B3%E9%A9%AC%E8%B7%AF%E5%AF%B9%E9%9D%A2-%E4%B8%A4%E5%90%8D%E5%AD%A6%E7%94%9F%E6%AD%BB%E4%BA%A1-3%E4%BA%BA%E9%87%8D%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793989036000.webp","sourceId":"rfi"},{"id":1793988492000,"createdDate":"2026-11-06 18:08","name":"法国国际广播电台","title":"美媒：民主党人讨论众议院中国特设委员会的未来","content":"美国众议院民主党人正重新评估美中战略竞争特别委员会的未来定位，考虑是否调整现有架构，将监督范围由中国扩大至其他被美国视为威胁的外国势力。这项讨论涉及委员会的职权、人事安排及民主党未来在国会处理国家安全议题的策略，但目前尚未作出最终决定。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261106-%E7%BE%8E%E5%AA%92-%E6%B0%91%E4%B8%BB%E5%85%9A%E4%BA%BA%E8%AE%A8%E8%AE%BA%E4%BC%97%E8%AE%AE%E9%99%A2%E4%B8%AD%E5%9B%BD%E7%89%B9%E8%AE%BE%E5%A7%94%E5%91%98%E4%BC%9A%E7%9A%84%E6%9C%AA%E6%9D%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793988492000.webp","sourceId":"rfi"},{"id":1793982685000,"createdDate":"2026-11-06 16:31","name":"法国国际广播电台","title":"欧盟对特定PET树脂化学品启动保障措施调查","content":"11月6日，欧盟通知世贸组织保障措施委员会，其已于同一日对特定聚对苯二甲酸乙二醇酯（PET）树脂化学品的进口启动了一项保障措施调查。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261106-%E6%AC%A7%E7%9B%9F%E5%AF%B9%E7%89%B9%E5%AE%9Apet%E6%A0%91%E8%84%82%E5%8C%96%E5%AD%A6%E5%93%81%E5%90%AF%E5%8A%A8%E4%BF%9D%E9%9A%9C%E6%8E%AA%E6%96%BD%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793982685000.webp","sourceId":"rfi"}]