[{"id":1793980798000,"createdDate":"2026-11-06 15:59","name":"法国国际广播电台","title":"黄之锋重判10年 鲁比奥：美国强烈谴责，呼吁立即释放","content":"美国国务卿鲁比奥（MarcoRubio）周五通过社媒平台X发文称，“美国强烈谴责香港法院再次判处黄之锋因行使言论自由而入狱的决定。他一直以和平方式捍卫香港所有个人被承诺过的权利。我们呼吁立即将他释放以及释放所有被不公正拘留的人士”。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261106-%E9%B2%81%E6%AF%94%E5%A5%A5-%E7%BE%8E%E5%9B%BD%E5%BC%BA%E7%83%88%E8%B0%B4%E8%B4%A3%E9%A6%99%E6%B8%AF%E6%B3%95%E9%99%A2%E5%86%8D%E6%AC%A1%E5%88%A4%E5%A4%84%E9%BB%84%E4%B9%8B%E9%94%8B%E5%9B%A0%E8%A1%8C%E4%BD%BF%E8%A8%80%E8%AE%BA%E8%87%AA%E7%94%B1%E8%80%8C%E5%85%A5%E7%8B%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793980798000.webp","sourceId":"rfi"},{"id":1793979799000,"createdDate":"2026-11-06 15:43","name":"法国国际广播电台","title":"打击走私 英伟达采取措施加强在东南亚的芯片追踪","content":"英伟达正在加强对在东南亚销售的人工智能加速器的追踪，这是该公司为遏制半导体走私而采取的一项战略举措。此前，英伟达因未采取足够措施来阻止非法货物运往中国企业而受到批评。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261106-%E6%89%93%E5%87%BB%E8%B5%B0%E7%A7%81-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E9%87%87%E5%8F%96%E6%8E%AA%E6%96%BD%E5%8A%A0%E5%BC%BA%E5%9C%A8%E4%B8%9C%E5%8D%97%E4%BA%9A%E7%9A%84%E8%8A%AF%E7%89%87%E8%BF%BD%E8%B8%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793979799000.webp","sourceId":"rfi"},{"id":1793976807000,"createdDate":"2026-11-06 14:53","name":"法国国际广播电台","title":"欧委会初步认定TikTok为你推荐信息流存在兔子洞效应 违反《数字服务法》","content":"欧盟科技监管机构周五指控社交媒体平台TikTok违反了欧盟的在线内容规则，并要求其整改推荐系统的所谓“兔子洞效应”。该系统会将用户的注意力吸引到源源不断的类似视频中。监管机构表示，如果TikTok的中国母公司字节跳动无法解决这一问题，明年可能面临至高其全球年营业额6%的罚款。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%AC%A7%E5%A7%94%E4%BC%9A%E5%88%9D%E6%AD%A5%E8%AE%A4%E5%AE%9Atiktok%E4%B8%BA%E4%BD%A0%E6%8E%A8%E8%8D%90%E4%BF%A1%E6%81%AF%E6%B5%81%E5%AD%98%E5%9C%A8%E5%85%94%E5%AD%90%E6%B4%9E%E6%95%88%E5%BA%94-%E8%BF%9D%E5%8F%8D-%E6%95%B0%E5%AD%97%E6%9C%8D%E5%8A%A1%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793976807000.webp","sourceId":"rfi"},{"id":1793975009000,"createdDate":"2026-11-06 14:23","name":"法国国际广播电台","title":"意检方结束对“李老师”遭跟踪监视威胁案调查 4嫌疑人最高可判7年监禁","content":"意大利检方结束了一项调查，他们指该网络与中国当局有关联，多年来一直跟踪、恐吓和骚扰居住在意大利的网名为“李老师不是你老师”的社媒博主李颖。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261106-%E6%84%8F%E6%A3%80%E6%96%B9%E7%BB%93%E6%9D%9F%E5%AF%B9-%E6%9D%8E%E8%80%81%E5%B8%88-%E9%81%AD%E8%B7%9F%E8%B8%AA%E7%9B%91%E8%A7%86%E5%A8%81%E8%83%81%E6%A1%88%E8%B0%83%E6%9F%A5-4%E5%AB%8C%E7%96%91%E4%BA%BA%E6%9C%80%E9%AB%98%E5%8F%AF%E5%88%A47%E5%B9%B4%E7%9B%91%E7%A6%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793975009000.webp","sourceId":"rfi"},{"id":1793970637000,"createdDate":"2026-11-06 13:10","name":"法国国际广播电台","title":"黄之锋重判10年 美英法德日意澳加等10国外交部发联合声明 促当局履行国际承诺","content":"包括美国、英国、德国和法国在内的十个国家政府周五发布联合声明，谴责香港民主活动人士黄之锋被判处10年监禁。此前，正就初选47人案服刑的前香港众志秘书长黄之锋，去年6月在狱中被捕，被控2020年串谋勾结罗冠聪等危害国安。他今年9月认罪，周四在高等法院被判囚10年，当中两个月零两日与47人案刑期同期执行，即黄之锋被加监9年10个月。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261106-%E9%BB%84%E4%B9%8B%E9%94%8B%E9%87%8D%E5%88%A410%E5%B9%B4-%E7%BE%8E%E8%8B%B1%E6%B3%95%E5%BE%B7%E6%97%A5%E6%84%8F%E6%BE%B3%E5%8A%A0%E7%AD%8910%E5%9B%BD%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%91%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E-%E4%BF%83%E5%BD%93%E5%B1%80%E5%B1%A5%E8%A1%8C%E5%9B%BD%E9%99%85%E6%89%BF%E8%AF%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793970637000.webp","sourceId":"rfi"},{"id":1793968878000,"createdDate":"2026-11-06 12:41","name":"法国国际广播电台","title":"积压许久的刘德华主演抗疫题材电影《白衣逆行者》疑撤档","content":"综合消息显示，由香港导演邱礼涛执导、影星刘德华和杨子姗等主演的电影《白衣逆行者》原定于11月6日在中国全国上映，并曾通过央视电影频道《中国电影报道》等渠道宣传，但随后在11月6日上映前夕出现疑似临时撤档或调整情况，目前在部分购票平台暂无法正常购票，豆瓣等平台显示上映日期已改为空白或延后。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261106-%E7%A7%AF%E5%8E%8B%E8%AE%B8%E4%B9%85%E7%9A%84%E5%88%98%E5%BE%B7%E5%8D%8E%E4%B8%BB%E6%BC%94%E6%8A%97%E7%96%AB%E9%A2%98%E6%9D%90%E7%94%B5%E5%BD%B1-%E7%99%BD%E8%A1%A3%E9%80%86%E8%A1%8C%E8%80%85-%E7%96%91%E6%92%A4%E6%A1%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793968878000.webp","sourceId":"rfi"},{"id":1793965445000,"createdDate":"2026-11-06 11:44","name":"法国国际广播电台","title":"打击跨国电诈 美国制裁太子集团41关联实体及4个人","content":"美国财政部周四宣布对与总部位于柬埔寨的太子集团有关联的4名个人和41个实体实施制裁。美国国务院发言人皮戈特（TommyPigott）当天通过新闻稿表示，“今天，美国对与总部位于柬埔寨的太子集团跨国犯罪组织有关联的4名个人和41家实体实施制裁，此举是继2025年10月和2026年6月针对该组织头目、关联公司及金融协助者实施制裁后的又一举措。这些制裁措施由美国财政部海外资产控制办公室负责执行”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261106-%E6%89%93%E5%87%BB%E8%B7%A8%E5%9B%BD%E7%94%B5%E8%AF%88-%E7%BE%8E%E5%9B%BD%E5%88%B6%E8%A3%81%E5%A4%AA%E5%AD%90%E9%9B%86%E5%9B%A241%E5%85%B3%E8%81%94%E4%BC%81%E4%B8%9A%E5%8F%8A4%E4%B8%AA%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793965445000.webp","sourceId":"rfi"},{"id":1793963073000,"createdDate":"2026-11-06 11:04","name":"法国国际广播电台","title":"民主党夺回两院，如何影响美中关系？","content":"美国民主党在11月3日国会期中选举中大胜，夺回众议院及参议院控制权，重挫总统特朗普（DonaldTrump）及共和党，为未来两年美国对华政策增添变数。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%BE%8E%E5%9B%BD%E4%B8%93%E6%A0%8F/20261106-%E6%B0%91%E4%B8%BB%E5%85%9A%E5%A4%BA%E5%9B%9E%E4%B8%A4%E9%99%A2%EF%BC%8C%E5%A6%82%E4%BD%95%E5%BD%B1%E5%93%8D%E7%BE%8E%E4%B8%AD%E5%85%B3%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793963073000.webp","sourceId":"rfi"},{"id":1793961034000,"createdDate":"2026-11-06 10:30","name":"法国国际广播电台","title":"请注意，法国正在召回这些酸奶；它们可能含有玻璃碎片","content":"法国媒体呼吁消费者要注意，法国正在召回一些酸奶，因它们可能含有玻璃碎片。法国的Auchan、SuperU和E.Leclerc三大超商集团销售的这些酸奶已被紧急召回。以下是受影响的批次。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261106-%E8%AF%B7%E6%B3%A8%E6%84%8F%EF%BC%8C%E6%B3%95%E5%9B%BD%E6%AD%A3%E5%9C%A8%E5%8F%AC%E5%9B%9E%E8%BF%99%E4%BA%9B%E9%85%B8%E5%A5%B6-%E5%AE%83%E4%BB%AC%E5%8F%AF%E8%83%BD%E5%90%AB%E6%9C%89%E7%8E%BB%E7%92%83%E7%A2%8E%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/06/1793961034000.webp","sourceId":"rfi"},{"id":1793959552000,"createdDate":"2026-11-06 10:05","name":"法国国际广播电台","title":"调查：币安黑客开始透过中国洗钱网络转移资金","content":"彭博周四报道称，根据区块链分析公司Chainalysis最新调查，涉嫌窃取币安（Binance）约63亿美元加密资产的黑客，正透过中国的洗钱网络，试图将部分赃款转换为现金。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/2