[{"id":1795515536000,"createdDate":"2026-11-24 10:18","name":"法国国际广播电台","title":"俄军机接连引发安全警报，韩国与波兰报告领空事件","content":"11月24日，韩国和波兰分别报告了涉及俄罗斯军机及无人机的领空安全事件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E4%BF%84%E5%86%9B%E6%9C%BA%E6%8E%A5%E8%BF%9E%E5%BC%95%E5%8F%91%E5%AE%89%E5%85%A8%E8%AD%A6%E6%8A%A5%EF%BC%8C%E9%9F%A9%E5%9B%BD%E4%B8%8E%E6%B3%A2%E5%85%B0%E7%9B%B8%E7%BB%A7%E6%8A%A5%E5%91%8A%E9%A2%86%E7%A9%BA%E4%BA%8B%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795515536000.webp","sourceId":"rfi"},{"id":1795514732000,"createdDate":"2026-11-24 10:05","name":"法国国际广播电台","title":"英伟达：华盛顿瞄准高端芯片流向中国的问题","content":"新加坡和马来西亚周二同意与美国合作，打击英伟达尖端芯片流向中国的行为。尽管丑闻缠身，这家美国科技巨头仍恢复了黄仁勋的首席执行官职务。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261124-%E8%8B%B1%E4%BC%9F%E8%BE%BE-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E7%9E%84%E5%87%86%E9%AB%98%E7%AB%AF%E8%8A%AF%E7%89%87%E6%B5%81%E5%90%91%E4%B8%AD%E5%9B%BD%E7%9A%84%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795514732000.webp","sourceId":"rfi"},{"id":1795514464000,"createdDate":"2026-11-24 10:01","name":"法国国际广播电台","title":"黄仁勋突然复职 特朗普所持英伟达股票价值或增长多达1500万美元","content":"据英国《金融时报》报导，周一，受黄仁勋重返首席执行官职位的突发消息影响，英伟达股价大幅飙升，美国总统特朗普（DonaldTrump）所持英伟达股票的价值随之增长了多达1500万美元。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261124-%E9%BB%84%E4%BB%81%E5%8B%8B%E7%AA%81%E7%84%B6%E5%A4%8D%E8%81%8C-%E7%89%B9%E6%9C%97%E6%99%AE%E6%89%80%E6%8C%81%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%82%A1%E7%A5%A8%E4%BB%B7%E5%80%BC%E6%88%96%E5%A2%9E%E9%95%BF%E5%A4%9A%E8%BE%BE1500%E4%B8%87%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795514464000.webp","sourceId":"rfi"},{"id":1795512701000,"createdDate":"2026-11-24 09:31","name":"法国国际广播电台","title":"欧盟12月起限混动车进口 中方促公平调查","content":"欧盟委员会周二公布针对混合动力汽车进口的临时保障措施，将从12月1日起实施进口配额制度，以应对近年来进口量快速攀升，对欧洲汽车产业带来的压力。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261124-%E6%AC%A7%E7%9B%9F12%E6%9C%88%E8%B5%B7%E9%99%90%E6%B7%B7%E5%8A%A8%E8%BD%A6%E8%BF%9B%E5%8F%A3-%E4%B8%AD%E6%96%B9%E4%BF%83%E5%85%AC%E5%B9%B3%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795512701000.webp","sourceId":"rfi"},{"id":1795511876000,"createdDate":"2026-11-24 09:17","name":"法国国际广播电台","title":"欧盟电动汽车优惠政策修正案排除日本 日本表示关切","content":"日本内阁官房长官木原稔24日在记者会上表示，对于欧盟（EU）正在研究的欧洲制造电动汽车（EV）优惠政策可能将日本制造的电动汽车排除在外一事，认为“有可能给日本企业造成不可忽视的不利影响”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261124-%E6%AC%A7%E7%9B%9F%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E4%BC%98%E6%83%A0%E6%94%BF%E7%AD%96%E4%BF%AE%E6%AD%A3%E6%A1%88%E6%8E%92%E9%99%A4%E6%97%A5%E6%9C%AC-%E6%97%A5%E6%9C%AC%E8%A1%A8%E7%A4%BA%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795511876000.webp","sourceId":"rfi"},{"id":1795511627000,"createdDate":"2026-11-24 09:13","name":"法国国际广播电台","title":"所罗门群岛已告知北京不再续约中所安全协议 将与澳方签署新条约","content":"据澳大利亚广播公司（ABC）报导，所罗门群岛已告知中国，将不再续约双方于2022年签署的一项颇具争议的安全协议；与此同时，这个太平洋岛国正准备与澳大利亚签署一份内容广泛、价值近十亿澳元的新条约。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E6%89%80%E7%BD%97%E9%97%A8%E7%BE%A4%E5%B2%9B%E5%B7%B2%E5%91%8A%E7%9F%A5%E5%8C%97%E4%BA%AC%E4%B8%8D%E5%86%8D%E7%BB%AD%E7%BA%A6%E4%B8%AD%E6%89%80%E5%AE%89%E5%85%A8%E5%8D%8F%E8%AE%AE-%E5%B0%86%E4%B8%8E%E6%BE%B3%E6%96%B9%E7%AD%BE%E7%BD%B2%E6%96%B0%E6%9D%A1%E7%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795511627000.webp","sourceId":"rfi"}]