[{"id":1795515536000,"createdDate":"2026-11-24 10:18","name":"法国国际广播电台","title":"俄军机接连引发安全警报，韩国与波兰报告领空事件","content":"11月24日，韩国和波兰分别报告了涉及俄罗斯军机及无人机的领空安全事件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E4%BF%84%E5%86%9B%E6%9C%BA%E6%8E%A5%E8%BF%9E%E5%BC%95%E5%8F%91%E5%AE%89%E5%85%A8%E8%AD%A6%E6%8A%A5%EF%BC%8C%E9%9F%A9%E5%9B%BD%E4%B8%8E%E6%B3%A2%E5%85%B0%E7%9B%B8%E7%BB%A7%E6%8A%A5%E5%91%8A%E9%A2%86%E7%A9%BA%E4%BA%8B%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795515536000.webp","sourceId":"rfi"},{"id":1795514732000,"createdDate":"2026-11-24 10:05","name":"法国国际广播电台","title":"英伟达：华盛顿瞄准高端芯片流向中国的问题","content":"新加坡和马来西亚周二同意与美国合作，打击英伟达尖端芯片流向中国的行为。尽管丑闻缠身，这家美国科技巨头仍恢复了黄仁勋的首席执行官职务。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261124-%E8%8B%B1%E4%BC%9F%E8%BE%BE-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E7%9E%84%E5%87%86%E9%AB%98%E7%AB%AF%E8%8A%AF%E7%89%87%E6%B5%81%E5%90%91%E4%B8%AD%E5%9B%BD%E7%9A%84%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795514732000.webp","sourceId":"rfi"},{"id":1795514464000,"createdDate":"2026-11-24 10:01","name":"法国国际广播电台","title":"黄仁勋突然复职 特朗普所持英伟达股票价值或增长多达1500万美元","content":"据英国《金融时报》报导，周一，受黄仁勋重返首席执行官职位的突发消息影响，英伟达股价大幅飙升，美国总统特朗普（DonaldTrump）所持英伟达股票的价值随之增长了多达1500万美元。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261124-%E9%BB%84%E4%BB%81%E5%8B%8B%E7%AA%81%E7%84%B6%E5%A4%8D%E8%81%8C-%E7%89%B9%E6%9C%97%E6%99%AE%E6%89%80%E6%8C%81%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%82%A1%E7%A5%A8%E4%BB%B7%E5%80%BC%E6%88%96%E5%A2%9E%E9%95%BF%E5%A4%9A%E8%BE%BE1500%E4%B8%87%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795514464000.webp","sourceId":"rfi"},{"id":1795512701000,"createdDate":"2026-11-24 09:31","name":"法国国际广播电台","title":"欧盟12月起限混动车进口 中方促公平调查","content":"欧盟委员会周二公布针对混合动力汽车进口的临时保障措施，将从12月1日起实施进口配额制度，以应对近年来进口量快速攀升，对欧洲汽车产业带来的压力。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261124-%E6%AC%A7%E7%9B%9F12%E6%9C%88%E8%B5%B7%E9%99%90%E6%B7%B7%E5%8A%A8%E8%BD%A6%E8%BF%9B%E5%8F%A3-%E4%B8%AD%E6%96%B9%E4%BF%83%E5%85%AC%E5%B9%B3%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795512701000.webp","sourceId":"rfi"},{"id":1795511876000,"createdDate":"2026-11-24 09:17","name":"法国国际广播电台","title":"欧盟电动汽车优惠政策修正案排除日本 日本表示关切","content":"日本内阁官房长官木原稔24日在记者会上表示，对于欧盟（EU）正在研究的欧洲制造电动汽车（EV）优惠政策可能将日本制造的电动汽车排除在外一事，认为“有可能给日本企业造成不可忽视的不利影响”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261124-%E6%AC%A7%E7%9B%9F%E7%94%B5%E5%8A%A8%E6%B1%BD%E8%BD%A6%E4%BC%98%E6%83%A0%E6%94%BF%E7%AD%96%E4%BF%AE%E6%AD%A3%E6%A1%88%E6%8E%92%E9%99%A4%E6%97%A5%E6%9C%AC-%E6%97%A5%E6%9C%AC%E8%A1%A8%E7%A4%BA%E5%85%B3%E5%88%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795511876000.webp","sourceId":"rfi"},{"id":1795511627000,"createdDate":"2026-11-24 09:13","name":"法国国际广播电台","title":"所罗门群岛已告知北京不再续约中所安全协议 将与澳方签署新条约","content":"据澳大利亚广播公司（ABC）报导，所罗门群岛已告知中国，将不再续约双方于2022年签署的一项颇具争议的安全协议；与此同时，这个太平洋岛国正准备与澳大利亚签署一份内容广泛、价值近十亿澳元的新条约。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E6%89%80%E7%BD%97%E9%97%A8%E7%BE%A4%E5%B2%9B%E5%B7%B2%E5%91%8A%E7%9F%A5%E5%8C%97%E4%BA%AC%E4%B8%8D%E5%86%8D%E7%BB%AD%E7%BA%A6%E4%B8%AD%E6%89%80%E5%AE%89%E5%85%A8%E5%8D%8F%E8%AE%AE-%E5%B0%86%E4%B8%8E%E6%BE%B3%E6%96%B9%E7%AD%BE%E7%BD%B2%E6%96%B0%E6%9D%A1%E7%BA%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795511627000.webp","sourceId":"rfi"},{"id":1795560140000,"createdDate":"2026-11-24 22:42","name":"法国国际广播电台","title":"英伟达事件背后：一个为中国输送人工智能芯片的庞大网络","content":"在黄仁勋11月23日重新执掌英伟达的同时，全球媒体正在梳理是哪些操作让英伟达的相关芯片得以绕过美国的限制，被运往中国。法国世界报周二写道，美国自2022年起禁止英伟达向中国出售部分最先进的人工智能芯片。然而，一系列调查显示，相关企业和中间商通过虚假申报、海外部署、关联公司转运和物流网络等方式，仍然可能将受限制的芯片送给中国。比如Megaspeed案例。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261124-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E4%BA%8B%E4%BB%B6%E8%83%8C%E5%90%8E-%E4%B8%80%E4%B8%AA%E4%B8%BA%E4%B8%AD%E5%9B%BD%E8%BE%93%E9%80%81%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E8%8A%AF%E7%89%87%E7%9A%84%E5%BA%9E%E5%A4%A7%E7%BD%91%E7%BB%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795560140000.webp","sourceId":"rfi"},{"id":1795559911000,"createdDate":"2026-11-24 22:38","name":"法国国际广播电台","title":"英王储威廉夫妇乡间别墅遇窃，警方拘捕两男子，事发时屋内无人","content":"英国警方表示，两名男子因涉嫌入室盗窃及非法侵入被逮捕。英国媒体指出，遇窃的宅邸为“安默堡”（AnmerHall），是英国威廉王子及凯特王妃的乡间别墅。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261124-%E8%8B%B1%E7%8E%8B%E5%82%A8%E5%A8%81%E5%BB%89%E5%A4%AB%E5%A6%87%E4%B9%A1%E9%97%B4%E5%88%AB%E5%A2%85%E9%81%87%E7%AA%83%EF%BC%8C%E8%AD%A6%E6%96%B9%E6%8B%98%E6%8D%95%E4%B8%A4%E7%94%B7%E5%AD%90%EF%BC%8C%E4%BA%8B%E5%8F%91%E6%97%B6%E5%B1%8B%E5%86%85%E6%97%A0%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795559911000.webp","sourceId":"rfi"},{"id":1795555839000,"createdDate":"2026-11-24 21:30","name":"法国国际广播电台","title":"华为因与伊朗有关的刑事犯罪而被美国一家法院定罪","content":"美国一家法院裁定华为犯有一系列刑事罪行。此前，这家中国电信巨头被控就其在伊朗的活动欺骗银行，并窃取美国公司的商业机密。纽约布鲁克林的一个联邦陪审团认定华为12项指控中的10项罪名成立。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261124-%E5%8D%8E%E4%B8%BA%E5%9B%A0%E4%B8%8E%E4%BC%8A%E6%9C%97%E6%9C%89%E5%85%B3%E7%9A%84%E5%88%91%E4%BA%8B%E7%8A%AF%E7%BD%AA%E8%80%8C%E8%A2%AB%E5%AE%9A%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795555839000.webp","sourceId":"rfi"},{"id":1795554839000,"createdDate":"2026-11-24 21:13","name":"法国国际广播电台","title":"美国司法部长回避黄仁勋是否遭调查","content":"美国司法部长布兰奇（ToddBlanche）周二（24日）在记者会上，拒绝明确说明司法部是否调查英伟达（Nvidia）执行长黄仁勋（JensenHuang），也未交代相关调查是否已排除他的刑事责任。联邦调查局（FBI）局长帕特尔（KashPatel）同样回避相关问题。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261124-%E7%BE%8E%E5%9B%BD%E5%8F%B8%E6%B3%95%E9%83%A8%E9%95%BF%E5%9B%9E%E9%81%BF%E9%BB%84%E4%BB%81%E5%8B%8B%E6%98%AF%E5%90%A6%E9%81%AD%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795554839000.webp","sourceId":"rfi"},{"id":1795554138000,"createdDate":"2026-11-24 21:02","name":"法国国际广播电台","title":"深圳人在亚太经合会期间“全妆出街”惊艳了自己","content":"亚太经合组织（APEC）第三十三次领导人非正式会议在深圳举行，11月24日，中共深圳市委、市人民政府发出《你们是城市的荣光——致广大市民朋友的感谢信》。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261124-%E6%B7%B1%E5%9C%B3%E4%BA%BA%E5%9C%A8%E4%BA%9A%E5%A4%AA%E7%BB%8F%E5%90%88%E4%BC%9A%E6%9C%9F%E9%97%B4-%E5%85%A8%E5%A6%86%E5%87%BA%E8%A1%97-%E5%8F%97%E5%88%B0%E5%B8%82%E6%94%BF%E5%BA%9C%E6%84%9F%E8%B0%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795554138000.webp","sourceId":"rfi"},{"id":1795553801000,"createdDate":"2026-11-24 20:56","name":"法国国际广播电台","title":"中国的“天宫”迎来首位外籍宇航员","content":"11月24日，首位参与中国航天任务的外国航天员表示，本周他将从戈壁沙漠启程，肩负着“2.5亿巴基斯坦人的希望”奔赴太空。中国在航天项目上投入了数十亿美元，“天宫”空间站由三人组成的航天员乘组负责运营，乘组通常每六个月轮换一次。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261124-%E4%B8%AD%E5%9B%BD%E7%9A%84-%E5%A4%A9%E5%AE%AB-%E8%BF%8E%E6%9D%A5%E9%A6%96%E4%BD%8D%E5%A4%96%E7%B1%8D%E5%AE%87%E8%88%AA%E5%91%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795553801000.webp","sourceId":"rfi"},{"id":1795553424000,"createdDate":"2026-11-24 20:50","name":"法国国际广播电台","title":"话说上海市委书记陈吉宁落马 本届中共政治局委员中的“老四”","content":"中国官媒新华社本周二（11月24日）报导指：中共中央政治局委员、上海市委书记陈吉宁涉嫌严重违纪违法，目前正接受中央纪委国家监委的审查调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261124-%E4%B8%8A%E6%B5%B7%E5%B8%82%E5%A7%94%E4%B9%A6%E8%AE%B0%E9%99%88%E5%90%89%E5%AE%81%E8%90%BD%E9%A9%AC-%E6%9C%AC%E5%B1%8A%E4%B8%AD%E5%85%B1%E6%94%BF%E6%B2%BB%E5%B1%80%E5%A7%94%E5%91%98%E4%B8%AD%E7%9A%84%E7%AC%AC%E5%9B%9B%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795553424000.webp","sourceId":"rfi"},{"id":1795553407000,"createdDate":"2026-11-24 20:50","name":"法国国际广播电台","title":"联合国谴责伊朗对年轻歌手实施鞭刑","content":"联合国人权事务高级专员福尔克尔·蒂尔克（VolkerTürk）谴责伊朗对一名歌手处以鞭刑。他表示：“伊朗歌手帕拉斯图·艾哈迈迪（ParastooAhmadi）及其四名团队成员因在演唱会上未佩戴头巾而遭到鞭刑，这种做法令人发指”！","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E8%81%94%E5%90%88%E5%9B%BD%E8%B0%B4%E8%B4%A3%E4%BC%8A%E6%9C%97%E5%AF%B9%E5%B9%B4%E8%BD%BB%E6%AD%8C%E6%89%8B%E5%AE%9E%E6%96%BD%E9%9E%AD%E5%88%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795553407000.webp","sourceId":"rfi"},{"id":1795553107000,"createdDate":"2026-11-24 20:45","name":"法国国际广播电台","title":"波兰军方：一架俄无人机侵犯其领空","content":"波兰军方11月24日宣布，在俄罗斯夜间袭击邻国乌克兰期间，一架俄罗斯侦察无人机短暂进入波兰领空。就在几天前，三枚俄罗斯导弹落入波兰东部。波兰武装部队作战司令部在一份声明中表示：“在俄罗斯联邦夜间袭击乌克兰西部目标期间，一架俄罗斯无人机短暂侵犯了波兰领空。”","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261124-%E6%B3%A2%E5%85%B0%E5%86%9B%E6%96%B9-%E4%B8%80%E6%9E%B6%E4%BF%84%E6%97%A0%E4%BA%BA%E6%9C%BA%E4%BE%B5%E7%8A%AF%E5%85%B6%E9%A2%86%E7%A9%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795553107000.webp","sourceId":"rfi"},{"id":1795552774000,"createdDate":"2026-11-24 20:39","name":"法国国际广播电台","title":"FMI 将向厄瓜多尔追加贷款","content":"国际货币基金组织（IMF）11月24日宣布，已批准对厄瓜多尔持续援助计划的第六次审查，并决定在18个月内拨付3.77亿美元的新款项和总额为7.03亿美元的额外贷款。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-fmi-%E5%B0%86%E5%90%91%E5%8E%84%E7%93%9C%E5%A4%9A%E5%B0%94%E8%BF%BD%E5%8A%A0%E8%B4%B7%E6%AC%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795552774000.webp","sourceId":"rfi"},{"id":1795552345000,"createdDate":"2026-11-24 20:32","name":"法国国际广播电台","title":"网络名厨米歇尔·杜马斯离世    享年72岁","content":"米歇尔·杜马斯(MichelDumas)出生于法国普瓦捷（Poitiers），1976年定居加拿大。他曾在蒙特利尔温莎酒店担任副主厨，颇为引人注目。他于10月20日因前列腺癌病逝，享年72岁。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261124-%E7%BD%91%E7%BB%9C%E5%90%8D%E5%8E%A8%E7%B1%B3%E6%AD%87%E5%B0%94%C2%B7%E6%9D%9C%E9%A9%AC%E6%96%AF%E7%A6%BB%E4%B8%96-%E4%BA%AB%E5%B9%B472%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795552345000.webp","sourceId":"rfi"},{"id":1795552143000,"createdDate":"2026-11-24 20:29","name":"法国国际广播电台","title":"第108届法国市长大会在巴黎开幕","content":"第108届法国市长大会周二在巴黎开幕，正值市长竞选之际，自由派人士、法国市长协会（AMF）主席大卫·利斯纳尔同时竞选总统和协会主席引发争议。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261124-%E7%AC%AC108%E5%B1%8A%E6%B3%95%E5%9B%BD%E5%B8%82%E9%95%BF%E5%A4%A7%E4%BC%9A%E5%9C%A8%E5%B7%B4%E9%BB%8E%E5%BC%80%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795552143000.webp","sourceId":"rfi"},{"id":1795551702000,"createdDate":"2026-11-24 20:21","name":"法国国际广播电台","title":"英伟达股价出现下跌","content":"由黄仁勋（JensenHuang）重返英伟达（Nvidia）担任首席执行官所引发的股价涨势消退。由于市场对其所面临的调查以及人工智能（AI）投资热潮的前景仍存疑虑，英伟达股价出现下跌。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261124-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%82%A1%E4%BB%B7%E5%87%BA%E7%8E%B0%E4%B8%8B%E8%B7%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795551702000.webp","sourceId":"rfi"},{"id":1795551542000,"createdDate":"2026-11-24 20:19","name":"法国国际广播电台","title":"爱荷华州爆炸物销毁行动定于周三进行","content":"美国陆军周二宣布，尽管存在健康风险，但法院已批准在爱荷华州（美国中部）一家陆军弹药厂销毁超过4000公斤的陈旧爆炸物，销毁工作现已定于周三上午进行。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261124-%E7%88%B1%E8%8D%B7%E5%8D%8E%E5%B7%9E%E7%88%86%E7%82%B8%E7%89%A9%E9%94%80%E6%AF%81%E8%A1%8C%E5%8A%A8%E5%AE%9A%E4%BA%8E%E5%91%A8%E4%B8%89%E8%BF%9B%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795551542000.webp","sourceId":"rfi"},{"id":1795551302000,"createdDate":"2026-11-24 20:15","name":"法国国际广播电台","title":"哥伦比亚发生抢劫未遂事件   25人被劫为人质","content":"哥伦比亚总统阿韦拉多·德拉埃斯普里利亚（AbelardodelaEspriella）周二宣布，在哥伦比亚旅游城市卡塔赫纳（Carthagène），一群武装分子劫持了25名人质，此前他们试图抢劫一辆运钞车，但行动失败。袭击者原本计划袭击一家购物中心内的运钞车。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261124-%E5%93%A5%E4%BC%A6%E6%AF%94%E4%BA%9A%E5%8F%91%E7%94%9F%E6%8A%A2%E5%8A%AB%E6%9C%AA%E9%81%82%E4%BA%8B%E4%BB%B6-25%E4%BA%BA%E8%A2%AB%E5%8A%AB%E4%B8%BA%E4%BA%BA%E8%B4%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795551302000.webp","sourceId":"rfi"},{"id":1795538609000,"createdDate":"2026-11-24 16:43","name":"法国国际广播电台","title":"比亚迪就收购英力士汽车法国汉巴赫工厂展开谈判 马克龙指1月发布细节","content":"比亚迪周二在一份声明中宣布，已就收购英国英力士汽车（IneosAutomotive）位于法国摩泽尔省汉巴赫（Hambach）的工厂展开排他性谈判，旨在该地“生产专门为欧洲消费者设计的车型”。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261124-%E6%AF%94%E4%BA%9A%E8%BF%AA%E5%B0%B1%E6%94%B6%E8%B4%AD%E8%8B%B1%E5%8A%9B%E5%A3%AB%E6%B1%BD%E8%BD%A6%E6%B3%95%E5%9B%BD%E6%B1%89%E5%B7%B4%E8%B5%AB%E5%B7%A5%E5%8E%82%E5%B1%95%E5%BC%80%E8%B0%88%E5%88%A4-%E9%A9%AC%E5%85%8B%E9%BE%99%E6%8C%871%E6%9C%88%E5%8F%91%E5%B8%83%E7%BB%86%E8%8A%82","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795538609000.webp","sourceId":"rfi"},{"id":1795536350000,"createdDate":"2026-11-24 16:05","name":"法国国际广播电台","title":"现役美陆军中士就共谋向中国买家传递国防信息认罪","content":"一名驻扎在华盛顿州的现役美国陆军中士已认罪，承认曾共谋收集国防信息并将其提供给与中国有关联的人员。据俄勒冈联邦检察官办公室透露，37岁的赵健（音译，JianZhao）此前驻扎在位于华盛顿州塔科马的刘易斯–麦克乔德联合基地；他当时持有安全许可，能够接触到敏感的军事信息及装备。","newsLink":"https://www.rfi.fr/cn/%E7%A4%BE%E4%BC%9A/20261124-%E7%8E%B0%E5%BD%B9%E7%BE%8E%E9%99%86%E5%86%9B%E4%B8%AD%E5%A3%AB%E5%B0%B1%E5%85%B1%E8%B0%8B%E5%90%91%E4%B8%AD%E5%9B%BD%E4%B9%B0%E5%AE%B6%E4%BC%A0%E9%80%92%E5%9B%BD%E9%98%B2%E4%BF%A1%E6%81%AF%E8%AE%A4%E7%BD%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795536350000.webp","sourceId":"rfi"},{"id":1795535286000,"createdDate":"2026-11-24 15:48","name":"法国国际广播电台","title":"黄仁勋重掌英伟达，争议进一步扩大","content":"黄仁勋重新执掌英伟达后，围绕这家美国芯片巨头的争议进一步扩大。从美国国会两党议员提出国家安全质疑，到德国外交部长公开表达震惊，再到新加坡和马来西亚宣布与美国合作防止先进芯片流向中国，黄仁勋复职所引发的影响，继续在国际蔓延。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261124-%E9%BB%84%E4%BB%81%E5%8B%8B%E9%87%8D%E6%8E%8C%E8%8B%B1%E4%BC%9F%E8%BE%BE%EF%BC%8C%E4%BA%89%E8%AE%AE%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%89%A9%E5%A4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795535286000.webp","sourceId":"rfi"},{"id":1795533401000,"createdDate":"2026-11-24 15:16","name":"法国国际广播电台","title":"特朗普称黄仁勋有一位非常好的妻子 加州司法部门誓言继续查英伟达","content":"据《华尔街日报》援引知情人士报导，英伟达联合创办人黄仁勋在周日与公司董事会进行的一场长达数小时的会议上，除了已被广泛报道的那两段婚外情外，他又向董事会披露了其他数段婚外情，但他对自己这些行为感到悔恨。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261124-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E9%BB%84%E4%BB%81%E5%8B%8B%E6%9C%89%E4%B8%80%E4%BD%8D%E9%9D%9E%E5%B8%B8%E5%A5%BD%E7%9A%84%E5%A6%BB%E5%AD%90-%E5%8A%A0%E5%B7%9E%E6%A3%80%E6%96%B9%E8%AA%93%E8%A8%80%E7%BB%A7%E7%BB%AD%E6%9F%A5%E8%8B%B1%E4%BC%9F%E8%BE%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795533401000.webp","sourceId":"rfi"},{"id":1795531776000,"createdDate":"2026-11-24 14:49","name":"法国国际广播电台","title":"视频 兜帽为何它总是名声不佳？","content":"无处不在的兜帽总是名声不佳，在示威游行中，无论是在暴力冲突还是和平示威中，都能看到穿着兜帽的人，然而这种服饰却常常与犯罪联系在一起，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261124-%E8%A7%86%E9%A2%91-%E5%85%9C%E5%B8%BD%E4%B8%BA%E4%BD%95%E5%AE%83%E6%80%BB%E6%98%AF%E5%90%8D%E5%A3%B0%E4%B8%8D%E4%BD%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795531776000.webp","sourceId":"rfi"},{"id":1795529234000,"createdDate":"2026-11-24 14:07","name":"法国国际广播电台","title":"美国即将公布工业补贴调查结果 拟对中国等数十国加征关税","content":"据《华尔街日报》援引熟悉相关计划的人士报导称，美国正准备对中国以及其他数十个国家提高关税。特朗普政府认为，这些国家通过支持本国工业生产，正在损害美国企业的利益。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261124-%E7%BE%8E%E5%9B%BD%E5%8D%B3%E5%B0%86%E5%85%AC%E5%B8%83%E5%B7%A5%E4%B8%9A%E8%A1%A5%E8%B4%B4%E8%B0%83%E6%9F%A5%E7%BB%93%E6%9E%9C-%E6%8B%9F%E5%AF%B9%E4%B8%AD%E5%9B%BD%E7%AD%89%E6%95%B0%E5%8D%81%E5%9B%BD%E5%8A%A0%E5%BE%81%E5%85%B3%E7%A8%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795529234000.webp","sourceId":"rfi"},{"id":1795522304000,"createdDate":"2026-11-24 12:11","name":"法国国际广播电台","title":"视频 : 黄仁勋重返英伟达 台湾支持者欣喜","content":"在黄仁勋被迫离职不到两周后,周二他重返英伟达（Nvidia）继续担任首席执行官，台湾民众对此表示欣喜，请看视频报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261124-%E8%A7%86%E9%A2%91-%E9%BB%84%E4%BB%81%E5%8B%8B%E9%87%8D%E8%BF%94%E8%8B%B1%E4%BC%9F%E8%BE%BE-%E5%8F%B0%E6%B9%BE%E6%94%AF%E6%8C%81%E8%80%85%E6%AC%A3%E5%96%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795522304000.webp","sourceId":"rfi"},{"id":1795521647000,"createdDate":"2026-11-24 12:00","name":"法国国际广播电台","title":"黄仁勋重返英伟达：从“出局”到回归的AI巨头风波","content":"法国报纸周二关注英伟达创始人兼首席执行官黄仁勋重返公司的消息，多家媒体从市场反应、企业治理以及美国政治因素等不同角度，分析这场围绕人工智能巨头的风波。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261124-%E9%BB%84%E4%BB%81%E5%8B%8B%E9%87%8D%E8%BF%94%E8%8B%B1%E4%BC%9F%E8%BE%BE-%E4%BB%8E-%E5%87%BA%E5%B1%80-%E5%88%B0%E5%9B%9E%E5%BD%92%E7%9A%84ai%E5%B7%A8%E5%A4%B4%E9%A3%8E%E6%B3%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795521647000.webp","sourceId":"rfi"},{"id":1795521646000,"createdDate":"2026-11-24 12:00","name":"法国国际广播电台","title":"《法兰克福汇报》：深圳三巨头会晤并没有瓜分世界","content":"德国媒体还在探寻深圳中美俄三巨头会晤的意义。就在三巨头深圳会晤的同时，柏林打擂台，也举行了一场国际会晤，即援助乌克兰国家的会晤，以显示自己应对三巨头的雄心。柏林的对台戏留给德国媒体又是什么样的观感呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20261124-%E6%B3%95%E5%85%B0%E5%85%8B%E7%A6%8F%E6%B1%87%E6%8A%A5-%E6%B7%B1%E5%9C%B3%E4%B8%89%E5%B7%A8%E5%A4%B4%E4%BC%9A%E6%99%A4%E5%B9%B6%E6%B2%A1%E6%9C%89%E7%93%9C%E5%88%86%E4%B8%96%E7%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795521646000.webp","sourceId":"rfi"},{"id":1795521477000,"createdDate":"2026-11-24 11:57","name":"法国国际广播电台","title":"缅甸种族灭绝案：国际法院判决如何影响未来国际诉讼？","content":"国际法院上周裁定，缅甸政府须为对罗兴亚人犯下的种族灭绝罪行承担责任，并就相关损害作出赔偿。这是国际法院首度裁定一个国家须为种族灭绝负责，被视为国际司法史上的重要里程碑，也可能为日后类似案件确立重要的法律先例。今天，我们将透过两段专访，深入了解这项判决的法律意义，以及它可能对其他种族灭绝诉讼带来的影响。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%85%AC%E6%B0%91%E8%AE%BA%E5%9D%9B/20261124-%E7%BC%85%E7%94%B8%E7%A7%8D%E6%97%8F%E7%81%AD%E7%BB%9D%E6%A1%88-%E5%9B%BD%E9%99%85%E6%B3%95%E9%99%A2%E5%88%A4%E5%86%B3%E5%A6%82%E4%BD%95%E5%BD%B1%E5%93%8D%E6%9C%AA%E6%9D%A5%E5%9B%BD%E9%99%85%E8%AF%89%E8%AE%BC","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795521477000.webp","sourceId":"rfi"},{"id":1795520816000,"createdDate":"2026-11-24 11:46","name":"法国国际广播电台","title":"官宣上海市委书记陈吉宁涉嫌严重违纪违法 正接受审查调查","content":"中国官媒新华社周二（24日）报导指，中央政治局委员、上海市委书记陈吉宁涉嫌严重违纪违法，目前正接受中央纪委国家监委审查调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261124-%E5%AE%98%E5%AE%A3%E9%99%88%E5%90%89%E5%AE%81%E6%B6%89%E5%AB%8C%E4%B8%A5%E9%87%8D%E8%BF%9D%E7%BA%AA%E8%BF%9D%E6%B3%95-%E6%AD%A3%E6%8E%A5%E5%8F%97%E5%AE%A1%E6%9F%A5%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795520816000.webp","sourceId":"rfi"},{"id":1795520247000,"createdDate":"2026-11-24 11:37","name":"法国国际广播电台","title":"美商务部将阿里子公司和Megaspeed等7公司列入实体清单","content":"在美国国会议员和政府高官提出批评后，美国商务部周一将Megaspeed以及阿里巴巴旗下在新加坡的子公司——该公司与身陷英伟达丑闻漩涡的云服务公司存在业务往来——列入了贸易黑名单。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261124-%E7%BE%8E%E5%95%86%E5%8A%A1%E9%83%A8%E5%B0%86%E9%98%BF%E9%87%8C%E5%AD%90%E5%85%AC%E5%8F%B8%E5%92%8Cmegaspeed%E7%AD%897%E5%85%AC%E5%8F%B8%E5%88%97%E5%85%A5%E5%AE%9E%E4%BD%93%E6%B8%85%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/24/1795520247000.webp","sourceId":"rfi"}]