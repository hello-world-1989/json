[{"id":1793644063000,"createdDate":"2026-11-02 18:27","name":"法国国际广播电台","title":"美国佛州发生空难　机上九人无一生还","content":"综合法新社和美联社报道，美国佛罗里达州棕榈滩县星期天下午发生严重空难。一架由美国德州奥斯汀起飞、原定飞往巴哈马的里尔60型公务机，在飞行途中坠毁于棕榈滩县格林埃克斯（Greenacres）住宅区附近，机上九人全部罹难。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261102-%E7%BE%8E%E5%9B%BD%E4%BD%9B%E5%B7%9E%E5%8F%91%E7%94%9F%E7%A9%BA%E9%9A%BE-%E6%9C%BA%E4%B8%8A%E4%B9%9D%E4%BA%BA%E6%97%A0%E4%B8%80%E7%94%9F%E8%BF%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793644063000.webp","sourceId":"rfi"},{"id":1793643271000,"createdDate":"2026-11-02 18:14","name":"法国国际广播电台","title":"特朗普称会赦免马斯克，以避免民主党选举获胜后展开调查","content":"美国总统特朗普（DonaldTrump）表示，如果民主党在期中选举后重新控制众议院，并对亿万富豪、特斯拉（Tesla）及太空探索科技公司（SpaceX）行政总裁马斯克（ElonMusk）展开调查，他将设法保护马斯克，甚至可能预先特赦他及其他白宫幕僚和政治盟友。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261102-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%BC%9A%E8%B5%A6%E5%85%8D%E9%A9%AC%E6%96%AF%E5%85%8B%EF%BC%8C%E4%BB%A5%E9%81%BF%E5%85%8D%E6%B0%91%E4%B8%BB%E5%85%9A%E9%80%89%E4%B8%BE%E8%8E%B7%E8%83%9C%E5%90%8E%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793643271000.webp","sourceId":"rfi"},{"id":1793639343000,"createdDate":"2026-11-02 17:09","name":"法国国际广播电台","title":"继法国之后，欧洲多国超市冷柜系统遭网攻 再凸显物联网设备脆弱性","content":"比利时、爱沙尼亚、芬兰、卢森堡和瑞典的多家超市周一上午发现，其冰箱和冷冻柜的温度急剧上升，迫使他们不得不丢弃变质的食品，与法国一些超市10月遭遇一样。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261102-%E7%BB%A7%E6%B3%95%E5%9B%BD%E4%B9%8B%E5%90%8E%EF%BC%8C%E6%AC%A7%E6%B4%B2%E5%A4%9A%E5%9B%BD%E8%B6%85%E5%B8%82%E5%86%B7%E6%9F%9C%E7%B3%BB%E7%BB%9F%E9%81%AD%E7%BD%91%E6%94%BB-%E5%86%8D%E5%87%B8%E6%98%BE%E7%89%A9%E8%81%94%E7%BD%91%E8%AE%BE%E5%A4%87%E8%84%86%E5%BC%B1%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793639343000.webp","sourceId":"rfi"},{"id":1793634312000,"createdDate":"2026-11-02 15:45","name":"法国国际广播电台","title":"盘点第17届生物多样性峰会的成果","content":"第十七届联合国气候变化大会（COP17）于上周六在亚美尼亚首都埃里温闭幕。经过了马拉松式的谈判，周六深夜召开的最后一场会议终于传出了掌声。亚美尼亚环境部长汉巴尔祖姆·马特沃相如释重负地宣布通过了两项重要的、基于妥协的文本。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261102-%E7%9B%98%E7%82%B9%E7%AC%AC17%E5%B1%8A%E7%94%9F%E7%89%A9%E5%A4%9A%E6%A0%B7%E6%80%A7%E5%B3%B0%E4%BC%9A%E7%9A%84%E6%88%90%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793634312000.webp","sourceId":"rfi"},{"id":1793634015000,"createdDate":"2026-11-02 15:40","name":"法国国际广播电台","title":"泄露个人信息2.6亿件 日本为什么成网络攻击重灾区？","content":"据日本个人信息保护委员会透露，自2026年4月以来，该委员会接到企业报告的因非法访问而导致的个人信息泄露事件，累计涉及人次约达2.6亿人次，约是日本人口的两倍。根据IBM网络安全部门发布的报告《X-Force威胁情报指数2022》，2021年遭受网络攻击最多的国家是日本，而在新的一轮网络攻击中，日本也是重灾区。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%B8%9C%E4%BA%AC%E4%B8%93%E6%A0%8F/20261102-%E6%B3%84%E9%9C%B2%E4%B8%AA%E4%BA%BA%E4%BF%A1%E6%81%AF2-6%E4%BA%BF%E4%BB%B6-%E6%97%A5%E6%9C%AC%E4%B8%BA%E4%BB%80%E4%B9%88%E6%88%90%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB%E9%87%8D%E7%81%BE%E5%8C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793634015000.webp","sourceId":"rfi"},{"id":1793632529000,"createdDate":"2026-11-02 15:15","name":"法国国际广播电台","title":"曼谷机场查获近9000支瘦瘦针 中国旅客涉走私被逮捕","content":"中央社曼谷2日电：泰国海关近日在曼谷素万那普国际机场查获一起走私案，一名从孟加拉飞抵泰国的中国籍旅客的行李中，被查获藏有近9000支俗称「瘦瘦针」的注射笔，遭逮捕。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261102-%E6%9B%BC%E8%B0%B7%E6%9C%BA%E5%9C%BA%E6%9F%A5%E8%8E%B7%E8%BF%919000%E6%94%AF%E7%98%A6%E7%98%A6%E9%92%88-%E4%B8%AD%E5%9B%BD%E6%97%85%E5%AE%A2%E6%B6%89%E8%B5%B0%E7%A7%81%E8%A2%AB%E9%80%AE%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793632529000.webp","sourceId":"rfi"},{"id":1793631666000,"createdDate":"2026-11-02 15:01","name":"法国国际广播电台","title":"美中期选举投票尚未启动，对投票结果的质疑已如影随形","content":"距离2026美国中期选举11月3日的投票启动只剩最后24小时。选民将选出众议院全部435名议员。由100名议员组成的参议院则有三分之一，也就是35个议员席位参加选举。虽说中期选举通常对在职总统所在政党不利，但今年的选举争夺则格外激烈。多项民调虽然预测民主党有望在众议院翻盘，但朝野两党目前围绕参议院选举的争夺似乎呈现势均力敌的局面。而这种胶着不明的情况也为投票日之后的检票结果争议留下空间。2020年围绕总统选举检票争议发生的冲击国会山事件是否会重演引发关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261102-%E7%BE%8E%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E6%8A%95%E7%A5%A8%E5%B0%9A%E6%9C%AA%E5%90%AF%E5%8A%A8%EF%BC%8C%E5%AF%B9%E6%8A%95%E7%A5%A8%E7%BB%93%E6%9E%9C%E7%9A%84%E8%B4%A8%E7%96%91%E5%B7%B2%E5%A6%82%E5%BD%B1%E9%9A%8F%E5%BD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793631666000.webp","sourceId":"rfi"},{"id":1793631325000,"createdDate":"2026-11-02 14:55","name":"法国国际广播电台","title":"在局部停火结束后，乌克兰和俄罗斯先后报告遭遇网络攻击","content":"法新社2日基辅消息，乌克兰昨晚表示，其面向民众的预警移动应用程序遭到黑客攻击；随后，俄罗斯于周一宣布，在前线局部停火结束不久，其紧急情况部开发的应用程序遭到攻击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261102-%E5%9C%A8%E5%B1%80%E9%83%A8%E5%81%9C%E7%81%AB%E7%BB%93%E6%9D%9F%E5%90%8E%EF%BC%8C%E4%B9%8C%E5%85%8B%E5%85%B0%E5%92%8C%E4%BF%84%E7%BD%97%E6%96%AF%E5%85%88%E5%90%8E%E6%8A%A5%E5%91%8A%E9%81%AD%E9%81%87%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793631325000.webp","sourceId":"rfi"},{"id":1793630343000,"createdDate":"2026-11-02 14:39","name":"法国国际广播电台","title":"路透: 伊朗全球隐秘军购网络成功绕过美国的封锁","content":"5,000多个机构共同构成了一个强大的金融和军事机器，其中的一个机构就进口了大量火箭推进剂、爆炸物和武器部件，此外还进口了可作为导弹发射车的重型卡车。这些物资通过陆路、海路和空路运入伊朗，其中大部分记录的来源地是中国、俄罗斯和德国。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261102-%E8%B7%AF%E9%80%8F-%E4%BC%8A%E6%9C%97%E5%85%A8%E7%90%83%E9%9A%90%E7%A7%98%E5%86%9B%E8%B4%AD%E7%BD%91%E7%BB%9C%E6%88%90%E5%8A%9F%E7%BB%95%E8%BF%87%E7%BE%8E%E5%9B%BD%E7%9A%84%E5%B0%81%E9%94%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793630343000.webp","sourceId":"rfi"},{"id":1793630250000,"createdDate":"2026-11-02 14:37","name":"法国国际广播电台","title":"印度1.3亿选民遭除名引爆全国抗议：莫迪政府面临新的政治挑战","content":"印度近期因选民册修订而爆发全国性大规模抗议。抗议浪潮蔓延到多个地区，参与者包括反对党、学生团体、民间和社会组织等。示威者的诉求之一，是要求印度首席选举专员吉亚内什·库马尔辞职，并叫停对选民名册的修订。这一修订被批评“文件要求严格、截止期限紧迫、删除选民规模大”。此事发生在印度总理莫迪的第三任期的中期，成为印度国内新的政治挑战。虽然11月1日新德里又爆发新的示威，但莫迪政府依然稳定，按计划，下一次印度大选要到2029年才会举行。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20261102-%E5%8D%B0%E5%BA%A61-3%E4%BA%BF%E9%80%89%E6%B0%91%E9%81%AD%E9%99%A4%E5%90%8D%E5%BC%95%E7%88%86%E5%85%A8%E5%9B%BD%E6%8A%97%E8%AE%AE-%E8%8E%AB%E8%BF%AA%E6%94%BF%E5%BA%9C%E9%9D%A2%E4%B8%B4%E6%96%B0%E7%9A%84%E6%94%BF%E6%B2%BB%E6%8C%91%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793630250000.webp","sourceId":"rfi"},{"id":1793629278000,"createdDate":"2026-11-02 14:21","name":"法国国际广播电台","title":"默茨亚洲行：寻求深化印太布局、降低对华依赖","content":"德国总理弗里德里希·默茨近日进行了为期一周的亚洲之旅，访问新加坡、日本、韩国期间，释放出一系列合作信号。他多次强调，欧洲和亚洲需要在全球贸易秩序变化、关税措施增加、国际安全形势变化当中，加强协调；欧洲和亚洲应该在贸易、技术、防卫和关键原材料等领域，建立起更加紧密的合作。路透社总结认为，本次默茨的亚洲之行，明显提出几个方向：维护基于规则的贸易、降低供应链对单一来源，例如对中国的依赖、开拓未来的技术市场，深化国防工业合作、以维护各自的自由、主权、安全与繁荣。。德国与韩国建立强化战略伙伴关系、与日本讨论战斗机合作项目，推动欧盟与“全面与进步跨太平洋伙伴关系”协定成员国开展跨区域贸易合作，均是例证。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20261102-%E9%BB%98%E8%8C%A8%E4%BA%9A%E6%B4%B2%E8%A1%8C-%E5%AF%BB%E6%B1%82%E6%B7%B1%E5%8C%96%E5%8D%B0%E5%A4%AA%E5%B8%83%E5%B1%80-%E9%99%8D%E4%BD%8E%E5%AF%B9%E5%8D%8E%E4%BE%9D%E8%B5%96","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793629278000.webp","sourceId":"rfi"},{"id":1793627545000,"createdDate":"2026-11-02 13:52","name":"法国国际广播电台","title":"中国化学品出口激增 或引发新贸易战","content":"中国在五年间，部分关键化学原料产量几乎翻了一番，不仅对发达经济体的出口正在增长，且在本国市场迅速取代外国产品的销售份额，并在新兴市场击败现有竞争对手。欧洲计划关闭的化工产能已从2022年的290万吨增至2025年的1720万吨，增长了六倍。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261102-%E4%B8%AD%E5%9B%BD%E5%8C%96%E5%AD%A6%E5%93%81%E5%87%BA%E5%8F%A3%E6%BF%80%E5%A2%9E-%E6%88%96%E5%BC%95%E5%8F%91%E6%96%B0%E8%B4%B8%E6%98%93%E6%88%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793627545000.webp","sourceId":"rfi"},{"id":1793625887000,"createdDate":"2026-11-02 13:24","name":"法国国际广播电台","title":"美中期选举 、苹果财报、多国央行会议受市场聚焦","content":"多重市场主题交织碰撞，包括美国关键中期选举、关键经济数据、大型科技公司财报，以及一系列央行会议，都将对投资者构成考验。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E4%BB%8A%E6%97%A5%E7%BB%8F%E6%B5%8E/20261102-%E7%BE%8E%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE-%E8%8B%B9%E6%9E%9C%E8%B4%A2%E6%8A%A5-%E5%A4%9A%E5%9B%BD%E5%A4%AE%E8%A1%8C%E4%BC%9A%E8%AE%AE%E5%8F%97%E5%B8%82%E5%9C%BA%E8%81%9A%E7%84%A6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793625887000.webp","sourceId":"rfi"},{"id":1793625801000,"createdDate":"2026-11-02 13:23","name":"法国国际广播电台","title":"“世界钴都”，中美争夺","content":"11月2日星期一出刊的法国主流日刊有多篇与中国相关的报道。首先一起来看费加罗报长篇聚焦的，中美争夺的“世界钴元素之都”-刚果民主共和国的科卢韦齐。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261102-%E4%B8%96%E7%95%8C%E9%92%B4%E9%83%BD-%EF%BC%8C%E4%B8%AD%E7%BE%8E%E4%BA%89%E5%A4%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793625801000.webp","sourceId":"rfi"},{"id":1793621579000,"createdDate":"2026-11-02 12:12","name":"法国国际广播电台","title":"法国中学秋假后返校第一天，堵校罢课行动重启但响应者有限","content":"11月2日星期一，原则上是法国大中小学校万圣节秋假结束，返校复课第一天。但有些中学响应学生组织呼吁，再次启动堵校门，呼吁罢课和游行的活动。截至本台本次播音开始前，法国各地再现封堵校门的情况依然相对有限，能否再次形成规模有待关注。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261102-%E6%B3%95%E5%9B%BD%E4%B8%AD%E5%AD%A6%E7%A7%8B%E5%81%87%E5%90%8E%E8%BF%94%E6%A0%A1%E7%AC%AC%E4%B8%80%E5%A4%A9%EF%BC%8C%E5%A0%B5%E6%A0%A1%E7%BD%A2%E8%AF%BE%E8%A1%8C%E5%8A%A8%E9%87%8D%E5%90%AF%E4%BD%86%E5%93%8D%E5%BA%94%E8%80%85%E6%9C%89%E9%99%90","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793621579000.webp","sourceId":"rfi"},{"id":1793620726000,"createdDate":"2026-11-02 11:58","name":"法国国际广播电台","title":"中国经济：独立指数显示制造业活动连续11个月扩张","content":"周一（11月2日）发布的一项独立指数显示，10月份中国制造业活动实现连续第11个月增长。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261102-%E4%B8%AD%E5%9B%BD%E7%BB%8F%E6%B5%8E-%E7%8B%AC%E7%AB%8B%E6%8C%87%E6%95%B0%E6%98%BE%E7%A4%BA%E5%88%B6%E9%80%A0%E4%B8%9A%E6%B4%BB%E5%8A%A8%E8%BF%9E%E7%BB%AD11%E4%B8%AA%E6%9C%88%E6%89%A9%E5%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793620726000.webp","sourceId":"rfi"},{"id":1793612070000,"createdDate":"2026-11-02 09:34","name":"法国国际广播电台","title":"台北市长选举辩论后 民进党参选人沈伯洋民调首度突破五成","content":"台湾韬略策进学会在2日公最新民调显示，沈伯洋支持度首度突破5成，来到52.6%，胜于蒋万安的35.3%，双方支持度拉大到17.3%。在选举看好度方面，沈伯洋也首度超越蒋万安，出现「黄金交叉」。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261102-%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E9%80%89%E4%B8%BE%E8%BE%A9%E8%AE%BA%E5%90%8E-%E6%B0%91%E8%BF%9B%E5%85%9A%E5%8F%82%E9%80%89%E4%BA%BA%E6%B2%88%E4%BC%AF%E6%B4%8B%E6%B0%91%E8%B0%83%E9%A6%96%E5%BA%A6%E7%AA%81%E7%A0%B4%E4%BA%94%E6%88%90","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793612070000.webp","sourceId":"rfi"},{"id":1793608264000,"createdDate":"2026-11-02 08:31","name":"法国国际广播电台","title":"驻冲绳美海军陆战队员在禁止夜间外出期间因酒驾遭逮捕","content":"日本防卫大臣小泉进次郎在11月2日内阁会议后的记者会上，就美国海军陆战队员在美军规定午夜零时以后全体军人禁止外出的时段内，因涉嫌违反《道路交通法》（酒后驾驶）被捕一事作出回应。他表示，日方已向美方“提出要求，确保彻底落实夜间外出禁令”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261102-%E9%A9%BB%E5%86%B2%E7%BB%B3%E7%BE%8E%E6%B5%B7%E5%86%9B%E9%99%86%E6%88%98%E9%98%9F%E5%91%98%E5%9C%A8%E7%A6%81%E6%AD%A2%E5%A4%9C%E9%97%B4%E5%A4%96%E5%87%BA%E6%9C%9F%E9%97%B4%E5%9B%A0%E9%85%92%E9%A9%BE%E9%81%AD%E9%80%AE%E6%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793608264000.webp","sourceId":"rfi"},{"id":1793607765000,"createdDate":"2026-11-02 08:22","name":"法国国际广播电台","title":"黎智英案传三污点证人提早获释 张剑虹因在官方改造团受访而令消息曝光","content":"曾在《苹果日报》创办人黎智英被控串谋勾结外国势力罪一案中顶证黎而获减刑的前社长张剑虹，疑与另外两名同样转为污点证人的被告获安排提早出狱。事件曝光，源於张剑虹随惩教署的更生人士访问深圳并接受亲北京媒体访问，赞扬中国科技发展，并为2019年煽惑抗争感到懊悔；但署方回应传媒查询时，表示不评论事件。评论指，事例反映涉及国安案件者，出狱后也没有真正的自由，必须配合官方要求进行政治宣传。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261102-%E9%BB%8E%E6%99%BA%E8%8B%B1%E6%A1%88%E4%BC%A0%E4%B8%89%E6%B1%A1%E7%82%B9%E8%AF%81%E4%BA%BA%E6%8F%90%E6%97%A9%E8%8E%B7%E9%87%8A-%E5%BC%A0%E5%89%91%E8%99%B9%E5%9B%A0%E5%9C%A8%E5%AE%98%E6%96%B9%E6%94%B9%E9%80%A0%E5%9B%A2%E5%8F%97%E8%AE%BF%E8%80%8C%E4%BB%A4%E6%B6%88%E6%81%AF%E6%9B%9D%E5%85%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793607765000.webp","sourceId":"rfi"},{"id":1793607689000,"createdDate":"2026-11-02 08:21","name":"法国国际广播电台","title":"港府向全港幼稚园派国安绘本 国安教育扩至3至6岁幼儿","content":"香港在《港区国安法》实施后，持续加强对学生的国家安全及爱国教育，连幼稚园儿童亦成为国安教育的重点培训对象。港府计划把由保安局出版的一套国安儿童绘本，年底前发给全港超过900间幼稚园及公共图书馆，声称要让小朋友从小便知道国家安全的重要性。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261102-%E6%B8%AF%E5%BA%9C%E5%90%91%E5%85%A8%E6%B8%AF%E5%B9%BC%E7%A8%9A%E5%9B%AD%E6%B4%BE%E5%9B%BD%E5%AE%89%E7%BB%98%E6%9C%AC-%E5%9B%BD%E5%AE%89%E6%95%99%E8%82%B2%E6%89%A9%E8%87%B33%E8%87%B36%E5%B2%81%E5%B9%BC%E5%84%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/02/1793607689000.webp","sourceId":"rfi"}]