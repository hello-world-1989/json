[{"id":1794293185000,"createdDate":"2026-11-10 06:46","name":"法国国际广播电台","title":"教徒为宏福苑大火死者办祈祷会亦受限 须模糊化处理 灾民感失望不满","content":"导致168人死亡的大埔宏福苑火灾快将迎来一周年，保安局长邓炳强表示，悼念活动须依法办事，当局亦会协助。言犹在耳，大埔天主教堂欲为宏福苑火灾灾民举办弥撒，在警方多次「查询」後，改为为过去一年的所有亡者祈祷。一个火灾家属群组对此大感失望和不满；曾任宗教刊物社长多年的评论员李锦洪亦表示，只有宗教力量可以重建心灵，港府现时只要一种声音和政策的做法，只会令民心不满情绪更浮面，是适得其反。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261110-%E6%95%99%E5%BE%92%E4%B8%BA%E5%AE%8F%E7%A6%8F%E8%8B%91%E5%A4%A7%E7%81%AB%E6%AD%BB%E8%80%85%E5%8A%9E%E7%A5%88%E7%A5%B7%E4%BC%9A%E4%BA%A6%E5%8F%97%E9%99%90-%E9%A1%BB%E6%A8%A1%E7%B3%8A%E5%8C%96%E5%A4%84%E7%90%86-%E7%81%BE%E6%B0%91%E6%84%9F%E5%A4%B1%E6%9C%9B%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794293185000.webp","sourceId":"rfi"},{"id":1794269603000,"createdDate":"2026-11-10 00:13","name":"法国国际广播电台","title":"黄仁勋婚外情：其影响可能远超个人婚外情","content":"一家估值达4.5万亿美元的美国人工智能巨头的掌门人，竟与一名可能是中国间谍的女子保持秘密恋情！这名叫黄乐的中国女子目前具体下落不明。美国媒体未能联系到她，也没有获得她的回应。她似乎已经销声匿迹。但是，不管怎样，这起事件的影响可能远超个人婚外情。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261110-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%A9%9A%E5%A4%96%E6%83%85-%E5%85%B3%E9%94%AE%E5%AE%83%E6%98%AF%E4%B8%8D%E6%98%AF%E4%B8%AA%E9%97%B4%E8%B0%8D%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794269603000.webp","sourceId":"rfi"},{"id":1794269442000,"createdDate":"2026-11-10 00:10","name":"法国国际广播电台","title":"塞浦路斯岛南北双方领导人同意再开放两个新的过境点","content":"联合国宣布，11月9日星期一，塞浦路斯岛南北双方领导人同意沿着分隔该岛的“绿线”再开放两个新的过境点。这是双方为重新启动统一谈判所作的持续努力之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E5%A1%9E%E6%B5%A6%E8%B7%AF%E6%96%AF%E5%B2%9B%E5%8D%97%E5%8C%97%E5%8F%8C%E6%96%B9%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%90%8C%E6%84%8F%E5%86%8D%E5%BC%80%E6%94%BE%E4%B8%A4%E4%B8%AA%E6%96%B0%E7%9A%84%E8%BF%87%E5%A2%83%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794269442000.webp","sourceId":"rfi"},{"id":1794326487000,"createdDate":"2026-11-10 16:01","name":"法国国际广播电台","title":"特朗普为黄仁勋辩护：“他说自己完全不知道那个人是间谍”","content":"美国总统特朗普周一为人工智能（AI）芯片巨头英伟达（Nvidia）首席执行官黄仁勋的诚意作保，称黄仁勋“完全不知道”自己的情妇可能在为中国进行间谍活动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%BA%E9%BB%84%E4%BB%81%E5%8B%8B%E8%BE%A9%E6%8A%A4-%E4%BB%96%E8%AF%B4%E8%87%AA%E5%B7%B1%E5%AE%8C%E5%85%A8%E4%B8%8D%E7%9F%A5%E9%81%93%E9%82%A3%E4%B8%AA%E4%BA%BA%E6%98%AF%E9%97%B4%E8%B0%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794326487000.webp","sourceId":"rfi"},{"id":1794324899000,"createdDate":"2026-11-10 15:34","name":"法国国际广播电台","title":"英伟达因黄仁勋涉谍案遭起诉 诉讼曝光之际股价已跌近5%","content":"在报道称英伟达首席执行官黄仁勋与一名涉嫌为中国间谍的女子有染后，周一，英伟达的股价暴跌近5%，随后该公司遭到股东起诉。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%9B%A0%E9%BB%84%E4%BB%81%E5%8B%8B%E6%B6%89%E8%B0%8D%E6%A1%88%E9%81%AD%E8%B5%B7%E8%AF%89-%E8%AF%89%E8%AE%BC%E6%9B%9D%E5%85%89%E4%B9%8B%E9%99%85%E8%82%A1%E4%BB%B7%E5%B7%B2%E8%B7%8C%E8%BF%915","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794324899000.webp","sourceId":"rfi"},{"id":1794324119000,"createdDate":"2026-11-10 15:21","name":"法国国际广播电台","title":"法国承诺对伊朗网攻超市冰柜系统进行隐秘制裁与报复 欧盟准备加入","content":"法国周一指责伊朗是10月大规模网络攻击数百超市联网冰柜的幕后黑手，目前正筹备对德黑兰进行反击，包括采取不会公开披露的措施。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E6%B3%95%E5%9B%BD%E6%89%BF%E8%AF%BA%E5%AF%B9%E4%BC%8A%E6%9C%97%E7%BD%91%E6%94%BB%E8%B6%85%E5%B8%82%E5%86%B0%E6%9F%9C%E7%B3%BB%E7%BB%9F%E8%BF%9B%E8%A1%8C%E9%9A%90%E7%A7%98%E5%88%B6%E8%A3%81%E4%B8%8E%E6%8A%A5%E5%A4%8D-%E6%AC%A7%E7%9B%9F%E5%87%86%E5%A4%87%E5%8A%A0%E5%85%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794324119000.webp","sourceId":"rfi"},{"id":1794320972000,"createdDate":"2026-11-10 14:29","name":"法国国际广播电台","title":"最新报告显示2026年全球碳排放或减少0.4%  专家对此如何解读","content":"全球碳计划项目（GlobalCarbonProject）今天周二发布第21版有关全球碳排放的统计报告，报告显示，由于中东冲突导致全球石油和天然气消费量下降，以及风力涡轮机和太阳能电池板的快速部署，预计全球今年的二氧化碳排放量将为382亿吨，比2025年的384亿吨碳相对比下降了0.4%，而2024年至2025年间，二氧化碳排放量曾增长了1.2%。今年是除新冠疫情期间之外，全球碳排放首次出现下降的一年。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261110-%E6%9C%80%E6%96%B0%E6%8A%A5%E5%91%8A%E6%98%BE%E7%A4%BA2026%E5%B9%B4%E5%85%A8%E7%90%83%E7%A2%B3%E6%8E%92%E6%94%BE%E6%88%96%E5%B0%86%E5%87%8F%E5%B0%910-4-%E4%B8%93%E5%AE%B6%E5%AF%B9%E6%AD%A4%E5%A6%82%E4%BD%95%E8%A7%A3%E8%AF%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794320972000.webp","sourceId":"rfi"},{"id":1794318529000,"createdDate":"2026-11-10 13:48","name":"法国国际广播电台","title":"《法兰克福汇报》：美国外交政策仍大部分由总统决定","content":"美国中期选举结果引发德语媒体极大关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9F%8F%E6%9E%97%E9%A3%9E%E9%B8%BF/20261110-%E6%B3%95%E5%85%B0%E5%85%8B%E7%A6%8F%E6%B1%87%E6%8A%A5-%E7%BE%8E%E5%9B%BD%E5%A4%96%E4%BA%A4%E6%94%BF%E7%AD%96%E4%BB%8D%E5%A4%A7%E9%83%A8%E5%88%86%E7%94%B1%E6%80%BB%E7%BB%9F%E5%86%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794318529000.webp","sourceId":"rfi"},{"id":1794317683000,"createdDate":"2026-11-10 13:34","name":"法国国际广播电台","title":"媒体报道陶宛要求台湾驻该国代表处更名，台湾表示名称是双方共识 没有更名计划","content":"对于立陶宛要求台湾驻维尔纽斯代表处更名的报道，台湾做出回应，其外交部发言人表示名称是双方达成的共识。外交次长表示目前没有更名计划。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E5%AA%92%E4%BD%93%E6%8A%A5%E9%81%93%E9%99%B6%E5%AE%9B%E8%A6%81%E6%B1%82%E5%8F%B0%E6%B9%BE%E9%A9%BB%E8%AF%A5%E5%9B%BD%E4%BB%A3%E8%A1%A8%E5%A4%84%E6%9B%B4%E5%90%8D%EF%BC%8C%E5%8F%B0%E6%B9%BE%E8%A1%A8%E7%A4%BA%E5%90%8D%E7%A7%B0%E6%98%AF%E5%8F%8C%E6%96%B9%E5%85%B1%E8%AF%86-%E6%B2%A1%E6%9C%89%E6%9B%B4%E5%90%8D%E8%AE%A1%E5%88%92","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794317683000.webp","sourceId":"rfi"},{"id":1794313844000,"createdDate":"2026-11-10 12:30","name":"法国国际广播电台","title":"美国斡旋，俄乌在阿联酋重启谈判，割让领土等重大分歧尚无进展","content":"俄罗斯和乌克兰代表团11月10日在阿联酋阿布扎比举行会谈。这是自今年2月以来，双方首次在美国斡旋下展开此类谈判。美国总统特朗普此前表示，结束乌克兰战争、实现欧洲安全的全面协议有望达成。随着谈判的启动，战后欧洲安全架构、乌克兰领土归属以及未来安全保障等问题，又一次成为各方关注的重点。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261110-%E7%BE%8E%E5%9B%BD%E6%96%A1%E6%97%8B%EF%BC%8C%E4%BF%84%E4%B9%8C%E5%9C%A8%E9%98%BF%E8%81%94%E9%85%8B%E9%87%8D%E5%90%AF%E8%B0%88%E5%88%A4%EF%BC%8C%E5%89%B2%E8%AE%A9%E9%A2%86%E5%9C%9F%E7%AD%89%E9%87%8D%E5%A4%A7%E5%88%86%E6%AD%A7%E5%B0%9A%E6%97%A0%E8%BF%9B%E5%B1%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794313844000.webp","sourceId":"rfi"},{"id":1794313371000,"createdDate":"2026-11-10 12:22","name":"法国国际广播电台","title":"黄仁勋陷疑似中国间谍事件 人工智能行业震荡","content":"周二（11月10日）法国各大报纸头版关注的议题各有侧重，《费加罗报》聚焦全球气候变化，报道2026年全球碳排放有望依赖历史性下降，除了霍尔木兹海峡被封因素外，可再生能源的发展成为推动减排的主要力量。报纸同时关注教皇良十四世访问拉美国家阿根廷。《解放报》头版关注法国国内议题，总理勒科尔尼宣布自12月1日起提高最低工资至每月净收1500欧元以上，但工会并不满意这一涨幅，而各方对后续社会动员也存在分歧。《十字架报》聚焦同一主题，重点关注法国近300万拿最低工资人群、其真实的生活状况。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261110-%E5%8D%B1%E9%99%A9%E7%9A%84%E5%85%B3%E7%B3%BB-%E8%8B%B1%E4%BC%9F%E8%BE%BEceo%E9%99%B7%E7%96%91%E4%BC%BC%E4%B8%AD%E5%9B%BD%E9%97%B4%E8%B0%8D%E4%BA%8B%E4%BB%B6%E9%9C%87%E8%8D%A1%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E8%A1%8C%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794313371000.webp","sourceId":"rfi"},{"id":1794312429000,"createdDate":"2026-11-10 12:07","name":"法国国际广播电台","title":"《信息报》：英伟达CEO与涉谍情人导致向中国输送了75亿美元芯片","content":"据《TheInformation》报道，黄乐（AliceHuang）、她的丈夫和姊妹在中国和新加坡建立了一个公司网络，用于采购英伟达芯片，其中上海世纪利通公司获得了该芯片制造商授予的“优先云合作伙伴”资格。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E4%BF%A1%E6%81%AF%E6%8A%A5-%E8%8B%B1%E4%BC%9F%E8%BE%BEceo%E4%B8%8E%E6%B6%89%E8%B0%8D%E6%83%85%E4%BA%BA%E5%90%91%E4%B8%AD%E5%9B%BD%E8%BE%93%E9%80%81%E4%BA%8675%E4%BA%BF%E7%BE%8E%E5%85%83%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794312429000.webp","sourceId":"rfi"},{"id":1794308957000,"createdDate":"2026-11-10 11:09","name":"法国国际广播电台","title":"日美外长在法国举行会谈 鲁比奥继续批判国际刑事法院","content":"当地时间11月9日下午，正在法国巴黎出席七国集团（G7）外长会议的日本外务大臣茂木敏充，与美国国务卿马尔科·鲁比奥进行了意见交流。这是美国共和党在中期选举中惨败后，日美两国外长首次单独会面。双方着眼于11月即将举行的东南亚国家联盟（ASEAN）峰会、亚太经济合作组织（APEC）领导人非正式会议等今后的外交日程进行了磋商。茂木外相也向鲁比奥再次传达了日本支持遭美国制裁的国际刑事法院（ICC）的一贯立场。鲁比奥在会谈后接受记者采访时表示：“日美关系良好，但在国际刑事法院问题上，双方存在不同意见。”","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E6%97%A5%E7%BE%8E%E5%A4%96%E9%95%BF%E5%9C%A8%E6%B3%95%E5%9B%BD%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88-%E9%B2%81%E6%AF%94%E5%A5%A5%E7%BB%A7%E7%BB%AD%E6%89%B9%E5%88%A4%E5%9B%BD%E9%99%85%E5%88%91%E4%BA%8B%E6%B3%95%E9%99%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794308957000.webp","sourceId":"rfi"},{"id":1794307917000,"createdDate":"2026-11-10 10:51","name":"法国国际广播电台","title":"第31届联合国气候变化大会 : 2026年排放量略有下降 但“还不够”","content":"第31届联合国气候变化大会（COP31）周一在土耳其南部滨海城市安塔利亚开幕,全球温室气体排放量在2025年达到历史新高后，预计将在2026年略有下降，但“还不够”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E7%AC%AC31%E5%B1%8A%E8%81%94%E5%90%88%E5%9B%BD%E6%B0%94%E5%80%99%E5%8F%98%E5%8C%96%E5%A4%A7%E4%BC%9A-2026%E5%B9%B4%E6%8E%92%E6%94%BE%E9%87%8F%E7%95%A5%E6%9C%89%E4%B8%8B%E9%99%8D-%E4%BD%86-%E8%BF%98%E4%B8%8D%E5%A4%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794307917000.webp","sourceId":"rfi"},{"id":1794305263000,"createdDate":"2026-11-10 10:07","name":"法国国际广播电台","title":"APEC峰会前夕：俄罗斯多地加强与广东合作","content":"面对11月18日即将在深圳召开的亚太经合组织峰会，俄罗斯驻广州总领事11月10日星期二通过塔斯社表示，俄罗斯多地正表现出与中国广东省深化多领域合作的意愿。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-apec%E5%B3%B0%E4%BC%9A%E5%89%8D%E5%A4%95-%E4%BF%84%E7%BD%97%E6%96%AF%E5%A4%9A%E5%9C%B0%E5%8A%A0%E5%BC%BA%E4%B8%8E%E5%B9%BF%E4%B8%9C%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794305263000.webp","sourceId":"rfi"},{"id":1794347376000,"createdDate":"2026-11-10 21:49","name":"法国国际广播电台","title":"美中俄峰会筹备发生分歧 北京要求照稿发言","content":"美中俄能否在深圳APEC峰会期间举行三方会谈尚有疑问，据华尔街日报报道，北京与华盛顿在议程安排上出现分歧，中方要求严格按照预定程序进行，三位元首依次宣读声明，特朗普则希望自由讨论，而不是各自照稿发言。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E7%BE%8E%E4%B8%AD%E4%BF%84%E5%B3%B0%E4%BC%9A%E7%AD%B9%E5%A4%87%E5%8F%91%E7%94%9F%E5%88%86%E6%AD%A7-%E5%8C%97%E4%BA%AC%E8%A6%81%E6%B1%82%E7%85%A7%E7%A8%BF%E5%8F%91%E8%A8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794347376000.webp","sourceId":"rfi"},{"id":1794346461000,"createdDate":"2026-11-10 21:34","name":"法国国际广播电台","title":"法国指责上个月针对超市冷藏设备的网络攻击是伊朗干的， 伊朗拒绝法国的指控","content":"法国指责说，上个月针对超市冷藏设备的网络攻击是伊朗干的。伊朗周二表示，这种说法是“毫无根据的”。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261110-%E6%B3%95%E5%9B%BD%E6%8C%87%E8%B4%A3%E4%B8%8A%E4%B8%AA%E6%9C%88%E9%92%88%E5%AF%B9%E8%B6%85%E5%B8%82%E5%86%B7%E8%97%8F%E8%AE%BE%E5%A4%87%E7%9A%84%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB%E6%98%AF%E4%BC%8A%E6%9C%97%E5%B9%B2%E7%9A%84%EF%BC%8C-%E4%BC%8A%E6%9C%97%E6%8B%92%E7%BB%9D%E6%B3%95%E5%9B%BD%E7%9A%84%E6%8C%87%E6%8E%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794346461000.webp","sourceId":"rfi"},{"id":1794345867000,"createdDate":"2026-11-10 21:24","name":"法国国际广播电台","title":"美国国务卿： 目前没必要对伊朗展开大规模作战","content":"美国国务卿马可·卢比奥周二表示，目前没有必要针对伊朗开展大规模作战行动，因为经济制裁和其他限制措施成效显著。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%8A%A1%E5%8D%BF%E8%AF%B4%EF%BC%8C%E7%9B%AE%E5%89%8D%E6%B2%A1%E5%BF%85%E8%A6%81%E5%AF%B9%E4%BC%8A%E6%9C%97%E5%BC%80%E5%B1%95%E5%A4%A7%E8%A7%84%E6%A8%A1%E4%BD%9C%E6%88%98%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794345867000.webp","sourceId":"rfi"},{"id":1794345681000,"createdDate":"2026-11-10 21:21","name":"法国国际广播电台","title":"基辅与莫斯科在阿布扎比启动会谈，美国斡旋，泽连斯基说高兴","content":"基辅与莫斯科在阿布扎比开启了由美国斡旋的会谈，据华盛顿方面称，会谈旨在推动解决冲突，并着手构建一个涵盖欧洲的“新”安全框架。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E5%9F%BA%E8%BE%85%E4%B8%8E%E8%8E%AB%E6%96%AF%E7%A7%91%E5%9C%A8%E9%98%BF%E5%B8%83%E6%89%8E%E6%AF%94%E5%90%AF%E5%8A%A8%E4%BC%9A%E8%B0%88%EF%BC%8C%E7%BE%8E%E5%9B%BD%E6%96%A1%E6%97%8B%EF%BC%8C%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E8%AF%B4%E9%AB%98%E5%85%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794345681000.webp","sourceId":"rfi"},{"id":1794345325000,"createdDate":"2026-11-10 21:15","name":"法国国际广播电台","title":"德国有望迎来第一位女总统","content":"德国有望迎来第一位女总统。由基民盟和基社盟推举的德国联邦总统候选人伊尔泽·艾格纳（IlseAigner）已向多个议会党团介绍了自己。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261110-%E5%BE%B7%E5%9B%BD%E6%9C%89%E6%9C%9B%E8%BF%8E%E6%9D%A5%E7%AC%AC%E4%B8%80%E4%BD%8D%E5%A5%B3%E6%80%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794345325000.webp","sourceId":"rfi"},{"id":1794344882000,"createdDate":"2026-11-10 21:08","name":"法国国际广播电台","title":"美国撤销药明康德中国军企认定","content":"美国国防部宣布将药明康德移出中国军事企业名单，撤销今年6月作出的相关认定。此举是为遵从美国联邦法院今年8月的裁决，暂时解除药明康德因被列入名单而面临的部分监管风险，也为美中生物科技业的紧张关系带来缓和讯号。不过，美国政府仍可透过其他法律程序重新审查该公司，后续发展仍有待观察。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E7%BE%8E%E5%9B%BD%E6%92%A4%E9%94%80%E8%8D%AF%E6%98%8E%E5%BA%B7%E5%BE%B7%E4%B8%AD%E5%9B%BD%E5%86%9B%E4%BC%81%E8%AE%A4%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794344882000.webp","sourceId":"rfi"},{"id":1794335304000,"createdDate":"2026-11-10 18:28","name":"法国国际广播电台","title":"华盛顿谴责澳门对一名亲民主派前议员的判决","content":"华盛顿表示，澳门亲民主活动人士前议员区锦新被判重刑，凸显北京利用广泛的国安权力压制和平的政治异议并打压基本自由。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E5%8D%8E%E7%9B%9B%E9%A1%BF%E8%B0%B4%E8%B4%A3%E6%BE%B3%E9%97%A8%E5%AF%B9%E4%B8%80%E5%90%8D%E4%BA%B2%E6%B0%91%E4%B8%BB%E6%B4%BE%E5%89%8D%E8%AE%AE%E5%91%98%E7%9A%84%E5%88%A4%E5%86%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794335304000.webp","sourceId":"rfi"},{"id":1794333264000,"createdDate":"2026-11-10 17:54","name":"法国国际广播电台","title":"FT：黄乐Alice复杂的人际关系网","content":"一位了解Megaspeed高管情况的人士表示，今年早些时候，有消息称新加坡正就芯片走私指控对该公司展开调查，随后中国国家安全部（MSS）曾向其索要有关黄女士的信息。美方确信，她最终成为了中国国安部的线人。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-ft-%E9%BB%84%E4%B9%90alice%E5%A4%8D%E6%9D%82%E7%9A%84%E4%BA%BA%E9%99%85%E5%85%B3%E7%B3%BB%E7%BD%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794333264000.webp","sourceId":"rfi"},{"id":1794328508000,"createdDate":"2026-11-10 16:35","name":"法国国际广播电台","title":"马克龙和卢比奥就下任联合国秘书长遴选及黎巴嫩问题交换了意见","content":"美国国务卿卢比奥周一在巴黎七国集团外长会议期间与法国总统马克龙会晤后对记者表示，他与法国总统讨论了下一任联合国秘书长的遴选，并重申了华盛顿希望联合国进行“改革”的立场。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E9%A9%AC%E5%85%8B%E9%BE%99%E5%92%8C%E5%8D%A2%E6%AF%94%E5%A5%A5%E5%B0%B1%E4%B8%8B%E4%BB%BB%E8%81%94%E5%90%88%E5%9B%BD%E7%A7%98%E4%B9%A6%E9%95%BF%E9%81%B4%E9%80%89%E5%8F%8A%E9%BB%8E%E5%B7%B4%E5%AB%A9%E9%97%AE%E9%A2%98%E4%BA%A4%E6%8D%A2%E4%BA%86%E6%84%8F%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794328508000.webp","sourceId":"rfi"},{"id":1794350974000,"createdDate":"2026-11-10 22:49","name":"法国国际广播电台","title":"俄乌谈判 仲裁者偏袒？ 前景不乐观","content":"乌克兰与俄罗斯在美国特使调停下周二在阿布扎比展开谈判，欧洲代表则在会客室待命，按照美方的说法，希望本次谈判能在化解冲突方面取得进展，并建立一个新的包括欧洲的安全框架。但欧洲与乌克兰对此次会谈并不抱太大期望，因为“仲裁者”被指偏袒俄罗斯。普京既可倚仗特朗普的纵容，又可利用欧洲各国的分歧和软弱。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E4%BF%84%E4%B9%8C%E8%B0%88%E5%88%A4-%E4%BB%B2%E8%A3%81%E8%80%85%E5%81%8F%E8%A2%92-%E5%89%8D%E6%99%AF%E4%B8%8D%E4%B9%90%E8%A7%82","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794350974000.webp","sourceId":"rfi"},{"id":1794350611000,"createdDate":"2026-11-10 22:43","name":"法国国际广播电台","title":"以色列新一届议会周二宣誓就职，艾森科特承诺尽快组建国家紧急团结政府","content":"以色列新一届议会于11月10日宣誓就职，正式走马上任。加迪·艾森科特表示要“尽快”组建政府。但是，各政治派别的底线似乎难以调和，组建联合政府是个艰巨的任务。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E4%BB%A5%E8%89%B2%E5%88%97%E6%96%B0%E4%B8%80%E5%B1%8A%E8%AE%AE%E4%BC%9A%E5%91%A8%E4%BA%8C%E5%AE%A3%E8%AA%93%E5%B0%B1%E8%81%8C%EF%BC%8C%E8%89%BE%E6%A3%AE%E7%A7%91%E7%89%B9%E6%89%BF%E8%AF%BA%E5%B0%BD%E5%BF%AB%E7%BB%84%E5%BB%BA%E5%9B%BD%E5%AE%B6%E7%B4%A7%E6%80%A5%E5%9B%A2%E7%BB%93%E6%94%BF%E5%BA%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794350611000.webp","sourceId":"rfi"},{"id":1794348922000,"createdDate":"2026-11-10 22:15","name":"法国国际广播电台","title":"中国在气候峰会上 自身互为矛盾的国际地位和立场 越来越难以维持","content":"现今仍具“发展中国家”身份的中国，面对COP31全球气候峰会，由于中国目前既是世界上最大的污染国，又是销售绿色技术的最大供应国。气候专家继指出“中国在气候环保上所占据的这两种互为矛盾的国际地位和身份，正变得越来越站不住脚。尽管美国抵制了COP31气候峰会，但北京仍有机会影响气候谈判。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261110-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E6%B0%94%E5%80%99%E5%B3%B0%E4%BC%9A%E4%B8%8A-%E8%87%AA%E8%BA%AB%E4%BA%92%E4%B8%BA%E7%9F%9B%E7%9B%BE%E7%9A%84%E5%9B%BD%E9%99%85%E5%9C%B0%E4%BD%8D%E5%92%8C%E7%AB%8B%E5%9C%BA-%E8%B6%8A%E6%9D%A5%E8%B6%8A%E9%9A%BE%E4%BB%A5%E7%BB%B4%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794348922000.webp","sourceId":"rfi"}]