[{"id":1794293185000,"createdDate":"2026-11-10 06:46","name":"法国国际广播电台","title":"教徒为宏福苑大火死者办祈祷会亦受限 须模糊化处理 灾民感失望不满","content":"导致168人死亡的大埔宏福苑火灾快将迎来一周年，保安局长邓炳强表示，悼念活动须依法办事，当局亦会协助。言犹在耳，大埔天主教堂欲为宏福苑火灾灾民举办弥撒，在警方多次「查询」後，改为为过去一年的所有亡者祈祷。一个火灾家属群组对此大感失望和不满；曾任宗教刊物社长多年的评论员李锦洪亦表示，只有宗教力量可以重建心灵，港府现时只要一种声音和政策的做法，只会令民心不满情绪更浮面，是适得其反。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261110-%E6%95%99%E5%BE%92%E4%B8%BA%E5%AE%8F%E7%A6%8F%E8%8B%91%E5%A4%A7%E7%81%AB%E6%AD%BB%E8%80%85%E5%8A%9E%E7%A5%88%E7%A5%B7%E4%BC%9A%E4%BA%A6%E5%8F%97%E9%99%90-%E9%A1%BB%E6%A8%A1%E7%B3%8A%E5%8C%96%E5%A4%84%E7%90%86-%E7%81%BE%E6%B0%91%E6%84%9F%E5%A4%B1%E6%9C%9B%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794293185000.webp","sourceId":"rfi"},{"id":1794269603000,"createdDate":"2026-11-10 00:13","name":"法国国际广播电台","title":"黄仁勋婚外情：其影响可能远超个人婚外情","content":"一家估值达4.5万亿美元的美国人工智能巨头的掌门人，竟与一名可能是中国间谍的女子保持秘密恋情！这名叫黄乐的中国女子目前具体下落不明。美国媒体未能联系到她，也没有获得她的回应。她似乎已经销声匿迹。但是，不管怎样，这起事件的影响可能远超个人婚外情。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261110-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%A9%9A%E5%A4%96%E6%83%85-%E5%85%B3%E9%94%AE%E5%AE%83%E6%98%AF%E4%B8%8D%E6%98%AF%E4%B8%AA%E9%97%B4%E8%B0%8D%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794269603000.webp","sourceId":"rfi"},{"id":1794269442000,"createdDate":"2026-11-10 00:10","name":"法国国际广播电台","title":"塞浦路斯岛南北双方领导人同意再开放两个新的过境点","content":"联合国宣布，11月9日星期一，塞浦路斯岛南北双方领导人同意沿着分隔该岛的“绿线”再开放两个新的过境点。这是双方为重新启动统一谈判所作的持续努力之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261110-%E5%A1%9E%E6%B5%A6%E8%B7%AF%E6%96%AF%E5%B2%9B%E5%8D%97%E5%8C%97%E5%8F%8C%E6%96%B9%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%90%8C%E6%84%8F%E5%86%8D%E5%BC%80%E6%94%BE%E4%B8%A4%E4%B8%AA%E6%96%B0%E7%9A%84%E8%BF%87%E5%A2%83%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/10/1794269442000.webp","sourceId":"rfi"}]