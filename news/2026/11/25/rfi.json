[{"id":1795631710000,"createdDate":"2026-11-25 18:35","name":"法国国际广播电台","title":"北约华裔实习生涉间谍罪   比法院裁定电子监控候审","content":"比利时检方证实，一名在北大西洋公约组织军事总部实习的华裔加拿大籍女子因涉间谍罪遭捕，法院已裁定她在候审期间接受电子监控。比利时检察官办公室目前正考虑是否提出上诉。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261125-%E5%8C%97%E7%BA%A6%E5%8D%8E%E8%A3%94%E5%AE%9E%E4%B9%A0%E7%94%9F%E6%B6%89%E9%97%B4%E8%B0%8D%E7%BD%AA-%E6%AF%94%E6%B3%95%E9%99%A2%E8%A3%81%E5%AE%9A%E7%94%B5%E5%AD%90%E7%9B%91%E6%8E%A7%E5%80%99%E5%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795631710000.webp","sourceId":"rfi"},{"id":1795630160000,"createdDate":"2026-11-25 18:09","name":"法国国际广播电台","title":"英伟达支付2.9亿美元     和解股东2018年的诉讼案","content":"英伟达已同意支付2.9亿美元，以和解股东于2018年提起的诉讼。这些股东指控这家美国芯片巨头误导投资者，谎称加密货币对其业务的重要性。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261125-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%94%AF%E4%BB%982-9%E4%BA%BF%E7%BE%8E%E5%85%83-%E5%92%8C%E8%A7%A3%E8%82%A1%E4%B8%9C2018%E5%B9%B4%E7%9A%84%E8%AF%89%E8%AE%BC%E6%A1%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795630160000.webp","sourceId":"rfi"},{"id":1795630135000,"createdDate":"2026-11-25 18:08","name":"法国国际广播电台","title":"特朗普称黄仁勋不构成风险 美司法部并未对其展开过正式调查","content":"据路透社援引三位知情人士报导称，在美国总统特朗普近日推动黄仁勋重返英伟达担任首席执行官之前，美国司法部并未针对黄仁勋进行过正式调查——尽管美国司法部正积极调查英伟达的客户，且黄仁勋曾与一名被指是中国情报资产的女子有过婚外情。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261125-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E9%BB%84%E4%BB%81%E5%8B%8B%E4%B8%8D%E6%9E%84%E6%88%90%E9%A3%8E%E9%99%A9-%E7%BE%8E%E5%8F%B8%E6%B3%95%E9%83%A8%E5%B9%B6%E6%9C%AA%E5%AF%B9%E5%85%B6%E5%B1%95%E5%BC%80%E8%BF%87%E6%AD%A3%E5%BC%8F%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795630135000.webp","sourceId":"rfi"},{"id":1795627297000,"createdDate":"2026-11-25 17:21","name":"法国国际广播电台","title":"美搁置将商业作为激励手段促使俄停战想法 对乌安全保障仍不明朗","content":"特朗普政府已悄然搁置了将商业交易作为激励手段、促使俄罗斯结束乌克兰战争的提议，此前克里姆林宫对这些能源和航空领域的合作构想表现得兴趣寥寥。据五位知晓这一策略调整的官员向英国《金融时报》透露，美国总统特朗普的女婿库什纳（JaredKushner）及特使威特科夫（SteveWitkoff）已告知欧洲官员，企业间的合作已不再是美方对俄提出方案的核心内容；美方目前的工作重点已转向领土和安全议题。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261125-%E7%BE%8E%E6%90%81%E7%BD%AE%E5%B0%86%E5%95%86%E4%B8%9A%E4%BD%9C%E4%B8%BA%E6%BF%80%E5%8A%B1%E6%89%8B%E6%AE%B5%E4%BF%83%E4%BD%BF%E4%BF%84%E5%81%9C%E6%88%98%E6%83%B3%E6%B3%95-%E5%AE%89%E5%85%A8%E4%BF%9D%E9%9A%9C%E4%BB%8D%E4%B8%8D%E6%98%8E%E6%9C%97","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795627297000.webp","sourceId":"rfi"},{"id":1795621375000,"createdDate":"2026-11-25 15:42","name":"法国国际广播电台","title":"中美高科技竞争背景下，美司法裁定华为窃密等十项罪名成立","content":"中美领导人深圳热情拥抱的友好场面刚刚落幕，两国在高科技领域的激烈竞争就再起浪花。24日，纽约联邦法院经过长达两个月的审理，宣布对中国高科技巨头华为的十项刑事指控成立。华为集团反驳称相关指控证据不足，中国外交部发言人郭嘉堃25日在例行记者会上表示坚决反对美国打压遏制中国企业。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261125-%E4%B8%AD%E7%BE%8E%E9%AB%98%E7%A7%91%E6%8A%80%E7%AB%9E%E4%BA%89%E8%83%8C%E6%99%AF%E4%B8%8B%EF%BC%8C%E7%BE%8E%E5%8F%B8%E6%B3%95%E8%A3%81%E5%AE%9A%E5%8D%8E%E4%B8%BA%E7%AA%83%E5%AF%86%E7%AD%89%E5%8D%81%E9%A1%B9%E7%BD%AA%E5%90%8D%E6%88%90%E7%AB%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795621375000.webp","sourceId":"rfi"},{"id":1795620535000,"createdDate":"2026-11-25 15:28","name":"法国国际广播电台","title":"遏制砷污染河流 泰国促中国协助关闭缅甸矿场至少六个月","content":"泰国正请求中国协助关闭缅甸东北部的矿场，至少关闭六个月，此举正值泰方试图阻止砷污染河水越境流入该国社区和农民所依赖的河流。据泰国官员透露，这一请求是在周二泰国、中国与缅甸三方会谈期间提出的。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261125-%E9%81%8F%E5%88%B6%E7%A0%B7%E6%B1%A1%E6%9F%93%E6%B2%B3%E6%B5%81-%E6%B3%B0%E5%9B%BD%E4%BF%83%E4%B8%AD%E5%9B%BD%E5%8D%8F%E5%8A%A9%E5%85%B3%E9%97%AD%E7%BC%85%E7%94%B8%E7%9F%BF%E5%9C%BA%E8%87%B3%E5%B0%91%E5%85%AD%E4%B8%AA%E6%9C%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795620535000.webp","sourceId":"rfi"},{"id":1795616707000,"createdDate":"2026-11-25 14:25","name":"法国国际广播电台","title":"特朗普政府提对14个贸易伙伴加征新关税：对中国税率为20%","content":"美国特朗普政府已提议对包括中国、欧盟、日本和印度在内的14个贸易伙伴加征新关税。尽管此前实施的相当一部分关税已被美国最高法院驳回，但特朗普总统仍执意加大关税力度。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261125-%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E6%8F%90%E5%AF%B914%E4%B8%AA%E8%B4%B8%E6%98%93%E4%BC%99%E4%BC%B4%E5%8A%A0%E5%BE%81%E6%96%B0%E5%85%B3%E7%A8%8E-%E5%AF%B9%E5%8D%8E%E7%A8%8E%E7%8E%87%E4%B8%BA20","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795616707000.webp","sourceId":"rfi"},{"id":1795610630000,"createdDate":"2026-11-25 12:43","name":"法国国际广播电台","title":"美国会情报委员会要求看鲁比奥备忘录副本 特朗普指愿赦免黄仁勋","content":"据《纽约时报》援引获悉相关简报情况的人士报导，在特朗普总统公开宣称“美国政府没有理由认为黄仁勋重返英伟达会构成任何国家安全风险”，其也未面临刑事起诉的一天后，美国官员于周二在向国会所作的简报中，对英伟达相关风波核心所涉的情报给出了更为审慎的表述。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261125-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E6%83%85%E6%8A%A5%E5%A7%94%E5%91%98%E4%BC%9A%E8%A6%81%E6%B1%82%E7%9C%8B%E9%B2%81%E6%AF%94%E5%A5%A5%E5%A4%87%E5%BF%98%E5%BD%95%E5%89%AF%E6%9C%AC-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8C%87%E6%84%BF%E8%B5%A6%E5%85%8D%E9%BB%84%E4%BB%81%E5%8B%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795610630000.webp","sourceId":"rfi"},{"id":1795609630000,"createdDate":"2026-11-25 12:27","name":"法国国际广播电台","title":"官方数据: 2025年法国百余名女性被生活伴侣杀害","content":"11月25日是联合国发起的消除针对女性的暴力的国际行动日。法国一个女权活动团体当日在凯旋门下的无名烈士墓前展开横幅，上书：向被父权体制杀害的无名斗士致敬。根据法国政府公布的数据，2025年，法国有111名女性被他们的生活伴侣杀害。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261125-%E5%AE%98%E6%96%B9%E6%95%B0%E6%8D%AE-2025%E5%B9%B4%E6%B3%95%E5%9B%BD%E7%99%BE%E4%BD%99%E5%90%8D%E5%A5%B3%E6%80%A7%E8%A2%AB%E7%94%9F%E6%B4%BB%E4%BC%B4%E4%BE%A3%E6%9D%80%E5%AE%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795609630000.webp","sourceId":"rfi"},{"id":1795608051000,"createdDate":"2026-11-25 12:00","name":"法国国际广播电台","title":"从经济暴力到强制控制：揭开家庭暴力的隐形链条","content":"11月25日星期三为制止暴力侵害妇女行为国际日，法国各大报纸纷纷刊登相关文章，从家庭暴力的隐蔽形式到法律制度的演进，聚焦那些长期被忽视、却深刻影响受害者生活的暴力机制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261125-%E4%BB%8E%E7%BB%8F%E6%B5%8E%E6%9A%B4%E5%8A%9B%E5%88%B0%E5%BC%BA%E5%88%B6%E6%8E%A7%E5%88%B6-%E6%8F%AD%E5%BC%80%E5%AE%B6%E5%BA%AD%E6%9A%B4%E5%8A%9B%E7%9A%84%E9%9A%90%E5%BD%A2%E9%93%BE%E6%9D%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795608051000.webp","sourceId":"rfi"},{"id":1795608046000,"createdDate":"2026-11-25 12:00","name":"法国国际广播电台","title":"台湾九合一大选｜台北市长候选人沈伯洋掀起的「洋流」效应是否有助绿营翻转既有版图？","content":"2026年台湾九合一地方选举将于11月28日举行，目前选战已进入最后一周冲刺阶段。本次选举被视为总统赖清德执政首场全国地方期中考，投票结果不仅会决定未来四年的地方治理，也可能牵动2028年总统选举布局，甚至影响两岸关系。2022年的九合一选举中，国民党在全台22席拿下14席，民进党则仅取得5席。因此今年只要能多攻下席次即视为有所斩获。台北市长候选人沈伯洋的「洋流」声势虽然不小，但究竟能否帮助绿营翻转版图？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%81%9A%E7%84%A6%E5%8F%B0%E6%B5%B7/20261125-%E5%8F%B0%E6%B9%BE%E4%B9%9D%E5%90%88%E4%B8%80%E5%A4%A7%E9%80%89%EF%BD%9C%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E5%80%99%E9%80%89%E4%BA%BA%E6%B2%88%E4%BC%AF%E6%B4%8B%E6%8E%80%E8%B5%B7%E7%9A%84-%E6%B4%8B%E6%B5%81-%E6%95%88%E5%BA%94%E6%98%AF%E5%90%A6%E6%9C%89%E5%8A%A9%E7%BB%BF%E8%90%A5%E7%BF%BB%E8%BD%AC%E6%97%A2%E6%9C%89%E7%89%88%E5%9B%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795608046000.webp","sourceId":"rfi"},{"id":1795603300000,"createdDate":"2026-11-25 10:41","name":"法国国际广播电台","title":"不能说的故事？ 记宏福苑火灾一周年 学者形容港府在做「香港六四」","content":"今天是导致168人死亡的大埔宏福苑火灾一周年纪念前夕，港府高官继续大谈火灾善後和改革工作，京官亦发文予以肯定，并期望香港凝聚力量前行；但在大量官意背後，却是传媒有关宏福苑的纪念特辑和报道「被下架」丶民间自发活动「被取消」丶居民到火灾现场悼念被警方「关注」丶传媒采访灾民全程「被保护」丶不少驻港外媒收官方提醒要公平报道。有评论认为，宏福苑快成为「香港六四事件」；而官方将之定性为有人「以灾乱港」，亦不利社会的情绪发泄和社会复原。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261125-%E4%B8%8D%E8%83%BD%E8%AF%B4%E7%9A%84%E6%95%85%E4%BA%8B-%E8%AE%B0%E5%AE%8F%E7%A6%8F%E8%8B%91%E7%81%AB%E7%81%BE%E4%B8%80%E5%91%A8%E5%B9%B4-%E5%AD%A6%E8%80%85%E5%BD%A2%E5%AE%B9%E6%B8%AF%E5%BA%9C%E5%9C%A8%E5%81%9A-%E9%A6%99%E6%B8%AF%E5%85%AD%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795603300000.webp","sourceId":"rfi"},{"id":1795603094000,"createdDate":"2026-11-25 10:38","name":"法国国际广播电台","title":"欧委会提出《量子法案》和500亿欧元主权科技股权基金 以提升竞争力","content":"欧盟委员会周三提议设立一项规模为500亿欧元的股权融资基金，并提出其他多项举措，旨在政府采购招标中倾向于欧洲企业，并力争在2030年前使欧洲成为全球量子技术领域的领导者。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261125-%E6%AC%A7%E5%A7%94%E4%BC%9A%E6%8F%90%E5%87%BA-%E9%87%8F%E5%AD%90%E6%B3%95%E6%A1%88-%E5%92%8C500%E4%BA%BF%E6%AC%A7%E5%85%83%E4%B8%BB%E6%9D%83%E7%A7%91%E6%8A%80%E8%82%A1%E6%9D%83%E5%9F%BA%E9%87%91-%E4%BB%A5%E6%8F%90%E5%8D%87%E7%AB%9E%E4%BA%89%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795603094000.webp","sourceId":"rfi"},{"id":1795602525000,"createdDate":"2026-11-25 10:28","name":"法国国际广播电台","title":"中国柬埔寨进行大规模联合军演","content":"中柬两国今天周三启动了联合军演，此次演习规模空前，有近3000名官兵在三个不同地点同时进行演练。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261125-%E4%B8%AD%E5%9B%BD%E6%9F%AC%E5%9F%94%E5%AF%A8%E8%BF%9B%E8%A1%8C%E5%A4%A7%E8%A7%84%E6%A8%A1%E8%81%94%E5%90%88%E5%86%9B%E6%BC%94","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795602525000.webp","sourceId":"rfi"},{"id":1795601689000,"createdDate":"2026-11-25 10:14","name":"法国国际广播电台","title":"记录显示黄乐关联企业以价值2.7亿美元AI设备在华融资","content":"据路透社审阅此前未曾报道的文件显示，与女商人黄乐关联的公司，曾以功能强大的运算设备作为融资担保，为中国大型人工智能（AI）数据中心取得资金。这些来自中国央行的文件列出了多达764台人工智能服务器及模块，总价值达2.7亿美元；此外还有价值3100万美元的设备，用于将这些服务器连接成大型计算网络。其中大部分硬件被登记存放在上海的一处大型数据中心内；该数据中心最初是由相关方与中国科技巨头腾讯合作开发的。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261125-%E8%AE%B0%E5%BD%95%E6%98%BE%E7%A4%BA%E9%BB%84%E4%B9%90%E5%85%B3%E8%81%94%E4%BC%81%E4%B8%9A%E4%BB%A5%E4%BB%B7%E5%80%BC2-7%E4%BA%BF%E7%BE%8E%E5%85%83ai%E8%AE%BE%E5%A4%87%E5%9C%A8%E5%8D%8E%E8%9E%8D%E8%B5%84","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795601689000.webp","sourceId":"rfi"},{"id":1795597773000,"createdDate":"2026-11-25 09:09","name":"法国国际广播电台","title":"日本议员就高市访华舷梯再批中国 华人议员称中国为“中华地痞共和国”","content":"自民党前总务会长有村治子24日在自己的社交媒体上发文称，关于高市首相为出席APEC会议抵达中国深圳机场时，政府专机与舷梯之间出现较大高度差一事，“中方事先没有进行任何通知，也没有提供任何相关信息”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261125-%E6%97%A5%E6%9C%AC%E8%AE%AE%E5%91%98%E5%B0%B1%E9%AB%98%E5%B8%82%E8%AE%BF%E5%8D%8E%E8%88%B7%E6%A2%AF%E5%86%8D%E6%89%B9%E4%B8%AD%E5%9B%BD-%E5%8D%8E%E4%BA%BA%E8%AE%AE%E5%91%98%E7%A7%B0%E4%B8%AD%E5%9B%BD%E4%B8%BA-%E4%B8%AD%E5%8D%8E%E5%9C%B0%E7%97%9E%E5%85%B1%E5%92%8C%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/25/1795597773000.webp","sourceId":"rfi"}]