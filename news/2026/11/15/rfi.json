[{"id":1794753743000,"createdDate":"2026-11-15 14:42","name":"法国国际广播电台","title":"美国会四项法案有望通过 以收紧AI芯片出口及远程访问监管","content":"在媒体披露，英伟达前首席执行官黄仁勋曾与一名被指是中国情报资产的女子有过婚外情之后，美国国会的议员们正加紧采取行动，旨在阻止先进人工智能（AI）芯片流入中国。民主党和共和党要员均已表态支持一系列法案，这些法案旨在限制敏感芯片的海外销售，并赋予国会审查甚至否决此前已获特朗普政府批准的芯片销售交易的权力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261115-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E5%9B%9B%E9%A1%B9%E6%B3%95%E6%A1%88%E6%9C%89%E6%9C%9B%E9%80%9A%E8%BF%87-%E4%BB%A5%E6%94%B6%E7%B4%A7ai%E8%8A%AF%E7%89%87%E5%87%BA%E5%8F%A3%E5%8F%8A%E8%BF%9C%E7%A8%8B%E8%AE%BF%E9%97%AE%E7%9B%91%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794753743000.webp","sourceId":"rfi"},{"id":1794749166000,"createdDate":"2026-11-15 13:26","name":"法国国际广播电台","title":"Megaspeed据报曾安排将价值近120亿美元英伟达芯片运往中国企业","content":"新加坡云计算公司Megaspeed周日向消费者新闻与商业频道（CNBC）表示，黄乐已于2025年8月从公司离职，并称Megaspeed已针对有关其业务及供应链的媒体报道启动了内部调查。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-megaspeed%E6%8D%AE%E6%8A%A5%E6%9B%BE%E5%AE%89%E6%8E%92%E5%B0%86%E4%BB%B7%E5%80%BC%E8%BF%91120%E4%BA%BF%E7%BE%8E%E5%85%83%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%8A%AF%E7%89%87%E8%BF%90%E5%BE%80%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794749166000.webp","sourceId":"rfi"},{"id":1794744698000,"createdDate":"2026-11-15 12:11","name":"法国国际广播电台","title":"第49届东盟峰会周日开幕，南海与缅甸成核心议题","content":"周日（11月15日），东南亚各国领导人齐聚马尼拉，开启东盟的年度峰会。为期三天的会议将围绕一系列议题展开，美国总统特朗普也将出席相关会议，这也是他在中期选举失利后首次出访。据本台昨天的报道，特朗普将于周二晚些时候参加三场重要会议，其中包括由美国、日本、澳大利亚和印度组成的“四方安全对话”（QUAD）会议，该机制主要是为了制衡中国影响力。此外，根据菲律宾官员的说法，特朗普还将与东盟领导人举行一场特别峰会。中国方面，多方消息显示，会派出国务院总理李强代表出席峰会。不过，李强将于周一与东盟领导人举行会晤，并会在特朗普周二抵达之前就离开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261115-%E7%AC%AC49%E5%B1%8A%E4%B8%9C%E7%9B%9F%E5%B3%B0%E4%BC%9A%E5%91%A8%E6%97%A5%E5%BC%80%E5%B9%95%EF%BC%8C%E5%8D%97%E6%B5%B7%E4%B8%8E%E7%BC%85%E7%94%B8%E6%88%90%E6%A0%B8%E5%BF%83%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794744698000.webp","sourceId":"rfi"},{"id":1794744452000,"createdDate":"2026-11-15 12:07","name":"法国国际广播电台","title":"也门政府军从曼德海峡附近区域撤出 胡塞武装获取控制权","content":"周日，效忠于沙特支持的、获国际社会承认的也门政府的武装力量表示，他们正从一处俯瞰战略要地曼德海峡的区域撤出，该区域预计将由亲伊朗的胡塞武装控制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261115-%E4%B9%9F%E9%97%A8%E6%94%BF%E5%BA%9C%E5%86%9B%E4%BB%8E%E6%9B%BC%E5%BE%B7%E6%B5%B7%E5%B3%A1%E9%99%84%E8%BF%91%E5%8C%BA%E5%9F%9F%E6%92%A4%E5%87%BA-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%8E%B7%E5%8F%96%E6%8E%A7%E5%88%B6%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794744452000.webp","sourceId":"rfi"},{"id":1794743000000,"createdDate":"2026-11-15 11:43","name":"法国国际广播电台","title":"菲外长称《南海行为准则》完成达80%剩下留给新加坡 指东盟十国与中国对局势看法不同","content":"菲律宾外交部长拉扎罗（TheresaLazaro）周日表示，在菲方担任东盟轮值主席国期间，具有约束力的《南海行为准则》将不会最终敲定。拉扎罗指出，该文件已取得实质性进展，目前已完成了80%。她强调：“各国领导人依然致力于维护南中国海的和平、安全与稳定”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261115-%E8%8F%B2%E5%A4%96%E9%95%BF%E7%A7%B0-%E5%8D%97%E6%B5%B7%E8%A1%8C%E4%B8%BA%E5%87%86%E5%88%99-%E5%AE%8C%E6%88%90%E8%BE%BE80-%E5%89%A9%E4%B8%8B%E7%95%99%E7%BB%99%E6%96%B0%E5%8A%A0%E5%9D%A1-%E6%8C%87%E4%B8%9C%E7%9B%9F%E5%8D%81%E5%9B%BD%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%AF%B9%E5%B1%80%E5%8A%BF%E7%9C%8B%E6%B3%95%E4%B8%8D%E5%90%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794743000000.webp","sourceId":"rfi"},{"id":1794740088000,"createdDate":"2026-11-15 10:54","name":"法国国际广播电台","title":"低碳排的太平洋岛国，承受最前沿气候灾难：聚焦COP31与区域治理权","content":"当地时间11月9日，第31届联合国气候变化大会在土耳其安塔利亚拉开帷幕。本届会议为期两周，由土耳其主办，澳大利亚担任谈判主席国。随着全球气温持续上升，极端天气和气候相关灾害不断增加，会议开幕之际，本次大会组织方再次呼吁国际社会加快气候行动，将应对全球变暖置于各国政策议程的重要位置。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20261115-%E4%BD%8E%E7%A2%B3%E6%8E%92%E7%9A%84%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%EF%BC%8C%E6%89%BF%E5%8F%97%E6%9C%80%E5%89%8D%E6%B2%BF%E6%B0%94%E5%80%99%E7%81%BE%E9%9A%BE-%E8%81%9A%E7%84%A6cop31%E4%B8%8E%E5%8C%BA%E5%9F%9F%E6%B2%BB%E7%90%86%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794740088000.webp","sourceId":"rfi"},{"id":1794739195000,"createdDate":"2026-11-15 10:39","name":"法国国际广播电台","title":"巴林称拦截摧毁多次伊朗空中袭击 9月以来首次执行此类拦截任务","content":"巴林周日表示，该国拦截并摧毁了来自伊朗的数次空中袭击；与此同时，在有关结束伊朗战争的协议前景尚不明朗之际，德黑兰方面声称已打击了位于巴林境内的一处美军基地。这是自9月以来，巴林防空系统首次执行此类拦截任务。在此之前，巴林当局曾两次发出潜在威胁预警，敦促居民寻求掩护。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261115-%E5%B7%B4%E6%9E%97%E6%8C%87%E6%8B%A6%E6%88%AA%E6%91%A7%E6%AF%81%E5%A4%9A%E6%AC%A1%E4%BC%8A%E6%9C%97%E7%A9%BA%E4%B8%AD%E8%A2%AD%E5%87%BB-9%E6%9C%88%E4%BB%A5%E6%9D%A5%E9%A6%96%E6%AC%A1%E6%89%A7%E8%A1%8C%E6%AD%A4%E7%B1%BB%E6%8B%A6%E6%88%AA%E4%BB%BB%E5%8A%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794739195000.webp","sourceId":"rfi"},{"id":1794738929000,"createdDate":"2026-11-15 10:35","name":"法国国际广播电台","title":"当中国的“国家精密资本主义”开始收割世界","content":"各位好，欢迎收听本期的法国报纸摘要。由于本台订阅的法国主流日刊周日大多不出刊，我们照例为您选取法国世界报当中与中国相关的话题做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261115-%E5%BD%93%E4%B8%AD%E5%9B%BD%E7%9A%84-%E5%9B%BD%E5%AE%B6%E7%B2%BE%E5%AF%86%E8%B5%84%E6%9C%AC%E4%B8%BB%E4%B9%89-%E5%BC%80%E5%A7%8B%E6%94%B6%E5%89%B2%E4%B8%96%E7%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794738929000.webp","sourceId":"rfi"},{"id":1794738188000,"createdDate":"2026-11-15 10:23","name":"法国国际广播电台","title":"高市首相将在菲律宾倡议创立“亚洲版国际能源署”","content":"高市首相已决定，将在17日于菲律宾马尼拉举行的亚洲零排放共同体（AZEC）首脑会议上，倡议创设“亚洲版国际能源署”，作为在危机时期加强石油相互采购合作的机制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%B0%86%E5%9C%A8%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%80%A1%E8%AE%AE%E5%88%9B%E7%AB%8B-%E4%BA%9A%E6%B4%B2%E7%89%88%E5%9B%BD%E9%99%85%E8%83%BD%E6%BA%90%E7%BD%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794738188000.webp","sourceId":"rfi"},{"id":1794737347000,"createdDate":"2026-11-15 10:09","name":"法国国际广播电台","title":"新美高官会谈同意就共同关心问题，包括Megaspeed案保持沟通","content":"新加坡与美国两国官员在华盛顿举行的高层会议上讨论了Megaspeed公司案相关事宜，双方​​均承诺将继续就此事保持沟通。此次交流发生在新加坡数码发展及新闻部长杨莉明11月12日至13日访问华盛顿期间。访问期间，杨莉明会见了多位特朗普政府要员，包括白宫科技政策办公室主任克拉西奥斯（MichaelKratsios）以及美国常务副国务卿兰道（ChristopherLandau）。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261115-%E6%96%B0%E7%BE%8E%E9%AB%98%E5%AE%98%E4%BC%9A%E8%B0%88%E5%90%8C%E6%84%8F%E5%B0%B1%E5%85%B1%E5%90%8C%E5%85%B3%E5%BF%83%E9%97%AE%E9%A2%98%EF%BC%8C%E5%8C%85%E6%8B%ACmegaspeed%E6%A1%88%E4%BF%9D%E6%8C%81%E6%B2%9F%E9%80%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794737347000.webp","sourceId":"rfi"},{"id":1794734376000,"createdDate":"2026-11-15 09:19","name":"法国国际广播电台","title":"从禁飞、禁售到禁持：自周日起，北京全面禁止居民持有无人机","content":"法新社消息称，自本周日（11月15日）起，北京正式实施无人机全面禁持令，也就是在这个超两千万人口的整个行政辖区内，任何人不得持有无人机。此前，北京已经禁止无人机飞行和销售。近年来，无人机在中国迅速普及，尤其受到旅游和户外活动爱好者的欢迎。许多人喜欢在郊游或旅行时使用无人机拍摄风景。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261115-%E4%BB%8E%E7%A6%81%E9%A3%9E-%E7%A6%81%E5%94%AE%E5%88%B0%E7%A6%81%E6%8C%81-%E8%87%AA%E5%91%A8%E6%97%A5%E8%B5%B7%EF%BC%8C%E5%8C%97%E4%BA%AC%E5%85%A8%E9%9D%A2%E7%A6%81%E6%AD%A2%E5%B1%85%E6%B0%91%E6%8C%81%E6%9C%89%E6%97%A0%E4%BA%BA%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794734376000.webp","sourceId":"rfi"},{"id":1794731108000,"createdDate":"2026-11-15 08:25","name":"法国国际广播电台","title":"俄罗斯获准回归国际冰球大赛，加拿大拒不执行，俄威胁索赔","content":"综合路透社等报道，国际冰球联合会就恢复俄罗斯参赛国际比赛资格的决定，向国际体育仲裁庭提出了异议。多国也表示，若俄罗斯冰球队回归，其将拒绝与之进行比赛，甚至拒绝俄罗斯代表队入境参赛。就此，俄方威胁索赔。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-%E4%BF%84%E7%BD%97%E6%96%AF%E8%8E%B7%E5%87%86%E5%9B%9E%E5%BD%92%E5%9B%BD%E9%99%85%E5%86%B0%E7%90%83%E5%A4%A7%E8%B5%9B%EF%BC%8C%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%8B%92%E4%B8%8D%E6%89%A7%E8%A1%8C%EF%BC%8C%E4%BF%84%E5%A8%81%E8%83%81%E7%B4%A2%E8%B5%94","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794731108000.webp","sourceId":"rfi"},{"id":1794775997000,"createdDate":"2026-11-15 20:53","name":"法国国际广播电台","title":"卢拉：古巴并“没有祈求美国发慈悲”","content":"一场关键峰会周日在马尼拉拉开帷幕。东南亚各国领导人正着手应对中东危机及本地区的热点议题，而各国领导人也就美国总统特朗普发起的“贸易战”寻求共识。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261115-%E5%8D%A2%E6%8B%89-%E5%8F%A4%E5%B7%B4%E5%B9%B6-%E6%B2%A1%E6%9C%89%E7%A5%88%E6%B1%82%E7%BE%8E%E5%9B%BD%E5%8F%91%E6%85%88%E6%82%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794775997000.webp","sourceId":"rfi"},{"id":1794775749000,"createdDate":"2026-11-15 20:49","name":"法国国际广播电台","title":"法汉学家：中国会利用APEC峰会削弱美主导地位","content":"法国汉学家埃克曼（AliceEkman）女士表示：“尽管面临重重困难，中国仍希望加速全球治理格局的重塑，由此让西方国家边缘化。”这位中国问题专家在接受《世界报》采访时表示，北京计划利用11月18日至19日举行的亚太经合组织（APEC）峰会，展示其实力，以构建“在其领导下的全球新型秩序”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-%E6%B3%95%E6%B1%89%E5%AD%A6%E5%AE%B6-%E4%B8%AD%E5%9B%BD%E4%BC%9A%E5%88%A9%E7%94%A8apec%E5%B3%B0%E4%BC%9A%E5%89%8A%E5%BC%B1%E7%BE%8E%E4%B8%BB%E5%AF%BC%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794775749000.webp","sourceId":"rfi"},{"id":1794775479000,"createdDate":"2026-11-15 20:44","name":"法国国际广播电台","title":"爱沙尼亚自12月1日起将关闭所有和俄之间的边境口岸","content":"爱沙尼亚外交部长周日宣布，自12月1日起，爱沙尼亚将关闭所有与俄罗斯的边境口岸。此前，一家国防公司遭到纵火未遂，爱沙尼亚指责莫斯科是幕后黑手。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261115-%E7%88%B1%E6%B2%99%E5%B0%BC%E4%BA%9A%E8%87%AA12%E6%9C%881%E6%97%A5%E8%B5%B7%E5%B0%86%E5%85%B3%E9%97%AD%E6%89%80%E6%9C%89%E5%92%8C%E4%BF%84%E4%B9%8B%E9%97%B4%E7%9A%84%E8%BE%B9%E5%A2%83%E5%8F%A3%E5%B2%B8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794775479000.webp","sourceId":"rfi"},{"id":1794775409000,"createdDate":"2026-11-15 20:43","name":"法国国际广播电台","title":"黄仁勋与盟友讨论重返英伟达CEO职位","content":"黄仁勋正在考虑重返英伟达首席执行官职位，因为硅谷的盟友正在向公司董事会施压，要求在这位科技高管因涉嫌与一名中国间谍和下属有婚外情而辞职几天后复职。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261115-%E9%BB%84%E4%BB%81%E5%8B%8B%E4%B8%8E%E7%9B%9F%E5%8F%8B%E8%AE%A8%E8%AE%BA%E9%87%8D%E8%BF%94%E8%8B%B1%E4%BC%9F%E8%BE%BEceo%E8%81%8C%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794775409000.webp","sourceId":"rfi"},{"id":1794775290000,"createdDate":"2026-11-15 20:41","name":"法国国际广播电台","title":"俄罗斯一处大型工业设施遭基辅空袭","content":"基辅方面周日宣称对袭击俄罗斯中部城市下卡姆斯克（Nijnekamsk）一家大型石化厂和一家炼油厂的事件负责。俄罗斯和亲俄当局也报告称，俄罗斯境内及被占领土共有三人死亡。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261115-%E4%BF%84%E7%BD%97%E6%96%AF%E4%B8%80%E5%A4%84%E5%A4%A7%E5%9E%8B%E5%B7%A5%E4%B8%9A%E8%AE%BE%E6%96%BD%E9%81%AD%E5%9F%BA%E8%BE%85%E7%A9%BA%E8%A2%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794775290000.webp","sourceId":"rfi"},{"id":1794774974000,"createdDate":"2026-11-15 20:36","name":"法国国际广播电台","title":"教宗良十四世在秘鲁主持三钟经祈祷活动","content":"教宗良十四世于周日抵达秘鲁安第斯山脉的库斯科，在数千名身着传统服饰的信徒的迎接下，开启了他南美之行的重要一站。一个月前，他刚刚接受了肺癌手术。“欢迎您良神父！”（克丘亚语）——在一栋聚集着一些信徒的建筑上，横幅这样写道。教宗走下飞机时，面带笑容，向他们致意。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261115-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E5%9C%A8%E7%A7%98%E9%B2%81%E4%B8%BB%E6%8C%81%E4%B8%89%E9%92%9F%E7%BB%8F%E7%A5%88%E7%A5%B7%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794774974000.webp","sourceId":"rfi"},{"id":1794774675000,"createdDate":"2026-11-15 20:31","name":"法国国际广播电台","title":"佛得角首轮总统选举投票落幕","content":"佛得角群岛的投票站于周日晚间关闭，总统选举第一轮计票工作随即展开。此次选举共有419,448名登记选民。现任总统若泽·玛丽亚·内维斯（JoséMaríaNeves）寻求连任，被认为是该西非葡语区群岛的热门人选。佛得角以其民主稳定而闻名。如果无候选人获得过半数选票，得票数居前两位的候选人将进入11月29日的第二轮角逐。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261115-%E4%BD%9B%E5%BE%97%E8%A7%92%E9%A6%96%E8%BD%AE%E6%80%BB%E7%BB%9F%E9%80%89%E4%B8%BE%E6%8A%95%E7%A5%A8%E8%90%BD%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794774675000.webp","sourceId":"rfi"},{"id":1794774389000,"createdDate":"2026-11-15 20:26","name":"法国国际广播电台","title":"胡塞武装距也门政府所在地亚丁仅60公里","content":"据法新社周日援引军方和政府消息人士的话报道，也门亲伊朗的胡塞武装距离政府所在地亚丁仅60公里，他们正向亚丁方向推进，政府军也正在向该国南部重新部署兵力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261115-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%B7%9D%E4%B9%9F%E9%97%A8%E6%94%BF%E5%BA%9C%E6%89%80%E5%9C%A8%E5%9C%B0%E4%BA%9A%E4%B8%81%E4%BB%8560%E5%85%AC%E9%87%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794774389000.webp","sourceId":"rfi"},{"id":1794772915000,"createdDate":"2026-11-15 20:01","name":"法国国际广播电台","title":"崛起的中国也对德国医疗技术业构成威胁","content":"据德国商务知情者网页businessinsider.de报道：中国竞争对手正在迅速崛起，并对德国医疗技术行业构成威胁。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261115-%E5%B4%9B%E8%B5%B7%E7%9A%84%E4%B8%AD%E5%9B%BD%E4%B9%9F%E5%AF%B9%E5%BE%B7%E5%9B%BD%E5%8C%BB%E7%96%97%E6%8A%80%E6%9C%AF%E4%B8%9A%E6%9E%84%E6%88%90%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794772915000.webp","sourceId":"rfi"},{"id":1794772600000,"createdDate":"2026-11-15 19:56","name":"法国国际广播电台","title":"COP31 : 主会场成果甚微 人民峰会气氛热烈","content":"正在土耳其安塔利亚举行的第31届气候峰会刚刚结束第一周的谈判，上周的谈判是否取得进展？下周的谈判又将如何展开？在市中心的举行的人民峰会又有何特色？","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261115-cop31-%E4%B8%BB%E4%BC%9A%E5%9C%BA%E6%88%90%E6%9E%9C%E7%94%9A%E5%BE%AE-%E4%BA%BA%E6%B0%91%E5%B3%B0%E4%BC%9A%E6%B0%94%E6%B0%9B%E7%83%AD%E7%83%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794772600000.webp","sourceId":"rfi"},{"id":1794772218000,"createdDate":"2026-11-15 19:50","name":"法国国际广播电台","title":"美国及盟友同意签署协议以保护 AI 供应链免受中国影响","content":"美国及包括日本、澳大利亚、以色列和英国在内的盟友已同意制定一份联合清单，列出支撑AI的关键技术和供应链，这些技术和供应链需要更多保护，以帮助应对中国。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261115-%E7%BE%8E%E5%9B%BD%E5%8F%8A%E7%9B%9F%E5%8F%8B%E7%AD%BE%E7%BD%B2%E5%8D%8F%E8%AE%AE%E4%BB%A5%E4%BF%9D%E6%8A%A4-ai-%E4%BE%9B%E5%BA%94%E9%93%BE%E5%85%8D%E5%8F%97%E4%B8%AD%E5%9B%BD%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794772218000.webp","sourceId":"rfi"},{"id":1794769170000,"createdDate":"2026-11-15 18:59","name":"法国国际广播电台","title":"美财长贝森特强调须从英伟达外部寻找新执行长","content":"美国财政部长贝森特15日表示，英伟达（NVIDIA）执行长黄仁勋11月12日突然辞职后，该公司必须“从公司外部”寻找新的接任人选。这显示贝森特对英伟达现有高层和董事会缺乏信任，而要一查到底的态度。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261115-%E7%BE%8E%E8%B4%A2%E9%95%BF%E8%B4%9D%E6%A3%AE%E7%89%B9%E4%B8%BA%E4%BD%95%E5%BC%BA%E8%B0%83%E9%A1%BB%E4%BB%8E%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%A4%96%E9%83%A8%E5%AF%BB%E6%89%BE%E6%96%B0%E6%89%A7%E8%A1%8C%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794769170000.webp","sourceId":"rfi"},{"id":1794762683000,"createdDate":"2026-11-15 17:11","name":"法国国际广播电台","title":"贝森特称英伟达需戏剧性改组：是否为推高营收和利润推动非法销售","content":"美国财政部长贝森特（ScottBessent）周日在受访时表示，在黄仁勋宣布辞职后，英伟达在寻找新任首席执行官时，应当从公司外部进行物色。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261115-%E8%B4%9D%E6%A3%AE%E7%89%B9%E7%A7%B0%E8%8B%B1%E4%BC%9F%E8%BE%BE%E9%9C%80%E6%88%8F%E5%89%A7%E6%80%A7%E6%94%B9%E7%BB%84-%E6%98%AF%E5%90%A6%E4%B8%BA%E6%8E%A8%E9%AB%98%E8%90%A5%E6%94%B6%E5%92%8C%E5%88%A9%E6%B6%A6%E5%BC%BA%E8%A1%8C%E6%8E%A8%E5%8A%A8%E8%BF%9D%E6%B3%95%E9%94%80%E5%94%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794762683000.webp","sourceId":"rfi"},{"id":1794759420000,"createdDate":"2026-11-15 16:17","name":"法国国际广播电台","title":"其子运营公司深度参与东南亚数据中心项目 美商务部长卢特尼克备受质疑","content":"在英伟达事件持续发酵之际，美国商务部长卢特尼克（Howard Lutnick）已成为特朗普政府应对中国间谍活动和潜在国家安全威胁失责的焦点高官。目前对卢特尼克最严厉的审视来自国会共和党人、内阁同僚以及特朗普总统的“让美国再次伟大”（MAGA）阵营的基本盘。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261115-%E5%85%B6%E5%AD%90%E8%BF%90%E8%90%A5%E5%85%AC%E5%8F%B8%E6%B7%B1%E5%BA%A6%E5%8F%82%E4%B8%8E%E4%B8%9C%E5%8D%97%E4%BA%9A%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E9%A1%B9%E7%9B%AE-%E7%BE%8E%E5%95%86%E5%8A%A1%E9%83%A8%E9%95%BF%E5%8D%A2%E7%89%B9%E5%B0%BC%E5%85%8B%E5%A4%87%E5%8F%97%E8%B4%A8%E7%96%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794759420000.webp","sourceId":"rfi"}]