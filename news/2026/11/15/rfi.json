[{"id":1794753743000,"createdDate":"2026-11-15 14:42","name":"法国国际广播电台","title":"美国会四项法案有望通过 以收紧AI芯片出口及远程访问监管","content":"在媒体披露，英伟达前首席执行官黄仁勋曾与一名被指是中国情报资产的女子有过婚外情之后，美国国会的议员们正加紧采取行动，旨在阻止先进人工智能（AI）芯片流入中国。民主党和共和党要员均已表态支持一系列法案，这些法案旨在限制敏感芯片的海外销售，并赋予国会审查甚至否决此前已获特朗普政府批准的芯片销售交易的权力。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261115-%E7%BE%8E%E5%9B%BD%E4%BC%9A%E5%9B%9B%E9%A1%B9%E6%B3%95%E6%A1%88%E6%9C%89%E6%9C%9B%E9%80%9A%E8%BF%87-%E4%BB%A5%E6%94%B6%E7%B4%A7ai%E8%8A%AF%E7%89%87%E5%87%BA%E5%8F%A3%E5%8F%8A%E8%BF%9C%E7%A8%8B%E8%AE%BF%E9%97%AE%E7%9B%91%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794753743000.webp","sourceId":"rfi"},{"id":1794749166000,"createdDate":"2026-11-15 13:26","name":"法国国际广播电台","title":"Megaspeed据报曾安排将价值近120亿美元英伟达芯片运往中国企业","content":"新加坡云计算公司Megaspeed周日向消费者新闻与商业频道（CNBC）表示，黄乐已于2025年8月从公司离职，并称Megaspeed已针对有关其业务及供应链的媒体报道启动了内部调查。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-megaspeed%E6%8D%AE%E6%8A%A5%E6%9B%BE%E5%AE%89%E6%8E%92%E5%B0%86%E4%BB%B7%E5%80%BC%E8%BF%91120%E4%BA%BF%E7%BE%8E%E5%85%83%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%8A%AF%E7%89%87%E8%BF%90%E5%BE%80%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794749166000.webp","sourceId":"rfi"},{"id":1794744698000,"createdDate":"2026-11-15 12:11","name":"法国国际广播电台","title":"第49届东盟峰会周日开幕，南海与缅甸成核心议题","content":"周日（11月15日），东南亚各国领导人齐聚马尼拉，开启东盟的年度峰会。为期三天的会议将围绕一系列议题展开，美国总统特朗普也将出席相关会议，这也是他在中期选举失利后首次出访。据本台昨天的报道，特朗普将于周二晚些时候参加三场重要会议，其中包括由美国、日本、澳大利亚和印度组成的“四方安全对话”（QUAD）会议，该机制主要是为了制衡中国影响力。此外，根据菲律宾官员的说法，特朗普还将与东盟领导人举行一场特别峰会。中国方面，多方消息显示，会派出国务院总理李强代表出席峰会。不过，李强将于周一与东盟领导人举行会晤，并会在特朗普周二抵达之前就离开。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261115-%E7%AC%AC49%E5%B1%8A%E4%B8%9C%E7%9B%9F%E5%B3%B0%E4%BC%9A%E5%91%A8%E6%97%A5%E5%BC%80%E5%B9%95%EF%BC%8C%E5%8D%97%E6%B5%B7%E4%B8%8E%E7%BC%85%E7%94%B8%E6%88%90%E6%A0%B8%E5%BF%83%E8%AE%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794744698000.webp","sourceId":"rfi"},{"id":1794744452000,"createdDate":"2026-11-15 12:07","name":"法国国际广播电台","title":"也门政府军从曼德海峡附近区域撤出 胡塞武装获取控制权","content":"周日，效忠于沙特支持的、获国际社会承认的也门政府的武装力量表示，他们正从一处俯瞰战略要地曼德海峡的区域撤出，该区域预计将由亲伊朗的胡塞武装控制。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261115-%E4%B9%9F%E9%97%A8%E6%94%BF%E5%BA%9C%E5%86%9B%E4%BB%8E%E6%9B%BC%E5%BE%B7%E6%B5%B7%E5%B3%A1%E9%99%84%E8%BF%91%E5%8C%BA%E5%9F%9F%E6%92%A4%E5%87%BA-%E8%83%A1%E5%A1%9E%E6%AD%A6%E8%A3%85%E8%8E%B7%E5%8F%96%E6%8E%A7%E5%88%B6%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794744452000.webp","sourceId":"rfi"},{"id":1794743000000,"createdDate":"2026-11-15 11:43","name":"法国国际广播电台","title":"菲外长称《南海行为准则》完成达80%剩下留给新加坡 指东盟十国与中国对局势看法不同","content":"菲律宾外交部长拉扎罗（TheresaLazaro）周日表示，在菲方担任东盟轮值主席国期间，具有约束力的《南海行为准则》将不会最终敲定。拉扎罗指出，该文件已取得实质性进展，目前已完成了80%。她强调：“各国领导人依然致力于维护南中国海的和平、安全与稳定”。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261115-%E8%8F%B2%E5%A4%96%E9%95%BF%E7%A7%B0-%E5%8D%97%E6%B5%B7%E8%A1%8C%E4%B8%BA%E5%87%86%E5%88%99-%E5%AE%8C%E6%88%90%E8%BE%BE80-%E5%89%A9%E4%B8%8B%E7%95%99%E7%BB%99%E6%96%B0%E5%8A%A0%E5%9D%A1-%E6%8C%87%E4%B8%9C%E7%9B%9F%E5%8D%81%E5%9B%BD%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%AF%B9%E5%B1%80%E5%8A%BF%E7%9C%8B%E6%B3%95%E4%B8%8D%E5%90%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794743000000.webp","sourceId":"rfi"},{"id":1794740088000,"createdDate":"2026-11-15 10:54","name":"法国国际广播电台","title":"低碳排的太平洋岛国，承受最前沿气候灾难：聚焦COP31与区域治理权","content":"当地时间11月9日，第31届联合国气候变化大会在土耳其安塔利亚拉开帷幕。本届会议为期两周，由土耳其主办，澳大利亚担任谈判主席国。随着全球气温持续上升，极端天气和气候相关灾害不断增加，会议开幕之际，本次大会组织方再次呼吁国际社会加快气候行动，将应对全球变暖置于各国政策议程的重要位置。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8D%B0%E5%A4%AA%E7%BA%B5%E8%A7%88/20261115-%E4%BD%8E%E7%A2%B3%E6%8E%92%E7%9A%84%E5%A4%AA%E5%B9%B3%E6%B4%8B%E5%B2%9B%E5%9B%BD%EF%BC%8C%E6%89%BF%E5%8F%97%E6%9C%80%E5%89%8D%E6%B2%BF%E6%B0%94%E5%80%99%E7%81%BE%E9%9A%BE-%E8%81%9A%E7%84%A6cop31%E4%B8%8E%E5%8C%BA%E5%9F%9F%E6%B2%BB%E7%90%86%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794740088000.webp","sourceId":"rfi"},{"id":1794739195000,"createdDate":"2026-11-15 10:39","name":"法国国际广播电台","title":"巴林称拦截摧毁多次伊朗空中袭击 9月以来首次执行此类拦截任务","content":"巴林周日表示，该国拦截并摧毁了来自伊朗的数次空中袭击；与此同时，在有关结束伊朗战争的协议前景尚不明朗之际，德黑兰方面声称已打击了位于巴林境内的一处美军基地。这是自9月以来，巴林防空系统首次执行此类拦截任务。在此之前，巴林当局曾两次发出潜在威胁预警，敦促居民寻求掩护。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261115-%E5%B7%B4%E6%9E%97%E6%8C%87%E6%8B%A6%E6%88%AA%E6%91%A7%E6%AF%81%E5%A4%9A%E6%AC%A1%E4%BC%8A%E6%9C%97%E7%A9%BA%E4%B8%AD%E8%A2%AD%E5%87%BB-9%E6%9C%88%E4%BB%A5%E6%9D%A5%E9%A6%96%E6%AC%A1%E6%89%A7%E8%A1%8C%E6%AD%A4%E7%B1%BB%E6%8B%A6%E6%88%AA%E4%BB%BB%E5%8A%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794739195000.webp","sourceId":"rfi"},{"id":1794738929000,"createdDate":"2026-11-15 10:35","name":"法国国际广播电台","title":"当中国的“国家精密资本主义”开始收割世界","content":"各位好，欢迎收听本期的法国报纸摘要。由于本台订阅的法国主流日刊周日大多不出刊，我们照例为您选取法国世界报当中与中国相关的话题做综述。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261115-%E5%BD%93%E4%B8%AD%E5%9B%BD%E7%9A%84-%E5%9B%BD%E5%AE%B6%E7%B2%BE%E5%AF%86%E8%B5%84%E6%9C%AC%E4%B8%BB%E4%B9%89-%E5%BC%80%E5%A7%8B%E6%94%B6%E5%89%B2%E4%B8%96%E7%95%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794738929000.webp","sourceId":"rfi"},{"id":1794738188000,"createdDate":"2026-11-15 10:23","name":"法国国际广播电台","title":"高市首相将在菲律宾倡议创立“亚洲版国际能源署”","content":"高市首相已决定，将在17日于菲律宾马尼拉举行的亚洲零排放共同体（AZEC）首脑会议上，倡议创设“亚洲版国际能源署”，作为在危机时期加强石油相互采购合作的机制。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E5%B0%86%E5%9C%A8%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%80%A1%E8%AE%AE%E5%88%9B%E7%AB%8B-%E4%BA%9A%E6%B4%B2%E7%89%88%E5%9B%BD%E9%99%85%E8%83%BD%E6%BA%90%E7%BD%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794738188000.webp","sourceId":"rfi"},{"id":1794737347000,"createdDate":"2026-11-15 10:09","name":"法国国际广播电台","title":"新美高官会谈同意就共同关心问题，包括Megaspeed案保持沟通","content":"新加坡与美国两国官员在华盛顿举行的高层会议上讨论了Megaspeed公司案相关事宜，双方​​均承诺将继续就此事保持沟通。此次交流发生在新加坡数码发展及新闻部长杨莉明11月12日至13日访问华盛顿期间。访问期间，杨莉明会见了多位特朗普政府要员，包括白宫科技政策办公室主任克拉西奥斯（MichaelKratsios）以及美国常务副国务卿兰道（ChristopherLandau）。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261115-%E6%96%B0%E7%BE%8E%E9%AB%98%E5%AE%98%E4%BC%9A%E8%B0%88%E5%90%8C%E6%84%8F%E5%B0%B1%E5%85%B1%E5%90%8C%E5%85%B3%E5%BF%83%E9%97%AE%E9%A2%98%EF%BC%8C%E5%8C%85%E6%8B%ACmegaspeed%E6%A1%88%E4%BF%9D%E6%8C%81%E6%B2%9F%E9%80%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794737347000.webp","sourceId":"rfi"},{"id":1794734376000,"createdDate":"2026-11-15 09:19","name":"法国国际广播电台","title":"从禁飞、禁售到禁持：自周日起，北京全面禁止居民持有无人机","content":"法新社消息称，自本周日（11月15日）起，北京正式实施无人机全面禁持令，也就是在这个超两千万人口的整个行政辖区内，任何人不得持有无人机。此前，北京已经禁止无人机飞行和销售。近年来，无人机在中国迅速普及，尤其受到旅游和户外活动爱好者的欢迎。许多人喜欢在郊游或旅行时使用无人机拍摄风景。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261115-%E4%BB%8E%E7%A6%81%E9%A3%9E-%E7%A6%81%E5%94%AE%E5%88%B0%E7%A6%81%E6%8C%81-%E8%87%AA%E5%91%A8%E6%97%A5%E8%B5%B7%EF%BC%8C%E5%8C%97%E4%BA%AC%E5%85%A8%E9%9D%A2%E7%A6%81%E6%AD%A2%E5%B1%85%E6%B0%91%E6%8C%81%E6%9C%89%E6%97%A0%E4%BA%BA%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794734376000.webp","sourceId":"rfi"},{"id":1794731108000,"createdDate":"2026-11-15 08:25","name":"法国国际广播电台","title":"俄罗斯获准回归国际冰球大赛，加拿大拒不执行，俄威胁索赔","content":"综合路透社等报道，国际冰球联合会就恢复俄罗斯参赛国际比赛资格的决定，向国际体育仲裁庭提出了异议。多国也表示，若俄罗斯冰球队回归，其将拒绝与之进行比赛，甚至拒绝俄罗斯代表队入境参赛。就此，俄方威胁索赔。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261115-%E4%BF%84%E7%BD%97%E6%96%AF%E8%8E%B7%E5%87%86%E5%9B%9E%E5%BD%92%E5%9B%BD%E9%99%85%E5%86%B0%E7%90%83%E5%A4%A7%E8%B5%9B%EF%BC%8C%E5%8A%A0%E6%8B%BF%E5%A4%A7%E6%8B%92%E4%B8%8D%E6%89%A7%E8%A1%8C%EF%BC%8C%E4%BF%84%E5%A8%81%E8%83%81%E7%B4%A2%E8%B5%94","thumbnail":"","detailImage":"news/detail/rfi/2026/11/15/1794731108000.webp","sourceId":"rfi"}]