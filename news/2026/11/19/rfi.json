[{"id":1795068453000,"createdDate":"2026-11-19 06:07","name":"法国国际广播电台","title":"英国年轻人 失业的一代","content":"在伦敦，这家名为“感觉良好(feelgood)”的咖啡馆为那些远离就业市场的年轻人提供了第二次机会。该项目由“再生(Regenerate)”协会运营，旨在帮助他们获得有偿工作，接受咖啡师培训，并重拾信心，从而规划自己的职业生涯。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261119-%E8%8B%B1%E5%9B%BD%E5%B9%B4%E8%BD%BB%E4%BA%BA-%E5%A4%B1%E4%B8%9A%E7%9A%84%E4%B8%80%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795068453000.webp","sourceId":"rfi"},{"id":1795104179000,"createdDate":"2026-11-19 16:02","name":"法国国际广播电台","title":"AI芯片热潮推动韩国出口突破万亿美元，晋升全球第四","content":"韩国贸易部周四表示，在全球人工智能（AI）芯片热潮带动下，韩国今年累计出口额已突破1万亿美元，成为继德国、美国和中国之后，全球第四个达到这一出口额的国家。相比之下，韩国去年全年出口额创下7090亿美元的历史纪录。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261119-ai%E8%8A%AF%E7%89%87%E7%83%AD%E6%BD%AE%E6%8E%A8%E5%8A%A8%E9%9F%A9%E5%9B%BD%E5%87%BA%E5%8F%A3%E7%AA%81%E7%A0%B4%E4%B8%87%E4%BA%BF%E7%BE%8E%E5%85%83%EF%BC%8C%E6%99%8B%E5%8D%87%E5%85%A8%E7%90%83%E7%AC%AC%E5%9B%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795104179000.webp","sourceId":"rfi"},{"id":1795103823000,"createdDate":"2026-11-19 15:57","name":"法国国际广播电台","title":"财务披露文件显示，特朗普9月买入最高26.5万美元的英伟达股票","content":"根据美国总统特朗普最新财务披露文件显示，他今年9月买入价值最高达26.5万美元的英伟达股票，并卖出价值最高1.5万美元的相关持股。与此同时，外界正持续关注特朗普究竟掌握多少有关黄仁勋和据称涉嫌为中国从事间谍活动女子关系的信息。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E8%B4%A2%E5%8A%A1%E6%8A%AB%E9%9C%B2%E6%96%87%E4%BB%B6%E6%98%BE%E7%A4%BA%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE9%E6%9C%88%E4%B9%B0%E5%85%A5%E6%9C%80%E9%AB%9826-5%E4%B8%87%E7%BE%8E%E5%85%83%E7%9A%84%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%82%A1%E7%A5%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795103823000.webp","sourceId":"rfi"},{"id":1795102955000,"createdDate":"2026-11-19 15:42","name":"法国国际广播电台","title":"美国新规生效，台积电与三星暂停部分中国客户先进制程订单","content":"两名知情人士表示，台积电正进一步收紧对中国芯片设计企业的限制，部分此前仍被允许的先进制程订单将会被暂停，并将受影响客户限制在较成熟工艺节点。根据《金融时报》的报导，三星也采取了相似的做法。路透社称，此举可能切断中国企业生产高性能人工智能处理器的最后几条渠道之一，从而使中国发展国产替代芯片、摆脱对英伟达设计并由台积电代工芯片依赖的努力面临更大挑战。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-%E7%BE%8E%E5%9B%BD%E6%96%B0%E8%A7%84%E7%94%9F%E6%95%88%EF%BC%8C%E5%8F%B0%E7%A7%AF%E7%94%B5%E4%B8%8E%E4%B8%89%E6%98%9F%E6%9A%82%E5%81%9C%E9%83%A8%E5%88%86%E4%B8%AD%E5%9B%BD%E5%AE%A2%E6%88%B7%E5%85%88%E8%BF%9B%E5%88%B6%E7%A8%8B%E8%AE%A2%E5%8D%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795102955000.webp","sourceId":"rfi"},{"id":1795102921000,"createdDate":"2026-11-19 15:42","name":"法国国际广播电台","title":"COP31 ： 新协议一出台即遭杯葛","content":"正在土耳其举行的联合国气候峰会周三经过数小时的部长级“长沙发”会议之后，周四出台了精简版的最新文本，新草案从周一的18页删减成为9页。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261119-cop31-%E7%AC%AC%E4%BA%8C%E4%BB%BD%E5%8D%8F%E8%AE%AE%E8%8D%89%E6%A1%88%E6%BF%80%E5%8F%91%E5%8F%8D%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795102921000.webp","sourceId":"rfi"},{"id":1795090077000,"createdDate":"2026-11-19 12:07","name":"法国国际广播电台","title":"毛里求斯要加入查戈斯群岛讨论","content":"印度洋岛国毛里求斯（Maurice）提出加入美英两国有关查戈斯群岛（ArchipeldesChagos）未来的讨论。这是本台法广非洲组(RFIAfrique)今天（2026年11月19日星期四）刊出的最新法文消息之一。路易港方面总是优先考虑通过外交途径来解决（Port-Louisprivilégietoujoursunesolutiondiplomatique），但不排除将相关问题诉诸司法。毛里求斯的中文国名也有译作模里西斯（Mauritius）。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261119-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E6%AF%9B%E9%87%8C%E6%B1%82%E6%96%AF%E8%A6%81%E5%8A%A0%E5%85%A5%E6%9F%A5%E6%88%88%E6%96%AF%E7%BE%A4%E5%B2%9B%E8%AE%A8%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795090077000.webp","sourceId":"rfi"},{"id":1795087800000,"createdDate":"2026-11-19 11:30","name":"法国国际广播电台","title":"特习普结束历史性三方会晤，讨论乌战与核军控并发表联合《和平宣言》","content":"周四（11月19日），美国总统特朗普、中国国家主席习近平和俄罗斯总统普京结束了一场前所未有的三方会晤。三位领导人在会谈中讨论了乌克兰战争以及核军备控制等议题。据中国官方媒体报道，中国、俄罗斯和美国三国元首在三方峰会结束后通过了一份联合《和平宣言》，其中表示将增加全球成品油的生产和供应。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E7%89%B9%E4%B9%A0%E6%99%AE%E7%BB%93%E6%9D%9F%E5%8E%86%E5%8F%B2%E6%80%A7%E4%B8%89%E6%96%B9%E4%BC%9A%E6%99%A4%EF%BC%8C%E8%AE%A8%E8%AE%BA%E4%B9%8C%E6%88%98%E4%B8%8E%E6%A0%B8%E5%86%9B%E6%8E%A7%E5%B9%B6%E5%8F%91%E8%A1%A8%E8%81%94%E5%90%88-%E5%92%8C%E5%B9%B3%E5%AE%A3%E8%A8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795087800000.webp","sourceId":"rfi"},{"id":1795082510000,"createdDate":"2026-11-19 10:01","name":"法国国际广播电台","title":"朝中社报导金正恩视察海军大学，韩总统府：尚未发现朝美领导人可能会晤的“特殊动向”","content":"朝鲜官方媒体周四（11月19日）报导，朝鲜最高领导人金正恩近日视察了一所海军大学和多处造船设施。此前，美国总统特朗普曾提及本周在中国与金正恩会面的可能性。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E6%9C%9D%E4%B8%AD%E7%A4%BE%E6%8A%A5%E5%AF%BC%E9%87%91%E6%AD%A3%E6%81%A9%E8%A7%86%E5%AF%9F%E6%B5%B7%E5%86%9B%E5%A4%A7%E5%AD%A6%EF%BC%8C%E9%9F%A9%E6%80%BB%E7%BB%9F%E5%BA%9C-%E5%B0%9A%E6%9C%AA%E5%8F%91%E7%8E%B0%E6%9C%9D%E7%BE%8E%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%8F%AF%E8%83%BD%E4%BC%9A%E6%99%A4%E7%9A%84-%E7%89%B9%E6%AE%8A%E5%8A%A8%E5%90%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795082510000.webp","sourceId":"rfi"},{"id":1795081556000,"createdDate":"2026-11-19 09:45","name":"法国国际广播电台","title":"APEC 峰会之际 俄罗斯军机再次飞越台湾","content":"台湾国防部表示，两架俄罗斯图-95军用飞机周四从南面飞越台湾东部，这是两天内俄罗斯军机第二次飞越台湾。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-apec-%E5%B3%B0%E4%BC%9A%E4%B9%8B%E9%99%85-%E4%BF%84%E7%BD%97%E6%96%AF%E5%86%9B%E6%9C%BA%E5%86%8D%E6%AC%A1%E9%A3%9E%E8%B6%8A%E5%8F%B0%E6%B9%BE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795081556000.webp","sourceId":"rfi"},{"id":1795081256000,"createdDate":"2026-11-19 09:40","name":"法国国际广播电台","title":"习近平：美国应在台湾问题上“做正确的事情”，避免中美关系出现大的波折","content":"据中国官方通讯社新华社报道，中国国家主席习近平周四(11月19日)表示，美国应在台湾问题上“做正确的事情”，以避免中美关系遭遇重大挫折。此前，习近平在深圳与美国总统特朗普举行了会谈。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E4%B9%A0%E8%BF%91%E5%B9%B3-%E7%BE%8E%E5%9B%BD%E5%BA%94%E5%9C%A8%E5%8F%B0%E6%B9%BE%E9%97%AE%E9%A2%98%E4%B8%8A-%E5%81%9A%E6%AD%A3%E7%A1%AE%E7%9A%84%E4%BA%8B%E6%83%85-%EF%BC%8C%E9%81%BF%E5%85%8D%E4%B8%AD%E7%BE%8E%E5%85%B3%E7%B3%BB%E5%87%BA%E7%8E%B0%E5%A4%A7%E7%9A%84%E6%B3%A2%E6%8A%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795081256000.webp","sourceId":"rfi"},{"id":1795079949000,"createdDate":"2026-11-19 09:19","name":"法国国际广播电台","title":"高市早苗在APEC峰会期间与普京举行会谈","content":"日本政府周四（11月19日）表示，日本首相高市早苗在中国深圳举行的亚太经合组织（APEC）峰会期间与俄罗斯总统普京进行了会谈。这是高市早苗就任首相以来，双方首次面对面会晤。此次会谈举行之际，日俄关系近期再度恶化。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97%E5%9C%A8apec%E5%B3%B0%E4%BC%9A%E6%9C%9F%E9%97%B4%E4%B8%8E%E6%99%AE%E4%BA%AC%E4%B8%BE%E8%A1%8C%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795079949000.webp","sourceId":"rfi"},{"id":1795079731000,"createdDate":"2026-11-19 09:15","name":"法国国际广播电台","title":"台湾APEC代表施振荣与习近平握手 台湾参会空间再成交点","content":"现年81岁的宏碁电脑创办人施振荣出任本届APEC台湾代表，19日上午会场期间，他与习近平、美国总统特朗普和俄罗斯总统普廷等5国领袖握手。施振荣是一位无鲜明政党色彩的科技界元老，能否顺利完成这次代表台湾的任务，将成为观察本届峰会的重要指标。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261119-%E5%8F%B0%E6%B9%BEapec%E4%BB%A3%E8%A1%A8%E6%96%BD%E6%8C%AF%E8%8D%A3%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8F%A1%E6%89%8B-%E5%8F%B0%E6%B9%BE%E5%8F%82%E4%BC%9A%E7%A9%BA%E9%97%B4%E5%86%8D%E6%88%90%E4%BA%A4%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795079731000.webp","sourceId":"rfi"},{"id":1795079406000,"createdDate":"2026-11-19 09:10","name":"法国国际广播电台","title":"日本方面普遍认为高市首相赴深圳出席APEC峰会遭中国冷遇","content":"日本首相高市早苗于18日抵达中国深圳出席亚太经合组织（APEC）领导人非正式会议。与其他国家领导人相比，中国方面在机场安排的迎接仪式实在过于简单，日本国内因此出现不满，认为中国公然冷遇高市首相。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261119-%E6%97%A5%E6%9C%AC%E6%96%B9%E9%9D%A2%E6%99%AE%E9%81%8D%E8%AE%A4%E4%B8%BA%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E8%B5%B4%E6%B7%B1%E5%9C%B3%E5%87%BA%E5%B8%ADapec%E5%B3%B0%E4%BC%9A%E9%81%AD%E4%B8%AD%E5%9B%BD%E5%86%B7%E9%81%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795079406000.webp","sourceId":"rfi"},{"id":1795079359000,"createdDate":"2026-11-19 09:09","name":"法国国际广播电台","title":"乌克兰本周内第三次袭击克里米亚大桥 导致铁路交通中断","content":"俄罗斯交通部周四（11月19日）表示，连接俄罗斯与克里米亚半岛的克里米亚大桥周三夜间再次遭到乌克兰无人机袭击，导致大桥铁路交通暂时中断。这是乌方一周内第三次对该桥发动攻击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261119-%E4%B9%8C%E5%85%8B%E5%85%B0%E6%9C%AC%E5%91%A8%E5%86%85%E7%AC%AC%E4%B8%89%E6%AC%A1%E8%A2%AD%E5%87%BB%E5%85%8B%E9%87%8C%E7%B1%B3%E4%BA%9A%E5%A4%A7%E6%A1%A5-%E5%AF%BC%E8%87%B4%E9%93%81%E8%B7%AF%E4%BA%A4%E9%80%9A%E4%B8%AD%E6%96%AD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795079359000.webp","sourceId":"rfi"},{"id":1795078987000,"createdDate":"2026-11-19 09:03","name":"法国国际广播电台","title":"三方会晤前特朗普对习近平表示中国可帮助结束乌克兰战争","content":"美国总统特朗普周四（11月19日）对中国国家主席习近平表示，希望双方共同帮助结束乌克兰战争。晚些时候，两人将与俄罗斯总统普京举行一次前所未有的三方会晤。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E4%B8%89%E6%96%B9%E4%BC%9A%E6%99%A4%E5%89%8D%E7%89%B9%E6%9C%97%E6%99%AE%E5%AF%B9%E4%B9%A0%E8%BF%91%E5%B9%B3%E8%A1%A8%E7%A4%BA%E4%B8%AD%E5%9B%BD%E5%8F%AF%E5%B8%AE%E5%8A%A9%E7%BB%93%E6%9D%9F%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E4%BA%89%EF%BC%8C%E5%88%86%E6%9E%90%E4%BA%BA%E5%A3%AB%E8%AE%A4%E4%B8%BA%E4%B8%89%E6%96%B9%E5%BE%88%E9%9A%BE%E8%BE%BE%E6%88%90%E9%87%8D%E5%A4%A7%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795078987000.webp","sourceId":"rfi"},{"id":1795078054000,"createdDate":"2026-11-19 08:47","name":"法国国际广播电台","title":"高市早苗：希望与中国建立“稳定”关系，且日本对台湾立场自1972年来未变","content":"日本首相高市早苗周四（11月19日）表示，东京希望与北京“建立建设性且稳定的关系”，并且日本自1972年以来在台湾问题上的立场没有发生变化。高市早苗此次赴深圳出席亚太经合组织领导人会议，是她自2025年10月上台以来首次访问中国。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261119-%E9%AB%98%E5%B8%82%E6%97%A9%E8%8B%97-%E5%B8%8C%E6%9C%9B%E4%B8%8E%E4%B8%AD%E5%9B%BD%E5%BB%BA%E7%AB%8B-%E7%A8%B3%E5%AE%9A-%E5%85%B3%E7%B3%BB%EF%BC%8C%E4%B8%94%E6%97%A5%E6%9C%AC%E5%AF%B9%E5%8F%B0%E6%B9%BE%E7%AB%8B%E5%9C%BA%E6%9C%AA%E5%8F%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795078054000.webp","sourceId":"rfi"},{"id":1795075720000,"createdDate":"2026-11-19 08:08","name":"法国国际广播电台","title":"习近平APEC宣布：提供2000万推动亚太共同体合作","content":"亚太经济合作组织(APEC)领导人非正式会议今(19日)早召开，东道主的中国国家主席习近平在会上表示，亚太合作须适应新形势，推动建设能包容发展的亚太共同体，中方将提供2000万美元来资助开展亚太经合组织的合作，并会在深圳设立亚太共同体研究中心，开展政策研究和交流，提供智力支撑。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-%E4%B9%A0%E8%BF%91%E5%B9%B3apec%E5%AE%A3%E5%B8%83-%E6%8F%90%E4%BE%9B2000%E4%B8%87%E6%8E%A8%E5%8A%A8%E4%BA%9A%E5%A4%AA%E5%85%B1%E5%90%8C%E4%BD%93%E5%90%88%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795075720000.webp","sourceId":"rfi"},{"id":1795075154000,"createdDate":"2026-11-19 07:59","name":"法国国际广播电台","title":"建宏福苑火灾纪录库者因揭名医之女涉嫌「请枪」反被控四宗罪：吹哨者变被告","content":"曾揭发香港名医之女获奖的AI医疗程式「药倍安心」涉嫌是「请枪」开发，并在大埔宏福苑火灾后建立资料库以保存火灾资讯的大学生郑曦琳，从吹哨者变成刑事被告，在公开获美国着名大学收生後，於昨(18日)午被警方正式起诉她四项「起底罪」，明年春季赴美升学的计划亦可能生变。事件引发关注，有评论认为，揭弊者反成被告令人痛心，亦质疑检控是否涉及政治因素。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261119-%E5%BB%BA%E5%AE%8F%E7%A6%8F%E8%8B%91%E7%81%AB%E7%81%BE%E7%BA%AA%E5%BD%95%E5%BA%93%E8%80%85%E5%9B%A0%E6%8F%AD%E5%90%8D%E5%8C%BB%E4%B9%8B%E5%A5%B3%E6%B6%89%E5%AB%8C-%E8%AF%B7%E6%9E%AA-%E5%8F%8D%E8%A2%AB%E6%8E%A7%E5%9B%9B%E5%AE%97%E7%BD%AA-%E5%90%B9%E5%93%A8%E8%80%85%E5%8F%98%E8%A2%AB%E5%91%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795075154000.webp","sourceId":"rfi"},{"id":1795128689000,"createdDate":"2026-11-19 22:51","name":"法国国际广播电台","title":"习近平 特朗普 普京 谁是最大的赢家","content":"这场被美国总统特朗普形容为“书写历史”的美中俄三元首峰会，究竟谁胜谁负，众说纷纭。法新社分析认为，对参与其中的三位元首而言，每个人似乎都可以自认是赢家。习近平感觉自己处于国际舞台中心，普京庆幸自己冲出重围，与特习同框；而不久前在中期选举中遭遇失败的特朗普则备受东道主的超级抬举，重新占据了“新闻头条”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-%E4%B9%A0%E8%BF%91%E5%B9%B3-%E7%89%B9%E6%9C%97%E6%99%AE-%E6%99%AE%E4%BA%AC-%E8%B0%81%E6%98%AF%E6%9C%80%E5%A4%A7%E7%9A%84%E8%B5%A2%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795128689000.webp","sourceId":"rfi"},{"id":1795124748000,"createdDate":"2026-11-19 21:45","name":"法国国际广播电台","title":"中美俄元首和平宣言 分析指各取所需","content":"这次亚太经合峰会广受瞩目的其实是峰会期间举行的中美俄元首峰会，会后发表了『和平宣言』，但分析指缺乏实质内容。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-%E4%B8%AD%E7%BE%8E%E4%BF%84%E5%85%83%E9%A6%96%E5%92%8C%E5%B9%B3%E5%AE%A3%E8%A8%80-%E5%88%86%E6%9E%90%E6%8C%87%E5%90%84%E5%8F%96%E6%89%80%E9%9C%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795124748000.webp","sourceId":"rfi"},{"id":1795117287000,"createdDate":"2026-11-19 19:41","name":"法国国际广播电台","title":"法国加强选举监管　大型YouTuber首次须遵守政治多元规则","content":"法国视听和数字通信监管机构Arcom宣布，在2027年总统大选期间，部分大型网络内容创作者将首次被要求遵守政治报道多元化原则，引发法国网红和视频创作者的反弹。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261119-%E6%B3%95%E5%9B%BD%E5%8A%A0%E5%BC%BA%E9%80%89%E4%B8%BE%E7%9B%91%E7%AE%A1-%E5%A4%A7%E5%9E%8Byoutuber%E9%A6%96%E6%AC%A1%E9%A1%BB%E9%81%B5%E5%AE%88%E6%94%BF%E6%B2%BB%E5%A4%9A%E5%85%83%E8%A7%84%E5%88%99","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795117287000.webp","sourceId":"rfi"},{"id":1795114760000,"createdDate":"2026-11-19 18:59","name":"法国国际广播电台","title":"美国芯片出口管制遇挑战　CNN称多所中国高校采购英伟达芯片","content":"美国对先进人工智能芯片出口限制的执行面临新的挑战。CNN调查中国高校采购记录发现，至少六所被美国政府列入限制名单的中国高校，近年来曾申报购买受出口管制影响的英伟达（Nvidia）芯片。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261119-%E7%BE%8E%E5%9B%BD%E8%8A%AF%E7%89%87%E5%87%BA%E5%8F%A3%E7%AE%A1%E5%88%B6%E9%81%87%E6%8C%91%E6%88%98-cnn%E7%A7%B0%E5%A4%9A%E6%89%80%E4%B8%AD%E5%9B%BD%E9%AB%98%E6%A0%A1%E9%87%87%E8%B4%AD%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%8A%AF%E7%89%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795114760000.webp","sourceId":"rfi"},{"id":1795114107000,"createdDate":"2026-11-19 18:48","name":"法国国际广播电台","title":"俄罗斯借GTA 6热潮发布征兵宣传","content":"俄罗斯国防部利用全球热门电子游戏《侠盗猎车手VI》（GrandTheftAutoVI）发布宣传图，鼓励民众加入军队、参与乌克兰战事。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261119-%E4%BF%84%E7%BD%97%E6%96%AF%E5%80%9Fgta-vi%E7%83%AD%E6%BD%AE%E5%8F%91%E5%B8%83%E5%BE%81%E5%85%B5%E5%AE%A3%E4%BC%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795114107000.webp","sourceId":"rfi"},{"id":1795113487000,"createdDate":"2026-11-19 18:38","name":"法国国际广播电台","title":"彭博记者遭拒进入美中俄会谈　中国媒体管控再受关注","content":"中国当局周四禁止彭博社记者安玛丽·霍登（AnnmarieHordern）进入美国、中国和俄罗斯领导人三方会谈现场，事件再次引发外界对中国媒体管控的关注。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261119-%E5%BD%AD%E5%8D%9A%E8%AE%B0%E8%80%85%E9%81%AD%E6%8B%92%E8%BF%9B%E5%85%A5%E7%BE%8E%E4%B8%AD%E4%BF%84%E4%BC%9A%E8%B0%88-%E4%B8%AD%E5%9B%BD%E5%AA%92%E4%BD%93%E7%AE%A1%E6%8E%A7%E5%86%8D%E5%8F%97%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795113487000.webp","sourceId":"rfi"},{"id":1795113170000,"createdDate":"2026-11-19 18:32","name":"法国国际广播电台","title":"南非总统拉马福萨考察美国硅谷","content":"南非总统西里尔·拉马福萨（leprésidentsud-africainCyrilRamaphosa）率领着一支庞大的代表团正在对美国展开为期一个星期的跨大西洋访问（unevisiteoutre-Atlantique）。这是本台法广（RFI）非洲通讯员从约翰内斯堡（Johannesbourg）发回的一则法文消息。南非总统于11月15日上星期天出发，专程前往加利福尼亚州（laCalifornie）的硅谷（laSiliconValley）考察。整个行程计划为期一周，将于2026年11月21日星期六结束。南非官方发言人特别补充说，此行没有预备在华盛顿（Washington）停靠。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261119-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%8D%97%E9%9D%9E%E6%80%BB%E7%BB%9F%E6%8B%89%E9%A9%AC%E7%A6%8F%E8%90%A8%E8%80%83%E5%AF%9F%E7%BE%8E%E5%9B%BD%E7%A1%85%E8%B0%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795113170000.webp","sourceId":"rfi"},{"id":1795112148000,"createdDate":"2026-11-19 18:15","name":"法国国际广播电台","title":"Anthropic登陆纳斯达克　人工智能公司IPO创纪录","content":"美国人工智能公司Anthropic周四登陆纳斯达克，上市首日表现强劲，在整体市场低迷之际受到投资者追捧。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261119-anthropic%E7%BA%B3%E6%96%AF%E8%BE%BE%E5%85%8B%E4%B8%8A%E5%B8%82%E9%A6%96%E6%97%A5%E5%A4%A7%E6%B6%A8-%E5%B8%82%E5%80%BC%E7%AA%81%E7%A0%B4%E4%B8%A4%E4%B8%87%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795112148000.webp","sourceId":"rfi"},{"id":1795110920000,"createdDate":"2026-11-19 17:55","name":"法国国际广播电台","title":"国际法院历史性裁决　认定缅甸对罗兴亚人实施种族灭绝","content":"联合国最高司法机构——国际法院周四就冈比亚诉缅甸案作出历史性裁决，以九票对六票认定，缅甸在2017年若开邦北部针对罗兴亚人的军事清剿行动构成种族灭绝，违反《防止及惩治灭绝种族罪公约》。这是国际法院成立八十年来，首次裁定一个国家须为实施种族灭绝承担国际法律责任。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261119-%E5%9B%BD%E9%99%85%E6%B3%95%E9%99%A2%E5%8E%86%E5%8F%B2%E6%80%A7%E8%A3%81%E5%86%B3-%E8%AE%A4%E5%AE%9A%E7%BC%85%E7%94%B8%E5%AF%B9%E7%BD%97%E5%85%B4%E4%BA%9A%E4%BA%BA%E5%AE%9E%E6%96%BD%E7%A7%8D%E6%97%8F%E7%81%AD%E7%BB%9D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/19/1795110920000.webp","sourceId":"rfi"}]