[{"id":1794617339000,"createdDate":"2026-11-14 00:48","name":"法国国际广播电台","title":"黄仁勋何竟只因婚外情被迫辞职英伟达执行长","content":"近日全球媒体狂热追踪的世界AI大佬英伟达联合创始人黄仁勋婚外情事件于本周被揭露的第二起婚外情案件。英伟达董事会12日宣布，黄仁勋已辞去公司总裁、执行长及董事会成员等职务。政治界重要人士的婚外情屡见不鲜，英伟达的顶梁柱黄仁勋只是一介商人，其外遇事件何以全球掀起轩然大波，甚至并导致最终辞职。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261114-%E9%BB%84%E4%BB%81%E5%8B%8B%E4%BD%95%E7%AB%9F%E5%8F%AA%E5%9B%A0%E5%A9%9A%E5%A4%96%E6%83%85%E8%A2%AB%E8%BF%AB%E8%BE%9E%E8%81%8C%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%89%A7%E8%A1%8C%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794617339000.webp","sourceId":"rfi"},{"id":1794666355000,"createdDate":"2026-11-14 14:25","name":"法国国际广播电台","title":"在对欧尔班政府前部长调查中查获约合两千万美元现金 现总理称“黑手党的终结”","content":"在针对前总理欧尔班（ViktorOrbán）执政时期的一位部长——塞斯塔克（MiklosSesztak）——所展开的贿赂调查中，匈牙利当局查获了约合2000万美元的现金；其中部分现金被埋在森林里，另一些则藏在农场建筑和仓库中。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261114-%E5%9C%A8%E5%AF%B9%E6%AC%A7%E5%B0%94%E7%8F%AD%E6%94%BF%E5%BA%9C%E5%89%8D%E9%83%A8%E9%95%BF%E8%B0%83%E6%9F%A5%E4%B8%AD%E6%9F%A5%E8%8E%B7%E7%BA%A6%E5%90%88%E4%B8%A4%E5%8D%83%E4%B8%87%E7%BE%8E%E5%85%83%E7%8E%B0%E9%87%91-%E7%8E%B0%E6%80%BB%E7%90%86%E7%A7%B0-%E9%BB%91%E5%B8%AE%E7%9A%84%E7%BB%88%E7%BB%93","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794666355000.webp","sourceId":"rfi"},{"id":1794663810000,"createdDate":"2026-11-14 13:43","name":"法国国际广播电台","title":"特朗普重返白宫后首次Quad峰会预计周二举行 澳菲将签署防务合作协议","content":"据路透社援引两位知情人士报导，美国、日本、澳大利亚和印度的领导人预计将于周二在马尼拉出席东盟峰会及系列会议期间举行会晤。这将是四方安全对话（Quad）机制成员国两年来首次举行峰会。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261114-%E7%89%B9%E6%9C%97%E6%99%AE%E9%87%8D%E8%BF%94%E7%99%BD%E5%AE%AB%E5%90%8E%E9%A6%96%E6%AC%A1quad%E5%B3%B0%E4%BC%9A%E9%A2%84%E8%AE%A1%E5%91%A8%E4%BA%8C%E4%B8%BE%E8%A1%8C-%E6%BE%B3%E8%8F%B2%E5%B0%86%E7%AD%BE%E7%BD%B2%E9%98%B2%E5%8A%A1%E5%90%88%E4%BD%9C%E5%8D%8F%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794663810000.webp","sourceId":"rfi"},{"id":1794659799000,"createdDate":"2026-11-14 12:36","name":"法国国际广播电台","title":"泽连斯基：普京并不支持停火，不会同意在宪法中确立中立地位","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周五在接受记者采访时表示，在阿布扎比举行的会谈中，俄罗斯代表团称其并无授权讨论能源休战或其他停火方案，并指此事需由俄总统普京来决定。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261114-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E6%99%AE%E4%BA%AC%E5%B9%B6%E4%B8%8D%E6%94%AF%E6%8C%81%E5%81%9C%E7%81%AB%EF%BC%8C%E4%B8%8D%E4%BC%9A%E5%90%8C%E6%84%8F%E5%9C%A8%E5%AE%AA%E6%B3%95%E4%B8%AD%E7%A1%AE%E7%AB%8B%E4%B8%AD%E7%AB%8B%E5%9C%B0%E4%BD%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794659799000.webp","sourceId":"rfi"},{"id":1794658642000,"createdDate":"2026-11-14 12:17","name":"法国国际广播电台","title":"费加罗报：北京控制下的香港正以另一种方式“重新崛起” 法国房地产迎来大萧条时代","content":"今日出刊的费加罗报发表多篇与中国有关的文章，尤其是国际版，用了整版的内容来报道中国的粤港澳地区。我们为您一一详细介绍。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261114-%E8%B4%B9%E5%8A%A0%E7%BD%97%E6%8A%A5-%E5%8C%97%E4%BA%AC%E6%8E%A7%E5%88%B6%E4%B8%8B%E7%9A%84%E9%A6%99%E6%B8%AF%E6%AD%A3%E4%BB%A5%E5%8F%A6%E4%B8%80%E7%A7%8D%E6%96%B9%E5%BC%8F-%E9%87%8D%E6%96%B0%E5%B4%9B%E8%B5%B7-%E6%B3%95%E5%9B%BD%E6%88%BF%E5%9C%B0%E4%BA%A7%E8%BF%8E%E6%9D%A5%E5%A4%A7%E8%90%A7%E6%9D%A1%E6%97%B6%E4%BB%A3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794658642000.webp","sourceId":"rfi"},{"id":1794657828000,"createdDate":"2026-11-14 12:03","name":"法国国际广播电台","title":"刘德华《白衣逆行者》积压六年上映前夕悄然撤档 中国为何不敢再谈抗疫？","content":"由香港导演邱礼涛执导、刘德华主演的武汉抗疫电影《白衣逆行者》，原定11月6日在中国全国上映，却在上映前夕从售票平台上消失。这部片早在2020年已经杀青，等了将近六年才敲定档期，然而消息一出，网上却是一片「不想再回忆」的声音。一部歌颂医护人员的疫情电影，在上映前夕撤下了播映。武汉封城的记忆，为什么无法走进电影院？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%BE%AE%E8%A8%80%E5%BE%AE%E8%AF%AD/20261114-%E5%88%98%E5%BE%B7%E5%8D%8E-%E7%99%BD%E8%A1%A3%E9%80%86%E8%A1%8C%E8%80%85-%E7%A7%AF%E5%8E%8B%E5%85%AD%E5%B9%B4%E4%B8%8A%E6%98%A0%E5%89%8D%E5%A4%95%E6%82%84%E7%84%B6%E6%92%A4%E6%A1%A3-%E4%B8%AD%E5%9B%BD%E4%B8%BA%E4%BD%95%E4%B8%8D%E6%95%A2%E5%86%8D%E8%B0%88%E6%8A%97%E7%96%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794657828000.webp","sourceId":"rfi"},{"id":1794656875000,"createdDate":"2026-11-14 11:47","name":"法国国际广播电台","title":"泽连斯基指美方首次提出乌克兰以撤出顿巴斯为条件加入北约可能性","content":"乌克兰总统泽连斯基（VolodymyrZelenskyy）周五在接受记者采访时表示，美方首次提出乌克兰以撤出顿巴斯为条件加入北约的可能性。泽连斯基指出，乌方正与伙伴国讨论一揽子安全保障方案，但目前尚未提出具体内容。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261114-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E6%8C%87%E7%BE%8E%E6%96%B9%E9%A6%96%E6%AC%A1%E6%8F%90%E5%87%BA%E4%B9%8C%E5%85%8B%E5%85%B0%E4%BB%A5%E6%92%A4%E5%87%BA%E9%A1%BF%E5%B7%B4%E6%96%AF%E4%B8%BA%E6%9D%A1%E4%BB%B6%E5%8A%A0%E5%85%A5%E5%8C%97%E7%BA%A6%E5%8F%AF%E8%83%BD%E6%80%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794656875000.webp","sourceId":"rfi"},{"id":1794652795000,"createdDate":"2026-11-14 10:39","name":"法国国际广播电台","title":"黄仁勋据报就其与黄乐关系性质曾误导英伟达法律总顾问等高管","content":"据两位知情人士透露，并结合路透社所审阅的内部通信记录，黄仁勋曾就其黄乐之间的关系性质，误导了英伟达的多位高管——包括公司法律总顾问泰特（TimTeter）和首席营销官瓦贡菲尔德（AlisonWagonfeld）。黄仁勋与该女子有过一段婚外情。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261114-%E9%BB%84%E4%BB%81%E5%8B%8B%E6%8D%AE%E6%8A%A5%E5%B0%B1%E5%85%B6%E4%B8%8E%E9%BB%84%E4%B9%90%E5%85%B3%E7%B3%BB%E6%80%A7%E8%B4%A8%E6%9B%BE%E8%AF%AF%E5%AF%BC%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%B3%95%E5%BE%8B%E6%80%BB%E9%A1%BE%E9%97%AE%E7%AD%89%E9%AB%98%E7%AE%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794652795000.webp","sourceId":"rfi"},{"id":1794651922000,"createdDate":"2026-11-14 10:25","name":"法国国际广播电台","title":"美联社分析：英伟达丑闻会加剧中美之间的人工智能竞争","content":"美联社周六（11月14日）报导称，英伟达丑闻会加剧中美之间的人工智能竞争。下周特朗普将与习近平会晤，当前美国国会两党议员正借此发声，要求进一步收紧技术出口限制，防止中国获得美国先进芯片及技术，以维护美国在人工智能领域的领先优势。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261114-%E7%BE%8E%E8%81%94%E7%A4%BE-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E4%B8%91%E9%97%BB%E4%BC%9A%E5%8A%A0%E5%89%A7%E4%B8%AD%E7%BE%8E%E4%B9%8B%E9%97%B4%E7%9A%84%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%AB%9E%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794651922000.webp","sourceId":"rfi"},{"id":1794651313000,"createdDate":"2026-11-14 10:15","name":"法国国际广播电台","title":"访华在即 美官员：预计特朗普不会与习近平提及黄乐事件","content":"美方官员周五表示，预计美国总统特朗普（DonaldTrump）在与中国国家主席习近平会晤时，不会提及黄乐事件；该中国女商人与英伟达前首席执行官黄仁勋之间的婚外情曾在华盛顿引发国家安全方面的担忧。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261114-%E7%BE%8E%E5%AE%98%E5%91%98-%E9%A2%84%E8%AE%A1%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8D%E4%BC%9A%E4%B8%8E%E4%B9%A0%E8%BF%91%E5%B9%B3%E6%8F%90%E5%8F%8A%E9%BB%84%E4%B9%90%E4%BA%8B%E4%BB%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794651313000.webp","sourceId":"rfi"},{"id":1794649339000,"createdDate":"2026-11-14 09:42","name":"法国国际广播电台","title":"美高官：特朗普将与普习谈核裁军 预计不单独见普京、不谈俄乌战争","content":"白宫方面周五表示，美国总统特朗普将于下周在中国与俄罗斯总统普京及中国国家主席习近平举行会晤，届时他将提出核裁军议题。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261114-%E7%BE%8E%E9%AB%98%E5%AE%98-%E7%89%B9%E6%9C%97%E6%99%AE%E5%B0%86%E4%B8%8E%E6%99%AE%E4%B9%A0%E8%B0%88%E6%A0%B8%E8%A3%81%E5%86%9B-%E9%A2%84%E8%AE%A1%E4%B8%8D%E5%8D%95%E7%8B%AC%E8%A7%81%E6%99%AE%E4%BA%AC-%E4%B8%8D%E8%B0%88%E4%BF%84%E4%B9%8C%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794649339000.webp","sourceId":"rfi"},{"id":1794647600000,"createdDate":"2026-11-14 09:13","name":"法国国际广播电台","title":"高市首相拟在东盟首脑会议期间与特朗普会晤 讨论中美俄首脑会谈","content":"美国白宫新闻发言人13日宣布，美国、中国和俄罗斯三国领导人会谈将于19日在中国举行，并表示会谈将讨论削减全球核武器问题。这将是历史上首次举行的三方首脑会谈。据悉，日本政府目前正向美国方面提出，希望借本月中旬在菲律宾马尼拉举行的东南亚国家联盟（ASEAN）相关首脑会议之机，为日本首相高市早苗与美国总统特朗普创造对话机会。在菲律宾期间，日本、美国、澳大利亚和印度四国合作机制“四方安全对话”（QUAD）的首脑会议也正在协调安排之中。高市首相希望在该会议前后等时机寻求与特朗普对话。如果能够实现，日本方面希望就如何看待中国和俄罗斯的问题与美国展开协商，协调立场。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261114-%E9%AB%98%E5%B8%82%E9%A6%96%E7%9B%B8%E6%8B%9F%E5%9C%A8%E4%B8%9C%E7%9B%9F%E9%A6%96%E8%84%91%E4%BC%9A%E8%AE%AE%E6%9C%9F%E9%97%B4%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E4%BC%9A%E6%99%A4-%E8%AE%A8%E8%AE%BA%E4%B8%AD%E7%BE%8E%E4%BF%84%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/14/1794647600000.webp","sourceId":"rfi"}]