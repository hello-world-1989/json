[{"id":1794467760000,"createdDate":"2026-11-12 07:16","name":"英国广播公司","title":"黃仁勳婚外情：黃樂據稱已返回中國，曾多次入境美國、台灣","content":"據報導，捲入婚外情、被指涉入中國間諜活動的女子黃樂（AliceHuangLe）已經返回中國。近年來，她曾十次入境美國、八次入境台灣。","newsLink":"https://www.bbc.com/zhongwen/articles/cje391ee1xvlo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/11/12/1794467760000.webp","sourceId":"bbc"},{"id":1794460857000,"createdDate":"2026-11-12 05:20","name":"英国广播公司","title":"黃仁勳疑涉另一宗婚外情，Nvidia董事會傳擬撤換執行長","content":"隨着第二宗婚外情的報導曝光，Nvidia股價大幅下跌。據報董事會正與一家外部公司合作，尋找黃仁勳的潛在繼任者。","newsLink":"https://www.bbc.com/zhongwen/articles/c63egjy85wq8o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/11/12/1794460857000.webp","sourceId":"bbc"},{"id":1794453040000,"createdDate":"2026-11-12 03:10","name":"英国广播公司","title":"西班牙大罷工：數萬人參與、巴塞羅那爆發警民衝突","content":"數以萬計民眾參與這場由西班牙主要工會發起的工業行動，抗議住房問題及生活成本高漲。","newsLink":"https://www.bbc.com/zhongwen/articles/c8wy5x2q2wryo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/11/12/1794453040000.webp","sourceId":"bbc"},{"id":1794447918000,"createdDate":"2026-11-12 01:45","name":"英国广播公司","title":"中美能源大戰，如何影響你的帳單？","content":"中美之間的博弈可能會對能源成本產生重大影響，但誰會最終獲勝？","newsLink":"https://www.bbc.com/zhongwen/articles/cmvg2er51z1wo/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/11/12/1794447918000.webp","sourceId":"bbc"},{"id":1794500081000,"createdDate":"2026-11-12 16:14","name":"英国广播公司","title":"從科技巨星到跌落神壇——黃仁勳如何深陷醜聞漩渦？","content":"短短幾天內，黃仁勳作為全球科技競賽領軍人物、看似無可撼動的地位便迅速崩塌。","newsLink":"https://www.bbc.com/zhongwen/articles/cm3wgp60p952o/trad?at_medium=RSS&at_campaign=rss","thumbnail":"","detailImage":"news/detail/bbc/2026/11/12/1794500081000.webp","sourceId":"bbc"},{"id":1794499939000,"createdDate":"2026-11-12 16:12","name":"英国广播公司","title":"黃仁勳辭職：暫時接掌Nvidia的克雷斯是誰？還有哪些正式接班人選？","content":"財務長科萊特·克雷斯將暫時接替黃仁勳，但另有數人被視為可能的正式接班人。","newsLink":"https://www.bbc.com/zhongwen/articles/