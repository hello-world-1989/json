[{"id":1795803125000,"createdDate":"2026-11-27 18:12","name":"法国国际广播电台","title":"桑普：港裔台人参选限制多 暂难成气候","content":"在2019年的反对修订逃犯条例运动之后，不少香港人移居台湾，而获得定居身份可以投票的，人数约有一万人，但这却未能令参选的港人数目大幅上升，以即将进行投票的九合一选举为例，只有两人是具有港人背景，与四年前的选举相若；与大陆配偶的参选人数节节上升，今年便有26名具陆配身份人士参选，比2022年的九合一选举上升37%。追求民主自由的香港人，为什么来了台湾之后，参选人数远较陆配为低？有什么困难？如何解决？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE/20261127-%E6%A1%91%E6%99%AE-%E6%B8%AF%E8%A3%94%E5%8F%B0%E4%BA%BA%E5%8F%82%E9%80%89%E9%99%90%E5%88%B6%E5%A4%9A-%E6%9A%82%E9%9A%BE%E6%88%90%E6%B0%94%E5%80%99","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795803125000.webp","sourceId":"rfi"},{"id":1795799321000,"createdDate":"2026-11-27 17:08","name":"法国国际广播电台","title":"入侵乌克兰战争近五年，俄军损兵折将估计超过70万人","content":"两个黑客团体11月初成功侵入俄罗斯联邦统计局网络。一些独立媒体根据由此流出的官方统计数字估计，2022年至2026年9月底，俄军可能有超过70万人死于战场。克里姆林宫发言人25日在例行简报会上拒绝对这些数字发表评论。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261127-%E5%85%A5%E4%BE%B5%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E4%BA%89%E8%BF%91%E4%BA%94%E5%B9%B4%EF%BC%8C%E4%BF%84%E5%86%9B%E6%8D%9F%E5%85%B5%E6%8A%98%E5%B0%86%E4%BC%B0%E8%AE%A1%E8%B6%85%E8%BF%8770%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795799321000.webp","sourceId":"rfi"},{"id":1795798476000,"createdDate":"2026-11-27 16:54","name":"法国国际广播电台","title":"首尔遣返六名在海上获救的朝鲜渔民  一人选择留韩","content":"韩国统一部周五（11月27号）宣布，韩国已将六名朝鲜渔民遣返回国。此前，他们的渔船在日本海国际水域漂流时获救。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261127-%E9%A6%96%E5%B0%94%E9%81%A3%E8%BF%94%E5%85%AD%E5%90%8D%E5%9C%A8%E6%B5%B7%E4%B8%8A%E8%8E%B7%E6%95%91%E7%9A%84%E6%9C%9D%E9%B2%9C%E6%B8%94%E6%B0%91-%E4%B8%80%E4%BA%BA%E9%80%89%E6%8B%A9%E7%95%99%E9%9F%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795798476000.webp","sourceId":"rfi"},{"id":1795796774000,"createdDate":"2026-11-27 16:26","name":"法国国际广播电台","title":"拉脱维亚军方：一架无人机短暂侵犯领空  北约战机紧急回应","content":"拉脱维亚武装部队周五（11月27号）在一份声明中表示，一架无人机于周五短暂侵犯了拉脱维亚领空，这是欧盟和北约成员国领空再次遭到侵犯的事件。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261127-%E6%8B%89%E8%84%B1%E7%BB%B4%E4%BA%9A%E5%86%9B%E6%96%B9-%E4%B8%80%E6%9E%B6%E6%97%A0%E4%BA%BA%E6%9C%BA%E7%9F%AD%E6%9A%82%E4%BE%B5%E7%8A%AF%E9%A2%86%E7%A9%BA-%E5%8C%97%E7%BA%A6%E6%88%98%E6%9C%BA%E7%B4%A7%E6%80%A5%E5%9B%9E%E5%BA%94","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795796774000.webp","sourceId":"rfi"},{"id":1795794811000,"createdDate":"2026-11-27 15:53","name":"法国国际广播电台","title":"广西前主席蓝天立涉巨贪判死缓 不得减刑或假释","content":"路透社周五（11月27日）报道，中国一家法院一审判处广西壮族自治区政府前主席蓝天立死刑，缓刑两年执行。期满后不得减刑假释。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261127-%E5%B9%BF%E8%A5%BF%E5%89%8D%E4%B8%BB%E5%B8%AD%E8%93%9D%E5%A4%A9%E7%AB%8B%E6%B6%89%E5%B7%A8%E8%B4%AA%E5%88%A4%E6%AD%BB%E7%BC%93-%E4%B8%8D%E5%BE%97%E5%87%8F%E5%88%91%E6%88%96%E5%81%87%E9%87%8A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795794811000.webp","sourceId":"rfi"},{"id":1795793420000,"createdDate":"2026-11-27 15:30","name":"法国国际广播电台","title":"北京罕提“国家队”上场 稳定跌跌不休的股市","content":"据中国官媒新华社报道，中国国务院总理李强周五（11月27号）主持召开内阁会议，呼吁国家支持的“国家队”投资者发挥更大作用，以稳定不断下跌的股市。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261127-%E5%8C%97%E4%BA%AC%E7%BD%95%E6%8F%90-%E5%9B%BD%E5%AE%B6%E9%98%9F-%E4%B8%8A%E5%9C%BA-%E7%A8%B3%E5%AE%9A%E8%B7%8C%E8%B7%8C%E4%B8%8D%E4%BC%91%E7%9A%84%E8%82%A1%E5%B8%82","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795793420000.webp","sourceId":"rfi"},{"id":1795791710000,"createdDate":"2026-11-27 15:01","name":"法国国际广播电台","title":"传为救线人向中国提供台湾情报  韩国国情院否认","content":"综合韩媒报导，有消息指出，韩国情报机构在与北京方面交涉、以释放因间谍等罪名遭拘留的韩方线人期间，曾向中国提供有关台湾人员情报来源的资讯。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261127-%E4%BC%A0%E4%B8%BA%E6%95%91%E7%BA%BF%E4%BA%BA%E5%90%91%E4%B8%AD%E5%9B%BD%E6%8F%90%E4%BE%9B%E5%8F%B0%E6%B9%BE%E6%83%85%E6%8A%A5-%E9%9F%A9%E5%9B%BD%E5%9B%BD%E6%83%85%E9%99%A2%E5%90%A6%E8%AE%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795791710000.webp","sourceId":"rfi"},{"id":1795791136000,"createdDate":"2026-11-27 14:52","name":"法国国际广播电台","title":"美芯片管控措施指向东南亚，中国IA研发陷入处处围堵","content":"美国人工智能领域的龙头企业英伟达的创办人及首席执行官黄仁勋虽然官复原职重回英伟达，但他与中国女子黄乐的婚外情背后的中美围绕人工智能技术的角力仍然余波荡漾，不仅令本已经艰难保持稳定的中美关系新增紧张气氛，也开始波及不少东南亚国家。美国政府11月中旬宣布限制向新加坡、泰国、马来西亚和印度尼西亚四个东南亚国家以及巴西出口最先进制程芯片后，英国《金融时报》日前披露，英伟达集团已经要求其合作伙伴停止向新加坡、泰国、马来西亚和印尼这四国输出伺服器。黄仁勋婚外情事件冲击波后，美国扩大了对人工智能相关技术出口的管控力度，令中国的人工智能研发面对更艰难的环境。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261127-%E7%BE%8E%E8%8A%AF%E7%89%87%E7%AE%A1%E6%8E%A7%E6%8E%AA%E6%96%BD%E6%8C%87%E5%90%91%E4%B8%9C%E5%8D%97%E4%BA%9A%EF%BC%8C%E4%B8%AD%E5%9B%BDia%E7%A0%94%E5%8F%91%E9%99%B7%E5%85%A5%E5%A4%84%E5%A4%84%E5%9B%B4%E5%A0%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795791136000.webp","sourceId":"rfi"},{"id":1795785846000,"createdDate":"2026-11-27 13:24","name":"法国国际广播电台","title":"路透： 中国军队在福建沿海演习中测试民船搭建浮桥","content":"路透社周五（11月27号）报道，卫星图像和一份研究报告显示，中国正在台湾对面的省份进行为期数周的两栖登陆演习，测试一种将民用船只连接成临时浮桥，从而实现部队登陆的新方法。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261127-%E8%B7%AF%E9%80%8F-%E4%B8%AD%E5%9B%BD%E5%86%9B%E9%98%9F%E5%9C%A8%E7%A6%8F%E5%BB%BA%E6%B2%BF%E6%B5%B7%E6%BC%94%E4%B9%A0%E4%B8%AD%E6%B5%8B%E8%AF%95%E6%B0%91%E8%88%B9%E6%90%AD%E5%BB%BA%E6%B5%AE%E6%A1%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795785846000.webp","sourceId":"rfi"},{"id":1795783390000,"createdDate":"2026-11-27 12:43","name":"法国国际广播电台","title":"台湾：九合一选举最后一天冲刺 国防部称侦测到中国派出的战机","content":"台湾九合一地方选举周五（11月27号）进入了竞选活动的最后一天。此次选举受到北京方面的密切关注，台湾国防部报告称，侦测到中国空军活动再次激增。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261127-%E5%8F%B0%E6%B9%BE-%E4%B9%9D%E5%90%88%E4%B8%80%E9%80%89%E4%B8%BE%E6%9C%80%E5%90%8E%E4%B8%80%E5%A4%A9%E5%86%B2%E5%88%BA-%E5%9B%BD%E9%98%B2%E9%83%A8%E7%A7%B0%E4%BE%A6%E6%B5%8B%E5%88%B0%E4%B8%AD%E5%9B%BD%E6%B4%BE%E5%87%BA%E7%9A%84%E6%88%98%E6%9C%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795783390000.webp","sourceId":"rfi"},{"id":1795781068000,"createdDate":"2026-11-27 12:04","name":"法国国际广播电台","title":"近20年来首次民进党台北市长候选人取消选前之夜 沈伯洋宣布改线上活动","content":"沈伯洋取消选前市民之夜，堪称是这场选举最出其不意的剧情。这更是台北市自1994年恢复市长直选以来，首次有民进党参选人不举办选前之夜。这可能窒碍绿营凝聚声势，但作为非典型参选人，这将考验沈伯洋能否找到替代方法化危为机。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261127-%E8%BF%9120%E5%B9%B4%E6%9D%A5%E9%A6%96%E6%AC%A1%E6%B0%91%E8%BF%9B%E5%85%9A%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%BF%E5%80%99%E9%80%89%E4%BA%BA%E5%8F%96%E6%B6%88%E9%80%89%E5%89%8D%E4%B9%8B%E5%A4%9C-%E6%B2%88%E4%BC%AF%E6%B4%8B%E5%AE%A3%E5%B8%83%E6%94%B9%E7%BA%BF%E4%B8%8A%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795781068000.webp","sourceId":"rfi"},{"id":1795780633000,"createdDate":"2026-11-27 11:57","name":"法国国际广播电台","title":"特朗普称他掌握“信息”表明 黄仁勋不会构成安全威胁","content":"美国总统唐纳德·特朗普周四（11月26号）声称，他掌握了足够的信息，足以得出科技巨头英伟达首席执行官黄仁勋不会构成安全威胁的结论。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261127-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%BB%96%E6%8E%8C%E6%8F%A1-%E4%BF%A1%E6%81%AF-%E8%A1%A8%E6%98%8E-%E9%BB%84%E4%BB%81%E5%8B%8B%E4%B8%8D%E4%BC%9A%E6%9E%84%E6%88%90%E5%AE%89%E5%85%A8%E5%A8%81%E8%83%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795780633000.webp","sourceId":"rfi"},{"id":1795779938000,"createdDate":"2026-11-27 11:45","name":"法国国际广播电台","title":"台湾九合一选举首次增「港味」 两港裔学者和退伍军人参选惹关注","content":"台湾九合一选举明(28日)早起投票，二千万名选民将会从接近二万名候选人中选出1.1万名地方公职人员，当中，有两人具有港人背景，更是首次有港人「打正旗号」参选，二人更曾计划举办记者会，藉此增强声势，但其中一位「港裔」候选人邓乐强亦明言，由於选民人数不多，香港因素在选举中作用不大。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261127-%E5%8F%B0%E6%B9%BE%E4%B9%9D%E5%90%88%E4%B8%80%E9%80%89%E4%B8%BE%E9%A6%96%E6%AC%A1%E5%A2%9E-%E6%B8%AF%E5%91%B3-%E4%B8%A4%E6%B8%AF%E8%A3%94%E5%AD%A6%E8%80%85%E5%92%8C%E9%80%80%E4%BC%8D%E5%86%9B%E4%BA%BA%E5%8F%82%E9%80%89%E6%83%B9%E5%85%B3%E6%B3%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795779938000.webp","sourceId":"rfi"},{"id":1795779673000,"createdDate":"2026-11-27 11:41","name":"法国国际广播电台","title":"特朗普淡化北京和莫斯科对德黑兰的情报支持","content":"尽管媒体报道指出，在中东战争的背景下，德黑兰的盟友曾参与袭击美国军事基地。但美国总统特朗普周四淡化了中国和俄罗斯与伊朗共享情报的重要性。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261127-%E7%89%B9%E6%9C%97%E6%99%AE%E6%B7%A1%E5%8C%96%E5%8C%97%E4%BA%AC%E5%92%8C%E8%8E%AB%E6%96%AF%E7%A7%91%E5%AF%B9%E5%BE%B7%E9%BB%91%E5%85%B0%E7%9A%84%E6%83%85%E6%8A%A5%E6%94%AF%E6%8C%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795779673000.webp","sourceId":"rfi"},{"id":1795777273000,"createdDate":"2026-11-27 11:01","name":"法国国际广播电台","title":"COP31就公正转型达成共识   NGO 有何不满？","content":"联合国第31届气候峰会11月22日在土耳其落下帷幕，此次峰会未能就封面决议达成共识，因而无果而终，不过，与会国家最终就公正转型的机制问题达成一致，尽管达成的决定是将机制建立的日程表推迟到下一届的气候峰会，也就是说比原先预期的在今年峰会上敲定的结果又延期了一年，不过，对许多支持此一机制的发展中国家以及公民社会来说，公正转型机制的设立并未遭到否决本身就值得庆幸，因为同去年相对比，至少并没有退步。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261127-cop31%E5%B0%B1%E5%85%AC%E6%AD%A3%E8%BD%AC%E5%9E%8B%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86-ngo-%E6%9C%89%E4%BD%95%E4%B8%8D%E6%BB%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795777273000.webp","sourceId":"rfi"},{"id":1795775925000,"createdDate":"2026-11-27 10:38","name":"法国国际广播电台","title":"中国国务院总理李强会见亚洲开发银行日本人行长","content":"中国国务院总理李强11月26日在北京人民大会堂会见了亚洲开发银行行长神田真人，并表示：“希望进一步加强双方的合作伙伴关系。”中国对日本首相高市早苗去年11月围绕“台湾有事”发表的国会答辩表示强烈反对，导致中日关系陷入低潮，神田虽然是国际机构的负责人，但自高市发表上述国会答辩以来，李强与日本人举行会谈也属罕见。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261127-%E4%B8%AD%E5%9B%BD%E5%9B%BD%E5%8A%A1%E9%99%A2%E6%80%BB%E7%90%86%E6%9D%8E%E5%BC%BA%E4%BC%9A%E8%A7%81%E4%BA%9A%E6%B4%B2%E5%BC%80%E5%8F%91%E9%93%B6%E8%A1%8C%E6%97%A5%E6%9C%AC%E4%BA%BA%E8%A1%8C%E9%95%BF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/27/1795775925000.webp","sourceId":"rfi"}]