[{"id":1793675915000,"createdDate":"2026-11-03 03:18","name":"法国国际广播电台","title":"中国：一名男子因用绳子拴着9岁儿子跑马拉松被禁赛3年","content":"中国郑州马拉松赛上的一张照片在中国的社交媒体上引发众怒：一名男子用绳子拴着他九岁的儿子跑步。赛事组织者被迫对他进行了严厉处罚。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261103-%E4%B8%AD%E5%9B%BD-%E4%B8%80%E5%90%8D%E7%94%B7%E5%AD%90%E5%9B%A0%E7%94%A8%E7%BB%B3%E5%AD%90%E6%8B%B4%E7%9D%809%E5%B2%81%E5%84%BF%E5%AD%90%E8%B7%91%E9%A9%AC%E6%8B%89%E6%9D%BE%E8%A2%AB%E7%A6%81%E8%B5%9B3%E5%B9%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793675915000.webp","sourceId":"rfi"},{"id":1793717284000,"createdDate":"2026-11-03 14:48","name":"法国国际广播电台","title":"法媒纷纷聚焦美国中期选举对特朗普政府的影响","content":"3日启动投票的美国中期选举占据当日出版的法国各全国性头版头条以及国际版大版篇幅。《解放报》头版醒目标题写着：让民主党人的美国再次伟大。《费加罗报》凸出这次中期选举是一次对特朗普的公民投票。法共《人道报》则把这次选举称作是反特朗普公民投票。财经报刊《回声报》的标题大同小异，写着：算账的时候到了。天主教报刊《十字架报》则重点关注天主教信徒对特朗普的失望。在美国中期选举话题之外，各报在国际版关注的话题还有在保加利亚刚刚结束的总统选举中，立场亲俄罗斯的现任总统伊莉亚娜·约托娃（IlianaIotova）胜出、支持乌克兰的“志愿国”联盟将在波兰联合演习、塞尔维亚立法选举后的政治形势、以色列大选之后总理内塔尼雅胡面对的政治困局、等等。财经报刊《回声报》特别以大版篇幅展望2027年欧洲不再进口俄罗斯天然气对各国能源价格的影响。该报也刊登文章介绍欧盟对中国的反倾销措施对欧洲钢铁业的积极作用。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261103-%E6%B3%95%E5%AA%92%E7%BA%B7%E7%BA%B7%E8%81%9A%E7%84%A6%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E6%94%BF%E5%BA%9C%E7%9A%84%E5%BD%B1%E5%93%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793717284000.webp","sourceId":"rfi"},{"id":1793716825000,"createdDate":"2026-11-03 14:40","name":"法国国际广播电台","title":"捷克：被控从事间谍活动的中国公民获判无罪释放 检方提上诉","content":"路透社：中国官员谈及今年6月中国以危害国家安全拘留一名捷克公民时，要求捷克释放杨艺明。台媒怀疑杨艺明案与台湾副总统萧美琴访捷克期间遭跟踪险酿车祸有关。捷克现政府自去年12月上台以来致力于与北京建立更务实关系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E6%8D%B7%E5%85%8B-%E8%A2%AB%E6%8E%A7%E4%BB%8E%E4%BA%8B%E9%97%B4%E8%B0%8D%E6%B4%BB%E5%8A%A8%E7%9A%84%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E8%8E%B7%E5%88%A4%E6%97%A0%E7%BD%AA%E9%87%8A%E6%94%BE-%E6%A3%80%E6%96%B9%E6%8F%90%E4%B8%8A%E8%AF%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793716825000.webp","sourceId":"rfi"},{"id":1793711988000,"createdDate":"2026-11-03 13:19","name":"法国国际广播电台","title":"民主党重夺国会可改善美加关系？ 加拿大人不抱过高期望","content":"美国中期选举后民主党重夺国会控制权。对加拿大人而言，这场选举虽可能对美国总统权力带来一定程度的制衡，但两国关系很难马上就修复过来，加拿大也不再把希望寄托在美国政治转向。选前最后几天的民调、谈判讯号与政策动向，都指向同一个结论，就是加拿大人已做好心理准备，美加关系已无法回到以前。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E5%8C%97%E7%BE%8E%E6%9D%A5%E9%B8%BF/20261103-%E6%B0%91%E4%B8%BB%E5%85%9A%E9%87%8D%E5%A4%BA%E5%9B%BD%E4%BC%9A%E5%8F%AF%E6%94%B9%E5%96%84%E7%BE%8E%E5%8A%A0%E5%85%B3%E7%B3%BB-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E4%BA%BA%E4%B8%8D%E6%8A%B1%E8%BF%87%E9%AB%98%E6%9C%9F%E6%9C%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793711988000.webp","sourceId":"rfi"},{"id":1793711952000,"createdDate":"2026-11-03 13:19","name":"法国国际广播电台","title":"美国中期选举：民主党实现“蓝色浪潮”夺回国会控制权？","content":"备受瞩目的美国中期选举周二（11月3日）登场，选民将选出新一届国会众院全部议席，改选参议院部分席位，同时在多州选举州长。选举被视为对总统特朗普及其第二任期两年执政表现的一个集中检验，不仅关系到国会参、众两院的控制权，也将直接影响特朗普未来两年的施政空间，并为2028年美国总统大选提前拉开政治角逐的序幕。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261103-%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE-%E6%B0%91%E4%B8%BB%E5%85%9A%E5%AE%9E%E7%8E%B0-%E8%93%9D%E8%89%B2%E6%B5%AA%E6%BD%AE-%E5%A4%BA%E5%9B%9E%E5%9B%BD%E4%BC%9A%E6%8E%A7%E5%88%B6%E6%9D%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793711952000.webp","sourceId":"rfi"},{"id":1793708484000,"createdDate":"2026-11-03 12:21","name":"法国国际广播电台","title":"中国前央视主持人程万军在台湾跳机寻求人道庇护转送第三国","content":"据台湾多家媒体介绍，程万军是前中共官媒《央视》「法律讲堂」节目的主持人、曾任《法律与生活》杂志社主编，曾因「亡国之君」等言论获刑六年。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261103-%E4%B8%AD%E5%9B%BD%E5%89%8D%E5%A4%AE%E8%A7%86%E4%B8%BB%E6%8C%81%E4%BA%BA%E7%A8%8B%E4%B8%87%E5%86%9B%E5%9C%A8%E5%8F%B0%E6%B9%BE%E8%B7%B3%E6%9C%BA%E5%AF%BB%E6%B1%82%E4%BA%BA%E9%81%93%E5%BA%87%E6%8A%A4%E8%BD%AC%E9%80%81%E7%AC%AC%E4%B8%89%E5%9B%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793708484000.webp","sourceId":"rfi"},{"id":1793700407000,"createdDate":"2026-11-03 10:06","name":"法国国际广播电台","title":"中国是否会举办中美俄三方峰会，谈乌克兰战争？各方表态","content":"随着亚太经济合作组织峰会临近，外界关注美国总统特朗普、中国国家主席习近平和俄罗斯总统普京是否会在中国举行三方会谈，以及乌克兰问题是否会被列入相关议程。相关方就此做出不同表态。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E4%B8%AD%E5%9B%BD%E6%98%AF%E5%90%A6%E4%BC%9A%E4%B8%BE%E5%8A%9E%E4%B8%AD%E7%BE%8E%E4%BF%84%E4%B8%89%E6%96%B9%E5%B3%B0%E4%BC%9A%EF%BC%8C%E8%B0%88%E4%B9%8C%E5%85%8B%E5%85%B0%E6%88%98%E4%BA%89-%E5%90%84%E6%96%B9%E8%A1%A8%E6%80%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793700407000.webp","sourceId":"rfi"},{"id":1793696097000,"createdDate":"2026-11-03 08:54","name":"法国国际广播电台","title":"日本与台湾或最早于今年年底签署一项全面经贸协定","content":"据日本和台湾等多家媒体报道，《日本经济新闻》的英文媒体《NikkeiAsia》（日经亚洲）11月2日援引两名高官的消息报道称，日本政府正在与赖清德政权就缔结一项全面经济协定展开磋商。据悉，该协定预计将以英国与台湾于2023年签署的《贸易强化伙伴关系协定》（EnhancedTradePartnership，ETP）为蓝本，协定最快可能在今年年底签署。台湾外交部长林佳龙11月2日没有证实消息是否属实，但表示，乐观其成。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261103-%E6%97%A5%E6%9C%AC%E4%B8%8E%E5%8F%B0%E6%B9%BE%E6%88%96%E6%9C%80%E6%97%A9%E4%BA%8E%E4%BB%8A%E5%B9%B4%E5%B9%B4%E5%BA%95%E7%AD%BE%E7%BD%B2%E4%B8%80%E9%A1%B9%E5%85%A8%E9%9D%A2%E7%BB%8F%E8%B4%B8%E5%8D%8F%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793696097000.webp","sourceId":"rfi"},{"id":1793695406000,"createdDate":"2026-11-03 08:43","name":"法国国际广播电台","title":"另类大撒币？ 百年国际法律组织受资助落户香港 中港政府却称彰显香港成就","content":"具有百年历史的国际法律组织「国际统一私法协会」（UNIDROIT），在香港开设罗马总部以外的首个办公室。港府称，此举彰显香港作为国际法律枢纽的领导地位，京官形容，这是国际社会对香港的认可。但该会高层接受媒体访问时透露，会方是应港府邀请，并获得港府提供资金支持的情况下落户香港，该会更希望藉此吸纳更多东南亚国家成为会员。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261103-%E5%8F%A6%E7%B1%BB%E5%A4%A7%E6%92%92%E5%B8%81-%E7%99%BE%E5%B9%B4%E5%9B%BD%E9%99%85%E6%B3%95%E5%BE%8B%E7%BB%84%E7%BB%87%E5%8F%97%E8%B5%84%E5%8A%A9%E8%90%BD%E6%88%B7%E9%A6%99%E6%B8%AF-%E4%B8%AD%E6%B8%AF%E6%94%BF%E5%BA%9C%E5%8D%B4%E7%A7%B0%E5%BD%B0%E6%98%BE%E9%A6%99%E6%B8%AF%E6%88%90%E5%B0%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793695406000.webp","sourceId":"rfi"},{"id":1793694591000,"createdDate":"2026-11-03 08:29","name":"法国国际广播电台","title":"美国周一“防御性”空袭伊朗位于霍尔木兹海峡的格什姆岛","content":"据美国《华尔街日报》报道，美国军方周一晚间空袭了位于霍尔木兹海峡的伊朗格什姆岛。美国官员称，此次行动属于“防御性”打击，并不意味着将重启对伊朗的大规模军事行动。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E7%BE%8E%E5%9B%BD%E5%91%A8%E4%B8%80-%E9%98%B2%E5%BE%A1%E6%80%A7-%E7%A9%BA%E8%A2%AD%E4%BC%8A%E6%9C%97%E4%BD%8D%E4%BA%8E%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E7%9A%84%E6%A0%BC%E4%BB%80%E5%A7%86%E5%B2%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793694591000.webp","sourceId":"rfi"},{"id":1793694272000,"createdDate":"2026-11-03 08:24","name":"法国国际广播电台","title":"中港领导人习近平丶李家超连任「新闻自由掠夺者」　两欧洲领导人因败选而落榜","content":"无国界记者组织（RSF）今年的「新闻自由掠夺者」33人名单中，中国国家主席习近平和香港特首李家超继续名列榜上，前者被指以「安全打压」新闻自由，而後者则利用「法律打压」新闻工作者。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261103-%E4%B8%AD%E6%B8%AF%E9%A2%86%E5%AF%BC%E4%BA%BA%E4%B9%A0%E8%BF%91%E5%B9%B3%E4%B8%B6%E6%9D%8E%E5%AE%B6%E8%B6%85%E8%BF%9E%E4%BB%BB-%E6%96%B0%E9%97%BB%E8%87%AA%E7%94%B1%E6%8E%A0%E5%A4%BA%E8%80%85-%E4%B8%A4%E6%AC%A7%E6%B4%B2%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%9B%A0%E8%B4%A5%E9%80%89%E8%80%8C%E8%90%BD%E6%A6%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793694272000.webp","sourceId":"rfi"},{"id":1793733662000,"createdDate":"2026-11-03 19:21","name":"法国国际广播电台","title":"欧洲航空安全拉警报　多国航班接获炸弹威胁","content":"据美联社报道，欧洲多国今天接连发生航班炸弹威胁事件。波兰、意大利、西班牙、保加利亚等国多架客机收到炸弹恐吓，部分航班改降、延误，甚至由战机伴飞护航。不过，各国警方和安全部门检查后均未发现爆炸物，也没有人员伤亡。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261103-%E7%82%B8%E5%BC%B9%E5%A8%81%E8%83%81%E6%89%B0%E4%B9%B1%E6%AC%A7%E6%B4%B2%E8%88%AA%E7%A9%BA-%E5%A4%9A%E5%9B%BD%E5%90%AF%E5%8A%A8%E6%9C%80%E9%AB%98%E5%AE%89%E5%85%A8%E7%A8%8B%E5%BA%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793733662000.webp","sourceId":"rfi"},{"id":1793731799000,"createdDate":"2026-11-03 18:49","name":"法国国际广播电台","title":"美国期中选举有哪些看点？","content":"美国2026年期中选举登场，选民将决定民主党是否重掌众议院，以及检验特朗普施政成绩。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261103-%E7%BE%8E%E5%9B%BD%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E6%9C%89%E5%93%AA%E4%BA%9B%E7%9C%8B%E7%82%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793731799000.webp","sourceId":"rfi"},{"id":1793726306000,"createdDate":"2026-11-03 17:18","name":"法国国际广播电台","title":"中国大使馆称在巴布亚新几内亚码头发现的爆炸物是“酒瓶”，“不构成危险”","content":"据澳大利亚广播公司（ABC）11月3日独家披露，在巴布亚新几内亚一个商业集装箱内发现的一枚大型中国军用级爆炸物实为武器，尽管中国政府官员曾暗示该物体是一瓶葡萄酒。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E4%B8%AD%E5%9B%BD%E5%A4%A7%E4%BD%BF%E9%A6%86%E7%A7%B0%E5%9C%A8%E5%B7%B4%E5%B8%83%E4%BA%9A%E6%96%B0%E5%87%A0%E5%86%85%E4%BA%9A%E7%A0%81%E5%A4%B4%E5%8F%91%E7%8E%B0%E7%9A%84%E7%88%86%E7%82%B8%E7%89%A9%E6%98%AF-%E9%85%92%E7%93%B6-%EF%BC%8C-%E4%B8%8D%E6%9E%84%E6%88%90%E5%8D%B1%E9%99%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793726306000.webp","sourceId":"rfi"},{"id":1793723294000,"createdDate":"2026-11-03 16:28","name":"法国国际广播电台","title":"平壤否认对币安实施了创纪录黑客攻击 专家称63亿美元约占朝鲜GDP四分之一","content":"朝鲜周二驳斥美国联邦调查局（FBI）指控其策划盗取币安平台63亿美元的创纪录黑客攻击，并称，朝鲜“坚决反对”网络攻击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E5%B9%B3%E5%A3%A4%E5%90%A6%E8%AE%A4%E5%AF%B9%E5%B8%81%E5%AE%89%E5%AE%9E%E6%96%BD%E4%BA%86%E5%88%9B%E7%BA%AA%E5%BD%95%E9%BB%91%E5%AE%A2%E6%94%BB%E5%87%BB-%E4%B8%93%E5%AE%B6%E7%A7%B063%E4%BA%BF%E7%BE%8E%E5%85%83%E7%BA%A6%E5%8D%A0%E6%9C%9D%E9%B2%9Cgdp%E5%9B%9B%E5%88%86%E4%B9%8B%E4%B8%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793723294000.webp","sourceId":"rfi"},{"id":1793721877000,"createdDate":"2026-11-03 16:04","name":"法国国际广播电台","title":"美国中期选举：人工智能的大量使用，加剧选举信息混乱","content":"美国进入中期选举，选民投票，改选国会两院中的大部分席位，包括众议院和参议院。此外，全美国各地还将举行大量地方选举。这场选举不仅关系到美国国会的席位分布，更是成为虚假信息集中传播的一个重要节点。围绕选举产生的虚假信息正在社交媒体和人工智能平台上不断扩散。从选举作弊的指控、到针对候选人的虚假攻击，再到人工智能生成的真假难辨的竞选视频，以及聊天机器人提供的错误的投票信息…海量的线上内容正在影响选民投票的过程。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%A7%91%E6%8A%80%E6%97%B6%E7%A9%BA/20261103-%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE-%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%9A%84%E5%A4%A7%E9%87%8F%E4%BD%BF%E7%94%A8%EF%BC%8C%E5%8A%A0%E5%89%A7%E9%80%89%E4%B8%BE%E4%BF%A1%E6%81%AF%E6%B7%B7%E4%B9%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793721877000.webp","sourceId":"rfi"},{"id":1793720570000,"createdDate":"2026-11-03 15:42","name":"法国国际广播电台","title":"英伟达要求数据中心客户降低对中国业务比重","content":"金融时报3日消息：随着世界两大人工智能超级大国之间的竞争日趋激烈，英伟达正要求其数据中心合作伙伴减少对中国客户的业务，此举进一步限制了中国追赶美国竞争对手的能力。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%A6%81%E6%B1%82%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E5%AE%A2%E6%88%B7%E9%99%8D%E4%BD%8E%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%B8%9A%E5%8A%A1%E6%AF%94%E9%87%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793720570000.webp","sourceId":"rfi"},{"id":1793717501000,"createdDate":"2026-11-03 14:51","name":"法国国际广播电台","title":"专家评联合国生物多样性峰会的成果","content":"第十七届联合国生物多样性峰会（COP17）经过为期两周的紧张谈判终于于上周六在亚美尼亚首都埃里温闭幕。亚美尼亚环境部长汉巴尔祖姆·马特沃相周六晚间如释重负地宣布峰会通过了最终文本，埃里温终于避免了重蹈两年前卡利峰会功亏一篑的后尘而圆满结束。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261103-%E4%B8%93%E5%AE%B6%E8%AF%84%E8%81%94%E5%90%88%E5%9B%BD%E7%94%9F%E7%89%A9%E5%A4%9A%E6%A0%B7%E6%80%A7%E5%B3%B0%E4%BC%9A%E7%9A%84%E6%88%90%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793717501000.webp","sourceId":"rfi"},{"id":1793748778000,"createdDate":"2026-11-03 23:32","name":"法国国际广播电台","title":"中国首部全AI电影惨败，被指“完全没有情感”","content":"法国世界报近日刊出文章，报道中国首部全AI电影惨败。相关的文章写道，中国首部完全由人工智能（AI）制作的长片《三星堆：未来往事》，上映后遭遇惨败。10月27日，影片上映的第六天，上座率仅为0.3%。0.3%的上座率意味着，每放映10场，只有3名观众。那么，是什么原因导致如此的惨败呢？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261103-%E4%B8%AD%E5%9B%BD%E9%A6%96%E9%83%A8%E5%85%A8ai%E7%94%B5%E5%BD%B1%E6%83%A8%E8%B4%A5%EF%BC%8C%E8%A2%AB%E6%8C%87-%E5%AE%8C%E5%85%A8%E6%B2%A1%E6%9C%89%E6%83%85%E6%84%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793748778000.webp","sourceId":"rfi"},{"id":1793746057000,"createdDate":"2026-11-03 22:47","name":"法国国际广播电台","title":"欧洲各国政府正竞相加强海军力量， “欧洲海军防务展”在巴黎附近开幕","content":"周二，“欧洲海军防务展”在巴黎附近开幕，造船商、导弹制造商和无人机厂商纷纷展示各自的产品。与此同时，欧洲各国政府正竞相加强海军力量——它们一方面对美国作为防务盟友的可靠性产生怀疑，另一方面也对俄罗斯的侵略行径深感忧虑。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261103-%E6%B4%B2%E5%90%84%E5%9B%BD%E6%94%BF%E5%BA%9C%E6%AD%A3%E7%AB%9E%E7%9B%B8%E5%8A%A0%E5%BC%BA%E6%B5%B7%E5%86%9B%E5%8A%9B%E9%87%8F%EF%BC%8C-%E6%AC%A7%E6%B4%B2%E6%B5%B7%E5%86%9B%E9%98%B2%E5%8A%A1%E5%B1%95-%E5%9C%A8%E5%B7%B4%E9%BB%8E%E9%99%84%E8%BF%91%E5%BC%80%E5%B9%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793746057000.webp","sourceId":"rfi"},{"id":1793745785000,"createdDate":"2026-11-03 22:43","name":"法国国际广播电台","title":"十多个欧洲国家遭遇新一轮疑似网络攻击，超市冰柜是目标","content":"自周一以来，欧洲有十多个国家遭遇新一轮的针对超市冰柜的疑似网络攻击。周二，德国、罗马尼亚和英国也成为遭受疑似网络攻击的欧洲国家，此次攻击针对超市的冰箱和冷冻柜。三周前，法国也发生过类似的事件。这些事件再次暴露出欧洲食品供应链的脆弱性。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261103-%E5%8D%81%E5%A4%9A%E4%B8%AA%E6%AC%A7%E6%B4%B2%E5%9B%BD%E5%AE%B6%E9%81%AD%E9%81%87%E6%96%B0%E4%B8%80%E8%BD%AE%E7%96%91%E4%BC%BC%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB%EF%BC%8C%E8%B6%85%E5%B8%82%E5%86%B0%E6%9F%9C%E6%98%AF%E7%9B%AE%E6%A0%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793745785000.webp","sourceId":"rfi"},{"id":1793745670000,"createdDate":"2026-11-03 22:41","name":"法国国际广播电台","title":"选举后， 以色列 “变革阵营”的各领导人加快行动步伐让内塔尼亚胡下台","content":"以色列立法选举结束后，最终结果尚未尘埃落定，但“变革阵营”的领导人们已开始加快行动步伐。11月3日，四个政党的领导人举行了首次会晤，并达成共识：将以统一立场向总统推荐加迪·艾森科特（GadiEisenkot）。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261103-%E9%80%89%E4%B8%BE%E5%90%8E%EF%BC%8C-%E4%BB%A5%E8%89%B2%E5%88%97-%E5%8F%98%E9%9D%A9%E9%98%B5%E8%90%A5-%E7%9A%84%E5%90%84%E9%A2%86%E5%AF%BC%E4%BA%BA%E5%8A%A0%E5%BF%AB%E8%A1%8C%E5%8A%A8%E6%AD%A5%E4%BC%90%E8%AE%A9%E5%86%85%E5%A1%94%E5%B0%BC%E4%BA%9A%E8%83%A1%E4%B8%8B%E5%8F%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793745670000.webp","sourceId":"rfi"},{"id":1793745175000,"createdDate":"2026-11-03 22:32","name":"法国国际广播电台","title":"特朗普：将停止向以色列提供每年38亿美元的安全援助","content":"美国总统特朗普周二表示，他已与以色列总理内塔尼亚胡达成协议，将停止向以色列提供每年38亿美元的安全援助。特朗普说：“我们每年给以色列40亿美元，几个月前我们就达成了一项协议，要停止这项援助”。他在接受福克斯新闻（FoxNews）电话采访时说，以色列总理内塔尼亚胡“同意”这一决定。特朗普说：以色列是一个非常富裕的国家，他们不需要这些钱。如果以色列确实需要，我们还是会提供帮助的。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261103-%E7%89%B9%E6%9C%97%E6%99%AE-%E5%B0%86%E5%81%9C%E6%AD%A2%E5%90%91%E4%BB%A5%E8%89%B2%E5%88%97%E6%8F%90%E4%BE%9B%E6%AF%8F%E5%B9%B438%E4%BA%BF%E7%BE%8E%E5%85%83%E7%9A%84%E5%AE%89%E5%85%A8%E6%8F%B4%E5%8A%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793745175000.webp","sourceId":"rfi"},{"id":1793744824000,"createdDate":"2026-11-03 22:27","name":"法国国际广播电台","title":"美国民众周二参加中期选举，这次选举被看作是针对特朗普的全民公投","content":"美国民众于周二参加了中期选举。此次选举被视为一场针对特朗普的全民公投；如果共和党失利，他们将失去对国会的控制权，特朗普剩下的两年总统任期也将受到重大制约。民调预测，受选民对总统支持率低迷、能源价格飙升以及与伊朗持续冲突的不满情绪推动，美国民主党有望在众议院赢得多数席位，甚至可能夺取参议院的控制权。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261103-%E7%BE%8E%E5%9B%BD%E6%B0%91%E4%BC%97%E5%91%A8%E4%BA%8C%E5%8F%82%E5%8A%A0%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE-%E8%BF%99%E6%AC%A1%E9%80%89%E4%B8%BE%E8%A2%AB%E7%9C%8B%E4%BD%9C%E6%98%AF%E9%92%88%E5%AF%B9%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E5%85%A8%E6%B0%91%E5%85%AC%E6%8A%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/03/1793744824000.webp","sourceId":"rfi"}]