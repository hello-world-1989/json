[{"id":1793896598000,"createdDate":"2026-11-05 16:36","name":"法国国际广播电台","title":"特朗普中期选举政治挫败让中国短期获益，但长期受损？","content":"美国总统特朗普领导的共和党在中期选举中遭遇惨败，这或许会增强中国在与华盛顿的贸易谈判中的筹码。但北京方面未必会因这位美国总统的失利而感到高兴，毕竟他的继任者可能会更难打交道。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261105-%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E6%94%BF%E6%B2%BB%E6%8C%AB%E8%B4%A5%E8%AE%A9%E4%B8%AD%E5%9B%BD%E7%9F%AD%E6%9C%9F%E8%8E%B7%E7%9B%8A%EF%BC%8C%E4%BD%86%E9%95%BF%E6%9C%9F%E5%8F%97%E6%8D%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793896598000.webp","sourceId":"rfi"},{"id":1793896365000,"createdDate":"2026-11-05 16:32","name":"法国国际广播电台","title":"欧盟称对黄之锋在政治动机下被判刑10年表遗憾 英外交部促尊重《中英联合声明》","content":"正就初选47人案服刑的前香港众志秘书长黄之锋，去年6月在狱中被捕，被控2020年串谋勾结罗冠聪等危害国安。他今年9月认罪，周四在高等法院被判囚10年，当中两个月零两日与47人案刑期同期执行，即黄之锋被加监9年10个月。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261105-%E6%AC%A7%E7%9B%9F%E7%A7%B0%E5%AF%B9%E9%BB%84%E4%B9%8B%E9%94%8B%E5%9C%A8%E6%94%BF%E6%B2%BB%E5%8A%A8%E6%9C%BA%E4%B8%8B%E8%A2%AB%E5%88%A4%E5%88%9110%E5%B9%B4%E8%A1%A8%E9%81%97%E6%86%BE-%E8%8B%B1%E5%A4%96%E4%BA%A4%E9%83%A8%E4%BF%83%E5%B0%8A%E9%87%8D-%E4%B8%AD%E8%8B%B1%E8%81%94%E5%90%88%E5%A3%B0%E6%98%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793896365000.webp","sourceId":"rfi"},{"id":1793893794000,"createdDate":"2026-11-05 15:49","name":"法国国际广播电台","title":"德国总理默茨：欧洲必须储备关键原材料","content":"德国总理弗里德里希·默茨（FriedrichMerz）周四（11月5号）表示，欧洲必须增加关键原材料的储备，以减少对主导这些原材料开采和加工国家的依赖。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261105-%E5%BE%B7%E5%9B%BD%E6%80%BB%E7%90%86%E9%BB%98%E8%8C%A8-%E6%AC%A7%E6%B4%B2%E5%BF%85%E9%A1%BB%E5%82%A8%E5%A4%87%E5%85%B3%E9%94%AE%E5%8E%9F%E6%9D%90%E6%96%99","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793893794000.webp","sourceId":"rfi"},{"id":1793892697000,"createdDate":"2026-11-05 15:31","name":"法国国际广播电台","title":"法国呼吁欧盟针对快时尚征收更高税费","content":"法国呼吁欧盟效仿法国，对快时尚产品征收更高税费，以应对Shein、Temu等中国跨境电商平台带来的市场冲击。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261105-%E6%B3%95%E5%9B%BD%E5%91%BC%E5%90%81%E6%AC%A7%E7%9B%9F%E5%BE%81%E6%94%B6%E5%BF%AB%E6%97%B6%E5%B0%9A%E6%9B%B4%E9%AB%98%E7%A8%8E%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793892697000.webp","sourceId":"rfi"},{"id":1793891676000,"createdDate":"2026-11-05 15:14","name":"法国国际广播电台","title":"月之暗面已图通过欧洲数据中心寻求英伟达Blackwell算力","content":"据消费者新闻与商业频道（CNBC）报导，在白宫官员指控中国人工智能实验室月之暗面（MoonshotAI）通过东亚地区远程使用英伟达先进芯片后，月之暗面已试图通过位于欧洲的数据中心获取这些芯片的使用权。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261105-%E6%9C%88%E4%B9%8B%E6%9A%97%E9%9D%A2%E5%B7%B2%E5%9B%BE%E9%80%9A%E8%BF%87%E6%AC%A7%E6%B4%B2%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E5%AF%BB%E6%B1%82%E8%8B%B1%E4%BC%9F%E8%BE%BEblackwell%E7%AE%97%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793891676000.webp","sourceId":"rfi"},{"id":1793888802000,"createdDate":"2026-11-05 14:26","name":"法国国际广播电台","title":"黄之锋亲撰求情信认错判法律 强调政治参与非出于仇恨 盼出狱照顾年迈双亲","content":"中国着名异见份子刘晓波在狱中坚称「我没有敌人」而为人津津乐道，被重判入狱十年的前香港众志秘书长黄之锋亦在他亲笔撰写的求情信中表示，参与政治绝非出于仇恨，对中港政府亦没有怨恨，更不希望任何人因这宗案件而对司法机关或政府心生怨恨。他再次否认自己有收取外国资金，更从未倡导香港独立或鼓吹中国政权更迭。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261105-%E9%BB%84%E4%B9%8B%E9%94%8B%E4%BA%B2%E6%92%B0%E6%B1%82%E6%83%85%E4%BF%A1%E8%AE%A4%E9%94%99%E5%88%A4%E6%B3%95%E5%BE%8B-%E5%BC%BA%E8%B0%83%E6%94%BF%E6%B2%BB%E5%8F%82%E4%B8%8E%E9%9D%9E%E5%87%BA%E4%BA%8E%E4%BB%87%E6%81%A8-%E7%9B%BC%E5%87%BA%E7%8B%B1%E7%85%A7%E9%A1%BE%E5%B9%B4%E8%BF%88%E5%8F%8C%E4%BA%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793888802000.webp","sourceId":"rfi"},{"id":1793883285000,"createdDate":"2026-11-05 12:54","name":"法国国际广播电台","title":"软银以近54亿美元收购ABB机器人业务交易确认被中方阻止","content":"总部位于瑞士苏黎世的跨国工程技术集团ABB周四表示，中国国家规划部门已告知日本投资者软银集团，不会批准其以近54亿美元收购ABB旗下机器人业务的交易。","newsLink":"https://www.rfi.fr/cn/%E7%BB%8F%E8%B4%B8/20261105-%E8%BD%AF%E9%93%B6%E4%BB%A554%E4%BA%BF%E7%BE%8E%E5%85%83%E6%94%B6%E8%B4%ADabb%E6%9C%BA%E5%99%A8%E4%BA%BA%E4%B8%9A%E5%8A%A1%E4%BA%A4%E6%98%93%E7%A1%AE%E8%AE%A4%E8%A2%AB%E4%B8%AD%E6%96%B9%E9%98%BB%E6%AD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793883285000.webp","sourceId":"rfi"},{"id":1793882057000,"createdDate":"2026-11-05 12:34","name":"法国国际广播电台","title":"法国社会不满进一步合流：工会、新老黄背心、学生、公私营等领域今日罢工示威","content":"法国社会抗议活动持续发酵。11月5日星期四，法国多个工会组织联合发起全国性罢工和示威，其主要诉求包括提振工资、立即启动工资谈判、增加对公共服务的投入、维护就业和工业发展，通过对大额财富征税，实现税收公平等。本次罢工和示威不仅涉及公共部门，也扩大至私营领域，预计在交通、教育、医疗、能源等多个领域在全国范围内造成一定程度的冲击。随着工会加入全国性动员，原本分散的社会不满正在通过更广泛的集体行动出现集中表达的趋势。截至午间，法国总工会称，至少73个城市有超过25万人开始示威。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261105-%E6%B3%95%E5%9B%BD%E7%A4%BE%E4%BC%9A%E4%B8%8D%E6%BB%A1%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%90%88%E6%B5%81-%E5%B7%A5%E4%BC%9A-%E6%96%B0%E8%80%81%E9%BB%84%E8%83%8C%E5%BF%83-%E5%AD%A6%E7%94%9F-%E5%85%AC%E7%A7%81%E8%90%A5%E7%AD%89%E9%A2%86%E5%9F%9F%E4%BB%8A%E6%97%A5%E7%BD%A2%E5%B7%A5%E7%A4%BA%E5%A8%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793882057000.webp","sourceId":"rfi"},{"id":1793881337000,"createdDate":"2026-11-05 12:22","name":"法国国际广播电台","title":"北京未批准大规模进口 约60万枚英伟达H200芯片被指滞留香港","content":"据路透社援引两位知情人士报导称，约有60万枚英伟达先进人工智能芯片目前存放在香港，等待运往中国内地。尽管中国科技企业有相关需求，但北京方面尚未批准这些芯片的大规模进口。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261105-%E5%8C%97%E4%BA%AC%E6%9C%AA%E6%89%B9%E5%87%86%E5%A4%A7%E8%A7%84%E6%A8%A1%E8%BF%9B%E5%8F%A3-%E7%BA%A6%E6%9C%8960%E4%B8%87%E6%9E%9A%E8%8B%B1%E4%BC%9F%E8%BE%BEh200%E8%8A%AF%E7%89%87%E8%A2%AB%E6%8C%87%E6%BB%9E%E7%95%99%E9%A6%99%E6%B8%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793881337000.webp","sourceId":"rfi"},{"id":1793879304000,"createdDate":"2026-11-05 11:48","name":"法国国际广播电台","title":"中使馆称“炮弹造型酒瓶” 巴新警方确认查获炮弹属军用弹药","content":"巴布亚新几内亚当局证实，警方在该国首都查获的一枚炮弹，实为130毫米口径的军用弹药。巴布亚新几内亚皇家警察专员曼宁（DavidManning）于周四公布了这一消息。上周，在一只集装箱内发现该枚炮弹后，巴新警方拘留了四名中国籍男子。中国驻巴布亚新几内亚大使馆周二对该物品的真实性提出质疑，并在社媒上宣称，该物品实际上是一个“炮弹造型的酒瓶，完全不构成任何危险”。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261105-%E4%B8%AD%E4%BD%BF%E9%A6%86%E7%A7%B0-%E7%82%AE%E5%BC%B9%E9%80%A0%E5%9E%8B%E9%85%92%E7%93%B6-%E5%B7%B4%E6%96%B0%E8%AD%A6%E6%96%B9%E7%A1%AE%E8%AE%A4%E6%9F%A5%E8%8E%B7%E7%82%AE%E5%BC%B9%E5%B1%9E%E5%86%9B%E7%94%A8%E5%BC%B9%E8%8D%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793879304000.webp","sourceId":"rfi"},{"id":1793876513000,"createdDate":"2026-11-05 11:01","name":"法国国际广播电台","title":"《海啸》之后：法国媒体解读美国中期选举与特朗普的新困局","content":"法国主流媒体周四几乎都将焦点放在美国中期选举。共和党不仅失去了众议院，也丢掉了参议院，特朗普未来两年的执政将不得不面对一个由民主党控制的国会。法国《解放报》（Libération）、《回声报》（LesÉchos）和《费加罗报》（LeFigaro）虽然政治立场各不相同，但都认为，这次选举是特朗普第二任期以来遭遇的第一次重大政治挫败，也意味着美国政治进入新的权力制衡阶段。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261105-%E6%B5%B7%E5%95%B8-%E4%B9%8B%E5%90%8E-%E6%B3%95%E5%9B%BD%E5%AA%92%E4%BD%93%E8%A7%A3%E8%AF%BB%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E4%B8%8E%E7%89%B9%E6%9C%97%E6%99%AE%E7%9A%84%E6%96%B0%E5%9B%B0%E5%B1%80","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793876513000.webp","sourceId":"rfi"},{"id":1793876409000,"createdDate":"2026-11-05 11:00","name":"法国国际广播电台","title":"美共和党中期选举大败 日本担心特朗普与中俄朝急遽接近","content":"日本政府对美国执政党共和党在中期选举中大败表示警惕，担心这将对亚洲外交产生不利影响，政府人士认为:由在野党民主党主导的国会将使特朗普政府难以在内政方面取得成果，好大喜功的特朗普可能会在总统可以最大程度发挥其权限的外交方面胡来，因此正密切关注特朗普将在外交领域提出什么新方针。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261105-%E7%BE%8E%E5%85%B1%E5%92%8C%E5%85%9A%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E5%A4%A7%E8%B4%A5-%E6%97%A5%E6%9C%AC%E6%8B%85%E5%BF%83%E7%89%B9%E6%9C%97%E6%99%AE%E4%B8%8E%E4%B8%AD%E4%BF%84%E6%9C%9D%E6%80%A5%E9%81%BD%E6%8E%A5%E8%BF%91","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793876409000.webp","sourceId":"rfi"},{"id":1793874847000,"createdDate":"2026-11-05 10:34","name":"法国国际广播电台","title":"韩国拟在霍尔木兹海峡附近开展行动，称此举不意味着卷入美伊战争","content":"韩国国防部11月5日表示，韩国计划将其反海盗部队的行动范围扩大至距离霍尔木兹海峡更近的海域。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261105-%E9%9F%A9%E5%9B%BD%E6%8B%9F%E5%9C%A8%E9%9C%8D%E5%B0%94%E6%9C%A8%E5%85%B9%E6%B5%B7%E5%B3%A1%E9%99%84%E8%BF%91%E5%BC%80%E5%B1%95%E8%A1%8C%E5%8A%A8%EF%BC%8C%E7%A7%B0%E6%AD%A4%E4%B8%BE%E4%B8%8D%E6%84%8F%E5%91%B3%E7%9D%80%E5%8D%B7%E5%85%A5%E7%BE%8E%E4%BC%8A%E6%88%98%E4%BA%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793874847000.webp","sourceId":"rfi"},{"id":1793873817000,"createdDate":"2026-11-05 10:16","name":"法国国际广播电台","title":"印度多家金融机构遭人工智能驱动攻击 至少两款工具与中国有关","content":"印度网络安全机构公布了一系列针对金融机构的人工智能驱动型攻击背后的黑客组织名称，并识别出其使用的工具，其中至少有两款与中国有关。这使得印度被列入越来越多遭受此类工具攻击的国家名单。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261105-%E5%8D%B0%E5%BA%A6%E5%A4%9A%E5%AE%B6%E9%87%91%E8%9E%8D%E6%9C%BA%E6%9E%84%E9%81%AD%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E9%A9%B1%E5%8A%A8%E6%94%BB%E5%87%BB-%E8%87%B3%E5%B0%91%E4%B8%A4%E6%AC%BE%E5%B7%A5%E5%85%B7%E4%B8%8E%E4%B8%AD%E5%9B%BD%E6%9C%89%E5%85%B3","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793873817000.webp","sourceId":"rfi"},{"id":1793870958000,"createdDate":"2026-11-05 09:29","name":"法国国际广播电台","title":"特朗普跛脚 密切跟踪全球政经变化","content":"美国中期选举在全球引发舆论关注热潮。一时间关于关税、货币汇率、资本流通、伊朗战争，包括美国对华战略等话题甚嚣尘上。一致的担忧指向了美国后中期选举时代，华盛顿政坛变局将如何震荡全球政治与经济格局？","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%9B%BC%E8%B0%B7%E4%B8%93%E6%A0%8F/20261105-%E7%89%B9%E6%9C%97%E6%99%AE%E8%B7%9B%E8%84%9A-%E5%AF%86%E5%88%87%E8%B7%9F%E8%B8%AA%E5%85%A8%E7%90%83%E6%94%BF%E7%BB%8F%E5%8F%98%E5%8C%96","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793870958000.webp","sourceId":"rfi"},{"id":1793870806000,"createdDate":"2026-11-05 09:26","name":"法国国际广播电台","title":"澳门首宗国安案 前立法会议员区锦新涉颠覆政权等罪周五宣判","content":"澳门初级法院周四发布新闻稿称，嫌犯区锦新被控触犯“颠覆国家政权罪”、“与澳门特别行政区以外的组织、团体或个人建立联系作出危害国家安全的行为罪”及“违反保密罪”的首宗国安案件早前已完成庭审，该案定于明日（11月6日）上午十时进行公开宣判。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261105-%E6%BE%B3%E9%97%A8%E9%A6%96%E5%AE%97%E5%9B%BD%E5%AE%89%E6%A1%88-%E5%89%8D%E7%AB%8B%E6%B3%95%E4%BC%9A%E8%AE%AE%E5%91%98%E5%8C%BA%E9%94%A6%E6%96%B0%E6%B6%89%E9%A2%A0%E8%A6%86%E6%94%BF%E6%9D%83%E7%AD%89%E7%BD%AA%E5%91%A8%E4%BA%94%E5%AE%A3%E5%88%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793870806000.webp","sourceId":"rfi"},{"id":1793870702000,"createdDate":"2026-11-05 09:25","name":"法国国际广播电台","title":"加拿大宣布中国副总理何立峰下周访加　料推动经贸合作落地","content":"加拿大政府周三宣布，中国国务院副总理何立峰将于11月8至9日访问加拿大。他是加中关系解冻以来，最高层级访加的经贸官员。相信会讨论如何落实一连串加中贸易与经济合作。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261105-%E5%8A%A0%E6%8B%BF%E5%A4%A7%E5%AE%A3%E5%B8%83%E4%B8%AD%E5%9B%BD%E5%89%AF%E6%80%BB%E7%90%86%E4%BD%95%E7%AB%8B%E5%B3%B0%E4%B8%8B%E5%91%A8%E8%AE%BF%E5%8A%A0-%E6%96%99%E6%8E%A8%E5%8A%A8%E7%BB%8F%E8%B4%B8%E5%90%88%E4%BD%9C%E8%90%BD%E5%9C%B0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793870702000.webp","sourceId":"rfi"},{"id":1793868865000,"createdDate":"2026-11-05 08:54","name":"法国国际广播电台","title":"马兴瑞涉嫌受贿案提起公诉 被指以职权为他人谋利等","content":"据官媒报导，中共中央政治局原委员、中央农村工作领导小组原副组长马兴瑞涉嫌受贿案，由国家监察委员会调查终结，移送检察机关审查起诉。中国最高人民检察院依法以涉嫌受贿罪对马兴瑞作出逮捕决定，并指定由湖北省宜昌市人民检察院审查起诉。近日，宜昌市人民检察院已向宜昌市中级人民法院提起公诉。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261105-%E9%A9%AC%E5%85%B4%E7%91%9E%E6%B6%89%E5%AB%8C%E5%8F%97%E8%B4%BF%E6%A1%88%E6%8F%90%E8%B5%B7%E5%85%AC%E8%AF%89-%E8%A2%AB%E6%8C%87%E4%BB%A5%E8%81%8C%E6%9D%83%E4%B8%BA%E4%BB%96%E4%BA%BA%E8%B0%8B%E5%88%A9%E7%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793868865000.webp","sourceId":"rfi"},{"id":1793868081000,"createdDate":"2026-11-05 08:41","name":"法国国际广播电台","title":"黄之锋闻判刑皱眉  两人权组织责港府手法残酷 感愤慨","content":"曾是香港年轻社运人士领军人物的黄之锋，因被控《港区国安法》勾结外国势力罪而被判刑十年，他闻判时皱眉，现时未知他会否上诉。国际特赦组织和香港人权资讯中心均指责港府在黄之锋即将出狱前将他定罪，手法残酷，有意将他无了期监禁；两个组织再次呼吁释放黄之锋，并呼吁各国继续施压，促使港府释放仅因行使人权而被囚禁的人。","newsLink":"https://www.rfi.fr/cn/%E4%BA%BA%E6%9D%83/20261105-%E9%BB%84%E4%B9%8B%E9%94%8B%E9%97%BB%E5%88%A4%E5%88%91%E7%9A%B1%E7%9C%89-%E4%B8%A4%E4%BA%BA%E6%9D%83%E7%BB%84%E7%BB%87%E8%B4%A3%E6%B8%AF%E5%BA%9C%E6%89%8B%E6%B3%95%E6%AE%8B%E9%85%B7-%E6%84%9F%E6%84%A4%E6%85%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793868081000.webp","sourceId":"rfi"},{"id":1793867693000,"createdDate":"2026-11-05 08:34","name":"法国国际广播电台","title":"黄之锋被控串谋勾结外国势力 法官裁定属「罪行重大」 重判10年料服刑至40岁","content":"正在服刑的前香港众志秘书长黄之锋，在狱中被港府加控「串谋勾结外国势力」罪。国安法指定法官指，黄之锋和罗冠聪是案中主脑，二人在国家安全的关键时期合谋勾结外国势力，要求实施制裁，并曾促成外国实施制裁和不利措施，增加中港政府的困难，并在《港区国安法》在港实施后，继续「国际战线」，被裁定属「罪行重大」，重判黄之锋监禁10年，预料他要服刑至2036年11月才可获释。","newsLink":"https://www.rfi.fr/cn/%E4%BA%BA%E6%9D%83/20261105-%E9%BB%84%E4%B9%8B%E9%94%8B%E8%A2%AB%E6%8E%A7%E4%B8%B2%E8%B0%8B%E5%8B%BE%E7%BB%93%E5%A4%96%E5%9B%BD%E5%8A%BF%E5%8A%9B-%E6%B3%95%E5%AE%98%E8%A3%81%E5%AE%9A%E5%B1%9E-%E7%BD%AA%E8%A1%8C%E9%87%8D%E5%A4%A7-%E9%87%8D%E5%88%A410%E5%B9%B4%E6%96%99%E6%9C%8D%E5%88%91%E8%87%B340%E5%B2%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/05/1793867693000.webp","sourceId":"rfi"}]