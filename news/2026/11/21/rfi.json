[{"id":1795275493000,"createdDate":"2026-11-21 15:38","name":"法国国际广播电台","title":"伊朗外长：俄罗斯和中国都反对伊朗改变核政策","content":"根据伊朗官方报纸《伊朗日报》周六（11月21日）刊登的专访，阿拉格齐表示，是否调整核政策是一个“广泛而严肃”的问题，并且“既有支持者，也有反对者”。他说，与伊朗签有战略合作协议的俄罗斯和中国都“反对”改变伊朗的核政策。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF-%E4%BF%84%E7%BD%97%E6%96%AF%E5%92%8C%E4%B8%AD%E5%9B%BD%E9%83%BD%E5%8F%8D%E5%AF%B9%E4%BC%8A%E6%9C%97%E6%94%B9%E5%8F%98%E6%A0%B8%E6%94%BF%E7%AD%96","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795275493000.webp","sourceId":"rfi"},{"id":1795274149000,"createdDate":"2026-11-21 15:15","name":"法国国际广播电台","title":"《解放报》：中国在国际气候谈判中为何如此低调？","content":"近期，每周六成为法国以及其它欧洲国家民间抗议活动日。21日出版的法共《人道报》以此作为头版头条，以大版篇幅介绍本周末欧洲七个国家工会组织以及民间团体发起的抗议集会活动，认为这些活动的共同之处是对生活成本太高、政府财政紧缩措施的不满。《解放报》重点关注法国各路政治力量备战明年总统大选的动向。今天聚焦右翼阵营不断加长的可能的候选人名单。《费加罗报》则特别聚焦英国在退出欧洲联盟十年之后，正试图重新拉近与欧盟关系的努力。各报在国际版关注的话题还有俄乌战争近况以及可能以乌克兰加入北大西洋公约组织为基础的停战谈判、国际法院认为缅甸政府对罗兴亚人犯有种族灭绝罪行的裁决、即将启动的西班牙立法选举以及住房危机在该国引发的社会紧张关系，等等。关于中国，我们借本次节目时间，向大家介绍财经报刊《回声报》网站一篇关于刚刚在深圳举行的中美俄三方峰会的评论文章，以及《解放报》一篇关于中国在气候议题国际谈判中的表现的文章。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E6%8A%A5%E7%BA%B8%E6%91%98%E8%A6%81/20261121-%E8%A7%A3%E6%94%BE%E6%8A%A5-%E4%B8%AD%E5%9B%BD%E5%9C%A8%E5%9B%BD%E9%99%85%E6%B0%94%E5%80%99%E8%B0%88%E5%88%A4%E4%B8%AD%E4%B8%BA%E4%BD%95%E5%A6%82%E6%AD%A4%E4%BD%8E%E8%B0%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795274149000.webp","sourceId":"rfi"},{"id":1795273411000,"createdDate":"2026-11-21 15:03","name":"法国国际广播电台","title":"欧洲希望效仿美国收购TikTok， 德国称已有投资者愿出资250亿欧元","content":"继美国之后，欧洲很可能也会要求TikTok与其中国母公司断绝关系。据POLITICO报导，德国文化部长沃尔夫拉姆·魏默（WolframWeimer）周五(11月20日)表示，德国政府已经找到有意投资高达250亿欧元的投资者，希望收购TikTok欧洲业务的大部分股权。他补充说，TikTok欧洲应当开放出售75%至80%的股份。德国和奥地利本周联合提出一项提案，建议将该社交网络的欧洲业务置于当地投资者的控制之下。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E6%AC%A7%E6%B4%B2%E5%B8%8C%E6%9C%9B%E6%95%88%E4%BB%BF%E7%BE%8E%E5%9B%BD%E6%94%B6%E8%B4%ADtiktok%EF%BC%8C-%E5%BE%B7%E5%9B%BD%E7%A7%B0%E5%B7%B2%E6%9C%89%E6%8A%95%E8%B5%84%E8%80%85%E6%84%BF%E5%87%BA%E8%B5%84250%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795273411000.webp","sourceId":"rfi"},{"id":1795270025000,"createdDate":"2026-11-21 14:07","name":"法国国际广播电台","title":"Cop 31 : 对比中西专家对走出化石能源以及电气化目标的看法","content":"正在土耳其召开的联合国第31届气候峰会进入最后的拉锯战，各方分歧集中电气化目标，走出化石能源以及是否将碳捕捉等技术纳入最终文本的问题，如果说中国与西方在遵守巴黎协定等问题上方向一致的话，欧洲国家对走出化石能源路线图的呼吁似乎并没有受到中国的相应，同样，欧洲原先提出的电气化的电力必须来自清洁能源的要求也并没有赢得中国方面的支持，其中原因，除了不排除地缘政治方面的影响之外，或许还归结于中西方对如何务实的行动问题上的认知差异。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E4%BF%9D%E5%A4%A9%E5%9C%B0/20261121-cop-31-%E5%AF%B9%E6%AF%94%E4%B8%AD%E8%A5%BF%E4%B8%93%E5%AE%B6%E5%AF%B9%E8%B5%B0%E5%87%BA%E5%8C%96%E7%9F%B3%E8%83%BD%E6%BA%90%E4%BB%A5%E5%8F%8A%E7%94%B5%E6%B0%94%E5%8C%96%E7%9B%AE%E6%A0%87%E7%9A%84%E7%9C%8B%E6%B3%95","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795270025000.webp","sourceId":"rfi"},{"id":1795269862000,"createdDate":"2026-11-21 14:04","name":"法国国际广播电台","title":"路透分析：习近平借峰会巩固国际地位，特朗普获礼遇但无实质成果","content":"路透社周六（11月21日）发布一篇深度报道称，分析人士表示，美国总统特朗普将本周中国方面对他高规格的接待礼遇视为一种胜利，但今年举行的三次这样的峰会都没能给他带来多少实际收获。习近平则在这次APEC峰会后，以一名能够促成首次中美俄三国峰会的政治家形象亮相。他还使美中之间脆弱的贸易休战维持在一种悬而未决的状态，而这正是北京所乐见的，即便华盛顿正采取更加强硬的立场。至少从公开宣布的成果来看，特朗普几乎没有多少具体成绩可以展示。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261121-%E8%B7%AF%E9%80%8F%E5%88%86%E6%9E%90-%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%80%9F%E5%B3%B0%E4%BC%9A%E5%B7%A9%E5%9B%BA%E5%9B%BD%E9%99%85%E5%9C%B0%E4%BD%8D%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E8%8E%B7%E7%A4%BC%E9%81%87%E4%BD%86%E6%97%A0%E5%AE%9E%E8%B4%A8%E6%88%90%E6%9E%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795269862000.webp","sourceId":"rfi"},{"id":1795260564000,"createdDate":"2026-11-21 11:29","name":"法国国际广播电台","title":"联合国将在未来两年讨论制定杀手机器人管控机制","content":"联合国成员国围绕致命性自主武器系统管控议题的讨论艰难推进数日之后，终于在21日达成一项妥协，同意继续讨论，并在未来两年内，就致命性自主武器系统的研发制定出新的规则。持续关注此议题的非政府组织对这项妥协深感失望。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261121-%E8%81%94%E5%90%88%E5%9B%BD%E5%B0%86%E5%9C%A8%E6%9C%AA%E6%9D%A5%E4%B8%A4%E5%B9%B4%E8%AE%A8%E8%AE%BA%E5%88%B6%E5%AE%9A%E6%9D%80%E6%89%8B%E6%9C%BA%E5%99%A8%E4%BA%BA%E7%AE%A1%E6%8E%A7%E6%9C%BA%E5%88%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795260564000.webp","sourceId":"rfi"},{"id":1795259212000,"createdDate":"2026-11-21 11:06","name":"法国国际广播电台","title":"日本外相谈中美俄三国首脑会谈 不认为中国是亚洲的霸权国家","content":"日本外务大臣茂木敏充在20日的记者会上，在回答记者有关中美俄首脑会谈的提问时表示：我并不认为中国已经成为亚洲的地区霸权国家。此外，从国际形势及其影响等角度出发，日本一直密切关注美、中、俄三国之间的各种关系，今后也将继续跟踪事态发展。在谈及日中关系时他表示：中国是日本的重要邻国。正因为日中之间存在悬而未决的问题和各种课题，才更有必要开展对话、加强沟通。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261121-%E6%97%A5%E6%9C%AC%E5%A4%96%E7%9B%B8%E8%B0%88%E4%B8%AD%E7%BE%8E%E4%BF%84%E4%B8%89%E5%9B%BD%E9%A6%96%E8%84%91%E4%BC%9A%E8%B0%88-%E4%B8%8D%E8%AE%A4%E4%B8%BA%E4%B8%AD%E5%9B%BD%E6%98%AF%E4%BA%9A%E6%B4%B2%E7%9A%84%E9%9C%B8%E6%9D%83%E5%9B%BD%E5%AE%B6","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795259212000.webp","sourceId":"rfi"},{"id":1795258426000,"createdDate":"2026-11-21 10:53","name":"法国国际广播电台","title":"皮克敏手游「中国台湾」争议与个资疑虑 引发台湾玩家退坑潮","content":"知名手游皮克敏《PikminBloom》在台湾掀起一股散步种花、打菇风潮的旋风。但日前因其官方简体中文公告将台湾矮化为「中国台湾」，以及游戏需要使用GPS定位，引发个资隐私疑虑，遭到台湾玩家抵制。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261121-%E7%9A%AE%E5%85%8B%E6%95%8F%E6%89%8B%E6%B8%B8-%E4%B8%AD%E5%9B%BD%E5%8F%B0%E6%B9%BE-%E4%BA%89%E8%AE%AE%E4%B8%8E%E4%B8%AA%E8%B5%84%E7%96%91%E8%99%91-%E5%BC%95%E5%8F%91%E5%8F%B0%E6%B9%BE%E7%8E%A9%E5%AE%B6%E9%80%80%E5%9D%91%E6%BD%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795258426000.webp","sourceId":"rfi"},{"id":1795255019000,"createdDate":"2026-11-21 09:56","name":"法国国际广播电台","title":"法国民众连续第六个周六抗议示威，议会通过新法案将执法人员使用枪支推定为“依法行事”","content":"目前，已经是连续第六个周六，法国工会、青年组织以及“黄背心”运动呼吁民众走上街头，抗议生活成本高企。起源于燃油价格上涨抗议的黄背心运动，今年秋天以新的形式重新活跃，本周末恰逢该运动诞生八周年。值得注意的是，法国议会周五（11月20日）晚最终通过一项法案，确立警方和宪兵使用武器时享有“合法使用武器推定”原则。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E6%B3%95%E5%9B%BD%E6%B0%91%E4%BC%97%E8%BF%9E%E7%BB%AD%E7%AC%AC%E5%85%AD%E4%B8%AA%E5%91%A8%E5%85%AD%E6%8A%97%E8%AE%AE%E7%A4%BA%E5%A8%81%EF%BC%8C%E8%AE%AE%E4%BC%9A%E9%80%9A%E8%BF%87%E6%96%B0%E6%B3%95%E6%A1%88%E5%B0%86%E6%89%A7%E6%B3%95%E4%BA%BA%E5%91%98%E4%BD%BF%E7%94%A8%E6%9E%AA%E6%94%AF%E6%8E%A8%E5%AE%9A%E4%B8%BA-%E4%BE%9D%E6%B3%95%E8%A1%8C%E4%BA%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795255019000.webp","sourceId":"rfi"},{"id":1795254295000,"createdDate":"2026-11-21 09:44","name":"法国国际广播电台","title":"特朗普称与普京就乌克兰问题进行了良好会谈，但不愿讨论向乌提供安全保障","content":"美国总统特朗普周五（11月20日）表示，他本周在中国与俄罗斯总统普京就乌克兰问题进行了“非常好的会谈”，但强调在达成更广泛和平协议之前，他不愿讨论向乌克兰提供安全保障的问题。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E4%B8%8E%E6%99%AE%E4%BA%AC%E5%B0%B1%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98%E8%BF%9B%E8%A1%8C%E4%BA%86%E8%89%AF%E5%A5%BD%E4%BC%9A%E8%B0%88%EF%BC%8C%E4%BD%86%E4%B8%8D%E6%84%BF%E8%AE%A8%E8%AE%BA%E5%90%91%E4%B9%8C%E6%8F%90%E4%BE%9B%E5%AE%89%E5%85%A8%E4%BF%9D%E9%9A%9C%E9%97%AE%E9%A2%98","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795254295000.webp","sourceId":"rfi"},{"id":1795253821000,"createdDate":"2026-11-21 09:37","name":"法国国际广播电台","title":"为进一步防止中国间接获取芯片，特朗普称将对在海外建设数据中心的美国企业实施惩罚措施","content":"美国总统特朗普周五（11月20日）表示，美国将对在海外建设数据中心的美国企业实施惩罚性措施。他称，这是为了帮助美国人工智能产业与中国竞争对手展开竞争。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E4%B8%BA%E8%BF%9B%E4%B8%80%E6%AD%A5%E9%98%B2%E6%AD%A2%E4%B8%AD%E5%9B%BD%E9%97%B4%E6%8E%A5%E8%8E%B7%E5%8F%96%E8%8A%AF%E7%89%87%EF%BC%8C%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E5%B0%86%E5%AF%B9%E5%9C%A8%E6%B5%B7%E5%A4%96%E5%BB%BA%E8%AE%BE%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E7%9A%84%E7%BE%8E%E5%9B%BD%E4%BC%81%E4%B8%9A%E5%AE%9E%E6%96%BD%E6%83%A9%E7%BD%9A%E6%8E%AA%E6%96%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795253821000.webp","sourceId":"rfi"},{"id":1795253178000,"createdDate":"2026-11-21 09:26","name":"法国国际广播电台","title":"美国证监会调查英伟达可能存在的会计问题，法律风险进一步升级","content":"据两名知情人士透露，美国证券交易委员会（SEC）正在调查英伟达（Nvidia）的会计处理做法，这使这家深陷丑闻的芯片巨头面临的法律压力进一步加大。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E7%BE%8E%E5%9B%BD%E8%AF%81%E7%9B%91%E4%BC%9A%E8%B0%83%E6%9F%A5%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%8F%AF%E8%83%BD%E5%AD%98%E5%9C%A8%E7%9A%84%E4%BC%9A%E8%AE%A1%E9%97%AE%E9%A2%98%EF%BC%8C%E6%B3%95%E5%BE%8B%E9%A3%8E%E9%99%A9%E8%BF%9B%E4%B8%80%E6%AD%A5%E5%8D%87%E7%BA%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795253178000.webp","sourceId":"rfi"},{"id":1795252516000,"createdDate":"2026-11-21 09:15","name":"法国国际广播电台","title":"金正恩无视特朗普释放的会晤信号，频频在朝鲜媒体亮相开展视察活动","content":"据朝中社周六（11月21日）报导，朝鲜最高领导人金正恩近日视察了学校设施和教育器材生产工厂。本周四，中国刚刚举行了APEC峰会，美国总统特朗普原本希望借机与其会面，但未能如愿。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E9%87%91%E6%AD%A3%E6%81%A9%E6%97%A0%E8%A7%86%E7%89%B9%E6%9C%97%E6%99%AE%E9%87%8A%E6%94%BE%E7%9A%84%E4%BC%9A%E6%99%A4%E4%BF%A1%E5%8F%B7%EF%BC%8C%E9%A2%91%E9%A2%91%E5%9C%A8%E6%9C%9D%E9%B2%9C%E5%AA%92%E4%BD%93%E4%BA%AE%E7%9B%B8%E5%BC%80%E5%B1%95%E8%A7%86%E5%AF%9F%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795252516000.webp","sourceId":"rfi"},{"id":1795251948000,"createdDate":"2026-11-21 09:05","name":"法国国际广播电台","title":"特朗普呼吁英伟达给予黄仁勋“第二次机会”","content":"美国总统特朗普周五（11月20日）呼吁英伟达给予黄仁勋“第二次机会”。黄仁勋此前因婚外情丑闻辞职，而公司董事会目前并无让他重回企业的计划。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261121-%E7%89%B9%E6%9C%97%E6%99%AE%E5%91%BC%E5%90%81%E8%8B%B1%E4%BC%9F%E8%BE%BE%E7%BB%99%E4%BA%88%E9%BB%84%E4%BB%81%E5%8B%8B-%E7%AC%AC%E4%BA%8C%E6%AC%A1%E6%9C%BA%E4%BC%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795251948000.webp","sourceId":"rfi"},{"id":1795303130000,"createdDate":"2026-11-21 23:18","name":"法国国际广播电台","title":"欧盟与印度尼西亚的贸易协议：让欧盟GDP高出160亿欧元， 印度尼西亚GDP高270亿欧元","content":"欧盟与印度尼西亚周六在布鲁塞尔正式签署了一项贸易协议，旨在开放双方市场。因为有了这份协议，预计到2042年，欧盟GDP高出160亿欧元，印度尼西亚GDP高270亿欧元。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261121-%E6%AC%A7%E7%9B%9F%E4%B8%8E%E5%8D%B0%E5%BA%A6%E5%B0%BC%E8%A5%BF%E4%BA%9A%E7%9A%84%E8%B4%B8%E6%98%93%E5%8D%8F%E8%AE%AE-%E8%AE%A9%E6%AC%A7%E7%9B%9Fgdp%E9%AB%98%E5%87%BA160%E4%BA%BF%E6%AC%A7%E5%85%83%EF%BC%8C-%E5%8D%B0%E5%BA%A6%E5%B0%BC%E8%A5%BF%E4%BA%9Agdp%E9%AB%98270%E4%BA%BF%E6%AC%A7%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795303130000.webp","sourceId":"rfi"},{"id":1795302859000,"createdDate":"2026-11-21 23:14","name":"法国国际广播电台","title":"德维尔潘竞选总统为何引发热议","content":"法国总统竞选进入关键阶段，左右候选人成堆，极右翼国民联盟候选人玛丽娜.勒庞领衔民调，极左翼法兰西不屈服领袖梅郎雄摇旗呐喊，声势不小，民调虽低于国民联盟十个点左右，但高于其他左右各翼。然而就在这个周五，又杀出一个号称超出“群党”，既不屑于与两个极端为伍，又痛斥马克龙主义的所谓中间派削弱了法国，讲话有点戴高乐式的姿态，言辞却似不乏革命者情怀的一个候选人，他就是希拉克时期曾担任总理的德维尔潘。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261121-%E5%BE%B7%E7%BB%B4%E5%B0%94%E6%BD%98%E7%AB%9E%E9%80%89%E6%80%BB%E7%BB%9F%E4%B8%BA%E4%BD%95%E5%BC%95%E5%8F%91%E7%83%AD%E8%AE%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795302859000.webp","sourceId":"rfi"},{"id":1795302830000,"createdDate":"2026-11-21 23:13","name":"法国国际广播电台","title":"欧盟开支预算： 德国认为规模太大，法国认为预算被砍得太厉害了","content":"欧盟开支预算，德国认为总体规模太大，但法国认为被预算砍得太厉害了。于是在协调的时间点，欧盟要征收数字税，扩大收入。欧盟提出的数字税方案，是一项针对全球大型数字企业的征税计划，这是星期六提出来的。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261121-%E6%AC%A7%E7%9B%9F%E5%BC%80%E6%94%AF%E9%A2%84%E7%AE%97-%E5%BE%B7%E5%9B%BD%E8%AE%A4%E4%B8%BA%E8%A7%84%E6%A8%A1%E5%A4%AA%E5%A4%A7%EF%BC%8C%E6%B3%95%E5%9B%BD%E8%AE%A4%E4%B8%BA%E9%A2%84%E7%AE%97%E8%A2%AB%E7%A0%8D%E5%BE%97%E5%A4%AA%E5%8E%89%E5%AE%B3%E4%BA%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795302830000.webp","sourceId":"rfi"},{"id":1795301986000,"createdDate":"2026-11-21 22:59","name":"法国国际广播电台","title":"COP31 : 欧盟专员说没有协议总比达成一份糟糕的协议要好， 法国巴拿马带头说目前的协议不够好","content":"在土耳其安塔利亚参加第31届联合国气候变化大会的谈判代表仍在努力寻找近200个国家都能接受的方案。","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261121-cop31-%E6%AC%A7%E7%9B%9F%E4%B8%93%E5%91%98%E8%AF%B4%E6%B2%A1%E6%9C%89%E5%8D%8F%E8%AE%AE%E6%80%BB%E6%AF%94%E8%BE%BE%E6%88%90%E4%B8%80%E4%BB%BD%E7%B3%9F%E7%B3%95%E7%9A%84%E5%8D%8F%E8%AE%AE%E8%A6%81%E5%A5%BD%EF%BC%8C-%E6%B3%95%E5%9B%BD%E5%B7%B4%E6%8B%BF%E9%A9%AC%E5%B8%A6%E5%A4%B4%E8%AF%B4%E7%9B%AE%E5%89%8D%E7%9A%84%E5%8D%8F%E8%AE%AE%E4%B8%8D%E5%A4%9F%E5%A5%BD","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795301986000.webp","sourceId":"rfi"},{"id":1795300467000,"createdDate":"2026-11-21 22:34","name":"法国国际广播电台","title":"周六法国多个城市爆发大规模游行，抗议公共服务差、生活成本高、不平等","content":"周六，法国多个城市爆发了大规模游行，这是第六个周末的抗议活动。示威者要求改善公共服务，并对不断上涨的生活成本和不平等现象表达不满。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261121-%E5%91%A8%E5%85%AD%E6%B3%95%E5%9B%BD%E5%A4%9A%E4%B8%AA%E5%9F%8E%E5%B8%82%E7%88%86%E5%8F%91%E4%BA%86%E7%AC%AC%E5%85%AD%E4%B8%AA%E5%91%A8%E6%9C%AB%E5%A4%A7%E8%A7%84%E6%A8%A1%E6%B8%B8%E8%A1%8C%EF%BC%8C%E6%8A%97%E8%AE%AE%E5%85%AC%E5%85%B1%E6%9C%8D%E5%8A%A1%E5%B7%AE%EF%BC%8C%E7%94%9F%E6%B4%BB%E6%88%90%E6%9C%AC%E9%AB%98%EF%BC%8C%E4%B8%8D%E5%B9%B3%E7%AD%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795300467000.webp","sourceId":"rfi"},{"id":1795300228000,"createdDate":"2026-11-21 22:30","name":"法国国际广播电台","title":"COP31 : 最终能否达成并通过决议文本充满悬念","content":"土耳其安塔利亚气候峰会周六延期一天后未能结束谈判，周六晚上12点主席国召集全体大会，宣布会议最终文本应该在周日早上六点推出。不过，推出之后，能否获得一致通过？土耳其峰会会否无果而终？","newsLink":"https://www.rfi.fr/cn/%E7%94%9F%E6%80%81/20261121-cop31-%E6%9C%80%E7%BB%88%E6%96%87%E6%9C%AC%E9%A2%84%E5%AE%9A%E5%91%A8%E6%97%A5%E4%B8%8A%E5%8D%88%E6%8E%A8%E5%87%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795300228000.webp","sourceId":"rfi"},{"id":1795300153000,"createdDate":"2026-11-21 22:29","name":"法国国际广播电台","title":"泽连斯基回应特朗普：普京只是一介屠夫","content":"针对特朗普形容普京是其“朋友”，乌克兰总统泽连斯基毫不犹豫地对美国媒体表示，他的同行俄罗斯总统普京仅仅是一介“屠夫”。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261121-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA%E5%9B%9E%E5%BA%94%E7%89%B9%E6%9C%97%E6%99%AE-%E6%99%AE%E4%BA%AC%E5%8F%AA%E6%98%AF%E4%B8%80%E4%BB%8B%E5%B1%A0%E5%A4%AB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795300153000.webp","sourceId":"rfi"},{"id":1795298132000,"createdDate":"2026-11-21 21:55","name":"法国国际广播电台","title":"德国《南方信使报》：中美俄三巨头会晤成果寥寥无几","content":"德国媒体就深圳中美俄三巨头会晤表示了关注，但多份媒体感到失望。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261121-%E5%BE%B7%E5%9B%BD-%E5%8D%97%E6%96%B9%E4%BF%A1%E4%BD%BF%E6%8A%A5-%E4%B8%AD%E7%BE%8E%E4%BF%84%E4%B8%89%E5%B7%A8%E5%A4%B4%E4%BC%9A%E6%99%A4%E6%88%90%E6%9E%9C%E5%AF%A5%E5%AF%A5%E6%97%A0%E5%87%A0","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795298132000.webp","sourceId":"rfi"},{"id":1795297941000,"createdDate":"2026-11-21 21:52","name":"法国国际广播电台","title":"加州律师公会调查前白宫发言人扎卡里亚　涉未取得执照却多次自称律师","content":"美国加州律师公会已对前白宫发言人扎卡里亚（KatieZacharia）展开调查，厘清她是否在未取得律师执业资格的情况下，多次对外宣称自己是律师，涉嫌违反加州法律。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261121-%E5%8A%A0%E5%B7%9E%E5%BE%8B%E5%B8%88%E5%85%AC%E4%BC%9A%E8%B0%83%E6%9F%A5%E5%89%8D%E7%99%BD%E5%AE%AB%E5%8F%91%E8%A8%80%E4%BA%BA%E6%89%8E%E5%8D%A1%E9%87%8C%E4%BA%9A-%E6%B6%89%E6%9C%AA%E5%8F%96%E5%BE%97%E6%89%A7%E7%85%A7%E5%8D%B4%E5%A4%9A%E6%AC%A1%E8%87%AA%E7%A7%B0%E5%BE%8B%E5%B8%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/21/1795297941000.webp","sourceId":"rfi"}]