[{"id":1793544447000,"createdDate":"2026-11-01 14:47","name":"法国国际广播电台","title":"法国释放战略柴油储备 加油站预计开始降价","content":"法国政府释放柴油战略储备措施于周日生效。继道达尔能源之后，E.Leclerc公司周六宣布从11月1日起柴油降价。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261101-%E6%B3%95%E5%9B%BD%E9%87%8A%E6%94%BE%E6%88%98%E7%95%A5%E6%9F%B4%E6%B2%B9%E5%82%A8%E5%A4%87-%E5%8A%A0%E6%B2%B9%E7%AB%99%E5%BC%80%E5%A7%8B%E9%99%8D%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793544447000.webp","sourceId":"rfi"},{"id":1793543279000,"createdDate":"2026-11-01 14:27","name":"法国国际广播电台","title":"特朗普威胁将对伊朗“一两个目标”发动新一轮打击","content":"美国总统唐纳德·特朗普周六表示，美国已摧毁了伊朗大部分核能力，但仍需“处理”一两个设施；与此同时，德黑兰方面威胁称，若再遭打击将进行反击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A8%81%E8%83%81%E5%B0%86%E5%AF%B9%E4%BC%8A%E6%9C%97-%E4%B8%80%E4%B8%A4%E4%B8%AA%E7%9B%AE%E6%A0%87-%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E6%89%93%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793543279000.webp","sourceId":"rfi"},{"id":1793539933000,"createdDate":"2026-11-01 13:32","name":"法国国际广播电台","title":"欧盟继对小包裹征税后 今起加征2欧元处理费","content":"据法新社11月1日布鲁塞尔消息，为遏制网上中国商品的涌入并加强监管，欧盟从11月1日起，对进口至欧盟的包裹，加征2欧元的“处理费”。2025年，近59亿件小包裹进入欧盟，相当于每秒超过180件。其中93%来自中国，通常经由Shein、Temu、AliExpress等网站进入。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E6%AC%A7%E7%9B%9F%E7%BB%A7%E5%AF%B9%E5%B0%8F%E5%8C%85%E8%A3%B9%E5%BE%81%E7%A8%8E%E5%90%8E-%E4%BB%8A%E8%B5%B7%E5%8A%A0%E5%BE%812%E6%AC%A7%E5%85%83%E5%A4%84%E7%90%86%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793539933000.webp","sourceId":"rfi"},{"id":1793534580000,"createdDate":"2026-11-01 12:03","name":"法国国际广播电台","title":"币安63亿美元“世纪大劫案”：朝鲜黑客组织TraderTraitor究竟是什么来头？","content":"本周，一宗号称“世纪大劫案”的案件刷新了有史以来金融盗窃案的损失记录。全球最大加密货币交易所币安（Binance）遭遇史上最严重黑客攻击，黑客盗走约63亿美元的加密货币。为阻止资金进一步流失，该平台一度暂停客户提现服务。周日（11月1日），币安宣布，将逐步恢复用户提现服务，并表示第一批提现服务现已在比特币网络上开放。更令人意想不到的是，FBI表示，已经确认幕后黑手为朝鲜黑客组织“TraderTraitor”。从出于报复目的的数据破坏，到大规模窃取虚拟货币，再到各种形式的网络入侵，朝鲜近年来似乎拥有了一支隐秘而强大的网络攻击力量。外界认为，朝鲜通过这些行动获取的巨额收益，主要用于资助朝鲜的军事项目。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261101-%E5%B8%81%E5%AE%8963%E4%BA%BF%E7%BE%8E%E5%85%83-%E4%B8%96%E7%BA%AA%E5%A4%A7%E5%8A%AB%E6%A1%88-%E6%9C%9D%E9%B2%9C%E9%BB%91%E5%AE%A2%E7%BB%84%E7%BB%87tradertraitor%E7%A9%B6%E7%AB%9F%E6%98%AF%E4%BB%80%E4%B9%88%E6%9D%A5%E5%A4%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793534580000.webp","sourceId":"rfi"},{"id":1793523693000,"createdDate":"2026-11-01 09:01","name":"法国国际广播电台","title":"日本外务省遭网络攻击 或有3600件个人信息外泄","content":"日本外务省宣布，因遭到非法访问，部分个人信息可能已经泄露。据外务省介绍，今年7月，该部门发现，有第三方非法侵入了一个能够与外部进行信息往来的网络。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E7%9C%81%E9%81%AD%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB-%E6%88%96%E6%9C%893600%E4%BB%B6%E4%B8%AA%E4%BA%BA%E4%BF%A1%E6%81%AF%E5%A4%96%E6%B3%84","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793523693000.webp","sourceId":"rfi"},{"id":1793523352000,"createdDate":"2026-11-01 08:55","name":"法国国际广播电台","title":"台湾称中国海警在东部海域巡逻期间骚扰船只 台方派船监视","content":"路透社报道，台湾海巡部门表示，中国海警近日在台湾东部海域进行的新一轮巡逻中骚扰海上船只，并试图扩大管辖权。台湾方面已派遣舰船前往全程监视。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261101-%E5%8F%B0%E6%B9%BE%E7%A7%B0%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E5%9C%A8%E4%B8%9C%E9%83%A8%E6%B5%B7%E5%9F%9F%E5%B7%A1%E9%80%BB%E6%9C%9F%E9%97%B4%E9%AA%9A%E6%89%B0%E8%88%B9%E5%8F%AA-%E5%8F%B0%E6%96%B9%E6%B4%BE%E8%88%B9%E7%9B%91%E8%A7%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793523352000.webp","sourceId":"rfi"},{"id":1793522836000,"createdDate":"2026-11-01 08:47","name":"法国国际广播电台","title":"莫迪政府再遭挑战：因审查选民信息，印度反对党及“蟑螂党”举行抗议活动","content":"据美联社报道，周日（11月1日），印度再次爆发了针对总理莫迪政府的抗议行动。这次抗议是在印度最大反对党国大党（CongressParty）领袖拉胡尔·甘地（RahulGandhi）的带领下进行的，并得到青年组织“蟑螂运动”的支持，示威者呼吁捍卫印度民主，同时要求选举委员会负责人贾内什·库马尔（GyaneshKumar）辞职，原因是围绕选民登记册修订问题引发了巨大争议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261101-%E8%8E%AB%E8%BF%AA%E6%94%BF%E5%BA%9C%E5%86%8D%E9%81%AD%E6%8C%91%E6%88%98-%E5%9B%A0%E5%AE%A1%E6%9F%A5%E9%80%89%E6%B0%91%E4%BF%A1%E6%81%AF%EF%BC%8C%E5%8D%B0%E5%BA%A6%E5%8F%8D%E5%AF%B9%E5%85%9A%E5%8F%8A-%E8%9F%91%E8%9E%82%E5%85%9A-%E4%B8%BE%E8%A1%8C%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793522836000.webp","sourceId":"rfi"},{"id":1793521638000,"createdDate":"2026-11-01 08:27","name":"法国国际广播电台","title":"美国FBI指控朝鲜黑客攻击币安加密货币盗取63亿美元","content":"在币安平台63亿美元加密货币被盗后，美国FBI指控朝鲜黑客组织TraderTraitor犯下“世纪大劫案”。法新社说，该组织是平壤在网络攻击行动中最具威力的武器之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E7%BE%8E%E5%9B%BDfbi%E6%8C%87%E6%8E%A7%E6%9C%9D%E9%B2%9C%E9%BB%91%E5%AE%A2%E6%94%BB%E5%87%BB%E5%B8%81%E5%AE%89%E5%8A%A0%E5%AF%86%E8%B4%A7%E5%B8%81%E7%9B%97%E5%8F%9663%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793521638000.webp","sourceId":"rfi"}]