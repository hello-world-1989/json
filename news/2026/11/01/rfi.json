[{"id":1793544447000,"createdDate":"2026-11-01 14:47","name":"法国国际广播电台","title":"法国释放战略柴油储备 加油站预计开始降价","content":"法国政府释放柴油战略储备措施于周日生效。继道达尔能源之后，E.Leclerc公司周六宣布从11月1日起柴油降价。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261101-%E6%B3%95%E5%9B%BD%E9%87%8A%E6%94%BE%E6%88%98%E7%95%A5%E6%9F%B4%E6%B2%B9%E5%82%A8%E5%A4%87-%E5%8A%A0%E6%B2%B9%E7%AB%99%E5%BC%80%E5%A7%8B%E9%99%8D%E4%BB%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793544447000.webp","sourceId":"rfi"},{"id":1793543279000,"createdDate":"2026-11-01 14:27","name":"法国国际广播电台","title":"特朗普威胁将对伊朗“一两个目标”发动新一轮打击","content":"美国总统唐纳德·特朗普周六表示，美国已摧毁了伊朗大部分核能力，但仍需“处理”一两个设施；与此同时，德黑兰方面威胁称，若再遭打击将进行反击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E7%89%B9%E6%9C%97%E6%99%AE%E5%A8%81%E8%83%81%E5%B0%86%E5%AF%B9%E4%BC%8A%E6%9C%97-%E4%B8%80%E4%B8%A4%E4%B8%AA%E7%9B%AE%E6%A0%87-%E5%8F%91%E5%8A%A8%E6%96%B0%E4%B8%80%E8%BD%AE%E6%89%93%E5%87%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793543279000.webp","sourceId":"rfi"},{"id":1793539933000,"createdDate":"2026-11-01 13:32","name":"法国国际广播电台","title":"欧盟继对小包裹征税后 今起加征2欧元处理费","content":"据法新社11月1日布鲁塞尔消息，为遏制网上中国商品的涌入并加强监管，欧盟从11月1日起，对进口至欧盟的包裹，加征2欧元的“处理费”。2025年，近59亿件小包裹进入欧盟，相当于每秒超过180件。其中93%来自中国，通常经由Shein、Temu、AliExpress等网站进入。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E6%AC%A7%E7%9B%9F%E7%BB%A7%E5%AF%B9%E5%B0%8F%E5%8C%85%E8%A3%B9%E5%BE%81%E7%A8%8E%E5%90%8E-%E4%BB%8A%E8%B5%B7%E5%8A%A0%E5%BE%812%E6%AC%A7%E5%85%83%E5%A4%84%E7%90%86%E8%B4%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793539933000.webp","sourceId":"rfi"},{"id":1793534580000,"createdDate":"2026-11-01 12:03","name":"法国国际广播电台","title":"币安63亿美元“世纪大劫案”：朝鲜黑客组织TraderTraitor究竟是什么来头？","content":"本周，一宗号称“世纪大劫案”的案件刷新了有史以来金融盗窃案的损失记录。全球最大加密货币交易所币安（Binance）遭遇史上最严重黑客攻击，黑客盗走约63亿美元的加密货币。为阻止资金进一步流失，该平台一度暂停客户提现服务。周日（11月1日），币安宣布，将逐步恢复用户提现服务，并表示第一批提现服务现已在比特币网络上开放。更令人意想不到的是，FBI表示，已经确认幕后黑手为朝鲜黑客组织“TraderTraitor”。从出于报复目的的数据破坏，到大规模窃取虚拟货币，再到各种形式的网络入侵，朝鲜近年来似乎拥有了一支隐秘而强大的网络攻击力量。外界认为，朝鲜通过这些行动获取的巨额收益，主要用于资助朝鲜的军事项目。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261101-%E5%B8%81%E5%AE%8963%E4%BA%BF%E7%BE%8E%E5%85%83-%E4%B8%96%E7%BA%AA%E5%A4%A7%E5%8A%AB%E6%A1%88-%E6%9C%9D%E9%B2%9C%E9%BB%91%E5%AE%A2%E7%BB%84%E7%BB%87tradertraitor%E7%A9%B6%E7%AB%9F%E6%98%AF%E4%BB%80%E4%B9%88%E6%9D%A5%E5%A4%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793534580000.webp","sourceId":"rfi"},{"id":1793523693000,"createdDate":"2026-11-01 09:01","name":"法国国际广播电台","title":"日本外务省遭网络攻击 或有3600件个人信息外泄","content":"日本外务省宣布，因遭到非法访问，部分个人信息可能已经泄露。据外务省介绍，今年7月，该部门发现，有第三方非法侵入了一个能够与外部进行信息往来的网络。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E6%97%A5%E6%9C%AC%E5%A4%96%E5%8A%A1%E7%9C%81%E9%81%AD%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB-%E6%88%96%E6%9C%893600%E4%BB%B6%E4%B8%AA%E4%BA%BA%E4%BF%A1%E6%81%AF%E5%A4%96%E6%B3%84","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793523693000.webp","sourceId":"rfi"},{"id":1793523352000,"createdDate":"2026-11-01 08:55","name":"法国国际广播电台","title":"台湾称中国海警在东部海域巡逻期间骚扰船只 台方派船监视","content":"路透社报道，台湾海巡部门表示，中国海警近日在台湾东部海域进行的新一轮巡逻中骚扰海上船只，并试图扩大管辖权。台湾方面已派遣舰船前往全程监视。","newsLink":"https://www.rfi.fr/cn/%E6%B8%AF%E6%BE%B3%E5%8F%B0/20261101-%E5%8F%B0%E6%B9%BE%E7%A7%B0%E4%B8%AD%E5%9B%BD%E6%B5%B7%E8%AD%A6%E5%9C%A8%E4%B8%9C%E9%83%A8%E6%B5%B7%E5%9F%9F%E5%B7%A1%E9%80%BB%E6%9C%9F%E9%97%B4%E9%AA%9A%E6%89%B0%E8%88%B9%E5%8F%AA-%E5%8F%B0%E6%96%B9%E6%B4%BE%E8%88%B9%E7%9B%91%E8%A7%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793523352000.webp","sourceId":"rfi"},{"id":1793522836000,"createdDate":"2026-11-01 08:47","name":"法国国际广播电台","title":"莫迪政府再遭挑战：因审查选民信息，印度反对党及“蟑螂党”举行抗议活动","content":"据美联社报道，周日（11月1日），印度再次爆发了针对总理莫迪政府的抗议行动。这次抗议是在印度最大反对党国大党（CongressParty）领袖拉胡尔·甘地（RahulGandhi）的带领下进行的，并得到青年组织“蟑螂运动”的支持，示威者呼吁捍卫印度民主，同时要求选举委员会负责人贾内什·库马尔（GyaneshKumar）辞职，原因是围绕选民登记册修订问题引发了巨大争议。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261101-%E8%8E%AB%E8%BF%AA%E6%94%BF%E5%BA%9C%E5%86%8D%E9%81%AD%E6%8C%91%E6%88%98-%E5%9B%A0%E5%AE%A1%E6%9F%A5%E9%80%89%E6%B0%91%E4%BF%A1%E6%81%AF%EF%BC%8C%E5%8D%B0%E5%BA%A6%E5%8F%8D%E5%AF%B9%E5%85%9A%E5%8F%8A-%E8%9F%91%E8%9E%82%E5%85%9A-%E4%B8%BE%E8%A1%8C%E6%8A%97%E8%AE%AE%E6%B4%BB%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793522836000.webp","sourceId":"rfi"},{"id":1793521638000,"createdDate":"2026-11-01 08:27","name":"法国国际广播电台","title":"美国FBI指控朝鲜黑客攻击币安加密货币盗取63亿美元","content":"在币安平台63亿美元加密货币被盗后，美国FBI指控朝鲜黑客组织TraderTraitor犯下“世纪大劫案”。法新社说，该组织是平壤在网络攻击行动中最具威力的武器之一。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E7%BE%8E%E5%9B%BDfbi%E6%8C%87%E6%8E%A7%E6%9C%9D%E9%B2%9C%E9%BB%91%E5%AE%A2%E6%94%BB%E5%87%BB%E5%B8%81%E5%AE%89%E5%8A%A0%E5%AF%86%E8%B4%A7%E5%B8%81%E7%9B%97%E5%8F%9663%E4%BA%BF%E7%BE%8E%E5%85%83","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793521638000.webp","sourceId":"rfi"},{"id":1793559423000,"createdDate":"2026-11-01 18:57","name":"法国国际广播电台","title":"姆巴佩风波延续   央视停播皇家马德里比赛","content":"中国官方媒体中央电视台（CCTV）周日没有转播皇家马德里的西甲联赛比赛。此前，皇马前锋基利安·姆巴佩（KylianMbappé）因一段涉及中国前领导人毛泽东的言论视频在中国引发争议。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261101-%E5%A7%86%E5%B7%B4%E4%BD%A9%E9%A3%8E%E6%B3%A2%E5%BB%B6%E7%BB%AD%EF%BC%8C%E5%A4%AE%E8%A7%86%E6%9A%82%E5%81%9C%E8%BD%AC%E6%92%AD%E7%9A%87%E5%AE%B6%E9%A9%AC%E5%BE%B7%E9%87%8C%E6%AF%94%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793559423000.webp","sourceId":"rfi"},{"id":1793558372000,"createdDate":"2026-11-01 18:39","name":"法国国际广播电台","title":"青年和平示威活动之后是骚乱","content":"据德国广播电台报道，周六晚上，德国多个城市出现骚乱和暴力冲突。其中，法兰克福受到的影响尤为严重。科隆、汉堡和柏林也受到较大影响。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261101-%E9%9D%92%E5%B9%B4%E5%92%8C%E5%B9%B3%E7%A4%BA%E5%A8%81%E6%B4%BB%E5%8A%A8%E4%B9%8B%E5%90%8E%E6%98%AF%E9%AA%9A%E4%B9%B1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793558372000.webp","sourceId":"rfi"},{"id":1793556547000,"createdDate":"2026-11-01 18:09","name":"法国国际广播电台","title":"美国期中选举提前投票逾5300万人","content":"美国2026年期中选举将于星期二（11月3日）举行，截至星期日已有逾5300万名选民提前投票，较2022年同期明显增加。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261101-%E7%BE%8E%E5%9B%BD%E6%9C%9F%E4%B8%AD%E9%80%89%E4%B8%BE%E6%8F%90%E5%89%8D%E6%8A%95%E7%A5%A8%E9%80%BE5300%E4%B8%87%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793556547000.webp","sourceId":"rfi"},{"id":1793554692000,"createdDate":"2026-11-01 17:38","name":"法国国际广播电台","title":"波兰政治危机：布鲁塞尔向波兰总统施压","content":"欧盟委员会周六站在波兰总理唐纳德·图斯克一边，呼吁波兰总统卡罗尔·纳夫罗茨基批准新法官的任命，以化解华沙的严重政治危机。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261101-%E6%B3%A2%E5%85%B0%E6%94%BF%E6%B2%BB%E5%8D%B1%E6%9C%BA-%E5%B8%83%E9%B2%81%E5%A1%9E%E5%B0%94%E5%90%91%E6%B3%A2%E5%85%B0%E6%80%BB%E7%BB%9F%E6%96%BD%E5%8E%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793554692000.webp","sourceId":"rfi"},{"id":1793550669000,"createdDate":"2026-11-01 16:31","name":"法国国际广播电台","title":"特朗普发出威胁后，伊朗警告称新一轮战争可能旷日持久","content":"周日，伊朗警告美国称，若敌对行动重启，冲突恐将旷日持久。此前一天，唐纳德·特朗普再次发出威胁称打算“处理”一两个目标。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E7%89%B9%E6%9C%97%E6%99%AE%E5%8F%91%E5%87%BA%E5%A8%81%E8%83%81%E5%90%8E%EF%BC%8C%E4%BC%8A%E6%9C%97%E8%AD%A6%E5%91%8A%E7%A7%B0%E6%96%B0%E4%B8%80%E8%BD%AE%E6%88%98%E4%BA%89%E5%8F%AF%E8%83%BD%E6%97%B7%E6%97%A5%E6%8C%81%E4%B9%85","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793550669000.webp","sourceId":"rfi"},{"id":1793547269000,"createdDate":"2026-11-01 15:34","name":"法国国际广播电台","title":"施泰因迈尔：当被问及是否将就乌克兰问题举行中美俄峰会? 习近平面露不悦之色","content":"德国联邦总统弗兰克-瓦尔特·施泰因迈尔表示，根据他上周在北京与习近平会面的情况来看，中国对与美俄就乌克兰问题举行三方峰会不感兴趣。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261101-%E6%96%BD%E6%B3%B0%E5%9B%A0%E8%BF%88%E5%B0%94-%E5%BD%93%E8%A2%AB%E9%97%AE%E5%8F%8A%E6%98%AF%E5%90%A6%E5%B0%86%E5%B0%B1%E4%B9%8C%E5%85%8B%E5%85%B0%E9%97%AE%E9%A2%98%E4%B8%BE%E8%A1%8C%E4%B8%AD%E7%BE%8E%E4%BF%84%E5%B3%B0%E4%BC%9A-%E4%B9%A0%E8%BF%91%E5%B9%B3%E9%9D%A2%E9%9C%B2%E4%B8%8D%E6%82%A6%E4%B9%8B%E8%89%B2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793547269000.webp","sourceId":"rfi"},{"id":1793569890000,"createdDate":"2026-11-01 21:51","name":"法国国际广播电台","title":"美国将助马达加斯加建厂炼稀土","content":"美国将资助印度洋中的非洲大岛国马达加斯加（Madagascar）在安帕辛达瓦（Ampasindava）建设一座稀土提炼厂。通过对这一项目的支持，华盛顿寻求实现供应链多元化，以应对中国。这是本台法广（RFI）非洲通讯员10月31日周六刊出的一篇有关中美关系的最新法文报道。目前在美国第二届特朗普政府中负责经济事务的副国务卿雅各布·赫尔伯格（JacobHelberg）已确认了480万美元的首笔资金。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261101-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E7%BE%8E%E5%9B%BD%E5%B0%86%E5%8A%A9%E9%A9%AC%E8%BE%BE%E5%8A%A0%E6%96%AF%E5%8A%A0%E5%BB%BA%E5%8E%82%E7%82%BC%E7%A8%80%E5%9C%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793569890000.webp","sourceId":"rfi"},{"id":1793569437000,"createdDate":"2026-11-01 21:43","name":"法国国际广播电台","title":"中国共产党将审查官员的资产和网络活动, 为习近平延长执政期铺平道路","content":"中国共产党将通过审查官员的资产和网络活动，加强对官员的监督。法新社根据周日发布的一份党内文件做了报道。法新社的报道援引分析人士指出，这些举措旨在为习近平在2027年下半年召开的党代会上延长执政期铺平道路。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261101-%E4%B8%AD%E5%9B%BD%E5%85%B1%E4%BA%A7%E5%85%9A%E5%B0%86%E5%AE%A1%E6%9F%A5%E5%AE%98%E5%91%98%E7%9A%84%E8%B5%84%E4%BA%A7%E5%92%8C%E7%BD%91%E7%BB%9C%E6%B4%BB%E5%8A%A8-%E4%B8%BA%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%BB%B6%E9%95%BF%E6%89%A7%E6%94%BF%E6%9C%9F%E9%93%BA%E5%B9%B3%E9%81%93%E8%B7%AF","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793569437000.webp","sourceId":"rfi"},{"id":1793568841000,"createdDate":"2026-11-01 21:34","name":"法国国际广播电台","title":"美国共和党人展开了最后冲刺，试图避免在美国中期选举中遭遇惨败","content":"周日，美国共和党人展开了最后冲刺，试图避免在美国中期选举中遭遇惨败。此次中期选举中，民主党人正力争夺取国会控制权，从而对特朗普总统前所未有的权力扩张施加第一次政治制衡。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261101-%E7%BE%8E%E5%9B%BD%E5%85%B1%E5%92%8C%E5%85%9A%E4%BA%BA%E5%B1%95%E5%BC%80%E4%BA%86%E6%9C%80%E5%90%8E%E5%86%B2%E5%88%BA%EF%BC%8C%E8%AF%95%E5%9B%BE%E9%81%BF%E5%85%8D%E5%9C%A8%E7%BE%8E%E5%9B%BD%E4%B8%AD%E6%9C%9F%E9%80%89%E4%B8%BE%E4%B8%AD%E9%81%AD%E9%81%87%E6%83%A8%E8%B4%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793568841000.webp","sourceId":"rfi"},{"id":1793568198000,"createdDate":"2026-11-01 21:23","name":"法国国际广播电台","title":"周一开始，封锁高中的行动在法国又要重新启动。","content":"法国一个学生组织的负责人表示，法国政府提出的方案力度还不够。从周一开始，封锁高中的行动又要重新启动。周六，法国各地有数十万人走上街头，其中包括中学生和大学生，这是连续第三个周末的抗议活动。","newsLink":"https://www.rfi.fr/cn/%E6%B3%95%E5%9B%BD/20261101-%E5%91%A8%E4%B8%80%E5%BC%80%E5%A7%8B%EF%BC%8C%E5%B0%81%E9%94%81%E9%AB%98%E4%B8%AD%E7%9A%84%E8%A1%8C%E5%8A%A8%E5%9C%A8%E6%B3%95%E5%9B%BD%E5%8F%88%E8%A6%81%E9%87%8D%E6%96%B0%E5%90%AF%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793568198000.webp","sourceId":"rfi"},{"id":1793567159000,"createdDate":"2026-11-01 21:05","name":"法国国际广播电台","title":"达喀尔2026青奥会难忘的开幕式","content":"西非国家塞内加尔经过历时8年的等待，迎来了2026年青年奥林匹克运动会这场体育盛事。10月31日星期六在达喀尔（Dakar）举行的开幕式令人印象深刻,难以忘却。这是本台法广非洲组（RFIAfrique）和体育组(RFISport)今天（2026年11月01日星期天）法文报道的关注焦点之一。其中之一是本台法广（RFI）特派记者（envoyéspécial）发自塞内加尔新城Diamniadio的现场报道。这一为期两周，从10月31日周六开始计划一直举行到11月13日星期五的青年奥运盛会在非洲体育史上具有重要意义。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261101-rfi%E6%B3%95%E5%B9%BF-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E8%BE%BE%E5%96%80%E5%B0%942026%E9%9D%92%E5%A5%A5%E4%BC%9A%E9%9A%BE%E5%BF%98%E7%9A%84%E5%BC%80%E5%B9%95%E5%BC%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/01/1793567159000.webp","sourceId":"rfi"}]