[{"id":1795458292000,"createdDate":"2026-11-23 18:24","name":"法国国际广播电台","title":"特朗普促使英伟达董事会让黄仁勋复职 据报未征求临时CEO等高管意见","content":"据彭博社援引熟悉事情经过的人士报导称，英伟达董事会出人意料地决定让此前在压力下辞职的前首席执行官黄仁勋复职；这一举动并未事先征求公司高层领导的意见，他们直到最后一刻才获悉此事。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E7%89%B9%E6%9C%97%E6%99%AE%E4%BF%83%E4%BD%BF%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%91%A3%E4%BA%8B%E4%BC%9A%E8%AE%A9%E9%BB%84%E4%BB%81%E5%8B%8B%E5%A4%8D%E8%81%8C-%E6%8D%AE%E6%8A%A5%E6%9C%AA%E5%BE%81%E6%B1%82%E4%B8%B4%E6%97%B6ceo%E7%AD%89%E9%AB%98%E7%AE%A1%E6%84%8F%E8%A7%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795458292000.webp","sourceId":"rfi"},{"id":1795457746000,"createdDate":"2026-11-23 18:15","name":"法国国际广播电台","title":"黄仁勋回任英伟达执行长　美国两党议员质疑国安风险　要求国会彻查","content":"美国人工智能芯片大厂英伟达董事会23日一致决议，恢复黄仁勋的执行长职务，但这项决定未能平息美国国会两党议员的质疑。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%9B%9E%E4%BB%BB%E8%8B%B1%E4%BC%9F%E8%BE%BE%E6%89%A7%E8%A1%8C%E9%95%BF-%E7%BE%8E%E5%9B%BD%E4%B8%A4%E5%85%9A%E8%AE%AE%E5%91%98%E8%B4%A8%E7%96%91%E5%9B%BD%E5%AE%89%E9%A3%8E%E9%99%A9-%E8%A6%81%E6%B1%82%E5%9B%BD%E4%BC%9A%E5%BD%BB%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795457746000.webp","sourceId":"rfi"},{"id":1795456423000,"createdDate":"2026-11-23 17:53","name":"法国国际广播电台","title":"特朗普称其说服英伟达董事会让黄仁勋复职 未问习近平黄乐是否是间谍","content":"美国总统特朗普（DonaldTrump）周一向消费者新闻与商业频道（CNBC）透露，他曾直接与英伟达董事会谈话，敦促他们让黄仁勋重返首席执行官职位。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E7%89%B9%E6%9C%97%E6%99%AE%E7%A7%B0%E8%AF%B4%E6%9C%8D%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%91%A3%E4%BA%8B%E4%BC%9A%E8%AE%A9%E9%BB%84%E4%BB%81%E5%8B%8B%E5%A4%8D%E8%81%8C-%E6%9C%AA%E9%97%AE%E4%B9%A0%E8%BF%91%E5%B9%B3%E9%BB%84%E4%B9%90%E6%98%AF%E5%90%A6%E6%98%AF%E9%97%B4%E8%B0%8D","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795456423000.webp","sourceId":"rfi"},{"id":1795452407000,"createdDate":"2026-11-23 16:46","name":"法国国际广播电台","title":"黄仁勋在美参众两院委员会的作证目前预计仍将按计划进行","content":"英伟达周一宣布恢复黄仁勋的总裁兼首席执行官及董事职务，这一举动可能会打乱美国国会两党议员对这家人工智能巨头进行监管的计划。英伟达董事会的这一决定——以及特朗普（DonaldTrump）总统在其中的介入——进一步加剧了特朗普与其所属的共和党之间的紧张关系。此前，部分共和党国会议员已精心筹划，准备在相关丑闻曝光之际，对黄仁勋本人以及针对中国的芯片出口管制措施展开严格审查。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%9C%A8%E7%BE%8E%E5%9B%BD%E4%BC%9A%E5%8F%82%E4%BC%97%E4%B8%A4%E9%99%A2%E7%9A%84%E4%BD%9C%E8%AF%81%E7%9B%AE%E5%89%8D%E9%A2%84%E8%AE%A1%E4%BB%8D%E5%B0%86%E6%8C%89%E8%AE%A1%E5%88%92%E8%BF%9B%E8%A1%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795452407000.webp","sourceId":"rfi"},{"id":1795450055000,"createdDate":"2026-11-23 16:07","name":"法国国际广播电台","title":"黄仁勋复职前数小时 特朗普据报曾亲自致电英伟达董事会，力主其回归","content":"据旗语新闻社援引知情人士报导称，在美国总统特朗普（DonaldTrump）通过电话连线参加英伟达董事会会议，力主黄仁勋回归后的数小时内，该公司便恢复了这位此前在压力下辞职的首席执行官的职务。","newsLink":"https://www.rfi.fr/cn/%E7%A7%91%E6%8A%80%E4%B8%8E%E6%96%87%E5%8C%96/20261123-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%A4%8D%E8%81%8C%E5%89%8D%E6%95%B0%E5%B0%8F%E6%97%B6-%E7%89%B9%E6%9C%97%E6%99%AE%E6%8D%AE%E6%8A%A5%E6%9B%BE%E4%BA%B2%E8%87%AA%E8%87%B4%E7%94%B5%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%91%A3%E4%BA%8B%E4%BC%9A%EF%BC%8C%E5%8A%9B%E4%B8%BB%E5%85%B6%E5%9B%9E%E5%BD%92","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795450055000.webp","sourceId":"rfi"},{"id":1795446660000,"createdDate":"2026-11-23 15:11","name":"法国国际广播电台","title":"特朗普：董事会作出正确且恰当决定，英伟达应继续合规内部调查","content":"美国总统特朗普（DonaldTrump）周一通过其社媒平台表示，他对英伟达董事会恢复黄仁勋首席执行官等职务一事表示欢迎，并宣称黄仁勋回归不会对美国国家安全构成任何风险。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E7%89%B9%E6%9C%97%E6%99%AE-%E8%91%A3%E4%BA%8B%E4%BC%9A%E4%BD%9C%E5%87%BA%E6%AD%A3%E7%A1%AE%E4%B8%94%E6%81%B0%E5%BD%93%E7%9A%84%E5%86%B3%E5%AE%9A%EF%BC%8C%E8%8B%B1%E4%BC%9F%E8%BE%BE%E5%BA%94%E5%90%8C%E6%97%B6%E7%BB%A7%E7%BB%AD%E5%90%88%E8%A7%84%E5%86%85%E9%83%A8%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795446660000.webp","sourceId":"rfi"},{"id":1795444359000,"createdDate":"2026-11-23 14:32","name":"法国国际广播电台","title":"英伟达董事会称确信其不会构成任何国安风险：黄仁勋即刻复职","content":"英伟达周一宣布，黄仁勋即刻重返公司首席执行官等职位。此前，黄仁勋被曝出存在多起婚外情，其中包括与一名被美国官员认定是中国情报资产的女子有染，在美国总统特朗普（DonaldTrump）近日多次表态支持的背景下，黄仁勋的“二进宫”不同寻常。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261123-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%91%A3%E4%BA%8B%E4%BC%9A%E7%A7%B0%E5%85%B6%E4%B8%8D%E4%BC%9A%E6%9E%84%E6%88%90%E4%BB%BB%E4%BD%95%E5%9B%BD%E5%AE%89%E9%A3%8E%E9%99%A9-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%8D%B3%E5%88%BB%E5%A4%8D%E8%81%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795444359000.webp","sourceId":"rfi"},{"id":1795443674000,"createdDate":"2026-11-23 14:21","name":"法国国际广播电台","title":"欧委会怀疑中国支持黑客组织是已持续一个月的网络攻击幕后黑手","content":"据欧洲新闻台报导，欧盟委员会怀疑，一个中国支持的黑客组织是一场使其系统受到影响的网络攻击的幕后黑手；该攻击已持续一个月，且目前仍在进行中。首起已确认的个人数据泄露事件涉及欧盟学院（EUAcademy）的用户。两位知情人士称，欧盟委员会怀疑，一场正在其IT系统中持续蔓延的大规模网络攻击，是由一个中国支持的威胁行为体网络所为。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261123-%E6%AC%A7%E5%A7%94%E4%BC%9A%E6%80%80%E7%96%91%E4%B8%AD%E5%9B%BD%E6%94%AF%E6%8C%81%E9%BB%91%E5%AE%A2%E7%BB%84%E7%BB%87%E6%98%AF%E5%B7%B2%E6%8C%81%E7%BB%AD%E4%B8%80%E4%B8%AA%E6%9C%88%E7%9A%84%E7%BD%91%E7%BB%9C%E6%94%BB%E5%87%BB%E5%B9%95%E5%90%8E%E9%BB%91%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795443674000.webp","sourceId":"rfi"},{"id":1795438887000,"createdDate":"2026-11-23 13:01","name":"法国国际广播电台","title":"印官员指针对中国公民的签证拒签率降至约7% 中方称愿为商务人员提供便利","content":"针对有报道称中国驻外外交机构减少了向印度公民发放签证，包括商务签证的情况，中方表示愿与印方共同努力，为双方商务人员的签证安排提供便利。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261123-%E5%8D%B0%E5%AE%98%E5%91%98%E6%8C%87%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E5%85%AC%E6%B0%91%E7%9A%84%E7%AD%BE%E8%AF%81%E6%8B%92%E7%AD%BE%E7%8E%87%E9%99%8D%E8%87%B3%E7%BA%A67-%E4%B8%AD%E6%96%B9%E7%A7%B0%E6%84%BF%E4%B8%BA%E5%95%86%E5%8A%A1%E4%BA%BA%E5%91%98%E6%8F%90%E4%BE%9B%E4%BE%BF%E5%88%A9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795438887000.webp","sourceId":"rfi"},{"id":1795435670000,"createdDate":"2026-11-23 12:07","name":"法国国际广播电台","title":"贝森特：需要查清楚究竟是谁负责英伟达的合规工作","content":"美国财政部长贝森特（ScottBessent）周日在受访时表示，正就英伟达向中国销售芯片一事向其寻求解释，并应查明该公司负责合规工作人员的责任。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261123-%E8%B4%9D%E6%A3%AE%E7%89%B9-%E9%9C%80%E8%A6%81%E6%9F%A5%E6%B8%85%E6%A5%9A%E7%A9%B6%E7%AB%9F%E6%98%AF%E8%B0%81%E8%B4%9F%E8%B4%A3%E8%8B%B1%E4%BC%9F%E8%BE%BE%E7%9A%84%E5%90%88%E8%A7%84%E5%B7%A5%E4%BD%9C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795435670000.webp","sourceId":"rfi"},{"id":1795433915000,"createdDate":"2026-11-23 11:38","name":"法国国际广播电台","title":"泽连斯基：乌克兰在利比亚海域袭击了两艘俄罗斯船只","content":"乌克兰总统泽连斯基周一宣称对在利比亚近海两艘俄罗斯军舰遭到的袭击负责，此前数小时，联合国刚呼吁就班加西附近海域针对船只的袭击事件展开调查。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261123-%E6%B3%BD%E8%BF%9E%E6%96%AF%E5%9F%BA-%E4%B9%8C%E5%85%8B%E5%85%B0%E5%9C%A8%E5%88%A9%E6%AF%94%E4%BA%9A%E6%B5%B7%E5%9F%9F%E8%A2%AD%E5%87%BB%E4%BA%86%E4%B8%A4%E8%89%98%E4%BF%84%E7%BD%97%E6%96%AF%E8%88%B9%E5%8F%AA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795433915000.webp","sourceId":"rfi"},{"id":1795431874000,"createdDate":"2026-11-23 11:04","name":"法国国际广播电台","title":"美加谈判有进展唯美方不满“中国牌” 民主党国会无力推翻总统决定","content":"美国贸易代表格里尔（JamiesonGreer）周日（22日）接受福克斯新闻（FoxNews）专访时，形容美加谈判已取得进展，“距离找到着陆区（landingzone）相当接近”。他将双边分歧轻描淡写为“哲学理念不同”，强调美加多数商品仍免关税，“这其实比外界想象的更正面，我们希望达成一份对美国好、也对加拿大好的协议”。格里尔对渥太华的唯一公开不满，则是点名加方近期与中国的经贸升温，特别是放宽中国电动车进口与钢铝关税减免。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E7%BE%8E%E5%8A%A0%E8%B0%88%E5%88%A4%E6%9C%89%E8%BF%9B%E5%B1%95%E5%94%AF%E7%BE%8E%E6%96%B9%E4%B8%8D%E6%BB%A1-%E4%B8%AD%E5%9B%BD%E7%89%8C-%E6%B0%91%E4%B8%BB%E5%85%9A%E5%9B%BD%E4%BC%9A%E6%97%A0%E5%8A%9B%E6%8E%A8%E7%BF%BB%E6%80%BB%E7%BB%9F%E5%86%B3%E5%AE%9A","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795431874000.webp","sourceId":"rfi"},{"id":1795431624000,"createdDate":"2026-11-23 11:00","name":"法国国际广播电台","title":"乌俄互袭升级　战火从黑海延伸至利比亚外海","content":"乌克兰总统泽伦斯基23日首度公开承认，乌军日前在利比亚外海发动两起针对俄罗斯船只的攻击行动，其中包括击沉一艘俄罗斯海军巡防舰，并重创另一艘负责运送武器的货轮。事件发生后，引发国际社会高度关注，联合国也呼吁针对攻击展开调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261123-%E4%B9%8C%E4%BF%84%E4%BA%92%E8%A2%AD%E5%8D%87%E7%BA%A7-%E6%88%98%E7%81%AB%E4%BB%8E%E9%BB%91%E6%B5%B7%E5%BB%B6%E4%BC%B8%E8%87%B3%E5%88%A9%E6%AF%94%E4%BA%9A%E5%A4%96%E6%B5%B7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795431624000.webp","sourceId":"rfi"},{"id":1795430693000,"createdDate":"2026-11-23 10:44","name":"法国国际广播电台","title":"香港电影夺金马六奖 《善男信女》成大赢家 港台电影人完成世代交指","content":"在台北举行的金马奖颁奖礼中，来自香港的袁澧林和台湾的刘冠廷分别当选影后和影帝，而港人杨两全自编自导的《善男信女》更夺得压轴的最佳原着剧本和最佳剧情片两个大奖，令香港在金马奖中夺得六个奖项，占奖项总数近四分之一。有评论指，港台两地年青人均在是次金马奖中大放异彩，高兴电影业得到接棒。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E9%A6%99%E6%B8%AF%E7%94%B5%E5%BD%B1%E5%A4%BA%E9%87%91%E9%A9%AC%E5%85%AD%E5%A5%96-%E5%96%84%E7%94%B7%E4%BF%A1%E5%A5%B3-%E6%88%90%E5%A4%A7%E8%B5%A2%E5%AE%B6-%E6%B8%AF%E5%8F%B0%E7%94%B5%E5%BD%B1%E4%BA%BA%E5%AE%8C%E6%88%90%E4%B8%96%E4%BB%A3%E4%BA%A4%E6%8C%87","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795430693000.webp","sourceId":"rfi"},{"id":1795430509000,"createdDate":"2026-11-23 10:41","name":"法国国际广播电台","title":"民主成分大减的选委会获近99%投票率产生  半年内将选出新一任特首","content":"负责选出行政长官与四成半立法会议员的选举委员会完成换届选举，在只有小圈子选举才有可能出现的接近百分百投票率中，723名须经投票竞逐的选委诞生，连同早前已登记的当然委员和无竞争界别产生的委员，新一届全数1479名选委出炉。不过，败选者中有近半数属应有优势的原选委，包括前财经事务及库务局局长陈家强；至於新当选者中，亦换入不少前高官。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261123-%E6%B0%91%E4%B8%BB%E6%88%90%E5%88%86%E5%A4%A7%E5%87%8F%E7%9A%84%E9%80%89%E5%A7%94%E4%BC%9A%E8%8E%B7%E8%BF%9199-%E6%8A%95%E7%A5%A8%E7%8E%87%E4%BA%A7%E7%94%9F-%E5%8D%8A%E5%B9%B4%E5%86%85%E5%B0%86%E9%80%89%E5%87%BA%E6%96%B0%E4%B8%80%E4%BB%BB%E7%89%B9%E9%A6%96","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795430509000.webp","sourceId":"rfi"},{"id":1795428694000,"createdDate":"2026-11-23 10:11","name":"法国国际广播电台","title":"黄乐据报从去年春季到今年秋季与国安部官员一直保持联系","content":"据《纽约时报》援引多位知晓美国情报报告——其中描述了相关接触情况——的人士透露，在英伟达丑闻的核心人物黄乐与黄仁勋保持秘密婚外情期间，她还与中国国家安全部的一名官员保持了长达一年多的联系。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261123-%E9%BB%84%E4%B9%90%E6%8D%AE%E6%8A%A5%E4%BB%8E%E5%8E%BB%E5%B9%B4%E6%98%A5%E5%AD%A3%E5%88%B0%E4%BB%8A%E5%B9%B4%E7%A7%8B%E5%AD%A3%E4%B8%8E%E5%9B%BD%E5%AE%89%E9%83%A8%E5%AE%98%E5%91%98%E4%B8%80%E7%9B%B4%E4%BF%9D%E6%8C%81%E8%81%94%E7%B3%BB","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795428694000.webp","sourceId":"rfi"},{"id":1795424916000,"createdDate":"2026-11-23 09:08","name":"法国国际广播电台","title":"两日本人在上海打架 一人死亡  中国媒体批日本报道误导舆论","content":"据多家媒体报道，在中国上海市18日发生了一起两个日本人打架，造成一名日本人死亡的事件，受害者和被当地警方拘留的日本人均为男性，且两人是朋友关系。据悉，两人于18日凌晨前往上海市内一家餐饮店后，因某种原因发生纠纷，其中一人疑似对另一人实施了暴力行为。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261123-%E4%B8%A4%E6%97%A5%E6%9C%AC%E4%BA%BA%E5%9C%A8%E4%B8%8A%E6%B5%B7%E6%89%93%E6%9E%B6-%E4%B8%80%E4%BA%BA%E6%AD%BB%E4%BA%A1-%E4%B8%AD%E5%9B%BD%E5%AA%92%E4%BD%93%E6%89%B9%E6%97%A5%E6%9C%AC%E6%8A%A5%E9%81%93%E8%AF%AF%E5%AF%BC%E8%88%86%E8%AE%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795424916000.webp","sourceId":"rfi"},{"id":1795423853000,"createdDate":"2026-11-23 08:50","name":"法国国际广播电台","title":"CNN：假招聘网站疑涉中国情报行动","content":"根据美国有线电视新闻网CNN最新调查，美国联邦调查局指出，疑似与中国情报机构有关的人员，近年透过伪装成顾问公司或智库，在LinkedIn等求职平台刊登高薪职缺，接触美国现任及离职政府官员、军方背景人士、记者以及国际事务研究人员，希望藉由委讬撰写研究报告，逐步搜集可能具有情报价值的资讯。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261123-cnn-%E5%81%87%E6%8B%9B%E8%81%98%E7%BD%91%E7%AB%99%E7%96%91%E6%B6%89%E4%B8%AD%E5%9B%BD%E6%83%85%E6%8A%A5%E8%A1%8C%E5%8A%A8","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795423853000.webp","sourceId":"rfi"},{"id":1795422049000,"createdDate":"2026-11-23 08:20","name":"法国国际广播电台","title":"欧洲思想文化长廊:希腊：欧洲文化永不磨灭的光辉：伯罗奔尼撒战争（下）","content":"斯巴达人决定投入战争，因为他们看到雅典的实力渐渐扩展到全希腊。无疑，雅典的精神文化的感召力使那些小城邦当中的才俊之士心生向往。他们或来雅典学习，或干脆搬到雅典。而且雅典的民主制度让人有自由的感觉。这些文化上的感召力背后是雅典日益增强的经济和军事实力。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A/20261123-%E6%AC%A7%E6%B4%B2%E6%80%9D%E6%83%B3%E6%96%87%E5%8C%96%E9%95%BF%E5%BB%8A-%E5%B8%8C%E8%85%8A-%E6%AC%A7%E6%B4%B2%E6%96%87%E5%8C%96%E6%B0%B8%E4%B8%8D%E7%A3%A8%E7%81%AD%E7%9A%84%E5%85%89%E8%BE%89-%E4%BC%AF%E7%BD%97%E5%A5%94%E5%B0%BC%E6%92%92%E6%88%98%E4%BA%89-%E4%B8%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/23/1795422049000.webp","sourceId":"rfi"}]