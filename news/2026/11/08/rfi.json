[{"id":1794150858000,"createdDate":"2026-11-08 15:14","name":"法国国际广播电台","title":"内讧？菲防长指外交动向不会影响菲方防务行动 菲外交部发长文呼吁声音一致","content":"菲律宾外交部周日对其他政府机构及官员就中国相关议题所发表的言论提出间接批评，指出这些言论可能会损害外交努力，并强调所有政府官员在应对相关问题时，应与小马科斯总统的政策方针保持一致。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E5%86%85%E8%AE%A7-%E8%8F%B2%E9%98%B2%E9%95%BF%E6%8C%87%E5%A4%96%E4%BA%A4%E5%8A%A8%E5%90%91%E4%B8%8D%E4%BC%9A%E5%BD%B1%E5%93%8D%E8%8F%B2%E6%96%B9%E9%98%B2%E5%8A%A1%E8%A1%8C%E5%8A%A8-%E8%8F%B2%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%91%E9%95%BF%E6%96%87%E5%91%BC%E5%90%81%E5%A3%B0%E9%9F%B3%E4%B8%80%E8%87%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794150858000.webp","sourceId":"rfi"},{"id":1794146828000,"createdDate":"2026-11-08 14:07","name":"法国国际广播电台","title":"COP31聚集点与中西方在中国大国责任担当上的不同解读","content":"第31届联合国气候峰会将于11月9日至20日在土耳其的海滨城市安塔利亚举行，在国际地缘政治形势紧绷的前提下，在伊朗战争导致能源危机的大背景下，此次峰会能否成为各国摆脱对化石能源依赖从而成为全球能源转型的一大转折点？另外，在全球碳排放大国美国的继续缺席下，中国作为第一大碳排放国是否终于将承担起大国的责任？最后，此次峰会的主要看点是什么？法广为此电话采访了法国可持续发展与国际关系学院的负责人SebastienTreyer先生以及绿色和平组织东亚办公室的气候项目负责人姚喆女士。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261108-cop31%E8%81%9A%E9%9B%86%E7%82%B9%E4%B8%8E%E4%B8%AD%E8%A5%BF%E6%96%B9%E5%9C%A8%E4%B8%AD%E5%9B%BD%E5%A4%A7%E5%9B%BD%E8%A7%92%E8%89%B2%E8%B4%A3%E4%BB%BB%E6%89%BF%E6%8B%85%E4%B8%8A%E7%9A%84%E8%90%BD%E5%B7%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794146828000.webp","sourceId":"rfi"},{"id":1794145436000,"createdDate":"2026-11-08 13:43","name":"法国国际广播电台","title":"高市据报曾打算驱逐威胁斩首的薛剑 在中方警告加倍奉还后作罢","content":"日本首相高市早苗去年11月7日在众议院接受质询时提到，如果“台湾有事”并伴随使用武力的情况，有可能构成触发和平安全法制中的“存亡危机事态”，日本可依此行使集体自卫权，不过仍要看实际发生的具体情况，引发中日外交紧张局势。次日，中国驻大阪总领事薛剑在其X账号上引用了关于高市国会答辩的报道，并附文称“只能毫不犹豫地斩掉那擅自闯入的肮脏头颅。你已经做好心理准备了吗？”据悉，高市事后一度考虑驱逐薛剑，却遭中方警告将加倍报复，最终暂缓行动。日中政府此后持续缺乏有效沟通，双边关系陷入低迷。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E9%AB%98%E5%B8%82%E6%8D%AE%E6%8A%A5%E6%9B%BE%E6%89%93%E7%AE%97%E9%A9%B1%E9%80%90%E5%A8%81%E8%83%81%E6%96%A9%E9%A6%96%E7%9A%84%E8%96%9B%E5%89%91-%E5%9C%A8%E4%B8%AD%E6%96%B9%E5%A8%81%E8%83%81%E5%8A%A0%E5%80%8D%E5%A5%89%E8%BF%98%E5%90%8E%E4%BD%9C%E7%BD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794145436000.webp","sourceId":"rfi"},{"id":1794141314000,"createdDate":"2026-11-08 12:35","name":"法国国际广播电台","title":"\"矛盾\"的中国：既是最大排放国，也是全球能源转型重要推手","content":"今天的要闻解说栏目要介绍的内容源自一篇路透社的深度调查，这篇调查主要在讲中国如何凭借政府和国家政策主导的绿色产业重塑全球气候机制和绿色能源市场。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261108-%E7%9F%9B%E7%9B%BE-%E7%9A%84%E4%B8%AD%E5%9B%BD-%E6%97%A2%E6%98%AF%E6%9C%80%E5%A4%A7%E6%8E%92%E6%94%BE%E5%9B%BD%EF%BC%8C%E4%B9%9F%E6%98%AF%E5%85%A8%E7%90%83%E8%83%BD%E6%BA%90%E8%BD%AC%E5%9E%8B%E9%87%8D%E8%A6%81%E6%8E%A8%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794141314000.webp","sourceId":"rfi"},{"id":1794140018000,"createdDate":"2026-11-08 12:13","name":"法国国际广播电台","title":"中国缺乏能纠正长期失衡的宏观经济战略?","content":"周末版《世界报》头版内容相当丰富，关注焦点多元。头条报道的是法国高中生的运动持续；头版配图新闻关注的是斯蒂芬·米勒（，美国总统特朗普的忠实顾问，一位被指热衷于阴谋论的人，将接替苏西·威尔斯的职位，出任白宫幕僚长，此举被视为共和党试图转移人们对11月3日中期选举失利的注意力的孤注一掷之举。即将开幕的土耳其联合国气候峰会以及法国总统大选相关议题也都在内文有不同篇幅的的报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261108-%E4%B8%AD%E5%9B%BD%E7%BC%BA%E4%B9%8F%E8%83%BD%E7%BA%A0%E6%AD%A3%E9%95%BF%E6%9C%9F%E5%A4%B1%E8%A1%A1%E7%9A%84%E5%AE%8F%E8%A7%82%E7%BB%8F%E6%B5%8E%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794140018000.webp","sourceId":"rfi"},{"id":1794139446000,"createdDate":"2026-11-08 12:04","name":"法国国际广播电台","title":"克宫：俄美中正就潜在深圳三方峰会拟定议程，须就此达成共识","content":"俄罗斯总统新闻秘书佩斯科夫最新在受访时表示，在本月将于深圳举行的亚太经合组织（APEC）峰会召开前夕，俄罗斯、美国和中国正为三国领导人可能举行的会晤议程提出建议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E5%85%8B%E5%AE%AB-%E4%BF%84%E7%BE%8E%E4%B8%AD%E6%AD%A3%E5%B0%B1%E6%BD%9C%E5%9C%A8%E6%B7%B1%E5%9C%B3%E4%B8%89%E6%96%B9%E5%B3%B0%E4%BC%9A%E6%8B%9F%E5%AE%9A%E8%AE%AE%E7%A8%8B%EF%BC%8C%E9%A1%BB%E5%B0%B1%E6%AD%A4%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794139446000.webp","sourceId":"rfi"},{"id":1794134562000,"createdDate":"2026-11-08 10:42","name":"法国国际广播电台","title":"美俄乌三方会谈下周登场前  俄继续空袭乌能源基础设施致数十万用户断电","content":"乌克兰当局和能源供应商周日（11月8号）宣布，俄罗斯周六晚至周日凌晨对乌克兰能源基础设施发动的新一轮空袭，导致第聂伯罗彼得罗夫斯克州和哈尔科夫州数十万用户断电。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E7%BE%8E%E4%BF%84%E4%B9%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88%E4%B8%8B%E5%91%A8%E7%99%BB%E5%9C%BA%E5%89%8D-%E4%BF%84%E7%BB%A7%E7%BB%AD%E7%A9%BA%E8%A2%AD%E4%B9%8C%E8%83%BD%E6%BA%90%E5%9F%BA%E7%A1%80%E8%AE%BE%E6%96%BD%E8%87%B4%E6%95%B0%E5%8D%81%E4%B8%87%E7%94%A8%E6%88%B7%E6%96%AD%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794134562000.webp","sourceId":"rfi"},{"id":1794134335000,"createdDate":"2026-11-08 10:38","name":"法国国际广播电台","title":"在中国 人工智能现正通过电视购物频道进行销售 出现火爆现象","content":"在中国的一次网络直播中，阿里巴巴旗下人工智能助手“千问办公”QwenWork的月度订阅服务在短短30分钟内就售出了约10万份。但是，这次活动的目的并非在于销售额。法媒关注指出，人工智能现在中国，正通过电视购物频道进行，而且“千问办公”销售火爆，可说一炮而红。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261108-%E5%9C%A8%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%8E%B0%E6%AD%A3%E9%80%9A%E8%BF%87%E7%94%B5%E8%A7%86%E8%B4%AD%E7%89%A9%E9%A2%91%E9%81%93%E8%BF%9B%E8%A1%8C%E9%94%80%E5%94%AE%EF%BC%8C%E5%8D%83%E9%97%AE%E9%94%80%E5%94%AE%E7%81%AB%E7%88%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794134335000.webp","sourceId":"rfi"},{"id":1794133227000,"createdDate":"2026-11-08 10:20","name":"法国国际广播电台","title":"黄仁勋卷入女间谍风波面临国会两党压力 民主党要员誓言将展开调查","content":"英伟达首席执行官黄仁勋正面临美国国会两党议员日益加强的审视。此前，周五有多篇报道称，他曾与一名美国官员认定是中国间谍的女子存在“恋爱”关系。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%8D%B7%E5%85%A5%E5%A5%B3%E9%97%B4%E8%B0%8D%E9%A3%8E%E6%B3%A2%E9%9D%A2%E4%B8%B4%E5%9B%BD%E4%BC%9A%E4%B8%A4%E5%85%9A%E5%8E%8B%E5%8A%9B-%E6%B0%91%E4%B8%BB%E5%85%9A%E8%A6%81%E5%91%98%E8%AA%93%E8%A8%80%E5%B0%86%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794133227000.webp","sourceId":"rfi"},{"id":1794130066000,"createdDate":"2026-11-08 09:27","name":"法国国际广播电台","title":"英国王室顾问透露，查尔斯三世愿考虑对中国进行国是访问，其母伊丽莎白二世曾在香港回归前访华","content":"法新社周六（11月7日）消息称，英国国王查尔斯三世愿意考虑对中国进行国是访问。英国王室一名顾问表示，如果英国政府提出这一建议，国王将认真考虑。40年前，查尔斯三世的母亲伊丽莎白二世女王曾对中国进行过国是访问，当时的中国国家主席为李先念，这是迄今为止英国君主对中国进行的唯一一次国是访问。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E8%8B%B1%E5%9B%BD%E7%8E%8B%E5%AE%A4%E9%A1%BE%E9%97%AE%E9%80%8F%E9%9C%B2%EF%BC%8C%E6%9F%A5%E5%B0%94%E6%96%AF%E4%B8%89%E4%B8%96%E6%84%BF%E8%80%83%E8%99%91%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%BF%9B%E8%A1%8C%E5%9B%BD%E6%98%AF%E8%AE%BF%E9%97%AE%EF%BC%8C%E5%85%B6%E6%AF%8D%E4%BC%8A%E4%B8%BD%E8%8E%8E%E7%99%BD%E4%BA%8C%E4%B8%96%E6%9B%BE%E5%9C%A8%E9%A6%99%E6%B8%AF%E5%9B%9E%E5%BD%92%E5%89%8D%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794130066000.webp","sourceId":"rfi"},{"id":1794129122000,"createdDate":"2026-11-08 09:12","name":"法国国际广播电台","title":"台湾基于国家尊严主动关闭驻巴布亚新几内亚驻处 台湾学者称重伤的反而会是对方","content":"面对外交争议再度升高，台湾外交部在6日宣布主动关闭驻巴布亚新几内亚代表处。台湾学者叶耀元坦言，台湾占有巴国液化天然气输出的三分之一，且液化天然气又是其重要经济命脉，可以推测巴国内部的企业会有反弹。台湾还有与美国阿拉斯加的液化天燃气合约，所以短时间内不会造成太大的产业冲击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E5%8F%B0%E6%B9%BE%E5%9F%BA%E4%BA%8E%E5%9B%BD%E5%AE%B6%E5%B0%8A%E4%B8%A5%E4%B8%BB%E5%8A%A8%E5%85%B3%E9%97%AD%E9%A9%BB%E5%B7%B4%E5%B8%83%E4%BA%9A%E6%96%B0%E5%87%A0%E5%86%85%E4%BA%9A%E9%A9%BB%E5%A4%84-%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85%E7%A7%B0%E9%87%8D%E4%BC%A4%E7%9A%84%E5%8F%8D%E8%80%8C%E4%BC%9A%E6%98%AF%E5%AF%B9%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794129122000.webp","sourceId":"rfi"},{"id":1794128863000,"createdDate":"2026-11-08 09:07","name":"法国国际广播电台","title":"日本安保三文件将明确提出加强“续战能力”","content":"日本共同社2026年11月8日报道称，日本政府已开始研究在年底修订的三份安全保障相关文件之一《国家防卫战略》中，明确提出加强“续战能力”，即在战斗长期持续的情况下应对战争的能力。多名相关人士于7日透露了这一消息。鉴于俄罗斯对乌克兰的入侵已持续四年以上，暴露出诸多问题，日本政府将推进平时的弹药和导弹储备，并确保在发生紧急事态时能够扩大生产。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E6%97%A5%E6%9C%AC%E5%AE%89%E4%BF%9D%E4%B8%89%E6%96%87%E4%BB%B6%E5%B0%86%E6%98%8E%E7%A1%AE%E6%8F%90%E5%87%BA%E5%8A%A0%E5%BC%BA-%E7%BB%AD%E6%88%98%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794128863000.webp","sourceId":"rfi"}]