[{"id":1794150858000,"createdDate":"2026-11-08 15:14","name":"法国国际广播电台","title":"内讧？菲防长指外交动向不会影响菲方防务行动 菲外交部发长文呼吁声音一致","content":"菲律宾外交部周日对其他政府机构及官员就中国相关议题所发表的言论提出间接批评，指出这些言论可能会损害外交努力，并强调所有政府官员在应对相关问题时，应与小马科斯总统的政策方针保持一致。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E5%86%85%E8%AE%A7-%E8%8F%B2%E9%98%B2%E9%95%BF%E6%8C%87%E5%A4%96%E4%BA%A4%E5%8A%A8%E5%90%91%E4%B8%8D%E4%BC%9A%E5%BD%B1%E5%93%8D%E8%8F%B2%E6%96%B9%E9%98%B2%E5%8A%A1%E8%A1%8C%E5%8A%A8-%E8%8F%B2%E5%A4%96%E4%BA%A4%E9%83%A8%E5%8F%91%E9%95%BF%E6%96%87%E5%91%BC%E5%90%81%E5%A3%B0%E9%9F%B3%E4%B8%80%E8%87%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794150858000.webp","sourceId":"rfi"},{"id":1794146828000,"createdDate":"2026-11-08 14:07","name":"法国国际广播电台","title":"COP31聚集点与中西方在中国大国责任担当上的不同解读","content":"第31届联合国气候峰会将于11月9日至20日在土耳其的海滨城市安塔利亚举行，在国际地缘政治形势紧绷的前提下，在伊朗战争导致能源危机的大背景下，此次峰会能否成为各国摆脱对化石能源依赖从而成为全球能源转型的一大转折点？另外，在全球碳排放大国美国的继续缺席下，中国作为第一大碳排放国是否终于将承担起大国的责任？最后，此次峰会的主要看点是什么？法广为此电话采访了法国可持续发展与国际关系学院的负责人SebastienTreyer先生以及绿色和平组织东亚办公室的气候项目负责人姚喆女士。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E7%8E%AF%E5%A2%83%E4%B8%8E%E5%8F%91%E5%B1%95/20261108-cop31%E8%81%9A%E9%9B%86%E7%82%B9%E4%B8%8E%E4%B8%AD%E8%A5%BF%E6%96%B9%E5%9C%A8%E4%B8%AD%E5%9B%BD%E5%A4%A7%E5%9B%BD%E8%A7%92%E8%89%B2%E8%B4%A3%E4%BB%BB%E6%89%BF%E6%8B%85%E4%B8%8A%E7%9A%84%E8%90%BD%E5%B7%AE","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794146828000.webp","sourceId":"rfi"},{"id":1794145436000,"createdDate":"2026-11-08 13:43","name":"法国国际广播电台","title":"高市据报曾打算驱逐威胁斩首的薛剑 在中方警告加倍奉还后作罢","content":"日本首相高市早苗去年11月7日在众议院接受质询时提到，如果“台湾有事”并伴随使用武力的情况，有可能构成触发和平安全法制中的“存亡危机事态”，日本可依此行使集体自卫权，不过仍要看实际发生的具体情况，引发中日外交紧张局势。次日，中国驻大阪总领事薛剑在其X账号上引用了关于高市国会答辩的报道，并附文称“只能毫不犹豫地斩掉那擅自闯入的肮脏头颅。你已经做好心理准备了吗？”据悉，高市事后一度考虑驱逐薛剑，却遭中方警告将加倍报复，最终暂缓行动。日中政府此后持续缺乏有效沟通，双边关系陷入低迷。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E9%AB%98%E5%B8%82%E6%8D%AE%E6%8A%A5%E6%9B%BE%E6%89%93%E7%AE%97%E9%A9%B1%E9%80%90%E5%A8%81%E8%83%81%E6%96%A9%E9%A6%96%E7%9A%84%E8%96%9B%E5%89%91-%E5%9C%A8%E4%B8%AD%E6%96%B9%E5%A8%81%E8%83%81%E5%8A%A0%E5%80%8D%E5%A5%89%E8%BF%98%E5%90%8E%E4%BD%9C%E7%BD%A2","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794145436000.webp","sourceId":"rfi"},{"id":1794141314000,"createdDate":"2026-11-08 12:35","name":"法国国际广播电台","title":"\"矛盾\"的中国：既是最大排放国，也是全球能源转型重要推手","content":"今天的要闻解说栏目要介绍的内容源自一篇路透社的深度调查，这篇调查主要在讲中国如何凭借政府和国家政策主导的绿色产业重塑全球气候机制和绿色能源市场。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E8%A7%A3%E8%AF%B4/20261108-%E7%9F%9B%E7%9B%BE-%E7%9A%84%E4%B8%AD%E5%9B%BD-%E6%97%A2%E6%98%AF%E6%9C%80%E5%A4%A7%E6%8E%92%E6%94%BE%E5%9B%BD%EF%BC%8C%E4%B9%9F%E6%98%AF%E5%85%A8%E7%90%83%E8%83%BD%E6%BA%90%E8%BD%AC%E5%9E%8B%E9%87%8D%E8%A6%81%E6%8E%A8%E6%89%8B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794141314000.webp","sourceId":"rfi"},{"id":1794140018000,"createdDate":"2026-11-08 12:13","name":"法国国际广播电台","title":"中国缺乏能纠正长期失衡的宏观经济战略?","content":"周末版《世界报》头版内容相当丰富，关注焦点多元。头条报道的是法国高中生的运动持续；头版配图新闻关注的是斯蒂芬·米勒（，美国总统特朗普的忠实顾问，一位被指热衷于阴谋论的人，将接替苏西·威尔斯的职位，出任白宫幕僚长，此举被视为共和党试图转移人们对11月3日中期选举失利的注意力的孤注一掷之举。即将开幕的土耳其联合国气候峰会以及法国总统大选相关议题也都在内文有不同篇幅的的报道。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E6%B3%95%E5%9B%BD%E4%B8%96%E7%95%8C%E6%8A%A5/20261108-%E4%B8%AD%E5%9B%BD%E7%BC%BA%E4%B9%8F%E8%83%BD%E7%BA%A0%E6%AD%A3%E9%95%BF%E6%9C%9F%E5%A4%B1%E8%A1%A1%E7%9A%84%E5%AE%8F%E8%A7%82%E7%BB%8F%E6%B5%8E%E6%88%98%E7%95%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794140018000.webp","sourceId":"rfi"},{"id":1794139446000,"createdDate":"2026-11-08 12:04","name":"法国国际广播电台","title":"克宫：俄美中正就潜在深圳三方峰会拟定议程，须就此达成共识","content":"俄罗斯总统新闻秘书佩斯科夫最新在受访时表示，在本月将于深圳举行的亚太经合组织（APEC）峰会召开前夕，俄罗斯、美国和中国正为三国领导人可能举行的会晤议程提出建议。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E5%85%8B%E5%AE%AB-%E4%BF%84%E7%BE%8E%E4%B8%AD%E6%AD%A3%E5%B0%B1%E6%BD%9C%E5%9C%A8%E6%B7%B1%E5%9C%B3%E4%B8%89%E6%96%B9%E5%B3%B0%E4%BC%9A%E6%8B%9F%E5%AE%9A%E8%AE%AE%E7%A8%8B%EF%BC%8C%E9%A1%BB%E5%B0%B1%E6%AD%A4%E8%BE%BE%E6%88%90%E5%85%B1%E8%AF%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794139446000.webp","sourceId":"rfi"},{"id":1794134562000,"createdDate":"2026-11-08 10:42","name":"法国国际广播电台","title":"美俄乌三方会谈下周登场前  俄继续空袭乌能源基础设施致数十万用户断电","content":"乌克兰当局和能源供应商周日（11月8号）宣布，俄罗斯周六晚至周日凌晨对乌克兰能源基础设施发动的新一轮空袭，导致第聂伯罗彼得罗夫斯克州和哈尔科夫州数十万用户断电。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E7%BE%8E%E4%BF%84%E4%B9%8C%E4%B8%89%E6%96%B9%E4%BC%9A%E8%B0%88%E4%B8%8B%E5%91%A8%E7%99%BB%E5%9C%BA%E5%89%8D-%E4%BF%84%E7%BB%A7%E7%BB%AD%E7%A9%BA%E8%A2%AD%E4%B9%8C%E8%83%BD%E6%BA%90%E5%9F%BA%E7%A1%80%E8%AE%BE%E6%96%BD%E8%87%B4%E6%95%B0%E5%8D%81%E4%B8%87%E7%94%A8%E6%88%B7%E6%96%AD%E7%94%B5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794134562000.webp","sourceId":"rfi"},{"id":1794134335000,"createdDate":"2026-11-08 10:38","name":"法国国际广播电台","title":"在中国 人工智能现正通过电视购物频道进行销售 出现火爆现象","content":"在中国的一次网络直播中，阿里巴巴旗下人工智能助手“千问办公”QwenWork的月度订阅服务在短短30分钟内就售出了约10万份。但是，这次活动的目的并非在于销售额。法媒关注指出，人工智能现在中国，正通过电视购物频道进行，而且“千问办公”销售火爆，可说一炮而红。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261108-%E5%9C%A8%E4%B8%AD%E5%9B%BD%EF%BC%8C%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E7%8E%B0%E6%AD%A3%E9%80%9A%E8%BF%87%E7%94%B5%E8%A7%86%E8%B4%AD%E7%89%A9%E9%A2%91%E9%81%93%E8%BF%9B%E8%A1%8C%E9%94%80%E5%94%AE%EF%BC%8C%E5%8D%83%E9%97%AE%E9%94%80%E5%94%AE%E7%81%AB%E7%88%86","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794134335000.webp","sourceId":"rfi"},{"id":1794133227000,"createdDate":"2026-11-08 10:20","name":"法国国际广播电台","title":"黄仁勋卷入女间谍风波面临国会两党压力 民主党要员誓言将展开调查","content":"英伟达首席执行官黄仁勋正面临美国国会两党议员日益加强的审视。此前，周五有多篇报道称，他曾与一名美国官员认定是中国间谍的女子存在“恋爱”关系。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E9%BB%84%E4%BB%81%E5%8B%8B%E5%8D%B7%E5%85%A5%E5%A5%B3%E9%97%B4%E8%B0%8D%E9%A3%8E%E6%B3%A2%E9%9D%A2%E4%B8%B4%E5%9B%BD%E4%BC%9A%E4%B8%A4%E5%85%9A%E5%8E%8B%E5%8A%9B-%E6%B0%91%E4%B8%BB%E5%85%9A%E8%A6%81%E5%91%98%E8%AA%93%E8%A8%80%E5%B0%86%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794133227000.webp","sourceId":"rfi"},{"id":1794130066000,"createdDate":"2026-11-08 09:27","name":"法国国际广播电台","title":"英国王室顾问透露，查尔斯三世愿考虑对中国进行国是访问，其母伊丽莎白二世曾在香港回归前访华","content":"法新社周六（11月7日）消息称，英国国王查尔斯三世愿意考虑对中国进行国是访问。英国王室一名顾问表示，如果英国政府提出这一建议，国王将认真考虑。40年前，查尔斯三世的母亲伊丽莎白二世女王曾对中国进行过国是访问，当时的中国国家主席为李先念，这是迄今为止英国君主对中国进行的唯一一次国是访问。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E8%8B%B1%E5%9B%BD%E7%8E%8B%E5%AE%A4%E9%A1%BE%E9%97%AE%E9%80%8F%E9%9C%B2%EF%BC%8C%E6%9F%A5%E5%B0%94%E6%96%AF%E4%B8%89%E4%B8%96%E6%84%BF%E8%80%83%E8%99%91%E5%AF%B9%E4%B8%AD%E5%9B%BD%E8%BF%9B%E8%A1%8C%E5%9B%BD%E6%98%AF%E8%AE%BF%E9%97%AE%EF%BC%8C%E5%85%B6%E6%AF%8D%E4%BC%8A%E4%B8%BD%E8%8E%8E%E7%99%BD%E4%BA%8C%E4%B8%96%E6%9B%BE%E5%9C%A8%E9%A6%99%E6%B8%AF%E5%9B%9E%E5%BD%92%E5%89%8D%E8%AE%BF%E5%8D%8E","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794130066000.webp","sourceId":"rfi"},{"id":1794129122000,"createdDate":"2026-11-08 09:12","name":"法国国际广播电台","title":"台湾基于国家尊严主动关闭驻巴布亚新几内亚驻处 台湾学者称重伤的反而会是对方","content":"面对外交争议再度升高，台湾外交部在6日宣布主动关闭驻巴布亚新几内亚代表处。台湾学者叶耀元坦言，台湾占有巴国液化天然气输出的三分之一，且液化天然气又是其重要经济命脉，可以推测巴国内部的企业会有反弹。台湾还有与美国阿拉斯加的液化天燃气合约，所以短时间内不会造成太大的产业冲击。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E5%8F%B0%E6%B9%BE%E5%9F%BA%E4%BA%8E%E5%9B%BD%E5%AE%B6%E5%B0%8A%E4%B8%A5%E4%B8%BB%E5%8A%A8%E5%85%B3%E9%97%AD%E9%A9%BB%E5%B7%B4%E5%B8%83%E4%BA%9A%E6%96%B0%E5%87%A0%E5%86%85%E4%BA%9A%E9%A9%BB%E5%A4%84-%E5%8F%B0%E6%B9%BE%E5%AD%A6%E8%80%85%E7%A7%B0%E9%87%8D%E4%BC%A4%E7%9A%84%E5%8F%8D%E8%80%8C%E4%BC%9A%E6%98%AF%E5%AF%B9%E6%96%B9","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794129122000.webp","sourceId":"rfi"},{"id":1794128863000,"createdDate":"2026-11-08 09:07","name":"法国国际广播电台","title":"日本安保三文件将明确提出加强“续战能力”","content":"日本共同社2026年11月8日报道称，日本政府已开始研究在年底修订的三份安全保障相关文件之一《国家防卫战略》中，明确提出加强“续战能力”，即在战斗长期持续的情况下应对战争的能力。多名相关人士于7日透露了这一消息。鉴于俄罗斯对乌克兰的入侵已持续四年以上，暴露出诸多问题，日本政府将推进平时的弹药和导弹储备，并确保在发生紧急事态时能够扩大生产。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E6%97%A5%E6%9C%AC%E5%AE%89%E4%BF%9D%E4%B8%89%E6%96%87%E4%BB%B6%E5%B0%86%E6%98%8E%E7%A1%AE%E6%8F%90%E5%87%BA%E5%8A%A0%E5%BC%BA-%E7%BB%AD%E6%88%98%E8%83%BD%E5%8A%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794128863000.webp","sourceId":"rfi"},{"id":1794170527000,"createdDate":"2026-11-08 20:42","name":"法国国际广播电台","title":"《南德意志报》：黄之锋是整整一代人的象征","content":"德国多份媒体对香港民主活动人士黄之锋（JoshuaWong）被判十年监禁表示了关注。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E5%8D%97%E5%BE%B7%E6%84%8F%E5%BF%97%E6%8A%A5-%E9%BB%84%E4%B9%8B%E9%94%8B%E6%98%AF%E6%95%B4%E6%95%B4%E4%B8%80%E4%BB%A3%E4%BA%BA%E7%9A%84%E8%B1%A1%E5%BE%81","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794170527000.webp","sourceId":"rfi"},{"id":1794165149000,"createdDate":"2026-11-08 19:12","name":"法国国际广播电台","title":"教宗良14世访南美3国10城 计划行程3万公里讲演36场","content":"罗马天主教教宗良十四世（PopeLeoXIV）11月8日将前往阿根廷，展开为期12天南美洲之旅的第2站行程。这位71岁教宗接受肺腺癌手术还不到一个月，就展开数十年来天主教领袖最密集的出访行程之一。","newsLink":"https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20261108-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E8%AE%BF%E5%8D%97%E7%BE%8E%E4%B8%89%E5%9B%BD%E5%8D%81%E5%9F%8E%E8%A1%8C%E7%A8%8B3%E4%B8%87%E5%85%AC%E9%87%8C%E5%8F%91%E8%A1%A836%E5%9C%BA%E6%BC%94%E8%AF%B4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794165149000.webp","sourceId":"rfi"},{"id":1794159158000,"createdDate":"2026-11-08 17:32","name":"法国国际广播电台","title":"美众院准备弹劾赫格塞思 部分共和党议员或将倒戈","content":"美国众议院共和党领导层正严阵以待，防范本周在针对战争部长赫格塞思（PeteHegseth）的弹劾动议进行表决时，出现足够多的共和党人倒戈。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E7%BE%8E%E4%BC%97%E9%99%A2%E5%87%86%E5%A4%87%E5%BC%B9%E5%8A%BE%E8%B5%AB%E6%A0%BC%E5%A1%9E%E6%80%9D-%E9%83%A8%E5%88%86%E5%85%B1%E5%92%8C%E5%85%9A%E8%AE%AE%E5%91%98%E6%88%96%E5%B0%86%E5%80%92%E6%88%88","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794159158000.webp","sourceId":"rfi"},{"id":1794157607000,"createdDate":"2026-11-08 17:06","name":"法国国际广播电台","title":"小泉提打破陆海空自卫队界限新组织架构 日外相拟巴黎会鲁比奥","content":"围绕日本政府对“安保三文件”的修订，防卫大臣小泉进次郎指出，在人口不断减少的背景下，确保必要的自卫队员人数并非易事；他表示，希望探讨一种打破陆、海、空自卫队界限的组织架构，以期提升防卫力。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E5%B0%8F%E6%B3%89%E6%8F%90%E6%89%93%E7%A0%B4%E9%99%86%E6%B5%B7%E7%A9%BA%E8%87%AA%E5%8D%AB%E9%98%9F%E7%95%8C%E9%99%90%E6%96%B0%E7%BB%84%E7%BB%87%E6%9E%B6%E6%9E%84-%E6%97%A5%E5%A4%96%E7%9B%B8%E6%8B%9F%E5%B7%B4%E9%BB%8E%E4%BC%9A%E9%B2%81%E6%AF%94%E5%A5%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794157607000.webp","sourceId":"rfi"},{"id":1794157460000,"createdDate":"2026-11-08 17:04","name":"法国国际广播电台","title":"特朗普长期亲信米勒将接任白宫幕僚长 移民政策恐再缩紧","content":"美国总统特朗普（DonaldTrump）宣布任命长期亲信、现任白宫副幕僚长兼国土安全顾问米勒（StephenMiller）接替威尔斯（SusieWiles），出任新任白宫幕僚长，预计11月9日正式上任。米勒是特朗普强硬移民政策的主要推手，长期主张大规模遣返非法移民、加强边境管制及扩大总统行政权力。他在共和党中期选举遭遇重大挫败后获得升迁，外界预料，特朗普政府不但不会放宽移民政策，反而可能进一步加强执法，并以更强硬姿态应对民主党控制的国会。","newsLink":"https://www.rfi.fr/cn/%E6%94%BF%E6%B2%BB/20261108-%E7%89%B9%E6%9C%97%E6%99%AE%E9%95%BF%E6%9C%9F%E4%BA%B2%E4%BF%A1%E7%B1%B3%E5%8B%92%E5%B0%86%E6%8E%A5%E4%BB%BB%E7%99%BD%E5%AE%AB%E5%B9%95%E5%83%9A%E9%95%BF-%E7%A7%BB%E6%B0%91%E6%94%BF%E7%AD%96%E6%81%90%E5%86%8D%E7%BC%A9%E7%B4%A7","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794157460000.webp","sourceId":"rfi"},{"id":1794155532000,"createdDate":"2026-11-08 16:32","name":"法国国际广播电台","title":"英高官指已就中使馆人员向示威者挥舞疑似非法电棍向大使提出交涉","content":"据英国《i报》披露，英国外交部就有关中国驻英国大使馆安保人员向抗议者挥舞非法电击武器的指控，向中国驻英大使郑泽光提出了交涉。据称，在伦敦市中心中国驻英使馆外举行的一场抗议活动中，使馆安保人员曾用电击棍指向抗议者，意图以此进行恐吓。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261108-%E8%8B%B1%E9%AB%98%E5%AE%98%E6%8C%87%E5%B7%B2%E5%B0%B1%E4%B8%AD%E4%BD%BF%E9%A6%86%E4%BA%BA%E5%91%98%E5%90%91%E7%A4%BA%E5%A8%81%E8%80%85%E6%8C%A5%E8%88%9E%E7%96%91%E4%BC%BC%E9%9D%9E%E6%B3%95%E7%94%B5%E6%A3%8D%E5%90%91%E5%A4%A7%E4%BD%BF%E6%8F%90%E5%87%BA%E4%BA%A4%E6%B6%89","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794155532000.webp","sourceId":"rfi"},{"id":1794180347000,"createdDate":"2026-11-08 23:25","name":"法国国际广播电台","title":"非洲:2026青奥会男子3人篮球赛","content":"法广（RFI）中文[周日体育]（Sportdimanche）继续关注正在非洲国家塞内加尔(leSénégal)首都达喀尔举办的第四届夏季青年奥林匹克运动会（JOJDakar2026）。综合本台体育组（RFISports）的多篇法文消息，本届青奥会(JOJ)男子三人篮球项目（basket3x3masculin）已于两天前的11月06日本星期五拉开战幕。法广特派记者（RFIEnvoyéspécial）发自现场的实地报道描述说，达喀尔全城当天洋溢着激动人心的氛围，观众的热情让赛场气氛格外火热。主场的塞内加尔队当天连赢两场，先后战胜阿尔及利亚队（16-13）和立陶宛队（21-12）。多名队员接受了现场采访。而今天（11月08号星期日）的最新战报则是：塞内加尔男队再接再厉，在数小时前又以20对11的比分击败蒙古队。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261108-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-2026%E9%9D%92%E5%A5%A5%E4%BC%9A3%E4%BA%BA%E7%AF%AE%E7%90%83%E8%B5%9B","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794180347000.webp","sourceId":"rfi"},{"id":1794174947000,"createdDate":"2026-11-08 21:55","name":"法国国际广播电台","title":"非洲:几内亚逐十万淘金人入马里","content":"在非洲内陆国马里（leMali），有数以万计遭几内亚驱逐的手工淘金人在过去几天里入境。这是本台法广非洲组（RFIAfrique）今天（2026年11月08号星期日）的法文更新消息之一。马里安全与民防部于11月07日周六晚发布的统计数据显示，已有超过十万人（+100000orpailleurs）抵达首都巴马科地区，另外还有六万人在一百多公里外的边境地带。目前已知至少六人死亡。马里过渡当局已经给这些从几内亚入境的外国淘金客提供了人道援助。下一步是要送他们回国。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261108-rfi%E6%B3%95%E5%B9%BF-%E4%B8%AD%E6%96%87-%E5%B0%BC%E5%8F%A4%E6%8B%89-%E9%9D%9E%E6%B4%B2-%E5%87%A0%E5%86%85%E4%BA%9A%E9%80%90%E5%8D%81%E4%B8%87%E6%B7%98%E9%87%91%E4%BA%BA%E5%85%A5%E9%A9%AC%E9%87%8C","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794174947000.webp","sourceId":"rfi"},{"id":1794172441000,"createdDate":"2026-11-08 21:14","name":"法国国际广播电台","title":"特朗普：“重燃战火的可能性非常小”","content":"伊朗外长阿巴斯·阿拉格奇（AbbasAraghchi）周日表示，近期为解决中东冲突而加强的外交努力因特朗普阵营在中期选举中失利带来的“冲击”而陷入停滞。11月8日，美国总统特朗普在接受CNN采访时表示：“重燃战火的可能性非常小。”","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E4%B8%9C/20261108-%E7%89%B9%E6%9C%97%E6%99%AE-%E9%87%8D%E7%87%83%E6%88%98%E7%81%AB%E7%9A%84%E5%8F%AF%E8%83%BD%E6%80%A7%E9%9D%9E%E5%B8%B8%E5%B0%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794172441000.webp","sourceId":"rfi"},{"id":1794172228000,"createdDate":"2026-11-08 21:10","name":"法国国际广播电台","title":"法国外长：“梅郎雄完全成为克里姆林宫代言人”","content":"法国外长周日表示，不屈服法兰西党领袖让-吕克·梅朗雄“简直成了克里姆林宫的的代言人”，因为他提议应该就顿巴斯地区的命运征询当地民众的意见。顿巴斯是乌克兰东部一个大部分被俄罗斯占领的地区。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261108-%E6%B3%95%E5%9B%BD%E5%A4%96%E9%95%BF-%E6%A2%85%E9%83%8E%E9%9B%84%E5%AE%8C%E5%85%A8%E6%88%90%E4%B8%BA%E5%85%8B%E9%87%8C%E5%A7%86%E6%9E%97%E5%AE%AB%E4%BB%A3%E8%A8%80%E4%BA%BA","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794172228000.webp","sourceId":"rfi"},{"id":1794171958000,"createdDate":"2026-11-08 21:05","name":"法国国际广播电台","title":"埃及列车追尾   司机死亡   4死   88人受伤","content":"周日，两列火车在埃及首都开罗南部相撞，造成至少4人死亡，数88受伤，4节车厢脱轨。铁路部门称，一列从尼罗河西岸吉萨（Gizeh）开往法尤姆（Fayoum）的火车撞上了另一列从开罗开往阿苏安（Assouan）的火车尾部。这些地点都是重要的旅游景点。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261108-%E5%9F%83%E5%8F%8A%E5%88%97%E8%BD%A6%E8%BF%BD%E5%B0%BE-%E5%8F%B8%E6%9C%BA%E6%AD%BB%E4%BA%A1-4%E6%AD%BB-88%E4%BA%BA%E5%8F%97%E4%BC%A4","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171958000.webp","sourceId":"rfi"},{"id":1794171897000,"createdDate":"2026-11-08 21:04","name":"法国国际广播电台","title":"黄仁勋承认婚外情向家人道歉 英伟达董事会声明：将对黄仁勋与疑似中国间谍的女商人的关系展开调查","content":"据CNBC的报道：英伟达已经对联合创始人兼首席执行官黄仁勋与一名情报机构称是中国间谍的女商人的关系展开调查。","newsLink":"https://www.rfi.fr/cn/%E4%B8%AD%E5%9B%BD/20261108-%E8%8B%B1%E4%BC%9F%E8%BE%BE%E8%91%A3%E4%BA%8B%E4%BC%9A%E5%8F%91%E8%A1%A8%E5%A3%B0%E6%98%8E%E5%B0%86%E5%AF%B9%E9%BB%84%E4%BB%81%E5%8B%8B%E4%B8%8E%E4%B8%80%E5%90%8D%E6%83%85%E6%8A%A5%E6%9C%BA%E6%9E%84%E7%A7%B0%E6%98%AF%E4%B8%AD%E5%9B%BD%E9%97%B4%E8%B0%8D%E7%9A%84%E5%A5%B3%E5%95%86%E4%BA%BA%E7%9A%84%E5%85%B3%E7%B3%BB%E5%B1%95%E5%BC%80%E8%B0%83%E6%9F%A5","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171897000.webp","sourceId":"rfi"},{"id":1794171745000,"createdDate":"2026-11-08 21:02","name":"法国国际广播电台","title":"秘鲁萨满为教宗来访准备欢迎仪式","content":"周日，在教宗良十四世访问秘鲁前夕，一群秘鲁萨满祭司用色彩缤纷的鲜花、古柯叶、护身符以及教宗走下飞机的照片，为他举行了一场欢迎仪式。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261108-%E7%A7%98%E9%B2%81%E8%90%A8%E6%BB%A1%E4%B8%BA%E6%95%99%E5%AE%97%E6%9D%A5%E8%AE%BF%E5%87%86%E5%A4%87%E6%AC%A2%E8%BF%8E%E4%BB%AA%E5%BC%8F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171745000.webp","sourceId":"rfi"},{"id":1794171576000,"createdDate":"2026-11-08 20:59","name":"法国国际广播电台","title":"众议院监督委员会主席：“特朗普是美历史上最腐败的总统”","content":"美国司法部长托德·布兰奇（ToddBlanche）周日在CNN上表示，他的职责是捍卫特朗普政府成员，这些成员可能会成为共和党败选后，即将占据国会多数席位的民主党人调查的目标。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261108-%E4%BC%97%E8%AE%AE%E9%99%A2%E7%9B%91%E7%9D%A3%E5%A7%94%E5%91%98%E4%BC%9A%E4%B8%BB%E5%B8%AD-%E7%89%B9%E6%9C%97%E6%99%AE%E6%98%AF%E7%BE%8E%E5%8E%86%E5%8F%B2%E4%B8%8A%E6%9C%80%E8%85%90%E8%B4%A5%E7%9A%84%E6%80%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171576000.webp","sourceId":"rfi"},{"id":1794171364000,"createdDate":"2026-11-08 20:56","name":"法国国际广播电台","title":"伊朗再处决3名抗议者","content":"伊朗当局周日宣布处决三名男子，他们被控在今年1月席卷全国的反政府抗议活动中代表以色列和美国行事。此前，一个人权组织谴责他们的审判不公。","newsLink":"https://www.rfi.fr/cn/%E4%BA%9A%E6%B4%B2/20261108-%E4%BC%8A%E6%9C%97%E5%86%8D%E5%A4%84%E5%86%B33%E5%90%8D%E6%8A%97%E8%AE%AE%E8%80%85","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171364000.webp","sourceId":"rfi"},{"id":1794171110000,"createdDate":"2026-11-08 20:51","name":"法国国际广播电台","title":"成都蓉城丢冠    俱乐部官方发布致歉信","content":"在2026赛季中超联赛中，成都蓉城队在一度领先第二名多达18分、最后4轮只需拿到1分即可夺冠的绝对优势下，遭遇收官阶段四连败（最后5轮仅拿1分），最终在最后一轮以2-3不敌山东泰山，将冠军拱手送给了大连英博。这场被媒体称为“世界足坛罕见”的史诗级大崩盘。","newsLink":"https://www.rfi.fr/cn/%E5%9B%BD%E9%99%85/20261108-%E6%88%90%E9%83%BD%E8%93%89%E5%9F%8E%E4%B8%A2%E5%86%A0-%E4%BF%B1%E4%B9%90%E9%83%A8%E5%AE%98%E6%96%B9%E5%8F%91%E5%B8%83%E8%87%B4%E6%AD%89%E4%BF%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794171110000.webp","sourceId":"rfi"},{"id":1794170818000,"createdDate":"2026-11-08 20:46","name":"法国国际广播电台","title":"塞内加尔移民船沉没  34人死亡","content":"据塞内加尔国家媒体和一家非政府组织周日公布的最新初步统计，在塞内加尔西北部凯贝梅尔海岸附近沉没的移民船死亡人数已从21人上升至34人。","newsLink":"https://www.rfi.fr/cn/%E9%9D%9E%E6%B4%B2/20261108-%E5%A1%9E%E5%86%85%E5%8A%A0%E5%B0%94%E7%A7%BB%E6%B0%91%E8%88%B9%E6%B2%89%E6%B2%A1-34%E4%BA%BA%E6%AD%BB%E4%BA%A1","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794170818000.webp","sourceId":"rfi"},{"id":1794170590000,"createdDate":"2026-11-08 20:43","name":"法国国际广播电台","title":"教宗良十四世抵达阿根廷继续南美之旅","content":"教宗良十四世于周日抵达阿根廷，这是他为期12天的拉丁美洲之行的第二站，行程安排紧凑。这是他近四周前接受肺癌手术后的首次访问。在阿根廷的四天里，教宗将在布宜诺斯艾利斯机场受到总统哈维尔·米莱的迎接，并计划主持三场露天弥撒，参观一座监狱、一所残疾人收容所和当地一处重要的朝圣地。","newsLink":"https://www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20261108-%E6%95%99%E5%AE%97%E8%89%AF%E5%8D%81%E5%9B%9B%E4%B8%96%E6%8A%B5%E8%BE%BE%E9%98%BF%E6%A0%B9%E5%BB%B7%E7%BB%A7%E7%BB%AD%E5%8D%97%E7%BE%8E%E4%B9%8B%E6%97%85","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794170590000.webp","sourceId":"rfi"},{"id":1794170296000,"createdDate":"2026-11-08 20:38","name":"法国国际广播电台","title":"默茨希望任命伊尔莎·艾格纳为德国第一位女总统","content":"据基民盟内部消息人士透露，德国总理弗里德里希·默茨（FriedrichMerz）周日晚间宣布，巴伐利亚州议会议长伊尔泽·艾格纳（IlseAigner）将作为其总统候选人。如果是这样的话，这是德国历史上首次由女性担任总统。","newsLink":"https://www.rfi.fr/cn/%E6%AC%A7%E6%B4%B2/20261108-%E9%BB%98%E8%8C%A8%E5%B8%8C%E6%9C%9B%E4%BB%BB%E5%91%BD%E4%BC%8A%E5%B0%94%E8%8E%8E%C2%B7%E8%89%BE%E6%A0%BC%E7%BA%B3%E4%B8%BA%E5%BE%B7%E5%9B%BD%E7%AC%AC%E4%B8%80%E4%BD%8D%E5%A5%B3%E6%80%BB%E7%BB%9F","thumbnail":"","detailImage":"news/detail/rfi/2026/11/08/1794170296000.webp","sourceId":"rfi"}]